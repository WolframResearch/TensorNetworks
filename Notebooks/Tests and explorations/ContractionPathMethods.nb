Cell[CellGroupData[{

Cell["Example 3: Using temperature (Stochastic Selection)", "Subsection",ExpressionUUID->"9986901a-73bd-46f6-a7cd-74c0c0bba130"],

Cell["\<\
temperature adds randomness to escape local minima. At temperature=0, always \
picks best. Higher temperature = more random.\
\>", "Text",ExpressionUUID->"69087cf9-d89d-4377-a3ea-92e0c1941228"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"PEPS", "-", 
     RowBox[{"like", " ", "2", "D", " ", "grid", " ", "network", " ", 
      RowBox[{"(", 
       RowBox[{"9", " ", "tensors", " ", "in", " ", "3", "x3", " ", "grid"}], 
       ")"}]}]}], ",", " ", 
    RowBox[{
    "Each", " ", "tensor", " ", "connects", " ", "to", " ", "neighbors"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pepsInput", "=", 
     RowBox[{"{", "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", "           ", 
       RowBox[{"(*", " ", "corner", " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4", ",", "5", ",", "6"}], "}"}], ",", "        ", 
       RowBox[{"(*", " ", "edge", " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"5", ",", "7", ",", "8"}], "}"}], ",", "           ", 
       RowBox[{"(*", " ", "corner", " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"3", ",", "9", ",", "10", ",", "11"}], "}"}], ",", "      ", 
       RowBox[{"(*", " ", "edge", " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"6", ",", "10", ",", "12", ",", "13", ",", "14"}], "}"}], ",",
        " ", 
       RowBox[{"(*", " ", "center", " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"8", ",", "13", ",", "15", ",", "16"}], "}"}], ",", "     ", 
       RowBox[{"(*", " ", "edge", " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"11", ",", "17", ",", "18"}], "}"}], ",", "        ", 
       RowBox[{"(*", " ", "corner", " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"14", ",", "17", ",", "19", ",", "20"}], "}"}], ",", "    ", 
       RowBox[{"(*", " ", "edge", " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"16", ",", "19", ",", "21"}], "}"}]}], "         ", 
      RowBox[{"(*", " ", "corner", " ", "*)"}], "\n", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pepsOutput", "=", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", "4", ",", "7", ",", "9", ",", "12", ",", "15", ",", "18", ",",
        "20", ",", "21"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pepsSizes", "=", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Range", "[", "21", "]"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{
        "10", ",", "50", ",", "50", ",", "10", ",", "50", ",", "50", ",", 
         "10", ",", "50", ",", "50", ",", "50", ",", "50", ",", "10", ",", 
         "50", ",", "50", ",", "50", ",", "10", ",", "50", ",", "50", ",", 
         "50", ",", "10", ",", "10"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"950f7039-7188-437e-b98d-ac3398698e51"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Deterministic", " ", "greedy", " ", "-", " ", 
    RowBox[{"Temperature", " ", "=", " ", "0"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"GreedyContractionPath", "[", 
    RowBox[{"pepsInput", ",", "pepsOutput", ",", "pepsSizes", ",", 
     RowBox[{"\"\<Temperature\>\"", "->", "0"}]}], "]"}], "==", 
   RowBox[{"GreedyContractionPath", "[", 
    RowBox[{
     RowBox[{"TensorNetwork", "[", 
      RowBox[{
       RowBox[{"pepsInput", "->", "pepsOutput"}], ",", "pepsSizes"}], "]"}], ",", 
     RowBox[{"\"\<Temperature\>\"", "->", "0"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.978799829787184*^9, 3.978799871095477*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"1b7b67a8-72ae-4e59-b7c1-cdd12b5b7b74"],

