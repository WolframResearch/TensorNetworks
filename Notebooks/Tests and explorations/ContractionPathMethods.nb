Cell[CellGroupData[{

Cell["Example 5: Using \"RandomSeed\" Option", "Subsection",ExpressionUUID->"f50d77de-7f5d-4ee3-9499-9ce3900a0990"],

Cell["\<\
\"RandomSeed\" ensures reproducible results when using Temperature > 0.\
\>", "Text",ExpressionUUID->"389a061d-6b64-4b06-b664-a50683dad029"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"With", " ", "Temperature", " ", "but", " ", "reproducible"}], " ",
    "*)"}], "\n", 
  RowBox[{
   RowBox[{"GreedyContractionPath", "[", 
    RowBox[{"pepsInput", ",", "pepsOutput", ",", "pepsSizes", ",", 
     RowBox[{"\"\<Temperature\>\"", "->", "1.0"}], ",", 
     RowBox[{"\"\<RandomSeed\>\"", "->", "12345"}]}], "]"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Running", " ", "again", " ", "with", " ", "same", " ", "seed", " ", 
     "gives", " ", "identical", " ", "result"}], " ", "*)"}], "\n", 
   RowBox[{"GreedyContractionPath", "[", 
    RowBox[{"pepsInput", ",", "pepsOutput", ",", "pepsSizes", ",", 
     RowBox[{"\"\<Temperature\>\"", "->", "1.0"}], ",", 
     RowBox[{"\"\<RandomSeed\>\"", "->", "12345"}]}], "]"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Different", " ", "seed"}], ",", " ", 
     RowBox[{"different", " ", "result"}]}], " ", "*)"}], "\n", 
   RowBox[{"GreedyContractionPath", "[", 
    RowBox[{"pepsInput", ",", "pepsOutput", ",", "pepsSizes", ",", 
     RowBox[{"\"\<Temperature\>\"", "->", "1.0"}], ",", 
     RowBox[{"\"\<RandomSeed\>\"", "->", "99999"}]}], "]"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Multiple", " ", "options", " ", "with", " ", "seed"}], " ", 
    "*)"}], "\n", 
   RowBox[{"GreedyContractionPath", "[", 
    RowBox[{"largeInput", ",", "largeOutput", ",", "largeSizes", ",", 
     RowBox[{"\"\<MemoryWeight\>\"", "->", "0.5"}], ",", 
     RowBox[{"\"\<Temperature\>\"", "->", "0.8"}], ",", 
     RowBox[{"\"\<MaxNeighbors\>\"", "->", "10"}], ",", 
     RowBox[{"\"\<RandomSeed\>\"", "->", "42"}]}], "]"}]}]}]], "Input",Express\
ionUUID->"77db847f-50d1-40cb-a269-5a99fa48e79f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example 6: Using \"PreSimplify\" Option", "Subsection",ExpressionUUID->"60c15411-3fd1-42aa-9180-a23aef531635"],

Cell["\<\
\"PreSimplify\" pre-processes the network to combine trivially contractible \
pairs.\
\>", "Text",ExpressionUUID->"7ad56301-86ed-46c1-9a5d-bf28cda75c41"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Network", " ", "with", " ", "some", " ", "obvious", " ", "contractions"}],
    " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"simplifiableInput", "=", 
     RowBox[{"{", "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "           ", 
       RowBox[{"(*", " ", "Matrix", " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "           ", 
       RowBox[{"(*", " ", 
        RowBox[{"Matrix", " ", "-", " ", 
         RowBox[{"obvious", " ", "chain", " ", "with", " ", "previous"}]}], 
        " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4", ",", "5"}], "}"}], ",", "        ", 
       RowBox[{"(*", " ", "Tensor", " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"5", ",", "6"}], "}"}], ",", "           ", 
       RowBox[{"(*", " ", "Matrix", " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"4", ",", "7", ",", "8"}], "}"}], ",", "        ", 
       RowBox[{"(*", " ", "Tensor", " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"6", ",", "8", ",", "9"}], "}"}]}], "         ", 
      RowBox[{"(*", " ", "Tensor", " ", "*)"}], "\n", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"simplifiableOutput", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "7", ",", "9"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"simplifiableSizes", "=", 
     RowBox[{"<|", "\n", 
      RowBox[{
       RowBox[{"1", "->", "100"}], ",", 
       RowBox[{"2", "->", "20"}], ",", 
       RowBox[{"3", "->", "20"}], ",", 
       RowBox[{"4", "->", "50"}], ",", "\n", 
       RowBox[{"5", "->", "30"}], ",", 
       RowBox[{"6", "->", "30"}], ",", 
       RowBox[{"7", "->", "100"}], ",", 
       RowBox[{"8", "->", "40"}], ",", 
       RowBox[{"9", "->", "100"}]}], "\n", "|>"}]}], ";"}]}]}]], "Input",Expre\
ssionUUID->"30356574-35ac-4998-884a-767a6e960736"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Without", " ", "simplification"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"GreedyContractionPath", "[", 
    RowBox[{
    "simplifiableInput", ",", "simplifiableOutput", ",", "simplifiableSizes", 
     ",", 
     RowBox[{"\"\<PreSimplify\>\"", "->", "False"}]}], "]"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"With", " ", "simplification", " ", "-", " ", 
     RowBox[{
     "may", " ", "find", " ", "better", " ", "path", " ", "by", " ", "pre"}], 
     "-", "combining"}], " ", "*)"}], "\n", 
   RowBox[{"GreedyContractionPath", "[", 
    RowBox[{
    "simplifiableInput", ",", "simplifiableOutput", ",", "simplifiableSizes", 
     ",", 
     RowBox[{"\"\<PreSimplify\>\"", "->", "True"}]}], "]"}]}]}]], "Input",Expr\
essionUUID->"b0ca7901-8ac4-43fc-b9e9-86a3996ef0e1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example 7: Using \"FixedIndexing\" Option", "Subsection",ExpressionUUID->"2ec98c10-6ecd-4bfc-992c-c812e2938ff1"],

Cell["\<\
\"FixedIndexing\" changes the output format to SSA (Single Static Assignment) \
form where each intermediate gets a unique ID.\
\>", "Text",ExpressionUUID->"ffd3f6fa-6f09-4ebf-bfac-ac820d2dcabb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Standard", " ", "path", " ", "format", " ", 
    RowBox[{"(", "default", ")"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"path1", "=", 
    RowBox[{"GreedyContractionPath", "[", 
     RowBox[{"input1", ",", "output1", ",", "sizeDict1"}], "]"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Output", " ", 
      RowBox[{"like", ":", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}]}], ",", " ", 
     RowBox[{
     "Positions", " ", "shift", " ", "as", " ", "tensors", " ", "are", " ", 
      "consumed"}]}], " ", "*)"}]}]}]], "Input",ExpressionUUID->"87cd57cf-\
c2bf-484a-8c37-328b9808e19e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"SSA", " ", "format", " ", "-", " ", 
    RowBox[{"unique", " ", "IDs", " ", "for", " ", "intermediates"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{"path2", "=", 
    RowBox[{"GreedyContractionPath", "[", 
     RowBox[{"input1", ",", "output1", ",", "sizeDict1", ",", 
      RowBox[{"\"\<FixedIndexing\>\"", "->", "True"}]}], "]"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Output", " ", 
      RowBox[{"like", ":", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "6"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"7", ",", "8"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"9", ",", "10"}], "}"}]}], "}"}]}]}], ",", " ", 
     RowBox[{
     "Each", " ", "number", " ", "is", " ", "a", " ", "unique", " ", "tensor",
       " ", "ID"}]}], " ", "*)"}]}]}]], "Input",ExpressionUUID->"703be2f8-\
eff1-4b37-8e9d-26c80cbbcadc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example 8: All Options Combined - MPS-MPO Contraction", "Subsection",ExpressionUUID->"fa6c0912-a7a4-4de6-a908-b615eb61e555"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Complex", " ", "MPS"}], "-", 
    RowBox[{"MPO", " ", "contraction", " ", "network"}]}], " ", "*)"}], "\n", 
  
  RowBox[{
   RowBox[{
    RowBox[{"mpsInput", "=", 
     RowBox[{"{", "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", "        ", 
       RowBox[{"(*", " ", 
        RowBox[{"MPS", " ", "tensor", " ", "1"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4", ",", "5"}], "}"}], ",", "        ", 
       RowBox[{"(*", " ", 
        RowBox[{"MPS", " ", "tensor", " ", "2"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"5", ",", "6", ",", "7"}], "}"}], ",", "        ", 
       RowBox[{"(*", " ", 
        RowBox[{"MPS", " ", "tensor", " ", "3"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"7", ",", "8", ",", "9"}], "}"}], ",", "        ", 
       RowBox[{"(*", " ", 
        RowBox[{"MPS", " ", "tensor", " ", "4"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"2", ",", "10", ",", "11", ",", "12"}], "}"}], ",", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"MPO", " ", "tensor", " ", "1"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"4", ",", "12", ",", "13", ",", "14"}], "}"}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"MPO", " ", "tensor", " ", "2"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"6", ",", "14", ",", "15", ",", "16"}], "}"}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"MPO", " ", "tensor", " ", "3"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"8", ",", "16", ",", "17", ",", "18"}], "}"}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"MPO", " ", "tensor", " ", "4"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"11", ",", "19", ",", "20"}], "}"}], ",", "     ", 
       RowBox[{"(*", " ", 
        RowBox[{"MPS", "'"}], " ", 
        RowBox[{"tensor", " ", "1"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"13", ",", "20", ",", "21"}], "}"}], ",", "     ", 
       RowBox[{"(*", " ", 
        RowBox[{"MPS", "'"}], " ", 
        RowBox[{"tensor", " ", "2"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"15", ",", "21", ",", "22"}], "}"}], ",", "     ", 
       RowBox[{"(*", " ", 
        RowBox[{"MPS", "'"}], " ", 
        RowBox[{"tensor", " ", "3"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"17", ",", "22", ",", "23"}], "}"}]}], "      ", 
      RowBox[{"(*", " ", 
       RowBox[{"MPS", "'"}], " ", 
       RowBox[{"tensor", " ", "4"}], " ", "*)"}], "\n", "}"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"mpsOutput", "=", 
     RowBox[{"RandomSample", "@", 
      RowBox[{"{", 
       RowBox[{"1", ",", "9", ",", "10", ",", "18", ",", "19", ",", "23"}], 
       "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mpsSizes", "=", 
     RowBox[{"<|", "\n", 
      RowBox[{
       RowBox[{"1", "->", "2"}], ",", 
       RowBox[{"2", "->", "4"}], ",", 
       RowBox[{"3", "->", "50"}], ",", 
       RowBox[{"4", "->", "4"}], ",", 
       RowBox[{"5", "->", "50"}], ",", 
       RowBox[{"6", "->", "4"}], ",", 
       RowBox[{"7", "->", "50"}], ",", 
       RowBox[{"8", "->", "4"}], ",", 
       RowBox[{"9", "->", "2"}], ",", "\n", 
       RowBox[{"10", "->", "4"}], ",", 
       RowBox[{"11", "->", "4"}], ",", 
       RowBox[{"12", "->", "20"}], ",", 
       RowBox[{"13", "->", "4"}], ",", 
       RowBox[{"14", "->", "20"}], ",", 
       RowBox[{"15", "->", "4"}], ",", 
       RowBox[{"16", "->", "20"}], ",", 
       RowBox[{"17", "->", "4"}], ",", 
       RowBox[{"18", "->", "4"}], ",", "\n", 
       RowBox[{"19", "->", "2"}], ",", 
       RowBox[{"20", "->", "50"}], ",", 
       RowBox[{"21", "->", "50"}], ",", 
       RowBox[{"22", "->", "50"}], ",", 
       RowBox[{"23", "->", "2"}]}], "\n", "|>"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.978807945795246*^9, 3.978807949188325*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"e377fbaf-79fb-4697-98ca-736829bf7ba7"],

