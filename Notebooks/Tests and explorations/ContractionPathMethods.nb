Cell[CellGroupData[{

Cell["Example 4: Using \"AllowOuterProducts\" Option", "Subsection",ExpressionUUID->"8de71fa0-c5bb-4f30-9c7e-6f00a6a272f8"],

Cell["\<\
\"AllowOuterProducts\" controls whether to consider contracting tensors that \
share NO common indices (outer products).\
\>", "Text",ExpressionUUID->"7e7f0dd8-5f32-4f33-8add-098183a4634b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Network", " ", "with", " ", "disconnected", " ", "components", " ", 
     "that", " ", "must", " ", "eventually", " ", 
     RowBox[{"join", ".", " ", "Without"}], " ", "outer", " ", "products"}], ",",
     " ", 
    RowBox[{"some", " ", "paths", " ", "are", " ", "impossible"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"disconnectedInput", "=", 
     RowBox[{"{", "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", "      ", 
       RowBox[{"(*", " ", 
        RowBox[{"Component", " ", "A"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}], ",", "         ", 
       RowBox[{"(*", " ", 
        RowBox[{"Component", " ", "A"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"5", ",", "6", ",", "7"}], "}"}], ",", "      ", 
       RowBox[{"(*", " ", 
        RowBox[{"Component", " ", "B", " ", "-", " ", 
         RowBox[{"disconnected", "!"}]}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"7", ",", "8"}], "}"}], ",", "         ", 
       RowBox[{"(*", " ", 
        RowBox[{"Component", " ", "B"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"2", ",", "6", ",", "9"}], "}"}], ",", "      ", 
       RowBox[{"(*", " ", 
        RowBox[{"Bridge", " ", "connecting", " ", "A", " ", "and", " ", "B"}],
         " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"4", ",", "8", ",", "9", ",", "10"}], "}"}]}], "   ", 
      RowBox[{"(*", " ", 
       RowBox[{"Final", " ", "connector"}], " ", "*)"}], "\n", "}"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"disconnectedOutput", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "5", ",", "10"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"disconnectedSizes", "=", 
     RowBox[{"<|", "\n", 
      RowBox[{
       RowBox[{"1", "->", "100"}], ",", 
       RowBox[{"2", "->", "30"}], ",", 
       RowBox[{"3", "->", "40"}], ",", 
       RowBox[{"4", "->", "50"}], ",", "\n", 
       RowBox[{"5", "->", "100"}], ",", 
       RowBox[{"6", "->", "30"}], ",", 
       RowBox[{"7", "->", "40"}], ",", 
       RowBox[{"8", "->", "50"}], ",", "\n", 
       RowBox[{"9", "->", "20"}], ",", 
       RowBox[{"10", "->", "100"}]}], "\n", "|>"}]}], ";"}]}]}]], "Input",Expr\
essionUUID->"8d222c57-36bb-4ec3-a949-405b45b86c0b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
