Cell[CellGroupData[{

Cell["Example 2: Asymmetric Network Comparison", "Subsection",ExpressionUUID->"55d5f29a-f795-4189-98a8-8d28c085fbc4"],

Cell["\<\
Network with very asymmetric dimensions - different strategies will give very \
different paths.\
\>", "Text",ExpressionUUID->"86cf6633-16bd-47db-9522-dbcfeff6b14b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Network", " ", "with", " ", "very", " ", "asymmetric", " ", 
     RowBox[{"dimensions", ".", " ", "Some"}], " ", "indices", " ", "are", " ",
      "huge", " ", 
     RowBox[{"(", "1000", ")"}]}], ",", " ", 
    RowBox[{"some", " ", "tiny", " ", 
     RowBox[{
      RowBox[{"(", "2", ")"}], ".", " ", "Different"}], " ", "strategies", " ",
      "will", " ", "give", " ", "very", " ", "different", " ", "paths"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"asymInput", "=", 
     RowBox[{"{", "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", "        ", 
       RowBox[{"(*", " ", 
        RowBox[{"huge", " ", "x", " ", "tiny", " ", "x", " ", "medium"}], " ",
         "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4", ",", "5"}], "}"}], ",", "        ", 
       RowBox[{"(*", " ", 
        RowBox[{"medium", " ", "x", " ", "huge", " ", "x", " ", "tiny"}], " ",
         "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"2", ",", "5", ",", "6"}], "}"}], ",", "        ", 
       RowBox[{"(*", " ", 
        RowBox[{"tiny", " ", "x", " ", "tiny", " ", "x", " ", "huge"}], " ", 
        "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"4", ",", "6", ",", "7"}], "}"}], ",", "        ", 
       RowBox[{"(*", " ", 
        RowBox[{"huge", " ", "x", " ", "huge", " ", "x", " ", "medium"}], " ",
         "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"1", ",", "7", ",", "8"}], "}"}]}], "         ", 
      RowBox[{"(*", " ", 
       RowBox[{"huge", " ", "x", " ", "medium", " ", "x", " ", "result"}], 
       " ", "*)"}], "\n", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"asymOutput", "=", 
     RowBox[{"{", "8", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"asymSizes", "=", 
     RowBox[{"<|", "\n", 
      RowBox[{
       RowBox[{"1", "->", "1000"}], ",", "  ", 
       RowBox[{"(*", " ", "huge", " ", "*)"}], "\n", 
       RowBox[{"2", "->", "2"}], ",", "     ", 
       RowBox[{"(*", " ", "tiny", " ", "*)"}], "\n", 
       RowBox[{"3", "->", "50"}], ",", "    ", 
       RowBox[{"(*", " ", "medium", " ", "*)"}], "\n", 
       RowBox[{"4", "->", "1000"}], ",", "  ", 
       RowBox[{"(*", " ", "huge", " ", "*)"}], "\n", 
       RowBox[{"5", "->", "2"}], ",", "     ", 
       RowBox[{"(*", " ", "tiny", " ", "*)"}], "\n", 
       RowBox[{"6", "->", "1000"}], ",", "  ", 
       RowBox[{"(*", " ", "huge", " ", "*)"}], "\n", 
       RowBox[{"7", "->", "50"}], ",", "    ", 
       RowBox[{"(*", " ", "medium", " ", "*)"}], "\n", 
       RowBox[{"8", "->", "10"}]}], "     ", 
      RowBox[{"(*", " ", "result", " ", "*)"}], "\n", "|>"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"37424555-314f-4972-8919-4326c8852c12"],

