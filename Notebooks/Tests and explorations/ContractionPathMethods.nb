Cell[CellGroupData[{

Cell["Example 4: Using \"MaxNeighbors\" Option", "Subsection",ExpressionUUID->"f8652a1d-6007-4e97-9c90-a788e9abfb14"],

Cell["\<\
\"MaxNeighbors\" limits how many candidate contractions to evaluate at each \
step. Useful for very large networks.\
\>", "Text",ExpressionUUID->"b82c780b-beee-46da-8e2d-5ac8c8c54c35"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Large", " ", "random"}], "-", 
    RowBox[{
    "like", " ", "network", " ", "with", " ", "12", " ", "tensors"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"largeInput", "=", 
     RowBox[{"{", "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"4", ",", "5", ",", "6"}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"3", ",", "7", ",", "8", ",", "9"}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"6", ",", "9", ",", "10", ",", "11"}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"2", ",", "12", ",", "13"}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"8", ",", "13", ",", "14", ",", "15"}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"5", ",", "11", ",", "16", ",", "17"}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"10", ",", "15", ",", "17", ",", "18"}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"7", ",", "12", ",", "19", ",", "20"}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"14", ",", "19", ",", "21", ",", "22"}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"16", ",", "20", ",", "22", ",", "23"}], "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"18", ",", "21", ",", "23", ",", "24"}], "}"}]}], "\n", 
      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"largeOutput", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "24"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"largeSizes", "=", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Range", "[", "24", "]"}], ",", "\n", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "100", "}"}], ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"50", ",", "22"}], "]"}], ",", 
         RowBox[{"{", "100", "}"}]}], "]"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"8c300e92-b2a8-45a2-867d-e3d58594c018"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"No", " ", "limit", " ", "-", " ", 
    RowBox[{"evaluate", " ", "all", " ", "possible", " ", "pairs"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{"GreedyContractionPath", "[", 
    RowBox[{"largeInput", ",", "largeOutput", ",", "largeSizes"}], "]"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Limit", " ", "to", " ", "best", " ", "10", " ", "neighbors", " ", "at", " ",
      "each", " ", "step"}], " ", "*)"}], "\n", 
   RowBox[{"GreedyContractionPath", "[", 
    RowBox[{"largeInput", ",", "largeOutput", ",", "largeSizes", ",", 
     RowBox[{"\"\<MaxNeighbors\>\"", "->", "10"}]}], "]"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Very", " ", "restrictive", " ", "-", " ", 
     RowBox[{"only", " ", "top", " ", "3", " ", "candidates"}]}], " ", "*)"}],
    "\n", 
   RowBox[{"GreedyContractionPath", "[", 
    RowBox[{"largeInput", ",", "largeOutput", ",", "largeSizes", ",", 
     RowBox[{"\"\<MaxNeighbors\>\"", "->", "3"}]}], "]"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Combine", " ", "with", " ", "Temperature", " ", "for", " ", "randomized",
      " ", "limited", " ", "search"}], " ", "*)"}], "\n", 
   RowBox[{"GreedyContractionPath", "[", 
    RowBox[{"largeInput", ",", "largeOutput", ",", "largeSizes", ",", 
     RowBox[{"\"\<Temperature\>\"", "->", "0.5"}], ",", 
     RowBox[{"\"\<MaxNeighbors\>\"", "->", "5"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"696c966b-b129-4c05-a8d7-d43b62c43a91"],

