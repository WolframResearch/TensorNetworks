Cell[CellGroupData[{

Cell["OptimalContractionPath", "Section",ExpressionUUID->"bd9b1264-3dcf-4191-ba3d-8694917dc595"],

Cell[CellGroupData[{

Cell["Function Signature", "Subsection",ExpressionUUID->"9d17afbe-5075-4062-ac4c-2577eeee08cc"],

Cell["\<\
OptimalContractionPath[input, output, sizeDict, opts...]

Options:
  Method -> \"size\"           (* cost function: \"flops\", \"size\", \
\"max\", \"write\", \"combo\", \"limit\" *)
  \"PruningThreshold\" -> None (* prune paths exceeding this cost *)
  \"AllowOuterProducts\" -> None (* consider outer products *)
  \"PreSimplify\" -> None      (* pre-simplify network *)
  \"FixedIndexing\" -> None    (* use SSA output format *)

Alternative (positional minimize for backward compatibility):
  OptimalContractionPath[input, output, sizeDict, \"flops\", opts...]
\
\>", "Program",ExpressionUUID->"76001dc1-7996-4342-a591-b28e9bee2dc8"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", "\n", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Parameter\>\"", ",", "\"\<Type\>\"", ",", "\"\<Default\>\"",
        ",", "\"\<Description\>\""}], "}"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{"\"\<input\>\"", ",", "\"\<{{___Integer}...}\>\"", 
       ",", "\"\<Required\>\"", 
       ",", "\"\<List of index lists for each tensor\>\""}], "}"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{"\"\<output\>\"", ",", "\"\<{___Integer}\>\"", 
       ",", "\"\<Required\>\"", 
       ",", "\"\<Indices remaining after contraction\>\""}], "}"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{"\"\<sizeDict\>\"", ",", "\"\<Association\>\"", 
       ",", "\"\<Required\>\"", ",", "\"\<Index -> dimension mapping\>\""}], 
      "}"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{"\"\<Method\>\"", ",", "\"\<String\>\"", 
       ",", "\"\<\\\"size\\\"\>\"", 
       ",", "\"\<Cost function: flops, size, max, write, combo, limit\>\""}], 
      "}"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\"PruningThreshold\\\"\>\"", ",", "\"\<Numeric|None\>\"",
        ",", "\"\<None\>\"", ",", "\"\<Prune paths exceeding this cost\>\""}],
       "}"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\"AllowOuterProducts\\\"\>\"", 
       ",", "\"\<Boolean|None\>\"", ",", "\"\<None\>\"", 
       ",", "\"\<Consider outer products in search\>\""}], "}"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\"PreSimplify\\\"\>\"", ",", "\"\<Boolean|None\>\"", 
       ",", "\"\<None\>\"", 
       ",", "\"\<Pre-simplify network before optimization\>\""}], "}"}], ",", 
     "\n", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\"FixedIndexing\\\"\>\"", ",", "\"\<Boolean|None\>\"", 
       ",", "\"\<None\>\"", 
       ",", "\"\<Use SSA (fixed) output indexing format\>\""}], "}"}]}], "\n",
     "}"}], ",", "\n", 
   RowBox[{"Frame", "->", "All"}], ",", 
   RowBox[{"Background", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"LightGray", ",", "None"}], "}"}]}], "}"}]}]}], "]"}]], "Input",\
ExpressionUUID->"0c8ce00b-ac5c-4b96-a9c3-87b48b8cd90d"]
}, Open  ]],

