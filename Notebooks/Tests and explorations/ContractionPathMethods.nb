   RowBox[{"(*", " ", 
    RowBox[{"Balanced", " ", "combination"}], " ", "*)"}], "\n", 
   RowBox[{"OptimalContractionPath", "[", 
    RowBox[{"input1", ",", "output1", ",", "sizeDict1", ",", 
     RowBox[{"Method", "->", "\"\<combo\>\""}]}], "]"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Positional", " ", "minimize", " ", 
