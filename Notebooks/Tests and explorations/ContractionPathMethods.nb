Cell["Example 8: Quantum Circuit Contraction", "Subsection",ExpressionUUID->"edb6687f-9c8f-46ea-91ee-4d3aa24eab00"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"5", "-", 
     RowBox[{
     "qubit", " ", "quantum", " ", "circuit", " ", "with", " ", "entangling", 
      " ", 
      RowBox[{"gates", ".", " ", "Each"}], " ", "gate", " ", "is", " ", "a", " ",
       "tensor"}]}], ",", " ", 
    RowBox[{"simulating", " ", "circuit", " ", "contraction"}]}], " ", "*)"}],
   "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"circuitInput", "=", 
     RowBox[{"{", "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "           ", 
       RowBox[{"(*", " ", 
        RowBox[{"Initial", " ", "state", " ", "qubit", " ", "1"}], " ", 
        "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}], ",", "           ", 
       RowBox[{"(*", " ", 
        RowBox[{"Initial", " ", "state", " ", "qubit", " ", "2"}], " ", 
        "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"5", ",", "6"}], "}"}], ",", "           ", 
       RowBox[{"(*", " ", 
        RowBox[{"Initial", " ", "state", " ", "qubit", " ", "3"}], " ", 
        "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"7", ",", "8"}], "}"}], ",", "           ", 
       RowBox[{"(*", " ", 
        RowBox[{"Initial", " ", "state", " ", "qubit", " ", "4"}], " ", 
        "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"9", ",", "10"}], "}"}], ",", "          ", 
       RowBox[{"(*", " ", 
        RowBox[{"Initial", " ", "state", " ", "qubit", " ", "5"}], " ", 
        "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4", ",", "11", ",", "12"}], "}"}], ",", "   ", 
       RowBox[{"(*", " ", 
        RowBox[{"CNOT", " ", "gate", " ", "1", "-", "2"}], " ", "*)"}], "\n", 
       
       RowBox[{"{", 
        RowBox[{"6", ",", "8", ",", "13", ",", "14"}], "}"}], ",", "   ", 
       RowBox[{"(*", " ", 
        RowBox[{"CNOT", " ", "gate", " ", "3", "-", "4"}], " ", "*)"}], "\n", 
       
       RowBox[{"{", 
        RowBox[{"12", ",", "13", ",", "15", ",", "16"}], "}"}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"CNOT", " ", "gate", " ", "2", "-", "3"}], " ", "*)"}], "\n", 
       
       RowBox[{"{", 
        RowBox[{"14", ",", "10", ",", "17", ",", "18"}], "}"}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"CNOT", " ", "gate", " ", "4", "-", "5"}], " ", "*)"}], "\n", 
       
       RowBox[{"{", 
        RowBox[{"11", ",", "16", ",", "19", ",", "20"}], "}"}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"CNOT", " ", "gate", " ", "1", "-", "3"}], " ", "*)"}], "\n", 
       
       RowBox[{"{", 
        RowBox[{"15", ",", "17", ",", "21", ",", "22"}], "}"}], ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"CNOT", " ", "gate", " ", "2", "-", "4"}], " ", "*)"}], "\n", 
       
       RowBox[{"{", 
        RowBox[{"19", ",", "23"}], "}"}], ",", "         ", 
       RowBox[{"(*", " ", 
        RowBox[{"Measurement", " ", "qubit", " ", "1"}], " ", "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"20", ",", "21", ",", "24"}], "}"}], ",", "     ", 
       RowBox[{"(*", " ", 
        RowBox[{"Measurement", " ", "qubit", " ", "2", "-", "3"}], " ", 
        "*)"}], "\n", 
       RowBox[{"{", 
        RowBox[{"22", ",", "18", ",", "25"}], "}"}]}], "      ", 
      RowBox[{"(*", " ", 
       RowBox[{"Measurement", " ", "qubit", " ", "4", "-", "5"}], " ", "*)"}],
       "\n", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"circuitOutput", "=", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", "3", ",", "5", ",", "7", ",", "9", ",", "23", ",", "24", ",", 
       "25"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"circuitSizes", "=", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"Range", "[", "25", "]"}], ",", "\n", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"2", ",", "10"}], "]"}], ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"2", ",", "15"}], "]"}]}], "]"}]}], "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"All", " ", "qubit", " ", "dims"}], " ", "*)"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"1c9beca7-92d5-47aa-9329-f866cde180eb"],

