      RowBox[{"\"\<\\\"max\\\"\>\"", ",", "\"\<Peak memory\>\"", 
       ",", "\"\<Memory-constrained systems (GPU)\>\""}], "}"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\"write\\\"\>\"", ",", "\"\<Total bytes written\>\"", 
       ",", "\"\<I/O bound systems\>\""}], "}"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\"combo\\\"\>\"", ",", "\"\<Weighted combination\>\"", 
       ",", "\"\<General balanced optimization\>\""}], "}"}], ",", "\n", 
     RowBox[{"{", 
      RowBox[{"\"\<\\\"limit\\\"\>\"", ",", "\"\<Size with cost ceiling\>\"", 
       ",", "\"\<Known memory budget\>\""}], "}"}]}], "\n", "}"}], ",", "\n", 
   
   RowBox[{"Frame", "->", "All"}], ",", 
