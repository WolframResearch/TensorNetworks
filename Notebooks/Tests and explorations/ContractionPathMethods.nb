Cell["\<\
GreedyContractionPath and OptimalContractionPath are now public exports, \
accessible directly after loading the package.\
\>", "Text",ExpressionUUID->"9075d1ef-a659-4205-8d38-c985d4e501a7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Overview", "Section",ExpressionUUID->"89ca8180-43e3-47f1-886d-c3d68833bd3e"],

Cell["\<\
TensorNetworkFindContractionPath uses two internal algorithms:\
\>", "Text",ExpressionUUID->"9510bab1-d0b9-4a37-8aff-1091804a54b3"],

Cell["\<\
OptimalContractionPath - Dynamic programming approach (guarantees optimal \
solution)\
\>", "Item",ExpressionUUID->"5a15656c-2cd6-4fa8-8bbc-748006049602"],

Cell["\<\
GreedyContractionPath - Greedy heuristic approach (fast but not guaranteed \
optimal)\
\>", "Item",ExpressionUUID->"011cf41a-3e9f-40e2-8f85-167a4e70fe7f"],

Cell[CellGroupData[{

Cell["Method Mapping", "Subsection",ExpressionUUID->"7b453809-f1da-4f8a-bdce-8a00bfed6b2a"],

