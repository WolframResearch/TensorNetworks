              ArraySymbol["T", {2, 2, 2, 3, 2, 3, 3}]], {
              Tree[
               Inactive[ArrayDot][
                ArraySymbol["T", {3, 3, 2}], 
                ArraySymbol["T", {3, 3, 3, 3, 3, 3, 3, 2, 2, 3}], {{2, 5}}], {
               
                Tree[
                 ArraySymbol["T", {3, 3, 2}], None], 
                Tree[
                 Inactive[ArrayDot][
                  ArraySymbol["T", {3, 3, 3, 3, 3}], 
                  ArraySymbol["T", {3, 3, 3, 3, 2, 2, 3}], {{1, 2}}], {
                  Tree[
                   ArraySymbol["T", {3, 3, 3, 3, 3}], None], 
                  Tree[
                   Inactive[ArrayDot][
                    ArraySymbol["T", {3, 3}], 
                    ArraySymbol["T", {3, 3, 3, 3, 2, 2, 3}], {{2, 3}}], {
                    Tree[
                    ArraySymbol["T", {3, 3}], None], 
                    Tree[
                    Inactive[ArrayDot][
                    ArraySymbol["T", {3, 3, 3, 3}], 
                    ArraySymbol["T", {3, 3, 2, 2, 3}], {{2, 2}}], {
                    Tree[
                    ArraySymbol["T", {3, 3, 3, 3}], None], 
                    Tree[
