Cell[CellGroupData[{

Cell["Contraction path, greedy vs optimal", "Section",
 CellChangeTimes->{{3.978793387674121*^9, 
  3.978793396946699*^9}},ExpressionUUID->"4efd46da-b428-4f23-904e-\
8d5dd0c9b015"],

Cell["\<\
GreedyPath[
    input : {{___Integer}...},        (* list of index lists for each tensor *)
    output : {___Integer},            (* indices for final result *)
    sizeDict : <|_Integer -> _Integer ...|>,  (* index -> dimension mapping \
*)
    costMod : _?NumericQ | None : None,       (* cost modification factor *)
    temperature : _?NumericQ | None : None,   (* randomization temperature *)
    maxNeighbors : _Integer | None : None,    (* neighbor search limit *)
    seed : _Integer | None : None,            (* random seed *)
    simplify : True | False | None : None,    (* simplification flag *)
    useSSA : True | False | None : None       (* single static assignment *)
]

Parameter\tDescription
input\tList of index lists, e.g., {{1,2}, {2,3}, {3,4}} for 3 tensors
output\tIndices that remain after contraction, e.g., {1,4}
sizeDict\tDimension of each index, e.g., <|1->10, 2->20, 3->30, 4->10|>
costMod\tModifies cost function weighting (default: balanced)
temperature\t>0 adds randomness to selection (useful for escaping local minima)
maxNeighbors\tLimits search space for very large networks
seed\tFor reproducible random behavior
simplify\tPre-simplify the contraction graph
useSSA\tUse Single Static Assignment form for path
\
\>", "Text",
 CellChangeTimes->{{3.978794138952153*^9, 
  3.978794165014237*^9}},ExpressionUUID->"551a4d5f-e9e0-4452-9b11-\
361374c2d314"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"input", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
