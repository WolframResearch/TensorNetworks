     RowBox[{"{", 
      RowBox[{"6", ",", "8", ",", "10", ",", "11"}], "}"}]}], "  ", "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"output", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", "9", ",", "11"}], "}"}]}], ";"}], "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TensorNetwork", "[", 
