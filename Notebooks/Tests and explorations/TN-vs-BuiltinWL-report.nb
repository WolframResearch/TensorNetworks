Cell[CellGroupData[{

Cell["\<\
Factor 2: lattice aspect ratio decides whether path-finding pays\
\>", "Subsection",
 CellChangeTimes->{
  3.988472444623889*^9},ExpressionUUID->"9e371c56-996a-414a-a44c-\
7ab4fa751172"],

Cell["\<\
Two lattices with the same total tensor count can be either chain-like or \
square-like. A chain has only one reasonable contraction order and the kernel \
finds it. A square has many; the kernel's local heuristic only sees one step \
at a time and gets it wrong.\
\>", "Text",ExpressionUUID->"121f1cb7-2e17-4e50-8df0-62224d5a7ef9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tn", " ", "=", " ", 
        RowBox[{"pepsOverlapTN", " ", "[", 
         RowBox[{"shape", ",", " ", "4"}], "]"}]}], "}"}], ",", "\n", 
