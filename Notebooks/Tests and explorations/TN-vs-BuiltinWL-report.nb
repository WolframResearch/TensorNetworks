Notebook[{

Cell[CellGroupData[{
Cell["Contraction-path optimization", "Title",
 CellChangeTimes->{
  3.9884735851736507`*^9},ExpressionUUID->"640a819e-0a66-4832-93b1-\
d53c2df1f931"],

Cell["Load the paclet:", "Text",ExpressionUUID->"ee748b34-b279-4e6a-a69e-79a56c011bd7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", 
   "[", "\"\</Users/mohammadb/Documents/GitHub/TensorNetworks\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`TensorNetworks`\>\"", "]"}], 
  ";"}]}], "Code",
 CellLabel->"In[1]:=",ExpressionUUID->"ab8b2749-3488-40a1-a17c-6c162efff34a"],

Cell[TextData[{
 "The interesting regime is dense 2D networks. The standard stress test is \
the ",
 StyleBox["PEPS overlap",
  FontSlant->"Italic"],
 ": a 2D lattice of tensors, copied so we have a \[OpenCurlyDoubleQuote]ket\
\[CloseCurlyDoubleQuote] and a \[OpenCurlyDoubleQuote]bra\
\[CloseCurlyDoubleQuote], with every bond and every physical leg contracted. \
The result is a single scalar. The construction depends on four parameters. \
Each one has a specific meaning:"
}], "Text",
 CellChangeTimes->{{3.988469803720872*^9, 
  3.98846982395669*^9}},ExpressionUUID->"e3288a72-d4b2-41a6-9923-\
7247b228add4"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["rows", "Code"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a130b29c-4e2f-46c6-81b6-23aa3d030c2a"],
 ", ",
 Cell[BoxData[
  StyleBox["cols", "Code"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1259043b-7751-4fe7-a9e0-cbe666cac087"],
 ": the shape of the 2D lattice. A PEPS at ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", 
    RowBox[{"rows", ",", " ", "cols"}], "}"}], "Code"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "08ea3676-265e-4172-ac63-4ed52bc1251d"],
 " has rows*cols sites, one tensor per site, arranged in a grid. Neighbors in \
the grid share a bond. Total tensors in the doubled overlap network is 2 * \
rows * cols."
}], "Item",ExpressionUUID->"914996b9-8a0e-4e23-bec3-3bd629e62222"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["chi", "Code"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3470d40b-6973-48ce-84c0-54eb50215840"],
 ": the ",
 StyleBox["bond dimension",
  FontSlant->"Italic"],
 ". Every internal bond between neighboring sites is an index of this \
dimension. Bigger chi means a richer ansatz and (much) more expensive \
contractions. This is the knob we will turn to make the contraction harder."
}], "Item",ExpressionUUID->"436e9b94-0422-40a6-9476-e61fe55ed537"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  StyleBox["d", "Code"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7ab5d7bd-e08e-4917-b109-d73df7e141b9"],
 ": the ",
 StyleBox["physical dimension",
  FontSlant->"Italic"],
 " at each site. For a spin-1/2 system, d = 2. The physical leg of each ket \
tensor contracts with the physical leg of the corresponding bra tensor."
}], "Item",ExpressionUUID->"0c8c07b4-58e5-472b-8f2c-27a8cd0623b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn1", "=", 
  RowBox[{"RandomTensorNetwork", "[", 
   RowBox[{"\"\<PEPS\>\"", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}], ",", "2", ",", "3"}], "]"}], 
   "]"}]}]], "Input",
