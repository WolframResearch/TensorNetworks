           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "   ", 
         RowBox[{"Echo", "[", "shape", "]"}], ";", "\n", "            ", 
         RowBox[{"<|", 
          RowBox[{
