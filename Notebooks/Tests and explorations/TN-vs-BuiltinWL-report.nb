Cell["\<\
Define a constructor that builds the doubled-PEPS overlap network from these \
four parameters:\
\>", "Text",ExpressionUUID->"f6866a25-a451-46cc-a2a4-3393bce40c72"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "pepsOverlapTN", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pepsOverlapTN", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rows_", ",", " ", "cols_"}], "}"}], ",", " ", "chi_", ",", " ", 
    
    RowBox[{"d_", " ", ":", " ", "2"}], ",", "args___"}], "]"}], " ", ":=", 
  "\n", "    ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ket", " ", "=", " ", 
      RowBox[{"BlockRandom", "[", 
       RowBox[{
        RowBox[{"SeedRandom", "[", 
         RowBox[{"31", " ", "+", " ", 
          RowBox[{"rows", " ", "*", " ", "1000"}], " ", "+", " ", 
          RowBox[{"cols", " ", "*", " ", "100"}], " ", "+", " ", "chi"}], 
         "]"}], ";", "\n", "                ", 
        RowBox[{"RandomTensorNetwork", "[", 
         RowBox[{
          RowBox[{"\"\<PEPS\>\"", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"rows", ",", " ", "cols"}], "}"}], ",", " ", "chi", ",", 
            " ", "d"}], "]"}], ",", "args"}], "]"}]}], "]"}]}], "}"}], ",", 
    "\n", "    ", 
    RowBox[{"{", 
     RowBox[{"idx", " ", "=", " ", 
      RowBox[{"ket", "[", "\"\<Hyperedges\>\"", "]"}]}], "}"}], ",", "\n", 
    "    ", 
    RowBox[{"{", 
     RowBox[{"shift", " ", "=", " ", 
      RowBox[{"Max", " ", "@@", " ", 
       RowBox[{"Flatten", " ", "@", " ", "idx"}]}]}], "}"}], ",", "\n", 
    "        ", 
    RowBox[{"TensorNetwork", "[", "\n", "            ", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"ket", "[", "\"\<Tensors\>\"", "]"}], ",", " ", 
        RowBox[{"Conjugate", " ", "/@", " ", 
         RowBox[{"ket", "[", "\"\<Tensors\>\"", "]"}]}]}], "]"}], ",", "\n", 
      "            ", 
      RowBox[{"Join", "[", 
       RowBox[{"idx", ",", " ", 
        RowBox[{"MapAt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", " ", "+", " ", "shift"}], " ", "&"}], ",", " ", "idx",
           ",", " ", 
          RowBox[{"{", 
           RowBox[{"All", ",", " ", 
            RowBox[{";;", " ", 
             RowBox[{"-", "2"}]}]}], "}"}]}], "]"}]}], "]"}]}], "\n", 
     "        ", "]"}]}], "\n", "    ", "]"}]}]}], "Code",
 CellChangeTimes->{{3.988470683883429*^9, 3.9884707056068153`*^9}, {
  3.988472586550516*^9, 3.988472589401206*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"d88b391e-e983-479b-80ee-4763f9cdc1d8"],

