Cell[CellGroupData[{

Cell["Factor 1: bond dimension scales the gap", "Subsection",
 CellChangeTimes->{
  3.988471491507182*^9},ExpressionUUID->"2d1d89f8-e7af-41d7-9935-\
f242fb1841da"],

Cell[TextData[{
 "The peak intermediate grows polynomially in the bond dimension chi. For the \
kernel's fixed heuristic, the ",
 StyleBox["price",
  FontSlant->"Italic"],
 " of a bad intermediate also grows with chi, so the speedup from path \
optimization gets larger as chi increases."
}], "Text",ExpressionUUID->"6b84c50e-a4a7-4e6e-8977-a2ac7c3c119f"],

Cell["Time PEPS 4x4 across three bond dimensions:", "Text",ExpressionUUID->"d6212165-1b3d-4169-afac-4593f884db8b"],

