Cell[BoxData[{
 RowBox[{"ClearAll", "[", 
  RowBox[{"intermediateTrajectory", ",", "peakIntermediate"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"intermediateTrajectory", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{"Cases", "[", 
    RowBox[{"expr", ",", "\n", "    ", 
     RowBox[{
      RowBox[{"e", " ", ":", " ", 
       RowBox[{"IgnoringInactive", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
          "ArrayDot", " ", "|", " ", "Dot", " ", "|", " ", "TensorContract", 
           " ", "|", " ", "TensorProduct", " ", "|", " ", "Transpose", " ", "|",
            " ", "ArrayReshape"}], ")"}], "[", "__", "]"}], "]"}]}], " ", ":>",
       "\n", "        ", 
      RowBox[{
      "Wolfram`TensorNetworks`PackageScope`symbolicTensorDimensions", "[", 
       "e", "]"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "Infinity"}], "}"}]}], "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"peakIntermediate", "[", "expr_", "]"}], " ", ":=", " ", 
  RowBox[{"Max", "[", 
   RowBox[{"Times", " ", "@@@", " ", 
    RowBox[{"intermediateTrajectory", "[", "expr", "]"}]}], "]"}]}]}], "Code",\

