           RowBox[{"\"\<Time (no path)\>\"", " ", "->", " ", "tN"}], ",", " ", 
           RowBox[{"\"\<Time (with path)\>\"", " ", "->", " ", "tO"}], ",", 
           " ", 
           RowBox[{"\"\<Speedup\>\"", " ", "->", " ", 
