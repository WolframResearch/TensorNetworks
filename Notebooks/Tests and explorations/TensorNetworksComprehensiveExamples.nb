\>", "Input",ExpressionUUID->"2aaf3463-bf2f-43ad-84fc-9ea4cbfbf31d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Path Validation", "Subsection",ExpressionUUID->"035fc8a5-ebde-4937-a597-dc54979b0f88"],

Cell["Test path validity.", "Text",ExpressionUUID->"6d64a839-9f1f-4fd4-a40f-d95fb2f70fc5"],

Cell["(* Test tree path validity. *)", "Text",ExpressionUUID->"1b46f3dd-5783-4b78-a567-841fffcd222c"],

Cell["TreePathQ[{{1}, {2}}]", "Input",ExpressionUUID->"3af20928-8a7b-478e-8152-b84066f93846"],

Cell["(* Test empty path. *)", "Text",ExpressionUUID->"ce2a198b-dce5-4911-92ce-9c6af4efc526"],

