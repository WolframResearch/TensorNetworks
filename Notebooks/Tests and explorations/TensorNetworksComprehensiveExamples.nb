Cell["(* Tensor contraction of rank-3 tensors. *)", "Text",ExpressionUUID->"32cdd684-f96b-4fed-9f07-620e2c8f6bc2"],

Cell["\<\
T1 = RandomReal[1, {2, 3, 4}]; T2 = RandomReal[1, {4, 3, 2}];
EinsteinSummation[{{i, j, k}, {k, j, l}} -> {i, l}, {T1, T2}]\
\>", "Input",ExpressionUUID->"e73f7e80-e104-46e5-b3d2-b11b3284b82e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["IndexedMultiply", "Section",ExpressionUUID->"35961c12-831b-4601-802d-37320bde6726"],

Cell["\<\
IndexedMultiply performs tensor contraction and returns both the resulting \
index structure and the contracted tensor as {indices, tensor}.\
\>", "Text",ExpressionUUID->"217188d8-9b95-47e9-b842-b8c585cfe67f"],

Cell[CellGroupData[{

Cell["Basic Contractions", "Subsection",ExpressionUUID->"ef0715b0-c4bc-42f5-91b6-4886f2834b50"],

Cell["Contract tensors and get both indices and result.", "Text",ExpressionUUID->"e868532a-c2a1-4a31-b254-bd167695cd14"],

Cell["(* Matrix multiplication returning {indices, result}. *)", "Text",ExpressionUUID->"e728f303-0e2e-490e-8eba-d05c6902c34f"],

Cell["IndexedMultiply[{{i, j}, {j, k}}, {A, B}]", "Input",ExpressionUUID->"72c4ffae-2dd9-46bc-9778-77bccb4d7843"],

Cell["\<\
(* Vector dot product. All indices contract, returns empty index list with \
scalar. *)\
\>", "Text",ExpressionUUID->"b8134905-1ff0-4e24-bc1a-df774cd40ee6"],

Cell["IndexedMultiply[{{i}, {i}}, {A[[All, 1]], A[[All, 2]]}]", "Input",ExpressionUUID->"b88076e3-4256-46d4-821c-b7d327904708"],

Cell["(* Chain of three matrices A(i,j) * B(j,k) * C(k,l). *)", "Text",ExpressionUUID->"e045d4f4-33e7-4542-9b83-6018074785fc"],

Cell["\<\
IndexedMultiply[{{i, j}, {j, k}, {k, l}}, {A, B, RandomReal[1, {4, 5}]}]\
\>", "Input",ExpressionUUID->"2e63e559-ae52-4847-8c09-10d1793e9233"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Element-wise and Special Operations", "Subsection",ExpressionUUID->"6a49bba6-79f8-457e-9508-bfaa551a7d2d"],

Cell["Handle element-wise products and special cases.", "Text",ExpressionUUID->"247d279a-91e7-405a-8b23-9078400723d1"],

Cell["\<\
(* Element-wise product (Hadamard): same indices on both tensors. *)\
\>", "Text",ExpressionUUID->"54463cbb-6667-46f4-af73-f85359648c8a"],

Cell["\<\
IndexedMultiply[{{i, j, k}, {i, j, k}}, {RandomReal[1, {2, 3, 4}], \
RandomReal[1, {2, 3, 4}]}]\
\>", "Input",ExpressionUUID->"bbef939c-d1fb-465e-9f5d-5aeb6888e948"],

Cell["(* Element-wise with sparse arrays. *)", "Text",ExpressionUUID->"40882dd8-99b2-4127-93d1-60dcf51c7f12"],

Cell["\<\
IndexedMultiply[{{i, j}, {i, j}}, {SparseArray[A], SparseArray[A]}]\
\>", "Input",ExpressionUUID->"ed6979ea-6b0c-4b37-9793-34e94e97007f"],

Cell["(* Multiply two scalars. *)", "Text",ExpressionUUID->"09ac934d-e76a-4ec5-ae87-b1f2c691a366"],

Cell["IndexedMultiply[{{}, {}}, {3., 5.}]", "Input",ExpressionUUID->"d41f56eb-50ad-49a1-9cf6-564acb9a1771"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Advanced Patterns", "Subsection",ExpressionUUID->"06b37b91-0165-4203-9fa1-c6f2d104671d"],

Cell["Transpose, diagonal, symbolic, and outer products.", "Text",ExpressionUUID->"e521bd7d-ba6f-40bb-b9df-0f53b7581b26"],

Cell["(* Implicit transpose: A(i,j) * A^T(j,i) gives A.A^T. *)", "Text",ExpressionUUID->"947ad849-2ee9-47a0-8858-0020687e37f2"],

Cell["IndexedMultiply[{{i, j}, {j, i}}, {A, Transpose[A]}]", "Input",ExpressionUUID->"49053002-fbe3-4456-8681-bad4b04da913"],

Cell["(* Contract diagonal matrices. *)", "Text",ExpressionUUID->"3912d6f9-bccd-41cc-b5f3-3ded93f17101"],

Cell["\<\
IndexedMultiply[{{i, i}, {i, i}}, {DiagonalMatrix[{1, 2}], DiagonalMatrix[{3, \
4}]}]\
\>", "Input",ExpressionUUID->"aeb8a4d7-87fb-4450-8b12-4b772b4e0e9f"],

Cell["(* Symbolic array multiplication with ArraySymbol. *)", "Text",ExpressionUUID->"7b6d101b-185d-4f76-87d3-1763ff479b6c"],

Cell["\<\
IndexedMultiply[{{i, j}, {j, k}}, {ArraySymbol[\"T\", {2, 3}], \
ArraySymbol[\"S\", {3, 4}]}]\
\>", "Input",ExpressionUUID->"a87d53b0-d316-410c-9c63-32db0d19ff52"],

Cell["\<\
(* Outer product: no shared indices, result is tensor product. *)\
\>", "Text",ExpressionUUID->"7ecab735-447b-4614-ae84-aa88cfb4c19e"],

Cell["IndexedMultiply[{{i}, {j}}, {Range[5], Range[6]}]", "Input",ExpressionUUID->"3c45c6e0-d315-4ce6-9cd9-d77c4eea53ae"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["ActivateTensors", "Section",ExpressionUUID->"3457255a-1975-427b-9ce8-4174cf84b805"],

Cell["\<\
ActivateTensors evaluates inactive tensor expressions. Use this to execute \
symbolic contraction expressions created with \"Inactive\" -> True.\
\>", "Text",ExpressionUUID->"658a7968-53a7-4fd9-9d4e-bc2a048b1c60"],

Cell[CellGroupData[{

Cell["Activating Contractions", "Subsection",ExpressionUUID->"2287929d-4a0d-4dd3-80c0-5a52952c8d0d"],

Cell["Evaluate inactive tensor operations.", "Text",ExpressionUUID->"5f20b284-bec4-4f62-b8c0-06cc62ac1373"],

Cell["(* Create inactive contraction then activate it. *)", "Text",ExpressionUUID->"fc50514a-78d3-471b-bf6a-29a20efcf5d6"],

Cell["\<\
exprInactive = TensorNetworkContraction[tn, path, \"Inactive\" -> True];
ActivateTensors[exprInactive]\
\>", "Input",ExpressionUUID->"fb3ae5e9-5eda-4e7b-89d4-dd8808b32fda"],

Cell["(* Activate a simple TensorContract expression. *)", "Text",ExpressionUUID->"98732e3e-7489-4a24-93f3-38e94b7b91e9"],

Cell["\<\
ActivateTensors[Inactive[TensorContract][Inactive[TensorProduct][A, B], {{2, \
3}}]]\
\>", "Input",ExpressionUUID->"1970ff94-3b81-4f94-873a-1d541df477bb"],

Cell["(* Activate with transpose. *)", "Text",ExpressionUUID->"37bb3170-5125-4487-a80c-115c2992dd9b"],

Cell["\<\
ActivateTensors[Inactive[Transpose][Inactive[TensorContract][Inactive[\
TensorProduct][A, B], {{2, 3}}], Cycles[{{1, 2}}]]]\
\>", "Input",ExpressionUUID->"f48dd3e1-e166-42b1-afcb-5bd2db065d87"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Products and Complex Expressions", "Subsection",ExpressionUUID->"8de13c26-1123-4e29-877b-c16055e6fbf1"],

Cell["Handle tensor products and nested expressions.", "Text",ExpressionUUID->"fa81bad2-82cc-45ca-b7ff-81bf07abf131"],

Cell["(* Activate tensor product. *)", "Text",ExpressionUUID->"35063f10-b275-4d8b-b0da-e53ff9785119"],

Cell["ActivateTensors[Inactive[TensorProduct][A, B, CC]]", "Input",ExpressionUUID->"b1be4932-ebe2-4e1d-b455-45838ef74af5"],

Cell["(* Activate with delta product. *)", "Text",ExpressionUUID->"90a89548-9168-480f-8783-607ae227db40"],

Cell["\<\
ActivateTensors[Inactive[TensorProduct][SymbolicDeltaProductArray[{2, 2}, \
{{1, 2}}], A]]\
\>", "Input",ExpressionUUID->"a8cb8697-17ea-479d-ac25-97b4a4fb5462"],

Cell["(* Activate a trace contraction. *)", "Text",ExpressionUUID->"e523273b-9303-492d-a064-ea0785f94f72"],

Cell["ActivateTensors[Inactive[TensorContract][t3, {{1, 2}}]]", "Input",ExpressionUUID->"b072db2f-cc4b-4e19-ad98-818008361f63"],

Cell["(* Chain contraction activation. *)", "Text",ExpressionUUID->"8dabbbfc-c04f-482a-b846-d8080f1389ca"],

Cell["\<\
ActivateTensors[Inactive[TensorContract][Inactive[TensorProduct][A, B, CC], \
{{2, 3}, {4, 5}}]]\
\>", "Input",ExpressionUUID->"a78d9351-8179-4a6e-9e1b-23a77e2e89c8"],

Cell["(* Generalized power activation. *)", "Text",ExpressionUUID->"efb1892f-e7fa-4599-ba49-1fd931bfa87f"],

Cell["\<\
ActivateTensors[Inactive[GeneralizedPower][TensorProduct, A, 2]]\
\>", "Input",ExpressionUUID->"4c2d887f-7f89-4470-bad1-9cafc875c603"],

Cell["(* Replace and reactivate. *)", "Text",ExpressionUUID->"355bac2e-7a08-4013-86fa-393ce37b0770"],

Cell["\<\
ActivateTensors[exprInactive /. Inactive[TensorContract][x_, y_] :> \
Inactive[TensorContract][x, y]]\
\>", "Input",ExpressionUUID->"62ad719e-c109-4d91-94cd-6f5e2f1b58b0"],

Cell["(* Build and activate custom expression. *)", "Text",ExpressionUUID->"340f60b2-d837-4a2a-8147-f2b4d2e05049"],

Cell["\<\
customExpr = Inactive[TensorContract][Inactive[TensorProduct][DD, DD], {{2, \
3}}];
ActivateTensors[customExpr]\
\>", "Input",ExpressionUUID->"f3ed56b5-202f-4ecc-8581-28af140551b7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["TensorNetwork", "Section",ExpressionUUID->"f253c027-ed66-4fc2-9b09-37056ce317d8"],

Cell["\<\
TensorNetwork creates a tensor network object from tensors and their index \
structure. Supports multiple input formats.\
\>", "Text",ExpressionUUID->"e01c3f8a-c173-40fe-8735-6c6053a354e7"],

Cell[CellGroupData[{

Cell["Basic Construction", "Subsection",ExpressionUUID->"7aa4bac8-e6fa-4d16-b755-ba119f0e51ef"],

Cell["Create networks from tensors and indices.", "Text",ExpressionUUID->"4353bbde-752f-49d9-804e-7c5bc8fb03f9"],

Cell["(* From tensors and integer edge lists. *)", "Text",ExpressionUUID->"fe474d07-3d73-41ba-abf2-edc4c6fbbb5a"],

Cell["TensorNetwork[{A, B}, {{1, 2}, {2, 3}}]", "Input",ExpressionUUID->"27e65a0c-d1b5-479a-bc31-a9efe2dea072"],

Cell["(* Named indices with explicit output (arrow notation). *)", "Text",ExpressionUUID->"eb7e22de-1e3f-4f36-be63-31507910ee5a"],

Cell["TensorNetwork[{A, B}, {{i, j}, {j, k}} -> {i, k}]", "Input",ExpressionUUID->"3524cd0a-7f42-4c32-b211-a2e2ba3dcbb6"],

Cell["(* With output permutation (Cycles specify permutation). *)", "Text",ExpressionUUID->"7a24b23d-0b69-4a79-86aa-3edff7b43573"],

Cell["TensorNetwork[{A, B}, {{i, j}, {j, k}}, Cycles[{{1, 2}}]]", "Input",ExpressionUUID->"fe12f39d-568b-4708-81e6-b18e1a9b2293"],

Cell["(* Full cyclic contraction (trace-like). *)", "Text",ExpressionUUID->"e7077aae-ea7e-4e4f-add1-d46da4d9fa15"],

Cell["TensorNetwork[{A, B, CC}, indices]", "Input",ExpressionUUID->"b2e4652e-b34f-4a63-a5e0-859759a7ecf2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["From Mathematica Expressions", "Subsection",ExpressionUUID->"8bfb74e2-e734-4791-8fc5-0df59051118f"],

Cell["Create from standard tensor operations.", "Text",ExpressionUUID->"40f4a6ff-5bad-4b16-baad-a279c0d9eb27"],

Cell["(* From TensorContract expression. *)", "Text",ExpressionUUID->"2c75b877-23ac-4c3d-96d9-de784c37d50b"],

Cell["TensorNetwork[TensorContract[TensorProduct[A, B], {{2, 3}}]]", "Input",ExpressionUUID->"af2f639b-7254-45da-bfa2-6f42ff58b5fe"],

Cell["(* From transposed contraction. *)", "Text",ExpressionUUID->"480cf061-23b5-43c0-a861-1c117aae904d"],

Cell["\<\
TensorNetwork[Transpose[TensorContract[TensorProduct[A, B], {{2, 3}}], \
Cycles[{{1, 2}}]]]\
\>", "Input",ExpressionUUID->"889d646c-6404-4e48-a536-0793cd08cf52"]
}, Open  ]],

Cell[CellGroupData[{

Cell["From Graphs and Hypergraphs", "Subsection",ExpressionUUID->"bde4851c-afb5-4c85-b9ad-80c85301437b"],

Cell["Create from graph structures.", "Text",ExpressionUUID->"15a67f4d-0e63-400a-a602-f59b13e4606d"],

Cell["(* From TensorNetworkGraph. *)", "Text",ExpressionUUID->"513862c9-0333-453e-95b0-d4da2dbce5fa"],

Cell["TensorNetwork[g]", "Input",ExpressionUUID->"0b071852-26e6-471d-805a-60415253abea"],

Cell["(* From hypergraph structure only (no tensors). *)", "Text",ExpressionUUID->"e229dd5d-3e41-491b-81e3-2476070b209b"],

Cell["TensorNetwork[{{1, 2}, {2, 3}}]", "Input",ExpressionUUID->"d3d2eafd-d4e4-4dec-b55a-d0327616ecd0"],

Cell["(* Hypergraph with output specification. *)", "Text",ExpressionUUID->"912a1f94-a936-47c2-84ea-adf65c86bcb4"],

Cell["TensorNetwork[{{1, 2}, {2, 3}} -> {1, 3}]", "Input",ExpressionUUID->"7420d9ff-fdc8-4514-9fe1-5ff8ff062f89"],

Cell["(* With ArraySymbol placeholders. *)", "Text",ExpressionUUID->"2b2dd114-e3e9-44f4-9e41-e9848b2d7931"],

Cell["\<\
TensorNetwork[{ArraySymbol[\"X\", {2, 2}], ArraySymbol[\"Y\", {2, 2}]}, {{1, \
2}, {2, 3}}]\
\>", "Input",ExpressionUUID->"bf5cb720-a621-492a-88c5-f8a769235ff3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Accessing Properties", "Subsection",ExpressionUUID->"235024fa-1daa-474e-a028-88491ab2384a"],

Cell["Query network properties.", "Text",ExpressionUUID->"00314aea-1a56-481b-a96b-04bd0ca82658"],

Cell["(* Access all network properties. *)", "Text",ExpressionUUID->"7babcc74-0bd5-47d7-aa45-a73c9c1bfc63"],

Cell["tn[\"Properties\"]", "Input",ExpressionUUID->"41bc9148-15c1-4172-8e47-f2228ed234f9"],

Cell["(* Get tensors. *)", "Text",ExpressionUUID->"0eb4cb14-cce4-4cf6-b33a-f034ff22da5f"],

Cell["tn[\"Tensors\"]", "Input",ExpressionUUID->"c812e483-f435-4c66-a255-80f5563d2c61"],

Cell["(* Get hyperedges (index structure). *)", "Text",ExpressionUUID->"c420cb45-bd5c-45fa-854a-9a4750fbf11c"],

Cell["tn[\"Hyperedges\"]", "Input",ExpressionUUID->"66e69eb1-c1f9-416c-a15b-1eabc9e0bced"],

Cell["(* Get indices. *)", "Text",ExpressionUUID->"8bb4e8d8-f3e9-4154-b4b1-19e529d455b4"],

Cell["tn[\"Indices\"]", "Input",ExpressionUUID->"846c4a9d-ce5f-4012-a666-cdafeb2e55f5"],

Cell["(* Get free (uncontracted) indices. *)", "Text",ExpressionUUID->"4f137d58-6171-4678-8d1a-01d984d48c81"],

Cell["tn[\"FreeIndices\"]", "Input",ExpressionUUID->"1381e88c-b9e7-4cea-8d3c-b2db9bcd9a12"],

Cell["(* Get tensor dimensions. *)", "Text",ExpressionUUID->"f4fa8706-270b-4e92-af85-7b1f66a9e43c"],

Cell["tn[\"Dimensions\"]", "Input",ExpressionUUID->"dbd9cf2e-78fe-40b2-9fdf-15d91f4a4788"],

Cell["(* Get network size (number of tensors). *)", "Text",ExpressionUUID->"24ce75f1-f3e9-4668-9791-32ba3e5eb2a2"],

Cell["tn[\"Size\"]", "Input",ExpressionUUID->"580f3e21-3484-443a-a535-8b81f821d6a7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["TensorNetworkQ", "Section",ExpressionUUID->"6e39d8c7-a30c-4379-b11d-97241d20202a"],

Cell["\<\
TensorNetworkQ tests whether an expression is a valid TensorNetwork with \
consistent dimensions.\
\>", "Text",ExpressionUUID->"a6bd8c26-b888-4099-a48a-9fb766a4be62"],

Cell[CellGroupData[{

Cell["Validation Tests", "Subsection",ExpressionUUID->"a029955b-2d8a-496a-b105-5792420715eb"],

Cell["Test various network types.", "Text",ExpressionUUID->"8e262ca3-9d62-4d94-8a37-35c11b52b46e"],

Cell["(* Test valid network. *)", "Text",ExpressionUUID->"a81c24b9-fafd-434a-a727-897af4cf764a"],

Cell["TensorNetworkQ[tn]", "Input",ExpressionUUID->"0c7fdf12-a3b7-45a1-acae-8dfaecf2b59c"],

Cell["(* Test network with self-loop (trace). *)", "Text",ExpressionUUID->"ee740bf9-3246-419c-9dd4-d17cf8b886a4"],

Cell["TensorNetworkQ[TensorNetwork[{A}, {{1, 1}}]]", "Input",ExpressionUUID->"06d37904-7e2b-4f89-af59-9f2c5e8888a8"],

Cell["(* Test network without contraction. *)", "Text",ExpressionUUID->"da963ded-3d90-469e-9cc6-9321b44c1633"],

Cell["TensorNetworkQ[TensorNetwork[{A}, {{1, 2}}]]", "Input",ExpressionUUID->"0d8a576b-6915-4d99-8a19-915df5105444"],

Cell["(* Test non-network object. *)", "Text",ExpressionUUID->"1b238a0a-1c20-4c66-9053-835be82783c7"],

Cell["TensorNetworkQ[\"not a network\"]", "Input",ExpressionUUID->"6daab38e-0c02-4bf8-867d-7c6e5d3a51ab"],

Cell["(* Test binary network. *)", "Text",ExpressionUUID->"8d48313b-7678-43a1-bb8e-0867d82471da"],

Cell["TensorNetworkQ[TensorNetwork[{A, B}, {{1, 2}, {2, 3}}]]", "Input",ExpressionUUID->"133ed33c-01e2-4d1b-b576-04e1eb124af4"],

Cell["(* Test with permutation. *)", "Text",ExpressionUUID->"85ed41aa-fc13-4cc1-b64b-3685b272fd67"],

Cell["\<\
TensorNetworkQ[TensorNetwork[{A, B}, {{1, 2}, {2, 3}}, Cycles[{{1, 2}}]]]\
\>", "Input",ExpressionUUID->"ee165b43-a889-4b4f-a76b-f1a1d2214a87"],

Cell["(* Test with Automatic permutation. *)", "Text",ExpressionUUID->"d9016a4a-bcd6-420a-80de-6a045d79cbf5"],

Cell["\<\
TensorNetworkQ[TensorNetwork[{A, B}, {{1, 2}, {2, 3}}, Automatic]]\
\>", "Input",ExpressionUUID->"42777dbc-05f4-48d5-82df-6ddc5f745a0e"],

Cell["(* Test after adding tensor. *)", "Text",ExpressionUUID->"54ab8947-8efb-4900-8125-741395c11dfa"],

Cell["TensorNetworkQ[TensorNetworkAdd[tn, DD, {m, n}]]", "Input",ExpressionUUID->"7b1857f8-9626-4138-8cc2-e013f836b416"],

Cell["(* Test after deleting tensor. *)", "Text",ExpressionUUID->"52a3a621-dabd-4e80-8b05-8ac5fe91a7e4"],

Cell["TensorNetworkQ[TensorNetworkDelete[tn, -1]]", "Input",ExpressionUUID->"b74b4f6c-20dc-4fed-a0ac-15b05c324363"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["TensorNetworkData", "Section",ExpressionUUID->"7c2334b8-0326-4a0b-a11b-3960a17a739e"],

Cell["\<\
TensorNetworkData extracts structural data from a tensor network as an \
Association.\
\>", "Text",ExpressionUUID->"7575a971-103c-430f-b998-f407955e48e3"],

Cell[CellGroupData[{

Cell["Data Extraction", "Subsection",ExpressionUUID->"c9d0ebd4-0a6f-4713-9c43-d2c126b3e8f2"],

Cell["Extract data from various network types.", "Text",ExpressionUUID->"485c01bd-9a5f-4869-9e18-7a3a34971cea"],

Cell["(* Data from basic network. *)", "Text",ExpressionUUID->"94d13f82-2bea-4d57-8053-42bb35bdfabf"],

Cell["TensorNetworkData[tn]", "Input",ExpressionUUID->"1c10a516-8dd9-4415-90a1-cd21fd0d95c9"],

Cell["(* Data from binary network. *)", "Text",ExpressionUUID->"68d091d9-761a-4c85-b48a-2c935998ba80"],

Cell["TensorNetworkData[BinaryTensorNetwork[tn]]", "Input",ExpressionUUID->"270db52f-ff36-4cc9-9f17-5ac6a96047f7"],

Cell["(* Data from sparse network. *)", "Text",ExpressionUUID->"b54cc771-b278-4c6d-989f-ffc36092366a"],

Cell["TensorNetworkData[SparseTensorNetwork[tn]]", "Input",ExpressionUUID->"f6dcb790-6629-402b-a697-dd08ce74e301"],

Cell["(* Data after adding tensor. *)", "Text",ExpressionUUID->"12e0307e-5cd7-40f2-88c1-2e8bc93c66cb"],

Cell["TensorNetworkData[TensorNetworkAdd[tn, DD, {m, n}]]", "Input",ExpressionUUID->"18ac4b8f-e681-4a29-bc29-b9bc7a64f922"],

Cell["(* Data after deleting tensor. *)", "Text",ExpressionUUID->"3ff00dac-af35-4189-ab7d-326dded2256c"],

Cell["TensorNetworkData[TensorNetworkDelete[tn, -1]]", "Input",ExpressionUUID->"1bf9f2b6-e32d-4ab8-bf0c-c19fa3658c5f"],

Cell["(* Data from random network. *)", "Text",ExpressionUUID->"b5bef53f-fb5a-49d0-84d6-3feef952011d"],

Cell["TensorNetworkData[RandomTensorNetwork[{4, 4}, 3]]", "Input",ExpressionUUID->"8a34cc40-2e17-4b86-b99c-d0d415676f91"],

Cell["(* Data from closed loop network. *)", "Text",ExpressionUUID->"bf00c0e5-24b1-48da-86f9-784f6f20edbb"],

Cell["TensorNetworkData[TensorNetwork[{A, B}, {{i, j}, {j, i}}]]", "Input",ExpressionUUID->"d796f32d-5e52-4905-9a20-5f80d37d1471"],

Cell["(* Data from scalar network. *)", "Text",ExpressionUUID->"f9c58a53-09dc-455f-b50c-6efb6c91e1f7"],

Cell["TensorNetworkData[TensorNetwork[{A}, {{}}]]", "Input",ExpressionUUID->"3b6121bd-a830-4561-a7c5-33a5c1f31663"],

Cell["(* Data from integer-indexed network. *)", "Text",ExpressionUUID->"fd6385a9-ae9b-429c-8c33-ee15c2afcf3d"],

Cell["TensorNetworkData[TensorNetwork[{A, B}, {{1, 2}, {2, 1}}]]", "Input",ExpressionUUID->"928a396a-1455-418e-8b84-0ac07fad2de0"],

Cell["(* Data with symbolic arrays. *)", "Text",ExpressionUUID->"33429128-e1a6-4293-b717-a7124999c5fe"],

Cell["\<\
TensorNetworkData[TensorNetwork[{ArraySymbol[\"X\", {2, 2}], \
ArraySymbol[\"Y\", {2, 2}]}, {{1, 2}, {2, 3}}]]\
\>", "Input",ExpressionUUID->"c2c96fb0-fae3-497d-a3d3-958255df69a6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["RandomTensorNetwork", "Section",ExpressionUUID->"45423019-eb5e-4cd8-b1e9-c4188ccfe449"],

Cell["\<\
RandomTensorNetwork generates random tensor networks with various structures \
including MPS, MPO, TT, PEPS, TTN, and MERA.\
\>", "Text",ExpressionUUID->"bf85bca7-785f-4330-9467-8ec0f5c644ee"],

Cell[CellGroupData[{

Cell["Random Graph Networks", "Subsection",ExpressionUUID->"44ecd9a9-8d96-4848-8aac-29008d9a999b"],

Cell["Create random networks from graph specifications.", "Text",ExpressionUUID->"c22e463a-df00-4e45-941d-ab06a9ca3dd7"],

Cell["(* {6, 8} = 6 vertices, 8 edges; 4 = max bond dimension. *)", "Text",ExpressionUUID->"1075b637-c65b-46be-b3da-9cb4874f884b"],

Cell["RandomTensorNetwork[{6, 8}, 4]", "Input",ExpressionUUID->"741b53bd-7309-4e75-a001-fa5826a80e79"],

Cell["(* Fixed bond dimension (exactly 3 for all bonds). *)", "Text",ExpressionUUID->"6e72e4ad-4e59-4c95-afdd-9e8899081d48"],

Cell["RandomTensorNetwork[{6, 8}, {3}]", "Input",ExpressionUUID->"ad6d4b07-0d34-4bdd-b839-a517d241b3da"],

Cell["(* With additional physical dimensions (extra legs). *)", "Text",ExpressionUUID->"93c7724a-e07c-45cd-bbc9-55ddbe157689"],

Cell["RandomTensorNetwork[{6, 8}, 4, 1]", "Input",ExpressionUUID->"7f5a124a-3536-4b05-8cfa-46780f4803c7"],

Cell["(* Complex-valued random network. *)", "Text",ExpressionUUID->"98c5e628-a041-413e-89c9-26821a7772cb"],

Cell["RandomTensorNetwork[{6, 8}, {3}, 2, Method -> \"Complex\"]", "Input",ExpressionUUID->"d912126d-2b54-4d30-aa9a-38ae91fbe55e"],

Cell["(* From explicit graph. *)", "Text",ExpressionUUID->"0652bfae-449a-4fda-9214-7573db5332c9"],

Cell["RandomTensorNetwork[RandomGraph[{6, 8}], 4]", "Input",ExpressionUUID->"a356fe0d-1145-4b19-81fa-481b54a54a8c"],

Cell["(* Complex from explicit graph. *)", "Text",ExpressionUUID->"76669ea6-9632-4426-a0ba-72a991b7364c"],

Cell["\<\
RandomTensorNetwork[RandomGraph[{6, 8}], {3}, 1, Method -> \"Complex\"]\
\>", "Input",ExpressionUUID->"a39901b9-80ff-4434-9068-9e14c5be1f7a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Matrix Product States (MPS)", "Subsection",ExpressionUUID->"fc240103-5ef4-4e79-ab46-b599fe58c2a1"],

Cell["1D chain tensor networks.", "Text",ExpressionUUID->"82b4b134-9fa9-4e05-aee3-ded89a4cadb4"],

Cell["(* Open boundary MPS: MPS[length, bondDim, physicalDim]. *)", "Text",ExpressionUUID->"4aa72687-119b-4e3b-b9d5-4a4a7974a6ac"],

Cell["RandomTensorNetwork[\"MPS\"[6, 3, 2]]", "Input",ExpressionUUID->"856c17a7-b333-4006-a70b-10448d4d2b27"],

Cell["(* Periodic MPS (ring). *)", "Text",ExpressionUUID->"8fa721e4-e6d7-4764-8608-0ab494231394"],

Cell["\<\
RandomTensorNetwork[\"MPS\"[6, 3, 2], \"Boundary\" -> \"Periodic\"]\
\>", "Input",ExpressionUUID->"5d67abc6-6377-4781-a1cf-72cb7a465078"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Other Architectures", "Subsection",ExpressionUUID->"e4d8c28c-7c60-4801-b009-5d2e1efd7e17"],

Cell["TT, MPO, and other structures.", "Text",ExpressionUUID->"bd5cfcab-c324-48cd-b83b-69d9a368ca63"],

Cell["(* Tensor Train (MPS without physical legs). *)", "Text",ExpressionUUID->"934ea8d9-ccb2-43a0-96d2-90d61725f2b5"],

Cell["RandomTensorNetwork[\"TT\"[6, 3]]", "Input",ExpressionUUID->"39b8dd42-6bb0-44bb-b783-c1e6a4b4eac5"],

Cell["\<\
(* Matrix Product Operator (input and output physical indices). *)\
\>", "Text",ExpressionUUID->"9512d3cf-93a2-4e66-8eaf-eb2c9b9e3df0"],

Cell["RandomTensorNetwork[\"MPO\"[4, 2, 2]]", "Input",ExpressionUUID->"5670b0f9-bbc0-4a44-a5ae-9e2e77c0812c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["TensorNetworkAdd and TensorNetworkDelete", "Section",ExpressionUUID->"fd8bf80e-ee21-4dde-a345-6a5ce7b21755"],

Cell["\<\
TensorNetworkAdd appends a tensor with specified indices. TensorNetworkDelete \
removes a tensor by index.\
\>", "Text",ExpressionUUID->"3baffc13-8908-4556-b32b-4d90ff2dde1a"],

Cell[CellGroupData[{

Cell["TensorNetworkAdd", "Subsection",ExpressionUUID->"a79a1190-ca0e-4252-bef4-1bdd95f51350"],

Cell["Add tensors to networks.", "Text",ExpressionUUID->"8946bc63-2656-4e20-b6ac-f04b038d6864"],

Cell["(* Add a 2x2 matrix with new indices. *)", "Text",ExpressionUUID->"ff9f8fdf-430b-49c2-8cb5-718bd750cc02"],

Cell["TensorNetworkAdd[tn, DD, {m, n}]", "Input",ExpressionUUID->"abc9642b-4cd3-4111-a977-ddbf503328b9"],

Cell["(* Add rank-3 tensor. *)", "Text",ExpressionUUID->"1b3138d8-d22a-453e-b30f-eed39ac78164"],

Cell["TensorNetworkAdd[tn, RandomReal[1, {2, 2, 2}], {m, n, k}]", "Input",ExpressionUUID->"5ab7a757-a07e-477f-8270-0e132f563888"],

Cell["(* Add complex tensor with existing indices. *)", "Text",ExpressionUUID->"7e52af38-27c8-4dbc-ab29-0959e8473712"],

Cell["\<\
TensorNetworkAdd[tn, RandomComplex[{-1 - I, 1 + I}, {2, 2}], {i, j}]\
\>", "Input",ExpressionUUID->"c26d0bb8-6723-4fec-aa78-edbd538fc216"],

Cell["(* Add to modified network. *)", "Text",ExpressionUUID->"385fe2b9-6a7f-42d1-af98-acafc32d30b7"],

Cell["TensorNetworkAdd[TensorNetworkDelete[tn, -1], CC, {k, i}]", "Input",ExpressionUUID->"79122f0a-9102-4ff7-944f-d2a5c950dba2"],

Cell["(* Build chain incrementally. *)", "Text",ExpressionUUID->"a55f4d81-8951-457f-8597-7df5343136c4"],

Cell["TensorNetworkAdd[TensorNetwork[{A}, {{i, j}}], B, {j, k}]", "Input",ExpressionUUID->"0fb25bca-2487-4dd8-bf06-f1904bc2fbea"],

Cell["(* Add with integer indices. *)", "Text",ExpressionUUID->"07ad3954-eb08-4091-bf16-9124aa430f5f"],

Cell["\<\
TensorNetworkAdd[TensorNetwork[{A, B}, {{1, 2}, {2, 3}}], CC, {3, 1}]\
\>", "Input",ExpressionUUID->"6c8b685b-6e22-4308-a1f7-7b84337864e9"],

Cell["(* Add symbolic array. *)", "Text",ExpressionUUID->"fd9db7e3-d6de-4bdb-8d67-b7bd9274feb0"],

Cell["TensorNetworkAdd[tn, ArraySymbol[\"New\", {2, 2}], {p, q}]", "Input",ExpressionUUID->"d931aa38-3d1d-4133-b4ab-9e9c6171fdd9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["TensorNetworkDelete", "Subsection",ExpressionUUID->"c8f6b728-1eff-4d82-8f08-5e0792d76759"],

Cell["Remove tensors from networks.", "Text",ExpressionUUID->"2dba30fe-6ce1-496e-8d80-283496ae0e0a"],

Cell["(* Delete last tensor. *)", "Text",ExpressionUUID->"22be832a-870b-4867-9ccf-eda49bad0de7"],

Cell["TensorNetworkDelete[tn, -1]", "Input",ExpressionUUID->"b52eda63-733e-41ad-971d-8104137cde5e"],

Cell["(* Delete first tensor. *)", "Text",ExpressionUUID->"f46a4048-d378-4141-8111-33a067034131"],

Cell["TensorNetworkDelete[tn, 1]", "Input",ExpressionUUID->"527e56ac-a17c-4a64-b84a-c3b9d22a37e6"],

Cell["(* Delete from augmented network. *)", "Text",ExpressionUUID->"9b7783ff-1ebb-4dba-8d98-fa9125e46e9f"],

Cell["TensorNetworkDelete[TensorNetworkAdd[tn, DD, {m, n}], 4]", "Input",ExpressionUUID->"b42eda92-e2de-4e9a-a27b-1dcc3063364e"],

Cell["(* Delete middle tensor. *)", "Text",ExpressionUUID->"168fbd30-e9f4-4f94-93d6-08dda74226d1"],

Cell["TensorNetworkDelete[TensorNetwork[{A, B, CC}, indices], 2]", "Input",ExpressionUUID->"9a9c082c-4c4c-43a7-b1f4-58d72abda437"],

Cell["(* Delete with integer indices. *)", "Text",ExpressionUUID->"3aefeeef-cf15-4f5d-b8c1-6f745a38bcc3"],

Cell["\<\
TensorNetworkDelete[TensorNetwork[{A, B, CC}, {{1, 2}, {2, 3}, {3, 1}}], 2]\
\>", "Input",ExpressionUUID->"23463d42-fb41-4a4e-a81c-69260decb217"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["BinaryTensorNetwork and SparseTensorNetwork", "Section",ExpressionUUID->"24850d0f-9054-4da4-b9fe-dd201434f943"],

Cell["\<\
BinaryTensorNetwork converts to binary (degree 2) hyperedges. \
SparseTensorNetwork converts tensors to SparseArray format.\
\>", "Text",ExpressionUUID->"ec8ae811-7745-4db2-9eda-b4bbcf1db18c"],

Cell[CellGroupData[{

Cell["BinaryTensorNetwork", "Subsection",ExpressionUUID->"aca6902b-4769-4ace-ac08-dde29da6fc7a"],

Cell["Convert to binary form.", "Text",ExpressionUUID->"e2433b35-7180-4221-832e-2c158188f3bd"],

Cell["(* Convert to binary form. *)", "Text",ExpressionUUID->"04c94817-c44f-47a2-8d94-c34bd6551eb2"],

Cell["BinaryTensorNetwork[tn]", "Input",ExpressionUUID->"3f048267-4c45-45d6-a796-e83f96bb5e13"],

Cell["(* Binary from closed loop. *)", "Text",ExpressionUUID->"8cb14b2b-f081-4bb6-89e0-6bd194441767"],

Cell["BinaryTensorNetwork[TensorNetwork[{A, B}, {{i, j}, {j, i}}]]", "Input",ExpressionUUID->"e54b29ab-b2a7-4c90-97a7-4ec27a223d33"],

Cell["(* Binary from random network. *)", "Text",ExpressionUUID->"93b237d0-6995-4f11-b03c-b8d75ec06a6d"],

Cell["BinaryTensorNetwork[RandomTensorNetwork[{5, 5}, 3]]", "Input",ExpressionUUID->"fb1a6fbd-8f7f-4934-8582-70d8e12d560d"],

Cell["(* Binary from sparse network. *)", "Text",ExpressionUUID->"c4710e5c-75fe-424d-89ef-61b3ea553207"],

