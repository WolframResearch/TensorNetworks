Notebook[{

Cell[CellGroupData[{
Cell["TensorNetworks Comprehensive Examples", "Title",ExpressionUUID->"ea48b63d-68b7-4de6-be75-25bae25f7b94"],

Cell["A Complete Guide with Runnable Examples for Every Function", "Subtitle",ExpressionUUID->"df4150e5-3ca8-4aaf-8b72-4dea696f9e2b"],

Cell["\<\
This notebook contains comprehensive examples for all functions in the \
Wolfram TensorNetworks package. Run the Setup section first to initialize \
required variables.\
\>", "Text",ExpressionUUID->"78c3d0ac-c2c7-4071-88ee-2a32388925a0"],

Cell[CellGroupData[{

Cell["Setup and Initialization", "Section",ExpressionUUID->"d2414120-3cd8-42d2-a775-aaa761163b81"],

Cell["\<\
Load the package and initialize variables used throughout the examples. Run \
this cell first.\
\>", "Text",ExpressionUUID->"de6d05ed-c510-42b3-91ad-eecf022cb4c5"],

Cell["\<\

(* Load the TensorNetworks package *)
Needs[\"Wolfram`TensorNetworks`\"];

(* Set random seed for reproducibility *)
SeedRandom[1];

(* === Basic Tensors === *)
(* 2x3 matrix *)
A = RandomReal[1, {2, 3}];
(* 3x4 matrix *)
B = RandomReal[1, {3, 4}];
(* 4x2 matrix for cyclic contraction *)
CC = RandomReal[1, {4, 2}];
(* 2x2 square matrix *)
DD = RandomReal[1, {2, 2}];
(* Complex matrix *)
EE = RandomComplex[{-1 - I, 1 + I}, {2, 2}];

(* === Index symbols === *)
(* Named indices for readable contractions *)
{i, j, k, l, m, n, p, q} = Table[Symbol[\"idx\" <> ToString[x]], {x, 8}];

(* === Basic TensorNetwork objects === *)
(* Cyclic contraction network: A(i,j) B(j,k) C(k,i) *)
indices = {{i, j}, {j, k}, {k, i}};
tn = TensorNetwork[{A, B, CC}, indices];

(* Graph representation *)
g = ToTensorNetworkGraph[tn];

(* Extract network data *)
data = TensorNetworkData[tn];

(* Find contraction path *)
path = TensorNetworkFindContractionPath[tn];
treePath = PathToTreePath[path, data[\"Vertices\"]];

(* === MPS (Matrix Product State) networks === *)
(* Open boundary MPS: 5 sites, bond dim 3, physical dim 2 *)
mps = RandomTensorNetwork[\"MPS\"[5, 3, 2]];
(* Periodic boundary MPS *)
mps2 = RandomTensorNetwork[\"MPS\"[5, 3, 2], \"Boundary\" -> \"Periodic\"];

(* === Size dictionary for path algorithms === *)
sizeDict = <|i -> 2, j -> 3, k -> 4, l -> 2, m -> 2, n -> 3|>;

(* === Young tableaux for symmetry operations === *)
yt1 = YoungTableau[{{1, 2}, {3}}];
yt2 = YoungTableau[{2, 1}];

(* === Rank-3 tensor for symmetry examples === *)
t3 = RandomReal[1, {2, 2, 2}];

(* === Cyclic graph for cycle removal examples === *)
cyc = ToTensorNetworkGraph[{A, B, CC}, {{1, 2}, {2, 3}, {3, 1}}];

Print[\"Setup complete. All variables initialized.\"];
\
\>", "Input",ExpressionUUID->"eb155ce8-2912-47c3-a950-2609b74e2a5b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["EinsteinSummation", "Section",ExpressionUUID->"e509004e-a5f6-4e65-aa20-081e1f6cce7c"],

Cell["\<\
EinsteinSummation performs tensor contractions using Einstein summation \
convention. Repeated indices are summed over (contracted), while unique \
indices remain free in the output.\
\>", "Text",ExpressionUUID->"d58f31c9-3b10-4d59-81db-fd8375c513cd"],

Cell[CellGroupData[{

Cell["Basic Index Notation", "Subsection",ExpressionUUID->"0667494e-db1c-4bf6-8063-6485b0346e56"],

Cell["\<\
Use nested lists to specify indices for each tensor. The arrow notation \
specifies output indices.\
\>", "Text",ExpressionUUID->"bce3f241-2dcf-4bfe-9597-d5a041f88eb6"],

Cell["\<\
(* Matrix multiplication A.B using index notation. A has indices {i,j}, B has \
indices {j,k}, output has {i,k}. Index j is repeated so it gets contracted. *)\
\>", "Text",ExpressionUUID->"cab9fac5-d1a2-453d-a36c-bf02d404cf59"],

Cell["EinsteinSummation[{{i, j}, {j, k}} -> {i, k}, {A, B}]", "Input",ExpressionUUID->"44a18199-86bf-4021-8bbc-3bec29da595e"],

Cell["\<\
(* Matrix multiplication without explicit output. Free indices appear in \
order of first occurrence. *)\
\>", "Text",ExpressionUUID->"38bd4444-8ad1-463c-ad8e-34469370e393"],

Cell["EinsteinSummation[{{i, j}, {j, k}}, {A, B}]", "Input",ExpressionUUID->"655ad86f-a6f9-4209-b1f0-f4566f49ef74"]
}, Open  ]],

Cell[CellGroupData[{

Cell["String Notation (NumPy-style)", "Subsection",ExpressionUUID->"ace00325-c9aa-4de7-9418-bace337d70e2"],

Cell["\<\
Use string notation similar to NumPy's einsum for compact expressions.\
\>", "Text",ExpressionUUID->"7a24c1f7-7a9a-4732-a35c-828cba3641ac"],

Cell["\<\
(* Matrix multiplication using string notation: tensor 1 has indices ij, \
tensor 2 has jk, output is ik. *)\
\>", "Text",ExpressionUUID->"9feabf46-2b9a-4dc8-a991-d5fa659850e9"],

Cell["EinsteinSummation[\"ij,jk->ik\", {A, B}]", "Input",ExpressionUUID->"d2d6b8a8-846a-41b4-9bfb-8ffc7a13a3c7"],

Cell["\<\
(* String notation without explicit output. Free indices kept, contracted \
indices summed. *)\
\>", "Text",ExpressionUUID->"ba6fb5ca-a2fc-4720-a6fd-94f985f155cc"],

Cell["EinsteinSummation[\"ij,jk\", {A, B}]", "Input",ExpressionUUID->"905907bd-697a-4b34-9332-85143249dbdc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Trace and Full Contraction", "Subsection",ExpressionUUID->"98401570-899b-44d0-97ca-fdc14e8e223a"],

Cell["Contract all indices to produce a scalar result.", "Text",
 CellChangeTimes->{
  3.978708136995892*^9},ExpressionUUID->"9d5f2731-8fa3-4dca-a548-\
d01ba579989e"],

Cell["\<\
(* Full contraction of three matrices into a scalar (Tr[A.B.C]). *)\
\>", "Text",ExpressionUUID->"48ef213d-3531-4067-889f-680c1c6e30bb"],

Cell["\<\
EinsteinSummation[{{i, j}, {j, k}, {k, i}} -> {}, {A, B, CC}]\
\>", "Input",ExpressionUUID->"9153f6ae-eef6-4880-a5a9-3bd7f7f890e3"],

Cell["(* Trace: diagonal elements are summed. *)", "Text",ExpressionUUID->"48394264-b12f-4ae8-955c-5c35df7c8c18"],

Cell["EinsteinSummation[{{i, i}}, {DD}]", "Input",ExpressionUUID->"f4f406a1-e645-4e5c-aa1e-27287827a0e7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Scalar and Vector Operations", "Subsection",ExpressionUUID->"92f2da83-1ab6-4c8b-8140-bb2a3dcca29f"],

Cell["Handle scalars and vectors.", "Text",ExpressionUUID->"5ada1eef-62ca-4354-9428-6f16d7da3d6e"],

Cell["\<\
(* Multiply two scalars. Empty index lists {} indicate scalars. *)\
\>", "Text",ExpressionUUID->"a93609fa-a80b-4833-be2c-a7683f752e86"],

Cell["EinsteinSummation[{{}, {}}, {1.2, 3.4}]", "Input",ExpressionUUID->"686fc75f-e99e-4e8e-b4cf-fc5b992c281e"],

Cell["(* Dot product of two vectors. *)", "Text",ExpressionUUID->"2ea49fd3-b66b-4c21-9097-a91a03f27f4b"],

Cell["EinsteinSummation[{{i}, {i}}, {A[[All, 1]], A[[All, 2]]}]", "Input",ExpressionUUID->"de77c7e3-60cc-4205-8cf4-c9968da4451c"],

Cell["(* Outer product: different indices mean no contraction. *)", "Text",ExpressionUUID->"2b838852-c1c2-4c34-ba73-c06b6481ad6b"],

Cell["\<\
EinsteinSummation[{{i}, {j}} -> {i, j}, {Range[3], Range[4]}]\
\>", "Input",ExpressionUUID->"f45ac563-fd70-4f2f-ae86-3bda56310cb5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sparse Arrays and Advanced", "Subsection",ExpressionUUID->"a94c5260-20c8-490f-89e6-4f5cb863ea26"],

Cell["Handle sparse arrays and batch operations.", "Text",ExpressionUUID->"77e8fc76-8979-4231-a226-a8af6eb50c80"],

Cell["(* Matrix multiply with sparse input. *)", "Text",ExpressionUUID->"f9ff5e68-6b28-40d0-ab42-5f65fe959ea3"],

Cell["EinsteinSummation[{{i, j}, {j, k}}, {SparseArray[A], B}]", "Input",ExpressionUUID->"591c2fa4-48b5-4f78-8efe-78b18ad658c4"],

Cell["(* Using Characters to create index lists. *)", "Text",ExpressionUUID->"c3859b79-2364-4fc4-9921-3f86b25bcb98"],

Cell["\<\
EinsteinSummation[{Characters /@ {\"ij\", \"jk\"}} -> Characters[\"ik\"], {A, \
B}]\
\>", "Input",ExpressionUUID->"6de4f55d-df3a-4802-8c9f-ae9dcf7bf2c6"],

Cell["(* Batch matrix multiply (keep batch dimension b). *)", "Text",ExpressionUUID->"13e4ef5b-575c-45c7-aad0-3a0abe53d746"],

Cell[CellGroupData[{

Cell["\<\
X = RandomReal[1, {5, 2, 3}]; Y = RandomReal[1, {5, 3, 4}];
EinsteinSummation[\"bij,bjk->bik\", {X, Y}]//Activate\
\>", "Input",
 CellChangeTimes->{{3.978708295661399*^9, 3.978708301937448*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"54fb2e6f-5c66-49bd-95fc-e00e421b41cb"],

