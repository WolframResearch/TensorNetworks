Cell["PathToTreePath[{{1, 2}}, {a, b}]", "Input",ExpressionUUID->"65910875-a4d6-47de-afaf-6c8923e99192"],

Cell["(* Canonicalize a path. *)", "Text",ExpressionUUID->"1d7ce152-1afe-45e0-aaab-2ff9401c3b9e"],

Cell["CanonicalPath[{{2, 3}, {1, 2}}]", "Input",ExpressionUUID->"b6c39631-3ba6-4222-8f86-7f3aa844e5de"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["MPS (Matrix Product State) Functions", "Section",ExpressionUUID->"86c540e2-1c99-4101-bdf6-b6561ae123d6"],

Cell["\<\
Functions for working with Matrix Product States, a 1D tensor network \
structure.\
\>", "Text",ExpressionUUID->"e9f8b392-39ac-44ea-8bf4-56d225b26fde"],

Cell[CellGroupData[{

Cell["MPSCanonicalForm", "Subsection",ExpressionUUID->"aa1740cc-107f-4c95-b47b-609246ad357e"],

Cell["Put MPS into canonical form.", "Text",ExpressionUUID->"61b974db-f62f-4c36-b2c0-b8a66f3f9e5f"],

Cell["(* Default (left) canonical form. *)", "Text",ExpressionUUID->"17416fc8-4131-42d6-8059-a3e48ac90239"],

Cell["MPSCanonicalForm[mps]", "Input",ExpressionUUID->"53ebe6b5-8058-4007-b5b9-bd924446edad"],

Cell["(* Left canonical form. *)", "Text",ExpressionUUID->"66a66d05-6b62-483d-a23f-ca0d3faa966c"],

Cell["MPSCanonicalForm[mps, \"Left\"]", "Input",ExpressionUUID->"656d1bc6-51eb-468a-bb86-94e090628e8b"],

Cell["(* Right canonical form. *)", "Text",ExpressionUUID->"d740b985-f70b-48dc-9b72-1db5d09c38a1"],

Cell["MPSCanonicalForm[mps, \"Right\"]", "Input",ExpressionUUID->"46a7a82e-f28c-47e9-827f-4e910d7782cb"],

Cell["(* Mixed canonical form at site 3. *)", "Text",ExpressionUUID->"b60f7bd6-1f4d-4bfb-8c33-a4fccfc8e48e"],

Cell["MPSCanonicalForm[mps, {\"Mixed\", 3}]", "Input",ExpressionUUID->"6999aa18-8d8d-4c15-9d0e-9fa21b7ae6e7"],

Cell["(* With bond dimension truncation. *)", "Text",ExpressionUUID->"e34bb4bf-1018-45f9-8f99-06ad22ec174a"],

Cell["MPSCanonicalForm[mps, \"Left\", \"MaxBond\" -> 4]", "Input",ExpressionUUID->"7bb57347-ee56-48e7-b570-79efc3d8634b"],

Cell["(* With tolerance. *)", "Text",ExpressionUUID->"5062655d-c3cf-433d-857a-32f04e80f9c2"],

Cell["MPSCanonicalForm[mps, \"Left\", \"Tolerance\" -> 1.*^-6]", "Input",ExpressionUUID->"773fffc2-e8a1-451d-aad8-0e9ddee8d23d"],

Cell["(* Periodic MPS left canonical. *)", "Text",ExpressionUUID->"ea490642-8fd4-4823-8f05-d317a5474dd2"],

Cell["MPSCanonicalForm[mps2, \"Left\"]", "Input",ExpressionUUID->"ea969483-81e8-4ef8-92ed-e5f7bbea2227"],

Cell["(* Periodic with truncation. *)", "Text",ExpressionUUID->"78369a36-00c7-4f0b-993c-e489f9b0af94"],

Cell["MPSCanonicalForm[mps2, \"Right\", \"MaxBond\" -> 5]", "Input",ExpressionUUID->"bb5446f1-cd12-4a1a-b47f-161bf3d0cfb6"],

Cell["(* Periodic mixed with tolerance. *)", "Text",ExpressionUUID->"2b1fd425-258e-4973-9b5f-77bb62056721"],

Cell["MPSCanonicalForm[mps2, {\"Mixed\", 2}, \"Tolerance\" -> 1.*^-8]", \
"Input",ExpressionUUID->"6ca220ad-5a5a-479a-9463-d42cbf50a57f"],

Cell["(* All options combined. *)", "Text",ExpressionUUID->"c487c14e-50fd-4789-bf9c-cf193538f6fb"],

Cell["\<\
MPSCanonicalForm[RandomTensorNetwork[\"MPS\"[4, 2, 2]], \"Left\", \"MaxBond\" \
-> 3, \"Tolerance\" -> 0]\
\>", "Input",ExpressionUUID->"72500985-3a7c-473d-8c1d-7ee0dffa422e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MPSCanonicalQ", "Subsection",ExpressionUUID->"dc93af7d-4b91-4ded-8a07-edb229fb4b97"],

Cell["Test canonical form.", "Text",ExpressionUUID->"f6492f1a-5529-4a8e-912a-1dbb5292bb84"],

Cell["(* Test left canonical form. *)", "Text",ExpressionUUID->"312f33b5-807f-40e9-ae13-904bb56863bf"],

Cell["MPSCanonicalQ[MPSCanonicalForm[mps, \"Left\"], \"Left\"]", "Input",ExpressionUUID->"4f006bb2-6874-49d9-8411-54da94a33268"],

Cell["(* Test right canonical form. *)", "Text",ExpressionUUID->"ae26dfa7-3e89-4234-82ea-25798f4c74b7"],

Cell["MPSCanonicalQ[MPSCanonicalForm[mps, \"Right\"], \"Right\"]", "Input",ExpressionUUID->"619db95a-164a-4a70-8dc3-cd058be492a4"],

Cell["(* Test mixed canonical form. *)", "Text",ExpressionUUID->"3a98c3f1-76cd-496d-98bc-166177f2855b"],

Cell["\<\
MPSCanonicalQ[MPSCanonicalForm[mps, {\"Mixed\", 3}], {\"Mixed\", 3}]\
\>", "Input",ExpressionUUID->"eb0bbd8c-409a-48d9-b9a2-c0aa3b56bc3d"],

Cell["(* Test random MPS (not canonical). *)", "Text",ExpressionUUID->"b6ad9eaa-87b9-44c9-a888-f11931fa8800"],

Cell["MPSCanonicalQ[mps, \"Left\"]", "Input",ExpressionUUID->"0ff4e55f-4e7d-4e29-9cbe-8e5a70656eff"],

Cell["(* Periodic test. *)", "Text",ExpressionUUID->"b41a0b19-cce9-4af4-96e6-cf3e3dd14442"],

Cell["MPSCanonicalQ[mps2, \"Left\"]", "Input",ExpressionUUID->"ad8cd0e6-465a-4313-8b3b-956427500aed"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MPSOverlap and MPSNorm", "Subsection",ExpressionUUID->"55f81832-391d-411d-9e76-609d587ecbd8"],

Cell["Compute inner products and norms.", "Text",ExpressionUUID->"bc961ad4-ecf1-44b4-9bb5-0f6ad5da91ac"],

Cell["(* Self overlap (norm squared). *)", "Text",ExpressionUUID->"15189e9c-77f7-43cf-9c44-238a57e0fd19"],

Cell["MPSOverlap[mps, mps]", "Input",ExpressionUUID->"55cd6691-12cd-4341-a5b4-dacc46df8534"],

Cell["(* Cross overlap. *)", "Text",ExpressionUUID->"06447c53-25bc-4102-80af-2dec35c6f9f3"],

Cell["MPSOverlap[mps, mps2]", "Input",ExpressionUUID->"c9b9549c-8fba-4b69-a311-fa0fb8b99232"],

Cell["(* Overlap with random MPS. *)", "Text",ExpressionUUID->"07debb58-132a-4def-b79a-5c8b2651fbbc"],

Cell["MPSOverlap[mps, RandomTensorNetwork[\"MPS\"[5, 3, 2]]]", "Input",ExpressionUUID->"1b68277b-7280-4c17-8139-3d65fa9af9c0"],

Cell["(* Compute MPS norm. *)", "Text",ExpressionUUID->"ed75954e-b58f-43df-8d9a-e30381d523ee"],

Cell["MPSNorm[mps]", "Input",ExpressionUUID->"ea2c8063-95eb-4785-a417-5d3beb49b288"],

Cell["(* Norm after canonicalization. *)", "Text",ExpressionUUID->"daf56082-d8cf-4a3d-a168-22ecdf4a2634"],

Cell["MPSNorm[MPSCanonicalForm[mps, \"Left\"]]", "Input",ExpressionUUID->"c198972b-c507-4f11-91de-4bfdcfc141d9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MPSNormalize", "Subsection",ExpressionUUID->"03951e6d-74bf-4d44-8a11-1d284bbc03d4"],

Cell["Normalize to unit norm.", "Text",ExpressionUUID->"8b7bebef-326c-4ab0-b990-0be7b9df6f4a"],

Cell["(* Normalize MPS. *)", "Text",ExpressionUUID->"09253171-9089-46ed-8315-3d940be23d49"],

Cell["MPSNormalize[mps]", "Input",ExpressionUUID->"08de93b3-bc8e-48f2-8def-2416debe8630"],

Cell["(* Verify normalized MPS has unit norm. *)", "Text",ExpressionUUID->"304c620b-c8f7-4033-80d4-88c4cd80f2fb"],

Cell["MPSNorm[MPSNormalize[mps]]", "Input",ExpressionUUID->"b29c33cc-f6c1-42a2-9ba1-319f819a2ca9"],

Cell["(* Normalize periodic MPS. *)", "Text",ExpressionUUID->"6633d2eb-d4ad-4d2e-8afb-dac9671ad0f2"],

Cell["MPSNormalize[mps2]", "Input",ExpressionUUID->"4aa13155-3cca-48cb-9d81-25848e1a4648"],

Cell["(* Normalize canonical form. *)", "Text",ExpressionUUID->"8ed8caac-d66a-4e52-ade3-b5e9cc0406fc"],

Cell["MPSNormalize[MPSCanonicalForm[mps, \"Left\"]]", "Input",ExpressionUUID->"a60dffb2-f62d-4236-9fcd-378a12e2f150"],

Cell["(* Normalize random MPS. *)", "Text",ExpressionUUID->"15a5cd5e-418e-4e80-be55-8ba80ce3983c"],

Cell["MPSNormalize[RandomTensorNetwork[\"MPS\"[4, 2, 2]]]", "Input",ExpressionUUID->"95bd777f-a83a-4637-bf1e-e0de123f59e0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MPSEntanglementEntropy and MPSSchmidtValues", "Subsection",ExpressionUUID->"ba3970e6-89b1-4628-af19-92a24e045950"],

Cell["Compute entanglement properties.", "Text",ExpressionUUID->"fb691f58-59a5-464c-99b2-52a44a82d20c"],

Cell["(* Entanglement entropy at bond 2. *)", "Text",ExpressionUUID->"fc669789-011f-4851-851a-36d8131d0c4d"],

Cell["MPSEntanglementEntropy[mps, 2]", "Input",ExpressionUUID->"b5274b4d-00da-48d3-973e-6fa4bda914be"],

Cell["(* Entanglement entropy at bond 3. *)", "Text",ExpressionUUID->"1c8967e1-36ab-4289-927a-04868faed7a1"],

Cell["MPSEntanglementEntropy[mps, 3]", "Input",ExpressionUUID->"5c6b5e71-c6cf-4511-be71-63f28fa37eb3"],

Cell["(* Entropy of canonical form. *)", "Text",ExpressionUUID->"5b0136a8-8336-480e-ab5e-25c02241445b"],

Cell["MPSEntanglementEntropy[MPSCanonicalForm[mps, \"Left\"], 2]", "Input",ExpressionUUID->"3f0e7cce-af04-4eb1-8210-39d5b3e698b9"],

Cell["(* Schmidt values at bond 2. *)", "Text",ExpressionUUID->"4f0750c8-f8c8-47b4-9a8e-22154df97053"],

Cell["MPSSchmidtValues[mps, 2]", "Input",ExpressionUUID->"b25bbd2a-be6f-4f37-9fe4-12b57727dfee"],

Cell["(* Schmidt values at bond 3. *)", "Text",ExpressionUUID->"33dd9c05-035b-44f0-9308-2c77f084c9d8"],

Cell["MPSSchmidtValues[mps, 3]", "Input",ExpressionUUID->"0c305f9f-3c1c-4037-8951-24cb53c0d27d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["MPSTruncate", "Subsection",ExpressionUUID->"6ad769d6-bd61-4c9c-bd38-3f3b546094d7"],

Cell["Truncate bond dimension.", "Text",ExpressionUUID->"e4f7131d-c98a-4b49-a4b6-1b3bc65159f5"],

Cell["(* Truncate to max bond 4. *)", "Text",ExpressionUUID->"546abe3f-fc20-4a11-9211-14f6502baada"],

Cell["MPSTruncate[mps, 4]", "Input",ExpressionUUID->"ed20a632-5c9d-4ad6-9e11-973869f964b1"],

Cell["(* Aggressive truncation to bond 2. *)", "Text",ExpressionUUID->"02aa724f-624a-4112-bb00-12b9ce0f6eb2"],

Cell["MPSTruncate[mps, 2]", "Input",ExpressionUUID->"79356bd3-2263-4624-84da-f6c8e3c7378a"],

Cell["(* Truncate without normalization. *)", "Text",ExpressionUUID->"41718f36-2ff6-48c0-916d-54bd593a0a88"],

Cell["MPSTruncate[mps, 4, \"Normalize\" -> False]", "Input",ExpressionUUID->"ece8792e-56b0-4c80-a077-5b013c7e0d75"],

Cell["(* Truncate periodic MPS. *)", "Text",ExpressionUUID->"a91e34c4-3622-497e-97d3-7f5d3f417003"],

Cell["MPSTruncate[mps2, 4]", "Input",ExpressionUUID->"b82fc60e-5f57-4aba-93ef-799c8a74b2d9"],

Cell["(* Truncate canonical form. *)", "Text",ExpressionUUID->"68409426-7f8f-44f4-8059-631f29d3dc62"],

Cell["MPSTruncate[MPSCanonicalForm[mps, \"Left\"], 3]", "Input",ExpressionUUID->"921bc65b-a91b-4d26-9a22-8b4807d8a896"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Young Tableaux", "Section",ExpressionUUID->"7b4f5d2a-83c7-48c9-8e82-1f156e2356e0"],

Cell["\<\
Functions for working with Young tableaux, used for tensor symmetry \
operations.\
\>", "Text",ExpressionUUID->"a9d07426-05a7-468e-8a82-7281d1061a87"],

Cell[CellGroupData[{

Cell["YoungTableau Creation", "Subsection",ExpressionUUID->"f8364cc1-352c-4c2c-adec-d0ebadd32ded"],

Cell["Create Young tableaux.", "Text",ExpressionUUID->"dd11339b-0b62-46cc-a686-09bc866e00ec"],

Cell["(* Create from explicit filling. *)", "Text",ExpressionUUID->"00c27652-389c-43a2-aac5-6dd519742ef6"],

Cell["YoungTableau[{{1, 2}, {3}}]", "Input",ExpressionUUID->"6dfe9aaf-224c-42ce-90e6-3e69a554ebb5"],

Cell["(* Create from shape (standard filling). *)", "Text",ExpressionUUID->"50961706-a04a-41e0-961c-0fc0fe5faa78"],

Cell["YoungTableau[{2, 1}]", "Input",ExpressionUUID->"45d423fc-c007-4c2d-832f-12043d22e3e7"],

Cell["(* Single row tableau. *)", "Text",ExpressionUUID->"742aa60c-b5e5-45d2-83e8-6816f5162bcf"],

Cell["YoungTableau[{3}]", "Input",ExpressionUUID->"8321343d-9794-4024-82a3-a409eefc8b15"],

Cell["(* Single column tableau. *)", "Text",ExpressionUUID->"addf9a40-8e0a-4e7b-9978-6caa5a7710e0"],

Cell["YoungTableau[{1, 1, 1}]", "Input",ExpressionUUID->"38566a76-ed92-4773-a426-cdf840a9d6d8"],

Cell["(* Square tableau. *)", "Text",ExpressionUUID->"b464c2b1-5b54-49d3-aa09-1df5a02e00fb"],

Cell["YoungTableau[{2, 2}]", "Input",ExpressionUUID->"294fda87-9535-46c5-9145-a6ca4a0791f3"],

Cell["(* Complex shape. *)", "Text",ExpressionUUID->"0a75fb5d-d810-4011-be8b-768edca9d4a3"],

Cell["YoungTableau[{4, 2, 1}]", "Input",ExpressionUUID->"39e16b86-2d84-400a-be31-fa59012eb07b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["YoungTableauQ and Properties", "Subsection",ExpressionUUID->"80e0a7ec-ad1f-42d7-8d77-9c3edaae5cd5"],

Cell["Test validity and get properties.", "Text",ExpressionUUID->"26d994e8-b2a3-4328-a37c-0d100cddc89f"],

Cell["(* Test tableau validity. *)", "Text",ExpressionUUID->"f3e237bb-c55f-44e6-8cb2-b5edd7bcc5e7"],

Cell["YoungTableauQ[yt1]", "Input",ExpressionUUID->"106b5a02-a1b2-44a4-99ac-6b62c51e0650"],

Cell["(* Test another tableau. *)", "Text",ExpressionUUID->"8fab717d-10c0-4275-b1e4-c1d55dcaedf8"],

Cell["YoungTableauQ[yt2]", "Input",ExpressionUUID->"6481b71b-22c1-48fc-9772-a37ad5029769"],

Cell["(* Test invalid input. *)", "Text",ExpressionUUID->"d47691cc-baf7-4dba-8e00-5dca15caa34f"],

Cell["YoungTableauQ[\"invalid\"]", "Input",ExpressionUUID->"26fc9f38-c84b-481b-b4e1-23f8e69ce424"],

Cell["(* Get tableau shape. *)", "Text",ExpressionUUID->"6e9b6a6b-fd1d-48f7-9bb9-cfcaa592ac89"],

Cell["TableauShape[yt1]", "Input",ExpressionUUID->"6ab9536f-5162-43b8-a6e7-070ec782ba73"],

Cell["(* Get tableau size (number of boxes). *)", "Text",ExpressionUUID->"ceded2e5-c966-4e73-83c4-50d7813fd21d"],

Cell["TableauSize[yt1]", "Input",ExpressionUUID->"a4b332c3-b034-4e9e-a2b1-8025ab3c0331"]
}, Open  ]],

Cell[CellGroupData[{

Cell["HookLength and TableauDimension", "Subsection",ExpressionUUID->"c8d9941e-d0d7-42e6-a248-10730fcf49bf"],

Cell["Compute hook lengths and dimensions.", "Text",ExpressionUUID->"9e3efaf9-99cd-4414-8e7c-67f2c59bae44"],

Cell["(* Hook length at position (1,1). *)", "Text",ExpressionUUID->"579a345a-0309-4499-b35e-e99eb41622fa"],

Cell["HookLength[yt1, {1, 1}]", "Input",ExpressionUUID->"68766643-41d5-423f-9089-43c7ffa390f0"],

Cell["(* Hook length at position (1,2). *)", "Text",ExpressionUUID->"8db6a5d2-a029-4b4b-944e-2cdb7f9d5cb9"],

Cell["HookLength[yt1, {1, 2}]", "Input",ExpressionUUID->"8b80f725-4245-4e20-9858-db136fb8f728"],

Cell["(* Hook length at corner. *)", "Text",ExpressionUUID->"36c63b7a-cbf8-4d4c-befd-1acde6b5a5b5"],

Cell["HookLength[yt1, {2, 1}]", "Input",ExpressionUUID->"6929f25a-adac-48bf-9f6e-a93692ed2684"],

Cell["(* Tableau dimension (number of standard tableaux). *)", "Text",ExpressionUUID->"714e51d9-fa41-46ff-9c2a-98933b2f03c3"],

Cell["TableauDimension[yt1]", "Input",ExpressionUUID->"9007482c-29f0-454a-8e20-ebd2183f8fd2"],

Cell["(* Dimension of another shape. *)", "Text",ExpressionUUID->"e18763e4-5221-415c-91a8-32a51c8812b7"],

Cell["TableauDimension[YoungTableau[{3}]]", "Input",ExpressionUUID->"7ee7eb74-484a-49da-bbcb-5afaf7af6a69"]
}, Open  ]],

Cell[CellGroupData[{

Cell["YoungSymmetrize and YoungProject", "Subsection",ExpressionUUID->"f9c3c9c4-451b-4168-acd4-09cfe8c8f82a"],

Cell["Apply symmetry operations.", "Text",ExpressionUUID->"231d0f3f-04a4-44d3-a492-30d43292fd69"],

Cell["(* Symmetrize rank-3 tensor. *)", "Text",ExpressionUUID->"67ac1552-235d-4f05-98c3-422e464adf94"],

Cell["YoungSymmetrize[t3, yt1]", "Input",ExpressionUUID->"fa3feb9c-6182-45b1-93af-720cc225e84c"],

Cell["(* Symmetrize with different tableau. *)", "Text",ExpressionUUID->"13a81d8c-9e2e-4a36-b7f6-33ea434efe38"],

Cell["YoungSymmetrize[t3, yt2]", "Input",ExpressionUUID->"357018ee-a23b-4eb5-aaf4-cfd3157dc78f"],

Cell["(* Full symmetrization (single row). *)", "Text",ExpressionUUID->"12957cd5-51d5-431c-8730-d6b4c5cf85b8"],

Cell["YoungSymmetrize[RandomReal[1, {3, 3, 3}], YoungTableau[{3}]]", "Input",ExpressionUUID->"448dcd3a-338c-4d69-a62d-aa602c6a38cf"],

Cell["(* Full antisymmetrization (single column). *)", "Text",ExpressionUUID->"1bb1d351-da8e-4529-90b4-33d517c81760"],

Cell["\<\
YoungSymmetrize[RandomReal[1, {2, 2, 2}], YoungTableau[{1, 1, 1}]]\
\>", "Input",ExpressionUUID->"69180b66-e8e3-4b4a-b8f5-81993ad1839b"],

Cell["(* Project onto symmetry subspace. *)", "Text",ExpressionUUID->"22276cd5-4015-4779-a54a-bfeecba3de85"],

Cell["YoungProject[t3, yt1]", "Input",ExpressionUUID->"54bab572-5406-4a1c-b618-bbb8f84c28ca"],

Cell["(* Project with different tableau. *)", "Text",ExpressionUUID->"fe767bb6-4d7b-4c44-944e-6444761ad004"],

Cell["YoungProject[t3, yt2]", "Input",ExpressionUUID->"cea58124-ac49-4fe7-9742-2a0ed8b78a1b"],

Cell["(* Project fully symmetric. *)", "Text",ExpressionUUID->"5298792d-515d-45db-afe8-2a17b5d8b216"],

Cell["YoungProject[RandomReal[1, {3, 3, 3}], YoungTableau[{3}]]", "Input",ExpressionUUID->"960aa950-d103-4373-99d0-4a95dc0819ad"],

Cell["(* Project fully antisymmetric. *)", "Text",ExpressionUUID->"af661c0a-6f62-4ba1-b032-8101ca020b6a"],

Cell["\<\
YoungProject[RandomReal[1, {2, 2, 2}], YoungTableau[{1, 1, 1}]]\
\>", "Input",ExpressionUUID->"232158c2-cd7d-4704-a15c-35aad8a5b0f7"],

Cell["(* Higher rank tensor symmetrization. *)", "Text",ExpressionUUID->"5c14258a-d986-4f4a-8f90-19196f2a4977"],

Cell["\<\
YoungSymmetrize[RandomReal[1, {2, 2, 2, 2}], YoungTableau[{2, 2}]]\
\>", "Input",ExpressionUUID->"d661be66-4658-4d3b-ab3a-d509c40f1cbf"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
