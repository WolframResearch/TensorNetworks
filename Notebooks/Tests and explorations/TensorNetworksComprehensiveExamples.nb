Cell[CellGroupData[{

Cell["Path Operations", "Section",ExpressionUUID->"6493782b-4b77-4c8f-a4c4-e957836ccadd"],

Cell["Low-level functions for manipulating contraction paths.", "Text",ExpressionUUID->"3fa4b1e4-f30d-4bc5-8096-9bede4e0dc3b"],

Cell[CellGroupData[{

Cell["GreedyContractionPath", "Subsection",ExpressionUUID->"b9c27850-f26a-490b-ba2b-3163228f5829"],

Cell["Fast heuristic path finding.", "Text",ExpressionUUID->"3ba310e9-dd51-4472-8762-8bcd595860d5"],

Cell["(* Basic greedy path finding. *)", "Text",ExpressionUUID->"1a4bd066-d6be-4e57-8dfc-bdf2650356a3"],

Cell["GreedyContractionPath[{{i, j}, {j, k}, {k, l}}, {i, l}, sizeDict]", "Input",ExpressionUUID->"fdc76162-e57f-41d0-b1fe-ab5915e35383"],

Cell["\<\
(* Greedy with custom options. *)\
\>", "Text",ExpressionUUID->"559b90bd-89c3-4a25-8afe-e906c2829dbd"],

Cell["\<\
GreedyContractionPath[{{i, j}, {j, k}}, {i, k}, sizeDict, \"MemoryWeight\" -> 1., \"Temperature\" -> 0.1, \"MaxNeighbors\" -> 20, \"RandomSeed\" -> 123]\
\>", "Input",ExpressionUUID->"bee121c3-9884-426a-bd88-0a5adb24c926"],

Cell["(* Greedy with PreSimplify and FixedIndexing options. *)", "Text",ExpressionUUID->"2e599b5e-7d74-48f8-aff4-6ea0696ed9ef"],

Cell["\<\
GreedyContractionPath[{{i, j}, {j, k}}, {i, k}, sizeDict, \"PreSimplify\" -> True, \"FixedIndexing\" -> True]\
\>", "Input",ExpressionUUID->"73c3ebde-085f-403a-9665-f9dbc0b83813"],

Cell["(* Full contraction (empty output). *)", "Text",ExpressionUUID->"a142e918-70d1-4a29-8a1f-4d36fafebfba"],

Cell["GreedyContractionPath[{{i, j}, {j, k}, {k, i}}, {}, sizeDict]", "Input",ExpressionUUID->"2562ce2a-cdd4-453c-94c6-3b574c3b83de"],

Cell["(* Vector dot product path. *)", "Text",ExpressionUUID->"2c27fb0e-3e83-4e68-91a0-188ed670b743"],

Cell["GreedyContractionPath[{{i}, {i}}, {}, <|i -> 2|>]", "Input",ExpressionUUID->"8dd9690a-1134-4969-9fc7-e12eb352d5e2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["OptimalContractionPath", "Subsection",ExpressionUUID->"d5be9561-7db1-449f-aece-510f05784d35"],

Cell["Exact optimal path finding.", "Text",ExpressionUUID->"d510c1b8-e68d-435e-9e5f-27459f515be8"],

Cell["(* Optimal path finding (default size minimization). *)", "Text",ExpressionUUID->"ae3e42f5-0607-4272-8287-20cf694fcb16"],

Cell["OptimalContractionPath[{{i, j}, {j, k}, {k, l}}, {i, l}, sizeDict]", "Input",ExpressionUUID->"9c6128bc-b7a2-4e6f-b6ae-6eca16d22eed"],

Cell["(* Optimal with explicit size Method. *)", "Text",ExpressionUUID->"c6fb336f-2262-46fa-8816-12eb0f947a6d"],

Cell["\<\
