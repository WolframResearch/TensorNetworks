Cell["\<\
OptimalContractionPath[{{i, j}, {j, k}, {k, i}}, {}, sizeDict, Method -> \"flops\"]\
\>", "Input",ExpressionUUID->"91da74a3-6e5b-457b-a9cd-c5b45deaa7a3"],

