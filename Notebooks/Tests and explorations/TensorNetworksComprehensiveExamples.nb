Cell[CellGroupData[{

Cell["Contraction Path Finding", "Section",ExpressionUUID->"a8882131-c0f6-47ad-8603-a80951ad533c"],

Cell["\<\
Functions to find optimal or near-optimal contraction orders for tensor \
networks.\
\>", "Text",ExpressionUUID->"e81210db-538f-4ba9-b583-b979384025d7"],

Cell[CellGroupData[{

Cell["TensorNetworkFindContractionPath", "Subsection",ExpressionUUID->"4f99e292-3537-4c5a-b1b4-a9fe51a1e19f"],

Cell["Compute contraction paths.", "Text",ExpressionUUID->"a5baf673-d62b-4fe6-b03e-32801d470b72"],

Cell["(* Find path from TensorNetwork. *)", "Text",ExpressionUUID->"c6cc1a77-1b15-4a4d-a723-caba12f799ce"],

Cell["TensorNetworkFindContractionPath[tn]", "Input",ExpressionUUID->"fb4d24b9-4c20-4104-8a1a-c6226d49a80a"],

Cell["(* Find path from graph. *)", "Text",ExpressionUUID->"69b9edc4-88ce-49cf-aaab-c124a4007f53"],

Cell["TensorNetworkFindContractionPath[g]", "Input",ExpressionUUID->"ac27dd10-c641-4f17-8274-858b420edcf6"],

Cell["(* Find path from data. *)", "Text",ExpressionUUID->"c223ebb7-ea38-4b5c-b714-17e3050921c3"],

Cell["TensorNetworkFindContractionPath[data]", "Input",ExpressionUUID->"17e75c33-8035-44c3-89e2-ad0d08e7b44d"],

Cell["(* Greedy algorithm. *)", "Text",ExpressionUUID->"e1d518e5-3eaf-4d9c-a7c1-5a02fdcc59bb"],

Cell["TensorNetworkFindContractionPath[data, Method -> \"Greedy\"]", "Input",ExpressionUUID->"0aa3f1b5-17ff-4236-bc2c-88e83095008d"],

Cell["(* Optimal algorithm (slower but better). *)", "Text",ExpressionUUID->"2825ad5d-dfe3-4485-b680-95315e4dee2e"],

Cell["TensorNetworkFindContractionPath[data, Method -> \"Optimal\"]", "Input",ExpressionUUID->"5103853f-d692-4b3b-8943-6a1d763bfe3c"],

Cell["(* Return cost parameters. *)", "Text",ExpressionUUID->"3cbe2e6b-e269-48b5-9e8c-7c2c91e12105"],

Cell["\<\
TensorNetworkFindContractionPath[data, \"ReturnParameters\" -> True]\
\>", "Input",ExpressionUUID->"d89efcb7-8ae4-4df7-9f93-bba6ca051424"],

Cell["(* From random network. *)", "Text",ExpressionUUID->"23ca196e-f07e-4276-b789-738d274943e8"],

Cell["\<\
TensorNetworkFindContractionPath[RandomTensorNetwork[{5, 6}, 3]]\
\>", "Input",ExpressionUUID->"b79e6449-1c21-4ebd-9bf7-627906d38a80"],

Cell["(* From closed loop. *)", "Text",ExpressionUUID->"3a23d576-ca37-4ae1-bba7-35e342856682"],

Cell["\<\
TensorNetworkFindContractionPath[TensorNetwork[{A, B}, {{i, j}, {j, i}}]]\
