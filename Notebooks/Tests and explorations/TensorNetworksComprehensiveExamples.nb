Cell["(* Test canonical path validity. *)", "Text",ExpressionUUID->"60ae860d-4e8b-4b4f-b762-0d6ab82d0cb2"],

Cell["CanonicalPathQ[{{1, 2}, {1, 2}}]", "Input",ExpressionUUID->"a3d25d67-0c1f-473e-b03c-367e3ac7a6fe"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Path Conversion", "Subsection",ExpressionUUID->"0c223b49-f201-409b-b823-b21a0461f61e"],

Cell["Convert between path formats.", "Text",ExpressionUUID->"43933de8-6398-4080-bc23-6669bc069a98"],

Cell["(* Convert tree path to canonical path. *)", "Text",ExpressionUUID->"93a86da5-10d6-4997-923a-78b0203e084b"],

Cell["TreePathToPath[{{1}, {2}}]", "Input",ExpressionUUID->"66b9c2cc-ccc2-405a-b7f4-58bf130bec6d"],

Cell["(* Tree to path with vertex labels. *)", "Text",ExpressionUUID->"82f068b7-4177-4508-8eb0-d4b7e0e903cb"],

Cell["TreePathToPath[{{1}, {2}}, {a, b}]", "Input",ExpressionUUID->"96e636f2-4e27-4210-b16f-ebe8206278e1"],

Cell["(* Convert canonical path to tree path. *)", "Text",ExpressionUUID->"9ee05d61-db38-4d58-a6b1-c972b5526300"],

Cell["PathToTreePath[{{1, 2}}]", "Input",ExpressionUUID->"ee269b11-0001-46b4-b33a-56c1981d90ae"],

