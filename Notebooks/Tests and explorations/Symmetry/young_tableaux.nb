Cell[TextData[{
 "Physics readout: the two numbers are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "/", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "55006d5e-59e4-471e-b827-6bf0786f5658"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "20619631-6604-4bc4-a484-4faf83524fb5"],
 ", and they sum to ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dcc2a762-5165-4d8b-9e9b-5f6286249b95"],
 ". Analytical check: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "+"}], "\[RightAngleBracket]", "\[CircleTimes]", 
    RowBox[{"|", "0"}], "\[RightAngleBracket]", "\[CircleTimes]", 
    RowBox[{"|", "+"}], "\[RightAngleBracket]", "\[LongEqual]", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"|", "000"}], "\[RightAngleBracket]"}], "+", 
    RowBox[{"|", "001"}], "\[RightAngleBracket]", "+", 
    RowBox[{"|", "100"}], "\[RightAngleBracket]", "+", 
    RowBox[{"|", "101"}], "\[RightAngleBracket]", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"eb7fcd9c-d406-4858-9eab-a21835a6fba4"],
 ", so its overlap with the W-like state ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["J", "TI"], "\[LongEqual]", 
    FractionBox["3", "2"], ",", 
    StyleBox["M", "TI"], "\[LongEqual]", 
    FractionBox["1", "2"], "\[RightAngleBracket]", "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"|", "001"}], "\[RightAngleBracket]"}], "+", 
    RowBox[{"|", "010"}], "\[RightAngleBracket]", "+", 
    RowBox[{"|", "100"}], "\[RightAngleBracket]", ")", "/", 
    SqrtBox["3"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c84e93a2-48d3-4fa5-9272-f5178b0233f7"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", "2"], "+", "0", "+", 
      FractionBox["1", "2"]}], ")"}], "/", 
    SqrtBox["3"], "\[LongEqual]", "1", "/", 
    SqrtBox["3"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2575d466-b462-424b-9043-c1a5ab26ea27"],
 ", contributing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8ef61423-9ca9-4371-8578-8fbf62620996"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["c", "TI"], 
     RowBox[{"3", "/", "2"}]], 
    SuperscriptBox["|", "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2bd4506d-3004-401e-81a6-2fb216db8ef5"],
 "; summing over all ",
 Cell[BoxData[
  FormBox[
   StyleBox["M", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3c34447e-e084-4dc2-beba-6f2025400873"],
 " in the spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f6bb4d32-30db-4928-b8c1-87698fce426e"],
 " block recovers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "/", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8fc592a7-b4cb-401f-9c98-22afadd5382a"],
 ". A ",
 StyleBox["product", "TI"],
 " state populates both available total-",
 Cell[BoxData[
  FormBox[
   StyleBox["J", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b3edf20a-11b7-47c1-9018-de7bc1814f64"],
 " sectors, and Young projection delivers exactly the Clebsch-Gordan \
amplitudes."
}], "Text",ExpressionUUID->"5890acc3-7fa5-41c5-8db1-3a5a62e52165"]
}, Open  ]],

