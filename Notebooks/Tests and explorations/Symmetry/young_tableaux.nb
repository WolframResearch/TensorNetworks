Cell[TextData[{
 "The \"standard\" qualifier earns its keep: not every filling of a valid \
diagram with the labels ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "\[Ellipsis]", ",", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d273376b-d225-42b5-b2c6-bc0cea0f9c8e"],
 " counts. Here the first row decreases, so the strict-increase rule fails \
along that row."
}], "Text",ExpressionUUID->"5cad76a3-f60d-490f-b3e2-da03b958a2d7"],

