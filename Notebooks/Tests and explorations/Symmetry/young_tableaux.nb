}, Open  ]],

Cell["\<\
Build the valence-bond state as a TN of two singlet tensors with no internal \
bonds.\
\>", "Text",ExpressionUUID->"bbd5dd93-f814-43dc-b500-c21c244afa5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vb4TN", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"singletPair", ",", " ", "singletPair"}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<q1\>\"", ",", " ", "\"\<q2\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<q3\>\"", ",", " ", "\"\<q4\>\""}], "}"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<q1\>\"", ",", " ", "\"\<q2\>\"", ",", " ", "\"\<q3\>\"", ",",
        " ", "\"\<q4\>\""}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[62]:=",ExpressionUUID->"5024f61d-78be-4344-8b84-8f4b4f9118e2"],

