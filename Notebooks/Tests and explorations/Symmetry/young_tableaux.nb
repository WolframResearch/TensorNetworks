Cell[TextData[{
 "The DFS has dimension ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1ebe73c3-5dc7-4ddb-ae8c-ea7c65cf34cc"],
 ": a second linearly independent basis vector is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", "13", ")"}], "(", "24", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"80d89654-8101-4c95-a7af-ae0dccda34c6"],
 " singlet pairing. Build it as a TN with the singlet tensors bonded across \
legs ",
 Cell[BoxData[
  RowBox[{"\"\<q1\>\"", "-", "\"\<q3\>\""}]], "InlineFormula",ExpressionUUID->
  "280300cb-1d0c-47d7-91c0-b75f366f8df7"],
 " and ",
 Cell[BoxData[
  RowBox[{"\"\<q2\>\"", "-", "\"\<q4\>\""}]], "InlineFormula",ExpressionUUID->
  "b9e60d5f-136c-4f4d-a13b-a10145219204"],
 "."
}], "Text",ExpressionUUID->"3ecddcca-2e89-41b5-a915-371e1e1f9b4b"],

