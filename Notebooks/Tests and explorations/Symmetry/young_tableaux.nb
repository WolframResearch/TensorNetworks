 "No weight leaks into the spin-",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ddabfd5f-e907-4e53-b2a5-eb77486acb4f"],
 " or spin-",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a0328449-93da-43e8-901b-0dc720a4ee14"],
 " sectors."
}], "Text",ExpressionUUID->"9b60b3ac-9e47-4ee5-9f88-0f267cf9c8e9"],

