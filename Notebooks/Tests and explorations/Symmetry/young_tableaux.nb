   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.989017261148287*^9},
 CellLabel->"Out[86]=",
 CellID->111811262,ExpressionUUID->"8580250a-f47b-4002-87de-28cde02146a6"]
}, Open  ]],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "8"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c86d4fd6-c0e8-4989-8bbd-ad972181313b"],
 " qubits, the multiplicities grow: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "14", ",", "0", ",", "28", ",", "0", ",", "20", ",", "0", ",", "7", ",", 
     "0", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6252737b-0a70-4c1b-a759-b36f2f4fea7f"],
 " when read out per integer ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    StyleBox["J", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e00ce86f-e9dd-46a9-9977-9981729bd3fc"],
 " (here, fourteen spin-",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4862510b-f589-4400-b4bf-cb8588281517"],
 " copies, twenty-eight spin-",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bdc351e9-a529-4c5d-987c-3a641cadbd6c"],
 ", twenty spin-",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "43626cd5-d0f1-4c7f-9e6f-9f5f4c9a768d"],
 ", seven spin-3, one spin-4). The paclet gets them in one line."
}], "Text",ExpressionUUID->"c36d5164-d2fa-4c39-bfe2-382699d9f88c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"spinSectors", "[", "8", "]"}]], "Input",
 CellLabel->"In[87]:=",ExpressionUUID->"1363081b-d72c-42af-b8fa-9c4594c488f4"],

