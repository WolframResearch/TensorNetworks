Cell[TextData[{
 "Physics readout: the three numbers are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "6"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "51109916-b9c5-43ad-b364-be417a3621be"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cfed11b4-aac1-4803-9cf1-50f8c5a54ed7"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "caf8948c-88bd-4b24-8a5c-4ce229046244"],
 ", summing to ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cf821346-c1e2-446f-9a94-94b84bad77ff"],
 ". The ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["J", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"25d3ed75-d579-4f9d-97c2-ada7be7c57f1"],
 " value matches the analytical ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      RowBox[{
       StyleBox["J", "TI"], "\[LongEqual]", "2"}], ",", 
      RowBox[{
       RowBox[{
        StyleBox["M", "TI"], "\[LongEqual]", "0"}], " ", "|", " ", "1100"}]}],
      "\[RightAngleBracket]"}], 
    SuperscriptBox["|", "2"], 
    RowBox[{"\[LongEqual]", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "/", 
        SqrtBox["6"]}], ")"}], "2"], "\[LongEqual]", 
     RowBox[{"1", "/", "6"}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0d80de7d-3b04-4fc2-bbc2-7efabd3be2a2"],
 " (the unique ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["J", "TI"], "\[LongEqual]", "2", ",", 
    StyleBox["M", "TI"], "\[LongEqual]", "0", "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0593d38d-9e54-4fb7-9bca-d60414a27af7"],
 " is the symmetric two-down state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", 
     SqrtBox["6"]], 
    UnderscriptBox["\[Sum]", "\[Sigma]",
     LimitsPositioning->True], "|", "\[Sigma]", 
    RowBox[{"(", "1100", ")"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"365ff1a5-12b1-4bee-a67f-733a671a7836"],
 "). A single classical bitstring is generally not an eigenstate of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "\[RightVector]"], 
    StyleBox["tot",
     FontSlant->"Plain"], 
    RowBox[{" ", "2"}]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f9dbadcf-6561-4ec1-a71d-a9c1686045df"],
 ": it spreads across ",
 StyleBox["every", "TI"],
 " total-spin sector available in its ",
 Cell[BoxData[
  FormBox[
   StyleBox["M", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e729b03c-bed3-4c50-8aa2-51ae0a5d4b15"],
 "-slice, with weights given by Young projection."
}], "Text",ExpressionUUID->"45ae1001-7b42-4131-aa18-b3122fa9058e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "A 4-qubit valence-bond state: pure ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["J", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f0b6fc1d-edca-4633-a8c0-c7b087c803c5"],
 " dimer"
}], "Section",ExpressionUUID->"fe3a4f4e-4584-4cd8-960b-c5d51171bacb"],

Cell[TextData[{
 "Two bond singlets ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SuperscriptBox["\[CapitalPsi]", "-"], 
    SubscriptBox["\[RightAngleBracket]", "12"], "\[CircleTimes]", "|", 
    SuperscriptBox["\[CapitalPsi]", "-"], 
    SubscriptBox["\[RightAngleBracket]", "34"]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"bfa3c09d-930a-4676-9226-c96c8264f5e2"],
 " form the simplest valence-bond crystal (the 4-site limit of the AKLT/RVB \
family on spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3b260e68-3f00-409b-9c23-59a56e437ed7"],
 "). It is a ",
 StyleBox["pure", "TI"],
 " spin-",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "be0b9abb-bc23-4f5d-91bc-db5e9aaf6d6a"],
 " state by construction, so Young projection onto every non-",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"563825c0-0d4c-4ffe-ab48-d42a97f38d4e"],
 " shape must vanish."
}], "Text",ExpressionUUID->"3a069289-4c7e-4bbb-9d29-8ea0d8e1ae28"],

Cell[TextData[{
 "The singlet ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SuperscriptBox["\[CapitalPsi]", "-"], "\[RightAngleBracket]", "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"|", "01"}], "\[RightAngleBracket]"}], "-", 
    RowBox[{"|", "10"}], "\[RightAngleBracket]", ")", "/", 
    SqrtBox["2"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8b101c78-08bb-4e47-8e59-7d030130a08b"],
 " as a rank-",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1b4a6b6c-c8c7-469f-b66d-4c472efa71cf"],
 " tensor is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], "/", 
      SqrtBox["2"]}], ")"}], " ", 
    SubscriptBox["\[Sigma]", 
     StyleBox["y", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f1af1952-b6f2-4abb-85dd-a4c7636f3f46"],
 ", so we get it from the built-in ",
 Cell[BoxData[
  RowBox[{"PauliMatrix", "[", "2", "]"}]], "InlineFormula",ExpressionUUID->
  "a2b51588-47b3-4d8b-b110-71933485d498"],
 " instead of hardcoding entries."
}], "Text",ExpressionUUID->"aa7bb930-afc3-4055-9cb0-8b5ed3e421df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"singletPair", " ", "=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"I", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], " ", 
   RowBox[{"PauliMatrix", "[", "2", "]"}]}]}]], "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"da08dd09-0b9b-4a8a-9671-2d05d88e9197"],

