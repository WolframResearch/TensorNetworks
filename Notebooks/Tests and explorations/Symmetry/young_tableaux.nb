Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"54c74d0f-61d3-4105-81f6-dbdcaefd2cd7"],
 " subspace of 4 qubits has dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"4", "2"},
     "Binomial"], "\[LongEqual]", "6"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d70bf063-1e31-4703-82c0-6d85bd8da085"],
 " and decomposes by Schur-Weyl as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["J", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"00e4477f-b455-4c17-9424-d58ab82bcfd7"],
 " (one state at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"4027949a-b942-4042-a517-1bbc10901ea9"],
 "), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["J", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"14ac8396-3e15-4f67-ab78-fa1b0a7c7a4d"],
 " (multiplicity ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d69cbac5-f3a0-4266-9020-314604a7fba7"],
 ", one ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"de87097d-0086-42d0-acf3-488dd0b3ca3d"],
 " state per copy), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["J", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"de2b61bf-4613-4133-a73e-e56c0e0179cd"],
 " (multiplicity ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "eb8bdb97-d4b9-46da-85c0-4f35da40c573"],
 "). A single computational basis state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "1100"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"aae3112c-1491-44a0-84dd-4ff12645c025"],
 " has nonzero overlap with ",
 StyleBox["every", "TI"],
 " one of these. Build it as a TN of four single-qubit basis tensors."
}], "Text",ExpressionUUID->"dc8a5e45-74eb-47c7-9388-743625d399a7"],

