Cell[TextData[{
 "The equal-amplitude sum over single-flip strings is exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["J", "TI"], "\[LongEqual]", 
    FractionBox["3", "2"], ",", 
    StyleBox["M", "TI"], "\[LongEqual]", 
    FractionBox["1", "2"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8b97316a-4306-4db9-93ed-b132b809fed9"],
 "."
}], "Text",ExpressionUUID->"a6a5ef93-f378-406c-86a3-1df1853bb169"],

Cell[TextData[{
 "Both states are fully Bose-symmetric, so projecting onto the unique SYT of \
shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "3", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "78a3d8b9-ffea-4236-85f0-32373dff93ec"],
 " returns each one unchanged. GHZ first."
}], "Text",ExpressionUUID->"3c7bdabf-060b-4816-8bbc-b72664b70be0"],

