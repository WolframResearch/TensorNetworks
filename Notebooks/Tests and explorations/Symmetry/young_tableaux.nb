  ExpressionUUID->"612cbdec-915a-48d3-941b-1a34b9a9a76a"],
 " which has three SYTs), and ",
 StyleBox["two", "TI"],
 " copies of spin-",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "20a69061-418c-4bc2-a8fb-544fc1507c25"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    StyleBox["W", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0e656b55-2063-4a54-8a9f-09a4f0ab9f5b"],
 ", from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"708bd7e6-1c95-4314-9d25-219d6c2209c2"],
 " which has two SYTs). In every row, the product column is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"dim", 
     RowBox[{
      SubscriptBox[
       StyleBox["V", "TI"], "\[Lambda]"], "\[CenterDot]", "dim"}], 
     SubscriptBox[
      StyleBox["W", "TI"], "\[Lambda]"], 
     RowBox[{"(", "2", ")"}]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"(", "multiplicity", ")"}], "\[Cross]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"spin", "-"}], 
       StyleBox["j", "TI"], " ", 
       RowBox[{"block", " ", "size"}]}], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"45be524d-4598-41c7-8a65-51a61b5d9600"],
 ", and the column sums to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d3d5ac17-618c-4bfa-af15-6a8974f30883"],
 "."
}], "Text",ExpressionUUID->"8afcd051-0149-48b0-bcbe-14f27024472e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Young projectors", "Section",ExpressionUUID->"e3aba466-802e-4ea7-922d-a3df9c461462"],

Cell[TextData[{
 "The ",
 StyleBox["Young symmetrizer", "TI"],
 " for a tableau ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7edb3012-96fd-43c1-9936-002c3b25e2ef"],
 " of shape ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8ae75352-0219-4c0f-ad03-5d848a5b1a5d"],
 " is the group-algebra element ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["T", "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["a", "TI"], 
     StyleBox["T", "TI"]], 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["T", "TI"]], "\[Element]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3b850a03-ed5c-4188-b7f0-365db87ea3e2"],
 ", with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "da5b314b-b92c-49db-9059-3f6a0dca5508"],
 " summing over the row stabilizer and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "779f81a9-2069-46f2-a214-804c5f1d6f4f"],
 " over the column stabilizer with signs; it is idempotent up to scale, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["T", "TI"], "2"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["n", "TI"], "!", "/", 
      SuperscriptBox[
       StyleBox["f", "TI"], "\[Lambda]"]}], ")"}], 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"eae0cd9c-804b-403e-8fa9-c5827005d5c7"],
 ", and the normalized projector"
}], "Text",ExpressionUUID->"1d968b03-92da-47b0-9e66-0c3a4947f774"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["T", "TI"]], " ", "\[LongEqual]", " ", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        StyleBox["f", "TI"], "\[Lambda]"], 
       RowBox[{
        StyleBox["n", "TI"], "!"}]], " ", 
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["T", "TI"]]}]}], ",", "    ", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["T", "TI"], 
      RowBox[{" ", "2"}]], "\[LongEqual]", 
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["T", "TI"]]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"628d311b-2e2c-4004-\
8192-4d6137c7f637"],

Cell[TextData[{
 "lands a tensor in one specific copy of the ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6d0e30cc-d267-450d-b456-ec5c076e8112"],
 "-irrep inside ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a0da74f8-b173-48bb-a81a-3b75e66f0f43"],
 ". The paclet exposes ",
 Cell[BoxData[
  RowBox[{"YoungSymmetrize", "[", 
   RowBox[{"T", ",", " ", "tab"}], "]"}]], "InlineFormula",ExpressionUUID->
  "d70373f5-9424-4666-8008-b40360274a9e"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["T", "TI"]], "\[CenterDot]", 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1f0ae22a-bbec-41e9-a024-0db810c9371f"],
 ") and ",
 Cell[BoxData[
  RowBox[{"YoungProject", "[", 
   RowBox[{"T", ",", " ", "tab"}], "]"}]], "InlineFormula",ExpressionUUID->
  "f1f0b631-fb42-40d4-b8f1-6dad42f0435d"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["T", "TI"]], "\[CenterDot]", 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d77e6cfb-0696-4ec4-abb1-1299fea5f7ba"],
 ")."
}], "Text",ExpressionUUID->"4d420e9b-2b97-4aa6-89b9-626ce3be6694"],

Cell[TextData[{
 "Two operational facts used below. (1) A ",
 StyleBox["single-tableau", "TI"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3c6fd637-539f-472c-b478-78e5ae9145a5"],
 " is an algebraic idempotent but ",
 StyleBox["not", "TI"],
 " an orthogonal Hermitian projector, so single-tableau norms do not satisfy \
Pythagoras. (2) Summing those single-tableau projectors over the standard \
tableaux, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M", "TI"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["T", "TI"], "\[Element]", 
      StyleBox["SYT",
       FontSlant->"Plain"], 
      RowBox[{"(", "\[Lambda]", ")"}]}],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ab0441bc-2ea7-4c7d-a111-7eadecd89758"],
 " gives an operator whose range is the entire ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9daee1b6-f7a3-4b54-81ac-edf3dfbb79d3"],
 "-block but which is itself generally not idempotent; the orthogonal \
projector onto that block is the genuine Hermitian idempotent ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], "\[Lambda]"], "\[LongEqual]", 
    StyleBox["M", "TI"], " ", 
    SuperscriptBox[
     StyleBox["M", "TI"], "+"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d8128981-d091-42dc-8ffa-08f548fa818b"],
 " (",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["M", "TI"], "+"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"524fc0d1-a29d-41db-8c92-f910af61f075"],
 " the Moore-Penrose pseudoinverse). For ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ff128499-158e-4d48-b4f5-0d36b7bd2a42"],
 " qubits the shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Lambda]", "1"], ",", 
      SubscriptBox["\[Lambda]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"589e36ed-2547-4ba1-9d4e-fb8c73ca7020"],
 " labels the total-",
 Cell[BoxData[
  FormBox[
   StyleBox["J", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "69026b3a-83fe-4f13-a5ea-134900cb9221"],
 " sector with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["J", "TI"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Lambda]", "1"], "-", 
      SubscriptBox["\[Lambda]", "2"]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"248dfe17-49b5-4f43-aa97-66a7be180b9c"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleVerticalBar]", 
    SubscriptBox[
     StyleBox["P", "TI"], "\[Lambda]"], " ", "|", "\[Psi]", "\[RightAngleBracket]", 
    SuperscriptBox["\[DoubleVerticalBar]", "2"]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b0adfac5-7a01-4c8e-b575-b05839d2c99d"],
 " is the probability of measuring total spin ",
 Cell[BoxData[
  FormBox[
   StyleBox["J", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1d36077a-40a1-47b7-baf1-3333970d4cf9"],
 " in state ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", "\[Psi]", "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"dbbf1fb6-1c1c-42dc-b6b9-abcc07d912dc"],
 ". Define a helper for that probability."
}], "Text",ExpressionUUID->"d0bd9ac4-d012-4a10-bbde-db94686e2c84"],

Cell[BoxData[
 RowBox[{
  RowBox[{"isotypicProjector", "[", "syts_List", "]"}], ":=", 
  RowBox[{
   RowBox[{"isotypicProjector", "[", "syts", "]"}], "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"TableauSize", "[", 
         RowBox[{"First", "[", "syts", "]"}], "]"}]}], ",", "m"}], "}"}], ",", 
     RowBox[{
      RowBox[{"m", "=", 
       TemplateBox[{
         RowBox[{"(", 
           RowBox[{
             RowBox[{"Function", "[", 
               RowBox[{"ket", ",", 
                 RowBox[{"Flatten", "[", 
                   RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"YoungProject", "[", 
                    RowBox[{"ket", ",", "#1"}], "]"}], "&"}], ")"}], "/@", 
                    "syts"}], "]"}], "]"}]}], "]"}], "/@", 
             RowBox[{
               RowBox[{"(", 
                 RowBox[{
                   RowBox[{"Normal", "[", 
                    RowBox[{"SparseArray", "[", 
                    RowBox[{
                    RowBox[{"#1", "\[Rule]", "1"}], ",", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"2", ",", "n"}], "]"}]}], "]"}], "]"}], "&"}], 
                 ")"}], "/@", 
               RowBox[{"Tuples", "[", 
                 RowBox[{
                   RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}], ",", "n"}], "]"}]}]}], 
           ")"}]},
        "Transpose"]}], ";", 
      RowBox[{"m", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", "\[LessEqual]", "5"}], ",", "m", ",", 
         RowBox[{"N", "[", "m", "]"}]}], "]"}]}], ";", 
      RowBox[{"m", ".", 
       TemplateBox[{"m"},
        "PseudoInverse"]}]}]}], "]"}]}]}]], "Input",ExpressionUUID->"d06657d0-\
4b52-4d33-b939-d6d5bcea0c32"],

Cell[BoxData[
 RowBox[{
  RowBox[{"isoNormSq", "[", 
   RowBox[{"psi_", ",", "syts_List"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", "=", 
      RowBox[{"isotypicProjector", "[", "syts", "]"}]}], "}"}], ",", 
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{"Conjugate", "[", 
       RowBox[{"Flatten", "[", "psi", "]"}], "]"}], ".", "p", ".", 
      RowBox[{"Flatten", "[", "psi", "]"}]}], "]"}]}], "]"}]}]], "Input",Expre\
ssionUUID->"8635577a-8177-4737-b463-6aa93c7dcb5b"],

Cell[TextData[{
 "In closed form, ",
 Cell[BoxData[
  RowBox[{"isoNormSq", "[", 
   RowBox[{"psi", ",", " ", "syts"}], "]"}]], "InlineFormula",ExpressionUUID->
  "1d94c578-174d-47a1-b4a0-ea01ca17fa8b"],
 " returns"
}], "Text",ExpressionUUID->"52b0cc02-9e3d-4987-93d7-177f7fcdbca9"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SuperscriptBox[
     TemplateBox[{
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], "\[Lambda]"], 
         TemplateBox[{"\[Psi]"}, "Ket"]}]},
      "Norm"], "2"], "\[LongEqual]", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"\[Psi]", "|", 
      SubscriptBox[
       StyleBox["P", "TI"], "\[Lambda]"], "|", "\[Psi]"}], 
     "\[RightAngleBracket]"}]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellChangeTimes->{{3.989017873255025*^9, 3.989017875580987*^9}, {
  3.989017907675576*^9, 
  3.989018017019041*^9}},ExpressionUUID->"3925a0d6-257f-4511-bbce-\
abff59bd3983"],

Cell[TextData[{
 "(equal because ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"eeb8961e-94c0-4f3f-968f-a21a29aed0ed"],
 " is a Hermitian idempotent), with the orthogonal isotypic projector"
}], "Text",ExpressionUUID->"89bab108-a665-40cd-a567-32c004df459f"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["P", "TI"], "\[Lambda]"], "\[LongEqual]", 
     RowBox[{
      StyleBox["M", "TI"], " ", 
      SuperscriptBox[
       StyleBox["M", "TI"], "+"]}]}], ",", "    ", 
    RowBox[{
     StyleBox["M", "TI"], "\[LongEqual]", 
     RowBox[{
      UnderscriptBox["\[Sum]", 
       StyleBox["T", "TI"],
       LimitsPositioning->True], 
      SubscriptBox[
       StyleBox["P", "TI"], 
       StyleBox["T", "TI"]]}]}]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"03091d34-c4db-49fd-\
8933-7a84a550842a"],

Cell[TextData[{
 "summed over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[Element]", 
    StyleBox["S", "TI"], 
    StyleBox["Y", "TI"], 
    StyleBox["T", "TI"], 
    RowBox[{"(", "\[Lambda]", ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8a02c0c5-b741-4c31-bf2b-3f55f5acd548"],
 ", and each single-tableau Young projector"
}], "Text",ExpressionUUID->"cd241093-cf8f-4818-809d-ef49167c2c71"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["P", "TI"], 
      StyleBox["T", "TI"]], " ", "\[LongEqual]", " ", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        StyleBox["f", "TI"], "\[Lambda]"], 
       RowBox[{
        StyleBox["n", "TI"], "!"}]], " ", 
      SubscriptBox[
       StyleBox["c", "TI"], 
       StyleBox["T", "TI"]]}]}], ",", "    ", 
    RowBox[{
     SubscriptBox[
      StyleBox["c", "TI"], 
      StyleBox["T", "TI"]], " ", "\[LongEqual]", " ", 
     RowBox[{
      SubscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["T", "TI"]], " ", 
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["T", "TI"]]}], " ", "\[LongEqual]", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        UnderscriptBox["\[Sum]", 
         RowBox[{"\[Sigma]", "\[Element]", 
          SubscriptBox[
           StyleBox["R", "TI"], 
           StyleBox["T", "TI"]]}],
         LimitsPositioning->True], "\[Sigma]"}], ")"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{"\[Tau]", "\[Element]", 
           SubscriptBox[
            StyleBox["C", "TI"], 
            StyleBox["T", "TI"]]}],
          LimitsPositioning->True], 
         StyleBox[
          RowBox[{"s", "g", "n"}], "TI"], 
         RowBox[{"(", "\[Tau]", ")"}], " ", "\[Tau]"}], ")"}], "."}]}]}]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"36cedef7-a466-4ab5-\
b578-9bb0f3a6180d"],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f8050363-a6ae-4581-a78b-7227647a84c8"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["C", "TI"], 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "eeaf458e-1879-4920-903d-813ea9f34ca4"],
 " are the row and column stabilizers of ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "28f3ee80-258d-4af7-8fc3-cad9dd8f742e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["f", "TI"], "\[Lambda]"], "\[LongEqual]", "dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c4f5c668-202f-4a50-b292-dc47acda6d03"],
 " (= number of SYTs of shape ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3904afa2-aec1-4346-84b0-70dbc9ad9b3a"],
 " = ",
 Cell[BoxData[
  RowBox[{"TableauDimension", "[", "lambda", "]"}]], "InlineFormula",
  ExpressionUUID->"d020b46e-752d-4131-b851-be889c6a6603"],
 "), and each ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", "\[Element]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a3f13bf7-be4d-4d11-8fab-2153581a8862"],
 " acts on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"de0a2292-deef-4504-8405-82006e5fe65b"],
 " by permuting the ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7d237600-e132-4ff7-bfaf-7356ed547029"],
 " tensor slots. The isotypic projector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d0f0236b-e02e-4fd9-b859-a65a28477f84"],
 " has the equivalent character form (a general identity for finite groups),"
}], "Text",ExpressionUUID->"68b265d9-0b95-4041-be44-033d5b90bbf5"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["P", "TI"], "\[Lambda]"], " ", "\[LongEqual]", " ", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        StyleBox["f", "TI"], "\[Lambda]"], 
       RowBox[{
        StyleBox["n", "TI"], "!"}]], 
      RowBox[{
       UnderscriptBox["\[Sum]", 
        RowBox[{"\[Sigma]", "\[Element]", 
         SubscriptBox[
          StyleBox["S", "TI"], 
          StyleBox["n", "TI"]]}],
        LimitsPositioning->True], 
       RowBox[{
        SubscriptBox["\[Chi]", "\[Lambda]"], 
        RowBox[{"(", "\[Sigma]", ")"}], " ", "\[Sigma]"}]}]}]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"d308af30-a2c4-4175-\
89fc-2c7ca29c5c50"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Chi]", "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a303131b-e14b-4c2e-9779-e0904af4fe7e"],
 " is the irreducible ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d0bb0b65-699e-4e88-bc05-dc0338835c2f"],
 "-character. Unlike the individual ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "285ebcc6-599b-4436-8fc0-fab5e2271f72"],
 " (idempotent but not self-adjoint), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"27f58893-da08-42e8-b6ab-9e5171e42ec1"],
 " is a genuine orthogonal Hermitian projector, so"
}], "Text",ExpressionUUID->"390d1026-23f7-4cfb-b711-a36906befc5f"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox[
       TemplateBox[{
         RowBox[{
           SubscriptBox[
            StyleBox["P", "TI"], "\[Lambda]"], 
           TemplateBox[{"\[Psi]"}, "Ket"]}]},
        "Norm"], "2"], "\[LongEqual]", 
      RowBox[{
       StyleBox["Pr", "TI"], "(", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox[
          StyleBox["S", "TI"], 
          StyleBox[
           RowBox[{"t", "o", "t"}], "TI"], "2"], "\[LongEqual]", 
         RowBox[{
          StyleBox["J", "TI"], 
          RowBox[{"(", 
           RowBox[{
            StyleBox["J", "TI"], "+", "1"}], ")"}]}]}], " ", "|", " ", "|", 
        "\[Psi]"}]}]}], "\[RightAngleBracket]"}], ")"}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",
 CellChangeTimes->{
  3.989018079797839*^9},ExpressionUUID->"c64f5008-2bd2-42f0-adbe-\
19de8b75bd75"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["J", "TI"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Lambda]", "1"], "-", 
      SubscriptBox["\[Lambda]", "2"]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"25df20f9-0a62-4189-93b0-5f01bcae6473"],
 "."
}], "Text",ExpressionUUID->"e6df206b-2727-4973-81bd-fe51f068ea84"],

Cell[TextData[{
 StyleBox["Worked example.", "TI"],
 " For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["GHZ",
      FontSlant->"Plain"], "3"], "\[RightAngleBracket]", "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"|", "000"}], "\[RightAngleBracket]"}], "+", 
    RowBox[{"|", "111"}], "\[RightAngleBracket]", ")", "/", 
    SqrtBox["2"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8b2beb2a-5bbc-43d0-b371-4d8db8a24f62"],
 " and shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "3", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8be77914-a24d-4fcc-a15f-0e990f0087c6"],
 " with the unique SYT ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}], "}"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"38ee4857-ca8f-4c40-af6c-14fed9916f57"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox["T", "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["S", "TI"], "3"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ef797fa1-c076-4cdb-a0b7-2652407de63c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     StyleBox["T", "TI"]], "\[LongEqual]", 
    RowBox[{"{", 
     StyleBox["e", "TI"], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"70eaca21-fb45-41af-997a-ce73d1b13323"],
 " (every column has length ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e4f19d5c-33b6-48b8-a0ea-2ffc822def2d"],
 "), so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["T", "TI"]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{"\[Sigma]", "\[Element]", 
      SubscriptBox[
       StyleBox["S", "TI"], "3"]}],
     LimitsPositioning->True], "\[Sigma]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"eab621d6-e9f5-4860-8e26-54746c3d2ece"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     RowBox[{"{", "3", "}"}]], "\[LongEqual]", 
    FractionBox["1", "6"], 
    UnderscriptBox["\[Sum]", "\[Sigma]",
     LimitsPositioning->True], "\[Sigma]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"1a1f91e7-b82c-4ecf-b299-b830cf6ba522"],
 " is the full symmetrizer. Each ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a7e8ab35-8263-4c57-8baa-7a877014c986"],
 " leaves ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["GHZ",
      FontSlant->"Plain"], "3"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"aa4ce6c3-84ae-47d0-9acd-f03f7c7d3333"],
 " invariant, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     RowBox[{"{", "3", "}"}]], "|", 
    SubscriptBox[
     StyleBox["GHZ",
      FontSlant->"Plain"], "3"], "\[RightAngleBracket]", "\[LongEqual]", "|", 
    
    SubscriptBox[
     StyleBox["GHZ",
      FontSlant->"Plain"], "3"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"40b41bf2-15b5-42b2-bf61-c0e333438e5c"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleVerticalBar]", 
    SubscriptBox[
     StyleBox["P", "TI"], 
     RowBox[{"{", "3", "}"}]], "|", 
    SubscriptBox[
     StyleBox["GHZ",
      FontSlant->"Plain"], "3"], "\[RightAngleBracket]", 
    SuperscriptBox["\[DoubleVerticalBar]", "2"], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d7be63dd-70df-4cc7-b4c7-07b92fe14716"],
 ". For shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3e259353-36b8-4109-badc-6453dfcf8d5d"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["A", "TI"]], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", "3", "}"}]}], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"180514c1-74cf-438a-ba25-b9b330da617b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     SubscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["A", "TI"]]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["e", "TI"], "+", 
      RowBox[{"(", "12", ")"}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["e", "TI"], "-", 
      RowBox[{"(", "13", ")"}]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6f63a879-173b-45d8-8dd5-3009f2e1a456"],
 "; each computational state ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["i", "TI"], 
    StyleBox["i", "TI"], 
    StyleBox["i", "TI"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8fe6223f-8a12-41f8-b9ca-76a8ed357d88"],
 " is invariant under both ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "12", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"aa26ab8e-1c38-4639-b4ce-840071730ec0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "13", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"35dfb19b-8f77-45cc-a5e4-1ba397b6f257"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["e", "TI"], "-", 
      RowBox[{"(", "13", ")"}]}], ")"}], "|", 
    SubscriptBox[
     StyleBox["GHZ",
      FontSlant->"Plain"], "3"], "\[RightAngleBracket]", "\[LongEqual]", 
    "0"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "34ff68de-6055-4ff8-833d-a3c19b64666b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     SubscriptBox[
      StyleBox["T", "TI"], 
      StyleBox["A", "TI"]]], "|", 
    SubscriptBox[
     StyleBox["GHZ",
      FontSlant->"Plain"], "3"], "\[RightAngleBracket]", "\[LongEqual]", 
    "0"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "288f16f0-763b-451f-9c29-17ce9b3ae5d2"],
 ". The same kills ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["c", "TI"], 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["B", "TI"]]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8728d86b-ef11-4423-a4a1-7014a4686117"],
 ", giving ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}]], "|", 
    SubscriptBox[
     StyleBox["GHZ",
      FontSlant->"Plain"], "3"], "\[RightAngleBracket]", "\[LongEqual]", 
    "0"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d6180595-236c-48ed-b280-d283979267ec"],
 ". These two algebraic facts (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleVerticalBar]", 
    SubscriptBox[
     StyleBox["P", "TI"], 
     RowBox[{"{", "3", "}"}]], "|", 
    SubscriptBox[
     StyleBox["GHZ",
      FontSlant->"Plain"], "3"], "\[RightAngleBracket]", 
    SuperscriptBox["\[DoubleVerticalBar]", "2"], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "16272439-7b9a-40f9-b8eb-d00f1290bdd3"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleVerticalBar]", 
    SubscriptBox[
     StyleBox["P", "TI"], 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}]], "|", 
    SubscriptBox[
     StyleBox["GHZ",
      FontSlant->"Plain"], "3"], "\[RightAngleBracket]", 
    SuperscriptBox["\[DoubleVerticalBar]", "2"], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "232cbbd4-a4c1-4735-8309-6d78985e08f5"],
 ") are exactly what the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["GHZ",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5b33f759-5ce1-4826-83ec-85aca09124c4"],
 " cells below produce."
}], "Text",ExpressionUUID->"efc82efb-37d9-49fc-b148-fccbb509df21"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["GHZ",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f2526441-27cb-45a9-b8b2-4f137bdc96f9"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["W",
     FontSlant->"Plain"], "3"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fa2ba1a5-578f-4638-9eb8-bc42ab89a587"],
 ": same total-",
 Cell[BoxData[
  FormBox[
   StyleBox["J", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c7c35fee-b3db-4002-adb7-f50d979c0417"],
 ", different ",
 Cell[BoxData[
  FormBox[
   StyleBox["M", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8dfe59ed-275e-45db-9da3-636297c2d299"]
}], "Section",ExpressionUUID->"1e1cc45f-1495-4b6d-8f23-2ea26c6b34c1"],

Cell[TextData[{
 "The 3-qubit GHZ state is a ",
 StyleBox["genuine", "TI"],
 " tensor-network node: a COPY/delta tensor where three legs share one bond, \
so contracting that bond forces all three physical indices equal. Build it \
that way through the paclet (three rank-2 tensors hyperedged on bond ",
 Cell[BoxData["\"\<a\>\""], "InlineFormula",ExpressionUUID->
  "367a365d-9ae5-4540-aa04-3eaea7d74992"],
 ", normalized so the contraction is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Delta]", 
     StyleBox[
      RowBox[{"i", "j", "k"}], "TI"]], "/", 
    SqrtBox["2"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"|", "000"}], "\[RightAngleBracket]"}], "+", 
    RowBox[{"|", "111"}], "\[RightAngleBracket]", ")", "/", 
    SqrtBox["2"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1adb9fb4-dba1-47a6-a920-e29e38258e59"],
 ")."
}], "Text",ExpressionUUID->"6784fc6f-1e69-4494-a50d-fa1444d92322"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ghz3TN", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "6"}], ")"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "6"}], ")"}]}]}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "6"}], ")"}]}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<q1\>\"", ",", " ", "\"\<a\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<q2\>\"", ",", " ", "\"\<a\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<q3\>\"", ",", " ", "\"\<a\>\""}], "}"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<q1\>\"", ",", " ", "\"\<q2\>\"", ",", " ", "\"\<q3\>\""}], 
      "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"7bdf7079-975a-41d7-8df3-d462929294cb"],

Cell[TextData[{
 "Inspect the hypergraph: three rank-2 tensors all bonded on the shared edge ",
 Cell[BoxData["\"\<a\>\""], "InlineFormula",ExpressionUUID->
  "cd57dbdd-e9db-4160-a094-c0a7d1e70dbb"],
 ", with three free physical legs."
}], "Text",ExpressionUUID->"1cbd92b7-641e-4f50-8699-362f4493b0a8"],

