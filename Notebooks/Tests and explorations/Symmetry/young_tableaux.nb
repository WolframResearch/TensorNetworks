Cell[CellGroupData[{

Cell["Conjugate (transpose) diagram", "Section",ExpressionUUID->"0595ed91-f217-4399-b804-203809e0dede"],

Cell[TextData[{
 "Swapping rows and columns of a Young diagram gives its ",
 StyleBox["conjugate", "TI"],
 " (or ",
 StyleBox["transpose", "TI"],
 ") ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Lambda]", 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c5dcedba-d2eb-408d-809c-e5cec2d452c3"],
 ": the box at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fc85391d-1a03-4b93-bd00-0028a1ac410c"],
 " moves to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["j", "TI"], ",", 
     StyleBox["i", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"224b10b8-bdd1-4ee3-8f1c-f131a10fe047"],
 ", and ",
 Cell[BoxData[
 "TransposePartition"], "InlineFormula",ExpressionUUID->
  "7300145d-0daa-43a6-8298-fbac07719b05"],
 " returns the new partition."
}], "Text",ExpressionUUID->"e6c33620-1764-4328-8299-ba8670cdaa99"],

