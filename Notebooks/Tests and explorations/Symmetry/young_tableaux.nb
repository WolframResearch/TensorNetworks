Cell[CellGroupData[{

Cell[TextData[{
 "Schur-Weyl bookkeeping on ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5245a530-63e3-4b8a-8d25-e92ffd695b18"],
 " qubits"
}], "Section",ExpressionUUID->"2b87da98-4900-4e87-81fa-f028e7f18c5d"],

Cell[TextData[{
 "Schur-Weyl duality decomposes ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8ef58f40-c0ce-478c-b457-61eab88da2f7"],
 " as a ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GL",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}], "\[Cross]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"09da1190-8885-4447-ac05-062b5b6a93dc"],
 " bimodule,"
}], "Text",ExpressionUUID->"fa2824da-59d3-40c4-bbd3-1f4347bfa0bd"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["V", "TI"], 
      RowBox[{"\[CircleTimes]", 
       StyleBox["n", "TI"]}]], " ", "\[TildeFullEqual]", " ", 
     RowBox[{
      SubscriptBox["\[CirclePlus]", 
       RowBox[{
        RowBox[{"\[Lambda]", " ", "\[RightTee]", " ", 
         StyleBox["n", "TI"]}], "\n", 
        RowBox[{
         RowBox[{"\[ScriptL]", 
          RowBox[{"(", "\[Lambda]", ")"}]}], "\[LessEqual]", 
         StyleBox["d", "TI"]}]}]], 
      RowBox[{
       SubscriptBox[
        StyleBox["W", "TI"], "\[Lambda]"], "\[CircleTimes]", 
       SubscriptBox[
        StyleBox["V", "TI"], "\[Lambda]"]}]}]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"bf05c915-0bba-4434-\
9002-bc4bf4251ace"],

Cell[TextData[{
 "so dimensions satisfy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["n", "TI"]], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", "\[Lambda]",
     LimitsPositioning->True], "dim", 
    SubscriptBox[
     StyleBox["W", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}], "\[CenterDot]", "dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9b94214f-f29c-4d76-9e0f-e89062e227b3"],
 ". For ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bfd721cc-cab5-4e47-b678-ddeb7c32904e"],
 " qubits this reads as \"spin-",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "323a6cb0-ed98-4bed-8482-3e52ab4aafd0"],
 " appears with multiplicity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"83e34909-625e-4ee4-ad7e-9e6e8158b4d2"],
 "\". The next three cells expand the sum for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "2", ",", "3", ",", "4"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "32239fcc-4b49-489e-9c73-ee0f7398d733"],
 " qubits."
}], "Text",ExpressionUUID->"57434ba7-480c-4086-a959-060c1b602649"],

