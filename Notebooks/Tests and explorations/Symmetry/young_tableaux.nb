Cell[TextData[{
 "GHZ and W therefore both live entirely in the spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e981fb6c-226c-4cdd-99eb-4654f5280069"],
 " block. Young projection cannot separate them; to distinguish W from GHZ \
one needs an ",
 StyleBox["additional", "TI"],
 " operator inside that block (e.g., ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["z", "TI"], 
    StyleBox["tot",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2066c5df-32fd-4711-beda-5ab457102ab0"],
 ")."
}], "Text",ExpressionUUID->"8281ce70-0a34-4d3e-a426-8795a0c9dc86"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "A product state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"+"},
     "Ket"], "\[CircleTimes]", 
    TemplateBox[{"0"},
     "Ket"], "\[CircleTimes]", 
    TemplateBox[{"+"},
     "Ket"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "02077a81-d3d0-4ab2-9dab-49d00a949aad"],
 ": nontrivial ",
 Cell[BoxData[
  FormBox[
   StyleBox["J", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "180d47fa-6a13-413f-84a7-88f5f7ff5ead"],
 "-spectrum"
}], "Section",
 CellChangeTimes->{{3.989018111948431*^9, 
  3.9890181227684383`*^9}},ExpressionUUID->"78eaf4dc-6b6b-4346-b775-\
ce4a2353cd3d"],

Cell[TextData[{
 "A product state has zero entanglement, yet ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "\[RightVector]"], 
    StyleBox["tot",
     FontSlant->"Plain"], 
    RowBox[{" ", "2"}]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2ad758e0-d850-4fa1-a174-9230982ae981"],
 " does not have a definite eigenvalue on it: adding three spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f9552712-17ab-416e-b6b0-fb9615e9a636"],
 "s quantum-mechanically gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["J", "TI"], "\[LongEqual]", 
    FractionBox["3", "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cf281260-7b33-4372-8874-50d2b48432dd"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["J", "TI"], "\[LongEqual]", 
    FractionBox["1", "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0a72131e-0bcb-4ea3-9d46-a76c01f7e58b"],
 " pieces both. Build ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "+"}], "\[RightAngleBracket]", "\[CircleTimes]", 
    RowBox[{"|", "0"}], "\[RightAngleBracket]", "\[CircleTimes]", 
    RowBox[{"|", "+"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a3ceda78-0719-42e1-b818-181becaa3551"],
 " as a TN of three rank-",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "36b2db15-8cf5-41e3-91f0-1cdd853110f6"],
 " single-qubit tensors with no internal bonds."
}], "Text",ExpressionUUID->"b5488cae-7a5d-446c-a7a1-7b4b2a4a4e62"],

