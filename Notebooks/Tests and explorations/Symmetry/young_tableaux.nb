Cell[CellGroupData[{

Cell["Standard Young tableaux", "Section",ExpressionUUID->"45dfe121-5790-4b3f-8022-8472d7ce2c28"],

Cell[TextData[{
 "A ",
 StyleBox["standard Young tableau", "TI"],
 " (SYT) of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[RightTee]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cf67fc9c-7336-4d16-aa55-6b566c425bc1"],
 " is a filling of the ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "efbc1728-8127-4a4e-b60b-1e7faa0e55d2"],
 " boxes with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", 
     StyleBox["n", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"23b95492-f5f4-4919-965e-834e81a5612f"],
 " (each used exactly once) that strictly increases left-to-right along every \
row ",
 StyleBox["and", "TI"],
 " top-to-bottom down every column. The paclet's ",
 StyleBox["explicit-rows form", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", "rows", "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "daf04a42-4cab-4b97-9aeb-0b26fd35b626"],
 " accepts any such filling and exposes it for downstream projectors."
}], "Text",ExpressionUUID->"02ae651e-431a-4d8b-b282-37137512908b"],

