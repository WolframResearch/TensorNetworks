Cell["Contract.", "Text",ExpressionUUID->"05ed7f37-c2d7-436b-afb6-3add7d3f82f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vb4b", " ", "=", " ", 
   RowBox[{"TensorNetworkContract", " ", "@", " ", "vb4bTN"}]}], 
  ";"}]], "Input",
 CellLabel->"In[76]:=",ExpressionUUID->"553cd7aa-bc95-44e0-a643-158b7ab7017d"],

Cell[TextData[{
 "It also lives in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9101f844-7f36-419d-89c8-601f86bf1483"],
 " block, and stays there after collective noise."
}], "Text",ExpressionUUID->"081821fc-6d94-4a64-b53a-9bff945f99ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", " ", "@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"isoNormSq", "[", 
     RowBox[{"vb4b", ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"YoungTableau", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}], "]"}], ",", " ", 
        RowBox[{"YoungTableau", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}]}], "}"}]}], 
     "]"}], ",", "\n", "   ", 
    RowBox[{"isoNormSq", "[", 
     RowBox[{
      RowBox[{"applyCollective", "[", 
       RowBox[{"V", ",", " ", "vb4b"}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"YoungTableau", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}], "]"}], ",", " ", 
        RowBox[{"YoungTableau", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}]}], "}"}]}], 
     "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[77]:=",ExpressionUUID->"411275dc-aae3-4d75-b5f4-29717a2ecca1"],

