}, Open  ]],

Cell[TextData[{
 "And ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "e1058ec7-6a6a-4c61-851e-5fcdce5c3ce6"],
 " multiplies by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "!"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"99f34cfe-8c0d-445d-81db-bc591e401fc8"],
 " to give the full irrep dimension ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["f", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7db4a714-5789-4cac-a2fb-a1faa85b8ed7"],
 "."
}], "Text",ExpressionUUID->"d76fc58b-0067-432b-a3f6-39753f979307"],

