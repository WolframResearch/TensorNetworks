Cell[TextData[{
 "The count of standard fillings of shape ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4dda387a-b262-4cac-82f8-4b89df96d404"],
 " equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6b1b96ba-b395-4bb5-afcd-0b3c20468c18"],
 " and is what ",
 Cell[BoxData[
  RowBox[{"TableauDimension", "[", "lambda", "]"}]], "InlineFormula",
  ExpressionUUID->"cf0b7f98-081f-4259-8ef3-2784fcda0c28"],
 " returns."
}], "Text",ExpressionUUID->"6121ca5e-7351-4e7b-a7ec-0d1fb288164b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Two SYT, two copies: the physics reading", "Section",ExpressionUUID->"0fd729b6-0a9a-4b20-a7a1-1172c5819b73"],

Cell[TextData[{
 "Why care about distinct fillings of the same shape? Because they label \
distinct copies of the same irreducible representation inside ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"75c8a4b3-18a2-45e7-8d52-7b4f01693a11"],
 ". For three qubits the shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5af34c56-0153-488a-88f5-b168ac1d1cbe"],
 " has exactly two SYTs, and that count is the multiplicity with which \
spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "09309849-1446-4823-b6ad-ec611c6aed01"],
 " appears in ",
 Cell[BoxData[
  FormBox["(", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "75cfbf02-0b86-474a-9693-f1d920ea47ca"],
 " under collective ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU",
     FontSlant->"Plain"], "(", "2", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"986da24d-fa5d-4a43-9098-7a1d7771faea"],
 "."
}], "Text",ExpressionUUID->"6afb558c-7e12-491c-a00b-1a0bfb1033e6"],

