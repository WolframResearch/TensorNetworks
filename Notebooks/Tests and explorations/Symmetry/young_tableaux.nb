Cell[TextData[{
 "Young projectors see the ",
 StyleBox["shape", "TI"],
 " ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "98314f94-44af-4cfe-b25c-82f797567b11"],
 " (equivalently, the total ",
 Cell[BoxData[
  FormBox[
   StyleBox["J", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b3d15b22-26c5-46d3-8a8f-ad011766c6ce"],
 "), not the magnetization ",
 Cell[BoxData[
  FormBox[
   StyleBox["M", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0897aad1-c31b-4cb3-b0ea-e4db0e08083c"],
 ", so both states being fixed by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], 
    RowBox[{"{", "3", "}"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cfdb2c5a-77f7-4abf-a223-340d5a8425ed"],
 " confirms they live in the spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "302d0683-6f5e-49d2-b6e3-6714e1e8d719"],
 " block."
}], "Text",ExpressionUUID->"8f6503e3-8eba-4ba3-a62c-2334a2f590f3"],

Cell[TextData[{
 "Projecting either state onto any SYT of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"490d40d5-da10-47d1-837b-6f73ef317ac7"],
 " gives zero: there is no spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "de06e088-cbcf-4045-bead-2186a2a12666"],
 " content. GHZ:"
}], "Text",ExpressionUUID->"acecf0d3-8a03-4bf0-a793-669f4147f766"],

