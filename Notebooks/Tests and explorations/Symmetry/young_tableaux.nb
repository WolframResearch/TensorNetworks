Cell[TextData[{
 "The paclet exposes a separate predicate ",
 Cell[BoxData[
 "StandardTableauQ"], "InlineFormula",ExpressionUUID->
  "2bbd4225-7797-4353-98bf-c84939e744cc"],
 " that enforces the strict-increase rule (and requires ",
 Cell[BoxData[
 "YoungTableauQ"], "InlineFormula",ExpressionUUID->
  "e0fc4f2c-5fdb-4d33-8aa4-ff415b9a8316"],
 " to pass first). Apply it to the same four fillings: only the first is a \
true SYT."
}], "Text",ExpressionUUID->"d17d83b8-eb28-47d2-aae5-d2a15ed341f9"],

