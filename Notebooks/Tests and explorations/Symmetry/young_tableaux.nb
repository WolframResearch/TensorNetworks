Cell[TextData[{
 "Conjugation is an involution, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Lambda]", 
     StyleBox[
      RowBox[{"T", "\[NoBreak]", "T"}], "TI"]], "\[LongEqual]", "\[Lambda]"}],
    TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c8a8f03b-130e-4f22-9ff3-594c915be4cf"],
 "; representation-theoretically it tensors the symmetric-group irrep with \
the sign representation, which trades \"symmetric in slot ",
 Cell[BoxData[
  FormBox[
   StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "802e0e7e-3f63-4f51-a6ac-f730dc0b517a"],
 "\" for \"antisymmetric in slot ",
 Cell[BoxData[
  FormBox[
   StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f33d5d07-84a1-4315-9b63-2e89b22c0631"],
 "\" wherever it appears, which is why ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox["n", "TI"], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4421af9b-df7d-4354-8fe1-1988b65db97f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "\[Ellipsis]", ",", "1"}], "}"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "36f60147-7a08-4a0b-8976-ddb7dfa0fe1b"],
 " are conjugates: fully symmetric and fully antisymmetric on ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "941a47b8-4863-4880-b99e-911f2ea9ae60"],
 " slots."
}], "Text",ExpressionUUID->"26108c2a-e6bd-40aa-add1-0df64f050b78"],

