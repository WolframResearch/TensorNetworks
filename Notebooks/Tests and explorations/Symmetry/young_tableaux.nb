Cell[TextData[{
 "The two nonzero amplitudes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "000"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"dba78530-e2e0-4572-954c-c0c6f4eb7629"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "111"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"88283668-2e36-4b84-91df-a7a6139dbf29"],
 " identify it as an equal superposition of the spin-3/2 stretched states ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["J", "TI"], "\[LongEqual]", 
    FractionBox["3", "2"], ",", 
    StyleBox["M", "TI"], "\[LongEqual]", "\[PlusMinus]", 
    FractionBox["3", "2"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e1d70d96-725a-41d5-9a29-371e546ec37b"],
 " (definite total spin 3/2, but not an eigenstate of the magnetization)."
}], "Text",ExpressionUUID->"ee6609ca-a964-4f12-97c7-0daa21fb99e4"],

Cell[TextData[{
 "The W state has three nonzero amplitudes at the one-excitation strings; \
load it as a single rank-",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "03b75856-fb01-4f05-8ff7-eae3ed30430d"],
 " tensor through the paclet."
}], "Text",ExpressionUUID->"a406fa6f-f68d-4b20-a0c8-8277ee10c6d5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"w3TN", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Normal", " ", "@", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1", ",", " ", "2"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "2", ",", " ", "1"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "1", ",", " ", "1"}], "}"}]}], "}"}], " ",
           "->", " ", 
          RowBox[{"1", "/", 
           RowBox[{"Sqrt", "[", "3", "]"}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\"\<q1\>\"", ",", " ", "\"\<q2\>\"", ",", " ", "\"\<q3\>\""}],
        "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<q1\>\"", ",", " ", "\"\<q2\>\"", ",", " ", "\"\<q3\>\""}], 
      "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"6230c879-31de-4a99-9bfc-c282756a24bc"],

Cell["\<\
The hypergraph is a single rank-3 node with three free legs (loaded here with \
no internal bonds; unlike GHZ, W has no single-shared-bond COPY-tensor form, \
though it does admit a bond-dimension-2 MPS).\
\>", "Text",ExpressionUUID->"82a27ae8-be47-4c23-8d96-4b1ae0fbe118"],

