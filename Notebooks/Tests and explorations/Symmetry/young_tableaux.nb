  ";"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"b440cd51-ec9d-47f2-a4f6-742d4fed9004"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Integer partitions", "Section",ExpressionUUID->"c0dcfd5c-5bdf-429e-9076-92aecfa51e61"],

Cell[TextData[{
 "A ",
 StyleBox["partition", "TI"],
 " of a positive integer ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3befa027-1f70-49ac-9c20-ff7b7aefecc9"],
 " is a weakly decreasing tuple ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["\[Lambda]", "1"], ",", 
      SubscriptBox["\[Lambda]", "2"], ",", "\[Ellipsis]", ",", 
      SubscriptBox["\[Lambda]", 
       StyleBox["k", "TI"]]}], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c401a48a-0fba-40d1-af4e-fd014e602e1e"],
 " of positive integers summing to ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6c35b46c-65f3-493f-a56a-64ad48b9cebf"],
 "; we write ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[RightTee]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f8a97705-8da4-4c05-aaf0-b684290cfe88"],
 ". The Wolfram Language enumerates them with ",
 Cell[BoxData[
  RowBox[{"IntegerPartitions", "[", "n", "]"}]], "InlineFormula",
  ExpressionUUID->"2042e2c4-dc6c-4cb1-bb6d-bb9e7738dab4"],
 "."
}], "Text",ExpressionUUID->"0b9ed01a-2abf-4079-b18f-ea8432a86a14"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", "4", "]"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"0769d42d-f6a5-4c50-9af4-85e6a2bf067e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "4", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.98901722853222*^9},
 CellLabel->"Out[4]=",
 CellID->1067278478,ExpressionUUID->"314edf5e-e4c4-4234-9e4f-e03ecb845d1d"]
}, Open  ]],

Cell[TextData[{
 "There are five partitions of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0dd4a4f3-941b-4b36-8ade-b058f004454f"],
 ": ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "4", "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}]}], 
   "}"}]], "InlineFormula",ExpressionUUID->
  "e5e9013a-c5bd-4e0d-b33b-52430b9a51bd"],
 ". Each one will become a Young diagram, and each diagram labels one \
irreducible representation of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d059902d-3fe4-47ab-86a0-f7072bd90e27"],
 "."
}], "Text",ExpressionUUID->"46bc933f-f5c0-4e48-b521-2310fe4608d0"],

Cell[TextData[{
 "The paclet provides a predicate ",
 Cell[BoxData[
 "PartitionQ"], "InlineFormula",ExpressionUUID->
  "edd1826f-b88a-482f-affe-8d3132ba82b0"],
 " that decides whether a list of integers is a valid partition (positive \
entries, weakly decreasing). Pick ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", " ", "1"}], "}"}]], "InlineFormula",ExpressionUUID->
  "ae68b4c9-d910-4197-bc01-69f0b567dcee"],
 " from ",
 Cell[BoxData[
  RowBox[{"IntegerPartitions", "[", "4", "]"}]], "InlineFormula",
  ExpressionUUID->"b8896f3e-d470-41fd-86cc-06eb3cdfe7f2"],
 ": it passes."
}], "Text",ExpressionUUID->"e6566f6f-9ea2-4ed3-8379-474a4fb1bd5d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PartitionQ", "[", 
  RowBox[{"{", 
   RowBox[{"3", ",", " ", "1"}], "}"}], "]"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"8a605817-fd27-4c5f-97ab-1f5b6785084a"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.98901722853931*^9},
 CellLabel->"Out[5]=",
 CellID->1965960002,ExpressionUUID->"71151892-e03e-4003-8608-47d8d2088293"]
}, Open  ]],

Cell[TextData[{
 "Swap the same entries into ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "3"}], "}"}]], "InlineFormula",ExpressionUUID->
  "f8d3d015-4d71-4ac2-9932-c17ec383052b"],
 " and the weakly-decreasing condition fails."
}], "Text",ExpressionUUID->"4a972c1d-01d3-4ea7-837c-b53f201c7ba3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PartitionQ", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "3"}], "}"}], "]"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"2969c20c-005c-4416-ad1a-ca5daf9f3efc"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.989017228552085*^9},
 CellLabel->"Out[6]=",
 CellID->706360872,ExpressionUUID->"72f137d8-2a40-4cff-b081-6e5307d318f0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Drawing the diagram", "Section",ExpressionUUID->"48d0d457-5461-4fe5-a040-9d6360b4da30"],

Cell[TextData[{
 "The diagram of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["\[Lambda]", "1"], ",", "\[Ellipsis]", ",", 
      SubscriptBox["\[Lambda]", 
       StyleBox["k", "TI"]]}], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0c76161d-1493-4c59-a0d8-4ea7a1b9b73b"],
 " is drawn (in English notation) as ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "200a8731-5f01-4039-a8f9-a997da00c2a0"],
 " left-justified rows with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0bc954d4-dfa3-4399-bc60-fb30b2d449cb"],
 " boxes in row ",
 Cell[BoxData[
  FormBox[
   StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2aca5fe6-fa9c-45a7-a9a3-c36e4a3fd124"],
 ". The paclet's typed handle is ",
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "e74bf18e-d1c0-449f-bcd9-3c9585576b19"],
 ": in ",
 StyleBox["partition form", "TI"],
 ", ",
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", "lambda", "]"}]], "InlineFormula",
  ExpressionUUID->"cfbc7fcb-5fb0-4a92-9e30-68ecb8db0c61"],
 " fills the boxes with slot labels ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2629fad7-8fca-4013-86cd-c935d110bffe"],
 " row by row and renders the shape. Pick a few extreme shapes to build \
intuition."
}], "Text",ExpressionUUID->"8e57609f-206e-4f9b-bc82-56bf4f34ed74"],

Cell[TextData[{
 "A single row ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox["n", "TI"], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"15a63b3c-1957-4667-97f1-3cec5dacadc0"],
 " is the ",
 StyleBox["fully symmetric", "TI"],
 " shape on ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "afc6512d-ec7c-4d6b-a5b7-1e5ba5d87d34"],
 " slots."
}], "Text",ExpressionUUID->"4db096e0-3ae2-492e-943e-696cc6f88212"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableau", "[", 
  RowBox[{"{", "4", "}"}], "]"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"f69231cc-2bb2-43e5-8f13-f623f043fea7"],

