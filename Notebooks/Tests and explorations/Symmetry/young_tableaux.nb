Cell[TextData[{
 "Apply ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", "4"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d4230daa-0bd4-4875-b70d-94bfbb3ab2bd"],
 " to the valence-bond state from the previous section."
}], "Text",ExpressionUUID->"a9a64873-b038-441d-9df1-8d20d2bd20c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"noisyVB4", " ", "=", " ", 
   RowBox[{"applyCollective", "[", 
    RowBox[{"V", ",", " ", "vb4"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[71]:=",ExpressionUUID->"9fc2de60-d98f-4229-b0ee-73cf8ce90f62"],

Cell[TextData[{
 "Even though every amplitude of ",
 Cell[BoxData[
 "vb4"], "InlineFormula",ExpressionUUID->
  "724a56a8-7cfd-47d1-b90f-4c362ee23eee"],
 " has changed, the entire weight still sits in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b28b8e69-42ac-4850-b72e-01f0b434a960"],
 " block (the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["J", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"71785c54-0082-4320-8242-484ffdc9faf7"],
 " sector). The DFS character of ",
 Cell[BoxData[
 "vb4"], "InlineFormula",ExpressionUUID->
  "d6ae4fe0-1827-481d-b941-b1c4fb3405bb"],
 " is preserved exactly."
}], "Text",ExpressionUUID->"b74a40aa-66f9-4e80-818f-4e15278cf81c"],

