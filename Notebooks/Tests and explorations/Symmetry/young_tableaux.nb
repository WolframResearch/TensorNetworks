Cell[TextData[{
 "The predicate ",
 Cell[BoxData[
 "YoungTableauQ"], "InlineFormula",ExpressionUUID->
  "7c33feb5-3b5c-4389-807e-76e5d6ce1d46"],
 " is ",
 StyleBox["structural", "TI"],
 ": it checks that the shape is a valid partition and that the entries are \
exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "\[Ellipsis]", ",", 
     StyleBox["n", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2329e497-141d-4d45-aa60-5b53653b2263"],
 " used once each, but it does not enforce the strict-increase rule. All four \
fillings above pass."
}], "Text",ExpressionUUID->"ca7a3259-4044-4d97-aa74-7e421b34475b"],

