Cell[CellGroupData[{

Cell[TextData[{
 "SchurDimension: the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GL",
     FontSlant->"Plain"], "(", 
    StyleBox["d", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"811efca4-2adb-467c-96f7-d1550b33747a"],
 " block size"
}], "Section",ExpressionUUID->"2476f04b-02b8-4b25-af6c-ec402c84f7e9"],

Cell[TextData[{
 "A ",
 StyleBox["semistandard Young tableau", "TI"],
 " (SSYT) of shape ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e29af247-6e12-455d-9c95-96eaf0fdbcd6"],
 " with entries in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "\[Ellipsis]", ",", 
     StyleBox["d", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bc428794-4145-4701-ad4b-e1f9b96325ae"],
 " has weakly increasing rows and strictly increasing columns; its count \
equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["W", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8877c9de-2825-4933-9d0b-3498c71bf999"],
 ", the dimension of the irreducible polynomial ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GL",
     FontSlant->"Plain"], "(", 
    StyleBox["d", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"58a04212-3655-49b3-ac0f-bb5782fda622"],
 "-representation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["W", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4cb26fb7-4e8e-4bb8-822a-4c960bb47284"],
 ". The closed form is Stanley's ",
 StyleBox["hook-content", "TI"],
 " formula"
}], "Text",ExpressionUUID->"07d5cf53-8065-496a-8c10-bfa5615235d1"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"dim", 
      SubscriptBox[
       StyleBox["W", "TI"], "\[Lambda]"], 
      RowBox[{"(", 
       StyleBox["d", "TI"], ")"}]}], " ", "\[LongEqual]", " ", 
     RowBox[{
      UnderscriptBox["\[Product]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          StyleBox["i", "TI"], ",", 
          StyleBox["j", "TI"]}], "}"}], "\[Element]", "\[Lambda]"}],
       LimitsPositioning->True], 
      FractionBox[
       RowBox[{
        StyleBox["d", "TI"], "+", 
        StyleBox["j", "TI"], "-", 
        StyleBox["i", "TI"]}], 
       RowBox[{
        SubscriptBox[
         StyleBox["h", "TI"], "\[Lambda]"], "(", 
        RowBox[{
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"]}], ")"}]]}]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"30547fcb-336e-4893-\
8dc5-0767cfdc0ca5"],

Cell[TextData[{
 "returned by ",
 Cell[BoxData[
  RowBox[{"SchurDimension", "[", 
   RowBox[{"lambda", ",", "d"}], "]"}]], "InlineFormula",ExpressionUUID->
  "747edb50-253c-48a1-80fa-35f0c08b49fc"],
 ". For qubits (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"efa1ba35-d53a-401d-9606-38afcec82e62"],
 "), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["W", "TI"], "\[Lambda]"], "(", "2", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"34902ecf-421b-4fe4-a9f4-2b26c80e1eff"],
 " is the spin-",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4d890659-bbbd-4fd2-9e92-8a7397b36741"],
 " representation with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["j", "TI"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Lambda]", "1"], "-", 
      SubscriptBox["\[Lambda]", "2"]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8df176ef-1bce-4d92-b3dc-70b653013f7b"],
 "."
}], "Text",
 CellChangeTimes->{{3.9890177260796747`*^9, 
  3.989017727777508*^9}},ExpressionUUID->"67c42f4b-ef2f-4308-9a90-\
9a8cf84e517e"],

