Cell[TextData[{
 "Physics readout: a singlet-paired dimer state is in the kernel of ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "\[RightVector]"], 
    StyleBox["tot",
     FontSlant->"Plain"], 
    RowBox[{" ", "2"}]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e2a3c01d-6b1d-41c9-82bc-bb8d6cdf9324"],
 ", occupying exactly the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["J", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"829c4f14-ee3e-44fe-a753-e6f3f348e4f3"],
 " block of dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}]], "\[CenterDot]", "dim", 
    SubscriptBox[
     StyleBox["W", "TI"], 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}]], 
    RowBox[{"(", "2", ")"}], "\[LongEqual]", "2", "\[CenterDot]", "1", "\[LongEqual]",
     "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5690e38c-159f-40b9-af33-1eb524ffa054"],
 ". The two SYTs of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5bb2884f-09a0-49f3-b3af-7c66af831c76"],
 " together span that 2D subspace, and the dimer ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SuperscriptBox["\[CapitalPsi]", "-"], 
    SubscriptBox["\[RightAngleBracket]", "12"], "\[CircleTimes]", "|", 
    SuperscriptBox["\[CapitalPsi]", "-"], 
    SubscriptBox["\[RightAngleBracket]", "34"]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a75ab403-6df0-4746-8b6e-acff17e31fea"],
 " sits inside it. This is the calculation underlying valence-bond mean-field \
arguments for frustrated antiferromagnets: identifying which states a \
candidate ansatz can or cannot represent is exactly \"which Young-tableau \
blocks does it have weight in\"."
}], "Text",ExpressionUUID->"18ef2634-f48e-4eb1-b2cc-89cf4f287b60"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Decoherence-free subspaces: Young projectors as collective-noise filters\
\>", "Section",ExpressionUUID->"e94fd3ca-b679-45f4-82b8-c87e0418f9b7"],

Cell[TextData[{
 "The most direct quantum-information payoff of Young projection: ",
 StyleBox["the multiplicity space ", "TI"],
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"53fcc532-67c2-4718-a377-c644a065f942"],
 StyleBox[" is automatically invariant under collective noise", "TI"],
 ". If the environment couples symmetrically to all ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ca8253d6-1c17-4a4e-ab60-72809e0ba6f0"],
 " qubits as a single-qubit unitary ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ca0cdcb7-711c-45e0-84f8-3adf6301ecca"],
 " applied identically to each (",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"994f4418-4e9d-4572-8418-bcd926719fdc"],
 "), the action factors as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["id",
      FontSlant->"Plain"], 
     SubscriptBox[
      StyleBox["V", "TI"], "\[Lambda]"]], "\[CircleTimes]", 
    SubscriptBox["\[Rho]", "\[Lambda]"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ba80c171-73b4-49bf-ae8f-acb97b1d31c5"],
 " on each Schur block, so collective unitaries act as the ",
 StyleBox["identity", "TI"],
 " on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d703ac91-a558-4407-b9ab-5687776ebab3"],
 " and only mix vectors inside ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["W", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"905f3e5d-a6e8-4f75-9c6b-aefbeb663485"],
 ". Logical information encoded in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8cdf6bf9-6ab3-4ae4-bf72-1278974f41c3"],
 " is therefore invisible to the noise: it is a ",
 StyleBox["noiseless subsystem", "TI"],
 " (Knill-Laflamme-Viola). When that block carries spin 0, the noise is the \
identity on the whole block and it is a genuine decoherence-free subspace \
(Lidar-Whaley), no syndrome extraction needed. For 4 qubits the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d82c16e4-11e2-45b6-b4cd-ec5027079809"],
 " block is exactly that case (its spin space is one-dimensional, spin 0), \
with multiplicity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}]], "\[LongEqual]", "2"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "24d5ead2-aa38-4993-9565-a6aff71994bb"],
 ": a 2-dimensional DFS, a noise-free ",
 StyleBox["logical qubit", "TI"],
 " in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["J", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"3dd00184-3c28-4781-aed7-470e7a63b29d"],
 " sector. The point of using Young tableaux here is concrete: the paclet \
identifies that protected subspace algebraically (no trial-and-error search), \
and ",
 Cell[BoxData[
 "isoNormSq"], "InlineFormula",ExpressionUUID->
  "a5bd6162-eec4-4ede-954c-d21945ccca8a"],
 " lets you certify that an encoded state stays inside it after noise."
}], "Text",ExpressionUUID->"6fffdcf1-aa5e-4b8b-92c2-f24875a8f476"],

Cell[TextData[{
 "Apply a single-qubit unitary ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a2d51c57-b6bd-440c-ad45-28ff9fdc9aa8"],
 " identically on all ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "75846cd9-5521-4093-9aee-d520db2d055f"],
 " legs of a state tensor. In Einstein notation, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Psi]", 
     RowBox[{
      SubscriptBox[
       StyleBox["j", "TI"], "1"], "\[Ellipsis]", 
      SubscriptBox[
       StyleBox["j", "TI"], 
       StyleBox["n", "TI"]]}], "\[Prime]"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["V", "TI"], 
     RowBox[{
      SubscriptBox[
       StyleBox["j", "TI"], "1"], 
      SubscriptBox[
       StyleBox["i", "TI"], "1"]}]], "\[CenterEllipsis]", 
    SubscriptBox[
     StyleBox["V", "TI"], 
     RowBox[{
      SubscriptBox[
       StyleBox["j", "TI"], 
       StyleBox["n", "TI"]], 
      SubscriptBox[
       StyleBox["i", "TI"], 
       StyleBox["n", "TI"]]}]], " ", 
    SubscriptBox["\[Psi]", 
     RowBox[{
      SubscriptBox[
       StyleBox["i", "TI"], "1"], "\[Ellipsis]", 
      SubscriptBox[
       StyleBox["i", "TI"], 
       StyleBox["n", "TI"]]}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6dbfa89a-fd76-431f-97d2-b42e2e748797"],
 ": one copy of ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "59aa865f-c0d0-4d41-b6c3-4f26bd1783b2"],
 " per leg, contracted on the input index and exposing the output. The \
paclet's ",
 Cell[BoxData[
 "EinsteinSummation"], "InlineFormula",ExpressionUUID->
  "68b5798f-a6b4-47d1-abe2-b94ac3d3a23e"],
 " reads exactly that, with integer labels (positive for inputs, negative for \
outputs); wrap in ",
 Cell[BoxData[
 "Activate"], "InlineFormula",ExpressionUUID->
  "dbcb7551-b9b7-4952-8bed-c4804b73c893"],
 " to evaluate the resulting ",
 Cell[BoxData[
 "TensorContract"], "InlineFormula",ExpressionUUID->
  "641e05d8-abc9-4ab3-af59-b1af4c435f2c"],
 "."
}], "Text",ExpressionUUID->"f94b18e1-7ff8-434f-8fd5-80538e006770"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"applyCollective", "[", 
    RowBox[{"V_", ",", " ", "psi_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", " ", "=", " ", 
       RowBox[{"ArrayDepth", "[", "psi", "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Activate", " ", "@", " ", 
      RowBox[{"EinsteinSummation", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "k"}], ",", " ", "k"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "n"}], "}"}]}], "]"}], ",", " ", 
           RowBox[{"Range", "[", "n", "]"}]}], "]"}], " ", "->", " ", 
         RowBox[{"-", 
          RowBox[{"Range", "[", "n", "]"}]}]}], ",", "\n", "    ", 
        RowBox[{"Append", "[", 
         RowBox[{
          RowBox[{"ConstantArray", "[", 
           RowBox[{"V", ",", " ", "n"}], "]"}], ",", " ", "psi"}], "]"}]}], 
       "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[68]:=",ExpressionUUID->"88418dc8-a401-40de-aa41-484cef08f636"],

Cell[TextData[{
 "Draw a Haar-random ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Cross]", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"dd18554f-e1ee-499f-8929-52287759d490"],
 " unitary in one line: ",
 Cell[BoxData[
  RowBox[{"CircularUnitaryMatrixDistribution", "[", "n", "]"}]], 
  "InlineFormula",ExpressionUUID->"3c76a34e-0de5-4816-b273-f1e52391ff49"],
 " is the built-in Haar measure on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], "(", 
    StyleBox["n", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8a032046-a1eb-425b-aa77-31f385e8defd"],
 ", and a single ",
 Cell[BoxData[
 "RandomVariate"], "InlineFormula",ExpressionUUID->
  "e73952f3-eb41-41dc-9548-d81002c48b5a"],
 " gives one realization. The overall ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], "(", "1", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"91d819a8-2000-43f9-9a4a-59dae67c7526"],
 " phase makes no difference to the squared-norm tests below, so a \
Haar-uniform ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], "(", "2", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1b351b34-4882-4c3e-93ea-6f9e48b934a2"],
 " is the same data as a Haar-uniform ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU",
     FontSlant->"Plain"], "(", "2", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ace088bc-16e0-4c63-a039-38a8eedef9fb"],
 " for this purpose."
}], "Text",ExpressionUUID->"0e50a34b-2531-425c-81cb-3e286708fcfe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "101", "]"}], ";"}], "\n", 
 RowBox[{"V", " ", "=", " ", 
  RowBox[{"RandomVariate", "[", 
   RowBox[{"CircularUnitaryMatrixDistribution", "[", "2", "]"}], 
   "]"}]}]}], "Input",
 CellLabel->"In[69]:=",ExpressionUUID->"709bbb8f-342a-4eab-8140-6ab2e4f36b1d"],

