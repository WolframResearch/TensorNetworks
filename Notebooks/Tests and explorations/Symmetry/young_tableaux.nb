 CellID->163689309,ExpressionUUID->"2d22a77f-247c-42c9-8a1e-0cfdd2ed4579"]
}, Open  ]],

Cell[TextData[{
 "For an MPS half-cut at site ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "/", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d8b8e669-f402-4146-b334-685bd21dffe6"],
 ", the ",
 StyleBox["non-symmetric", "TI"],
 " bond dimension upper bound is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    RowBox[{
     StyleBox["n", "TI"], "/", "2"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5dbcace2-42d5-421e-a3c6-4afc31d680f6"],
 ". The ",
 StyleBox["symmetric", "TI"],
 " bond dimension (used by SU(2)-preserving MPS like the symmetric DMRG \
implementations of Schollw\[ODoubleDot]ck, Singh-Pfeifer-Vidal, McCulloch, \
ITensor) is the sum of multiplicities of the left half over all ",
 Cell[BoxData[
  FormBox[
   StyleBox["J", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d45637cc-1023-4931-a58b-b6a0d4d54ffc"],
 ". For an MPS that represents a global singlet (total spin 0, the relevant \
case for a Heisenberg antiferromagnet ground state), each spin-",
 Cell[BoxData[
  FormBox[
   StyleBox["J", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c04470ec-16f5-4e15-bf4e-d5750054d9a7"],
 " on the left must pair with a matching spin-",
 Cell[BoxData[
  FormBox[
   StyleBox["J", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dc149afc-6227-484b-a000-82c022e9c1d2"],
 " on the right to build total spin 0, so each left multiplet contributes one \
bond multiplet (for a nonzero target total spin, Clebsch-Gordan lets a left \
spin-J pair with a range of right spins)."
}], "Text",ExpressionUUID->"3e4afacb-379a-4e7c-b4e8-f6473c326295"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"bondCompare", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"half", " ", "=", " ", 
       RowBox[{"n", "/", "2"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", 
       RowBox[{"2", "^", "half"}], ",", " ", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"spinSectors", "[", "half", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", "\n", 
       "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"N", " ", "@", " ", "2"}], "^", "half"}], " ", "/", " ", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"spinSectors", "[", "half", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}]}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[88]:=",ExpressionUUID->"c8ff9177-288e-4c40-b955-8614c1829bc7"],

Cell[TextData[{
 "Tabulate for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "4", ",", "6", ",", "8", ",", "10", ",",
     "12"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a463192f-175d-4038-ad95-63301e497a33"],
 " qubits."
}], "Text",ExpressionUUID->"1935118f-cf61-44ec-8970-48b5aa8315c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"bondCompare", " ", "/@", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"4", ",", " ", "12", ",", " ", "2"}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<n\>\"", ",", " ", "\"\<raw bond 2^(n/2)\>\"", ",", 
       " ", "\"\<symmetric bond\>\"", ",", " ", "\"\<ratio\>\""}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]], "Input",
 CellLabel->"In[89]:=",ExpressionUUID->"8b22127f-c1a4-4049-9d31-1fdbc1a12fd1"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"n\"\>", "\<\"raw bond 2^(n/2)\"\>", "\<\"symmetric bond\"\>", \
"\<\"ratio\"\>"},
    {"4", "4", "2", "2.`"},
    {"6", "8", "3", "2.6666666666666665`"},
    {"8", "16", "6", "2.6666666666666665`"},
    {"10", "32", "10", "3.2`"},
    {"12", "64", "20", "3.2`"}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{3.989017261170261*^9},
 CellLabel->"Out[89]=",
 CellID->199664556,ExpressionUUID->"c0fe2129-777b-4211-99e0-73bcf1c4562f"]
}, Open  ]],

Cell[TextData[{
 "For the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "8"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7a7cbf61-bca9-40ab-9c4e-7a2481c13ea5"],
 " half-cut concretely: each half is 4 qubits with multiplicities ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "3", ",", "2"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0d94fc6f-f5e6-490d-ae8e-27788da24bec"],
 " for spin ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"2", ",", "1", ",", "0"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"24927a01-0563-45e9-a568-847c982f74a6"],
 " from ",
 Cell[BoxData[
  RowBox[{"spinSectors", "[", "4", "]"}]], "InlineFormula",ExpressionUUID->
  "3b2140e3-e661-4e63-92de-69af0ac3d36a"],
 ". The symmetric bond carries ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", "3", "+", "2", "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"fc474302-5600-431e-abd5-f00d7448118a"],
 " modes, organized as three independent blocks of sizes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "3", ",", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e0d3a0ac-9cba-4b72-adef-bb469b25816c"],
 ". A dense bond-matrix multiplication costs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["6", "3"], "\[LongEqual]", "216"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0874292e-d72a-4de2-9dbd-94b9f83240dd"],
 " flops; the same operation done block by block costs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["1", "3"], "+", 
    SuperscriptBox["3", "3"], "+", 
    SuperscriptBox["2", "3"], "\[LongEqual]", "36"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"52922ee2-f394-43a7-81e5-c15225cae016"],
 " flops, a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", "\[Cross]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"50c7f41c-0059-48e9-9ea3-90ebed88db97"],
 " saving from bookkeeping alone."
}], "Text",ExpressionUUID->"8be0efab-1fcd-4a54-bbbe-a3fc07bf0cdc"],

Cell[TextData[{
 "Physics readout: the savings ratio grows roughly like ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f47e2438-5dfc-4092-8a11-290f77f37ddf"],
 ". The quantity that sets the symmetric bond is the sum of the half-cut \
multiplicities, a central binomial coefficient, which scales like ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["2", 
     RowBox[{
      StyleBox["n", "TI"], "/", "2"}]], "/", 
    SqrtBox[
     RowBox[{
      StyleBox["n", "TI"], "/", "2"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3d019fa5-ecc6-4229-bd59-ff048de6c2a7"],
 "; dividing it into the raw bound leaves the saving. It is this sum, not the \
largest single multiplicity, that matters: the multiplicities actually peak \
away from spin 0. More importantly, the ",
 StyleBox["correctness", "TI"],
 " aspect is free: a symmetric MPS constrained to the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["J", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"48da67ee-8659-4754-8fdc-d426393f142c"],
 " sector returns a state with definite total spin 0 by construction, and the \
Heisenberg antiferromagnet ground state on an even bipartite lattice is such \
a singlet. Every entry in the ",
 Cell[BoxData[
 "spinSectors"], "InlineFormula",ExpressionUUID->
  "45eb0f62-8f92-4a7f-85ba-3d90434eb2dd"],
 " list is one Young-diagram-labeled bond mode the MPS has to track, and ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "39f0fc34-ca33-4f9e-8367-49c438b68b30"],
 " tells you how many degrees of freedom each carries before you build any \
tensor."
}], "Text",ExpressionUUID->"909e3e20-ef9b-4e9a-8f85-63ca2a7fa7fe"]
}, Open  ]],

