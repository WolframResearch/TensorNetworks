      RowBox[{"\"\<q1\>\"", ",", " ", "\"\<q2\>\"", ",", " ", "\"\<q3\>\"", ",",
        " ", "\"\<q4\>\""}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[74]:=",ExpressionUUID->"03292cd0-bb62-46ab-89e6-56b7f599e979"],

Cell[TextData[{
 "The hypergraph is again two disconnected rank-2 tensors, but now the \
singlet bonds straddle qubits ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "3"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e16bee8a-4339-4db0-99ef-16e1c652381e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"2", ",", "4"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3a0b66ba-f8b2-4fd8-902b-bce83abab38c"],
 " rather than ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"73982bcc-3a3b-4112-b849-a9eaf32bf873"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"3", ",", "4"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8ba80aba-79e4-449d-a730-c51128b8afff"],
 "."
}], "Text",ExpressionUUID->"12c0603c-040b-498c-b349-613f4a4fcebd"],

