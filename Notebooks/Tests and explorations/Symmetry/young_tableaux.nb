Cell[TextData[{
 "Identify the most-likely shape (the \"Schur estimate\" of ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6643c6ac-c382-4efd-ab93-fb423f2b3da8"],
 "'s spectrum) at each ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7fc3e500-eb1f-42d1-84e8-dffef958b25d"],
 ", and show its rescaled ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "/", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "21b6a2de-3cbb-40bc-adbc-f38dc8829e51"],
 " converging to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["spec",
     FontSlant->"Plain"], 
    RowBox[{"(", "\[Rho]", ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"0.7", ",", "0.3"}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1b097b99-698d-4f1d-8076-1c02883c6052"],
 "."
}], "Text",ExpressionUUID->"b173d9f1-52fc-45d5-b175-07e916a55ba4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mostLikelyShape", "[", 
     RowBox[{"p_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
    RowBox[{"First", " ", "@", " ", 
     RowBox[{"MaximalBy", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"IntegerPartitions", "[", "n", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "#", "]"}], " ", "<=", " ", "2"}], " ", 
          "&"}]}], "]"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"schurProb", "[", 
         RowBox[{"#", ",", " ", "p", ",", " ", "n"}], "]"}], " ", "&"}]}], 
      "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lam", " ", "=", " ", 
       RowBox[{"mostLikelyShape", "[", 
        RowBox[{"0.7", ",", " ", "n"}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "lam", ",", " ", 
       RowBox[{
        RowBox[{"N", " ", "@", " ", 
         RowBox[{"PadRight", "[", 
          RowBox[{"lam", ",", " ", "2"}], "]"}]}], "/", "n"}]}], "}"}]}], 
    "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "4", ",", " ", "8", ",", " ", "2"}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"d787f283-2265-411e-9566-c7d26a1679b7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.75`", ",", "0.25`"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.8333333333333333`", ",", "0.16666666666666666`"}], "}"}]}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"8", ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.75`", ",", "0.25`"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.989017261096191*^9},
 CellLabel->"Out[84]=",
 CellID->1603304374,ExpressionUUID->"13ec46d2-c7d9-40f6-ba0a-18fc48f8ee6f"]
}, Open  ]],

Cell[TextData[{
 "Physics readout: at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e832eeac-6a05-465d-9291-0c1532c47a1b"],
 " the modal shape is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"3", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"dfd5b482-0130-4d8e-b3c4-f8383e891b52"],
 " (rescaled ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0.75", ",", "0.25"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"63043269-971d-464b-a8c6-8a254ef477fc"],
 "); at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e6825fe5-252a-4515-8093-c29015522598"],
 " it shifts to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"5", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"50800a8c-d722-434c-993b-7a538947715f"],
 " (rescaled ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0.833", ",", "0.167"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"38d7bb25-2cfb-46c7-a35a-dd212ee50e8b"],
 "); at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "8"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"131ed7aa-d55e-4c4a-8692-10a72e284d1b"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"6", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bd0cf02d-4f14-4ea9-a0e0-78a624298ea7"],
 " (rescaled ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0.75", ",", "0.25"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8238bad6-f5b7-4901-af6b-36a64e313010"],
 "). As ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2f0f34b5-0ebb-419e-bf74-b97e27351d81"],
 " grows the rescaled mode converges to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"0.7", ",", "0.3"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"88097e60-0a51-4472-aee2-328db5dd8617"],
 ", exactly as Keyl-Werner predicts. Many iid-copy protocols that exploit \
permutation symmetry (quantum hypothesis testing, universal compression, \
entanglement concentration) reduce to ",
 StyleBox["measuring this ", "TI"],
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "68f17a76-d9cd-4836-a11e-87269aab5a45"],
 StyleBox[" outcome", "TI"],
 ", and ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "771067c5-f9b1-4b1e-9df1-8d9e5a89de05"],
 " is the constructive way to compute the probabilities."
}], "Text",ExpressionUUID->"6a336c7b-8001-4a92-90fc-b6ee47b799e4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Symmetric tensor networks: bond Hilbert spaces split by Young diagram\
\>", "Section",ExpressionUUID->"768fdd14-46a1-4ccd-adc2-2703f06ff7a8"],

Cell[TextData[{
 "Tensor-network ansatze that preserve ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU",
     FontSlant->"Plain"], "(", "2", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f9d8ce58-16f3-4e7c-bafa-9634ce7dfbcf"],
 " (or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["SU",
     FontSlant->"Plain"], "(", 
    StyleBox["d", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3acf6e64-14b8-4e3b-8c7e-b3bfd0440d3d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["U", "TI"], "(", "1", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d97ef5c2-bd58-44d0-9718-ee3933fdada7"],
 ", any compact group) have ",
 StyleBox["bond", "TI"],
 " Hilbert spaces that automatically decompose into Young-diagram blocks. \
Each bond carries a label ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Lambda]", ",", "\[Alpha]"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b695612c-5e06-4fd2-b8c3-e13c653073a7"],
 " with ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3c8e9867-355a-4527-9d14-49105b7bb878"],
 " a Young diagram and ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "642e9d16-f56c-4aee-a36d-04a542a3308d"],
 " a multiplicity index; the MPS/PEPS tensors are block-sparse with respect \
to this structure. The point of using Young tableaux for symmetric TNs is \
twofold: (i) the ansatz produces states with the ",
 StyleBox["correct", "TI"],
 " quantum-number sector by construction (no contamination from other ",
 Cell[BoxData[
  FormBox[
   StyleBox["J", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2131aaa0-dab2-49cf-ae94-db3faaed02d9"],
 " values), and (ii) every contraction is ",
 StyleBox["block-diagonal", "TI"],
 ": a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Chi]", "\[Cross]", "\[Chi]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8a248dbb-4c8b-4755-9c8d-2f5bbceee2a0"],
 " matrix-vector product is replaced by independent products on much smaller ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["mult",
      FontSlant->"Plain"], "\[Lambda]"], "\[Cross]", 
    SubscriptBox[
     StyleBox["mult",
      FontSlant->"Plain"], "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f42f1507-d65d-48ca-9835-967c21f147fa"],
 " blocks. The paclet's ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "ebaeafc9-02f0-488d-b4d8-255d03a22a96"],
 " gives the per-sector multiplicities, so you can read off the ",
 StyleBox["symmetric", "TI"],
 " bond dimension without building the MPS."
}], "Text",ExpressionUUID->"717a3612-e93e-4e5f-9e72-34f3dccb1911"],

Cell[TextData[{
 "Multiplicity of each spin-",
 Cell[BoxData[
  FormBox[
   StyleBox["J", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "237b5d67-e8e0-4371-81b6-68b33d257c30"],
 " in ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f52fed16-34e6-4c8f-a7c4-8ed1d18027c0"],
 " qubits, returned as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["J", "TI"], ",", "dim", 
     SubscriptBox[
      StyleBox["V", "TI"], "\[Lambda]"]}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ca4b651b-7c11-477b-907a-e15a341e8804"],
 " pairs."
}], "Text",ExpressionUUID->"7a6490fc-dd5a-4a8a-bdeb-81ccf3e507f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"spinSectors", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"n", " ", "-", " ", 
          RowBox[{"2", " ", "k"}]}], ")"}], "/", "2"}], ",", "\n", "   ", 
       RowBox[{"TableauDimension", "[", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"k", " ", "==", " ", "0"}], ",", " ", 
          RowBox[{"{", "n", "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"n", " ", "-", " ", "k"}], ",", " ", "k"}], "}"}]}], 
         "]"}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", 
       RowBox[{"Floor", "[", 
        RowBox[{"n", "/", "2"}], "]"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[85]:=",ExpressionUUID->"c52840ea-45f6-448c-b17a-b2259d97a04e"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ce6e0c88-29f4-4e0b-b4bf-f481266c474c"],
 " qubits: one spin-",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "aea63d0a-ff23-478a-9240-0be29bc9a40d"],
 ", three spin-",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "27f2e023-6e20-4ef5-a7f5-e3ece4f34e0b"],
 "s, two spin-",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "89b42899-5418-47c9-9b61-9790d9d1de11"],
 "s."
}], "Text",ExpressionUUID->"02d2b6fa-7d7b-488b-9883-1ce955bca1af"],

