Cell[TextData[{
 "Physics readout: the 2D subspace spanned by ",
 Cell[BoxData[
 "vb4"], "InlineFormula",ExpressionUUID->
  "58259c4a-dcc6-43c8-8d20-1728f5b38866"],
 " and ",
 Cell[BoxData[
 "vb4b"], "InlineFormula",ExpressionUUID->
  "68d0c071-f990-414b-9c22-ef308727c736"],
 " (singlet pairings ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", "12", ")"}], "(", "34", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"357379e9-b036-4dcb-956f-b4adc16ec475"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", "13", ")"}], "(", "24", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8f4c8d78-f180-49fe-843a-2a72e29ad5ee"],
 ") is the standard 4-qubit DFS used in trapped-ion qubit encoding \
(Kielpinski-Wineland) and NMR experiments. ",
 StyleBox["Any", "TI"],
 " collective SU(2) unitary fixes it pointwise (a U(2) one only up to a \
global determinant phase, which the squared-norm test ignores), so encoding a \
logical qubit there gives complete protection against collective dephasing \
for free. The role of ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "799e6d3a-7a41-41bd-bf79-23a0625a43ba"],
 " is operational: it certifies that an encoded state has not leaked out of \
the DFS, without ever appealing to a noise channel."
}], "Text",ExpressionUUID->"fe149815-5e8c-44a1-bc58-4fcdf354e89a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Schur sampling: spectrum estimation from ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d919ce8d-ca30-4c90-8e90-4f50a70de5cc"],
 " outcomes"
}], "Section",ExpressionUUID->"5e78c4af-187a-42a7-9e80-61dbcd34f280"],

Cell[TextData[{
 "If you have ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d1876fe4-d489-4902-bbd2-ac82c973d3b7"],
 " identical copies of an unknown single-qubit state ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7cfc38da-2677-48d5-bdac-3fdb76261360"],
 " and apply the Schur transform (Bacon-Chuang-Harrow 2006) followed by a \
measurement in the Young-diagram basis, the outcome is one shape ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2b9cbfed-8f23-4af9-b3b2-8e3911da68bb"],
 " drawn with probability ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Pr", 
    RowBox[{"(", "\[Lambda]", ")"}], "\[LongEqual]", 
    StyleBox["Tr",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["P", "TI"], "\[Lambda]"], " ", 
      SuperscriptBox["\[Rho]", 
       RowBox[{"\[CircleTimes]", 
        StyleBox["n", "TI"]}]]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5f477080-620a-4e21-9336-5fdcbe003d53"],
 ". As ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[Rule]", "\[Infinity]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"27e0f2aa-18f7-42c3-99cb-3c5325fabbc2"],
 ", the rescaled ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "/", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9d72b17a-6db6-4639-85c0-f7d600969f47"],
 " concentrates on the eigenvalue spectrum of ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "89602a97-2a55-4b74-bda7-c216f7ab23d7"],
 ". This is the Keyl-Werner spectrum-estimation protocol (2001), provably \
sample-optimal. The point of using Young tableaux here is that the ",
 StyleBox["Young diagram is the universal sufficient statistic", "TI"],
 " for the spectrum of ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "432899ac-63db-4095-b2bf-93d1edb0df09"],
 " from independent and identically distributed samples: all information \
about the spectrum from ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4add7b01-7515-47fe-90fa-17f245a17e6b"],
 " identical experiments is carried by the random Young-diagram outcome ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "40646340-9b23-461b-8875-4ebea9f7dbe2"],
 " (the eigenbasis lives in the complementary Schur registers, not in it), \
and computing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Pr", "(", "\[Lambda]", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4c4abdc6-e38f-435f-afad-f3cb87d0462a"],
 " is just an isotypic norm."
}], "Text",ExpressionUUID->"732056d5-474e-491a-9cc6-2061d38dd0dd"],

Cell[TextData[{
 "Enumerate all SYTs of a given shape: all ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "!"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6bd52296-6284-4c8a-a9eb-e98aecf717a6"],
 " permutations of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "\[Ellipsis]", ",", 
     StyleBox["n", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"381ead32-1b05-4366-aee2-c3f7cb07351c"],
 ", split row-by-row into the shape via ",
 Cell[BoxData[
 "TakeList"], "InlineFormula",ExpressionUUID->
  "cc7cf30e-638a-4414-9548-a49fa8cd5516"],
 ", kept only if ",
 Cell[BoxData[
 "StandardTableauQ"], "InlineFormula",ExpressionUUID->
  "474969b8-313b-4758-9f52-52428e58b899"],
 " passes. Brute force, but fine for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LessEqual]", "8"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"16af6361-4085-4b3c-ba2b-62eb912efe60"],
 " and trivially correct."
}], "Text",ExpressionUUID->"c96ca54d-f71c-4f3e-844e-4eafa6ea4888"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"syts", "[", "lambda_List", "]"}], " ", ":=", " ", 
   RowBox[{"Select", "[", "\n", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"YoungTableau", "[", 
        RowBox[{"TakeList", "[", 
         RowBox[{"#", ",", " ", "lambda"}], "]"}], "]"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"Permutations", "[", 
       RowBox[{"Range", "[", 
        RowBox[{"Total", "[", "lambda", "]"}], "]"}], "]"}]}], ",", "\n", 
     "   ", "StandardTableauQ"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"dd5a8b59-e0c0-4567-bbb6-8202277dcb44"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3941b660-133e-4565-af2e-7768efcaa3f9"],
 "-qubit computational basis as a list of rank-",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "77f989d7-e54a-415b-b449-df6fb71c80db"],
 " tensors."
}], "Text",ExpressionUUID->"c97da1f0-7b40-4a38-8555-19259e342f3f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"basisStates", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"Map", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"idx", ",", " ", 
       RowBox[{"Normal", " ", "@", " ", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"idx", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"2", ",", " ", "n"}], "]"}]}], "]"}]}]}], "]"}], ",", "\n",
      "  ", 
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "n"}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[79]:=",ExpressionUUID->"cc6a181a-321d-4620-8393-9d82f05bef5b"],

Cell[TextData[{
 "For diagonal ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["p", "TI"], ",", "1", "-", 
      StyleBox["p", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ba96f434-84db-4509-bf38-545b360c97bb"],
 ", the n-fold tensor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Rho]", 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c15743dd-e2f5-4bfd-832b-055f567374dc"],
 " is diagonal in the computational basis with eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["p", "TI"], 
     RowBox[{"#0", "s"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       StyleBox["p", "TI"]}], ")"}], 
     RowBox[{"#1", "s"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0eb87e3c-5b4a-44f1-ab80-ec006f118e37"],
 " on each bit string, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Pr", 
    RowBox[{"(", "\[Lambda]", ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"],
     LimitsPositioning->True], "\[DoubleVerticalBar]", 
    SubscriptBox[
     StyleBox["P", "TI"], "\[Lambda]"], "|", 
    StyleBox["i", "TI"], "\[RightAngleBracket]", 
    SuperscriptBox["\[DoubleVerticalBar]", "2"], " ", 
    SubsuperscriptBox["\[Rho]", 
     StyleBox[
      RowBox[{"i", "\[NoBreak]", "i"}], "TI"], 
     RowBox[{"\[CircleTimes]", 
      StyleBox["n", "TI"]}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cb2fb037-2d10-4a3c-8d40-e82e5a80f41a"],
 "."
}], "Text",ExpressionUUID->"731bd376-a577-414b-9f35-eac3d6a9a152"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"schurProb", "[", 
    RowBox[{"shape_List", ",", " ", "p_", ",", " ", "n_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tabs", " ", "=", " ", 
        RowBox[{"syts", "[", "shape", "]"}]}], ",", " ", "weights"}], "}"}], ",",
      "\n", "  ", 
     RowBox[{
      RowBox[{"weights", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"p", "^", 
            RowBox[{"Count", "[", 
             RowBox[{"#", ",", " ", "1"}], "]"}]}], " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", "p"}], ")"}], "^", 
            RowBox[{"Count", "[", 
             RowBox[{"#", ",", " ", "2"}], "]"}]}]}], ")"}], " ", "&"}], " ", 
        "/@", " ", 
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "n"}], "]"}]}]}], ";",
       "\n", "  ", 
      RowBox[{"Total", " ", "@", " ", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#2", " ", 
           RowBox[{"isoNormSq", "[", 
            RowBox[{"#1", ",", " ", "tabs"}], "]"}]}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"basisStates", "[", "n", "]"}], ",", " ", "weights"}], 
          "}"}]}], "]"}]}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[80]:=",ExpressionUUID->"2e1cde12-f0ed-4df6-bf04-304a879f0c0d"],

Cell[TextData[{
 "Run it on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "\[LongEqual]", 
    StyleBox["diag",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{"0.7", ",", "0.3"}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f19e53b7-b028-4cd4-a064-06cac8d4dc9c"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9bcd4245-540a-4891-9df7-51b1b87d1088"],
 " copies: probabilities of measuring the three available shapes."
}], "Text",ExpressionUUID->"2ab841fe-8d78-4cf3-bbc3-8d1014a2cfe4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", " ", "@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"schurProb", "[", 
     RowBox[{
      RowBox[{"{", "4", "}"}], ",", " ", "0.7", ",", " ", "4"}], "]"}], ",", 
    " ", 
    RowBox[{"schurProb", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", "0.7", ",", " ", "4"}], 
     "]"}], ",", " ", 
    RowBox[{"schurProb", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}], ",", " ", "0.7", ",", " ", "4"}], 
     "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[81]:=",ExpressionUUID->"cf861a3f-108e-4f44-ae22-345fac913b1c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.41409999999999997`", ",", "0.49770000000000003`", ",", "0.0882`"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.989017235249502*^9},
 CellLabel->"Out[81]=",
 CellID->2044779569,ExpressionUUID->"18ea9ff1-a36d-4330-ab0f-011f65b75a06"]
}, Open  ]],

Cell[TextData[{
 "The three probabilities are approximately ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.41", ",", "0.50", ",", "0.09"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6bf43e29-2eca-406a-9d2c-89f76e5cdc5d"],
 ", summing to ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ca46e902-ad80-4257-b729-c02188c0b128"],
 " (verified by the orthogonal-isotypic-projector property). They match the \
analytical Keyl-Werner formula ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Pr", 
    RowBox[{"(", "\[Lambda]", ")"}], "\[LongEqual]", "dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], "\[CenterDot]", 
    SubscriptBox[
     StyleBox["s", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["p", "TI"], ",", "1", "-", 
      StyleBox["p", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0df30b10-c67f-451b-9b24-e7c35917d908"],
 " with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["s", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c18b87e0-33f6-4c85-a2e1-8bc85ef734ed"],
 " the Schur polynomial."
}], "Text",ExpressionUUID->"7ea7d62d-6c34-4b9c-9a41-ba00014f5aed"],

Cell[TextData[{
 "Repeat for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0e97764a-bb77-4cfb-86e9-792b2919b394"],
 " copies: now four shapes are available."
}], "Text",ExpressionUUID->"843f847a-6035-4761-befa-597ac0f6fde5"],

