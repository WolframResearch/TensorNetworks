Cell["\<\
This multiplicity is not bookkeeping for its own sake: it is the dimension of \
the protected subspace a quantum-information protocol can use. The DFS \
section below shows multiplicity-2 giving a noise-immune logical qubit and \
the Schur-sampling section below shows the same multiplicity space being the \
freedom that spectrum-estimation protocols deliberately discard.\
\>", "Text",
 CellChangeTimes->{3.989018253982839*^9},
 CellID->1170175714,ExpressionUUID->"6be5f927-9797-46f3-9538-2b0fd65a0414"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Counting SYT: the hook length formula", "Section",ExpressionUUID->"a82db346-6bc3-426b-9b47-65568446477e"],

Cell[TextData[{
 "The ",
 StyleBox["hook", "TI"],
 " of a box ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], "}"}], "\[Element]", "\[Lambda]"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c15272e5-4fc1-4dc3-9dd1-022124cd339c"],
 " collects the box itself, the boxes to its right in the same row, and the \
boxes below it in the same column; its size is the ",
 StyleBox["hook length", "TI"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["h", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Lambda]", 
       StyleBox["i", "TI"]], "-", 
      StyleBox["j", "TI"]}], ")"}], "+", 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["\[Lambda]", 
       StyleBox["j", "TI"], 
       StyleBox["T", "TI"]], "-", 
      StyleBox["i", "TI"]}], ")"}], "+", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"704f9140-2f78-44b8-bb42-7a8b7e015c8c"],
 ". Read off all hook lengths of a small shape."
}], "Text",ExpressionUUID->"4df4ed42-c390-4423-8f3b-177db6e7d6e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookLengths", "[", 
  RowBox[{"{", 
   RowBox[{"3", ",", " ", "2"}], "}"}], "]"}]], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"217b5284-2fbc-444f-8b0f-8f3c79f0f7a7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.989017233201211*^9},
 CellLabel->"Out[28]=",
 CellID->77271663,ExpressionUUID->"e93d9ad4-e15c-4317-99af-53c6b5554af4"]
}, Open  ]],

Cell["Read a single hook length.", "Text",ExpressionUUID->"2479ba6e-619c-44fc-9dfc-8217d35d50dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookLength", "[", 
  RowBox[{
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", "2"}], "}"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"cda0411d-76f9-4392-a805-5eac996b5b8a"],

Cell[BoxData["4"], "Output",
 CellChangeTimes->{3.9890172332100973`*^9},
 CellLabel->"Out[29]=",
 CellID->1624717253,ExpressionUUID->"ca84d193-0103-4d95-9978-70d2e3670b68"]
}, Open  ]],

Cell["\<\
The Frame-Robinson-Thrall formula collapses the irreducible-representation \
dimension into\
\>", "Text",ExpressionUUID->"33bd7506-6dd3-49e2-9434-e23ad8a0157d"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      StyleBox["f", "TI"], "\[Lambda]"], " ", "\[LongEqual]", " ", 
     RowBox[{"dim", 
      SubscriptBox[
       StyleBox["V", "TI"], "\[Lambda]"]}], " ", "\[LongEqual]", " ", 
     FractionBox[
      RowBox[{
       StyleBox["n", "TI"], "!"}], 
      RowBox[{
       UnderscriptBox["\[Product]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           StyleBox["i", "TI"], ",", 
           StyleBox["j", "TI"]}], "}"}], "\[Element]", "\[Lambda]"}],
        LimitsPositioning->False], 
       SubscriptBox[
        StyleBox["h", "TI"], "\[Lambda]"], 
       RowBox[{"(", 
        RowBox[{
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"]}], ")"}]}]]}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full,
  ScrollPosition->{0., 0.}]], "DisplayFormula",ExpressionUUID->"e8170324-5919-\
4163-831e-15c4c5fa57a9"],

Cell[TextData[{
 "evaluated by the paclet via the Frobenius determinant (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    SuperscriptBox[
     StyleBox["r", "TI"], "3"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ffcf1064-da5e-4cf3-b4cc-436e8b4ae437"],
 " in the row count, much faster than naive). ",
 Cell[BoxData[
 "HookFactor"], "InlineFormula",ExpressionUUID->
  "029b3db8-4b78-4e8a-943d-70bec3ce63c7"],
 " returns the reciprocal hook product and ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "1d6a6f94-071c-46bb-b815-ddda5c952c8e"],
 " multiplies by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "!"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e125ec05-dc41-40a9-b054-ee30bb6faf00"],
 "."
}], "Text",ExpressionUUID->"1e3b0ecc-0a4b-4bc8-8a2f-f7271c7129b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookFactor", "[", 
  RowBox[{"{", 
   RowBox[{"3", ",", " ", "2"}], "}"}], "]"}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"2b2c53b3-82ec-42f7-85ab-b7c317140465"],

Cell[BoxData[
 FractionBox["1", "24"]], "Output",
 CellChangeTimes->{3.989017233221916*^9},
 CellLabel->"Out[30]=",
