Cell[TextData[{
 "At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"fefd45bb-7b52-416a-aac8-0437eeba63f1"],
 " (qutrits), the same shape is one-dimensional (the unique antisymmetric \
tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", 
    StyleBox[
     RowBox[{"i", "j", "k"}], "TI"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ac319730-f665-413b-950b-37987011cd39"],
 ")."
}], "Text",ExpressionUUID->"33e7a4f3-4008-4139-beb7-071de0a994b0"],

