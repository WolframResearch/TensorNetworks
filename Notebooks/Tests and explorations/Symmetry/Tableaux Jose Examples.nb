Cell["\<\
That number is also the following combinatorial number, because this is just \
a multichoose problem:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Binomial", "[", 
  RowBox[{
   RowBox[{"10", "+", 
    RowBox[{"2", " ", "3"}], "-", "1"}], ",", "10"}], "]"}]], "Input"],

Cell[BoxData["3003"], "Output"]
}, Open  ]],

Cell["\<\
The connection is that the number of ways of choosing k nonnegative integers \
to add up to n is Binomial[n + k - 1, n]. This is exercise 7 of Fulton, page \
53.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Binomial", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"2", " ", "3"}], "+", "10", "-", "1"}], ",", "10"}], 
  "]"}]], "Input"],

Cell[BoxData["3003"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FrobeniusSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], 
    ",", "10"}], "]"}], "//", "Length"}]], "Input"],

Cell[BoxData["3003"], "Output"]
}, Open  ]],

Cell["\<\
Exercise 8 of Fulton's book, page 53, is rather amazing as a generalization \
of Sudokus and Latin squares.\
\>", "Text"],

Cell["\<\
Exercise 15 of Fulton in page 56 shows how to count the semistandard tableaux \
in a numeric set of labels whose entries all sum to a given number. It uses a \
generating function.\
\>", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["3.8. Normal tableaux", "Subsubsection"],

Cell["\<\
1) A normal tableau is a tableau in which all labels are sorted when joining \
all rows together into a single list. Hence, there is a single normal tableau \
for a given partition (and using a predetermined collection of different \
elements). It is always the first one in our listings of standard tableaux.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "NormalTableauQ"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"NormalTableauQ[tab] gives True if the Young tableau tab is \
written in normal form, that is, its elements are sorted when joining all \
rows into a single list. It returns False otherwise.\"\>", 
  "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442161-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NormalTableauQ", "[", 
    RowBox[{"tab", ":", 
     RowBox[{"Tableau", "[", "___List", "]"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"TableauQ", "[", "tab", "]"}], "&&", 
    RowBox[{"OrderedQ", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"List", "@@", "tab"}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NormalTableauQ", "[", "_", "]"}], ":=", "False"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"NormalTableauQ", ",", "1"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "NormalTableauQ", "]"}], ";"}]}], "Input",
 InitializationCell->True],

Cell["Examples :", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauQ", "[", 
  RowBox[{"Tableau", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "4"}], "}"}]}], "]"}], "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

