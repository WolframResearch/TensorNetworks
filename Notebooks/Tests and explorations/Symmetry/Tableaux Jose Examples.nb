Cell[CellGroupData[{

Cell["2.9. Frobenius notation", "Subsubsection"],

Cell["\<\
This is a clever way to represent a partition, and is rather symmetric:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ToFrobeniusMatrix", "[", 
    RowBox[{"par_", "?", "PartitionQ"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"#", "-", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "#", "]"}], "]"}]}], ",", "Positive"}], "]"}],
      "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"par", ",", 
      RowBox[{"TransposePartition", "[", "par", "]"}]}], "}"}]}]}], 
  ";"}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FromFrobeniusMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"hors_", ",", "vers_"}], "}"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dl", "=", 
       RowBox[{"Length", "[", "hors", "]"}]}], "}"}], ",", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"hors", "+", 
        RowBox[{"Range", "[", "dl", "]"}]}], ",", 
       RowBox[{"Drop", "[", 
        RowBox[{
         RowBox[{"TransposePartition", "[", 
          RowBox[{"vers", "+", 
           RowBox[{"Range", "[", "dl", "]"}]}], "]"}], ",", "dl"}], "]"}]}], 
      "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationCell->True],

Cell["\<\
Example in page 1558 of Black, King and Wybourne 1983:\
\>", "Text"],

