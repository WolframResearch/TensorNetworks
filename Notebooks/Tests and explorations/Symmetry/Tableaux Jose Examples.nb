Cell["\<\
The correspondence is one-to-one, so this is a way of constructing all \
involutions. Very impressive! Indeed, the number of involutions in S[n] is \
(it increases with n, but involutions are rarer with larger n with respect to \
the total of n!). We saw this formula before:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NumberOfInvolutions", "[", "n_", "]"}], ":=", 
  RowBox[{
   RowBox[{"n", "!"}], 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n", "-", 
           RowBox[{"2", "k"}]}], ")"}], "!"}]}], "/", 
       RowBox[{"2", "^", "k"}]}], "/", 
      RowBox[{"k", "!"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{"Floor", "[", 
        RowBox[{"n", "/", "2"}], "]"}]}], "}"}]}], "]"}]}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NumberOfInvolutions", "/@", 
  RowBox[{"Range", "[", "20", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "2", ",", "4", ",", "10", ",", "26", ",", "76", ",", "232", ",", 
   "764", ",", "2620", ",", "9496", ",", "35696", ",", "140152", ",", 
   "568504", ",", "2390480", ",", "10349536", ",", "46206736", ",", 
   "211799312", ",", "997313824", ",", "4809701440", ",", "23758664096"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"%", "/", 
   RowBox[{
    RowBox[{"Range", "[", "20", "]"}], "!"}]}], "//", "N"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1.`", ",", "1.`", ",", "0.6666666666666666`", ",", "0.4166666666666667`", 
   ",", "0.21666666666666667`", ",", "0.10555555555555556`", ",", 
   "0.046031746031746035`", ",", "0.018948412698412697`", ",", 
   "0.007220017636684303`", ",", "0.0026168430335097`", ",", 
   "0.0008942600609267276`", ",", "0.000292591924536369`", ",", 
   "0.00009129630657408436`", ",", "0.000027420587936460952`", ",", 
   "7.914459634036353`*^-6", ",", "2.2084404731560816`*^-6", ",", 
   "5.954647121877903`*^-7", ",", "1.5577251029688176`*^-7", ",", 
   "3.9538801183403796`*^-8", ",", "9.765565574014278`*^-9"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell["\<\
7) This is exercise 5, page 50, though there it is suggested that it is \
perfomed using the matrix-ball algorithm, which is claimed to be faster. I \
have not encoded the matrix-ball algorithm.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DoubleWordOfTableauPair", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Tableau", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "1", ",", "1", ",", "1", ",", "1", ",", "2", ",", "3", ",", "3", ",", 
         "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "2", ",", "2", ",", "2", ",", "3", ",", "4", ",", "4", ",", "4"}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "3", ",", "4", ",", "4"}], "}"}]}], "]"}], ",", 
     RowBox[{"Tableau", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "1", ",", "1", ",", "2", ",", "2", ",", "2", ",", "2", ",", "3", ",", 
         "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "2", ",", "3", ",", "3", ",", "3", ",", "3", ",", "4", ",", "4"}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4", ",", "4", ",", "4"}], "}"}]}], "]"}]}], "}"}], 
   "]"}], "//", "MatrixForm"}]], "Input"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"1", "1", "2", "2", "2", "2", "2", "3", "3", "3", "3", "3", "3", "3", 
      "4", "4", "4", "4", "4"},
     {"3", "3", "2", "4", "4", "4", "4", "1", "1", "2", "2", "3", "4", "4", 
      "1", "1", "2", "3", "3"}
    },
    GridBoxAlignment->{
     "Columns" -> {{Center}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
      "RowsIndexed" -> {}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}, "RowsIndexed" -> {}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output"]
}, Open  ]],

