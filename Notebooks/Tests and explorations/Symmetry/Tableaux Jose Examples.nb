Cell["\<\
So it seems that the objective for efficient computation is to arrive quickly \
at the list of LRSkewTableaux.\
\>", "Text"],

Cell[TextData[{
 "5) There are two key ways of computing LR numbers (my names):\n\n\t\
\[OpenCurlyDoubleQuote]Product\[CloseCurlyDoubleQuote]:\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["S", "\[Lambda]"], "\[CenterDot]", " ", 
     SubscriptBox["S", "\[Mu]"]}], "=", 
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "\[Nu]"], 
     SubscriptBox[
      SuperscriptBox[
       SubscriptBox["c", "\[Lambda]"], "\[Nu]"], "\[Mu]"], " ", 
     SubscriptBox["S", "\[Nu]"]}]}], TraditionalForm]]],
 "\n\t\n\t\[OpenCurlyDoubleQuote]Quotient\[CloseCurlyDoubleQuote]: \t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", 
     RowBox[{"\[Nu]", "/", "\[Lambda]"}]], "=", 
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "\[Mu]"], 
     SubscriptBox[
      SuperscriptBox[
       SubscriptBox["c", "\[Lambda]"], "\[Nu]"], "\[Mu]"], 
     SubscriptBox["S", "\[Mu]"]}]}], TraditionalForm]]],
 "\n\nThat is, either we start with \[Lambda] and \[Mu] and compute ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox[
     SubscriptBox["c", "\[Lambda]"], "\[Nu]"], "\[Mu]"], TraditionalForm]]],
 " for all compatible \[Nu] (\[OpenCurlyDoubleQuote]product way\
\[CloseCurlyDoubleQuote]) or we start with \[Nu] and \[Lambda] and compute \
them for all \[Mu] (\[OpenCurlyDoubleQuote]quotient way\
\[CloseCurlyDoubleQuote]). In the example of the previous paragraph we used \
the \[OpenCurlyDoubleQuote]quotient\[CloseCurlyDoubleQuote] approach. \
However, it is more standard to use the \[OpenCurlyDoubleQuote]product\
\[CloseCurlyDoubleQuote] approach. We discuss that now."
}], "Text"],

Cell["Simple examples:", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nu", "=", 
   RowBox[{"{", 
    RowBox[{"4", ",", "3", ",", "2", ",", "1"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lambda", "=", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "1"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mu", "=", 
   RowBox[{"{", 
    RowBox[{"3", ",", "1"}], "}"}]}], ";"}]}], "Input"],

