         RowBox[{"Length", "[", "par1", "]"}], ",", 
         RowBox[{"Length", "[", "par2", "]"}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Order", "[", 
      RowBox[{
       RowBox[{"PadRight", "[", 
        RowBox[{"par1", ",", "l"}], "]"}], ",", 
       RowBox[{"PadRight", "[", 
