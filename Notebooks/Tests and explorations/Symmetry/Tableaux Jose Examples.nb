Cell[CellGroupData[{

Cell["3.6. Standard tableaux", "Subsubsection"],

Cell["\<\
1) A standard tableau is a disjoint tableau in which labels in the rows are \
sorted, and labels in the columns are also sorted. This symmetric definition \
is preserved under transposition. This is the nomenclature used in the \
Wikipedia page for Young tableaux.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "StandardTableauQ"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"StandardTableauQ[tab] gives True if the labels of the Young \
tableau tab are all different, and the labels of each row and each column are \
sorted. It returns False otherwise.\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442115-9818602"]
}, Open  ]],

Cell[TextData[{
 "In order to check order of labels we use the Order functions of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", and not the Less functions, because"
}], "Text"],

