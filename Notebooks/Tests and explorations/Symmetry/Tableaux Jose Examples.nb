Cell["\<\
The head Tableau acts as a simple wrapper, and we do not store any other \
definitions with it.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Protect", "[", "Tableau", "]"}], ";"}]], "Input"],

