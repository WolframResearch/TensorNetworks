Cell["\<\
In fact a semistandard skew tableau is a LR skew tableau of content \[Mu] if \
and only if its rectification is the YamanouchiTableau[\[Mu]]. (Fulton, page \
65).\
\>", "Text"],

Cell[TextData[{
 "4) The number ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox[
     SubscriptBox["c", "\[Lambda]"], "\[Nu]"], "\[Mu]"], TraditionalForm]]],
 " is the number of Littlewood-Richardson skew tableaux on the shape \[Nu]/\
\[Lambda] of content \[Mu]."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Rule", "@@@", 
   RowBox[{"Tally", "[", 
    RowBox[{"TableauWeight", "/@", "tab15"}], "]"}]}], "//", 
  "Column"}]], "Input"],

