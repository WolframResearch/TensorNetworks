 RowBox[{
  RowBox[{"SortDoubleWord", "[", 
   RowBox[{"{", 
    RowBox[{"list1_List", ",", "list2_List"}], "}"}], "]"}], ":=", 
  RowBox[{"Transpose", "[", 
   RowBox[{"Sort", "@", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"list2", ",", "list1"}], "}"}], "]"}]}], "]"}]}]], "Input"],

