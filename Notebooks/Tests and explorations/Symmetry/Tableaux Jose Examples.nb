Cell["\<\
There is this interesting identity, which seems to come from the Robinson \
correspondence (see Fulton, page 52), and which is very important in the \
theory of characters of the symmetric groups:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"NumberOfStandardTableaux", "/@", 
    RowBox[{"IntegerPartitions", "[", "10", "]"}]}], ")"}], "^", 
  "2"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "81", ",", "1225", ",", "1296", ",", "5625", ",", "25600", ",", 
   "7056", ",", "8100", ",", "99225", ",", "50625", ",", "122500", ",", 
   "15876", ",", "1764", ",", "82944", ",", "202500", ",", "321489", ",", 
   "275625", ",", "200704", ",", "15876", ",", "63504", ",", "90000", ",", 
   "44100", ",", "589824", ",", "275625", ",", "90000", ",", "321489", ",", 
   "122500", ",", "7056", ",", "44100", ",", "63504", ",", "202500", ",", 
   "50625", ",", "82944", ",", "99225", ",", "25600", ",", "1296", ",", 
   "1764", ",", "8100", ",", "5625", ",", "1225", ",", "81", ",", "1"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Total", "[", "%", "]"}], "===", 
  RowBox[{"10", "!"}]}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell["\<\
The RSK correspondence also gives a formula for the sum of those numbers, in \
terms of the number of involutions in S[n]. See Fulton, page 52.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NumberOfInvolutions", "[", "n_", "]"}], ":=", 
  RowBox[{
   RowBox[{"n", "!"}], 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"n", "-", 
           RowBox[{"2", "k"}]}], ")"}], "!"}]}], "/", 
       RowBox[{"2", "^", "k"}]}], "/", 
      RowBox[{"k", "!"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", 
       RowBox[{"Floor", "[", 
        RowBox[{"n", "/", "2"}], "]"}]}], "}"}]}], "]"}]}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NumberOfStandardTableaux", "/@", 
  RowBox[{"IntegerPartitions", "[", "10", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "9", ",", "35", ",", "36", ",", "75", ",", "160", ",", "84", ",", 
   "90", ",", "315", ",", "225", ",", "350", ",", "126", ",", "42", ",", 
   "288", ",", "450", ",", "567", ",", "525", ",", "448", ",", "126", ",", 
   "252", ",", "300", ",", "210", ",", "768", ",", "525", ",", "300", ",", 
   "567", ",", "350", ",", "84", ",", "210", ",", "252", ",", "450", ",", 
   "225", ",", "288", ",", "315", ",", "160", ",", "36", ",", "42", ",", "90",
    ",", "75", ",", "35", ",", "9", ",", "1"}], "}"}]], "Output"]
}, Open  ]],

