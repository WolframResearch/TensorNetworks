   RowBox[{"2", ",", "1", ",", "3"}], "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox["1", "144"]}]], "Output"]
}, Open  ]],

Cell["\<\
A simple representation of the hook lengths:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"HookLengthsRow", "[", 
    RowBox[{"n_", ",", "trpar_List", ",", 
     RowBox[{"{", "row_", "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Take", "[", 
     RowBox[{"trpar", ",", "n"}], "]"}], "+", 
    RowBox[{"Reverse", "@", 
     RowBox[{"Range", "[", "n", "]"}]}], "-", "row"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HookLengthsTableau", "[", "par_List", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"trpar", "=", 
       RowBox[{"TransposePartition", "[", "par", "]"}]}], "}"}], ",", 
     RowBox[{"Tableau", "@@", 
      RowBox[{"MapIndexed", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"HookLengthsRow", "[", 
          RowBox[{"#1", ",", "trpar", ",", "#2"}], "]"}], "&"}], ",", "par"}],
        "]"}]}]}], "]"}]}], ";"}]}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookLengthsTableau", "[", 
  RowBox[{"{", 
   RowBox[{"5", ",", "4", ",", "2"}], "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"Tableau", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"7", ",", "6", ",", "4", ",", "3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "4", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}]}], "]"}]], "Output"]
}, Open  ]],

