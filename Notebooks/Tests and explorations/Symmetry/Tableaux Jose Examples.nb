Cell[TextData[{
 "In other words, if partitions are sorted lexicographically then the matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "\[Lambda]\[Mu]"], TraditionalForm]]],
 " is lower triangular with 1\[CloseCurlyQuote]s in the diagonal. This \
guarantees that certain linear combinations and equations given later can \
always be solved."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tabweights", "//", "Length"}]], "Input"],

Cell[BoxData["175"], "Output"]
}, Open  ]],

Cell[TextData[{
 "A final interesting result is that the numbers in \[Mu] can be reordered \
without affecting the value of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", "\[Lambda]\[Mu]"], TraditionalForm]]],
 ". In that sense \[Mu] does not need to be necessarily a partition, but we \
can always convert it into a partition without changing its value. There are \
only five partitions:"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tabpars", "=", 
  RowBox[{"Reverse", "@", 
   RowBox[{"Union", "[", 
    RowBox[{"Reverse", "/@", 
     RowBox[{"Sort", "/@", "tabweights"}]}], "]"}]}]}]], "Input"],

