Cell["\<\
4) There is an alternative more compact notation as a matrix for that RSK \
double word in which the labels of the second line are also numbers:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MatrixOfDoubleWord", "[", "doubleword_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"0", ",", 
         RowBox[{"doubleword", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"n", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"0", ",", 
         RowBox[{"doubleword", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ",", "matrix"}], "}"}], 
    ",", 
    RowBox[{
     RowBox[{"matrix", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "n"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Increment", "[", 
        RowBox[{"matrix", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "]"}], "&"}], "/@", 
      RowBox[{"Transpose", "[", "doubleword", "]"}]}], ";", "matrix"}]}], 
   "]"}]}]], "Input"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DoubleWordOfMatrix", "[", 
    RowBox[{"{", "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
     RowBox[{"{", "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DoubleWordOfMatrix", "[", "matrix_", "]"}], ":=", 
  RowBox[{"Transpose", "@", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ConstantArray", "[", 
         RowBox[{"#2", ",", "#1"}], "]"}], "&"}], ",", "matrix", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", "2"}], "]"}]}]}]}], "Input"],

