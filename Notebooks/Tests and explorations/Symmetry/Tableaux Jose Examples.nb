Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"StandardSkewTableaux", "[", 
    RowBox[{"opar_List", ",", "ipar_List"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"labels", "=", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Total", "[", "opar", "]"}], "]"}], "-", 
         RowBox[{"Total", "[", "ipar", "]"}]}]}], ",", 
       RowBox[{"pat", "=", 
        RowBox[{"PatternSkewTableau", "[", 
         RowBox[{"opar", ",", "ipar", ",", 
          RowBox[{"_", "?", "Positive"}], ",", 
          RowBox[{"_", "?", "NonPositive"}]}], "]"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Cases", "[", 
        RowBox[{
         RowBox[{"StandardTableaux", "[", 
          RowBox[{"opar", ",", "labels"}], "]"}], ",", "pat"}], "]"}], "/.", 
       RowBox[{
        RowBox[{"_Integer", "?", "NonPositive"}], "\[Rule]", "Skew"}]}], "//",
       "DeleteDuplicates"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"StandardSkewTableaux", "[", 
    RowBox[{"opar_List", ",", "ipar_List", ",", 
     RowBox[{"dim_Integer", "?", "Positive"}]}], "]"}], ":=", 
   RowBox[{"StandardSkewTableaux", "[", 
    RowBox[{"opar", ",", "ipar", ",", 
     RowBox[{"Range", "[", "dim", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"StandardSkewTableaux", "[", 
    RowBox[{"opar_List", ",", "ipar_List", ",", "labels_List"}], "]"}], ":=", 
   
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{
         RowBox[{"Total", "[", "opar", "]"}], "-", 
         RowBox[{"Total", "[", "ipar", "]"}]}]}], ",", 
       RowBox[{"dim", "=", 
        RowBox[{"Length", "[", 
         RowBox[{"LabelsSort", "@", "labels"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Flatten", "@", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"dim", "<", "n"}], ",", 
        RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"StandardSkewTableaux", "[", 
          RowBox[{"opar", ",", "ipar"}], "]"}], "/.", 
         RowBox[{"Inner", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Rule", "[", 
             RowBox[{"#2", ",", "#1"}], "]"}], "&"}], ",", 
           RowBox[{"Subsets", "[", 
            RowBox[{
             RowBox[{"LabelsSort", "@", "labels"}], ",", 
             RowBox[{"{", "n", "}"}]}], "]"}], ",", 
           RowBox[{"Range", "[", "n", "]"}], ",", "List"}], "]"}]}]}], 
       "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"StandardSkewTableaux", ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ";"}]}], "Input"],

