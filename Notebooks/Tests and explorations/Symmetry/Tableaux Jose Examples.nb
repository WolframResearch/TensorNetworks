Cell[CellGroupData[{

Cell["3.4. (General) Young tableaux", "Subsubsection"],

Cell["\<\
1) A general Young tableau is any expression with head Tableau in which the \
arguments are lists of labels (the rows of the tableau) with non-increasing \
length, and such that the lengths of the columns are also non-increasing. We \
pay no attention to the actual labels.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "TableauQ"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"TableauQ[expr] returns True if expr is a valid tableau, that \
is an expression with head Tableau and arguments being lists of \
non-increasing length. It returns False otherwise.\"\>", 
  "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442055-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TableauQ", "[", 
    RowBox[{"tab", ":", 
     RowBox[{"Tableau", "[", "___List", "]"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"GreaterEqual", "@@", 
     RowBox[{"(", 
      RowBox[{"Length", "/@", "tab"}], ")"}]}], "&&", 
    RowBox[{"GreaterEqual", "@@", 
     RowBox[{"(", 
      RowBox[{"Length", "/@", 
       RowBox[{"transpose", "[", "tab", "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TableauQ", "[", "_", "]"}], ":=", "False"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"TableauQ", ",", "1"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "TableauQ", "]"}], ";"}]}], "Input",
 InitializationCell->True],

