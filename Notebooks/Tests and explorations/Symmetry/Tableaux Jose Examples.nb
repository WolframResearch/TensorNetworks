\>", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
5.8. Littlewood-Richardson rule. Computations\
\>", "Subsubsection"],

Cell["\<\
Computations of LR numbers can be done reasonably efficiently, though always \
through some form of backtracking, and hence in exponential time.\
\>", "Text"],

Cell["\<\
1) Add one box, ensuring that the resulting tableau shape is a valid \
partition:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"AddOneBox", "[", 
    RowBox[{"tab_Tableau", ",", "nbox_", ",", 
     RowBox[{"initrow_:", "1"}]}], "]"}], ":=", 
   RowBox[{"DeleteCases", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", "=", 
         RowBox[{
          RowBox[{"Length", "[", "tab", "]"}], "+", "1"}]}], "}"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"addOneBox", "[", 
          RowBox[{"tab", ",", "nbox", ",", 
           RowBox[{"{", 
            RowBox[{"row", ",", "n"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"row", ",", "initrow", ",", "n"}], "}"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", "Null"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AddOneBox", "[", 
    RowBox[{"tablist_List", ",", "nbox_", ",", 
     RowBox[{"initrow_:", "1"}]}], "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"AddOneBox", "[", 
       RowBox[{"#", ",", "nbox", ",", "initrow"}], "]"}], "&"}], "/@", 
     "tablist"}], "]"}]}], ";"}]}], "Input",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"addOneBox", "[", 
    RowBox[{"tab_Tableau", ",", "nbox_", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "n_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"MapAt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Append", "[", 
       RowBox[{"#", ",", "nbox"}], "]"}], "&"}], ",", "tab", ",", "1"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"addOneBox", "[", 
    RowBox[{"tab_Tableau", ",", "nbox_", ",", 
     RowBox[{"{", 
      RowBox[{"n_", ",", "n_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Append", "[", 
    RowBox[{"tab", ",", 
     RowBox[{"{", "nbox", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"addOneBox", "[", 
    RowBox[{"tab_Tableau", ",", "nbox_", ",", 
     RowBox[{"{", 
      RowBox[{"row_", ",", "n_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"tab", "[", 
        RowBox[{"[", "row", "]"}], "]"}], "]"}], "<", 
      RowBox[{"Length", "[", 
       RowBox[{"tab", "[", 
        RowBox[{"[", 
         RowBox[{"row", "-", "1"}], "]"}], "]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"MapAt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Append", "[", 
         RowBox[{"#", ",", "nbox"}], "]"}], "&"}], ",", "tab", ",", "row"}], 
      "]"}], ",", "\[IndentingNewLine]", "Null"}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
 InitializationCell->True],

Cell["\<\
2) Remove those with columns with two elements in the same original row of \
the right tableau:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DropInvalid", "[", 
    RowBox[{"list_List", ",", "n_"}], "]"}], ":=", 
   RowBox[{"transpose", "/@", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"transpose", "/@", "list"}], ",", 
      RowBox[{"Tableau", "[", 
       RowBox[{"___", ",", 
        RowBox[{"{", 
         RowBox[{"___", ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "_"}], "}"}], ",", "___", ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "_"}], "}"}], ",", "___"}], "}"}], ",", "___"}], 
       "]"}]}], "]"}]}]}], ";"}]], "Input",
 InitializationCell->True],

Cell["\<\
List of valid-shape && valid-column tableaux with one more box added:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"AddOneValidBox", "[", 
    RowBox[{"tab_Tableau", ",", 
     RowBox[{"{", 
      RowBox[{"n_", ",", "box_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"DropInvalid", "[", 
    RowBox[{
     RowBox[{"AddOneBox", "[", 
      RowBox[{"tab", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "box"}], "}"}], ",", "n"}], "]"}], ",", "n"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AddOneValidBox", "[", 
    RowBox[{"tablist_List", ",", "nbox_"}], "]"}], ":=", 
   RowBox[{"Union", "@", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"AddOneValidBox", "[", 
        RowBox[{"#", ",", "nbox"}], "]"}], "&"}], "/@", "tablist"}], 
     "]"}]}]}], ";"}]}], "Input",
 InitializationCell->True],

Cell["3) The rule:", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"addlength", "[", 
    RowBox[{"list_List", ",", "n_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tmp", "=", "list"}], "}"}], ",", 
     RowBox[{
      RowBox[{"Increment", "[", 
       RowBox[{"tmp", "[", 
        RowBox[{"[", "n", "]"}], "]"}], "]"}], ";", "tmp"}]}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->True],

Cell["\<\
This old implementation is 3 times faster than my new implementation above:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ReverseLatticeWordQ2", "[", "list_List", "]"}], ":=", 
   RowBox[{"ReverseLatticeWordQ2", "[", 
    RowBox[{"list", ",", 
     RowBox[{"0", " ", "list"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReverseLatticeWordQ2", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "lengths_List"}], "]"}], ":=", "True"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReverseLatticeWordQ2", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n_", ",", "other___"}], "}"}], ",", "lengths_List"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"OrderedQ", "[", 
       RowBox[{"Reverse", "@", "lengths"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "False", ",", "\[IndentingNewLine]", 
     RowBox[{"ReverseLatticeWordQ2", "[", 
      RowBox[{
       RowBox[{"{", "other", "}"}], ",", 
       RowBox[{"addlength", "[", 
        RowBox[{"lengths", ",", "n"}], "]"}]}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 InitializationCell->True],

Cell["\<\
Extract the just added boxes in order (top to bottom, right to left):\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FlattenTableau", "[", "tab_Tableau", "]"}], ":=", 
   RowBox[{"First", "/@", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Apply", "[", 
         RowBox[{"List", ",", 
          RowBox[{"Reverse", "/@", "tab"}]}], "]"}], ",", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"_", ",", "_"}], "}"}]}], "]"}]}]}], ";"}]], "Input",
 InitializationCell->True],

Cell["\<\
Select the good tableux, those in which the added boxes are in reverse \
lattice order:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GoodTableaux", "[", "list_List", "]"}], ":=", 
   RowBox[{"Select", "[", 
    RowBox[{"list", ",", 
     RowBox[{
      RowBox[{"ReverseLatticeWordQ2", "[", 
       RowBox[{"FlattenTableau", "[", "#", "]"}], "]"}], "&"}]}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->True],

Cell["4) Product of two tableaux:", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"markrow", "[", 
    RowBox[{
     RowBox[{"list", ":", 
      RowBox[{"{", "___", "}"}]}], ",", 
     RowBox[{"{", "row_", "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"row", ",", "#"}], "}"}], "&"}], "/@", "list"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"unmarkrow", "[", 
    RowBox[{"list", ":", 
     RowBox[{"{", "___Tableau", "}"}]}], "]"}], ":=", 
   RowBox[{"Replace", "[", 
    RowBox[{"list", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}], "\[RuleDelayed]", "y"}], ",", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}]}], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "LRrule"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"LRrule[tab1, tab2] decomposes the product of the Young \
tableaux tab1, tab2 as a sum (with multiplicities) of Young tableaux, using \
the Littlewood-Richardson rule.\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442787-8749065"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Algebra", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"LRrule", "[", 
      RowBox[{"Lfactors___", ",", "expr_Plus", ",", "Rfactors___"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"LRrule", "[", 
        RowBox[{"Lfactors", ",", "#", ",", "Rfactors"}], "]"}], "&"}], "/@", 
      "expr"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LRrule", "[", 
      RowBox[{"Lfactors___", ",", 
       RowBox[{
        RowBox[{"coeff_", "?", "NumberQ"}], " ", "expr_"}], ",", 
       "Rfactors___"}], "]"}], ":=", 
     RowBox[{"coeff", " ", 
      RowBox[{"LRrule", "[", 
       RowBox[{"Lfactors", ",", "expr", ",", "Rfactors"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Vararg", " ", "product"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LRrule", "[", "]"}], ":=", 
     RowBox[{"Tableau", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LRrule", "[", "tab_Tableau", "]"}], ":=", "tab"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LRrule", "[", 
      RowBox[{"tabL_Tableau", ",", "tabR_Tableau", ",", "factors__"}], "]"}], 
     ":=", 
     RowBox[{"LRrule", "[", 
      RowBox[{
       RowBox[{"LRrule", "[", 
        RowBox[{"tabL", ",", "tabR"}], "]"}], ",", "factors"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Main", " ", "definition"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LRrule", "[", 
      RowBox[{"tabL_Tableau", ",", "tabR_Tableau"}], "]"}], ":=", 
     RowBox[{"Apply", "[", 
      RowBox[{"Plus", ",", 
       RowBox[{"unmarkrow", "@", 
        RowBox[{"GoodTableaux", "@", 
         RowBox[{"Fold", "[", 
          RowBox[{"AddOneValidBox", ",", "tabL", ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"List", "@@", 
              RowBox[{"MapIndexed", "[", 
               RowBox[{"markrow", ",", "tabR"}], "]"}]}], ",", "1"}], "]"}]}],
           "\[IndentingNewLine]", "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}],
     ";"}]}]}]], "Input",
 InitializationCell->True],

Cell["\<\
5) Example of how this works. The labels in the first tableau are irrelevant. \
The labels in the second one must be in Yamanouchi form:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tL", "=", 
   RowBox[{"Tableau", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "x", ",", "x"}], "}"}], ",", 
