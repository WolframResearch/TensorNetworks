}, Open  ]],

Cell["Trailing zeros are irrelevant:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookFactor", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", "2", ",", "0", ",", "0", ",", "0"}], "}"}], 
  "]"}]], "Input"],

Cell[BoxData[
 FractionBox["1", "12"]], "Output"]
}, Open  ]],

Cell["\<\
but increasing integers produce invalid Hood factors:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookFactor", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", "0", ",", "1"}], "}"}], "]"}]], "Input"],

Cell[BoxData["0"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookFactor", "[", 
