Cell[CellGroupData[{

Cell["1.2. Usage messages", "Subsubsection"],

Cell[TextData[{
 "Notes:\n\t- A ",
 StyleBox["partition",
  FontSlant->"Italic"],
 " will be denoted in the code as ",
 StyleBox["par",
  FontWeight->"Bold"],
 ". Do not use ",
 StyleBox["part",
  FontWeight->"Bold"],
 " because that is something else in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ".\n\t- A ",
 StyleBox["tableau",
  FontSlant->"Italic"],
 " will be denoted in the code as ",
 StyleBox["tab",
  FontWeight->"Bold"],
 ".\n\t- The object filling a box of a tableau is called a ",
 StyleBox["label",
  FontSlant->"Italic"],
 ". The word ",
 StyleBox["element",
  FontSlant->"Italic"],
 " is too general."
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Some", " ", "combinatorics", " ", "and", " ", "partitions"}], " ",
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"RepeatedSubsets", "::", "usage"}], "=", "\"\<\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PartitionQ", "::", "usage"}], "=", 
     "\"\<PartitionQ[expr] returns True if expr is a partition of a \
nonnegative integer, i.e. a non-increasing list of nonnegative integers, and \
False otherwise.\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TransposePartition", "::", "usage"}], "=", 
     "\"\<TransposePartition[par] returns the transpose of the partition par.\
\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HookFactor", "::", "usage"}], "=", 
     "\"\<HookFactor[par] computes the hook factor of the partition \
par.\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"InclusionOrder", "::", "usage"}], "=", 
     "\"\<InclusionOrder[par1, par2]\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"DominanceOrder", "::", "usage"}], "=", 
     "\"\<DominanceOrder[par1, par2]\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LexicographicOrder", "::", "usage"}], "=", 
     "\"\<LexicographicOrder[par1, par2]\>\""}], ";"}]}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Main", " ", "notation"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Tableau", "::", "usage"}], "=", 
     "\"\<Tableau is the head used to denote a Young tableau. Its arguments \
are lists containing the labels of consecutive rows of the tableau. A tableau \
is typeset as a left-justified and top-justified ragged array of boxes \
containing the labels (English style).\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TransposeTableau", "::", "usage"}], "=", 
     "\"\<TransposeTableau[tab] returns a Young tableau obtained from tab by \
turning the rows into columns and viceversa.\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TableauWeight", "::", "usage"}], "=", 
     "\"\<TableauWeight[tab, set] returns the weight of the tableau w.r.t. \
the given set of labels. This is a list of the respective numbers of \
occurrences of the elements of set in the tableau tab. TableauWeight[tab] \
returns the weight in the set of the union of all entries, sorted.\>\""}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"General", " ", "tableaux"}], " ", "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"TableauQ", "::", "usage"}], "=", 
     "\"\<TableauQ[expr] returns True if expr is a valid tableau, that is an \
expression with head Tableau and arguments being lists of non-increasing \
length. It returns False otherwise.\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Tableaux", "::", "usage"}], "=", 
     "\"\<Tableaux[par, set] returns the list of all tableaux, of shape given \
by the partition par, that can be constructed onto the given set of labels. \
Tableaux[par, n] for a positive integer n is interpreted as Tableaux[par, \
Range[n]]. Tableaux[par] is interpreted as Tableaux[par, Total[par]].\>\""}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"NumberOfTableaux", "::", "usage"}], "=", 
     "\"\<NumberOfTableaux[part, set] returns the number of tableaux, of \
shape given by the partition par, that can be constructed onto the given set \
of labels. NumberOfTableaux[par, n] for a positive integer is interpreted as \
NumberOfTableaux[par, Range[n]]. NumberOfTableaux[par] is interpreted as \
NumberOfTableaux[par, Total[par]].\>\""}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Disjoint", " ", "tableaux"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"DisjointTableauQ", "::", "usage"}], "=", 
     "\"\<DisjointTableauQ[expr] returns True if expr is a valid disjoint \
tableau, that is a Young tableau whose labels are all different. It returns \
False otherwise.\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"DisjointTableaux", "::", "usage"}], "=", 
     "\"\<DisjointTableaux[par, set] returns the list of all disjoint \
tableaux, of shape given by the partition par, that can be constructed onto \
the given set of labels. DisjointTableaux[par, n] for a positive integer n is \
interpreted as DisjointTableaux[par, Range[n]]. DisjointTableaux[par] is \
interpreted as DisjointTableaux[par, Total[par]].\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"NumberOfDisjointTableaux", "::", "usage"}], "=", 
     "\"\<NumberOfDisjointTableaux[par, set] returns the number of disjoint \
tableaux, of shape given by the partition par, that can be constructed onto \
the given set of labels. NumberOfDisjointTableaux[par, n] for a positive \
integer n is interpreted as NumberOfDisjointTableaux[par, Range[n]]. \
NumberOfDisjointTableaux[par] is interpreted as NumberOfDisjointTableaux[par, \
Total[par]].\>\""}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Semistandard", " ", "tableaux"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SemistandardTableauQ", "::", "usage"}], "=", 
     "\"\<SemistandardTableauQ[tab] gives True if the labels of the Young \
tableau tab are sorted in each row and are sorted and different in each \
column. It returns False otherwise.\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SemistandardTableaux", "::", "usage"}], "=", 
     "\"\<SemistandardTableaux[par, set] returns the list of all semistandard \
tableaux, of shape given by the partition par, that can be constructed onto \
the given set of labels. SemistandardTableaux[par, n] for a positive integer \
n is interpreted as SemistandardTableaux[par, Range[n]]. \
SemistandardTableaux[par] is interpreted as SemistandardTableaux[par, \
Total[par]].\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"NumberOfSemistandardTableaux", "::", "usage"}], "=", 
     "\"\<NumberOfSemistandardTableaux[par, set] returns the number of \
semistandard tableaux, of shape given by the partition par, that can be \
constructed onto the given set of labels. NumberOfSemistandardTableaux[par, \
n] for a positive integer n is interpreted as \
NumberOfSemistandardTableaux[par, Range[n]]. \
NumberOfSemistandardTableaux[par] is interpreted as \
NumberOfSemistandardTableaux[par, Total[par]].\>\""}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Standard", " ", "tableaux"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"StandardTableauQ", "::", "usage"}], "=", 
     "\"\<StandardTableauQ[tab] gives True if the labels of the Young tableau \
tab are all different, and the labels of each row and each column are sorted. \
It returns False otherwise.\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"StandardTableaux", "::", "usage"}], "=", 
     "\"\<StandardTableaux[par, set] returns the list of all standard \
tableaux, of shape given by the partition par, that can be constructed onto \
the given set of labels. StandardTableaux[par, n] for a positive integer n is \
interpreted as StandardTableaux[par, Range[n]]. StandardTableaux[par] is \
interpreted as StandardTableaux[par, Total[par]]. StandardTableaux[n] returns \
the list of all possible standard tableaux corresponding to the partitions of \
the integer n.\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"NumberOfStandardTableaux", "::", "usage"}], "=", 
     "\"\<NumberOfStandardTableaux[par, set] returns the number of standard \
tableaux, of shape given by the partition par, that can be constructed onto \
the given set of labels. NumberOfStandardTableaux[par, n] for a positive \
integer n is interpreted as NumberOfStandardTableaux[par, Range[n]]. \
NumberOfStandardTableaux[par] is interpreted as NumberOfStandardTableaux[par, \
Total[par]]. NumberOfStandardTableaux[n] returns the number of standard \
tableaux corresponding to all partitions of the integer n.\>\""}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Normal", " ", "tableaux"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"NormalTableauQ", "::", "usage"}], "=", 
     "\"\<NormalTableauQ[tab] gives True if the Young tableau tab is written \
in normal form, that is, its elements are sorted when joining all rows into a \
single list. It returns False otherwise.\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TableauOfPartition", "::", "usage"}], "=", 
     "\"\<TableauOfPartition[part] returns a filled Tableau constructed from \
part which is the partition of a natural number. The entries of this tableau \
are the natural numbers sorted in their canonical order when reading the \
tableau from left to right\>\""}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Skew", " ", "tableaux"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Skew", "::", "usage"}], "=", 
     "\"\<Skew is a symbol used to denote boxes of the interior partition of \
a skew tableau.\>\""}], ";"}]}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Operations", " ", "with", " ", "tableaux"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"RowBump", "::", "usage"}], "=", 
     "\"\<RowBump[tab, x, n] bumps the label x into the n-th row of the \
semistandard tableau tab. RowBump[tab, x] bumps the label into the first row \
of tab.\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SchenstedProduct", "::", "usage"}], "=", 
     "\"\<SchenstedProduct[tab1, tab2] computes the Schensted product of the \
semistandard tableaux tab1 and tab2, by iteration of RowBump.\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SkewTableauSlide", "::", "usage"}], "=", 
     "\"\<SkewTableauSlide[skewtab] removes the last Skew box of the skew \
tableau skewtab, using the sliding algorithm.\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"RectifySkewTableau", "::", "usage"}], "=", 
     "\"\<RectifySkewTableau[skewtab] removes all Skew boxes of the skew \
tableau skewtab, by iteration of SkewTableauSlide.\>\""}], ";"}]}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Words", " ", "and", " ", "the", " ", "plactic", " ", "monoid"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"WordOfTableau", "::", "usage"}], "=", "\"\<\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TableauOfWord", "::", "usage"}], "=", "\"\<\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LatticeWordQ", "::", "usage"}], "=", "\"\<\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ReverseLatticeWordQ", "::", "usage"}], "=", "\"\<\>\""}], 
    ";"}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"The", " ", "LR", " ", "rule"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"LRrule", "::", "usage"}], "=", 
     "\"\<LRrule[tab1, tab2] decomposes the product of the Young tableaux \
tab1, tab2 as a sum (with multiplicities) of Young tableaux, using the \
Littlewood-Richardson rule.\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LRNumber", "::", "usage"}], "=", 
     "\"\<LRNumber[par1, par2, tpar] returns the Littlewood-Richardson number \
associated to the decomposition of the partition tpar as a product of par1 \
and par2.\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LRProduct", "::", "usage"}], "=", 
     "\"\<LRProduct[tabpar1, tabpar2] returns the product of partitions, \
using Tableau notation for them.\>\""}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Branching", " ", "rules"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Branch", "::", "usage"}], "=", 
     "\"\<Branch[par] reduces the GL(d) representation par into a sum of \
representations of O(d).\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"DimensionalRestriction", "::", "usage"}], "=", 
     "\"\<DimensionalRestriction[par, dim] eliminates linear dependencies and \
trivial cases in the O(d) representation par.\>\""}], ";"}]}]}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Symmetric", " ", "polynomials", " ", "and", " ", "plethysms"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
