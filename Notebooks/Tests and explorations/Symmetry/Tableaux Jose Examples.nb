       Item[Tableaux`Private`d, Frame -> RGBColor[0, 0, 1]]}}], FontSize -> 
    10]]]], "Output"]
}, Open  ]],

Cell["\<\
Hence, semistandard tableaux correspond to classes of equivalence of words.\
\>", "Text"],

Cell["\<\
We could also define Knuth-equivalence of words as those words whose tableaux \
coincide.\
\>", "Text"],

Cell["\<\
But usually Knuth-equivalence is based on whether words can be related by \
elementary Knuth transformations. There are two. The basic idea is to work \
with a product of words given by juxtaposition, and give words a canonical \
form under the Knuth transformations:\
\>", "Text"],

Cell["\<\
Elementary Knuth transformation 1:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KnuthProduct", "[", 
    RowBox[{"{", 
     RowBox[{"L___", ",", "y_", ",", "z_", ",", "x_", ",", "R___"}], "}"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Using rule 1 with \>\"", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"L", ",", "y", ",", "z", ",", "x", ",", "R"}], "}"}], 
         "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"L", ",", "y", ",", "x", ",", "z", ",", "R"}], "}"}]}], 
        ",", "\"\< assuming \>\"", ",", "x", ",", "\"\<<\>\"", ",", "y", ",", 
        
        RowBox[{"\"\<\[LessEqual]\>\"", "z"}]}], "]"}], ";", 
      RowBox[{"KnuthProduct", "[", 
       RowBox[{"{", 
        RowBox[{"L", ",", "y", ",", "x", ",", "z", ",", "R"}], "}"}], "]"}]}],
      ")"}], "/;", 
    RowBox[{
     RowBox[{"OrderedQ", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}], "&&", 
     RowBox[{"UnsameQ", "[", 
      RowBox[{"x", ",", "y"}], "]"}]}]}]}], ";"}]], "Input"],

Cell["\<\
Elementary Knuth transformation 2:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KnuthProduct", "[", 
    RowBox[{"{", 
     RowBox[{"L___", ",", "x_", ",", "z_", ",", "y_", ",", "R___"}], "}"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Using rule 2 with \>\"", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"L", ",", "x", ",", "z", ",", "y", ",", "R"}], "}"}], 
         "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"L", ",", "z", ",", "x", ",", "y", ",", "R"}], "}"}]}], 
        ",", "\"\< assuming \>\"", ",", "x", ",", "\"\<\[LessEqual]\>\"", ",",
         "y", ",", "\"\<<\>\"", ",", "z"}], "]"}], ";", 
      RowBox[{"KnuthProduct", "[", 
       RowBox[{"{", 
        RowBox[{"L", ",", "z", ",", "x", ",", "y", ",", "R"}], "}"}], "]"}]}],
      ")"}], "/;", 
    RowBox[{
     RowBox[{"OrderedQ", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], "]"}], "&&", 
     RowBox[{"UnsameQ", "[", 
      RowBox[{"y", ",", "z"}], "]"}]}]}]}], ";"}]], "Input"],

Cell["\<\
Fulton's description is terrible, and leads to infinite loops :\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauOfWord", "[", 
  RowBox[{"{", 
   RowBox[{"v", ",", "x", ",", "z", ",", "u", ",", "y"}], "}"}], 
  "]"}]], "Input"],

