Cell[CellGroupData[{

Cell["3.3. TransposeTableau", "Subsubsection"],

Cell["\<\
Generalization of Transpose for ragged arrays. This operation is independent \
of the labels of the tableau.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "TransposeTableau"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"TransposeTableau[tab] returns a Young tableau obtained from \
tab by turning the rows into columns and viceversa.\"\>", 
  "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442055-9818602"]
}, Open  ]],

Cell["\<\
The only difference between TransposeTableau and transpose is that the former \
only works on expressions with head Tableau, while the latter accepts any \
head. The function works by padding with a unique variable pad$ and then \
using Transpose.\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"padright", "[", 
    RowBox[{"list_List", ",", "pad_"}], "]"}], ":=", 
   RowBox[{"PadRight", "[", 
    RowBox[{"list", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "list", "]"}], ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Length", "/@", "list"}], "]"}]}], "}"}], ",", "pad"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
