  "0.02598400000000000015232259897857147735`4.4353059208407055", ",", "45"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DynamicModule", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", "j", ",", "res"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"result", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Dynamic", "[", "i", "]"}], ",", 
        RowBox[{"Dynamic", "[", "j", "]"}], ",", 
        RowBox[{"Dynamic", "[", 
         RowBox[{"Length", "[", "result", "]"}], "]"}]}], "}"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"res", "=", 
         RowBox[{"SchenstedProduct", "[", 
          RowBox[{
           RowBox[{"lambdasstabs", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"musstabs", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Length", "/@", 
             RowBox[{"List", "@@", "res"}]}], ")"}], "===", "nu"}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"result", ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}], "\[Rule]", "res"}]}], "]"}]}], 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "lambdasstabs", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "[", "musstabs", "]"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], ";", 
     RowBox[{"Length", "[", "result", "]"}]}]}], "\[IndentingNewLine]", "]"}],
   "//", "Timing"}]}], "Input"],

