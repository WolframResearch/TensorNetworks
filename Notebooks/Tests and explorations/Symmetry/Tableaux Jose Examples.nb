Cell["\<\
2) Generation of all tableaux for a given set of labels  or dimension \
(interpreted as labels Range[dim]):\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "Tableaux"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"Tableaux[par, set] returns the list of all tableaux, of shape \
given by the partition par, that can be constructed onto the given set of \
labels. Tableaux[par, n] for a positive integer n is interpreted as \
Tableaux[par, Range[n]]. Tableaux[par] is interpreted as Tableaux[par, \
Total[par]].\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442056-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RaggedPartition", "[", 
    RowBox[{"list_List", ",", "lengths_List"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"raggedpartition", "[", 
     RowBox[{"list", ",", 
      RowBox[{"{", "}"}], ",", "lengths"}], "]"}], "/;", 
    RowBox[{
     RowBox[{"Length", "[", "list", "]"}], "\[GreaterEqual]", 
     RowBox[{"Total", "[", "lengths", "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"raggedpartition", "[", 
    RowBox[{"list_List", ",", "done_List", ",", 
     RowBox[{"{", 
      RowBox[{"l_", ",", "rest___"}], "}"}]}], "]"}], ":=", 
   RowBox[{"raggedpartition", "[", 
    RowBox[{
     RowBox[{"Drop", "[", 
      RowBox[{"list", ",", "l"}], "]"}], ",", 
     RowBox[{"Append", "[", 
      RowBox[{"done", ",", 
       RowBox[{"Take", "[", 
        RowBox[{"list", ",", "l"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", "rest", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"raggedpartition", "[", 
    RowBox[{"list_List", ",", "done_List", ",", 
     RowBox[{"{", "}"}]}], "]"}], ":=", "done"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MakeTableau", "[", 
   RowBox[{"list_List", ",", "par_List"}], "]"}], ":=", 
  RowBox[{"Tableau", "@@", 
   RowBox[{"RaggedPartition", "[", 
    RowBox[{"list", ",", "par"}], "]"}]}]}]}], "Input",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Tableaux", "[", 
    RowBox[{"par", ":", 
     RowBox[{"{", "___Integer", "}"}]}], "]"}], ":=", 
   RowBox[{"Tableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Total", "@", "par"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Tableaux", "[", 
    RowBox[{
     RowBox[{"par", ":", 
      RowBox[{"{", "___Integer", "}"}]}], ",", 
     RowBox[{"dim_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
   RowBox[{"Tableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Range", "[", "dim", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Tableaux", "[", 
    RowBox[{
     RowBox[{"par", ":", 
      RowBox[{"{", "___Integer", "}"}]}], ",", "labels_List"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"MakeTableau", "[", 
      RowBox[{"#", ",", "par"}], "]"}], "&"}], "/@", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"LabelsSort", "[", "labels", "]"}], ",", 
      RowBox[{"Total", "@", "par"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"Tableaux", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "Tableaux", "]"}], ";"}]}], "Input",
 InitializationCell->True],

