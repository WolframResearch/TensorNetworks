Cell[CellGroupData[{

Cell["0.3. Codes", "Subsubsection"],

Cell[TextData[{
 StyleBox["Combinatorica",
  FontSlant->"Italic"],
 " has some support for Young tableaux, but very little, and rather slow."
}], "Text"],

Cell[TextData[{
 "A ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " package is [",
 ButtonBox["LieART",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://lieart.hepforge.org/"], None},
  ButtonNote->"http://lieart.hepforge.org/"],
 "], with focus on Lie algebras."
}], "Text"],

Cell[TextData[{
 "Wybourne and his students developed ",
 StyleBox["Schur",
  FontSlant->"Italic"],
 ", for computations with Young tableaux and many other aspects of \
representation theory. Version 5 was commercialized by Steve Christensen. \
Version 6 is free: [",
 ButtonBox["schur.sourceforge.net",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://schur.sourceforge.net/"], None},
  ButtonNote->"http://schur.sourceforge.net/"],
 "]."
}], "Text"],

Cell[TextData[{
 "The Lie groups community has developed several codes, most notably [",
 ButtonBox["LiE",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://young.sp2mi.univ-poitiers.fr/~marc/LiE/"], None},
  ButtonNote->"http://young.sp2mi.univ-poitiers.fr/~marc/LiE/"],
 "], which includes Young tableaux capabilities."
}], "Text"],

Cell[TextData[{
 "MAGMA has Young tableaux capabilities in its [",
 ButtonBox["Combinatorics section",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://magma.maths.usyd.edu.au/magma/overview/2/17/19/"], None},
  ButtonNote->"http://magma.maths.usyd.edu.au/magma/overview/2/17/19/"],
 "]."
}], "Text"],

Cell[TextData[{
 "GAP 4 has Young tableaux capabilities in its [",
 ButtonBox["Hecke extension",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://www.gap-system.org/Manuals/pkg/hecke/doc/chap0.html"], None},
  ButtonNote->"http://www.gap-system.org/Manuals/pkg/hecke/doc/chap0.html"],
 "], which is a port of [",
 ButtonBox["Specht",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://www.maths.usyd.edu.au/u/mathas/specht/"], None},
  ButtonNote->"http://www.maths.usyd.edu.au/u/mathas/specht/"],
 "]. I\[CloseCurlyQuote]m not sure this covers the general case."
}], "Text"]
}, Closed]]
}, Open  ]],

