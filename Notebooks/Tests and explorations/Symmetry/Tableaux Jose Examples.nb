Cell["\<\
2) The row-bumping operation can be reversed if we know the position of the \
last added box. It returns the previous tableau and the label that was last \
bumped in.\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ColumnOfStrictlySmaller", "[", 
    RowBox[{"rowlabels_", ",", "label_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"col", "=", 
       RowBox[{"Length", "[", "rowlabels", "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OrderedQ", "[", 
          RowBox[{"{", 
           RowBox[{"label", ",", 
            RowBox[{"rowlabels", "[", 
             RowBox[{"[", "col", "]"}], "]"}]}], "}"}], "]"}], "&&", 
         RowBox[{"col", ">", "0"}]}], ",", 
        RowBox[{"col", "--"}]}], "]"}], ";", "col"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReverseRowBump", "[", 
    RowBox[{
     RowBox[{"tab_Tableau", "?", "SemistandardTableauQ"}], ",", 
     RowBox[{"row_:", "-", "1"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"ReverseRowBumpLabel", "[", 
     RowBox[{
      RowBox[{"MapAt", "[", 
       RowBox[{"Most", ",", "tab", ",", "row"}], "]"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"row", "<", "0"}], ",", 
        RowBox[{"row", "+", 
         RowBox[{"Length", "[", "tab", "]"}]}], ",", 
        RowBox[{"row", "-", "1"}]}], "]"}], ",", 
      RowBox[{"tab", "[", 
       RowBox[{"[", 
        RowBox[{"row", ",", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], "]"}], "/;", 
    RowBox[{
     RowBox[{"Abs", "[", "row", "]"}], "\[LessEqual]", 
     RowBox[{"Length", "[", "tab", "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReverseRowBumpLabel", "[", 
    RowBox[{"tab_Tableau", ",", "0", ",", "label_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"tab", ",", "label"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReverseRowBumpLabel", "[", 
    RowBox[{"tab_Tableau", ",", "row_", ",", "label_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"col", "=", 
       RowBox[{"ColumnOfStrictlySmaller", "[", 
        RowBox[{
         RowBox[{"tab", "[", 
          RowBox[{"[", "row", "]"}], "]"}], ",", "label"}], "]"}]}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"ReverseRowBumpLabel", "[", 
      RowBox[{
       RowBox[{"ReplacePart", "[", 
        RowBox[{"tab", ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"row", ",", "col"}], "}"}], "\[Rule]", "label"}]}], "]"}], 
       ",", 
       RowBox[{"row", "-", "1"}], ",", 
       RowBox[{"tab", "[", 
        RowBox[{"[", 
         RowBox[{"row", ",", "col"}], "]"}], "]"}]}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input"],

Cell["Example:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"tab", "=", 
      RowBox[{"Tableau", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "5", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "4", ",", "6"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"5", ",", "6"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"label", "=", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ReverseRowBump", "@", 
     RowBox[{"RowBump", "[", 
      RowBox[{"tab", ",", "label"}], "]"}]}], "===", 
    RowBox[{"{", 
     RowBox[{"tab", ",", "label"}], "}"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell["\<\
There is a concept of \[OpenCurlyDoubleQuote]bumping route\
\[CloseCurlyDoubleQuote], as the set of boxes whose labels are bumped. There \
is then the Row Bumping Lemma, describing the relative positions of the \
bumping routes of two labels x1, x2 depending on whether x1<=x2 or x1>x2.\
\>", "Text"],

Cell["\<\
3) Iterating the bumping algorithm we can construct an associative product of \
semistandard tableaux, called the Schensted product:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "SchenstedProduct"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"SchenstedProduct[tab1, tab2] computes the Schensted product of \
the semistandard tableaux tab1 and tab2, by iteration of RowBump.\"\>", 
  "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442349-9818602"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SchenstedProduct", "[", 
    RowBox[{
     RowBox[{"tab1_Tableau", "?", "SemistandardTableauQ"}], ",", 
     RowBox[{"tab2_Tableau", "?", "SemistandardTableauQ"}]}], "]"}], ":=", 
   RowBox[{"Fold", "[", 
    RowBox[{"RowBump", ",", "tab1", ",", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Reverse", "[", 
       RowBox[{"List", "@@", "tab2"}], "]"}], "]"}]}], "]"}]}], 
  ";"}]], "Input"],

