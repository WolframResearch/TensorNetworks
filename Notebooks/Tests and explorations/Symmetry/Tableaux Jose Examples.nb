 RowBox[{
  RowBox[{
   RowBox[{"SemistandardSkewTableauQ", "[", "tab_Tableau", "]"}], ":=", 
   RowBox[{
    RowBox[{"SkewTableauQ", "[", "tab", "]"}], "&&", 
    RowBox[{"And", "@@", 
     RowBox[{"(", 
      RowBox[{"OrderedQ", "/@", 
       RowBox[{"DeleteSkew", "[", "tab", "]"}]}], ")"}]}], "&&", 
    RowBox[{"And", "@@", 
     RowBox[{"(", 
      RowBox[{"UnsameOrderedQ", "/@", 
       RowBox[{"DeleteSkew", "[", 
        RowBox[{"transpose", "[", "tab", "]"}], "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
