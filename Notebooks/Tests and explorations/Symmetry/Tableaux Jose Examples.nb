Cell[CellGroupData[{

Cell["6.4. SchurPolynomial", "Subsubsection"],

Cell["\<\
We use the second Gambelli formula for Schur polynomials :\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SchurPolynomial", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "vars_List"}], "]"}], ":=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SchurPolynomial", "[", 
    RowBox[{
     RowBox[{"partition", ":", 
      RowBox[{"{", 
       RowBox[{"__Integer", "?", "Positive"}], "}"}]}], ",", "vars_List"}], 
    "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"trpart", "=", 
       RowBox[{"TransposePartition", "[", "partition", "]"}]}], "}"}], ",", 
     RowBox[{"Det", "@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"SymmetricPolynomial", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"trpart", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "+", "j", "-", "i"}], ",", 
          "vars"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "trpart", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"Length", "[", "trpart", "]"}]}], "}"}]}], "]"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"SchurPolynomial", ",", "2"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "SchurPolynomial", "]"}], ";"}]}], "Input",
 InitializationCell->True],

Cell["\<\
We could also use the first Gambelli formula, but it is generally slower :\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SchurPolynomial1", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "vars_List"}], "]"}], ":=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SchurPolynomial1", "[", 
    RowBox[{
     RowBox[{"partition", ":", 
      RowBox[{"{", 
       RowBox[{"__Integer", "?", "Positive"}], "}"}]}], ",", "vars_List"}], 
    "]"}], ":=", 
   RowBox[{"Det", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"CompleteHomogeneousSymmetricPolynomial", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"partition", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "+", "j", "-", "i"}], ",", "vars"}],
        "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "partition", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"Length", "[", "partition", "]"}]}], "}"}]}], "]"}]}]}], 
  ";"}]}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SchurPolynomial", "[", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData["1"], "Output"]
}, Open  ]],

Cell["\<\
The result is given in unexpanded form, because usually takes longer to \
expand it than generating it:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SchurPolynomial", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"x1", " ", "x2", " ", "x3", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "x1"}], " ", "x2", " ", "x3"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x1", "+", "x2", "+", "x3"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x1", " ", "x2"}], "+", 
       RowBox[{"x1", " ", "x3"}], "+", 
       RowBox[{"x2", " ", "x3"}]}], ")"}]}]}], ")"}]}]], "Output"]
}, Open  ]],

