Cell["\<\
This removes the last inside corner of the small tableau :\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SkewTableuSlide", "[", "%", "]"}]], "Input"],

Cell[BoxData[
 InterpretationBox[Cell[BoxData[
   FormBox[
    StyleBox[
     TagBox[GridBox[{
        {
         ItemBox["\[FilledSquare]",
          Frame->RGBColor[0, 0, 1],
          StripOnInput->False], 
         ItemBox["\[FilledSquare]",
          Frame->RGBColor[0, 0, 1],
          StripOnInput->False], 
