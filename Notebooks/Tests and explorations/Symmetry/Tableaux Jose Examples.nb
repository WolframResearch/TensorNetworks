Cell[CellGroupData[{

Cell["2.6. RepeatedSubsets", "Subsubsection"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "RepeatedSubsets"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442051-9818602"]
}, Open  ]],

Cell["\<\
This is not a good name. It should be something like SubsetsWithRepetitions \
or better Multisets:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RepeatedSubsets", "[", 
    RowBox[{"vars_List", ",", "k_"}], "]"}], ":=", 
   RowBox[{"Apply", "[", 
    RowBox[{"Union", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"repeatedsubsets", "[", 
        RowBox[{"vars", ",", "k", ",", "#"}], "]"}], "&"}], "/@", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "vars", "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RepeatedSubsets", "[", 
    RowBox[{"vars_List", ",", "1"}], "]"}], ":=", 
   RowBox[{"List", "/@", "vars"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RepeatedSubsets", "[", 
    RowBox[{"vars_List", ",", "0"}], "]"}], ":=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"repeatedsubsets", "[", 
    RowBox[{"vars_List", ",", "k_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Flatten", "/@", 
    RowBox[{"Thread", "[", 
     RowBox[{"List", "[", 
      RowBox[{
       RowBox[{"vars", "[", 
        RowBox[{"[", "n", "]"}], "]"}], ",", 
       RowBox[{"RepeatedSubsets", "[", 
        RowBox[{
         RowBox[{"Drop", "[", 
          RowBox[{"vars", ",", 
           RowBox[{"n", "-", "1"}]}], "]"}], ",", 
         RowBox[{"k", "-", "1"}]}], "]"}]}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"RepeatedSubsets", ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "RepeatedSubsets", "]"}], ";"}]}], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RepeatedSubsets", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}], ",", "3"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "a", ",", "a"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "a", ",", "b"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "b"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"b", ",", "b", ",", "b"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
These are alternative ways of constructing them, but they go through \
intermediate cases that are potentially very large:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Subsets", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "a", ",", "a", ",", "b", ",", "b", ",", "b"}], "}"}], 
    ",", 
    RowBox[{"{", "3", "}"}]}], "]"}], "//", "DeleteDuplicates"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "a", ",", "a"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "a", ",", "b"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "b"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"b", ",", "b", ",", "b"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", "/@", 
   RowBox[{"Tuples", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}], ",", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], "//", "DeleteDuplicates"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "a", ",", "a"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "a", ",", "b"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "b"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"b", ",", "b", ",", "b"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
The length of the result is the standard\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Binomial", "[", 
  RowBox[{
   RowBox[{"2", "+", "3", "-", "1"}], ",", "3"}], "]"}]], "Input"],

Cell[BoxData["4"], "Output"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["2.7. PartitionCorners", "Subsubsection"],

Cell["\<\
We now define the concept of partition corners: these are positions in the \
Young diagram of that partition such that they are at the end of the row and \
they do not have a box below them (hence they have hook-length 1).\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cornerposition", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "_"}], "}"}], ",", 
     RowBox[{"{", "_", "}"}]}], "]"}], ":=", 
   RowBox[{"Sequence", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cornerposition", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"_", ",", "column_"}], "}"}], ",", 
     RowBox[{"{", "row_", "}"}]}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"row", ",", "column"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PartitionCorners", "[", "par_List", "]"}], ":=", 
  RowBox[{"MapIndexed", "[", 
   RowBox[{"cornerposition", ",", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Differences", "[", 
        RowBox[{"Append", "[", 
         RowBox[{"par", ",", "0"}], "]"}], "]"}], ",", "par"}], "}"}], 
     "]"}]}], "]"}]}]}], "Input"],

Cell["\<\
Positions are denoted in the standard matrix-style of tableaux (English \
style).\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PartitionCorners", "[", 
  RowBox[{"{", 
   RowBox[{"4", ",", "4", ",", "1"}], "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "1"}], "}"}]}], "}"}]], "Output"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["2.8. Ordering of partitions", "Subsubsection"],

Cell["\<\
There are three orders for the whole sets of partitions. We want to order \
partitions even if they have different lengths. The idea is that of padding \
with zeros on the right if needed before comparing them.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pars6", "=", 
  RowBox[{"IntegerPartitions", "[", "6", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "6", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}]}], 
  "}"}]], "Output"]
}, Open  ]],

Cell["\<\
1) Inclusion order. This is the most restrictive. It is not a total order.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "InclusionOrder"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"InclusionOrder[par1, par2]\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442051-9818602"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InclusionOrder", "[", 
    RowBox[{"par1_List", ",", "par2_List"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l1", "=", 
        RowBox[{"Length", "@", "par1"}]}], ",", 
       RowBox[{"l2", "=", 
        RowBox[{"Length", "@", "par2"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"l1", "\[LessEqual]", "l2"}], " ", "&&", 
        RowBox[{"And", "@@", 
         RowBox[{"LessEqual", "@@@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"par1", ",", 
             RowBox[{"par2", "[", 
              RowBox[{"[", 
               RowBox[{"Range", "[", "l1", "]"}], "]"}], "]"}]}], "}"}], 
           "]"}]}]}]}], ",", "1", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"l2", "\[LessEqual]", "l1"}], "&&", 
        RowBox[{"And", "@@", 
         RowBox[{"LessEqual", "@@@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"par2", ",", 
             RowBox[{"par1", "[", 
              RowBox[{"[", 
               RowBox[{"Range", "[", "l2", "]"}], "]"}], "]"}]}], "}"}], 
           "]"}]}]}]}], ",", 
       RowBox[{"-", "1"}], ",", "\[IndentingNewLine]", "True", ",", "0"}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InclusionOrder", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "1"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData["1"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"InclusionOrder", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "1"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData["0"], "Output"]
}, Open  ]],

