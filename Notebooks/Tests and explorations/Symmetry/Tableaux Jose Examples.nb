Cell["3) Counting disjoint tableaux:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "NumberOfDisjointTableaux"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"NumberOfDisjointTableaux[par, set] returns the number of \
disjoint tableaux, of shape given by the partition par, that can be \
constructed onto the given set of labels. NumberOfDisjointTableaux[par, n] \
for a positive integer n is interpreted as NumberOfDisjointTableaux[par, \
Range[n]]. NumberOfDisjointTableaux[par] is interpreted as \
NumberOfDisjointTableaux[par, Total[par]].\"\>", 
  "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442101-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfDisjointTableaux", "[", 
    RowBox[{"par", ":", 
     RowBox[{"{", "___Integer", "}"}]}], "]"}], ":=", 
   RowBox[{"NumberOfDisjointTableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Total", "@", "par"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfDisjointTableaux", "[", 
    RowBox[{
     RowBox[{"par", ":", 
      RowBox[{"{", "___Integer", "}"}]}], ",", "labels_List"}], "]"}], ":=", 
   RowBox[{"NumberOfDisjointTableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Length", "@", 
      RowBox[{"LabelsSort", "[", "labels", "]"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"NumberOfDisjointTableaux", "[", 
    RowBox[{
     RowBox[{"par", ":", 
      RowBox[{"{", "___Integer", "}"}]}], ",", 
     RowBox[{"dim_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", "=", 
       RowBox[{"Total", "[", "par", "]"}]}], "}"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"dim", "<", "n"}], ",", "0", ",", 
       RowBox[{
        RowBox[{"dim", "!"}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"dim", "-", "n"}], ")"}], "!"}]}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"NumberOfDisjointTableaux", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "NumberOfDisjointTableaux", "]"}], ";"}]}], "Input",
 
 InitializationCell->True],

