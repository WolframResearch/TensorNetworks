Cell["\<\
4) For the RKS correspondence, it is interesting to keep track of the \
positions where the different labels have been inserted. This is done with an \
\"insertion tableau\", also called a \[OpenCurlyDoubleQuote]recording tableau\
\[CloseCurlyDoubleQuote]. This function takes two semistandard tableaux (the \
first with arbitrary labels, and the second with slot labels), assumed to \
have the same shape and RowBump the label in the first and modify the second \
to keep track of the routes:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RowBumpInsert", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tab_Tableau", "?", "SemistandardTableauQ"}], ",", 
       RowBox[{"instab_Tableau", "?", "SemistandardTableauQ"}]}], "}"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"label_", ",", "step_Integer"}], "}"}], ",", 
     RowBox[{"row_:", "1"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"col", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"row", "\[LessEqual]", 
            RowBox[{"Length", "[", "tab", "]"}]}], ",", 
           RowBox[{"ColumnOfStrictlyLarger", "[", 
            RowBox[{
             RowBox[{"tab", "[", 
              RowBox[{"[", "row", "]"}], "]"}], ",", "label"}], "]"}], ",", 
           "0"}], "]"}]}], ",", 
        RowBox[{"trinstab", "=", 
         RowBox[{"TransposeTableau", "[", "instab", "]"}]}]}], "}"}], ",", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"col", "===", "0"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Append", "[", 
           RowBox[{"tab", ",", 
            RowBox[{"{", "label", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
          
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"trinstab", "===", 
             RowBox[{"Tableau", "[", "]"}]}], ",", 
            RowBox[{"Tableau", "[", 
             RowBox[{"{", "step", "}"}], "]"}], ",", 
            RowBox[{"TransposeTableau", "@", 
             RowBox[{"MapAt", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Append", "[", 
                 RowBox[{"#", ",", "step"}], "]"}], "&"}], ",", "trinstab", 
               ",", "1"}], "]"}]}]}], "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"col", ">", 
         RowBox[{"Length", "[", 
          RowBox[{"tab", "[", 
           RowBox[{"[", "row", "]"}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"MapAt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Append", "[", 
              RowBox[{"#", ",", "label"}], "]"}], "&"}], ",", "tab", ",", 
            "row"}], "]"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"col", ">", 
             RowBox[{"Length", "[", "trinstab", "]"}]}], ",", 
            RowBox[{"TransposeTableau", "@", 
             RowBox[{"Append", "[", 
              RowBox[{"trinstab", ",", 
               RowBox[{"{", "step", "}"}]}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"TransposeTableau", "@", 
             RowBox[{"MapAt", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Append", "[", 
                 RowBox[{"#", ",", "step"}], "]"}], "&"}], ",", "trinstab", 
               ",", "col"}], "]"}]}]}], "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", "True", ",", "\[IndentingNewLine]", 
        RowBox[{"RowBumpInsert", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ReplacePart", "[", 
             RowBox[{"tab", ",", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"row", ",", "col"}], "}"}], "\[Rule]", "label"}]}], 
             "]"}], ",", "instab"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"tab", "[", 
             RowBox[{"[", 
              RowBox[{"row", ",", "col"}], "]"}], "]"}], ",", "step"}], "}"}],
           ",", 
          RowBox[{"row", "+", "1"}]}], "]"}]}], "\[IndentingNewLine]", 
       "]"}]}], "\[IndentingNewLine]", "]"}], "/;", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Length", "/@", "tab"}], ")"}], "===", 
      RowBox[{"(", 
       RowBox[{"Length", "/@", "instab"}], ")"}]}], "&&", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Union", "@@", "instab"}], "\[Equal]", 
       RowBox[{"Range", "[", 
        RowBox[{"Max", "[", 
         RowBox[{"0", ",", 
          RowBox[{"Sequence", "@@", "instab"}]}], "]"}], "]"}]}], ")"}]}]}]}],
   ";"}]], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
5.2. Sliding and the \[OpenCurlyDoubleQuote]jeu de taquin\
\[CloseCurlyDoubleQuote]\
\>", "Subsubsection"],

Cell["\<\
Recall that an \[OpenCurlyDoubleQuote]inner corner\[CloseCurlyDoubleQuote] is \
a Skew box whose right and lower neighbours are not Skew. An \
\[OpenCurlyDoubleQuote]outer corner\[CloseCurlyDoubleQuote] is a normal box \
with neither a right nor a lower neightbours.\
\>", "Text"],

Cell["\<\
1) The sliding algorithm takes a skew semistandard tableau and removes one \
Skew box:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "SkewTableauSlide"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"SkewTableauSlide[skewtab] removes the last Skew box of the \
skew tableau skewtab, using the sliding algorithm.\"\>", 
  "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442389-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SkewTableuSlide", "[", "tab_Tableau", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"TableauSlide1", "[", 
    RowBox[{"tab", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"#", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"Last", "[", "#", "]"}]}], "]"}], "&"}], "@", 
      RowBox[{"PartitionCorners", "[", 
       RowBox[{"SkewPartition", "[", "tab", "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TableauSlide1", "[", 
    RowBox[{"tab_", ",", 
     RowBox[{"{", "}"}]}], "]"}], ":=", "tab"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TableauSlide1", "[", 
    RowBox[{"tab_", ",", "corner_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"TableauSlide2", "[", 
     RowBox[{"tab", ",", "corner"}], "]"}], "/;", 
    RowBox[{
     RowBox[{"Extract", "[", 
      RowBox[{"tab", ",", "corner"}], "]"}], "===", "Skew"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TableauSlide2", "[", 
    RowBox[{"tab_", ",", 
     RowBox[{"{", 
      RowBox[{"row_", ",", "column_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"TableauSlide3", "[", 
    RowBox[{"tab", ",", 
     RowBox[{"{", 
      RowBox[{"row", ",", "column"}], "}"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{
          RowBox[{"TransposeTableau", "[", "tab", "]"}], "[", 
          RowBox[{"[", "column", "]"}], "]"}], "]"}], ">", "row"}], ",", 
       RowBox[{"tab", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"row", "+", "1"}], ",", "column"}], "]"}], "]"}], ",", 
       "Null"}], "]"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"tab", "[", 
          RowBox[{"[", "row", "]"}], "]"}], "]"}], ">", "column"}], ",", 
       RowBox[{"tab", "[", 
        RowBox[{"[", 
         RowBox[{"row", ",", 
          RowBox[{"column", "+", "1"}]}], "]"}], "]"}], ",", "Null"}], 
      "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TableauSlide3", "[", 
    RowBox[{"tab_", ",", 
     RowBox[{"{", 
      RowBox[{"row_", ",", "column_"}], "}"}], ",", "Null", ",", "Null"}], 
    "]"}], ":=", 
   RowBox[{"MapAt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Drop", "[", 
       RowBox[{"#", ",", 
        RowBox[{"-", "1"}]}], "]"}], "&"}], ",", "tab", ",", "row"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TableauSlide3", "[", 
    RowBox[{"tab_", ",", 
     RowBox[{"{", 
      RowBox[{"row_", ",", "column_"}], "}"}], ",", "below_", ",", "Null"}], 
    "]"}], ":=", 
   RowBox[{"TableauSlide2", "[", 
    RowBox[{
     RowBox[{"ReplacePart", "[", 
      RowBox[{"tab", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"row", ",", "column"}], "}"}], "\[Rule]", "below"}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"row", "+", "1"}], ",", "column"}], "}"}], "\[Rule]", 
          "Skew"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"row", "+", "1"}], ",", "column"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TableauSlide3", "[", 
    RowBox[{"tab_", ",", 
     RowBox[{"{", 
      RowBox[{"row_", ",", "column_"}], "}"}], ",", "Null", ",", "right_"}], 
    "]"}], ":=", 
   RowBox[{"TableauSlide2", "[", 
    RowBox[{
     RowBox[{"ReplacePart", "[", 
      RowBox[{"tab", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"row", ",", "column"}], "}"}], "\[Rule]", "right"}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"row", ",", 
            RowBox[{"column", "+", "1"}]}], "}"}], "\[Rule]", "Skew"}]}], 
        "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"row", ",", 
       RowBox[{"column", "+", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TableauSlide3", "[", 
    RowBox[{"tab_", ",", 
     RowBox[{"{", 
      RowBox[{"row_", ",", "column_"}], "}"}], ",", "below_", ",", "right_"}],
     "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"OrderedQ", "[", 
      RowBox[{"{", 
       RowBox[{"below", ",", "right"}], "}"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"TableauSlide2", "[", 
      RowBox[{
       RowBox[{"ReplacePart", "[", 
        RowBox[{"tab", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"row", ",", "column"}], "}"}], "\[Rule]", "below"}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"row", "+", "1"}], ",", "column"}], "}"}], "\[Rule]", 
            "Skew"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"row", "+", "1"}], ",", "column"}], "}"}]}], "]"}], ",", 
     RowBox[{"TableauSlide2", "[", 
      RowBox[{
       RowBox[{"ReplacePart", "[", 
        RowBox[{"tab", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"row", ",", "column"}], "}"}], "\[Rule]", "right"}], ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"row", ",", 
              RowBox[{"column", "+", "1"}]}], "}"}], "\[Rule]", "Skew"}]}], 
          "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"row", ",", 
         RowBox[{"column", "+", "1"}]}], "}"}]}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input"],

