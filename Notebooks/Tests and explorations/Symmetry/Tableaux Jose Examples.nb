Cell["\<\
Then the Schur polynomial is the sum of all those corresponding monomials. \
Note how nicely the notations of SemistandardTableaux and SchurPolynomial fit:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{"TableauMonomial", "/@", "%"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["x1", "3"], " ", 
   SuperscriptBox["x2", "2"], " ", "x3"}], "+", 
  RowBox[{
   SuperscriptBox["x1", "2"], " ", 
   SuperscriptBox["x2", "3"], " ", "x3"}], "+", 
  RowBox[{
   SuperscriptBox["x1", "3"], " ", "x2", " ", 
   SuperscriptBox["x3", "2"]}], "+", 
  RowBox[{"2", " ", 
   SuperscriptBox["x1", "2"], " ", 
   SuperscriptBox["x2", "2"], " ", 
   SuperscriptBox["x3", "2"]}], "+", 
  RowBox[{"x1", " ", 
   SuperscriptBox["x2", "3"], " ", 
   SuperscriptBox["x3", "2"]}], "+", 
  RowBox[{
   SuperscriptBox["x1", "2"], " ", "x2", " ", 
   SuperscriptBox["x3", "3"]}], "+", 
  RowBox[{"x1", " ", 
   SuperscriptBox["x2", "2"], " ", 
   SuperscriptBox["x3", "3"]}]}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"%", "===", 
  RowBox[{"Expand", "@", 
   RowBox[{"SchurPolynomial", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"3", ",", "2", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "]"}]}]}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell["\<\
There is a strange identity with Schur polynomials in page 52 of Fulton's \
book, equation (3). I don\[CloseCurlyQuote]t know how to interpret it. Anothe \
strange identity is given in page 56, exercise 14.\
\>", "Text"],

Cell[TextData[{
 "Two fundamental results for the tableau ring:\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["S", "\[Lambda]"], "\[CenterDot]", " ", 
     SubscriptBox["S", "\[Mu]"]}], "=", 
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "\[Nu]"], 
     SubscriptBox[
      SuperscriptBox[
       SubscriptBox["c", "\[Lambda]"], "\[Nu]"], "\[Mu]"], " ", 
     SubscriptBox["S", "\[Nu]"]}]}], TraditionalForm]]],
 "\n\t\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", 
     RowBox[{"\[Nu]", "/", "\[Lambda]"}]], "=", 
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "\[Mu]"], 
     SubscriptBox[
      SuperscriptBox[
       SubscriptBox["c", "\[Lambda]"], "\[Nu]"], "\[Mu]"], 
     SubscriptBox["S", "\[Mu]"]}]}], TraditionalForm]]]
}], "Text"],

Cell["\<\
Let us check some particular cases of the first identity:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"lambda", "=", 
  RowBox[{"RandomChoice", "[", 
   RowBox[{"IntegerPartitions", "[", "7", "]"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"mu", "=", 
  RowBox[{"RandomChoice", "[", 
   RowBox[{"IntegerPartitions", "[", "5", "]"}], "]"}]}]}], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "3", ",", "1"}], "}"}]], "Output"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "1", ",", "1"}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
This identity is valid for any list of variables (of any length) we put here:\
\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"Array", "[", 
    RowBox[{"x", ",", "8"}], "]"}]}], ";"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"SchurPolynomial", "[", 
      RowBox[{"lambda", ",", "vars"}], "]"}], 
     RowBox[{"SchurPolynomial", "[", 
      RowBox[{"mu", ",", "vars"}], "]"}]}], "-", 
    RowBox[{"Plus", "@@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#2", 
          RowBox[{"SchurPolynomial", "[", 
           RowBox[{"#1", ",", "vars"}], "]"}]}], "&"}], ")"}], "@@@", 
       RowBox[{"LRNumber", "[", 
        RowBox[{"lambda", ",", "mu"}], "]"}]}], ")"}]}]}], "//", "Expand"}], "//",
   "Timing"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "33.47590699999999941383066470734775066376`7.545332265946756", ",", "0"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell["\<\
For the second identity we need to generalize our definition of Schur \
polynomials to admit a pair of partitions (of a skew tableau).\
\>", "Text"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Plethysms", "Subsection",
 FontColor->RGBColor[0, 0, 1]],

Cell[CellGroupData[{

Cell["7.1. Plethysm", "Subsubsection"],

Cell[TextData[{
 "Following [",
 ButtonBox["Agaoka1",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://ir.lib.hiroshima-u.ac.jp/metadb/up/niikiyo/KJ00000197266.pdf"]\
, None},
  ButtonNote->
   "http://ir.lib.hiroshima-u.ac.jp/metadb/up/niikiyo/KJ00000197266.pdf"],
 "]. He gives tables up to degree 12, and apparently he has constructed \
tables up to degree 16 [",
 ButtonBox["Agaoka1bis",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://books.google.com/books/about/An_Algorithm_to_Calculate_\
Plethysms_of_S.html?id=KHMrGwAACAAJ"], None},
  ButtonNote->
   "http://books.google.com/books/about/An_Algorithm_to_Calculate_Plethysms_\
of_S.html?id=KHMrGwAACAAJ"],
 "]. His sigma is PowerSumSymmetricPolynomial. His p is \
CompleteHomogeneousSymmetricPolynomial. See also [",
 ButtonBox["Iijima",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://arxiv.org/pdf/1108.4915.pdf"], None},
  ButtonNote->"http://arxiv.org/pdf/1108.4915.pdf"],
 "] and [",
 ButtonBox["Agaoka2",
  BaseStyle->"Hyperlink",
  ButtonData->{
    FrontEnd`FileName[{"http://www.mis.hiroshima-u.ac.jp", "techrep"}, 
     "Tr91.ps", CharacterEncoding -> "UTF-8"], None}],
 "]."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"k", "=", "7"}], ",", 
      RowBox[{"vars", "=", 
       RowBox[{"{", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}]}], "}"}], 
    ",", 
    RowBox[{
     RowBox[{"PowerSumSymmetricPolynomial", "[", 
      RowBox[{"k", ",", "vars"}], "]"}], "+", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"PowerSumSymmetricPolynomial", "[", 
         RowBox[{"i", ",", "vars"}], "]"}], 
        RowBox[{"CompleteHomogeneousSymmetricPolynomial", "[", 
         RowBox[{
          RowBox[{"k", "-", "i"}], ",", "vars"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}], "-", 
     RowBox[{"k", " ", 
      RowBox[{"CompleteHomogeneousSymmetricPolynomial", "[", 
       RowBox[{"k", ",", "vars"}], "]"}]}]}]}], "]"}], "//", 
  "Expand"}]], "Input"],

Cell[BoxData["0"], "Output"]
}, Open  ]],

Cell["\<\
Note that we do not need to use SchurPolynomial here.\
\>", "Text"],

Cell["\<\
This implements first Giambelli' s formula, where the p stands formally for \
the CompleteHomogeneousSymmetricPolynomial.\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"schur", "[", 
   RowBox[{"p_", ",", "partition_"}], "]"}], ":=", 
  RowBox[{"Expand", "@", 
   RowBox[{"Det", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"p", "[", 
       RowBox[{
        RowBox[{"partition", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "+", "j", "-", "i"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "partition", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"Length", "[", "partition", "]"}]}], "}"}]}], 
     "]"}]}]}]}]], "Input",
 InitializationCell->True],

Cell["\<\
This is the main algorithm, based on the use, back and forth, of Giambelli' s \
formula. Note that p and ss are temporary pointers storing remembered values. \
However pp and s are global symbols used to localize objects.\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Plethysm", "[", 
    RowBox[{"Lpar_Plus", ",", 
     RowBox[{"head_", "[", "m_Integer", "]"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"terms", "=", 
       RowBox[{"List", "@@", "Lpar"}]}], "}"}], ",", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"Inner", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Plethysm", "[", 
           RowBox[{"#1", ",", 
            RowBox[{"{", "#2", "}"}]}], "]"}], "&"}], ",", "terms", ",", 
         "par", ",", "LRProduct"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"par", ",", 
         RowBox[{"permpartitions", "[", 
          RowBox[{"m", ",", 
           RowBox[{"Length", "[", "terms", "]"}]}], "]"}]}], "}"}]}], "]"}]}],
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Plethysm", "[", 
    RowBox[{
     RowBox[{"coeff_", " ", "par_Tableau"}], ",", 
     RowBox[{"head_", "[", "m_Integer", "]"}]}], "]"}], ":=", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"coeff", "^", "m"}], " ", 
     RowBox[{"Plethysm", "[", 
      RowBox[{"par", ",", 
       RowBox[{"head", "[", "m", "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Plethysm", "[", 
    RowBox[{"par_Tableau", ",", 
     RowBox[{"_", "[", "0", "]"}]}], "]"}], ":=", 
   RowBox[{"Tableau", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Plethysm", "[", 
    RowBox[{"Lpar_", ",", 
     RowBox[{"_", "[", "1", "]"}]}], "]"}], ":=", "Lpar"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Plethysm", "[", 
    RowBox[{"Lpar_", ",", "Rpar_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", "ss"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "[", "0", "]"}], "=", "1"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"p", "[", "k_", "]"}], ":=", 
        RowBox[{
         RowBox[{"p", "[", "k", "]"}], "=", 
         RowBox[{"Expand", "[", 
          RowBox[{
           RowBox[{"1", "/", "k"}], " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"p", "[", "i", "]"}], 
              RowBox[{"s", "[", 
               RowBox[{"k", "-", "i"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "0", ",", 
               RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"pp", "[", "0", "]"}], ":=", "1"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"pp", "[", 
         RowBox[{"k_Integer", "?", "Negative"}], "]"}], ":=", "0"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ss", "[", "k_", "]"}], ":=", 
        RowBox[{
         RowBox[{"ss", "[", "k", "]"}], "=", 
         RowBox[{"Expand", "[", 
          RowBox[{
           RowBox[{"k", " ", 
            RowBox[{"pp", "[", "k", "]"}]}], "-", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ss", "[", "i", "]"}], 
              RowBox[{"pp", "[", 
               RowBox[{"k", "-", "i"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"iteraterepartition", "[", 
        RowBox[{"Expand", "[", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{
            RowBox[{"schur", "[", 
             RowBox[{"p", ",", "Rpar"}], "]"}], "/.", 
            RowBox[{
             RowBox[{"s", "[", "k_", "]"}], "\[RuleDelayed]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"schur", "[", 
                RowBox[{"p", ",", "Lpar"}], "]"}], "/.", 
               RowBox[{
                RowBox[{"s", "[", "n_", "]"}], "\[Rule]", 
                RowBox[{"s", "[", 
                 RowBox[{"k", " ", "n"}], "]"}]}]}], ")"}]}]}], "]"}], "/.", 
          RowBox[{"s", "\[Rule]", "ss"}]}], "]"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}], "/;", "$ActivateComputations"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"Plethysm", ",", "2"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "Plethysm", "]"}], ";"}]}], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  RowBox[{"MakeBoxes", "[", 
   RowBox[{
    RowBox[{"Plethysm", "[", 
     RowBox[{"Lpar_", ",", "Rpar_"}], "]"}], ",", "StandardForm"}], "]"}], ":=", 
  RowBox[{"SuperscriptBox", "[", 
   RowBox[{
    RowBox[{"MakeBoxes", "[", 
     RowBox[{"Lpar", ",", "StandardForm"}], "]"}], ",", 
    RowBox[{"RowBox", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<\[CircleTimes]\>\"", ",", 
       RowBox[{"MakeBoxes", "[", 
        RowBox[{"Rpar", ",", "StandardForm"}], "]"}]}], "}"}], "]"}]}], 
   "]"}]}]], "Input",
 InitializationCell->True],

Cell["\<\
Decompose m in weak decompositions of exactly n numbers (including 0):\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"permpartitions", "[", 
    RowBox[{"m_Integer", ",", "n_Integer"}], "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Permutations", "/@", 
      RowBox[{"IntegerPartitions", "[", 
       RowBox[{"m", ",", 
        RowBox[{"{", "n", "}"}], ",", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "m"}], "]"}]}], "]"}]}], ",", "1"}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->True],

Cell["\<\
These functions are in charge of the second part of the algorithm, \
reconstructing the partitions from the symmetric polynomials.\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"repart", "[", "expr_Times", "]"}], ":=", 
   RowBox[{"Reverse", "@", 
    RowBox[{"Sort", "@", 
     RowBox[{"Flatten", "[", 
      RowBox[{"repart", "/@", 
       RowBox[{"Tableau", "@@", "expr"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"repart", "[", 
    RowBox[{"pp", "[", "k_", "]"}], "]"}], ":=", 
   RowBox[{"Tableau", "[", "k", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"repart", "[", 
   RowBox[{"Power", "[", 
    RowBox[{
     RowBox[{"pp", "[", "k_", "]"}], ",", "n_"}], "]"}], "]"}], ":=", 
  RowBox[{"Tableau", "@@", 
   RowBox[{"Table", "[", 
    RowBox[{"k", ",", 
     RowBox[{"{", "n", "}"}]}], "]"}]}]}]}], "Input",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"repartition", "[", 
    RowBox[{"expr_", " ", "k_Integer"}], "]"}], ":=", 
   RowBox[{"k", " ", 
    RowBox[{"repartition", "[", "expr", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"repartition", "[", "expr_", "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"diagram", "=", 
      RowBox[{"repart", "[", "expr", "]"}]}], "}"}], ",", 
    RowBox[{"diagram", "+", "expr", "-", 
     RowBox[{"schur", "[", 
      RowBox[{"pp", ",", 
       RowBox[{"List", "@@", "diagram"}]}], "]"}]}]}], "]"}]}]}], "Input",
 InitializationCell->True],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"iteraterepartition", "[", "1", "]"}], ":=", 
   RowBox[{"Tableau", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"iteraterepartition", "[", "expr_Tableau", "]"}], ":=", "expr"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"iteraterepartition", "[", 
    RowBox[{"expr_Tableau", " ", "k_Integer"}], "]"}], ":=", 
   RowBox[{"k", " ", "expr"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"iteraterepartition", "[", "expr_Plus", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Head", "[", 
      RowBox[{"First", "[", "expr", "]"}], "]"}], "=!=", "Tableau"}], ",", 
    RowBox[{"iteraterepartition", "@", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"repartition", "[", 
        RowBox[{"First", "[", "expr", "]"}], "]"}], "+", 
       RowBox[{"Rest", "[", "expr", "]"}]}], "]"}]}], ",", "expr"}], 
   "]"}]}]}], "Input",
 InitializationCell->True],

Cell[TextData[{
 "There is a technical detail: we assume that the order of polynomials p \
mentioned in Agaoka's paper coincide with the standard ordering rules of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". That is why we use the decomposition First/Rest in iteraterepartion. \
Experimentally it works well."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"$ActivateComputations", "=", "True"}]], "Input",
 InitializationCell->True],

Cell[BoxData["True"], "Output"]
}, Open  ]]
}, Closed]],

