Cell[BoxData["False"], "Output"]
}, Open  ]],

Cell["\<\
2) This command constructs a tableau from a partition of the number of \
indices. It can be also understood as a normal-numbered form of a Young \
diagram.\
\>", "Text"],

Cell[TextData[{
 "QUESTION : Do we need this function? I find it too simple, and actually it \
is never used in the rest of the package. Note also that this is identical to \
FirstLexicographicStandardTableau, taken from ",
 StyleBox["Combinatorica`.",
  FontSlant->"Italic"]
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "TableauOfPartition"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"TableauOfPartition[part] returns a filled Tableau constructed \
from part which is the partition of a natural number. The entries of this \
tableau are the natural numbers sorted in their canonical order when reading \
the tableau from left to right\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442162-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"row", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"___", ",", "m_"}], "}"}], ",", "n_"}], "]"}], ":=", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"m", "+", "1"}], ",", 
     RowBox[{"m", "+", "n"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TableauOfPartition", "[", 
    RowBox[{"par", ":", 
     RowBox[{"{", "___Integer", "}"}]}], "]"}], ":=", 
   RowBox[{"Apply", "[", 
    RowBox[{"Tableau", ",", 
     RowBox[{"Rest", "@", 
      RowBox[{"FoldList", "[", 
       RowBox[{"row", ",", 
        RowBox[{"{", "0", "}"}], ",", "par"}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"TableauOfPartition", ",", "1"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "TableauOfPartition", "]"}], ";"}]}], "Input",
 InitializationCell->True],

Cell["\<\
3) There is nothing to compute here concerning numbers of these objects, \
because there is one normal tableau per partition.\
\>", "Text"],

