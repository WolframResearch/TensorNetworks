  RowBox[{"x2", " ", 
   SuperscriptBox["x3", "3"]}], "+", 
  SuperscriptBox["x3", "4"]}]], "Output"]
}, Open  ]],

Cell["Well known identities :", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
