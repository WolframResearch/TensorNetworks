Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TableauToYVector", "[", "tb_Tableau", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"y", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"1", ",", 
          RowBox[{"{", 
           RowBox[{"Length", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{"List", "@@", "tb"}], "]"}], "]"}], "}"}]}], "]"}]}]}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Scan", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"y", "[", 
              RowBox[{"[", "#", "]"}], "]"}], "=", "i"}], ")"}], "&"}], ",", 
          RowBox[{"tb", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2", ",", 
          RowBox[{"Length", "[", "tb", "]"}]}], "}"}]}], "]"}], ";", "y"}]}], 
    "]"}]}], ";"}]], "Input",
 InitializationCell->True],

Cell["\<\
This function generates the previous standard tableau with the same shape. \
When reaching the first one, it gives the last one again. The function \
assumes that there are at least two labels in the tableau, and hence we need \
a special definition:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PreviousStandardTableau", "[", 
    RowBox[{"Tableau", "[", 
     RowBox[{"{", "1", "}"}], "]"}], "]"}], ":=", 
   RowBox[{"Tableau", "[", 
    RowBox[{"{", "1", "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PreviousStandardTableau", "[", "tb_Tableau", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", ",", "y", ",", "row", ",", "j", ",", 
       RowBox[{"count", "=", "0"}], ",", "tj", ",", "i", ",", 
       RowBox[{"n", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"List", "@@", "tb"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"y", "=", 
       RowBox[{"TableauToYVector", "[", "tb", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"j", "=", "2"}], ",", 
        RowBox[{
         RowBox[{"j", "<", "n"}], "&&", 
         RowBox[{
          RowBox[{"y", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}],
           "\[GreaterEqual]", 
          RowBox[{"y", "\[LeftDoubleBracket]", 
           RowBox[{"j", "-", "1"}], "\[RightDoubleBracket]"}]}]}], ",", 
        RowBox[{"j", "++"}], ",", "Null"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
         "\[GreaterEqual]", 
         RowBox[{"y", "\[LeftDoubleBracket]", 
          RowBox[{"j", "-", "1"}], "\[RightDoubleBracket]"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"LastLexicographicStandardTableau", "[", 
          RowBox[{"List", "@@", 
           RowBox[{"(", 
            RowBox[{"Length", "/@", "tb"}], ")"}]}], "]"}], "]"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"Length", "/@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{
            "tb", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
            RowBox[{
             RowBox[{"#1", "\[LessEqual]", "j"}], "&"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "tb", "]"}]}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "row", "}"}], "=", 
       RowBox[{"Last", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"s", ",", 
          RowBox[{"s", "\[LeftDoubleBracket]", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"tb", ",", "j"}], "]"}], "\[LeftDoubleBracket]", 
             RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], "+", "1"}], 
           "\[RightDoubleBracket]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"s", "\[LeftDoubleBracket]", "row", "\[RightDoubleBracket]"}], 
       "--"}], ";", "\[IndentingNewLine]", 
      RowBox[{"tj", "=", 
       RowBox[{"LastLexicographicStandardTableau", "[", "s", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "tj", "]"}], "<", "row"}], ",", 
        RowBox[{"tj", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"tj", ",", 
           RowBox[{"{", "j", "}"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{
         "tj", "\[LeftDoubleBracket]", "row", "\[RightDoubleBracket]"}], "=", 
         
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{
           "tj", "\[LeftDoubleBracket]", "row", "\[RightDoubleBracket]"}], 
           ",", "j"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Tableau", "@@", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{
             "tj", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             ",", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{
               "tb", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
               ",", 
               RowBox[{
                RowBox[{"#1", ">", "j"}], "&"}]}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "tj", "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
           "tb", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{
              RowBox[{"Length", "[", "tj", "]"}], "+", "1"}], ",", 
             RowBox[{"Length", "[", "tb", "]"}]}], "}"}]}], "]"}]}], 
        "\[IndentingNewLine]", "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 InitializationCell->True],

Cell["This is the needed function:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "StandardTableaux"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"StandardTableaux[par, set] returns the list of all standard \
tableaux, of shape given by the partition par, that can be constructed onto \
the given set of labels. StandardTableaux[par, n] for a positive integer n is \
interpreted as StandardTableaux[par, Range[n]]. StandardTableaux[par] is \
interpreted as StandardTableaux[par, Total[par]]. StandardTableaux[n] returns \
the list of all possible standard tableaux corresponding to the partitions of \
the integer n.\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442116-9818602"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Special", " ", "definitions", " ", "from", " ", "a", " ", "problem", " ", 
    "in", " ", "PreviousTableau"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"StandardTableaux", "[", 
      RowBox[{"{", "}"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{"Tableau", "[", "]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"StandardTableaux", "[", 
      RowBox[{"{", "n_Integer", "}"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{"Tableau", "[", 
       RowBox[{"Range", "[", "n", "]"}], "]"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Added", " ", "Sort", " ", "to", " ", "bring", " ", "the", " ", "sorting",
      " ", "rules", " ", "to", " ", 
     RowBox[{"Mathematica", "'"}], "s", " ", "default"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"StandardTableaux", "[", 
      RowBox[{"par", ":", 
       RowBox[{"{", "__Integer", "}"}]}], "]"}], ":=", 
     RowBox[{"Sort", "@", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", "=", 
          RowBox[{"FirstLexicographicStandardTableau", "[", "par", "]"}]}], 
         "}"}], ",", 
        RowBox[{"Reverse", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"t", "=", 
            RowBox[{"PreviousStandardTableau", "[", "t", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"NumberOfStandardTableaux", "[", "par", "]"}], "}"}]}], 
          "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"StandardTableaux", "[", "n_Integer", "]"}], ":=", 
     RowBox[{"Apply", "[", 
      RowBox[{"Join", ",", 
       RowBox[{"StandardTableaux", "/@", 
        RowBox[{"IntegerPartitions", "[", "n", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "With", " ", "a", " ", "nondefault", " ", "set", " ", "of", " ", 
     "labels"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ChangeLabels", "[", 
      RowBox[{"expr_", ",", "labels1_", ",", "labels2_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Sort", "@", 
       RowBox[{"Flatten", "[", 
        RowBox[{"expr", "/.", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{"labels1", "\[Rule]", "#"}], "]"}], "&"}], ",", 
           RowBox[{"Subsets", "[", 
            RowBox[{"labels2", ",", 
             RowBox[{"{", 
              RowBox[{"Length", "@", "labels1"}], "}"}]}], "]"}]}], "]"}]}], 
        "]"}]}], "/;", 
      RowBox[{
       RowBox[{"Length", "[", "labels2", "]"}], "\[GreaterEqual]", 
       RowBox[{"Length", "[", "labels1", "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"StandardTableaux", "[", 
      RowBox[{
       RowBox[{"par", ":", 
        RowBox[{"{", "___Integer", "}"}]}], ",", 
       RowBox[{"dim_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
     RowBox[{"StandardTableaux", "[", 
      RowBox[{"par", ",", 
       RowBox[{"Range", "[", "dim", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"StandardTableaux", "[", 
      RowBox[{
       RowBox[{"par", ":", 
        RowBox[{"{", "___Integer", "}"}]}], ",", "labels_List"}], "]"}], ":=", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"Total", "[", "par", "]"}]}], ",", 
         RowBox[{"slabels", "=", 
          RowBox[{"LabelsSort", "[", "labels", "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", ">", 
          RowBox[{"Length", "[", "slabels", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"ChangeLabels", "[", 
          RowBox[{
           RowBox[{"StandardTableaux", "[", "par", "]"}], ",", 
           RowBox[{"Range", "[", "n", "]"}], ",", "slabels"}], "]"}]}], 
        "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"StandardTableaux", "[", 
      RowBox[{"n_Integer", ",", 
       RowBox[{"dim_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
