Cell["\<\
3) Here we give the simple formula which computes the number of those \
standard tableaux corresponding to a given partition and a given set of \
labels (Fulton says this was given by Frame, Robinson and Thrall, at least \
for the case dim=n):\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "NumberOfStandardTableaux"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"NumberOfStandardTableaux[par, set] returns the number of \
standard tableaux, of shape given by the partition par, that can be \
constructed onto the given set of labels. NumberOfStandardTableaux[par, n] \
for a positive integer n is interpreted as NumberOfStandardTableaux[par, \
Range[n]]. NumberOfStandardTableaux[par] is interpreted as \
NumberOfStandardTableaux[par, Total[par]]. NumberOfStandardTableaux[n] \
returns the number of standard tableaux corresponding to all partitions of \
the integer n.\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442116-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfStandardTableaux", "[", 
    RowBox[{"par", ":", 
     RowBox[{"{", "___Integer", "}"}]}], "]"}], ":=", 
   RowBox[{"NumberOfStandardTableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Total", "[", "par", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfStandardTableaux", "[", 
    RowBox[{
     RowBox[{"par", ":", 
      RowBox[{"{", "___Integer", "}"}]}], ",", "labels_List"}], "]"}], ":=", 
   RowBox[{"NumberOfStandardTableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Length", "[", 
      RowBox[{"LabelsSort", "[", "labels", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfStandardTableaux", "[", 
    RowBox[{
     RowBox[{"par", ":", 
      RowBox[{"{", "___Integer", "}"}]}], ",", 
     RowBox[{"dim_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", "=", 
       RowBox[{"Total", "[", "par", "]"}]}], "}"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"dim", "<", "n"}], ",", "0", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"dim", "!"}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"dim", "-", "n"}], ")"}], "!"}]}], " ", 
        RowBox[{"HookFactor", "[", "par", "]"}]}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfStandardTableaux", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{"NumberOfStandardTableaux", "/@", 
     RowBox[{"IntegerPartitions", "[", "n", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfStandardTableaux", "[", 
    RowBox[{"n_Integer", ",", "labels_"}], "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"NumberOfStandardTableaux", "[", 
       RowBox[{"#", ",", "labels"}], "]"}], "&"}], "/@", 
     RowBox[{"IntegerPartitions", "[", "n", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"NumberOfStandardTableaux", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "NumberOfStandardTableaux", "]"}], ";"}]}], "Input",
 
 InitializationCell->True],

