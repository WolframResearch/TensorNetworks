   RowBox[{"LexicographicOrder", "[", 
    RowBox[{"par1_List", ",", "par2_List"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", "=", 
       RowBox[{"Max", "[", 
