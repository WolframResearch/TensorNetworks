     RowBox[{"PowerSumSymmetricPolynomial", "::", "usage"}], "=", 
     "\"\<\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CompleteHomogeneousSymmetricPolynomial", "::", "usage"}], "=", 
     "\"\<\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SchurPolynomial", "::", "usage"}], "=", "\"\<\>\""}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Plethysm", "::", "usage"}], "=", "\"\<\>\""}], 
    ";"}]}]}]], "Input",
 InitializationCell->True]
}, Closed]],

