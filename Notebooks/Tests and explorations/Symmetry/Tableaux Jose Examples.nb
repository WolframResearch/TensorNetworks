      RowBox[{"y", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tR", "=", 
   RowBox[{"Tableau", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "a"}], "}"}], ",", 
     RowBox[{"{", "b", "}"}]}], "]"}]}], ";"}]}], "Input"],

