Cell["\<\
6) Computations of LR numbers. We could tabulate the simplest cases.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "LRNumber"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"LRNumber[par1, par2, tpar] returns the Littlewood-Richardson \
number associated to the decomposition of the partition tpar as a product of \
par1 and par2.\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442788-8749065"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Trivial", " ", "cases"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"LRNumber", "[", 
      RowBox[{"lambda_", ",", "mu_", ",", "nu_"}], "]"}], ":=", 
     RowBox[{"0", "/;", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"PartitionQ", "[", "nu", "]"}]}], "||", 
       RowBox[{"!", 
        RowBox[{"PartitionQ", "[", "lambda", "]"}]}], "||", 
       RowBox[{"!", 
        RowBox[{"PartitionQ", "[", "mu", "]"}]}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LRNumber", "[", 
      RowBox[{"lambda_", ",", "mu_", ",", "nu_"}], "]"}], ":=", 
     RowBox[{"0", "/;", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", "lambda", "]"}], "+", 
        RowBox[{"Total", "[", "mu", "]"}]}], "=!=", 
       RowBox[{"Total", "[", "nu", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"LRNumber", "[", 
      RowBox[{"lambda_", ",", "mu_", ",", "nu_"}], "]"}], ":=", 
     RowBox[{"0", "/;", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"max", "=", 
          RowBox[{"Max", "@@", 
           RowBox[{"(", 
            RowBox[{"Length", "/@", 
             RowBox[{"{", 
              RowBox[{"nu", ",", "lambda", ",", "mu"}], "}"}]}], ")"}]}]}], 
         "}"}], ",", 
        RowBox[{
         RowBox[{"Or", "@@", 
          RowBox[{"Thread", "[", 
           RowBox[{"Less", "[", 
            RowBox[{
             RowBox[{"PadRight", "[", 
              RowBox[{"nu", ",", "max"}], "]"}], ",", 
             RowBox[{"PadRight", "[", 
              RowBox[{"lambda", ",", "max"}], "]"}]}], "]"}], "]"}]}], "||", 
         RowBox[{"Or", "@@", 
          RowBox[{"Thread", "[", 
           RowBox[{"Less", "[", 
            RowBox[{
             RowBox[{"PadRight", "[", 
              RowBox[{"nu", ",", "max"}], "]"}], ",", 
             RowBox[{"PadRight", "[", 
              RowBox[{"mu", ",", "max"}], "]"}]}], "]"}], "]"}]}]}]}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Specify", " ", "target", " ", "partition", " ", "nu"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LRNumber", "[", 
      RowBox[{"lambda_", ",", "mu_", ",", "nu_"}], "]"}], ":=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"LRrule", "[", 
        RowBox[{
         RowBox[{"First", "@", 
          RowBox[{"Tableaux", "[", 
           RowBox[{"lambda", ",", 
            RowBox[{"{", "Null", "}"}]}], "]"}]}], ",", 
         RowBox[{"First", "@", 
          RowBox[{"Tableaux", "[", 
           RowBox[{"mu", ",", 
            RowBox[{"{", "Null", "}"}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"First", "@", 
        RowBox[{"Tableaux", "[", 
         RowBox[{"nu", ",", 
          RowBox[{"{", "Null", "}"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"All", " ", "partitions"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LRNumber", "[", 
      RowBox[{"lambda_", ",", "mu_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"List", "@@", 
       RowBox[{"LRrule", "[", 
        RowBox[{
         RowBox[{"First", "@", 
          RowBox[{"Tableaux", "[", 
           RowBox[{"lambda", ",", 
            RowBox[{"{", "Null", "}"}]}], "]"}]}], ",", 
         RowBox[{"First", "@", 
          RowBox[{"Tableaux", "[", 
           RowBox[{"mu", ",", 
            RowBox[{"{", "Null", "}"}]}], "]"}]}]}], "]"}]}], "/.", 
      RowBox[{
       RowBox[{"c_.", " ", "tab_Tableau"}], "\[RuleDelayed]", 
       RowBox[{"Rule", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Length", "/@", 
           RowBox[{"List", "@@", "tab"}]}], ")"}], ",", "c"}], "]"}]}]}]}], 
    ";"}]}]}]], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"LRNumber", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}]}], "]"}], "//", "Column"}]], "Input"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{
      RowBox[{"{", 
       RowBox[{"4", ",", "4"}], "}"}], "\[Rule]", "1"}]},
    {
     RowBox[{
      RowBox[{"{", 
       RowBox[{"5", ",", "3"}], "}"}], "\[Rule]", "1"}]},
    {
     RowBox[{
      RowBox[{"{", 
       RowBox[{"3", ",", "3", ",", "2"}], "}"}], "\[Rule]", "1"}]},
    {
