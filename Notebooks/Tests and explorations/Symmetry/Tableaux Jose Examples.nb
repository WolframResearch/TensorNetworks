Cell[CellGroupData[{

Cell["6. Symmetric polynomials", "Subsection",
 FontColor->RGBColor[0, 0, 1]],

Cell[CellGroupData[{

Cell["\<\
6.1. ElementarySymmetricPolynomial\
\>", "Subsubsection"],

Cell["\<\
This should have been called ElementarySymmetricPolynomial, because there are \
many symmetric polynomials that are not this one:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SymmetricPolynomial", "[", 
  RowBox[{"4", ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5"}], "}"}]}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x1", " ", "x2", " ", "x3", " ", "x4"}], "+", 
  RowBox[{"x1", " ", "x2", " ", "x3", " ", "x5"}], "+", 
  RowBox[{"x1", " ", "x2", " ", "x4", " ", "x5"}], "+", 
  RowBox[{"x1", " ", "x3", " ", "x4", " ", "x5"}], "+", 
  RowBox[{"x2", " ", "x3", " ", "x4", " ", "x5"}]}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SymmetricPolynomial", "[", 
  RowBox[{"0", ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData["1"], "Output"]
}, Open  ]],

Cell["\<\
This is unfortunate. It should simply return 0:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SymmetricPolynomial", "[", 
  RowBox[{"3", ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"SymmetricPolynomial", "::", "hideg"}], "MessageName"], ":", 
  " ", "\<\"The degree \[NoBreak]\\!\\(3\\)\[NoBreak] of an elementary \
symmetric polynomial cannot be higher than the number of variables \[NoBreak]\
\\!\\({x1, x2}\\)\[NoBreak]. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", \
ButtonStyle->\\\"Link\\\", ButtonFrame->None, \
ButtonData:>\\\"paclet:ref/SymmetricPolynomial\\\", ButtonNote -> \
\\\"SymmetricPolynomial::hideg\\\"]\\)\"\>"}]], "Message", "MSG"],

Cell[BoxData[
 RowBox[{"SymmetricPolynomial", "[", 
  RowBox[{"3", ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}]}], "]"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SymmetricPolynomial", "[", 
  RowBox[{
   RowBox[{"-", "3"}], ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"SymmetricPolynomial", "::", "nmint"}], "MessageName"], ":", 
  " ", "\<\"\[NoBreak]\\!\\(-3\\)\[NoBreak] is not a non-negative machine \
integer. \\!\\(\\*ButtonBox[\\\"\[RightSkeleton]\\\", ButtonStyle->\\\"Link\\\
\", ButtonFrame->None, ButtonData:>\\\"paclet:ref/SymmetricPolynomial\\\", \
ButtonNote -> \\\"SymmetricPolynomial::nmint\\\"]\\)\"\>"}]], "Message", \
"MSG"],

Cell[BoxData[
 RowBox[{"SymmetricPolynomial", "[", 
  RowBox[{
   RowBox[{"-", "3"}], ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}]}], "]"}]], "Output"]
}, Open  ]],

Cell["\<\
We actually change it, because otherwise the standard identities do not hold:\
\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Unprotect", "[", "SymmetricPolynomial", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SymmetricPolynomial", "[", 
    RowBox[{"k_Integer", ",", "vars_List"}], "]"}], ":=", 
   RowBox[{"0", "/;", 
    RowBox[{"k", ">", 
     RowBox[{"Length", "[", "vars", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SymmetricPolynomial", "[", 
    RowBox[{
     RowBox[{"k_Integer", "?", "Negative"}], ",", "vars_List"}], "]"}], ":=", 
   "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "SymmetricPolynomial", "]"}], ";"}]}], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SymmetricPolynomial", "[", 
  RowBox[{"3", ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData["0"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SymmetricPolynomial", "[", 
  RowBox[{
   RowBox[{"-", "3"}], ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData["0"], "Output"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
6.2. PowerSumSymmetricPolynomial\
\>", "Subsubsection"],

Cell["Definition:", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PowerSumSymmetricPolynomial", "[", 
    RowBox[{"k_Integer", ",", "vars_List"}], "]"}], ":=", 
   RowBox[{"Apply", "[", 
    RowBox[{"Plus", ",", 
     RowBox[{"Power", "[", 
      RowBox[{"vars", ",", "k"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"PowerSumSymmetricPolynomial", ",", "2"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "PowerSumSymmetricPolynomial", "]"}], 
  ";"}]}], "Input",
 InitializationCell->True],

Cell["\<\
Is this the proper special case? Should it be 1?\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PowerSumSymmetricPolynomial", "[", 
  RowBox[{"0", ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5"}], "}"}]}], 
  "]"}]], "Input"],

Cell[BoxData["5"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PowerSumSymmetricPolynomial", "[", 
  RowBox[{"4", ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5"}], "}"}]}], 
  "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["x1", "4"], "+", 
  SuperscriptBox["x2", "4"], "+", 
  SuperscriptBox["x3", "4"], "+", 
  SuperscriptBox["x4", "4"], "+", 
  SuperscriptBox["x5", "4"]}]], "Output"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
6.3. CompleteHomogeneousSymmetricPolynomial\
\>", "Subsubsection"],

Cell["\<\
We need a stupid special definition for k=0, because the general code gives 0 \
instead of 1. That's ugly.\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CompleteHomogeneousSymmetricPolynomial", "[", 
    RowBox[{"0", ",", "vars_List"}], "]"}], ":=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CompleteHomogeneousSymmetricPolynomial", "[", 
    RowBox[{
     RowBox[{"k_Integer", "?", "Negative"}], ",", "vars_List"}], "]"}], ":=", 
   "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CompleteHomogeneousSymmetricPolynomial", "[", 
    RowBox[{
     RowBox[{"k_Integer", "?", "Positive"}], ",", "vars_List"}], "]"}], ":=", 
   
   RowBox[{"Plus", "@@", 
    RowBox[{"Apply", "[", 
     RowBox[{"Times", ",", 
      RowBox[{"RepeatedSubsets", "[", 
       RowBox[{"vars", ",", "k"}], "]"}], ",", 
      RowBox[{"{", "1", "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"CompleteHomogeneousSymmetricPolynomial", ",", "2"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "CompleteHomogeneousSymmetricPolynomial", "]"}], 
  ";"}]}], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CompleteHomogeneousSymmetricPolynomial", "[", 
  RowBox[{"4", ",", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["x1", "4"], "+", 
  RowBox[{
   SuperscriptBox["x1", "3"], " ", "x2"}], "+", 
  RowBox[{
   SuperscriptBox["x1", "2"], " ", 
   SuperscriptBox["x2", "2"]}], "+", 
  RowBox[{"x1", " ", 
   SuperscriptBox["x2", "3"]}], "+", 
  SuperscriptBox["x2", "4"], "+", 
