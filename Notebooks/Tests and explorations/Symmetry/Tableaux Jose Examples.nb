Cell[CellGroupData[{

Cell["3.7. Semistandard tableaux", "Subsubsection"],

Cell["\<\
1) A semistandard tableau is one in which labels are strictly increasing on \
any given column, and are non-decreasing (could be repeated) on any given row.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "SemistandardTableauQ"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"SemistandardTableauQ[tab] gives True if the labels of the \
Young tableau tab are sorted in each row and are sorted and different in each \
column. It returns False otherwise.\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442151-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SemistandardTableauQ", "[", 
    RowBox[{"tab", ":", 
     RowBox[{"Tableau", "[", "___List", "]"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"TableauQ", "[", "tab", "]"}], "&&", 
    RowBox[{"And", "@@", 
     RowBox[{"(", 
      RowBox[{"OrderedQ", "/@", "tab"}], ")"}]}], "&&", 
    RowBox[{"And", "@@", 
     RowBox[{"(", 
      RowBox[{"UnsameOrderedQ", "/@", 
       RowBox[{"transpose", "[", "tab", "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SemistandardTableauQ", "[", "_", "]"}], ":=", "False"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"SemistandardTableauQ", ",", "1"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "SemistandardTableauQ", "]"}], ";"}]}], "Input",
 InitializationCell->True],

Cell["\<\
It is helpful below to use this private function :\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NonSemistandardTableauQ", "[", "tab_", "]"}], ":=", 
   RowBox[{"Not", "@", 
    RowBox[{"SemistandardTableauQ", "[", "tab", "]"}]}]}], ";"}]], "Input",
 InitializationCell->True],

Cell["\<\
2) SemistandardTableaux is not a very elegant function because it first \
generates lots of tableaux (by expanding the dimension over standard \
tableaux) and then selects only those which are semistandard. It should be \
possible to enumerate directly semistandard tableaux.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "SemistandardTableaux"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"SemistandardTableaux[par, set] returns the list of all \
semistandard tableaux, of shape given by the partition par, that can be \
constructed onto the given set of labels. SemistandardTableaux[par, n] for a \
positive integer n is interpreted as SemistandardTableaux[par, Range[n]]. \
SemistandardTableaux[par] is interpreted as SemistandardTableaux[par, \
Total[par]].\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442152-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rules", "[", 
    RowBox[{"0", ",", "set_List"}], "]"}], ":=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rules", "[", 
    RowBox[{
     RowBox[{"m_Integer", "?", "Positive"}], ",", "labels_List"}], "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Outer", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Inner", "[", 
         RowBox[{"Rule", ",", 
          RowBox[{"Range", "[", "m", "]"}], ",", 
          RowBox[{"{", "##", "}"}], ",", "List"}], "]"}], "&"}], ",", 
       RowBox[{"Sequence", "@@", 
        RowBox[{"Table", "[", 
         RowBox[{"labels", ",", 
          RowBox[{"{", "m", "}"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"m", "-", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SemistandardTableaux", "[", 
    RowBox[{"par", ":", 
     RowBox[{"{", "___Integer", "}"}]}], "]"}], ":=", 
   RowBox[{"SemistandardTableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Total", "[", "par", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SemistandardTableaux", "[", 
    RowBox[{
     RowBox[{"par", ":", 
      RowBox[{"{", "___Integer", "}"}]}], ",", 
     RowBox[{"dim_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
   RowBox[{"SemistandardTableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Range", "[", "dim", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SemistandardTableaux", "[", 
    RowBox[{
     RowBox[{"par", ":", 
      RowBox[{"{", "___Integer", "}"}]}], ",", "labels_List"}], "]"}], ":=", 
   RowBox[{"Sort", "@", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"First", "[", 
        RowBox[{"StandardTableaux", "[", "par", "]"}], "]"}], "/.", 
       RowBox[{"rules", "[", 
        RowBox[{
         RowBox[{"Total", "[", "par", "]"}], ",", 
         RowBox[{"LabelsSort", "[", "labels", "]"}]}], "]"}]}], ",", 
      "SemistandardTableauQ"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"SemistandardTableaux", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Protect", "[", "SemistandardTableaux", "]"}], ";"}], 
   "*)"}]}]}], "Input",
 InitializationCell->True],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"StandardTableaux", "[", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"Tableau", "[", "]"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"StandardTableaux", "[", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"Tableau", "[", "]"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"StandardTableaux", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "3) This is the number of semistandard tableaux in dimension dim (that is, \
with labels Range[dim]). It gives the number of components when the tensor \
has as symmetry a standard tableau of the given partition. Fulton calls this ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "\[Lambda]"], "(", "m", ")"}], TraditionalForm]]],
 ", where \[Lambda] is the partition and m is our dim. Fulton says that this \
formula in terms of hook-lengths is due to Stanley (1971)."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "NumberOfSemistandardTableaux"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"NumberOfSemistandardTableaux[par, set] returns the number of \
semistandard tableaux, of shape given by the partition par, that can be \
constructed onto the given set of labels. NumberOfSemistandardTableaux[par, \
n] for a positive integer n is interpreted as \
NumberOfSemistandardTableaux[par, Range[n]]. \
NumberOfSemistandardTableaux[par] is interpreted as \
NumberOfSemistandardTableaux[par, Total[par]].\"\>", 
  "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442152-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfSemistandardTableaux", "[", 
    RowBox[{"par", ":", 
     RowBox[{"{", "___Integer", "}"}]}], "]"}], ":=", 
   RowBox[{"NumberOfSemistandardTableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Total", "[", "par", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfSemistandardTableaux", "[", 
    RowBox[{
     RowBox[{"par", ":", 
      RowBox[{"{", "___Integer", "}"}]}], ",", "labels_List"}], "]"}], ":=", 
   RowBox[{"NumberOfSemistandardTableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Length", "@", 
      RowBox[{"LabelsSort", "[", "labels", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfSemistandardTableaux", "[", 
    RowBox[{
     RowBox[{"par", ":", 
      RowBox[{"{", "___Integer", "}"}]}], ",", 
     RowBox[{"dim_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "par", "]"}], ">", "dim"}], ",", "0", ",", 
     RowBox[{
      RowBox[{"DET", "@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{"par", ",", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"dim", "-", 
               RowBox[{"Length", "[", "par", "]"}]}], "}"}]}], "]"}]}], "]"}],
          "+", "dim", "-", 
         RowBox[{"Range", "[", "dim", "]"}]}], ")"}]}], "/", 
      RowBox[{"DET", "@", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"dim", "-", "1"}], ",", "0", ",", 
         RowBox[{"-", "1"}]}], "]"}]}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"NumberOfSemistandardTableaux", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "NumberOfSemistandardTableaux", "]"}], 
  ";"}]}], "Input",
 InitializationCell->True],

