Cell[BoxData[
 RowBox[{
  RowBox[{"Total", "[", "%", "]"}], "===", 
  RowBox[{"5", "^", "7"}]}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell["\<\
Another interesting result is that the number of matrices m by n with \
nonnegative entries that sum to r is the sum of NumberOfSemistandardTableaux[\
\[Lambda],m]*NumberOfSemistandardTableaux[\[Lambda],n] over all partitions \
\[Lambda] of r. For example, take all 2x3 matrices with entries adding up to \
10:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"Permutations", "/@", 
     RowBox[{"IntegerPartitions", "[", 
      RowBox[{"10", ",", 
       RowBox[{"{", "6", "}"}], ",", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "10"}], "]"}]}], "]"}]}], ",", "1"}], "]"}], "//", 
  "Length"}]], "Input"],

Cell[BoxData["3003"], "Output"]
}, Open  ]],

