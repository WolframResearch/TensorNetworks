Cell["\<\
2) Enumeration of skew-tableaux on a given labels set is easy: construct a \
template skew tableau and then map all possible tuples of the labels set:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SkewTableaux", "[", 
    RowBox[{"opar_List", ",", "ipar_List"}], "]"}], ":=", 
   RowBox[{"SkewTableaux", "[", 
    RowBox[{"opar", ",", "ipar", ",", 
     RowBox[{
      RowBox[{"Total", "[", "opar", "]"}], "-", 
      RowBox[{"Total", "[", "ipar", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SkewTableaux", "[", 
    RowBox[{"opar_List", ",", "ipar_List", ",", "dim_Integer"}], "]"}], ":=", 
   
   RowBox[{"SkewTableaux", "[", 
    RowBox[{"opar", ",", "ipar", ",", 
     RowBox[{"Range", "[", "dim", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SkewTableaux", "[", 
    RowBox[{"opar_List", ",", "ipar_List", ",", "labels_List"}], "]"}], ":=", 
   
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vars", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Unique", "[", "]"}], "&"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"Total", "[", "opar", "]"}], "-", 
          RowBox[{"Total", "[", "ipar", "]"}]}], "]"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"First", "@", 
       RowBox[{"Fold", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Append", "[", 
             RowBox[{
              RowBox[{"#1", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"Skew", ",", 
                  RowBox[{"#2", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
                RowBox[{"Take", "[", 
                 RowBox[{
                  RowBox[{"#1", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", 
                  RowBox[{"Subtract", "@@", "#2"}]}], "]"}]}], "]"}]}], "]"}],
             ",", 
            RowBox[{"Drop", "[", 
             RowBox[{
              RowBox[{"#1", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"Subtract", "@@", "#2"}]}], "]"}]}], "}"}], "&"}], ",", 
         
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Tableau", "[", "]"}], ",", "vars"}], "}"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"opar", ",", 
            RowBox[{"PadRight", "[", 
             RowBox[{"ipar", ",", 
              RowBox[{"Length", "[", "opar", "]"}]}], "]"}]}], "}"}], "]"}]}],
         "]"}]}], "/.", 
      RowBox[{"Inner", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Rule", "[", 
          RowBox[{"#2", ",", "#1"}], "]"}], "&"}], ",", 
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"LabelsSort", "[", "labels", "]"}], ",", 
          RowBox[{"Length", "[", "vars", "]"}]}], "]"}], ",", "vars", ",", 
        "List", ",", "2"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"SkewTableaux", ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ";"}]}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SkewTableaux", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "2", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}]}], "]"}], "//", 
  "Length"}]], "Input"],

Cell[BoxData["64"], "Output"]
}, Open  ]],

Cell["3) Counting is equally simple:", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfSkewTableaux", "[", 
    RowBox[{"opar_List", ",", "ipar_List"}], "]"}], ":=", 
   RowBox[{"NumberOfSkewTableaux", "[", 
    RowBox[{"opar", ",", "ipar", ",", 
     RowBox[{
      RowBox[{"Total", "[", "opar", "]"}], "-", 
      RowBox[{"Total", "[", "ipar", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfSkewTableaux", "[", 
    RowBox[{"opar_List", ",", "ipar_List", ",", "dim_Integer"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"dim", "^", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Total", "[", "opar", "]"}], "-", 
      RowBox[{"Total", "[", "ipar", "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfSkewTableaux", "[", 
    RowBox[{"opar_List", ",", "ipar_List", ",", "labels_List"}], "]"}], ":=", 
   
   RowBox[{"NumberOfSkewTableaux", "[", 
    RowBox[{"opar", ",", "ipar", ",", 
     RowBox[{"Length", "[", 
      RowBox[{"LabelsSort", "[", "labels", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"NumberOfSkewTableaux", ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ";"}]}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NumberOfSkewTableaux", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
