Cell["\<\
Interestingly, the second factor of the product is always a Yamanouchi \
tableau. Other experiments seem to confirm that, what suggests a faster way \
to compute results: use only Schensted products of all semistandard tableux \
of the smaller partition with the Yamanouchi tableau of the larger partition, \
and then look for only Yamanouchi tableaux.\
\>", "Text"],

Cell["\<\
We saw before that the result here must be 3:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nu", "=", 
   RowBox[{"{", 
    RowBox[{"5", ",", "4", ",", "3", ",", "2"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lambda", "=", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3", ",", "1"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mu", "=", 
   RowBox[{"{", 
    RowBox[{"4", ",", "2", ",", "1"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"NumberOfSemistandardTableaux", "[", "lambda", "]"}], ">", 
     RowBox[{"NumberOfSemistandardTableaux", "[", "mu", "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"large", "=", "lambda"}], ";", "\[IndentingNewLine]", 
     RowBox[{"small", "=", "mu"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"large", "=", "mu"}], ";", "\[IndentingNewLine]", 
     RowBox[{"small", "=", "lambda"}]}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Timing", "@", 
  RowBox[{"Length", "[", 
   RowBox[{"smallsstabs", "=", 
    RowBox[{"SemistandardTableaux", "[", "small", "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Ylarge", "=", 
  RowBox[{"YamanouchiTableau", "[", "large", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Ynu", "=", 
  RowBox[{"YamanouchiTableau", "[", "nu", "]"}]}]}], "Input"],

Cell[BoxData[
 RowBox[{"{", 
