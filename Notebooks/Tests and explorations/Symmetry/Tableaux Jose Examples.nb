       Item[2, Frame -> RGBColor[0, 0, 1]], 
       Item[3, Frame -> RGBColor[0, 0, 1]], 
       Item[5, Frame -> RGBColor[0, 0, 1]]}, {
       Item[3, Frame -> RGBColor[0, 0, 1]], 
       Item[4, Frame -> RGBColor[0, 0, 1]], 
       Item[5, Frame -> RGBColor[0, 0, 1]]}, {
       Item[4, Frame -> RGBColor[0, 0, 1]], 
       Item[6, Frame -> RGBColor[0, 0, 1]], 
       Item[6, Frame -> RGBColor[0, 0, 1]]}, {
       Item[5, Frame -> RGBColor[0, 0, 1]]}}], FontSize -> 10]]]], "Output"]
}, Open  ]],

