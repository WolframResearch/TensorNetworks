  "3.35983300000000006946265784790739417076`6.546917604663241", ",", 
   "70423"}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
For partitions of length 1 the Schur polynomial coincide with the complete \
homogeneous symmetric polynomial :\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"SchurPolynomial", "[", 
     RowBox[{
      RowBox[{"{", "k", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "]"}], "===", 
    RowBox[{"CompleteHomogeneousSymmetricPolynomial", "[", 
     RowBox[{"k", ",", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "1", ",", "10"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "True", ",", "True", ",", "True", ",", "True", ",", "True", ",", "True", 
   ",", "True", ",", "True", ",", "True", ",", "True"}], "}"}]], "Output"]
}, Open  ]],

