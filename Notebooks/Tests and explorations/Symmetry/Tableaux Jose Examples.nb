Cell["3) Number of general tableaux:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "NumberOfTableaux"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"NumberOfTableaux[part, set] returns the number of tableaux, of \
shape given by the partition par, that can be constructed onto the given set \
of labels. NumberOfTableaux[par, n] for a positive integer is interpreted as \
NumberOfTableaux[par, Range[n]]. NumberOfTableaux[par] is interpreted as \
NumberOfTableaux[par, Total[par]].\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442069-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfTableaux", "[", 
    RowBox[{"par", ":", 
     RowBox[{"{", "___Integer", "}"}]}], "]"}], ":=", 
   RowBox[{"NumberOfTableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Total", "@", "par"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfTableaux", "[", 
    RowBox[{
     RowBox[{"par", ":", 
      RowBox[{"{", "___Integer", "}"}]}], ",", "labels_List"}], "]"}], ":=", 
   RowBox[{"NumberOfTableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Length", "@", 
      RowBox[{"LabelsSort", "[", "labels", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfTableaux", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "0"}], "]"}], ":=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NumberOfTableaux", "[", 
