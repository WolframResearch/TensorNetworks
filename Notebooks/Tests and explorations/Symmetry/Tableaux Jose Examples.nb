Cell["\<\
Then that defines a permutation list. This was the original correspondence \
discovered by Robinson, and independently by Schensted:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"WordOfTableauPair", "[", "%", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "9", ",", "3", ",", "7", ",", "11", ",", "10", ",", "4", ",", "8", ",", "2",
    ",", "5", ",", "6", ",", "1"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"%%", "===", 
  RowBox[{"TableauPairOfWord", "[", "%", "]"}]}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell["\<\
Recall that the labels of the first tableau need not be numbers, but the \
labels of the second tableau must be numbers, and actually a range of \
consecutive different integers starting at 1.\
\>", "Text"],

Cell["\<\
3) Knuth generalized this correspondence to the case in which both tableaux \
are semistandard. Unfortunately, this is another place is which Fulton\
\[CloseCurlyQuote]s description is absolutely terrible, very imprecise, and \
hence I cannot be sure I have encoded this correctly. I have to look at \
Cameron\[CloseCurlyQuote]s book again...\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Deactivated", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"InsertionOrder", "[", "instab_Tableau", "]"}], ":=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Last", "/@", 
     RowBox[{"Reverse", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#", ",", 
          RowBox[{"First", "/@", 
           RowBox[{"Reverse", "@", 
            RowBox[{"Position", "[", 
             RowBox[{"instab", ",", "#"}], "]"}]}]}]}], "}"}], "&"}], "/@", 
       RowBox[{"Union", "@@", "instab"}]}], "]"}]}], "]"}]}]}]], "Input",
 Evaluatable->False],

Cell[BoxData[
 RowBox[{
  RowBox[{"InsertionOrder", "[", "instab_Tableau", "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Flatten", "[", 
   RowBox[{"Last", "/@", 
    RowBox[{"Reverse", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", 
         RowBox[{"Last", "/@", 
          RowBox[{"Reverse", "@", 
           RowBox[{"Sort", "[", 
            RowBox[{"Reverse", "/@", 
             RowBox[{"Position", "[", 
              RowBox[{"instab", ",", "#"}], "]"}]}], "]"}]}]}]}], "}"}], 
       "&"}], "/@", 
      RowBox[{"Union", "@@", "instab"}]}], "]"}]}], "]"}]}]], "Input"],

Cell["\<\
Words are now denoted as two lists, and are called \
\[OpenCurlyDoubleQuote]double words\[CloseCurlyDoubleQuote] (my name), \
representing some sort of mapping from the elements of the first list to the \
elements of the second list (generalizing permutations).\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DoubleWordOfTableauPair", "[", 
    RowBox[{"{", 
     RowBox[{"tab_", ",", "instab_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{"Join", "@@", "instab"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Last", "/@", 
      RowBox[{"Reverse", "@", 
       RowBox[{"Rest", "[", "\[IndentingNewLine]", 
        RowBox[{"FoldList", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"ReverseRowBump", "[", 
            RowBox[{
             RowBox[{"First", "[", "#1", "]"}], ",", "#2"}], "]"}], "&"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"tab", ",", "0"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"InsertionOrder", "[", "instab", "]"}]}], 
         "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}]}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input"],

Cell["\<\
Note that the first list of the double word is returned sorted.\
\>", "Text"],

Cell["\<\
Fulton's exercise 1 in page 40:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"examplepair", "=", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tableau", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1", ",", "1", ",", "2"}], "}"}],
       ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Tableau", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "2", ",", "3", ",", "3"}], "}"}],
       ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "}"}]}]], "Input"],

Cell[BoxData[
