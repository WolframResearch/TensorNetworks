Cell[BoxData[
 RowBox[{"KnuthProduct", "[", 
  RowBox[{"{", 
   RowBox[{"v", ",", "z", ",", "u", ",", "x", ",", "y"}], "}"}], 
  "]"}]], "Output"]
}, Open  ]],

Cell["\<\
In principle, this provides a third route to the tableau product monoid.\
\>", "Text"],

Cell[TextData[{
 "With any monoid there is an associated \"group ring\". For the monoid of \
semistandard tableaux with labels in S, we have the ring ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "S"], TraditionalForm]]],
 ", called the tableau ring. This is the module of linear combinations with \
integers of the semistandard tableaux in S, with multiplication determined by \
the multiplication of tableaux. It is an associative but noncommutative ring. \
There is a canonical homomorphism of this ring to the ring of polynomials \
with integers coefficients with variables S."
}], "Text"],

Cell["\<\
An interesting result (Fulton, exercise 16, page 57) is that for a \
semistandard tableau T with shape \[Lambda] there are exactly \
NumberOfStandardTableaux[\[Lambda]] words that are Knuth-equivalent to \
WordOfTableau[T]. I have tried to check examples, but I \
don\[CloseCurlyQuote]t get that result...\
\>", "Text"],

Cell["\<\
An important type of words, for later use, are lattice words and reverse \
lattice words (aka Yamanouchi words):\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"LatticeWordQ", "[", "word_List", "]"}], ":=", 
   RowBox[{"LatticeWordQ", "[", 
    RowBox[{"word", ",", 
     RowBox[{"Union", "[", "word", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LatticeWordQ", "[", 
    RowBox[{"word_List", ",", "labels_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "rules"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "labels", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rules", "=", 
       RowBox[{"Thread", "[", 
        RowBox[{"labels", "\[Rule]", 
         RowBox[{"Range", "[", "n", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"And", "@@", 
       RowBox[{"GreaterEqual", "@@@", 
        RowBox[{"FoldList", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Plus", "[", 
            RowBox[{"#1", ",", 
             RowBox[{"UnitVector", "[", 
              RowBox[{"n", ",", "#2"}], "]"}]}], "]"}], "&"}], ",", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", "n"}], "]"}], ",", 
          RowBox[{"word", "/.", "rules"}]}], "]"}]}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReverseLatticeWordQ", "[", "word_List", "]"}], ":=", 
   RowBox[{"ReverseLatticeWordQ", "[", 
    RowBox[{"word", ",", 
     RowBox[{"Union", "[", "word", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReverseLatticeWordQ", "[", 
    RowBox[{"word_List", ",", "labels_"}], "]"}], ":=", 
   RowBox[{"LatticeWordQ", "[", 
    RowBox[{
     RowBox[{"Reverse", "[", "word", "]"}], ",", "labels"}], "]"}]}], 
  ";"}]}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ReverseLatticeWordQ", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", "1", ",", "3", ",", "2", ",", "1", ",", "2", ",", "1"}], 
   "}"}], "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ReverseLatticeWordQ", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3", ",", "2", ",", "1", ",", "2", ",", "1"}], 
   "}"}], "]"}]], "Input"],

Cell[BoxData["False"], "Output"]
}, Open  ]],

Cell["\<\
Interestingly, being ReverseLatticeWordQ is a property that is preserved \
under Knuth equivalence.\
\>", "Text"],

Cell["\<\
There is a canonical correspondence between standard tableaux and reverse \
lattice words. We do this for the integers alphabet only:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TableauOfReverseLatticeWord", "[", 
    RowBox[{"word_", "?", "ReverseLatticeWordQ"}], "]"}], ":=", 
   RowBox[{"Tableau", "@@", 
    RowBox[{"Fold", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"matrix", "=", "#1"}], ",", 
           RowBox[{"pos", "=", 
            RowBox[{"#2", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"val", "=", 
            RowBox[{"#2", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"MapAt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Prepend", "[", 
             RowBox[{"#", ",", "val"}], "]"}], "&"}], ",", "matrix", ",", 
           "pos"}], "]"}]}], "]"}], "&"}], ",", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"Max", "[", "word", "]"}]}], "]"}], ",", 
      RowBox[{"Reverse", "@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Reverse", "[", "word", "]"}], ",", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "word", "]"}], "]"}]}], "}"}], "]"}]}]}], 
     "]"}]}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReverseLatticeWordOfTableau", "[", 
   RowBox[{"tab_", "?", "StandardTableauQ"}], "]"}], ":=", 
  RowBox[{"Reverse", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{"tab", ",", "#"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}], "&"}], "/@", 
    RowBox[{"Union", "@@", "tab"}]}], "]"}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauOfReverseLatticeWord", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", "1", ",", "2", ",", "3", ",", "1", ",", "2", ",", "1"}], 
   "}"}], "]"}]], "Input"],

Cell[BoxData[
 InterpretationBox[Cell[BoxData[
   FormBox[
    StyleBox[
     TagBox[GridBox[{
        {
         ItemBox["1",
          Frame->RGBColor[0, 0, 1],
          StripOnInput->False], 
         ItemBox["3",
          Frame->RGBColor[0, 0, 1],
          StripOnInput->False], 
