Cell[CellGroupData[{

Cell["4. Skew-tableaux", "Subsection",
 FontColor->RGBColor[0, 0, 1]],

Cell[CellGroupData[{

Cell["\<\
4.0. Comments on the skew-tableaux\
\>", "Subsubsection"],

Cell["\<\
In order to deal with skew-tableaux we introduce the symbol Skew. Do not use \
it as a label for any other purpose! This is not an ideal solution, because \
skew-tableaux can also be classified as standard, semistandard, etc, and we \
are not implementing that. That is, we are considering skew-tableaux as a \
special case of tableau (those using the \[OpenCurlyDoubleQuote]label\
\[CloseCurlyDoubleQuote] Skew), but perhaps it would be more natural to \
consider tableaux as a special case of skew-tableau (those with an empty \
inner partition).\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "Skew"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"Skew is a symbol used to denote boxes of the interior \
partition of a skew tableau.\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442169-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Format", "[", "Skew", "]"}], "=", "\[FilledSquare]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "Skew", "]"}], ";"}]}], "Input",
 InitializationCell->True],

Cell["\<\
Skew-tableaux have two associated partitions. We will talk of \
\[OpenCurlyDoubleQuote]the partition\[CloseCurlyDoubleQuote] or the \
\[OpenCurlyDoubleQuote]outer partition\[CloseCurlyDoubleQuote] when referring \
to the larger one, and of the \[OpenCurlyDoubleQuote]skew partition\
\[CloseCurlyDoubleQuote] or the \[OpenCurlyDoubleQuote]inner partition\
\[CloseCurlyDoubleQuote] when referring to the smaller one. Our notation \
naturally implements the fact that the outer partition includes the inner \
partition and hence we do not have to check that in the tableaux. We need to \
check that on functions creating skew-tableaux.\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"takeSkew", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"lskew", ":", 
       RowBox[{"Longest", "[", 
        RowBox[{"Skew", "..."}], "]"}]}], ",", "rest___"}], "}"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"{", "rest", "}"}], ",", "Skew"}], "]"}], ",", 
     RowBox[{"{", "lskew", "}"}], ",", 
     RowBox[{"Throw", "[", 
      RowBox[{
      "Print", "[", "\"\<Skew labels are not contiguous in rows.\>\"", "]"}], 
      "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SkewPartition", "[", "tab_Tableau", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Length", "/@", 
      RowBox[{"takeSkew", "/@", 
       RowBox[{"List", "@@", "tab"}]}]}], ")"}], "//.", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ints___", ",", "0"}], "}"}], "\[RuleDelayed]", 
     RowBox[{"{", "ints", "}"}]}]}]}], ";"}]}], "Input"],

