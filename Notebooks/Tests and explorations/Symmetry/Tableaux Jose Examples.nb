         Item[3, Frame -> RGBColor[0, 0, 1]]}, {
         Item[4, Frame -> RGBColor[0, 0, 1]]}}], FontSize -> 10]]]}], 
  "}"}]], "Output"]
}, Open  ]],

Cell["\<\
Let us define a constructor of such type of tableaux:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"YamanouchiTableau", "[", 
    RowBox[{"par_", "?", "PartitionQ"}], "]"}], ":=", 
   RowBox[{"YamanouchiTableau", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "par", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"YamanouchiTableau", "[", 
    RowBox[{
     RowBox[{"par_", "?", "PartitionQ"}], ",", "labels_List"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "par", "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Inner", "[", 
       RowBox[{"ConstantArray", ",", 
        RowBox[{"Take", "[", 
         RowBox[{"labels", ",", "n"}], "]"}], ",", "par", ",", "Tableau"}], 
       "]"}], "/;", 
      RowBox[{
       RowBox[{"Length", "[", "labels", "]"}], "\[GreaterEqual]", "n"}]}]}], 
    "]"}]}], ";"}]}], "Input",
 InitializationCell->True],

