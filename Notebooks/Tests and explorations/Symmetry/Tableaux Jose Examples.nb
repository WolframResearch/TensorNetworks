Cell["\<\
In the example above we see the following Kostka numbers:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"parperms", "[", 
   RowBox[{"par_", ",", "kostka_"}], "]"}], ":=", 
  RowBox[{"Sequence", "@@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Permutations", "[", "par", "]"}], ",", 
     RowBox[{"{", "kostka", "}"}]}], "]"}]}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", "@", 
   RowBox[{"Join", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"parperms", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"3", ",", "2", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       "1"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"parperms", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"3", ",", "1", ",", "1", ",", "0", ",", "0"}], "}"}], ",", 
       "1"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"parperms", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "2", ",", "1", ",", "0", ",", "0"}], "}"}], ",", 
       "2"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"parperms", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "1", ",", "1", ",", "1", ",", "0"}], "}"}], ",", 
       "3"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"parperms", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
       "5"}], "]"}]}], "\[IndentingNewLine]", "]"}]}], "===", 
  RowBox[{"Sort", "@", "tabweights"}]}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell["\<\
Note how useful are the trailing zeros here.\
\>", "Text"],

Cell[TextData[{
 "QUESTION: This is a very innefficient way of computing Kostka numbers. What \
is a better way? See [",
 ButtonBox["MathExchange",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://math.stackexchange.com/questions/17891/why-is-a-general-\
formula-for-kostka-numbers-unlikely-to-exist"], None},
  ButtonNote->
   "http://math.stackexchange.com/questions/17891/why-is-a-general-formula-\
for-kostka-numbers-unlikely-to-exist"],
 "] discussion for pointers."
}], "Text"],

Cell["\<\
Note that we have not really written a function KostkaNumber[par1, par2].\
\>", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
5.6. The Robinson-Schensted-Knuth correspondence\
\>", "Subsubsection"],

Cell["\<\
1) From any word, it is possible to construct a pair of tableaux, the first \
containing the word and the second containing positional information to \
reconstruct the word:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TableauPairOfWord", "[", "word_List", "]"}], ":=", 
  RowBox[{"Fold", "[", 
   RowBox[{"RowBumpInsert", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Tableau", "[", "]"}], ",", 
      RowBox[{"Tableau", "[", "]"}]}], "}"}], ",", 
    RowBox[{"Transpose", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "#", "]"}], "]"}]}], "}"}], "&"}], "@", 
      "word"}], "]"}]}], "]"}]}]], "Input"],

Cell["\<\
This is the example given by Fulton page 37:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"exampleword", "=", 
   RowBox[{"{", 
    RowBox[{
    "5", ",", "4", ",", "8", ",", "2", ",", "3", ",", "4", ",", "1", ",", "7",
      ",", "5", ",", "3", ",", "1"}], "}"}]}], ";"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"examplepair", "=", 
  RowBox[{"TableauPairOfWord", "[", "exampleword", "]"}]}]], "Input"],

