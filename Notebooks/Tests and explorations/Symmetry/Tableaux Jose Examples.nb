Cell[BoxData[
 RowBox[{"WordOfTableau", "[", "%", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"v", ",", "z", ",", "u", ",", "x", ",", "y"}], "}"}]], "Output"]
}, Open  ]],

Cell["\<\
This construction does not stop when that canonical word is found. I don' t \
know what is the criterium to stop it. Perhaps there is no notion of \
canonical representative, and all what these two rules do is showing \
equivalence between two words. Fulton\[CloseCurlyQuote]s example just want to \
use equivalence between the original word {v,x,z,u,y} and the word \
{v,z,u,x,y}, which we get already in the fifth step.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"$RecursionLimit", "=", "20"}], ",", 
     RowBox[{"$IterationLimit", "=", "20"}]}], "}"}], ",", 
   RowBox[{"KnuthProduct", "[", 
    RowBox[{"{", 
     RowBox[{"v", ",", "x", ",", "z", ",", "u", ",", "y"}], "}"}], "]"}]}], 
  "]"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Using rule 1 with \"\>", "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"v", ",", "x", ",", "z", ",", "u", ",", "y"}], "}"}], "\[Rule]", 
    
    RowBox[{"{", 
     RowBox[{"v", ",", "x", ",", "u", ",", "z", ",", "y"}], "}"}]}], 
   "\[InvisibleSpace]", "\<\" assuming \"\>", "\[InvisibleSpace]", "u", 
   "\[InvisibleSpace]", "\<\"<\"\>", "\[InvisibleSpace]", "x", 
   "\[InvisibleSpace]", 
   RowBox[{"\<\"\[LessEqual]\"\>", " ", "z"}]}],
