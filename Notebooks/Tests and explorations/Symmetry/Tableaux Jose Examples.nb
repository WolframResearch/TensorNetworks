Cell["\<\
There is this interesting identity, which seems to come from the Robinson \
correspondence (Fulton, page 52),\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"NumberOfSemistandardTableaux", "[", 
      RowBox[{"#", ",", "5"}], "]"}], 
     RowBox[{"NumberOfStandardTableaux", "[", "#", "]"}]}], "&"}], ")"}], "/@", 
  RowBox[{"IntegerPartitions", "[", "7", "]"}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "330", ",", "4320", ",", "11760", ",", "8100", ",", "7840", ",", "24500", 
   ",", "3200", ",", "6615", ",", "4410", ",", "6125", ",", "225", ",", "560",
    ",", "140", ",", "0", ",", "0"}], "}"}]], "Output"]
}, Open  ]],

