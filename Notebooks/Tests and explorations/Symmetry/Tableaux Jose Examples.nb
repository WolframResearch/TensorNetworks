 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"NumberOfTableaux", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "NumberOfTableaux", "]"}], ";"}]}], "Input",
 InitializationCell->True],

