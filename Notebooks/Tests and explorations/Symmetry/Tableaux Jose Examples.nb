Cell[CellGroupData[{

Cell["2. Partitions of an integer", "Subsection",
 FontColor->RGBColor[0, 0, 1]],

Cell[CellGroupData[{

Cell["2.1. PartitionQ", "Subsubsection"],

Cell["\<\
A partition (abbreviated to par in the codes) of a nonnegative integer n is a \
list of nonincreasing nonnegative integers adding up to n. That is, we are \
dealing with **additive** partitions, and not with multiplicative partitions \
(more commonly known as factorizations). Note that partitions are naturally \
multisets, and could be also given in multiplicity-form, like FactorInteger \
does.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "PartitionQ"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"PartitionQ[expr] returns True if expr is a partition of a \
nonnegative integer, i.e. a non-increasing list of nonnegative integers, and \
False otherwise.\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442047-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PartitionQ", "[", 
    RowBox[{"par", ":", 
     RowBox[{"{", 
      RowBox[{"___Integer", "?", "NonNegative"}], "}"}]}], "]"}], ":=", 
   RowBox[{"GreaterEqual", "@@", "par"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PartitionQ", "[", "_", "]"}], ":=", "False"}], ";"}]}], "Input",
 InitializationCell->True],

Cell["\<\
The empty list { } is a partition, the only partition of 0. \
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PartitionQ", "[", 
  RowBox[{"{", "}"}], "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell["\<\
QUESTION: Do we accept trailing zeros in partitions? The previous definition \
of PartitionQ does accept them:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PartitionQ", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", "2", ",", "1", ",", "0", ",", "0"}], "}"}], 
  "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell["\<\
Actually I now think that we must accept trailing zeros because in some cases \
we need to compare or sort partitions of different lengths, and then it is \
useful to keep the idea that two partitions coincide if they differ only by \
trailing zeros. We will see later that empty lists are accepted by the head \
Tableau, though they are immediately removed. Because partitions have head \
List we cannot automatically remove zeros.\
\>", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["2.2. IntegerPartitions", "Subsubsection"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "IntegerPartitions"}]], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\!\(\*RowBox[{\\\"IntegerPartitions\\\", \\\"[\\\", StyleBox[\
\\\"n\\\", \\\"TI\\\"], \\\"]\\\"}]\) gives a list of all possible ways to \
partition the integer \!\(\*StyleBox[\\\"n\\\", \\\"TI\\\"]\) into smaller \
integers. \\n\!\(\*RowBox[{\\\"IntegerPartitions\\\", \\\"[\\\", \
RowBox[{StyleBox[\\\"n\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\\\"k\\\", \
\\\"TI\\\"]}], \\\"]\\\"}]\) gives partitions into at most \
\!\(\*StyleBox[\\\"k\\\", \\\"TI\\\"]\) integers. \
\\n\!\(\*RowBox[{\\\"IntegerPartitions\\\", \\\"[\\\", RowBox[{StyleBox[\\\"n\
\\\", \\\"TI\\\"], \\\",\\\", RowBox[{\\\"{\\\", StyleBox[\\\"k\\\", \\\"TI\\\
\"], \\\"}\\\"}]}], \\\"]\\\"}]\) gives partitions into exactly \
\!\(\*StyleBox[\\\"k\\\", \\\"TI\\\"]\) integers. \
\\n\!\(\*RowBox[{\\\"IntegerPartitions\\\", \\\"[\\\", RowBox[{StyleBox[\\\"n\
\\\", \\\"TI\\\"], \\\",\\\", RowBox[{\\\"{\\\", \
RowBox[{SubscriptBox[StyleBox[\\\"k\\\", \\\"TI\\\"], StyleBox[\\\"min\\\", \
\\\"TI\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"k\\\", \\\"TI\\\"], \
StyleBox[\\\"max\\\", \\\"TI\\\"]]}], \\\"}\\\"}]}], \\\"]\\\"}]\) gives \
partitions into between \!\(\*SubscriptBox[StyleBox[\\\"k\\\", \\\"TI\\\"], \
StyleBox[\\\"min\\\", \\\"TI\\\"]]\) and \
\!\(\*SubscriptBox[StyleBox[\\\"k\\\", \\\"TI\\\"], StyleBox[\\\"max\\\", \
\\\"TI\\\"]]\) integers. \\n\!\(\*RowBox[{\\\"IntegerPartitions\\\", \
\\\"[\\\", RowBox[{StyleBox[\\\"n\\\", \\\"TI\\\"], \\\",\\\", \
StyleBox[\\\"kspec\\\", \\\"TI\\\"], \\\",\\\", RowBox[{\\\"{\\\", \
RowBox[{SubscriptBox[StyleBox[\\\"s\\\", \\\"TI\\\"], StyleBox[\\\"1\\\", \
\\\"TR\\\"]], \\\",\\\", SubscriptBox[StyleBox[\\\"s\\\", \\\"TI\\\"], \
StyleBox[\\\"2\\\", \\\"TR\\\"]], \\\",\\\", StyleBox[\\\"\[Ellipsis]\\\", \\\
\"TR\\\"]}], \\\"}\\\"}]}], \\\"]\\\"}]\) gives partitions involving only the \
\!\(\*SubscriptBox[StyleBox[\\\"s\\\", \\\"TI\\\"], StyleBox[\\\"i\\\", \
\\\"TI\\\"]]\). \\n\!\(\*RowBox[{\\\"IntegerPartitions\\\", \\\"[\\\", \
RowBox[{StyleBox[\\\"n\\\", \\\"TI\\\"], \\\",\\\", StyleBox[\\\"kspec\\\", \
\\\"TI\\\"], \\\",\\\", StyleBox[\\\"sspec\\\", \\\"TI\\\"], \\\",\\\", \
StyleBox[\\\"m\\\", \\\"TI\\\"]}], \\\"]\\\"}]\) limits the result to the \
first \!\(\*StyleBox[\\\"m\\\", \\\"TI\\\"]\) partitions. \"\>", "MSG"], 
  "\[NonBreakingSpace]", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/IntegerPartitions"]}]], "Print", "PrintUsage",
 CellTags->"Info3579442047-9818602"]
}, Open  ]],

Cell["\<\
Starting version 6, there is the builtin function IntegerPartitions. This is \
an alternative implementation for the 2-arguments case:\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"$VersionNumber", "<", "6.0"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"IntegerPartitions", "[", "n_Integer", "]"}], ":=", 
      RowBox[{"IntegerPartitions", "[", 
       RowBox[{"n", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"IntegerPartitions", "[", 
       RowBox[{
        RowBox[{"n_Integer", "?", "Negative"}], ",", "_"}], "]"}], ":=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"IntegerPartitions", "[", 
       RowBox[{"0", ",", "_"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{"{", "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"IntegerPartitions", "[", 
       RowBox[{"_", ",", "0"}], "]"}], ":=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"IntegerPartitions", "[", 
       RowBox[{"n_Integer", ",", "1"}], "]"}], ":=", 
      RowBox[{"{", 
       RowBox[{"Table", "[", 
        RowBox[{"1", ",", 
         RowBox[{"{", "n", "}"}]}], "]"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"IntegerPartitions", "[", 
       RowBox[{"n_Integer", ",", "m_Integer"}], "]"}], ":=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{"#", ",", "m"}], "]"}], "&"}], ")"}], "/@", 
         RowBox[{"IntegerPartitions", "[", 
          RowBox[{
           RowBox[{"n", "-", "m"}], ",", "m"}], "]"}]}], ",", 
        RowBox[{"IntegerPartitions", "[", 
         RowBox[{"n", ",", 
          RowBox[{"m", "-", "1"}]}], "]"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]], "Input",
 InitializationCell->True],

Cell["\<\
A partition identifies a Young diagram (also known as Ferrer diagram), which \
is not a Young tableau. The diagram is an unfilled tableau, giving the boxes \
structure, but not its labels. A tableau always has labels.\
\>", "Text"],

Cell["\<\
Partitions are formatted as standard lists. We do not format them as unfilled \
tableaux. We will actually allow later the syntax Tableau[4, 4, 2], but only \
for typesetting purposes. The code does not accept partitions with head \
Tableau.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", "0", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", "}"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", "1", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", "1", "}"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", "2", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", "6", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "6", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "2", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}]}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PartitionQ", "/@", "%"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "True", ",", "True", ",", "True", ",", "True", ",", "True", ",", "True", 
   ",", "True", ",", "True", ",", "True", ",", "True", ",", "True"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell[TextData[{
 "Note that ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s function accepts any rational input (this is because a third argument \
allows partitioning a rational into specified rationals), returning an empty \
list:"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", 
  RowBox[{"-", "3"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", 
  RowBox[{"5", "/", "2"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["2.3. TransposePartition", "Subsubsection"],

Cell["\<\
A partition can be transposed (sometimes referred to as \
\[OpenCurlyDoubleQuote]conjugate\[CloseCurlyDoubleQuote] as well):\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "TransposePartition"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"TransposePartition[par] returns the transpose of the partition \
par.\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442048-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TransposePartition", "[", 
    RowBox[{"Tableau", "[", "ints___Integer", "]"}], "]"}], ":=", 
   RowBox[{"Tableau", "@@", 
    RowBox[{"TransposePartition", "[", 
     RowBox[{"{", "ints", "}"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TransposePartition", "[", 
   RowBox[{"par", ":", 
    RowBox[{"{", "___Integer", "}"}]}], "]"}], ":=", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Count", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"par", "\[GreaterEqual]", "#"}], "]"}], ",", "True"}], "]"}], 
     "&"}], ",", 
    RowBox[{"Range", "@", 
     RowBox[{"Max", "[", 
      RowBox[{"par", ",", "0"}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"TransposePartition", ",", "1"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "TransposePartition", "]"}], ";"}]}], "Input",
 InitializationCell->True],

Cell["\<\
Max[par, 0] is used to include the empty partition.\
\>", "Text"],

Cell["\<\
Note that zeros disappear under double transposition. It is not even clear \
that intermediate zeros should have been allowed in the first place, because \
they break the non-increasing condition of partitions, however we usually do \
not check input, to avoid the overhead:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransposePartition", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", "1", ",", "0", ",", "1"}], "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "1"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransposePartition", "[", "%", "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "1", ",", "1"}], "}"}]], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransposePartition", "[", 
  RowBox[{"{", "}"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
2.4. Counting partitions: PartitionsP\
\>", "Subsubsection"],

Cell[TextData[{
 "It seems there is no analytic formula for the number of partitions of an \
integer. However, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " has such function:"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"IntegerPartitions", "[", "9", "]"}], "//", "Length"}]], "Input"],

Cell[BoxData["30"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PartitionsP", "[", "9", "]"}]], "Input"],

Cell[BoxData["30"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "PartitionsP"}]], "Input"],

Cell[BoxData[
 RowBox[{
  StyleBox["\<\"\!\(\*RowBox[{\\\"PartitionsP\\\", \\\"[\\\", \
StyleBox[\\\"n\\\", \\\"TI\\\"], \\\"]\\\"}]\) gives the number \
\!\(\*RowBox[{StyleBox[\\\"p\\\", \\\"TI\\\"], RowBox[{\\\"(\\\", StyleBox[\\\
\"n\\\", \\\"TI\\\"], \\\")\\\"}]}]\) of unrestricted partitions of the \
integer \!\(\*StyleBox[\\\"n\\\", \\\"TI\\\"]\). \"\>", "MSG"], 
  "\[NonBreakingSpace]", 
  ButtonBox[
   StyleBox["\[RightSkeleton]", "SR"],
   Active->True,
   BaseStyle->"Link",
   ButtonData->"paclet:ref/PartitionsP"]}]], "Print", "PrintUsage",
 CellTags->"Info3579442049-9818602"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["2.5. HookFactor", "Subsubsection"],

Cell[TextData[{
 "A ",
 StyleBox["hook",
  FontSlant->"Italic"],
 " is a \[CapitalGamma]-shape collection of boxes,defined by the position of \
the corner box, and going to the far right and far bottom in the given \
tableau. Do not confuse it with a \[OpenCurlyDoubleQuote]Garnir hook\
\[CloseCurlyDoubleQuote], in which it has two corners (which are neighbours \
in a row)."
}], "Text"],

Cell["\<\
Here the HookFactor of a partition is defined as the **inverse** of the \
product of its hook-lengths. The hook-length of a box of a diagram of a \
partition is the number of boxes to its right plus the number of boxes under \
it plus 1 the box itself. Each box of a diagram has a hook-length. For \
example the hook factor of the partition {n} is 1/n!

QUESTION: Wouldn\[CloseCurlyQuote]t it be more natural to work with the \
product of the hook-lengths instead of its inverse? It is a bit odd to define \
something which is always of the form 1/n. Actually, this formula is \
typically used as Total[par]!/product_of_hook_lengths, so perhaps what we \
should do is multiplying by Total[par]!, which is guaranteed to give an \
integer always.\
\>", "Text"],

Cell["\<\
Frobenius determinant of a list of integers, not necessarily a partition:\
\>", "Text"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DET", "[", 
    RowBox[{"{", "x_Integer", "}"}], "]"}], ":=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DET", "[", 
     RowBox[{"{", 
      RowBox[{"xs__Integer", ",", "x_Integer"}], "}"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"DET", "[", 
      RowBox[{"{", "xs", "}"}], "]"}], 
     RowBox[{"Times", "@@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", "xs", "}"}], "-", "x"}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Special", " ", "case", " ", "to", " ", "work", " ", "with", " ", 
    "partition", " ", 
    RowBox[{"{", "}"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DET", "[", 
    RowBox[{"{", "}"}], "]"}], ":=", "1"}], ";"}]}], "Input",
 InitializationCell->True],

Cell["Rather efficient:", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"DET", "@", 
    RowBox[{"Range", "[", "100", "]"}]}], "//", "N"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.00388499999999999999847344334114040976`3.6099909364165574", ",", 
   "2.896481813596520898340534995682917663503`15.954589770191005*^6782"}], 
  "}"}]], "Output"]
}, Open  ]],

Cell["\<\
The hook factor  of a given partition:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "HookFactor"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"HookFactor[par] computes the hook factor of the partition par.\
\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442049-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HookFactor", "[", 
     RowBox[{"{", "n_Integer", "}"}], "]"}], ":=", 
    RowBox[{"1", "/", 
     RowBox[{"n", "!"}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"HookFactor", "[", 
      RowBox[{"seq", ":", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", "1", "}"}], ".."}], ")"}]}], "]"}], ":=", 
     RowBox[{"1", "/", 
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"{", "seq", "}"}], "]"}], "!"}]}]}], ";"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HookFactor", "[", "par_List", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tmppar", "=", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", "=", 
           RowBox[{"Length", "[", "par", "]"}]}], "}"}], ",", 
         RowBox[{"par", "-", 
          RowBox[{"Range", "[", "n", "]"}], "+", "n"}]}], "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"DET", "[", "tmppar", "]"}], "/", 
      RowBox[{"Apply", "[", 
       RowBox[{"Times", ",", 
        RowBox[{"Factorial", "/@", "tmppar"}]}], "]"}]}]}], " ", 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 InitializationCell->True],

Cell["Examples :", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookFactor", "[", 
  RowBox[{"{", "3", "}"}], "]"}]], "Input"],

Cell[BoxData[
 FractionBox["1", "6"]], "Output"]
}, Open  ]],

