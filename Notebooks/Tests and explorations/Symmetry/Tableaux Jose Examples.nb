Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell["\<\
2) Enumeration of all disjoint tableaux:\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "DisjointTableaux"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"DisjointTableaux[par, set] returns the list of all disjoint \
tableaux, of shape given by the partition par, that can be constructed onto \
the given set of labels. DisjointTableaux[par, n] for a positive integer n is \
interpreted as DisjointTableaux[par, Range[n]]. DisjointTableaux[par] is \
interpreted as DisjointTableaux[par, Total[par]].\"\>", 
  "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442090-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DisjointTableaux", "[", 
    RowBox[{"par", ":", 
     RowBox[{"{", "___Integer", "}"}]}], "]"}], ":=", 
   RowBox[{"DisjointTableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Total", "@", "par"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DisjointTableaux", "[", 
    RowBox[{
     RowBox[{"par", ":", 
      RowBox[{"{", "___Integer", "}"}]}], ",", 
     RowBox[{"dim_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
   RowBox[{"DisjointTableaux", "[", 
    RowBox[{"par", ",", 
     RowBox[{"Range", "[", "dim", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DisjointTableaux", "[", 
    RowBox[{
     RowBox[{"par", ":", 
      RowBox[{"{", "___Integer", "}"}]}], ",", "labels_List"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"MakeTableau", "[", 
      RowBox[{"#", ",", "par"}], "]"}], "&"}], "/@", 
    RowBox[{"Permutations", "[", 
     RowBox[{
      RowBox[{"LabelsSort", "[", "labels", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"Total", "@", "par"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"DisjointTableaux", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "DisjointTableaux", "]"}], ";"}]}], "Input",
 InitializationCell->True],

