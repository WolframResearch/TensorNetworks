 InterpretationBox[Cell[BoxData[
   FormBox[
    StyleBox[
     TagBox[GridBox[{
        {
         ItemBox["u",
          Frame->RGBColor[0, 0, 1],
          StripOnInput->False], 
         ItemBox["x",
          Frame->RGBColor[0, 0, 1],
          StripOnInput->False], 
         ItemBox["y",
          Frame->RGBColor[0, 0, 1],
          StripOnInput->False]},
        {
         ItemBox["v",
          Frame->RGBColor[0, 0, 1],
          StripOnInput->False], 
         ItemBox["z",
          Frame->RGBColor[0, 0, 1],
          StripOnInput->False], ""}
       },
       AutoDelete->False,
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
      "Grid"],
     StripOnInput->False,
     FontSize->10], TextForm]], "InlineText"],
  Text[
   Style[
    Grid[{{
       Item[Tableaux`Private`u, Frame -> RGBColor[0, 0, 1]], 
       Item[Tableaux`Private`x, Frame -> RGBColor[0, 0, 1]], 
       Item[Tableaux`Private`y, Frame -> RGBColor[0, 0, 1]]}, {
       Item[Tableaux`Private`v, Frame -> RGBColor[0, 0, 1]], 
       Item[Tableaux`Private`z, Frame -> RGBColor[0, 0, 1]]}}], FontSize -> 
    10]]]], "Output"]
}, Open  ]],

