Cell["\<\
2) This is a possible overshooting algorithm  to construct standard \
skew-tableaux from the algorithms for the respective tableaux. It can be very \
slow for those cases with many black boxes, but I don\[CloseCurlyQuote]t see \
a better way to do this...\
\>", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PatternSkewTableau", "[", 
    RowBox[{"opar_List", ",", "ipar_List", ",", "opat_", ",", "ipat_"}], 
    "]"}], ":=", 
   RowBox[{"Apply", "[", 
    RowBox[{"Tableau", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{"ipat", ",", 
           RowBox[{"First", "[", "#", "]"}]}], "]"}], ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"opat", ",", 
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], "-", 
            RowBox[{"First", "[", "#", "]"}]}]}], "]"}]}], "]"}], "&"}], "/@", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"PadRight", "[", 
          RowBox[{"ipar", ",", 
           RowBox[{"Length", "[", "opar", "]"}]}], "]"}], ",", "opar"}], 
        "}"}], "]"}]}]}], "]"}]}], ";"}]], "Input"],

