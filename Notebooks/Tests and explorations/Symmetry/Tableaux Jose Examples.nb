Cell["\<\
This is probably incorrectly programmed, because all results are trivial in \
that table.\
\>", "Text"],

Cell["\<\
2) Dominance order. It is not a total order either.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "DominanceOrder"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"DominanceOrder[par1, par2]\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442052-9818602"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DominanceOrder", "[", 
    RowBox[{"par1_List", ",", "par2_List"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", "=", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"Length", "[", "par1", "]"}], ",", 
         RowBox[{"Length", "[", "par2", "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p1", "=", 
          RowBox[{"Accumulate", "@", 
           RowBox[{"PadRight", "[", 
            RowBox[{"par1", ",", "l"}], "]"}]}]}], ",", 
         RowBox[{"p2", "=", 
          RowBox[{"Accumulate", "@", 
           RowBox[{"PadRight", "[", 
            RowBox[{"par2", ",", "l"}], "]"}]}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Which", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"p1", "===", "p2"}], ",", "0", ",", "\[IndentingNewLine]", 
         RowBox[{"And", "@@", 
          RowBox[{"LessEqual", "@@@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}], "]"}]}]}], ",", "1", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"And", "@@", 
          RowBox[{"GreaterEqual", "@@@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}], "]"}]}]}], ",", 
         RowBox[{"-", "1"}], ",", "\[IndentingNewLine]", "True", ",", "0"}], 
        "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DominanceOrder", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3"}], "}"}]}], "]"}]], "Input"],

Cell[BoxData["0"], "Output"]
}, Open  ]],

