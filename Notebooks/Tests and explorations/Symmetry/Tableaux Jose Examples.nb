Cell[CellGroupData[{

Cell["3.5. Disjoint tableaux", "Subsubsection"],

Cell["\<\
1) A disjoint tableau has no two repeated labels.To test for equality we use \
SameQ, and to test for inequality we use UnsameQ.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "DisjointTableauQ"}]], "Input"],

Cell[BoxData[
 StyleBox["\<\"DisjointTableauQ[expr] returns True if expr is a valid \
disjoint tableau, that is a Young tableau whose labels are all different. It \
returns False otherwise.\"\>", "MSG"]], "Print", "PrintUsage",
 CellTags->"Info3579442083-9818602"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"disjointQ", "[", "tab_", "]"}], ":=", 
   RowBox[{"UnsameQ", "@@", 
    RowBox[{"Join", "@@", "tab"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DisjointTableauQ", "[", 
    RowBox[{"tab", ":", 
     RowBox[{"Tableau", "[", "___List", "]"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"TableauQ", "[", "tab", "]"}], "&&", 
    RowBox[{"disjointQ", "[", "tab", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DisjointTableauQ", "[", "_", "]"}], ":=", "False"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"DisjointTableauQ", ",", "1"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "DisjointTableauQ", "]"}], ";"}]}], "Input"],

Cell["Examples :", "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DisjointTableauQ", "[", 
  RowBox[{"Tableau", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"4", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DisjointTableauQ", "[", 
