}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"UnsameOrderedQ", "[", "list_", "]"}], ":=", 
   RowBox[{"list", "===", 
    RowBox[{"Union", "[", "list", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"StandardTableauQ", "[", 
    RowBox[{"tab", ":", 
     RowBox[{"Tableau", "[", "___List", "]"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"TableauQ", "[", "tab", "]"}], "&&", 
    RowBox[{"And", "@@", 
     RowBox[{"(", 
      RowBox[{"UnsameOrderedQ", "/@", "tab"}], ")"}]}], "&&", 
    RowBox[{"And", "@@", 
     RowBox[{"(", 
      RowBox[{"UnsameOrderedQ", "/@", 
       RowBox[{"transpose", "[", "tab", "]"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"StandardTableauQ", "[", "_", "]"}], ":=", "False"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetNumberOfArguments", "[", 
   RowBox[{"StandardTableauQ", ",", "1"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Protect", "[", "StandardTableauQ", "]"}], ";"}]}], "Input",
 InitializationCell->True],

Cell[TextData[{
 "2) Now we want to generate the tableaux corresponding to a given partition. \
This code is taken from ",
 StyleBox["Combinatorica",
  FontSlant->"Italic"],
 "`, with names slightly modified:"
}], "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FirstLexicographicStandardTableau", "[", 
    RowBox[{"par", ":", 
     RowBox[{"{", "___Integer", "}"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", "=", "0"}], "}"}], ",", 
     RowBox[{"Apply", "[", 
      RowBox[{"Tableau", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"c", "+=", "#1"}], ";", 
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{"c", "-", "#1", "+", "1"}], ",", "c"}], "]"}]}], ")"}], 
          "&"}], ")"}], "/@", "par"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->True],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LastLexicographicStandardTableau", "[", 
    RowBox[{"par", ":", 
     RowBox[{"{", "__Integer", "}"}]}], "]"}], ":=", 
   RowBox[{"transpose", "[", 
    RowBox[{"FirstLexicographicStandardTableau", "[", 
     RowBox[{"TransposePartition", "[", "par", "]"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->True],

Cell[TextData[{
 "The lexicographic ordering of tableaux in ",
 StyleBox["Combinatorica",
  FontSlant->"Italic"],
 "` is confusing, and I do not think it is consistent. Anyway, it seems to be \
close to the reverse of what I want, so I have reversed First/Last/Next to \
Last/First/Previous, and added Reverse in the construction. But because that \
is not quite correct, finally there is a Sort at the end of the construction \
of the list, which brings the ordering to our convention."
}], "Text"],

