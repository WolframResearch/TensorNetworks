Cell[CellGroupData[{

Cell["Why Symmetry matters here, and how it helps", "Subsection",ExpressionUUID->"6d72fdd9-4459-4d7c-97f4-2b69c7567f0c"],

Cell[TextData[{
 "A single bond between two TN nodes is a rank-2 tensor in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2f1d9b9f-7dae-491e-b176-64dbb80f635e"],
 ". Schur-Weyl gives"
}], "Text",ExpressionUUID->"5a622303-07ba-4d32-947c-aa639d05c34e"],

Cell[TextData[{
 "$",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    SuperscriptBox[
     StyleBox["Sym",
      FontSlant->"Plain"], "2"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], " ", 
    RowBox[{"\[CirclePlus]", " "}], 
    SuperscriptBox[
     StyleBox["Anti",
      FontSlant->"Plain"], "2"], 
    RowBox[{"(", 
     StyleBox["V", "TI"], ")"}], ","}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"def8cedf-d5db-4a29-9f22-66d1136c84a3"],
 "$"
}], "Text",ExpressionUUID->"ebf73b94-b6a5-41e1-9de9-7841c597dc99"],

Cell[TextData[{
 "with dimensions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "+", "1"}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ee8cb651-b548-4fd1-a399-a93ef114121a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "-", "1"}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"df9c5f6c-cca2-45d0-8329-4af76febbc31"],
 ". If the bond carries only one parity (an antisymmetric fermionic two-body \
bond; a symmetric permutation-invariant kernel), projecting onto the correct \
sector before SVD or contraction saves the whole orthogonal sector's worth of \
bond dimension."
}], "Text",ExpressionUUID->"489ae64f-df6e-40ee-9007-5706f9aa4deb"],

Cell[TextData[{
 "For rank-2 this is the textbook formula ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["sym",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "+", 
      StyleBox["T", "TI"]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"742c99ef-107f-48ca-ab2d-d9aea2529dd8"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["anti",
      FontSlant->"Plain"]], 
    RowBox[{"(", 
     StyleBox["T", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "-", 
      StyleBox["T", "TI"]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"14d2bd4c-28cf-4865-8303-3700635fb045"],
 ", which is easy to code by hand. Two reasons ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "03a53f7e-7417-45ac-bf7b-0017ab33c3c4"],
 " is still the right tool:"
}], "Text",ExpressionUUID->"3590585d-8a9a-4755-a79c-b6d64efebdf4"],

Cell[TextData[{
 StyleBox["Rank generalisation.",
  FontWeight->"Bold"],
 " Beyond rank 2 the hand-coded symmetriser is a sum of up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "!"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f1c9d966-4e53-480f-8043-6375c43e4e7b"],
 " signed permutations, and mixed-symmetry diagrams require sequential \
row-symmetrise + column-antisymmetrise. ",
 Cell[BoxData[
  RowBox[{"YoungProject", "[", 
   RowBox[{"T", ",", " ", 
    RowBox[{"YoungTableau", "[", "t", "]"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"fcefe7a0-5a54-4646-a763-c022f47cb4ca"],
 " is the same one-line call for any rank and any Young diagram."
}], "ItemNumbered",ExpressionUUID->"6a2644f0-c4eb-46c0-9cba-76273f3deab4"],

Cell[TextData[{
 StyleBox["Built-in normalisation.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "459eb800-8a58-4047-80df-bab9c7ad15ec"],
 " carries the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], "\[Lambda]"], "/", 
    StyleBox["n", "TI"], "!"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"030bcb15-b143-45b3-b760-8b1b823103d0"],
 " prefactor that makes it idempotent (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["P", "TI"], "2"], "\[LongEqual]", 
    StyleBox["P", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3778366c-3a3e-4b8b-b4f5-d22b21475f27"],
 "). The unnormalised Young symmetrizer (also exported, as ",
 Cell[BoxData[
 "YoungSymmetrize"], "InlineFormula",ExpressionUUID->
  "067fc284-5f4c-457e-ade3-6317e7fd1701"],
 ") satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["T", "TI"], "2"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["n", "TI"], "!", "/", 
      SubscriptBox[
       StyleBox["d", "TI"], "\[Lambda]"]}], ")"}], " ", 
    SubscriptBox[
     StyleBox["e", "TI"], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"add084a2-32d3-4230-b472-8d2816d3d5e3"],
 " instead; hand-rolled symmetrisers typically forget the prefactor. The \
idempotent form is what iterative TN algorithms (DMRG, TDVP) need when a \
projector is applied repeatedly."
}], "ItemNumbered",ExpressionUUID->"7840ebcf-57f4-454f-bdfd-8c29ef1d0378"],

Cell[TextData[{
 "This is the warm-up case: the mechanism on the simplest possible bond \
before Tier 1 scales it to general ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"73dafec1-831a-4a97-8fe1-82865fdb8d69"],
 "."
}], "Text",ExpressionUUID->"4cccde56-b288-41d6-b3f4-066951378218"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Code", "Subsection",ExpressionUUID->"8cc6f99b-3b0f-4f2c-b61c-cf6de539c0c5"],

Cell[TextData[{
 "A generic rank-2 tensor with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"3ec48f73-e333-4384-9c7c-be378e3d3552"],
 ":"
}], "Text",ExpressionUUID->"43bbd12e-fe9a-4e8c-8414-8c6c1ca210e6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"d", " ", "=", " ", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "2026", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"T", " ", "=", " ", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Psym", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T", ",", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Pant", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T", ",", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "1", "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "}"}], "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"f059d083-bade-48cd-9f78-ea96429af0ef"],

Cell["The two projectors recover the original tensor:", "Text",ExpressionUUID->"c9ef9e3e-623e-42e6-b712-cbffe866355b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Psym", " ", "+", " ", "Pant", " ", "-", " ", "T"}], "]"}], 
    "]"}], "]"}], " ", "<", " ", "tol"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"a4d797a6-6e18-4e15-b7b1-f93a242312eb"],

