}, Open  ]],

Cell[TextData[{
 "The numerical spectrum from ",
 Cell[BoxData[
  RowBox[{"Eigenvalues", "[", "Hmat", "]"}]], "InlineFormula",ExpressionUUID->
  "75ab0d0c-c7d1-4e17-a2e0-77d4334ac384"],
 " and the closed-form prediction from Symmetry primitives agree exactly. The \
\"diagonalisation\" of ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c0744359-9375-456a-adff-6f2af0a70a2e"],
 " never actually needed ",
 Cell[BoxData[
 "Eigenvalues"], "InlineFormula",ExpressionUUID->
  "aa61f81b-0735-429f-91fc-aa2789bec7c2"],
 ": it needed ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "67237f30-ebae-4223-941c-bfa983b7c9e7"],
 ", ",
 Cell[BoxData[
 "schurDim"], "InlineFormula",ExpressionUUID->
  "d14311c1-b8aa-41d6-aa3a-45459370bb32"],
 ", and ",
 Cell[BoxData[
 "contentSum"], "InlineFormula",ExpressionUUID->
  "1327572f-1f6a-4109-a436-c8928a6b570a"],
 "."
}], "Text",ExpressionUUID->"f1214353-5d71-45a9-a861-f503379e3422"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tier 2: foundational Symmetry-subcontext usage", "Title",ExpressionUUID->"35c8473b-63ae-4bd4-a92e-d71c96c79714"],

Cell[TextData[{
 "These two examples make a single, surgical use of ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "467b2573-7a5e-45b5-924f-e7712f7765e6"],
 " (and the ",
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "fb3277fd-68dc-452c-aba8-29ec9693351d"],
 " that names the target irrep). The Symmetry-symbol count is lower, but the \
use is ",
 StyleBox["irreplaceable", "TI"],
 ": built-in WL canonicalisation cannot do the same job. For multi-term \
symmetry constraints (Example C) and for imposing exact parity on a bond \
(Example D), ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "99281592-f85e-4e55-ac45-6dfddbfb20b6"],
 " is the only WL primitive that does the right thing."
}], "Text",ExpressionUUID->"8782f81c-5f35-40e9-8c73-ac6fed3f4a45"],

Cell[CellGroupData[{

Cell["Example C. Riemann tensor as a TN node", "Section",ExpressionUUID->"bc846eb9-c326-48e3-b321-836e3ed1b48b"],

Cell[CellGroupData[{

Cell["Symmetry-subcontext functions used", "Subsection",ExpressionUUID->"9dbb97f4-a8b5-4d6a-bb3f-cb0e4e565115"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"1897a932-da20-4295-80c2-5d4fdcceb984"],
 " \[LongDash] encodes the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"2", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5e240257-c5fd-4d63-afd9-403ca2feb8f8"],
 " Young diagram with the slot labelling that defines Riemann symmetry."
}], "Item",ExpressionUUID->"b8d99456-96db-4225-af99-b5ed61b7573c"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"YoungProject", "[", 
   RowBox[{"T", ",", " ", "..."}], "]"}]], "InlineFormula",ExpressionUUID->
  "a422c992-d87c-4e0b-95f1-c99480b47728"],
 " \[LongDash] projects a generic rank-4 tensor onto the (2,2) irrep \
subspace, in one call."
}], "Item",ExpressionUUID->"693753da-5f6f-4163-8ebb-bad1e2c2d970"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Why Symmetry matters here, and how it helps", "Subsection",ExpressionUUID->"744dfc08-9aa3-40eb-810c-1ad33a567b43"],

Cell[TextData[{
 "The Riemann curvature tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"a", "b", "c", "d"}], "TI"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bd5fd577-d7a4-406c-9a0e-e366e218c7c9"],
 " satisfies four constraints:"
}], "Text",ExpressionUUID->"43781696-2ba7-4445-ba53-5fd58732c378"],

Cell[TextData[{
 "antisymmetry in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"09eab47d-c9f8-4703-b305-53532024dd9b"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox[
       RowBox[{"a", "b", "c", "d"}], "TI"]], "\[LongEqual]", 
     RowBox[{"-", 
      SubscriptBox[
       StyleBox["R", "TI"], 
       StyleBox[
        RowBox[{"b", "a", "c", "d"}], "TI"]]}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"5dd57935-d5c2-41e8-9b01-007376fb5126"],
 ","
}], "ItemNumbered",ExpressionUUID->"977f511a-62f1-42e1-8edf-953d5fd639e7"],

Cell[TextData[{
 "antisymmetry in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["c", "TI"], ",", 
     StyleBox["d", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"885dce5e-fcde-4d6c-a5a9-c3ef85e04733"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox[
       RowBox[{"a", "b", "c", "d"}], "TI"]], "\[LongEqual]", 
     RowBox[{"-", 
      SubscriptBox[
       StyleBox["R", "TI"], 
       StyleBox[
        RowBox[{"a", "b", "d", "c"}], "TI"]]}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7f87c6e3-1760-42ee-b942-79ea7e45d5e7"],
 ","
}], "ItemNumbered",ExpressionUUID->"72ba8146-f22f-4c3f-b4a6-cb5c590ded4c"],

Cell[TextData[{
 "pair-swap symmetry: ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox[
       RowBox[{"a", "b", "c", "d"}], "TI"]], "\[LongEqual]", 
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox[
       RowBox[{"c", "d", "a", "b"}], "TI"]]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"32a28cf0-8145-425b-a69d-2db51909df99"],
 ","
}], "ItemNumbered",ExpressionUUID->"892f6c92-e627-402e-8405-fa35e9b1eb1f"],

Cell["first Bianchi identity:", "ItemNumbered",ExpressionUUID->"7d907506-27aa-43f1-bf34-d5bacef84b19"],

Cell[TextData[{
 "$",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "c", "d", "b"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "d", "b", "c"}], "TI"]], " ", 
    RowBox[{"\[LongEqual]", " "}], "0."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"76a7438f-4640-4f3d-92f5-0f8dbad3a090"],
 "$"
}], "Text",ExpressionUUID->"d6067f40-c904-436f-8a49-e71580426268"],

Cell[TextData[{
 "The first three are ",
 StyleBox["single-term", "TI"],
 " slot symmetries: each has the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], "\[Sigma]"], "\[LongEqual]", "\[Phi]", 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f05944ee-d87c-4247-8ef5-bed3b9a66c57"],
 " for one permutation ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7d9d55b8-c8e0-4c6c-b0ae-af36683c4c6c"],
 " and sign ",
 Cell[BoxData[
  FormBox["\[Phi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f490c8ca-4420-474c-95fc-1cf3cb40f5e4"],
 ". Built-in WL canonicalisation (",
 Cell[BoxData[
 "TensorReduce"], "InlineFormula",ExpressionUUID->
  "720461c4-452f-43fe-9f24-80f1202a832e"],
 " + ",
 Cell[BoxData[
  RowBox[{"Arrays", "[", 
   RowBox[{"...", ",", " ", "sym"}], "]"}]], "InlineFormula",ExpressionUUID->
  "a2941191-ba53-43a7-b256-4ce2e59bbb40"],
 ") covers exactly this kind. The first Bianchi identity is ",
 StyleBox["multi-term",
  FontWeight->"Bold"],
 ": it asserts ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["R", "TI"], "+", 
    SuperscriptBox[
     StyleBox["R", "TI"], 
     SubscriptBox["\[Sigma]", "1"]], "+", 
    SuperscriptBox[
     StyleBox["R", "TI"], 
     SubscriptBox["\[Sigma]", "2"]], "\[LongEqual]", "0"}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"0294dc03-dd01-41e6-a6c5-740a4966a9dc"],
 ", where no single ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Sigma]", ",", "\[Phi]"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9d574a27-afd6-4c10-b280-d77b62bb186a"],
 " pair reproduces ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cfe91479-b7d7-4444-9a5e-dc77d7e42e3e"],
 ". No slot-permutation canonicalizer can prove a multi-term identity from \
single-term generators."
}], "Text",ExpressionUUID->"1a0e527c-58c7-4e43-90c5-3c301b0889bb"],

Cell[TextData[{
 "Riemann symmetry is in fact the full content of ",
 StyleBox["one", "TI"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8abd089d-dc8f-4f20-b1f0-975a37f9efeb"],
 " irrep, the one labelled by the Young diagram ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"2", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cd2da1a2-793c-45f0-92bf-eec5da922ade"],
 ". All four constraints follow from membership in that single irrep. ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "b4a94100-a2a8-47dd-91e3-ba848ffebead"],
 " is the only WL primitive that projects onto an ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "626bc3dc-5f92-4db1-b180-700731cb9a32"],
 " irrep, and one call enforces every Riemann constraint at once."
}], "Text",ExpressionUUID->"1abeb8e4-d189-4eae-8d78-646620d8403d"],

Cell[TextData[{
 "After projection, downstream TN operations (",
 Cell[BoxData[
 "TensorContract"], "InlineFormula",ExpressionUUID->
  "a9eb686d-5008-414d-8438-ba996ea5b29c"],
 ", traces, index raising) preserve the irrep structure automatically. The \
Euclidean Ricci contraction ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"b", "d"}], "TI"]], "\[LongEqual]", 
    SuperscriptBox["\[Delta]", 
     StyleBox[
      RowBox[{"a", "c"}], "TI"]], 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"1808dbc0-5c49-42a2-8ec7-370486b52fbe"],
 " comes out symmetric because the source lived in the right subspace, not by \
a separate re-symmetrisation step."
}], "Text",ExpressionUUID->"e3c0e5ca-dd26-4b91-9d72-3f914a667274"],

Cell[TextData[{
 "The structural gap opens at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"2dd4c7cf-6bf6-4fb5-89c3-ea7afc42c34f"],
 ". The true number of independent Riemann components is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["n", "TI"], "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["n", "TI"], "2"], "-", "1"}], ")"}], "/", "12"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "04fc4a2e-7177-4071-a43b-a30e1d36faf7"],
 ". ",
 Cell[BoxData[
  RowBox[{"Arrays", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "n", ",", "n", ",", "n"}], "}"}], ",", " ", "sym"}], 
   "]"}]], "InlineFormula",ExpressionUUID->
  "bf9bc928-abd6-4514-ad06-38d3f15de659"],
 " over-counts this by the Bianchi degrees of freedom: 1 extra component at \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"5438267d-c399-4c65-a1b1-99d7aebd49b2"],
 " (orbit 21 vs. true 20), 5 extra at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "5"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6067f272-5c62-4802-8c28-860f201678f2"],
 " (orbit 55 vs. true 50), growing. For curvature-scalar networks, \
Weyl-tensor contractions, or any rank-4 TN node with Riemann symmetry, ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "ad43f2c7-5f18-470f-932f-a14a030ecd3d"],
 " is the only tool that produces the correct subspace."
}], "Text",ExpressionUUID->"363ec86f-cba4-4728-a2e3-567b9b9b2367"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Code", "Subsection",ExpressionUUID->"605ff9aa-f44a-41f3-8422-af19cd038bea"],

Cell[TextData[{
 "Start with a generic rank-4 tensor and project onto the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"2", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"274ece0d-066d-4f72-9ce2-916165776c3f"],
 " Riemann irrep:"
}], "Text",ExpressionUUID->"6443057d-3bff-4014-a7e6-6de18f439cd7"],

Cell[BoxData[{
 RowBox[{
