Cell["\<\
The closed-form prediction and the explicit projector rank agree on every \
row, including the rows where the block is identically zero (so no allocation \
is wasted on those sectors).\
\>", "Text",ExpressionUUID->"b9007527-2b04-4708-9288-75b7d448ce37"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Example B. $V^{\\otimes 3}$ block-diagonalisation under sum-of-pair-swaps\
\>", "Section",ExpressionUUID->"9abab35d-eb1f-4718-93be-1f5dccbee577"],

Cell[CellGroupData[{

Cell["Symmetry-subcontext functions used", "Subsection",ExpressionUUID->"b3c3bf1c-c12d-48e8-b66f-34dc4ceb0b4e"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", "t", "]"}]], "InlineFormula",ExpressionUUID->
  "33d7314a-dbea-424c-a211-a3bb8d69dc0b"],
 " \[LongDash] one per standard tableau, four times in this example (one for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "3", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "76eddd43-479b-41a2-a728-292d7482d8a1"],
 ", two for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"91a50c4b-35fe-483a-ac88-134229612453"],
 ", one for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9a2e1402-9d68-4ef7-a09e-4d74902e0d14"],
 ")."
}], "Item",ExpressionUUID->"1ff17db1-67fb-4081-bf3c-4997fe4c70bb"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"YoungProject", "[", 
   RowBox[{"T", ",", " ", 
    RowBox[{"YoungTableau", "[", "t", "]"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"50a98ad1-c9c6-4744-a2f2-1262d3c437a1"],
 " \[LongDash] projects ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d468cd66-4612-4e50-bda1-8caaf9798e26"],
 " onto each tableau; for the mixed-symmetry irrep we sum two ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "8592197e-8763-4a3c-ab35-586e44e1c3bd"],
 " calls to form the isotypic projector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], 
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8f78fd1f-7635-4549-8f6e-898839d8edf9"],
 "."
}], "Item",ExpressionUUID->"fc279a76-0a44-4cc8-b547-1155ddea824a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"TableauDimension", "[", "par", "]"}]], "InlineFormula",
  ExpressionUUID->"f79a6bde-ab88-4de4-8284-09f52c77f54f"],
 " \[LongDash] gives the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bff40f36-2389-45ce-86a6-d9b098d496c3"],
 "-irrep dimension that equals the number of standard tableaux of shape ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f572cccc-4338-49f7-ab11-ff2ab621d2e0"],
 "."
}], "Item",ExpressionUUID->"ec3ab726-52ce-4a8d-9a75-6fb6d25008b6"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HookLengths", "[", "par", "]"}]], "InlineFormula",ExpressionUUID->
  "c2accb71-f498-4643-a6ec-3b169aafa1f0"],
 " (via ",
 Cell[BoxData[
 "schurDim"], "InlineFormula",ExpressionUUID->
  "b75ba6ed-6da2-499b-8b38-3d77619c8b62"],
 ") \[LongDash] used to evaluate the GL(d) factor in the Schur-Weyl \
multiplicity."
}], "Item",ExpressionUUID->"15952ac9-21b9-4317-abeb-afb43079ef1f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Why Symmetry matters here, and how it helps", "Subsection",ExpressionUUID->"3756d265-fccc-486f-907a-c69ce411c59a"],

Cell[TextData[{
 "The sum of pair-swaps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "<", 
      StyleBox["j", "TI"]}],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7c95b5c4-dd33-4d9b-927a-5e31db32a465"],
 " is a class function of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f0ee6849-6cfe-4bae-bd41-3fd2c106e377"],
 ". By Schur-Weyl it commutes with every isotypic projector and acts as a \
scalar on each block. For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"87190b01-7bcc-44bb-b72f-13cefa509457"],
 " that means ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "273029f8-6eb6-4b95-9023-f63dc1cda4b6"],
 " has at most three distinct eigenvalues, one per partition of ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "743e2e7e-4286-44b7-ba89-5a85e7d84f6a"],
 ", with multiplicity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], "\[Lambda]"], "\[LongEqual]", "dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], "\[CenterDot]", "dim", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"adccc511-c5e9-4406-923a-90caccaf597d"],
 "."
}], "Text",ExpressionUUID->"334938d6-abb5-47b1-bf44-454c771f1ce7"],

Cell[TextData[{
 "The eigenvalue on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6713628c-8e7a-48f7-a50e-a910df2f4159"],
 " is the content sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], 
    RowBox[{"(", "\[Lambda]", ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        StyleBox["i", "TI"], ",", 
        StyleBox["j", "TI"]}], ")"}], "\[Element]", "\[Lambda]"}],
     LimitsPositioning->True], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["j", "TI"], "-", 
      StyleBox["i", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cc4c8e5b-396b-418a-9d9e-7a891ae23fc2"],
 ": a one-line formula that needs no diagonalisation. For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b8a2ccbc-54eb-40b4-bef5-1f58dd63bb99"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], 
    RowBox[{"(", 
     RowBox[{"{", "3", "}"}], ")"}], "\[LongEqual]", 
    RowBox[{"+", "3"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8b5d40aa-85bf-4ec0-9dd2-ba39569efc30"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], 
    RowBox[{"(", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], ")"}], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d8c2541f-e7f5-40b3-ab2b-f9531300ee70"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], 
    RowBox[{"(", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}], ")"}], "\[LongEqual]", 
    RowBox[{"-", "3"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6e16ba6e-bb2a-4b64-91d5-bd2cbfbcf2aa"],
 ". (The same formula gives the eigenvalue of any class-function Hamiltonian \
made from transpositions on any number of sites.)"
}], "Text",ExpressionUUID->"794c3624-0a5d-418c-bdc9-0efb4c10dac4"],

Cell["The Symmetry subcontext provides the three pieces:", "Text",ExpressionUUID->"7533ee8d-b3aa-4ba3-8ead-44c0a9230d9f"],

Cell[TextData[{
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "dff8b509-d4f9-43d6-838f-09f004c168f9"],
 " on each standard tableau of ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3dfcbf79-2e6a-4b62-b28f-65663da9bfaa"],
 ". Each call is a ",
 StyleBox["minimal", "TI"],
 " idempotent; summing over all standard tableaux of a shape (two of them for \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1e3a0e91-4419-446f-823b-7f702f8d9fa5"],
 ") gives the isotypic projector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ae86460f-201f-42e2-87b7-97f03e3738b4"],
 "."
}], "Item",ExpressionUUID->"463597da-6b41-4bab-a8db-725f512aea14"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"TableauDimension", "[", "par", "]"}]], "InlineFormula",
  ExpressionUUID->"d717ca5c-57cc-4ea6-895b-c91063106589"],
 " returns ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4b96381a-6c84-46ee-8e7e-da62138dda92"],
 ", which by the RSK correspondence equals the number of standard tableaux of \
shape ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "99b6dbb7-e672-460b-a00e-828df4a26029"],
 ". Both meanings are used here: as a factor in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f56894fb-ac90-4541-8b6b-6c3be09281e0"],
 ", and as the count of ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "5fccf03a-b373-44f4-90fe-265075bdecfc"],
 " calls summed inside ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"81f75708-c6fc-452c-8df4-0941b47ffa08"],
 "."
}], "Item",ExpressionUUID->"cb683442-ea40-4347-9de0-47fe6bdd8d1d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HookLengths", "[", "par", "]"}]], "InlineFormula",ExpressionUUID->
  "e11e64e6-8c7e-4432-ace6-97d190d597bc"],
 " feeds ",
 Cell[BoxData[
 "schurDim"], "InlineFormula",ExpressionUUID->
  "7d6f9877-e7f1-4fd4-978b-48478fbe8bdf"],
 " for the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GL",
     FontSlant->"Plain"], "(", 
    StyleBox["d", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"642475d1-436d-4dcc-a8f7-2ccb781ef303"],
 " factor."
}], "Item",ExpressionUUID->"a9de0571-a744-4e26-9bce-745a142095bf"],

Cell[TextData[{
 "The payoff: per-block diagonalisation costs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", "\[Lambda]",
     LimitsPositioning->True], 
    SubsuperscriptBox[
     StyleBox["m", "TI"], "\[Lambda]", "3"]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7e202efe-ad0f-4513-a967-cc63fd818327"],
 " instead of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    SuperscriptBox[
     StyleBox["d", "TI"], 
     RowBox[{"3", 
      StyleBox["n", "TI"]}]], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"95b42e5c-1695-4ca0-b90e-307ac156ffdf"],
 ". For class-function Hamiltonians the eigenvalues themselves come from the \
partitions, not from any numerical diagonalisation."
}], "Text",ExpressionUUID->"e269a089-0a83-4dd1-801c-8382e2bfb0ee"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Code", "Subsection",ExpressionUUID->"2205774c-3ddc-4dfc-a15f-6750b7c2a832"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"d", " ", "=", " ", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"T", " ", "=", " ", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"d", ",", " ", "d", ",", " ", "d"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"e3", "   ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T", ",", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "}"}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e21", "  ", "=", " ", 
   RowBox[{
    RowBox[{"YoungProject", "[", 
     RowBox[{"T", ",", " ", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", "3", "}"}]}], "}"}], "]"}]}], "]"}], " ", "+", "\n", 
    "       ", 
    RowBox[{"YoungProject", "[", 
     RowBox[{"T", ",", " ", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "}"}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e111", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T", ",", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "1", "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}], ",", " ", 
        RowBox[{"{", "3", "}"}]}], "}"}], "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"60e2b867-e916-455b-90e4-db74d6f929c5"],

Cell[TextData[{
 "Completeness (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["E", "TI"], 
     RowBox[{"{", "3", "}"}]], "+", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}]], "+", 
    SubscriptBox[
     StyleBox["E", "TI"], 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}]], "\[LongEqual]", 
    StyleBox["id",
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b2e2892f-5f21-461b-b688-30ce74f28397"],
 " on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", "3"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1903eb50-b3c1-4f87-b53a-c7618a1fa280"],
 "):"
}], "Text",ExpressionUUID->"39b88ee1-12f7-4eb2-83bd-19b4e6bf9e3a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{
     "e3", " ", "+", " ", "e21", " ", "+", " ", "e111", " ", "-", " ", "T"}], 
     "]"}], "]"}], "]"}], " ", "<", " ", "tol"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"73190d2f-f9c6-40da-bc20-09d500d5f2ff"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"daf91f23-3de2-4258-badf-0491888a6192"]
}, Open  ]],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a663eb52-9c7f-4718-bddd-69aef46fbf94"],
 " the antisymmetric piece vanishes identically (cannot antisymmetrize three \
slots in two values):"
}], "Text",ExpressionUUID->"377144b4-3774-4b19-bfb4-6bac9fbd9c19"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", "e111", "]"}], "]"}], "]"}], " ", "<", " ", 
  "tol"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"41f75a99-65db-43e7-ac1a-7ea5e15b98fb"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"7af9c623-c0f2-4d17-9986-d6d71189aee8"]
}, Open  ]],

Cell[TextData[{
 "Predicted block dimensions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], "\[Lambda]"], "\[LongEqual]", "dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], "\[CenterDot]", "dim", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"75b01aee-509d-431a-9695-750b4fd6a7f3"],
 ", then measured projector ranks:"
}], "Text",ExpressionUUID->"6ca42935-8b15-4d79-8920-3723c57acaa0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"{", "\n", "    ", 
   RowBox[{
    RowBox[{
     RowBox[{"TableauDimension", "[", 
      RowBox[{"{", "3", "}"}], "]"}], "       ", "*", " ", 
     RowBox[{"schurDim", "[", 
      RowBox[{
       RowBox[{"{", "3", "}"}], ",", " ", "d"}], "]"}]}], ",", "         ", 
    RowBox[{"(*", " ", "4", " ", "*)"}], "\n", "    ", 
    RowBox[{
     RowBox[{"TableauDimension", "[", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], "    ", "*", " ", 
     RowBox[{"schurDim", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", "d"}], "]"}]}], ",", 
    "      ", 
    RowBox[{"(*", " ", "4", " ", "*)"}], "\n", "    ", 
    RowBox[{
     RowBox[{"TableauDimension", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "]"}], " ", "*", 
     " ", 
     RowBox[{"schurDim", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", "d"}], 
      "]"}]}]}], "    ", 
   RowBox[{"(*", " ", "0", " ", "*)"}], "\n", "}"}], "\n"}], "\n", 
 RowBox[{"{", "\n", "    ", 
  RowBox[{
   RowBox[{"irrepRank", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "}"}], "}"}], ",",
      " ", "d", ",", " ", "3"}], "]"}], ",", "                         ", 
   RowBox[{"(*", " ", "4", " ", "*)"}], "\n", "    ", 
   RowBox[{"irrepRank", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", "3", "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "}"}]}], "}"}], ",", " ", "d", ",", " ", 
     "3"}], "]"}], ",", "        ", 
   RowBox[{"(*", " ", "4", " ", "*)"}], "\n", "    ", 
   RowBox[{"irrepRank", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "1", "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}], ",", " ", 
        RowBox[{"{", "3", "}"}]}], "}"}], "}"}], ",", " ", "d", ",", " ", 
     "3"}], "]"}]}], "                      ", 
  RowBox[{"(*", " ", "0", " ", "*)"}], "\n", "}"}]}], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"ea6c9bf0-915c-4fca-b5a5-549640c863ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "4", ",", "0"}], "}"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"56bcb58f-05d6-451f-acaf-7799e10df43f"]
}, Open  ]],

Cell[TextData[{
 "Build the operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["P", "TI"], "12"], "+", 
    SubscriptBox[
     StyleBox["P", "TI"], "13"], "+", 
    SubscriptBox[
     StyleBox["P", "TI"], "23"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b28eb891-2cbc-4255-9e10-5b1c922ae8cd"],
 " as a ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["d", "TI"], "3"], "\[Cross]", 
    SuperscriptBox[
     StyleBox["d", "TI"], "3"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1c8d24c3-386f-4524-bbdc-6c69e0aa8e1a"],
 " matrix and diagonalise:"
}], "Text",ExpressionUUID->"f967cc84-1381-4cc7-84af-b37a2e485ac8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"applySwap", "[", 
     RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"perm", " ", "=", " ", 
        RowBox[{"Range", "[", "3", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"perm", "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], "]"}], " ", "=", " ", 
        RowBox[{"perm", "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "a"}], "}"}], "]"}], "]"}]}], ";", "\n", 
       "    ", 
       RowBox[{"ArrayReshape", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"Transpose", "[", "\n", "            ", 
          RowBox[{
           RowBox[{"Normal", " ", "@", " ", 
            RowBox[{"SparseArray", "[", "\n", "                ", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    "i", ",", " ", "j", ",", " ", "k", ",", " ", "i", ",", 
                    " ", "j", ",", " ", "k"}], "}"}], " ", "->", " ", "1"}], ",",
                   "\n", "                    ", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", " ", "d"}], "}"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"j", ",", " ", "d"}], "}"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"k", ",", " ", "d"}], "}"}]}], "]"}], ",", " ", 
                "2"}], "]"}], ",", "\n", "                ", 
              RowBox[{"{", 
               RowBox[{
               "d", ",", " ", "d", ",", " ", "d", ",", " ", "d", ",", " ", 
                "d", ",", " ", "d"}], "}"}]}], "\n", "            ", "]"}]}], 
           ",", "\n", "            ", 
           RowBox[{"Join", "[", 
            RowBox[{"perm", ",", " ", 
             RowBox[{"{", 
              RowBox[{"4", ",", " ", "5", ",", " ", "6"}], "}"}]}], "]"}]}], 
          "\n", "        ", "]"}], ",", "\n", "        ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"d", "^", "3"}], ",", " ", 
           RowBox[{"d", "^", "3"}]}], "}"}]}], "\n", "    ", "]"}]}]}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Hmat", " ", "=", " ", 
    RowBox[{
     RowBox[{"applySwap", "[", 
      RowBox[{"1", ",", " ", "2"}], "]"}], " ", "+", " ", 
     RowBox[{"applySwap", "[", 
      RowBox[{"1", ",", " ", "3"}], "]"}], " ", "+", " ", 
     RowBox[{"applySwap", "[", 
      RowBox[{"2", ",", " ", "3"}], "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{"Sort", "[", 
  RowBox[{
   RowBox[{"Eigenvalues", "[", "Hmat", "]"}], ",", " ", "Greater"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
    "3", ",", " ", "3", ",", " ", "3", ",", " ", "3", ",", " ", "0", ",", " ",
      "0", ",", " ", "0", ",", " ", "0"}], "}"}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"b08c9a04-e5ee-43cb-9d7b-20a41b312727"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "3", ",", "3", ",", "3", ",", "3", ",", "0", ",", "0", ",", "0", ",", "0"}],
   "}"}]], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"91e8dfc4-ba26-4eeb-861d-c0108e6c585b"]
}, Open  ]],

Cell[TextData[{
 "Predicted spectrum from content sums: each irrep contributes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"904b1910-3aaa-44c4-a608-ae3e8420cedd"],
 " copies at eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], "(", "\[Lambda]", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"773b747a-905b-411e-8fa1-82bb0c958897"],
 "."
}], "Text",ExpressionUUID->"307d1f44-0883-4775-b483-103faa45b358"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Sort", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"Flatten", " ", "@", " ", 
    RowBox[{"{", "\n", "        ", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"contentSum", "[", 
         RowBox[{"{", "3", "}"}], "]"}], ",", "       ", 
        RowBox[{
         RowBox[{"TableauDimension", "[", 
          RowBox[{"{", "3", "}"}], "]"}], "       ", "*", " ", 
         RowBox[{"schurDim", "[", 
          RowBox[{
           RowBox[{"{", "3", "}"}], ",", " ", "d"}], "]"}]}]}], "]"}], ",", 
      "\n", "        ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"contentSum", "[", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], ",", "    ", 
        RowBox[{
         RowBox[{"TableauDimension", "[", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], "    ", "*", " ", 
         RowBox[{"schurDim", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", "d"}], "]"}]}]}], 
       "]"}], ",", "\n", "        ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"contentSum", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"TableauDimension", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "]"}], " ", "*",
          " ", 
         RowBox[{"schurDim", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
           "d"}], "]"}]}]}], "]"}]}], "\n", "    ", "}"}]}], ",", "\n", 
   "    ", "Greater"}], "\n", "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
    "3", ",", " ", "3", ",", " ", "3", ",", " ", "3", ",", " ", "0", ",", " ",
      "0", ",", " ", "0", ",", " ", "0"}], "}"}], " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"02ce7e7d-5f39-4de6-96db-b1ea2a830df9"],

Cell[BoxData[
 RowBox[{"{", 
