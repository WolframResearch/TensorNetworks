Cell[TextData[{
 "Two ",
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "4737c3ac-8a74-4cdd-a5da-0a72eaa9af40"],
 " / ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "75ec9dd4-d3b6-4a47-8c8e-48ffd6aa1d87"],
 " calls in total, but each one does work that no slot-permutation \
canonicalizer can do. Once ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "40548bff-fae9-4500-8e6a-2ebca5cd7566"],
 " is projected, the rest of the TN proceeds with no further intervention."
}], "Text",ExpressionUUID->"dabddc41-cc60-404b-9605-9583a822c630"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example D. $V \\otimes V$ Schur-Weyl on a single bond", "Section",ExpressionUUID->"c5970670-56cf-4d57-bb7b-8b7534d33ac0"],

Cell[CellGroupData[{

Cell["Symmetry-subcontext functions used", "Subsection",ExpressionUUID->"165c26f2-c1b7-4748-ab10-07773db4b969"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"33b30683-1294-475d-b17c-3927a23c7abe"],
 " \[LongDash] the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cde17f05-c40f-4cf4-a3f5-46d2861d957d"],
 " partition (symmetric)."
}], "Item",ExpressionUUID->"84917bac-0142-4fd9-ab86-58900d3a3d16"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", "2", "}"}]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "7e160632-cd25-4a34-a63f-e6721a47b8e6"],
 " \[LongDash] the ",
 Cell[BoxData[
