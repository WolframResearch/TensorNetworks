Cell[CellGroupData[{

Cell["Recap", "Section",ExpressionUUID->"9c40de55-d192-41cf-a60e-f820c32f0c48"],

Cell["\<\
The tiers map to the operational ladder of a symmetry-resolved TN workflow:\
\>", "Text",ExpressionUUID->"3bcecb2f-fa43-4211-939e-e042a9a3eaed"],

Cell[TextData[{
 StyleBox["Tier 1: sizing and block-diagonalisation.",
  FontWeight->"Bold"],
 " Examples A and B give (a) the size of each isotypic block on a bond, and \
(b) the full eigenstructure of any class-function Hamiltonian on that bond, \
both in closed form. ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "fe653ae3-af94-4323-aea8-a8601d772380"],
 " and ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "60d91c1b-0e34-4da8-a255-50e68aa16f97"],
 " carry the math; ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "4a37e710-59ef-4e0c-bef9-b6deb32290b9"],
 " only appears in the verification step."
}], "ItemNumbered",ExpressionUUID->"db67e6a0-fe76-4fc5-a978-39195d97602f"],

Cell[TextData[{
 StyleBox["Tier 2: multi-term constraint enforcement.",
  FontWeight->"Bold"],
 " Example C is the case built-in WL canonicalisation cannot reach: the first \
Bianchi identity. Example D is the rank-2 warm-up of the same mechanism."
}], "ItemNumbered",ExpressionUUID->"b1cee6e0-e316-4ffe-8048-9ff92f7ea521"],

Cell[TextData[{
 "Every assertion above is verified by ",
 ButtonBox["symmetry_for_tn.wl",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["symmetry_for_tn.wl"], None}],
 " (green under ",
 Cell[BoxData[
  RowBox[{"wolframscript", " ", "-", "file"}]], "InlineFormula",
  ExpressionUUID->"2b31938a-b268-484c-9738-87bc7e23a7ee"],
 "). ",
 ButtonBox["SymmetryForTN.nb",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["SymmetryForTN.nb"], None}],
 " reproduces the same content with rendered TraditionalForm math."
}], "Text",ExpressionUUID->"08aaa47c-c08c-45a9-82a1-bf4756e830b4"]
}, Open  ]]
}, Open  ]]
