Cell[TextData[{
 "A few helpers used throughout. ",
 Cell[BoxData[
  RowBox[{"schurDim", "[", 
   RowBox[{"par", ",", " ", "d"}], "]"}]], "InlineFormula",ExpressionUUID->
  "95ad7308-dd14-4202-ae9e-1ed84ffd4e77"],
 " is the Weyl dimension of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["GL",
     FontSlant->"Plain"], "(", 
    StyleBox["d", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"12dded44-8a23-4559-a653-95e384ff4465"],
 " irrep ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], "(", 
    SuperscriptBox[
     StyleBox["C",
      FontSlant->"Plain"], 
     StyleBox["d", "TI"]], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9d544424-d5d7-45f6-9339-86b920a2df97"],
 " via the Weyl formula"
}], "Text",ExpressionUUID->"7865705d-1894-414c-830e-6e515677625b"],

Cell[TextData[{
 "$",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"dim", 
     SuperscriptBox[
      StyleBox["S", "TI"], "\[Lambda]"], 
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["C",
        FontSlant->"Plain"], 
       StyleBox["d", "TI"]], ")"}]}], " ", "\[LongEqual]", " ", 
    RowBox[{
     UnderscriptBox["\[Product]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"]}], ")"}], " ", "\[Element]", " ", "\[Lambda]"}],
      LimitsPositioning->True], 
     FractionBox[
      RowBox[{
       StyleBox["d", "TI"], "+", 
       StyleBox["j", "TI"], "-", 
       StyleBox["i", "TI"]}], 
      RowBox[{
       StyleBox["h", "TI"], "(", 
       RowBox[{
        StyleBox["i", "TI"], ",", 
        StyleBox["j", "TI"]}], ")"}]]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bf29ce88-2809-4b3d-bf72-8a81a539c97a"],
 "$"
}], "Text",ExpressionUUID->"18f2359e-e763-4cd6-b1e8-e55b36462b00"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["h", "TI"], "(", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c6f694fa-209e-48ef-8d4d-2de689d5b13e"],
 " is the hook length at cell ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"15ad50a1-ed20-4969-b91f-4fe323559d0f"],
 ". ",
 Cell[BoxData[
  RowBox[{"contentSum", "[", "par", "]"}]], "InlineFormula",ExpressionUUID->
  "3cb0866e-5ec2-438d-b6af-85d9c07ad3cb"],
 " is the eigenvalue of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "<", 
      StyleBox["j", "TI"]}],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2d89e59d-6e74-4f3e-9263-f4bfde400c38"],
 " on the irrep ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8e8cc32b-298d-4cb8-b8da-6b21bfed6de5"],
 ", namely"
}], "Text",ExpressionUUID->"b8cbef23-2db0-45d6-9a5d-05a084897552"],

Cell[TextData[{
 "$",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     StyleBox["c", "TI"], 
     RowBox[{"(", "\[Lambda]", ")"}]}], " ", "\[LongEqual]", " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"]}], ")"}], " ", "\[Element]", " ", "\[Lambda]"}],
      LimitsPositioning->True], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        StyleBox["j", "TI"], "-", 
        StyleBox["i", "TI"]}], ")"}], "."}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"244ed371-6c3b-4e56-aa35-b38dd099701d"],
 "$"
}], "Text",ExpressionUUID->"fe54b160-1a45-473a-946a-5f0b5273614c"],

Cell[TextData[{
 Cell[BoxData[
 "flattenProjector"], "InlineFormula",ExpressionUUID->
  "51f9ece2-23f3-47bb-8898-01ec10f994d2"],
 " materializes a Young projector (or a sum of them over the standard \
tableaux of one shape) as a ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["n", "TI"]], "\[Cross]", 
    SuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f3a62c71-6434-46b4-91b5-3abdff03bd7e"],
 " matrix on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2d53bd00-5f2f-4466-bdfa-ff2b4750940c"],
 ". ",
 Cell[BoxData[
 "irrepRank"], "InlineFormula",ExpressionUUID->
  "f2898f01-0210-427c-b8ff-d9e4d5e5f008"],
 " reports its rank, i.e. the block dimension. ",
 Cell[BoxData[
 "standardTableaux"], "InlineFormula",ExpressionUUID->
  "476ee0b2-c8f0-4542-8843-bd8605969a30"],
 " enumerates standard Young tableaux of a given shape (no built-in \
equivalent in plain WL)."
}], "Text",ExpressionUUID->"f012dd7f-74c0-4f3d-92a6-50d0745e70d6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tol", " ", "=", " ", 
    RowBox[{"10", "^", 
     RowBox[{"-", "10"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"schurDim", "[", 
     RowBox[{"par_List", ",", " ", "d_Integer"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "hooks", "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"hooks", " ", "=", " ", 
        RowBox[{"HookLengths", "[", "par", "]"}]}], ";", "\n", "    ", 
       RowBox[{"Product", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"Product", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"d", " ", "+", " ", "j", " ", "-", " ", "i"}], ")"}], "/", 
            RowBox[{"hooks", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", "j"}], "]"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", 
             RowBox[{"par", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
         "        ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", "par", "]"}]}], "}"}]}], "\n", "    ", 
        "]"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"contentSum", "[", "par_List", "]"}], " ", ":=", "\n", "    ", 
    RowBox[{"Total", " ", "@", " ", 
     RowBox[{"Flatten", " ", "@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"j", " ", "-", " ", "i"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "par", "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", 
          RowBox[{"par", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}]}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"flattenProjector", "[", 
     RowBox[{"tableaux_List", ",", " ", "d_Integer", ",", " ", "n_Integer"}], 
     "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "dims", ",", " ", "idxList", ",", " ", "basisTensors", ",", " ", 
        "projected"}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"dims", " ", "=", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"d", ",", " ", "n"}], "]"}]}], ";", "\n", "    ", 
       RowBox[{"idxList", " ", "=", " ", 
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"Range", "[", "d", "]"}], ",", " ", "n"}], "]"}]}], ";", 
       "\n", "    ", 
       RowBox[{"basisTensors", " ", "=", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Normal", " ", "@", " ", 
            RowBox[{"SparseArray", "[", 
             RowBox[{
              RowBox[{"#", " ", "->", " ", "1"}], ",", " ", "dims"}], "]"}]}],
            " ", "&"}], ",", " ", "idxList"}], "]"}]}], ";", "\n", "    ", 
       RowBox[{"projected", " ", "=", " ", 
        RowBox[{"Map", "[", "\n", "        ", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"T", ",", "\n", "            ", 
            RowBox[{"Flatten", " ", "@", " ", 
             RowBox[{"Total", "[", "\n", "                ", 
              RowBox[{
               RowBox[{"Function", "[", 
                RowBox[{"t", ",", " ", 
                 RowBox[{"YoungProject", "[", 
                  RowBox[{"T", ",", " ", 
                   RowBox[{"YoungTableau", "[", "t", "]"}]}], "]"}]}], "]"}], 
               " ", "/@", " ", "tableaux"}], "\n", "            ", "]"}]}]}], 
           "\n", "        ", "]"}], ",", "\n", "        ", "basisTensors"}], 
         "\n", "    ", "]"}]}], ";", "\n", "    ", 
       RowBox[{"Transpose", " ", "@", " ", "projected"}]}]}], "\n", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"irrepRank", "[", 
     RowBox[{"tableaux_List", ",", " ", "d_Integer", ",", " ", "n_Integer"}], 
     "]"}], " ", ":=", "\n", "    ", 
    RowBox[{"MatrixRank", " ", "@", " ", 
     RowBox[{"flattenProjector", "[", 
      RowBox[{"tableaux", ",", " ", "d", ",", " ", "n"}], "]"}]}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"removableCorners", "[", "par_List", "]"}], " ", ":=", " ", 
    RowBox[{"Select", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"par", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "par", "]"}]}], "}"}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"Function", "[", 
       RowBox[{"c", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "==", " ", 
          RowBox[{"Length", "[", "par", "]"}]}], " ", "||", " ", 
         RowBox[{
          RowBox[{"par", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"c", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", "1"}], "]"}], 
           "]"}], " ", "<", " ", 
          RowBox[{"c", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}]}], "]"}]}], "\n", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"shrinkAt", "[", 
     RowBox[{"par_List", ",", " ", 
      RowBox[{"{", 
       RowBox[{"i_", ",", " ", "_"}], "}"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"MapAt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", " ", "-", " ", "1"}], " ", "&"}], ",", " ", "par", ",", 
        " ", "i"}], "]"}], ",", " ", "0"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"standardTableaux", "[", 
    RowBox[{"{", "}"}], "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"{", "}"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"standardTableaux", "[", "par_List", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"standardTableaux", "[", "par", "]"}], " ", "=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Total", "[", "par", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Join", " ", "@@", " ", 
       RowBox[{"Map", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"c", ",", "\n", "            ", 
           RowBox[{"Map", "[", "\n", "                ", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{"T", ",", "\n", "                    ", 
               RowBox[{"Module", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"rows", " ", "=", " ", "T"}], "}"}], ",", "\n", 
                 "                        ", 
                 RowBox[{
                  RowBox[{"While", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "rows", "]"}], " ", "<", " ", 
                    RowBox[{"c", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"rows", ",", " ", 
                    RowBox[{"{", "}"}]}], "]"}]}], "]"}], ";", "\n", 
                  "                        ", 
                  RowBox[{"ReplacePart", "[", 
                   RowBox[{"rows", ",", " ", 
                    RowBox[{
                    RowBox[{"c", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"rows", "[", 
                    RowBox[{"[", 
                    RowBox[{"c", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", " ", 
                    "n"}], "]"}]}]}], "]"}]}]}], "\n", "                    ",
                 "]"}]}], "\n", "                ", "]"}], ",", "\n", 
             "                ", 
             RowBox[{"standardTableaux", "[", 
              RowBox[{"shrinkAt", "[", 
               RowBox[{"par", ",", " ", "c"}], "]"}], "]"}]}], "\n", 
            "            ", "]"}]}], "\n", "        ", "]"}], ",", "\n", 
         "        ", 
         RowBox[{"removableCorners", "[", "par", "]"}]}], "\n", "    ", 
        "]"}]}]}], "\n", "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"535d92e9-01e0-4556-a121-11ecdb706934"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tier 1: heavy Symmetry-subcontext usage", "Title",ExpressionUUID->"0dcca763-8d12-4dbf-88d0-5ce495a311f3"],

Cell[TextData[{
 "These two examples sweep over multiple partitions and dimensions, calling \
",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "2806cf51-2280-425e-b59f-87364303d490"],
 ", ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "6d50dc1e-499e-446e-a2ce-0946277a5eac"],
 ", ",
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "eaac244b-25b0-435a-ba21-ef46f19419c6"],
 ", and ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "a6e0b037-0285-4acb-8df5-bdeb447bec87"],
 " many times per run. Each is also the most operationally TN-actionable: the \
formulas they validate are exactly what you need to size and populate \
symmetry-resolved MPS / MPO blocks."
}], "Text",ExpressionUUID->"e53f13bb-ed50-4b32-a572-aafdf036bc29"],

Cell[CellGroupData[{

Cell["\<\
Example A. On-site irreps predict MPS / MPO bond multiplicity\
\>", "Section",ExpressionUUID->"f56edda0-090f-4346-b417-afe0443b628a"],

Cell[CellGroupData[{

Cell["Symmetry-subcontext functions used", "Subsection",ExpressionUUID->"18c1e313-cc19-4f11-b032-d3d2e195ca55"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"TableauDimension", "[", "par", "]"}]], "InlineFormula",
  ExpressionUUID->"d0f2bf33-8e43-44e2-b023-c5be00338a4a"],
 " \[LongDash] computes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4d82e7af-fc98-47ab-8ea9-16a718e7b076"],
 " via the hook-length formula ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "!", "/", "\[Product]", 
    StyleBox["h", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8e8f7cd5-b0e5-4327-bb9f-7152a9f94629"],
 ". This is the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b569fae4-9818-4738-b24e-269c65da0335"],
 "-irrep factor."
}], "Item",ExpressionUUID->"8d9b2332-43cf-44c1-9c7a-deefef749786"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HookLengths", "[", "par", "]"}]], "InlineFormula",ExpressionUUID->
  "e0ea8077-c3d6-4088-8536-7cd63047a900"],
 " \[LongDash] the per-cell hook lengths used inside ",
 Cell[BoxData[
 "schurDim"], "InlineFormula",ExpressionUUID->
  "56ddd861-485a-49ba-9bc2-6ca1d0f7d487"],
 " to evaluate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8c2670b9-6f07-4b82-9bd0-d6d16452362d"],
 " via the Weyl formula."
}], "Item",ExpressionUUID->"c5814db2-65ee-4b70-8290-b003c8c02a43"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", "t", "]"}]], "InlineFormula",ExpressionUUID->
  "f1382183-e993-4c86-8e24-f61c80a7b50a"],
 " \[LongDash] wraps each standard tableau into the structural type that ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "b832f976-0e19-42cd-ad89-f45178dcbd3a"],
 " understands."
}], "Item",ExpressionUUID->"75d7be81-0c99-4fb6-a00d-82a2fb54e1ff"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"YoungProject", "[", 
   RowBox[{"T", ",", " ", 
    RowBox[{"YoungTableau", "[", "t", "]"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"457ad3d6-3de2-4ccd-9c5c-ccd0543e8ba4"],
 " \[LongDash] projects basis tensors onto the irrep subspace (inside ",
 Cell[BoxData[
 "flattenProjector"], "InlineFormula",ExpressionUUID->
  "701038f6-fdd8-4350-8ef1-92ce8ba4350f"],
 " / ",
 Cell[BoxData[
 "irrepRank"], "InlineFormula",ExpressionUUID->
  "cecc8dc0-fa75-4b71-9d58-a0ab3db24b62"],
 "), giving the ",
 StyleBox["measured", "TI"],
 " block dimension as a verification of the closed-form prediction."
}], "Item",ExpressionUUID->"ddf333a1-484e-47b4-8aaa-875021d93352"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Why Symmetry matters here, and how it helps", "Subsection",ExpressionUUID->"3c0432b0-1161-446f-8406-b3af7c66616d"],

Cell[TextData[{
 "On a permutation-symmetric chain of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8d648c9e-f1fc-4f86-a99f-0e9e3219a151"],
 "-dim sites, the MPS bond carries a representation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["n", "TI"]], "\[Cross]", 
    StyleBox["GL",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"17a3467e-09e3-4d0e-a15e-75693457ea89"],
 ". Schur-Weyl decomposes it as"
}], "Text",ExpressionUUID->"7378f1a6-a95a-4979-8e4d-aae252ebdc13"],

Cell[TextData[{
 "$",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], 
     RowBox[{"\[CircleTimes]", 
      StyleBox["n", "TI"]}]], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    SubscriptBox["\[CirclePlus]", 
     RowBox[{
      RowBox[{"\[Lambda]", " "}], 
      RowBox[{"\[RightTee]", " "}], 
      StyleBox["n", "TI"]}]], 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], " ", 
    RowBox[{"\[CircleTimes]", " "}], 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a5ddc4f8-6f00-42c3-ab54-54e19dd87372"],
 "$"
}], "Text",ExpressionUUID->"97fb7e93-cb2c-45af-b029-33e7b314a1fd"],

Cell[TextData[{
 "The size of the ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0ff5938a-fc07-415b-a332-7b6d1194d1d6"],
 "-isotypic block is the multiplicity"
}], "Text",ExpressionUUID->"34262b9e-0411-44f7-9277-b1d46eaefc8b"],

Cell[TextData[{
 "$",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], "\[Lambda]"], " ", 
    RowBox[{"\[LongEqual]", " "}], "dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], " ", 
    RowBox[{"\[CenterDot]", " "}], "dim", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4835217f-b399-498e-9afd-229d5a5e1e12"],
 "$"
}], "Text",ExpressionUUID->"1ccf08f4-afcb-4e97-b7d3-c93ac1c70da0"],

Cell[TextData[{
 "Both factors come from the Symmetry subcontext in closed form, without ever \
materialising the projector: ",
 Cell[BoxData[
  RowBox[{"TableauDimension", "[", "par", "]"}]], "InlineFormula",
  ExpressionUUID->"f0ef2144-b1b7-4c03-bcdd-5b67da8193b8"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"68eb28da-c7eb-4192-b1bf-822a98df3b5f"],
 " via the hook-length formula; ",
 Cell[BoxData[
  RowBox[{"HookLengths", "[", "par", "]"}]], "InlineFormula",ExpressionUUID->
  "78728849-1487-4e88-82ce-c88be60e96ce"],
 " feeds the Weyl formula for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d5b7a41c-95fa-4c51-8b77-55bc505bd219"],
 ". Computing ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["m", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8c2c227d-df81-40ff-b19e-818217770891"],
 " is O(r\.b2) in the number of rows of ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5f510206-4a1a-43d6-8823-411cf095e41b"],
 ", regardless of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "66453179-4fd6-4c29-b684-25d81c979149"],
 " or ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7eaeeb4b-13be-4872-b18d-64bd38aa53c8"],
 "."
}], "Text",ExpressionUUID->"f76eb773-5f7f-4571-a70e-3da4a9ba4575"],

Cell[TextData[{
 "The payoff: a symmetry-resolved MPS sizes each sector exactly. Sectors with \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], "\[Lambda]"], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3f2db3c1-64c9-4a23-bc22-92d292a98d20"],
 " (e.g. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"376a800e-0062-4df3-ae60-f86304246f04"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b08ff635-eb7f-4b9e-ba0b-9e2106ca761c"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0677d957-81c5-4d68-a2c0-c8adceb5d1b8"],
 ") are skipped by formula. No truncation inside any sector; no slots wasted \
on empty ones."
}], "Text",ExpressionUUID->"81dd7b26-32d8-4f38-b063-e010ed2b7c76"],

Cell[TextData[{
 "The verification below also calls ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "57083e74-8e78-42ff-b456-9094e47faaab"],
 " (inside ",
 Cell[BoxData[
 "flattenProjector"], "InlineFormula",ExpressionUUID->
  "b62180c8-9655-425e-9d0b-44fd5acbfc07"],
 " / ",
 Cell[BoxData[
 "irrepRank"], "InlineFormula",ExpressionUUID->
  "5fe507db-598e-4597-b44a-132e9e99182d"],
 ") to ",
 StyleBox["measure", "TI"],
 " each block rank by projecting basis tensors. That confirms the closed-form \
prediction; in production only the closed form is needed."
}], "Text",ExpressionUUID->"66ceb0d4-3010-49ad-adb7-05b519f15a77"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Code", "Subsection",ExpressionUUID->"7eb0c603-1b52-4d3a-a43c-52a283da3240"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cases", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<n\>\"", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"\"\<d\>\"", " ", "->", " ", "2"}]}], "|>"}], ",", "\n", 
      "         ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<n\>\"", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"\"\<d\>\"", " ", "->", " ", "2"}]}], "|>"}], ",", "\n", 
      "         ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<n\>\"", " ", "->", " ", "3"}], ",", " ", 
        RowBox[{"\"\<d\>\"", " ", "->", " ", "3"}]}], "|>"}], ",", "\n", 
      "         ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<n\>\"", " ", "->", " ", "4"}], ",", " ", 
        RowBox[{"\"\<d\>\"", " ", "->", " ", "2"}]}], "|>"}]}], "}"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"results", " ", "=", " ", 
   RowBox[{"Map", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"case", ",", "\n", "        ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "d", ",", " ", "perShape"}], "}"}], ",", 
         "\n", "            ", 
         RowBox[{
          RowBox[{"n", " ", "=", " ", 
           RowBox[{"case", "[", "\"\<n\>\"", "]"}]}], ";", " ", 
