Cell[TextData[{
 "Wire ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "77627ffe-20c2-4e26-8295-1174d4e52763"],
 " into a TN: contract slots ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cb215b62-c7e9-4e82-8f98-e3f20446510e"],
 " and ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "62e92e3e-fa8d-42c4-ab70-50e95ce9fec0"],
 ", i.e. the Euclidean Ricci contraction ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"b", "d"}], "TI"]], "\[LongEqual]", 
    SuperscriptBox["\[Delta]", 
     StyleBox[
      RowBox[{"a", "c"}], "TI"]], 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"3ecbd79d-b403-40ef-8e10-54a950bac147"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6b01a7c3-651c-4223-8cc5-3a0b3e080729"],
 " lives in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"2", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5ddcbf32-4862-4eef-bfd0-c0ebee244d36"],
 " irrep, the Ricci tensor is automatically symmetric:"
}], "Text",ExpressionUUID->"eda99133-4c2c-404d-9165-8d1334c53df1"],

