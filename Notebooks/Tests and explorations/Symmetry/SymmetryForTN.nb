Cell["The antisymmetric piece has zero diagonal:", "Text",ExpressionUUID->"ef95216e-771c-4549-a32f-325c59dc8f13"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Diagonal", "[", "Pant", "]"}], "]"}], "]"}], " ", "<", " ", 
  "tol"}], "\n", 
