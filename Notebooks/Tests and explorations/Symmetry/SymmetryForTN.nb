      StyleBox["d", "TI"], "+", "1"}], ")"}], "/", "2", "\[LongEqual]", "6"}],
    TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2a605317-f121-4542-a06a-b18d24f50eb2"],
