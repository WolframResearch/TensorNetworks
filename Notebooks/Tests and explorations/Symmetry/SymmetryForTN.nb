 " partition (antisymmetric)."
}], "Item",ExpressionUUID->"60e4fb12-899f-4ed5-aef1-425572898129"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"YoungProject", "[", 
   RowBox[{"T", ",", " ", "..."}], "]"}]], "InlineFormula",ExpressionUUID->
  "5dcbefe9-8df5-400c-b694-c42425423d45"],
 " \[LongDash] the normalised idempotent projector for each."
}], "Item",ExpressionUUID->"f300568e-91d8-4977-8828-556a8c73fd3e"]
