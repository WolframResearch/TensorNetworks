    TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f7f1dd50-688b-4bd5-8a69-e3ab1b4659a0"],
 ":"
}], "Text",ExpressionUUID->"4e3a73d2-e630-4fd5-b9a3-fb0e8579057c"],

