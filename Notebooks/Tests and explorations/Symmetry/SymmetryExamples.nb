   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Project", " ", "onto", " ", "antisymmetric"}], "-", 
     RowBox[{"should", " ", "give", " ", "zero"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"antiPart", " ", "=", " ", 
