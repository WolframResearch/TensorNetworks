    RowBox[{"symPart", " ", "=", " ", 
     RowBox[{"YoungProject", "[", 
      RowBox[{"tSym", ",", " ", 
       RowBox[{"YoungTableau", "[", 
        RowBox[{"{", "3", "}"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Norm", "[", 
