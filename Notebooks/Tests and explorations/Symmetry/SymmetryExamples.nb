     RowBox[{"P", "^", "2"}]}], "=", "P"}], "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t3", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{"1", ",", " ", 
       RowBox[{"{", 
