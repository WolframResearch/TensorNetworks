Cell[CellGroupData[{

Cell["HookFactor", "Subsection",
 CellChangeTimes->{{3.979320300000000*^9, 3.979320300000001*^9}},
 ExpressionUUID->"hookfactor-section-uuid"],

Cell[TextData[{
 StyleBox["Purpose",
  FontWeight->"Bold"],
 ": Computes 1/(product of all hook lengths) using the efficient Frobenius determinant formula.\n\n",
 StyleBox["Input Patterns",
  FontWeight->"Bold"],
 ":\n",
 StyleBox["HookFactor[{d1, d2, ...}]",
  FontWeight->"Bold"],
 "\tFrom partition\n",
 StyleBox["HookFactor[YoungTableau[...]]",
  FontWeight->"Bold"],
 "\tFrom tableau\n\n",
 StyleBox["Formula",
  FontWeight->"Bold"],
 ": Uses Frobenius determinant - O(r^3) where r = number of rows.\nMuch faster than computing all hook lengths for partitions with few rows.\n\n",
 StyleBox["Relation to dimension",
  FontWeight->"Bold"],
 ": TableauDimension = n! * HookFactor where n = Total[partition]"
}], "Text",
 CellChangeTimes->{{3.979320300000002*^9, 3.979320300000003*^9}},
 ExpressionUUID->"hookfactor-text-uuid"],

