Cell["\<\
YoungTableau[{{1,3},{2}}] means:
   - Rows: {1,3} and {2}
   - Columns: {1,2} and {3}

   Algorithm:
   Step 1: Symmetrize over {1,3} -> T + Transpose[T,{3,2,1}]
   Step 2: Antisymmetrize over {1,2} -> result - Transpose[result,{2,1,3}]\
\>", "Text",
 CellChangeTimes->{
  3.978543178943486*^9},ExpressionUUID->"d6c2f927-4ef0-4d53-b5b4-\
