Cell[CellGroupData[{

Cell["TransposePartition", "Subsection",
 CellChangeTimes->{{3.979320100000000*^9, 3.979320100000001*^9}},
 ExpressionUUID->"transpose-partition-section-uuid"],

Cell[TextData[{
 StyleBox["Purpose",
  FontWeight->"Bold"],
 ": Computes the conjugate (transpose) of a partition by swapping rows and columns in the Young diagram.\n\n",
 StyleBox["Input Patterns",
  FontWeight->"Bold"],
 ":\n",
 StyleBox["TransposePartition[{d1, d2, ...}]",
  FontWeight->"Bold"],
 "\tReturns conjugate partition\n\n",
 StyleBox["Example",
  FontWeight->"Bold"],
 ": {4,2,1} has Young diagram:\n\[FilledSquare]\[FilledSquare]\[FilledSquare]\[FilledSquare]\n\[FilledSquare]\[FilledSquare]\n\[FilledSquare]\n\nTranspose swaps rows/columns to get {3,2,1,1}:\n\[FilledSquare]\[FilledSquare]\[FilledSquare]\n\[FilledSquare]\[FilledSquare]\n\[FilledSquare]\n\[FilledSquare]"
}], "Text",
 CellChangeTimes->{{3.979320100000002*^9, 3.979320100000003*^9}},
 ExpressionUUID->"transpose-partition-text-uuid"],

