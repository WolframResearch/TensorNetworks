  RowBox[{
   RowBox[{"HookFactor", "[",
    RowBox[{"{",
     RowBox[{"3", ",", "2"}], "}"}], "]"}], "\[IndentingNewLine]",
   RowBox[{"(*",
    RowBox[{"Returns", ":", " ",
     RowBox[{"5", "/", "120"}], " ", "=", " ",
     RowBox[{"1", "/", "24"}]}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.979320300000004*^9, 3.979320300000005*^9}},
 ExpressionUUID->"hookfactor-ex1-uuid"],

