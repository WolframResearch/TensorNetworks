Cell[BoxData[
 RowBox[{
  RowBox[{"(*",
   RowBox[{
    RowBox[{"Example", " ", "1"}], ":",
    RowBox[{"Standard", " ", "partition"}]}], "*)"}], "\[IndentingNewLine]",
  RowBox[{
   RowBox[{"TransposePartition", "[",
    RowBox[{"{",
     RowBox[{"4", ",", "2", ",", "1"}], "}"}], "]"}], "\[IndentingNewLine]",
   RowBox[{"(*",
    RowBox[{"Returns", ":",
     RowBox[{"{",
      RowBox[{"3", ",", "2", ",", "1", ",", "1"}], "}"}]}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.979320100000004*^9, 3.979320100000005*^9}},
 ExpressionUUID->"transpose-partition-ex1-uuid"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{"3", ",", "2", ",", "1", ",", "1"}], "}"}]], "Output",
 ExpressionUUID->"transpose-partition-out1-uuid"]
}, Open  ]],

