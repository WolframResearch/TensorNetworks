         RowBox[{"1", ",", "1", ",", "1"}], "}"}], "]"}]}], " ", 
      RowBox[{"(*", 
       RowBox[{"fully", " ", "antisymmetric"}], "*)"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Random", " ", "tensor"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t3", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "3", ",", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Project", " ", "onto", " ", "each", " ", "subspace"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"projections", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"YoungProject", "[", 
        RowBox[{"t3", ",", "#"}], "]"}], "&"}], "/@", "tableaux"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "pairwise", " ", "inner", " ", "products"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"innerProducts", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"projections", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "*", 
          RowBox[{"projections", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "as", " ", "matrix"}], "*)"}], "\n", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"Chop", "[", "innerProducts", "]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Returns", " ", "Diagonal"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"self", " ", "inner", " ", "product", " ", 
        RowBox[{"(", "norm\.b2", ")"}], " ", "Off"}], "-", "diagonal"}], "=", 
      
      RowBox[{"0", " ", 
       RowBox[{"(", 
        RowBox[{"orthogonal", "!"}], ")"}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Verify", " ", "off"}], "-", 
     RowBox[{"diagonal", " ", "elements", " ", "are", " ", "zero"}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"offDiagonal", "=", 
     RowBox[{"innerProducts", "-", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"Diagonal", "[", "innerProducts", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", "offDiagonal", "]"}], "]"}], "<", 
    RowBox[{"10", "^", 
     RowBox[{"-", "10"}]}]}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Returns", ":", "True"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.97854383536133*^9, 3.978543895240147*^9}, {
  3.978543935693699*^9, 3.978544033934327*^9}, {3.9785441601529627`*^9, 
