Cell[CellGroupData[{

Cell["TableauDimension", "Subsection",
 CellChangeTimes->{
  3.9785359436248217`*^9},ExpressionUUID->"28a3a1a3-c9ee-4f6c-ae3e-\
1574b9adf07d"],

Cell[TextData[{
 StyleBox["Purpose",
  FontWeight->"Bold"],
 ": Computes the dimension of the irreducible representation corresponding to \
a Young tableau or partition.\n\n",
 StyleBox["Input Patterns:",
  FontWeight->"Bold"],
 "\n",
 StyleBox["TableauDimension[{d1, d2, ...}]",
  FontWeight->"Bold"],
 "\tDirect from partition (fast path)\n",
 StyleBox["TableauDimension[YoungTableau[...]]",
  FontWeight->"Bold"],
 "\tFrom tableau\n\n",
 StyleBox["Formula",
  FontWeight->"Bold"],
 ": d = n! * HookFactor[partition]\n\n",
 StyleBox["Algorithm",
  FontWeight->"Bold"],
 ": Uses efficient Frobenius determinant formula via HookFactor.\nComplexity: O(r^3) where r = number of rows (much faster than naive O(n^2))."
}], "Text",
 CellChangeTimes->{{3.9785359392176523`*^9, 
  3.978535996422188*^9}},ExpressionUUID->"f67e483f-32e6-452b-81eb-\
701acb086bc8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tableauDimension", "[", "tab_", "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"shape", "=", 
      RowBox[{"TableauShape", "[", "tab", "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "[", "shape", "]"}], "!"}], "/", 
     RowBox[{"Times", "@@", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"HookLength", "[", 
          RowBox[{"tab", ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "c"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", 
           RowBox[{"Length", "@", "shape"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", 
           RowBox[{"shape", "[", 
            RowBox[{"[", "r", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.978536465706287*^9, 3.978536492929431*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"fac14225-954f-4464-a9b2-d44c9567d700"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Example", " ", "1"}], ":", 
    RowBox[{
     RowBox[{"Fully", " ", "symmetric"}], "-", 
     RowBox[{"single", " ", "row"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"TableauDimension", "[", 
    RowBox[{"YoungTableau", "[", 
     RowBox[{"{", "3", "}"}], "]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"%", "==", 
    RowBox[{"tableauDimension", "[", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", "3", "}"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Returns", ":", 
     RowBox[{
      RowBox[{"1", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"3", "!"}], "/", "6"}], "=", "1"}], ")"}]}], "-", 
      RowBox[{"trivial", " ", "symmetric", " ", "representation"}]}]}], 
    "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.978536024635483*^9, 3.9785360336694603`*^9}, {
  3.978536500282254*^9, 3.978536505494843*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"51362a61-af20-4891-a8fa-249e39b52e21"],

