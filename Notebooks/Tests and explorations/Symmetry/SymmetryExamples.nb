Cell[TextData[{
 StyleBox["Purpose",
  FontWeight->"Bold"],
 ": Computes ALL hook lengths for a partition at once. More efficient than calling HookLength for each cell individually.\n\n",
 StyleBox["Input Patterns",
  FontWeight->"Bold"],
 ":\n",
 StyleBox["HookLengths[{d1, d2, ...}]",
  FontWeight->"Bold"],
 "\tFrom partition directly\n",
 StyleBox["HookLengths[YoungTableau[...]]",
  FontWeight->"Bold"],
 "\tFrom tableau\n\n",
 StyleBox["Returns",
  FontWeight->"Bold"],
 ": Nested list of hook lengths matching tableau shape"
}], "Text",
 CellChangeTimes->{{3.979320200000002*^9, 3.979320200000003*^9}},
 ExpressionUUID->"hooklengths-text-uuid"],

