  RowBox[{"(*", 
   RowBox[{"Create", " ", "a", " ", "symmetric", " ", "tensor"}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"tSym", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
