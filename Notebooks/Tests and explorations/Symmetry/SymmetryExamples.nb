     RowBox[{"YoungProject", "[", 
      RowBox[{"t3", ",", " ", "tabMixed"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"Key", " ", 
     RowBox[{"property", ":", 
      RowBox[{"Idempotence", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"P", "^", "2"}], "=", "P"}], ")"}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"proj2", " ", "=", " ", 
     RowBox[{"YoungProject", "[", 
      RowBox[{"proj", ",", " ", "tabMixed"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Norm", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"proj", " ", "-", " ", "proj2"}], "]"}], "]"}], " ", "<", " ", 
    RowBox[{"10", "^", 
