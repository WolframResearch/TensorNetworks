  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    RowBox[{"i", "\[NoBreak]", "j"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fcec4146-47eb-42ad-9be4-1386628adb13"]
}], "Subsection",ExpressionUUID->"2fcb851b-f2e1-44d3-96e3-d411dff5717d"],

Cell[TextData[{
 StyleBox["The Levi-Civita symbol ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CurlyEpsilon]", 
    RowBox[{"i", "\[NoBreak]", "j"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c1833bb5-4beb-498d-aee2-ca4ef38011a1"],
 StyleBox[" is the orientation tensor on a 2D plane: antisymmetric by \
definition. At ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f7296e3f-da62-4de0-9189-d6a40ab69cf8"],
 StyleBox[" the antisymmetric sector is one-dimensional, so ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "158e1d76-22ae-40c3-a518-0b967f1bed7d"],
 StyleBox[" plus ",
  FontSlant->"Italic"],
 StyleBox["SchurDimension[{1,1}, 2] = 1", "Code"],
 StyleBox[" together prove ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["\[CurlyEpsilon]", TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b00ee4be-e264-4a2c-8cbf-fe981aba2441"],
 StyleBox[" is the unique (up to scale) antisymmetric rank-2 tensor on a \
2-qubit bond.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"cac657b8-c244-431f-934f-1c8c95eeaf09"],

