Cell[CellGroupData[{

Cell["\<\
Symbolic covariance matrix of a bivariate normal distribution\
\>", "Subsection",ExpressionUUID->"9cdc7539-c92c-48a2-9f7d-52a8e436756a"],

Cell[TextData[{
 StyleBox["Covariance is symmetric in its two variables: ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Cov", "MR"], "(", "X", ",", "Y", ")", "=", 
    StyleBox["Cov", "MR"], "(", "Y", ",", "X", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"fd499b8c-9421-4a24-961d-d152eaab06af"],
 StyleBox[" by definition. ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5c76aba6-6008-485a-b7b1-a338989b784d"],
 StyleBox[" confirms this symbolically in the correlation parameter ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ab4ffcc9-f729-47be-b116-0dda4d888108"],
 StyleBox[", the structural reason a covariance bond carries ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "(", "d", "+", "1", ")", "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c278215d-9c78-4c3e-a85f-ca003190c656"],
 StyleBox[" free entries rather than ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["d", "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d1ea95ad-a834-4c9e-bfbd-7d665c25d8ed"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"8c342a5a-253b-4350-b374-eb74e5652156"],

Cell[TextData[{
 "The covariance matrix of a multivariate distribution is symbolic when the \
distribution carries a symbolic parameter. For the bivariate normal ",
 StyleBox["BinormalDistribution[\[Rho]]", "Code"],
 " (unit variances, correlation parameter ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "eba5aa08-8dfe-41bf-a7b1-5d317a89bc6e"],
 "), built-in ",
 Cell[BoxData[
  TemplateBox[{"Covariance", "paclet:ref/Covariance"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "af2ecb3b-a704-49e8-adb3-5f8fddb3c20d"],
 " returns the symbolic matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"1", "\[Rho]"},
      {"\[Rho]", "1"}
     }], "\[NoBreak]", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3ff2478d-1d6b-469b-8f46-f132c7361e5d"],
 ", manifestly symmetric in ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "be61b155-2698-4bfc-911f-58291be5d706"],
 "."
}], "Text",ExpressionUUID->"a87a7776-6cad-4bb5-8900-cb920b4e15d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"covMat", " ", "=", " ", 
  RowBox[{"Covariance", "[", 
   RowBox[{"BinormalDistribution", "[", "\[Rho]", "]"}], "]"}]}]], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"c73cff87-6727-4b19-baa8-6bef7fe31473"],

Cell[BoxData[
