Cell[TextData[{
 "Built-in WL reports the three Riemann pair generators. Bianchi is not a ",
 StyleBox["{perm, phase}", "Code"],
 " relation so it cannot be a generator here, even though it is satisfied \
identically by the components of ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b1f80e57-cd51-45df-8854-9918d643badf"],
 ". The roles divide cleanly: the Symmetry functions produce a tensor in the \
irreducible representation, ",
 Cell[BoxData[
  TemplateBox[{"TensorSymmetry", "paclet:ref/TensorSymmetry"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2f06acb7-9e10-4987-8320-eacc155774dd"],
 " reads off the mono-term subgroup of its slot symmetries. ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "38c1479c-fb9d-43cd-9d21-5910a155af6c"],
 " outputs a plain array (or a ",
 Cell[BoxData[
  TemplateBox[{"SymmetrizedArray", "paclet:ref/SymmetrizedArray"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "64bc84be-92ed-45de-9963-31e2af8257e8"],
 "-compatible structure) that built-in WL handles directly."
}], "Text",ExpressionUUID->"732a0770-83b1-4e01-9aee-a7f6443c8ea2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The TN reward", "Subsection",ExpressionUUID->"fa5624f3-eb1e-4525-b3ea-a59faf8c7b50"],

Cell[TextData[{
 StyleBox["Once ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "53934bce-34cd-4cec-8692-fb4ef130cd8f"],
 StyleBox[" sits in the ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8e2a2fa9-a3a8-487f-9f81-011eae987d9d"],
 StyleBox[" block, contracting one upper-lower pair via ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{"TensorContract", "paclet:ref/TensorContract"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "53c205d1-8883-4eb3-878d-d5bb38f1e70e"],
 StyleBox[" produces the symmetric Ricci tensor with no separate \
re-symmetrisation step. Built-in tensor machinery sees and preserves the \
irreducible-representation structure automatically.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"2354a236-a225-474c-b598-f32c44a0e293"],

Cell[TextData[{
 "Once ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f64cdfe4-47cb-42f2-83c9-328691a09346"],
 " lives in the right irreducible representation, downstream contractions \
preserve the structure for free. The Euclidean Ricci tensor is the partial \
trace ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"b", "\[NoBreak]", "d"}]], "=", 
    SuperscriptBox["\[Delta]", 
     RowBox[{"a", "\[NoBreak]", "c"}]], " ", 
    SubscriptBox["R", 
     RowBox[{"a", " ", "b", " ", "c", " ", "d"}]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"cdbe954e-4360-4f3f-904e-c32c84cb567a"],
 ", written ",
 StyleBox["TensorContract[R, {{1, 3}}]", "Code"],
 ". It comes out symmetric automatically:"
}], "Text",ExpressionUUID->"b715de00-3ef2-45d2-ab04-1892781bd7a6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Ric", " ", "=", " ", 
   RowBox[{"TensorContract", "[", 
    RowBox[{"R", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Ric", " ", "-", " ", 
      RowBox[{"Transpose", "[", "Ric", "]"}]}], "]"}], "]"}], "]"}], " ", "<",
   " ", "tol"}]}], "Input",
 CellLabel->
  "In[197]:=",ExpressionUUID->"49354cd3-2532-4165-98c0-bc7fa6829067"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9888204142337008`*^9},
 CellLabel->
  "Out[198]=",ExpressionUUID->"4bdcd2d4-4c0b-4e26-9f53-5d6722941702"]
}, Open  ]],

Cell["\<\
No separate re-symmetrisation step. The scalar curvature is the trace of the \
Ricci tensor:\
\>", "Text",ExpressionUUID->"3083516a-1e24-4099-b84b-1517913e1458"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Tr", "[", "Ric", "]"}]], "Input",
 CellLabel->
  "In[199]:=",ExpressionUUID->"2f07a370-49c6-4f0a-9319-43ee53131c9b"],

Cell[BoxData["1.186550486536456`"], "Output",
 CellChangeTimes->{3.988820414243181*^9},
 CellLabel->
  "Out[199]=",ExpressionUUID->"d2c571c8-0573-4c5b-b3aa-ae828598f7d5"]
}, Open  ]],

Cell[TextData[{
 "The Weyl tensor is ",
 StyleBox["not",
  FontSlant->"Italic"],
 " a separate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "4"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6d81716c-150b-4a8f-83f9-5aae5cc243ae"],
 " irreducible representation: it is the trace-free part of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"66373db4-5be7-4adf-a366-69906ae33e57"],
 " block under the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "d", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"dbeaa8cc-0b64-4cb1-be3d-2fc79d3423c6"],
 " action on the four vector indices. Extracting it requires subtracting \
Ricci and scalar-curvature traces using the metric, which is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "d", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1c030030-bfb6-4fc4-b339-b3b5c5a90aeb"],
 " (or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "L", "(", "d", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ad80efdf-7900-47fa-96f7-c79fcd0cfe59"],
 ") representation theory on the ",
 StyleBox["indices",
  FontSlant->"Italic"],
 ", not ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "816db239-e0a0-4bc3-8c6c-d43c27e04ac4"],
 " representation theory on the ",
 StyleBox["slots",
  FontSlant->"Italic"],
 ". The Symmetry functions handle the slot layer cleanly; the index-level ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "d", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1b55ba48-4a59-492a-9ec9-b3a18280ec6b"],
 " decomposition into Weyl + traceless Ricci + scalar lives on top of it."
}], "Text",ExpressionUUID->"c341ea49-98ce-4a5b-9e68-5980be94dafa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Component count at arbitrary spacetime dimension", "Subsection",ExpressionUUID->"3e05882f-ce16-4938-97b1-490eddd0072d"],

Cell[TextData[{
 StyleBox["The Riemann tensor has ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["d", "2"], "(", 
    SuperscriptBox["d", "2"], "-", "1", ")", "/", "12"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"3ab2ff2b-81dd-4968-9cae-375ff62e7036"],
 StyleBox[" independent components in dimension ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c51889d7-8155-4605-a166-ada045f753b9"],
 StyleBox[" (1, 6, 20, 50 at ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2", ",", "3", ",", "4", ",", "5"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"470119c4-0a27-4386-99b1-d1156a7e6800"],
 StyleBox["). ",
  FontSlant->"Italic"],
 StyleBox["SchurDimension[{2, 2}, d]", "Code"],
 StyleBox[" returns this textbook count in closed form via the hook-content \
formula, and a brute-force ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{"MatrixRank", "paclet:ref/MatrixRank"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "30188e38-f6c6-44a3-a31d-c22de085603d"],
 StyleBox[" of the projector confirms it numerically at small ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "87e6cda9-0e90-47df-bf2b-1019a4372a71"],
 StyleBox[".",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"6fe28db8-bcc5-4ee8-ad0b-e6bf1384a79d"],

Cell[TextData[{
 "How many independent Riemann components are there in dimension ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8e0485d2-f82a-4067-bf00-74e26fb40be3"],
 "? The textbook answer is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["d", "2"], "(", 
    SuperscriptBox["d", "2"], "-", "1", ")", "/", "12"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b732eb44-720e-4020-86e3-996e98d7e4c1"],
 " (so 1, 6, 20, 50 at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2", ",", "3", ",", "4", ",", "5"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f93ae2a1-83e4-4e37-8fd0-8032126dbec2"],
 "). That count is ",
 StyleBox["exactly",
  FontSlant->"Italic"],
 " the dimension of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "L", "(", "d", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9f9bf893-9c93-439a-9bb6-903ddcc95b83"],
 " Weyl module ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["W", 
    RowBox[{"{", " ", "2", ",", "2", " ", "}"}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"4d58a9de-32f5-4f04-90ab-f4da76ed7bec"],
 ", which is the value of the Schur polynomial ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", 
     RowBox[{"2", ",", "2"}]], "(", 
    SuperscriptBox["1", "d"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"64de54ff-f8ad-4e4c-8a8f-eadf3dd091d3"],
 " that our ",
 Cell[BoxData[
  TemplateBox[{"HookLengths", "paclet:Wolfram/TensorNetworks/ref/HookLengths"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c4c0059e-87f4-4806-bf92-60d284c17d11"],
 "-driven ",
 Cell[BoxData[
  TemplateBox[{
   "SchurDimension", "paclet:Wolfram/TensorNetworks/ref/SchurDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "408ce364-7a9c-4dbd-bd0f-8a543551fc13"],
 " returns. Apply it at the four physically interesting dimensions."
}], "Text",ExpressionUUID->"243276c4-45d2-41b9-9f62-af04cf316c5f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", ",", " ", 
     RowBox[{"SchurDimension", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2"}], "}"}], ",", " ", "d"}], "]"}]}], "}"}], 
   ",", " ", 
   RowBox[{"{", 
    RowBox[{"d", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], "}"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[200]:=",ExpressionUUID->"36253af7-f161-4b50-ab38-ca513e34dfcb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", 
     RowBox[{"SchurDimension", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], ",", "2"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", 
     RowBox[{"SchurDimension", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], ",", "3"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", 
     RowBox[{"SchurDimension", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], ",", "4"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", 
     RowBox[{"SchurDimension", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], ",", "5"}], "]"}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9888204142498493`*^9},
 CellLabel->
  "Out[200]=",ExpressionUUID->"a97d9d51-32b8-4616-b6a8-4afb79b015a6"]
}, Open  ]],

Cell[TextData[{
 "Numerically verify the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "4"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ad60bf57-f8bc-42b3-9cc2-25238f139ddf"],
 " count by computing the rank of the linear map ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "\[Rule]", 
    StyleBox["YoungProject", "MR"], "[", "T", ",", 
    StyleBox["YoungTableau", "MR"], "[", "{", " ", "{", " ", "1", ",", "3", 
    " ", "}", ",", "{", " ", "2", ",", "4", " ", "}", " ", "}", "]", "]"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9c5948fd-1a3a-46cd-b619-4edcc2385de7"],
 " on the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0eac33c0-388b-4970-b9a9-aa0b6c28df7a"],
 "-dimensional space of generic rank-4 tensors."
}], "Text",ExpressionUUID->"088cf9f7-76ae-4b97-a124-216d07999d34"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"projectionRank", "[", "d_", "]"}], " ", ":=", " ", 
   RowBox[{"MatrixRank", " ", "@", " ", 
    RowBox[{"Transpose", " ", "@", " ", 
     RowBox[{"Map", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"YoungProject", "[", 
          RowBox[{
           RowBox[{"ArrayReshape", "[", 
            RowBox[{"#", ",", " ", 
             RowBox[{"{", 
              RowBox[{"d", ",", " ", "d", ",", " ", "d", ",", " ", "d"}], 
              "}"}]}], "]"}], ",", "\n", "                         ", 
           RowBox[{"YoungTableau", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}]}], "]"}], 
         "]"}], " ", "&"}], ",", "\n", "    ", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"d", "^", "4"}], "]"}]}], "\n", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{"projectionRank", "[", "4", "]"}]}], "Input",
 CellLabel->
  "In[201]:=",ExpressionUUID->"50f0b8b1-61da-4614-b56f-07d21278941e"],

Cell[BoxData["20"], "Output",
 CellChangeTimes->{3.988820414448655*^9},
 CellLabel->
  "Out[202]=",ExpressionUUID->"7acecb91-1a85-4fc1-a6f3-1648055ffb39"]
}, Open  ]],

Cell[TextData[{
 "Twenty, as expected. The full ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "4"], " ", "\[TensorProduct]", " ", "G", " ", "L", "(", 
    "d", ")"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7fe03a2d-650e-43cf-9b6a-2bb9c09b33a7"],
 " block dimension is twice this, since ",
 StyleBox["TableauDimension[{2,2}] = 2", "Code"],
 " (there are two standard tableaux of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7f3c45e1-1559-41db-a5e9-dd8f962312c2"],
 ", hence two isomorphic copies of the irreducible representation living \
inside ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{"\[TensorProduct]", " ", "4"}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a7dfd3bf-edfb-4160-83a9-e119c1ef3196"],
 "): the second standard tableau is ",
 StyleBox["YoungTableau[{{1, 2}, {3, 4}}]", "Code"],
 ", projecting onto a separate 20-dimensional subspace orthogonal to the \
first."
}], "Text",ExpressionUUID->"391a42f2-7bd5-4090-8869-2a7967823109"]
}, Open  ]],

Cell[CellGroupData[{

Cell["TN-bond enumeration for a rank-4 bond", "Subsection",ExpressionUUID->"bb81cd46-de71-4c16-b365-febce4945043"],

Cell[TextData[{
 StyleBox["A rank-4 TN tensor at bond dimension ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "4"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f45753e4-f09f-401c-b489-ac873975c16b"],
 StyleBox[" splits into five irreducible-representation blocks of sizes ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
   "{", " ", "35", ",", "135", ",", "40", ",", "45", ",", "1", " ", "}"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8736128d-fc5a-4a23-b783-b13e466ffebc"],
 StyleBox[", summing to ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["4", "4"], "=", "256"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"20e05cbe-3905-4006-9609-0cfe64cf9de7"],
 StyleBox[". ",
  FontSlant->"Italic"],
 StyleBox["IntegerPartitions[4]", "Code"],
 StyleBox[", ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "TableauDimension", "paclet:Wolfram/TensorNetworks/ref/TableauDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c8770dd7-4e0f-4249-8ad3-2c190544cf81"],
 StyleBox[", and ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "SchurDimension", "paclet:Wolfram/TensorNetworks/ref/SchurDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1739a569-82d0-4770-b0da-44d96e578d3f"],
 StyleBox[" together produce this table in closed form, which a \
symmetry-resolved TN library consults to pre-allocate block storage before \
any contraction runs.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"e11b8643-ea75-4d53-b4e4-7fabd47ead49"],

Cell[TextData[{
 "All five partitions of 4 together decompose the rank-4 tensor space at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "4"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "94924edc-5107-410d-afdd-b5efa9343aa9"],
 " block-by-block."
}], "Text",ExpressionUUID->"86071b89-b470-4bab-b40f-79b26d9e4d48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"par", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TableauDimension", "[", "par", "]"}], ",", " ", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{"par", ",", " ", "4"}], "]"}], ",", "\n", "            ", 
      RowBox[{
       RowBox[{"TableauDimension", "[", "par", "]"}], " ", "*", " ", 
       RowBox[{"SchurDimension", "[", 
        RowBox[{"par", ",", " ", "4"}], "]"}]}]}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{"par", ",", " ", 
     RowBox[{"IntegerPartitions", "[", "4", "]"}]}], "}"}]}], "\n", 
  "]"}]], "Input",
 CellLabel->
  "In[203]:=",ExpressionUUID->"aea91b7a-34bf-4999-a15b-a86fc2b80f66"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "4", "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{
        RowBox[{"{", "4", "}"}], ",", "4"}], "]"}], ",", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{
        RowBox[{"{", "4", "}"}], ",", "4"}], "]"}]}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "1"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3", ",", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", "1"}], "}"}], ",", "4"}], "]"}], ",", 
      RowBox[{"3", " ", 
       RowBox[{"SchurDimension", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", "1"}], "}"}], ",", "4"}], "]"}]}]}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}], ",", "4"}], "]"}], ",", 
      RowBox[{"2", " ", 
       RowBox[{"SchurDimension", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}], ",", "4"}], "]"}]}]}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3", ",", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", "1", ",", "1"}], "}"}], ",", "4"}], "]"}], ",", 
      RowBox[{"3", " ", 
       RowBox[{"SchurDimension", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "1", ",", "1"}], "}"}], ",", "4"}], "]"}]}]}], 
     "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", "4"}], 
       "]"}], ",", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", "4"}], 
       "]"}]}], "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.988820414460992*^9},
 CellLabel->
  "Out[203]=",ExpressionUUID->"68e7fc70-ff19-470c-9824-e72839e4c51f"]
}, Open  ]],

Cell[TextData[{
 "Read the totals column (",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", " ", 
    SubscriptBox["V", "\[Lambda]"], "\[CenterDot]", "dim", " ", 
    SubscriptBox["W", "\[Lambda]"], "(", "4", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a3ee8739-0eb6-4316-995f-a3a71d2692bd"],
 "): ",
 Cell[BoxData[
  FormBox[
   RowBox[{"35", "+", "135", "+", "40", "+", "45", "+", "1", "=", "?"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "14b88e82-5fd4-4647-b7c7-968ba1edfa89"],
 ". Sum it."
}], "Text",ExpressionUUID->"d0d5c966-22ae-47d4-895d-542d814c37e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"TableauDimension", "[", "#", "]"}], " ", "*", " ", 
     RowBox[{"SchurDimension", "[", 
      RowBox[{"#", ",", " ", "4"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
   RowBox[{"IntegerPartitions", "[", "4", "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[204]:=",ExpressionUUID->"bbbf78e2-b5e6-4e61-9559-96b201597d4f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SchurDimension", "[", 
   RowBox[{
    RowBox[{"{", "4", "}"}], ",", "4"}], "]"}], "+", 
  RowBox[{"2", " ", 
   RowBox[{"SchurDimension", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}], ",", "4"}], "]"}]}], "+", 
  RowBox[{"3", " ", 
   RowBox[{"SchurDimension", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"3", ",", "1"}], "}"}], ",", "4"}], "]"}]}], "+", 
  RowBox[{"3", " ", 
   RowBox[{"SchurDimension", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "1", ",", "1"}], "}"}], ",", "4"}], "]"}]}], "+", 
  RowBox[{"SchurDimension", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", "4"}], 
   "]"}]}]], "Output",
 CellChangeTimes->{3.988820414480097*^9},
 CellLabel->
  "Out[204]=",ExpressionUUID->"611caac8-8345-4801-8625-75dca56a46f6"]
}, Open  ]],

Cell[TextData[{
 "The total is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"256", "=", 
    SuperscriptBox["4", "4"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a1304198-ae9e-41f9-b02c-979683ba7ef8"],
 ": the five sectors exhaust the space. A TN library can carry the same data \
either as a flat ",
 Cell[BoxData[
  FormBox["256", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f5d1384d-a9e2-4db2-b798-e9d39bd442b0"],
 "-vector or as five block-sparse pieces of sizes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "{", " ", "35", ",", "135", ",", "40", ",", "45", ",", "1", " ", "}"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "208ebdbe-19ec-451f-b54b-61d09ee78949"],
 ". When symmetry forbids transitions between sectors (e.g. only ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"d55258e0-97ca-4e8d-9098-5c6a628c914f"],
 " is dynamical, as for a curvature tensor), the block-sparse form needs ",
 Cell[BoxData[
  FormBox["40", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8c1fe0c8-9db7-4a86-99d6-94fa279bfef2"],
 " numbers instead of ",
 Cell[BoxData[
  FormBox["256", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b90f7c00-dc00-4c3a-bc98-73083cfe85f5"],
 ": a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6.4", "\[Times]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f3b33712-1b95-4149-bddf-dd59c5be46ac"],
 " compression at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "4"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4d821b90-6985-4ab9-95f2-7e8c391b0eba"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6.2", "\[Times]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f1ca7ed3-5096-41ba-ae12-d0368f2f68d6"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "6"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a79c96bd-f8f3-4e28-8b59-3cf00fc38c43"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e68b4c4b-bec3-4bb3-8316-72324eab1780"],
 " block holds ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[CenterDot]", "105", "=", "210"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"76271340-7932-4385-b5bb-63fd4213f07b"],
 " out of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["6", "4"], "=", "1296"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"65723594-3c17-49ed-a598-082e8853173c"],
 "), and so on."
}], "Text",ExpressionUUID->"340ba8d8-4ca8-4a7a-8d79-61095f5f7147"],

Cell["\<\
The dimension counting itself costs only a few hook-length products, the \
cheapest pre-allocation step in a symmetry-resolved TN code.\
\>", "Text",ExpressionUUID->"493b57de-ca04-484a-9762-db0c214e78d4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Block-sparse contraction on a rank-4 bond", "Subsection",ExpressionUUID->"c1dc5ce0-a911-4f65-98ef-ca716e2d12d9"],

Cell[TextData[{
 StyleBox["Contracting two rank-4 tensors at ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "4"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a0a489c9-86c3-4ac5-8255-b164bf0d6ceb"],
 StyleBox[" splits into a ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"5", "\[Times]", "5"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d0952c56-2285-4469-98cf-b53a419d64e7"],
 StyleBox[" same-sector-only diagonal: 20 cross-sector products are zero by \
Schur orthogonality. When one tensor is symmetry-constrained (e.g. \
Riemann-like, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c8b3c41c-bb5f-42ae-824e-a5c7437d090b"],
 StyleBox["-block only), the contraction collapses from 256 multiplications \
to 40, a ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"6.4", "\[Times]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"95b432ab-20be-4182-ade9-47f6b1362804"],
 StyleBox[" FLOP saving per bond that compounds across a many-tensor network.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"8c88f9e2-7b46-4e3d-9808-1b0ef4ecb2a8"],

Cell[TextData[{
 "The enumeration is more than bookkeeping. Every Frobenius contraction of \
two rank-4 tensors at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "4"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "510d701f-7bf3-408d-8ed4-158ff00b2316"],
 " block-decomposes by Schur orthogonality: only same-sector pairs \
contribute, every cross-sector contribution is zero. Build two generic random \
rank-4 tensors."
}], "Text",ExpressionUUID->"ef588c43-bff3-4d2e-81f6-b94bd6ec46e2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T1", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4", ",", " ", "4", ",", " ", "4"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "100", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T2", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4", ",", " ", "4", ",", " ", "4"}], "}"}]}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[205]:=",ExpressionUUID->"7fc539c6-5ad3-4f49-a672-cef69174229d"],

Cell[TextData[{
 "The five partitions of 4 each have several standard tableaux (one per copy \
of the irreducible representation inside ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{"\[TensorProduct]", " ", "4"}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"05f24888-050f-435c-8367-ffaba4ec1ea8"],
 "). Enumerate them in an ",
 Cell[BoxData[
  TemplateBox[{"Association", "paclet:ref/Association"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "132e5a08-c082-4678-a2cf-4130ccf506a6"],
 " keyed by partition."
}], "Text",ExpressionUUID->"afcec06a-3f9e-42fa-af27-ece23228ee58"],

Cell[BoxData[
 RowBox[{
  RowBox[{"syt", " ", "=", " ", 
   RowBox[{"<|", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "4", "}"}], "          ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
        "}"}], "}"}]}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "1"}], "}"}], "       ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", "4", "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", "3", "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", "2", "}"}]}], "}"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}], "       ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}], "}"}]}], ",", "\n",
      "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1", ",", " ", "1"}], "}"}], "    ", "->", " ", 
      
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", "3", "}"}], ",", " ", 
          RowBox[{"{", "4", "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", "2", "}"}], ",", " ", 
          RowBox[{"{", "4", "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", "2", "}"}], ",", " ", 
          RowBox[{"{", "3", "}"}]}], "}"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}], " ",
       "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "1", "}"}], ",", " ", 
         RowBox[{"{", "2", "}"}], ",", " ", 
         RowBox[{"{", "3", "}"}], ",", " ", 
         RowBox[{"{", "4", "}"}]}], "}"}], "}"}]}]}], "\n", "|>"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[209]:=",ExpressionUUID->"ac261bd9-3b09-470f-9fe0-e43e078d5e65"],

Cell[TextData[{
 "The ",
 StyleBox["isotypic",
  FontSlant->"Italic"],
 " projector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6c3a801d-2e5d-44fa-947b-7ad2b3f8a49f"],
 " is the sum of single-tableau projectors over the standard tableaux of \
shape ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "743c213c-798c-4cd5-8efc-d9e9a3a8585b"],
 ". It projects onto the full ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", " ", 
    SubscriptBox["V", "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d95a8514-5309-419e-9a54-bad4018310f8"],
 " copies of the irreducible representation inside ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{"\[TensorProduct]", " ", "4"}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"40d2391b-057b-4f81-ba50-f42c1b205edf"],
 ", and the five ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"037f9cd5-0434-4961-a6e2-28c8d35c3f6c"],
 " together form a resolution of identity."
}], "Text",ExpressionUUID->"e1c05196-e84f-4083-8019-312e86c29694"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"isotypic", "[", 
    RowBox[{"T_", ",", " ", "par_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"YoungProject", "[", 
       RowBox[{"T", ",", " ", 
        RowBox[{"YoungTableau", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
      " ", 
     RowBox[{"syt", "[", "par", "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[210]:=",ExpressionUUID->"78787463-d736-44eb-89dd-b361e9c37474"],

Cell[TextData[{
 "Project ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "1"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6240715c-1a8b-4c22-abe1-7ade7b5f6280"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "28f42643-0e10-4ffb-8cb6-6671bd3d492d"],
 " block-by-block into associations keyed by partition."
}], "Text",ExpressionUUID->"d8d37f11-2a9c-47ff-b9e3-87a0a49d230d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"T1blk", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"isotypic", "[", 
       RowBox[{"T1", ",", " ", "#"}], "]"}], " ", "&"}], ",", " ", 
     RowBox[{"IntegerPartitions", "[", "4", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T2blk", " ", "=", " ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"isotypic", "[", 
       RowBox[{"T2", ",", " ", "#"}], "]"}], " ", "&"}], ",", " ", 
     RowBox[{"IntegerPartitions", "[", "4", "]"}]}], "]"}]}], ";"}]}], "Input",\

 CellLabel->
  "In[211]:=",ExpressionUUID->"65a91e5d-523a-45d8-aa4f-c4d6d7d02e0c"],

Cell[TextData[{
 "The five blocks of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "1"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0fceba57-e678-4e5f-8ea4-6c8334809fab"],
 " sum back to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "1"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5fb1609b-c09c-4a43-b138-ca2789250715"],
 " (resolution of identity)."
}], "Text",ExpressionUUID->"8a29268e-160a-4b85-a990-f5bd6b053744"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"Values", "[", "T1blk", "]"}], "]"}], " ", "-", " ", "T1"}], 
     "]"}], "]"}], "]"}], " ", "<", " ", "tol"}]], "Input",
 CellLabel->
  "In[213]:=",ExpressionUUID->"7bf5cd64-9344-4a99-bf65-1b46723221e9"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988820414522739*^9},
 CellLabel->
  "Out[213]=",ExpressionUUID->"66d4c272-fead-49f2-9465-ddc6f8f6b13d"]
}, Open  ]],

Cell[TextData[{
 "The full Frobenius contraction ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    SubscriptBox["T", "1"], ",", 
    SubscriptBox["T", "2"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8f6d6ea5-a871-44a7-900a-25bf1ce2db5f"],
 " equals the sum of the five within-sector contractions."
}], "Text",ExpressionUUID->"28b8dd59-5541-489d-b3ce-58a5228eba71"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Total", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"T1", " ", "*", " ", "T2"}], "]"}], "]"}], ",", "\n", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"T1blk", "[", "#", "]"}], " ", "*", " ", 
         RowBox[{"T2blk", "[", "#", "]"}]}], "]"}], "]"}], " ", "&"}], " ", "/@",
      " ", 
     RowBox[{"IntegerPartitions", "[", "4", "]"}]}], "]"}]}], "}"}]], "Input",\

 CellLabel->
  "In[214]:=",ExpressionUUID->"24e3d3b5-6c66-436e-9f42-293847d3bfe8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5.984896810106292`", ",", "5.984896810106292`"}], "}"}]], "Output",\

 CellChangeTimes->{3.9888204145327787`*^9},
 CellLabel->
  "Out[214]=",ExpressionUUID->"d4a4f29f-0764-45bf-948a-436e6c8afefc"]
}, Open  ]],

Cell[TextData[{
 "Form the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"5", "\[Times]", "5"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"426bdf11-05c8-497a-b141-139d1a2df79e"],
 " matrix of ",
 StyleBox["cross-sector",
  FontSlant->"Italic"],
 " contractions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    SubsuperscriptBox["T", "1", 
     RowBox[{"(", "\[Lambda]", ")"}]], ",", 
    SubsuperscriptBox["T", "2", 
     RowBox[{"(", "\[Mu]", ")"}]], "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cae440e0-4a05-4932-8cac-caa1ecb04448"],
 ". Every off-diagonal entry vanishes identically by Schur orthogonality."
}], "Text",ExpressionUUID->"e4cf0af8-de0e-49e2-a6f6-aa3e711cfde4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Chop", " ", "@", " ", 
   RowBox[{"Outer", "[", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"T1blk", "[", "#1", "]"}], " ", "*", " ", 
         RowBox[{"T2blk", "[", "#2", "]"}]}], "]"}], "]"}], " ", "&"}], ",", 
     "\n", "    ", 
     RowBox[{"IntegerPartitions", "[", "4", "]"}], ",", " ", 
     RowBox[{"IntegerPartitions", "[", "4", "]"}], ",", " ", "1"}], "\n", 
    "]"}]}], " ", "//", " ", "MatrixForm"}]], "Input",
 CellLabel->
  "In[215]:=",ExpressionUUID->"6f1e77ec-76e6-4452-8b7d-a77aad621d88"],

