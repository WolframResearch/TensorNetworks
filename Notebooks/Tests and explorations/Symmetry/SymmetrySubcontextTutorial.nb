     RowBox[{"SchurDimension", "[", 
      RowBox[{
       RowBox[{"{", "nn", "}"}], ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"2", "^", "nn"}], ",", "\n", "     ", 
