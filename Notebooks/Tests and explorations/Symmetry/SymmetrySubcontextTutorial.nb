Cell[CellGroupData[{

Cell[TextData[{
 "Spring-constant matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["K", 
    RowBox[{"i", "\[NoBreak]", "j"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bd17baa6-40de-414a-be55-21622bcc9adb"],
 " (Hessian of a scalar potential)"
}], "Subsection",ExpressionUUID->"a5b075ac-6af1-4c71-91f8-c668534ab884"],

Cell[TextData[{
 StyleBox["Mixed partials of a smooth potential commute, so the \
spring-constant matrix is symmetric. ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "705eedb4-b1c4-479a-9f8f-576c9f043367"],
 StyleBox[" recasts that textbook identity as a ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d81209fa-e0b6-4f09-a365-34da34c22fbb"],
 StyleBox["-projection statement: the antisymmetric remainder is identically \
zero, checkable in one line.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"4d69c7e2-db68-4a5d-ac1d-3e342b49d50d"],

Cell[TextData[{
 "The spring-constant matrix is the Hessian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["K", 
     RowBox[{"i", "\[NoBreak]", "j"}]], "=", 
    SubscriptBox["\[PartialD]", "i"], " ", 
    SubscriptBox["\[PartialD]", "j"], " ", "V"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"5ca4c4fc-e136-49c8-b7e1-4d51f43e81c7"],
 " of a scalar potential. For a purely quadratic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "(", "x", ",", "y", ")", "=", 
    FractionBox["1", "2"], "(", "3", " ", 
    SuperscriptBox["x", "2"], "+", "2", " ", 
    SuperscriptBox["y", "2"], "+", "x", " ", "y", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"15a94495-cf56-43b8-b37f-966418bd8c16"],
 " the Hessian is a constant matrix with no ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", ",", "y"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "347c8c2f-8b03-42c4-98d0-70dce75d371b"],
 " dependence, so no equilibrium-point substitution is needed. The built-in \
second-order form ",
 StyleBox["D[V, {{x, y}, 2}]", "Code"],
 " handles the partial-derivative bookkeeping."
}], "Text",ExpressionUUID->"5403d33d-f732-4be8-ad24-36e3b049b65a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"K", " ", "=", " ", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"x", "^", "2"}]}], " ", "+", " ", 
       RowBox[{"2", " ", 
        RowBox[{"y", "^", "2"}]}], " ", "+", " ", 
       RowBox[{"x", " ", "y"}]}], ")"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "2"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"ac2ad1be-a0ec-4a35-ba40-c9cef248234e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", 
     FractionBox["1", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "2"], ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9888204125468473`*^9},
 CellLabel->"Out[43]=",ExpressionUUID->"5785f9bd-b87d-4531-a4f6-c30c025d584d"]
}, Open  ]],

