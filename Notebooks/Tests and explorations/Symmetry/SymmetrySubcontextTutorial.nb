Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{
     "e3c", " ", "+", " ", "e21c", " ", "+", " ", "e111c", " ", "-", " ", 
      "T3c"}], "]"}], "]"}], "]"}], " ", "<", " ", "tol"}]], "Input",
 CellLabel->
  "In[145]:=",ExpressionUUID->"a73624b2-a54b-4b1d-80d6-a2deed5f01a8"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988820413526094*^9},
 CellLabel->
  "Out[145]=",ExpressionUUID->"d6be658f-fe6c-4be1-a301-a3e4dbb007c2"]
}, Open  ]],

Cell[TextData[{
 "Hermiticity is ",
 Cell[BoxData[
  TemplateBox[{"ConjugateTranspose", "paclet:ref/ConjugateTranspose"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "463fb908-ff96-4408-929a-5b8896a57dc9"],
 " (transpose composed with conjugation) and lives in built-in WL's ",
 StyleBox["Hermitian[{1,2}]", "Code"],
 " symmetry head, not in the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a73c22e4-7f9e-4927-be7e-88b078306867"],
 " representation theory the Symmetry functions implement. The two layers \
compose without collapsing: a tensor can be Hermitian without being \
symmetric, and the Young projector touches only the symmetric / antisymmetric \
layer."
}], "Text",ExpressionUUID->"d1820b29-6949-4360-a75c-80dfc08f51ab"],

Cell[CellGroupData[{

Cell["Block-sparse Frobenius contraction on a rank-3 bond", "Subsection",ExpressionUUID->"57918af1-52b6-4d9f-b6fe-37f56f6ebe9c"],

Cell[TextData[{
 StyleBox["Contracting two rank-3 tensors splits cleanly along symmetry \
sectors: only same-sector pieces talk. ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ed63b85a-02d7-4d03-a580-293f50a63661"],
 StyleBox[" decomposes each tensor into its bosonic, parastatistical, and \
fermionic blocks; the six cross-block Frobenius products vanish identically \
by Schur orthogonality, telling the contraction engine which products to \
skip.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"696a176c-0f8d-4c2d-8d3f-8869b7a00a9b"],

Cell[TextData[{
 "The block decomposition is not just a vector-space identity: it makes inner \
products block-diagonal. The Frobenius (Hilbert-Schmidt) contraction ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[LeftAngleBracket]", "T", ",", "S", "\[RightAngleBracket]", "=", 
    UnderscriptBox["\[Sum]", 
     RowBox[{"i", " ", "j", " ", "k"}]], " ", 
    SubscriptBox["T", 
     RowBox[{"i", " ", "j", " ", "k"}]], " ", 
    SubscriptBox["S", 
     RowBox[{"i", " ", "j", " ", "k"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"56b3dec6-4019-45b1-b8dd-c544ef2383ca"],
 " between two rank-3 tensors on the same bond splits into a sum of three \
within-block pieces, with every cross-block term zero. This is the rank-3 \
analogue of the rank-2 block-sparse trace, and it is the workhorse identity \
behind symmetry-resolved tensor-network contractions: a network of symmetric \
tensors decomposes into a direct sum of smaller networks, one per irreducible \
representation."
}], "Text",ExpressionUUID->"d3597220-590c-4916-af20-a429e69aca20"],

Cell[TextData[{
 "Build a second random rank-3 tensor ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9929d806-f335-49db-be15-a84960bb9711"],
 " on the same ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3112d3ac-7bb3-4bb7-b535-84fa823754f9"],
 " bond."
}], "Text",ExpressionUUID->"b2115430-22d9-4b3e-af62-014c1418b1a2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "200", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"S3", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[146]:=",ExpressionUUID->"3a390e70-b4b6-4b8f-b2de-9c27f405d5ef"],

Cell["Compute the full Frobenius contraction directly.", "Text",ExpressionUUID->"1a74eef0-0469-4b51-bc41-0d30061daeea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"froFull", " ", "=", " ", 
  RowBox[{"Total", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{"T3", " ", "*", " ", "S3"}], "]"}], "]"}]}]], "Input",
 CellLabel->
