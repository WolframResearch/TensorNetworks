 CellLabel->"Out[8]=",ExpressionUUID->"c11d4536-19fd-4147-b724-b20fb7f67114"]
}, Open  ]],

Cell[TextData[{
 "The explicit form matters beyond rank 2 because it picks ",
 StyleBox["which",
  FontSlant->"Italic"],
 " slot lives in which row and column. For example, ",
 StyleBox["YoungTableau[{{1, 3}, {2}}]", "Code"],
 " is a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f574e78a-015c-4d02-bd5e-252dd64fb340"],
 "-shape tableau on rank 3 with slot 3 paired with slot 1 in the column, \
distinct from the default ",
 StyleBox["YoungTableau[{{1, 2}, {3}}]", "Code"],
 " that fills row by row."
}], "Text",ExpressionUUID->"390f0598-576e-4f23-b979-2e98dcef88ab"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
   "YoungTableauQ", "paclet:Wolfram/TensorNetworks/ref/YoungTableauQ"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7fdb7027-5b71-434d-aeb9-56c326aa3f10"],
 " decides whether a ",
 StyleBox["YoungTableau[...]", "Code"],
 " is well-formed, rejecting malformed input before it reaches ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5f391574-6f5b-4d1a-a4e9-14d23074ae12"],
 ". Increasing row lengths violate the partition condition."
}], "Text",ExpressionUUID->"04c4b165-344e-4663-bc5f-63584c8a09a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableauQ", "[", 
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"f12a2bcb-d2c9-4f29-9aa7-5501d0c075be"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.988820412271552*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"36af0a2f-dbbf-47e0-8fdf-d6090083d4e7"]
}, Open  ]],

Cell["Duplicate slot labels are rejected.", "Text",ExpressionUUID->"da9eaab2-4355-43c8-aee0-aca58307e07c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableauQ", "[", 
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"9d31622e-ec74-4f74-8598-98168d199ca2"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.9888204122768497`*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"93030f98-50ad-4dfc-9f4a-5f633304450a"]
}, Open  ]],

Cell[TextData[{
 "Slot labels that are not a permutation of ",
 StyleBox["Range[n]", "Code"],
 " are rejected even when distinct and positive. Here the slots are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "2", ",", "3", ",", "5", ",", "7", " ", "}"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "42ce720c-866d-4a52-8c20-8846198bc6d4"],
 ", missing ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7a4974d9-fdee-4a41-be40-ed9b7abaa048"],
 " and ",
 Cell[BoxData[
  FormBox["6", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "38797ab1-c1e9-408d-bf90-008022ad40e0"],
 "."
}], "Text",ExpressionUUID->"e72e138b-fbf2-4022-b554-a13956373543"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableauQ", "[", 
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "5", ",", " ", "7"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"eccb27eb-bc20-4491-86ec-c81c40f3acdf"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.9888204122885017`*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"6c50b7a9-9984-4945-b75d-35b5e7052c77"]
}, Open  ]],

Cell[TextData[{
 "Custom slot orderings ",
 StyleBox["within",
  FontSlant->"Italic"],
 " the legal label set are allowed: the slots here are a permutation of ",
 StyleBox["Range[5]", "Code"],
 "."
}], "Text",ExpressionUUID->"862a3e3c-b7d5-4f5b-a5e2-ed18a1675883"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableauQ", "[", 
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3", ",", " ", "5"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"a70cb982-a302-4864-a26e-e4eb949fb567"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988820412293625*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"5dbc87f9-810a-48e6-b023-290914e17080"]
}, Open  ]],

Cell[TextData[{
 "Anything that is not a ",
 StyleBox["YoungTableau[...]", "Code"],
 " is rejected by head."
}], "Text",ExpressionUUID->"9293fcf1-73cb-486e-9ff4-557f89c1bd94"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableauQ", "[", "\"\<definitely not a tableau\>\"", 
  "]"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"91f94267-b092-4104-855a-fbbe6c9697b6"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.9888204123082027`*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"04900735-2d9b-408a-87b7-5639997b3f3c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Familiar rank-2 tensors and their TN-bond payoffs", "Section",ExpressionUUID->"95de283c-7e3d-48e1-bbdf-a1c3132c4610"],

Cell[TextData[{
 "The two rank-2 tableau classes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3ec06f10-bc66-4357-abbc-6f7deb7630a0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"76a436f3-477c-479a-972a-bfe0e3930df7"],
 " are nothing exotic: they are every symmetric matrix and every \
antisymmetric matrix you have ever seen. The examples below confirm this on \
textbook tensors (metric, Pauli, EM, Levi-Civita, covariance) and then turn \
the same projection machinery on three operational TN constructs: \
singlet/triplet decomposition, the SWAP-gate eigenspace, and a fermionic bond \
inside a tensor-network contraction. All of them share the rank-2 tableaux ",
 StyleBox["symTab", "Code"],
 " and ",
 StyleBox["antiTab", "Code"],
 " and the same ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9e9e670c-2672-4c48-b971-eb2ef1861183"],
 " workflow."
}], "Text",ExpressionUUID->"28332470-036b-44e1-bc91-84ed6a335e3a"],

Cell[TextData[{
 "The four single-qubit operators (identity plus the three Pauli matrices) \
are a clean illustration. Each is a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"54eee160-1692-4f59-bb3b-b01dfab0c3a8"],
 " matrix that lies entirely in one of the two shapes:"
}], "Text",ExpressionUUID->"74170391-606e-4b3b-9345-5614b8607de4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Id", ",", " ", "sx", ",", " ", "sy", ",", " ", "sz"}], "}"}], 
   " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "j", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"5f200c64-46c1-41e4-aadf-fee7c67821ce"],

Cell[TextData[{
 "The identity, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "x"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6dcdd9a6-7c98-43d6-b4dc-30471411ae86"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "z"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"064903f4-d600-48ad-86ce-28efcd257685"],
 " equal their own transpose; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "y"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cdc02d0e-5a25-40bb-b303-2a2d1fe58752"],
 " negates under transpose:"
}], "Text",ExpressionUUID->"1df5d6b6-6212-4022-9115-6cee66500fbe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Id", " ", "==", " ", 
    RowBox[{"Transpose", "[", "Id", "]"}]}], ",", " ", 
   RowBox[{"sx", " ", "==", " ", 
    RowBox[{"Transpose", "[", "sx", "]"}]}], ",", " ", 
   RowBox[{"sy", " ", "==", " ", 
    RowBox[{"-", 
     RowBox[{"Transpose", "[", "sy", "]"}]}]}], ",", " ", 
   RowBox[{"sz", " ", "==", " ", 
    RowBox[{"Transpose", "[", "sz", "]"}]}]}], "}"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"459a8c26-2707-40b4-93d1-4919db503c2e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.988820412322439*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"16696c16-e754-4170-b437-8b9e9ef2d838"]
}, Open  ]],

Cell[TextData[{
 "So the four-element Pauli basis splits as three matrices in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"35da7dc0-70d0-4cbf-92f9-dd4a126fa97e"],
 " shape (",
 Cell[BoxData[
  FormBox[
   RowBox[{"I", ",", 
    SubscriptBox["\[Sigma]", "x"], ",", 
    SubscriptBox["\[Sigma]", "z"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"75157fea-2433-4bb8-8579-5fc28dd0ff5d"],
 ") and one in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"64230acc-60b6-446d-b0ec-009419a6191f"],
 " shape (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "y"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a356f2c6-cc09-427d-a76e-84f05004c53c"],
 "). That matches the Schur-Weyl dimensions exactly: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "(", "d", "+", "1", ")", "/", "2", "=", "3"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d01af787-277d-42ba-8581-eaec52c1d179"],
 " symmetric matrices plus ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "(", "d", "-", "1", ")", "/", "2", "=", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "573348b5-4080-4e68-99b7-2d68a1392933"],
 " antisymmetric matrix gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "=", 
    SuperscriptBox["d", "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"27b8850d-4805-4dc5-a8ce-146c1713c870"],
 " total."
}], "Text",ExpressionUUID->"105ef8b7-1306-43fc-abd2-bf45800f848c"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "52299b22-e517-43c1-93ae-5206037f868e"],
 " applied to a tensor that already lives in one shape is a sanity check: the \
right-shape projection is the identity on that tensor, the wrong-shape \
projection is zero. Name the symmetric two-box tableau."
}], "Text",ExpressionUUID->"569dc40d-1aab-4d03-aa18-df9701ee1d76"],

Cell[BoxData[
 RowBox[{
  RowBox[{"symTab", " ", "=", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", "2", "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"1b2dc226-b157-498f-8dff-eb4e1f0c820c"],

Cell["Name the antisymmetric two-box tableau.", "Text",ExpressionUUID->"d6de32f7-af84-4203-b260-4421ac406e67"],

Cell[BoxData[
 RowBox[{
  RowBox[{"antiTab", " ", "=", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"3633fd1c-42a0-4e0b-97c9-808fcc6710e1"],

Cell[TextData[{
 "A ",
 StyleBox["YoungTableau[...]", "Code"],
 " is atomic, so explicit accessors are the only way to read off its row and \
column structure. ",
 Cell[BoxData[
  TemplateBox[{"TableauRows", "paclet:Wolfram/TensorNetworks/ref/TableauRows"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "95e1efee-0703-449a-a3bc-d75d0455abe6"],
 " returns the list of row-slot lists; ",
 Cell[BoxData[
  TemplateBox[{
   "TableauColumns", "paclet:Wolfram/TensorNetworks/ref/TableauColumns"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6acd6c98-2297-4923-969c-a47994ae25e3"],
 " returns the list of column-slot lists (correctly handling ragged shapes). \
These are the inputs ",
 Cell[BoxData[
  TemplateBox[{
   "YoungSymmetrize", "paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5a423db1-6c46-488b-9807-7eea8dc57e9e"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "729d7ccf-2b21-4f79-a8b5-f147221bf652"],
 " consume internally. Read the symmetric tableau's row and column lists."
}], "Text",ExpressionUUID->"5a05b296-4337-443d-b39b-ac3d881803cf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"TableauRows", "[", "symTab", "]"}], ",", " ", 
   RowBox[{"TableauColumns", "[", "symTab", "]"}]}], "}"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"84c03d50-dcaf-4de0-b4d1-b775a9709e70"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", "2", "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988820412342161*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"637cd945-426f-4fd5-ab55-1a1a6ecf3f67"]
}, Open  ]],

Cell["Read the antisymmetric tableau's row and column lists.", "Text",ExpressionUUID->"bc7bcc60-458f-41f7-96b7-4ff720a857a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"TableauRows", "[", "antiTab", "]"}], ",", " ", 
   RowBox[{"TableauColumns", "[", "antiTab", "]"}]}], "}"}]], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"9d55cdce-2b87-4366-b458-d058546a663b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", "2", "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988820412354246*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"4522a2d0-e7f7-4315-93cc-ed8e8071550a"]
}, Open  ]],

Cell[TextData[{
 "Note the row-column swap between ",
 StyleBox["symTab", "Code"],
 " and ",
 StyleBox["antiTab", "Code"],
 ": transposing the partition (",
 StyleBox["{2}", "Code"],
 " \[LeftRightArrow] ",
 StyleBox["{1, 1}", "Code"],
 ") swaps the row and column slot lists, which is exactly the \"exchange \
symmetric for antisymmetric\" mirror visible at the structural level."
}], "Text",ExpressionUUID->"b255fd80-fca0-4ce1-abdd-6262b9e29ad5"],

Cell[TextData[{
 "Before turning these tableaux loose on real tensors, sanity-check that both \
are well-formed standard tableaux. The ",
 Cell[BoxData[
  TemplateBox[{
   "YoungTableauQ", "paclet:Wolfram/TensorNetworks/ref/YoungTableauQ"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4c513802-ae03-4269-b56f-8b63cdc008bd"],
 " predicate is the gatekeeper: it rejects ill-formed entries (already shown \
in the constructor section above) and accepts the well-formed ones. Check the \
symmetric tableau."
}], "Text",ExpressionUUID->"9abd721f-32fb-40e7-936d-ac38121a5b21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableauQ", "[", "symTab", "]"}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"ddee8255-7560-4018-91c3-358d2529a39f"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988820412361116*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"da9a719b-a2b8-4fcb-9abc-2aedb4ab62d8"]
}, Open  ]],

Cell["Check the antisymmetric tableau.", "Text",ExpressionUUID->"04fecdcc-a8a7-4d7e-8c18-861b318d3d63"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableauQ", "[", "antiTab", "]"}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"bb43f704-a72c-400d-a2fc-bf3114a8abe7"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988820412372344*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"c968ec6b-dea2-43fa-adec-620cb4f897c9"]
}, Open  ]],

Cell[TextData[{
 "Both pass. Next, read off the structural numbers each tableau carries. ",
 Cell[BoxData[
  TemplateBox[{
   "TableauShape", "paclet:Wolfram/TensorNetworks/ref/TableauShape"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "33ef9d79-5d09-4c38-b604-b0b906e0b3ed"],
 " returns the underlying partition; ",
 Cell[BoxData[
  TemplateBox[{"TableauSize", "paclet:Wolfram/TensorNetworks/ref/TableauSize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ab1e1cbd-0075-4a74-b83d-42592259cda8"],
 " returns the total box count, which is the rank of any tensor the tableau \
can act on. Read the symmetric tableau's partition."
}], "Text",ExpressionUUID->"4d1ec492-5ba7-4b41-8957-7b715cd516f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauShape", "[", "symTab", "]"}]], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"c7a566f0-017c-45fd-90b4-069ccbae2297"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output",
 CellChangeTimes->{3.988820412377426*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"58ab4f62-fe54-4ee3-bbfd-fa5192cf5152"]
}, Open  ]],

Cell["Read its box count.", "Text",ExpressionUUID->"10f313a6-2af5-44e9-83d3-fed2bf57c031"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauSize", "[", "symTab", "]"}]], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"a599daac-655f-4d5b-9b3a-f5fe2a93c66e"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.988820412389112*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"c5ed5261-1d98-4113-87fa-7021e490821a"]
}, Open  ]],

Cell["Read the antisymmetric tableau's partition.", "Text",ExpressionUUID->"ce733c8d-6290-4df1-8e0a-927b38f96db0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauShape", "[", "antiTab", "]"}]], "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"9820a0fc-b2be-4b0c-9818-0be0354c09bd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{3.988820412395224*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"90b2a151-31bf-431b-a5f2-8d99820f417f"]
}, Open  ]],

Cell["Read its box count.", "Text",ExpressionUUID->"402ce615-a6e6-4e92-b0b2-ee764607da28"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauSize", "[", "antiTab", "]"}]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"2738b6e9-194b-4428-9194-16c663c00294"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.988820412407226*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"715e73b7-555e-453e-b99b-db6240b705b0"]
}, Open  ]],

Cell["\<\
Both tableaux carry two boxes, so they act on rank-2 tensors. Every concrete \
example in the rest of this section is a rank-2 tensor, so this constraint is \
automatically met; later sections that work with rank-3 and rank-4 tensors \
will need different tableaux of the matching size.\
\>", "Text",ExpressionUUID->"9f7c098d-96ee-4d4f-abc6-fd00600467eb"],

Cell[TextData[{
 "Project ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "x"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"41fe11e7-413f-4cb5-ba7a-ba9c00978835"],
 " onto the symmetric shape; the result is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "x"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cb8669a4-b181-423b-9fc6-bb6078cd384b"],
 " itself."
}], "Text",ExpressionUUID->"3480aba8-f290-4354-8cef-fd45f95cabb8"],

