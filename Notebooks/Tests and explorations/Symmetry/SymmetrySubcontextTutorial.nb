}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
   "TransposePartition", 
    "paclet:Wolfram/TensorNetworks/ref/TransposePartition"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8c396ab2-b19b-4144-b061-ab70b3adc29a"],
 " is the boson\\[LeftRightArrow]fermion duality: flipping the diagram across \
its main diagonal swaps the symmetric and antisymmetric statistics. The \
mixed-symmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0c795072-c62c-4790-b00f-4e5935ad347b"],
 " is self-conjugate at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "79fdb734-8e35-4d77-9da3-f820f89d76ef"],
 "."
}], "Text",ExpressionUUID->"76ccc8db-8b63-4956-8b6b-e8ca3b22bd88"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransposePartition", " ", "/@", " ", "parts"}]], "Input",
 CellLabel->
  "In[130]:=",ExpressionUUID->"59b04213-8f25-43c1-95c9-cf9cb9e2a5ed"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988820413412238*^9},
 CellLabel->
  "Out[130]=",ExpressionUUID->"ccb321a0-5773-4fc4-9e66-7e1e01805f3f"]
}, Open  ]],

Cell[TextData[{
 "The GL(",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a20ff260-6a6b-4d3d-95fb-685572894b78"],
 ") factor of the Weyl dimension formula is exported as ",
 StyleBox["SchurDimension[par, d]", "Code"],
 ", the Symmetry functions' hook-content-formula counterpart to ",
 Cell[BoxData[
  TemplateBox[{
   "TableauDimension", "paclet:Wolfram/TensorNetworks/ref/TableauDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7f40682e-0509-4129-8930-5253827c71db"],
 ": while ",
 StyleBox["TableauDimension[par]", "Code"],
 " returns the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c7090622-b8bb-4902-b6ca-a80c8813f3d3"],
 " irreducible representation dim ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", " ", 
    SubscriptBox["V", "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1626063e-c59b-4e1b-b10d-a12e8d3d03fa"],
 " (independent of ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "91b27c7d-febc-4438-a512-7e59ca282cf9"],
 "), ",
 StyleBox["SchurDimension[par, d]", "Code"],
 " returns the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "L", "(", "d", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"37949a64-a057-4eb8-b4df-ab27b9de4c1b"],
 " Weyl module dim ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", " ", 
    SubscriptBox["W", "\[Lambda]"], "(", "d", ")", "=", 
    UnderscriptBox["\[Product]", 
     RowBox[{"(", "i", ",", "j", ")", "\[Element]", "\[Lambda]"}]], "(", "d", 
    "+", "j", "-", "i", ")", "/", "h", "(", "i", ",", "j", ")"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "abdf68ab-5940-4f7f-ab51-eb799e5cc13b"],
 ". The two together give the size of the ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "00010b8a-8cd9-4617-a7a8-3b5006c4d22f"],
 "-block of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{"\[TensorProduct]", " ", "n"}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"d7f74301-6cb6-452b-97ae-d499a0cd4082"],
 "."
}], "Text",ExpressionUUID->"5c8c960a-bf02-4582-8af3-05019a85c50c"],

Cell[TextData[{
 "Predict the block sizes at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2", ",", "n", "=", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"2569e25f-c094-4994-b154-f36e8afe04be"],
 ":"
}], "Text",ExpressionUUID->"a1cceb2a-4fd5-4cc7-a1ec-c771d9d1f02e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"par", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TableauDimension", "[", "par", "]"}], ",", " ", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{"par", ",", " ", "2"}], "]"}], ",", "\n", "            ", 
      RowBox[{
       RowBox[{"TableauDimension", "[", "par", "]"}], " ", "*", " ", 
       RowBox[{"SchurDimension", "[", 
        RowBox[{"par", ",", " ", "2"}], "]"}]}]}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{"par", ",", " ", "parts"}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[131]:=",ExpressionUUID->"66fd3fff-6129-4cdc-80af-f52abb98836e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "3", "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{
        RowBox[{"{", "3", "}"}], ",", "2"}], "]"}], ",", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{
        RowBox[{"{", "3", "}"}], ",", "2"}], "]"}]}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}], ",", "2"}], "]"}], ",", 
      RowBox[{"2", " ", 
       RowBox[{"SchurDimension", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "1"}], "}"}], ",", "2"}], "]"}]}]}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", "2"}], "]"}], ",", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", "2"}], "]"}]}], 
     "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9888204134172077`*^9},
 CellLabel->
  "Out[131]=",ExpressionUUID->"37c1faf8-576a-4973-b22b-c1f4052b57ce"]
}, Open  ]],

Cell[TextData[{
 "Read row by row: the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "3", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b3717f46-dcac-4a1b-ae9f-db21b42692ba"],
 " block has size ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[CenterDot]", "4", "=", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"bf33185c-203c-43ef-a688-5a6417f64046"],
 " (a four-dimensional bosonic sector). The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"1fe177a4-a7d3-46f0-afdb-38588a5d5303"],
 " mixed block has size ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[CenterDot]", "2", "=", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"1ba15262-5964-4afe-800c-c4d180a74eae"],
 ". The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"689fe5b5-7920-42ad-a750-38fe42815c15"],
 " fermionic block has size ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[CenterDot]", "0", "=", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"58af98f1-65bf-4d8a-98ff-fd33cc282b88"],
 ", ",
 StyleBox["exactly zero",
  FontSlant->"Italic"],
 ", because you cannot antisymmetrise three slots over a two-dimensional \
space (the Pauli principle for three spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ffc524dd-2962-4f7a-ace7-ca28faa79f02"],
 " particles forbids it). The sum is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "+", "4", "+", "0", "=", "8", "=", 
    SuperscriptBox["d", "n"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e4fa3b33-e935-4d8b-a82b-3248353bad5c"],
 ". The decomposition exhausts the tensor space and tells you, without ever \
forming a projector, that any operation involving the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6cbd9ed5-3115-48a0-94eb-4729fe4365ed"],
 " sector can be skipped."
}], "Text",ExpressionUUID->"5751068b-9e57-4f40-82c8-6f7d8aee4285"],

Cell[TextData[{
 "When the input is already a ",
 Cell[BoxData[
  TemplateBox[{
   "YoungTableau", "paclet:Wolfram/TensorNetworks/ref/YoungTableau"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2761adb8-fae1-4779-8424-a94d5e499a8f"],
 ", ",
 StyleBox["TableauWeylDimension[tab, d]", "Code"],
 " returns the same ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", " ", 
    SubscriptBox["W", "\[Lambda]"], "(", "d", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ac0df4a9-a80d-4462-97f6-338673f77791"],
 " by delegating to ",
 StyleBox["SchurDimension[TableauShape[tab], d]", "Code"],
 ". Pair it with ",
 StyleBox["TableauDimension[tab]", "Code"],
 " to read both Schur-Weyl factors off the same object."
}], "Text",ExpressionUUID->"53f1ca5d-c2a9-47db-b14a-1373c23b82a6"],

