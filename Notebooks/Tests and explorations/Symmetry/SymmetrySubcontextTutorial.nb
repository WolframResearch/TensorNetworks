Cell[TextData[{
 "Evaluating returns the typed tableau with its rendered ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"68d06afd-8974-421f-aa77-57e64e05718a"],
 " diagram filled with the slot labels ",
 StyleBox["1, 3", "Code"],
 " (row 1) and ",
 StyleBox["2, 4", "Code"],
 " (row 2); the same nested list ",
 StyleBox["{{1, 3}, {2, 4}}", "Code"],
 " round-trips out via ",
 Cell[BoxData[
  TemplateBox[{"TableauRows", "paclet:Wolfram/TensorNetworks/ref/TableauRows"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8c326f81-bc4d-4989-addb-4db2746d8a21"],
 ". Name the tableau once and project the generic rank-4 tensor."
}], "Text",ExpressionUUID->"403d37f6-f860-46ee-93cf-21b9d18e0962"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tab", " ", "=", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T0", ",", " ", "tab"}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[180]:=",ExpressionUUID->"37dbfa74-5e45-49d2-a4cf-ef009dfa203a"],

Cell[TextData[{
 "An element ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", "k"], " ", 
    SubscriptBox["c", "k"], " ", "\[ThinSpace]", " ", 
    SubscriptBox["\[Sigma]", "k"], "\[Element]", "\[DoubleStruckCapitalC]", "[", 
    SubscriptBox["S", "4"], "]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b55a7f1d-9053-4684-ab15-5ad6364e2be8"],
 " acts on ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "568da9e3-b80f-4074-9a26-eb30cda2d60a"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", "k"], " ", 
    SubscriptBox["c", "k"], " ", "\[ThinSpace]", " ", 
    SubscriptBox["\[Sigma]", "k"], "(", "R", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"79cfcabf-4f76-4cf1-a692-99960b0fd1f4"],
 ", and is an algebraic identity of ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "22b7ff8f-48f8-4f2a-81a5-26a7fe0c9273"],
 " exactly when that sum is zero. The right-annihilator of ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e9a5d2eb-d58a-4d7f-a781-6f9ab56818f4"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleStruckCapitalC]", "[", 
    SubscriptBox["S", "4"], "]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ea85f9f2-8903-40dc-ad97-380abf4b2302"],
 " is the space of identities the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a2f91acd-395a-4ddc-8779-fc077f3ca0b2"],
 " irreducible representation enforces, and it is searchable: precompute the \
24 permuted copies of ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8b7f48d5-f1d4-4e2f-b050-8e4b41efa7ce"],
 " once and the relation predicate becomes a single dot product against a \
coefficient vector."
}], "Text",ExpressionUUID->"5ee7b960-e876-4336-ab1b-46ca1ce939ba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"perms", " ", "=", " ", 
   RowBox[{"Permutations", "[", 
    RowBox[{"Range", "[", "4", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"permutedR", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"R", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "perms"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"isRelation", "[", "coefs_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"coefs", " ", ".", " ", "permutedR"}], "]"}], "]"}], "]"}], 
    " ", "<", " ", "tol"}]}], ";"}]}], "Input",
 CellLabel->
  "In[182]:=",ExpressionUUID->"2eabfd35-ee36-456d-b46f-05229158811e"],

Cell[TextData[{
 "Sweep all two-term combinations ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "a"], "+", "\[CurlyEpsilon]", " ", 
    "\[ThinSpace]", " ", 
    SubscriptBox["\[Sigma]", "b"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"99489d10-7c37-4441-9323-937adc5fc375"],
 " over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "<", "b"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1cf709b0-0933-49fe-b761-55dc54a87c44"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[CurlyEpsilon]", "\[Element]", "{", " ", "\[PlusMinus]", " ", "1", " ", 
    "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7e607357-8e1e-46e1-bb3a-dc3ed2799b3c"],
 " using ",
 Cell[BoxData[
  TemplateBox[{"Subsets", "paclet:ref/Subsets"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ac89eee7-2037-4b88-bb5c-1c449cebb616"],
 " to enumerate ordered index pairs and ",
 Cell[BoxData[
  TemplateBox[{"Cases", "paclet:ref/Cases"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4cc8246d-1aa1-4339-9b3f-6367ff5a49b1"],
 " to keep only the annihilators, decoded as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["\[Sigma]", "a"], ",", "\[CurlyEpsilon]", ",", 
    SubscriptBox["\[Sigma]", "b"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"96ee445d-1368-4f2f-9015-7b6cdacba547"],
 " triples."
}], "Text",ExpressionUUID->"87f9b247-8b1f-4f06-a89e-43529d1da335"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"twoTerm", " ", "=", " ", 
   RowBox[{"Cases", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "[", "24", "]"}], ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}]}], "}"}], "]"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a_", ",", " ", "b_"}], "}"}], ",", " ", "eps_"}], "}"}], 
       " ", "/;", " ", 
       RowBox[{"isRelation", "[", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"b", " ", "->", " ", "eps"}]}], "}"}], ",", " ", "24"}], 
         "]"}], "]"}]}], " ", ":>", "\n", "        ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"perms", "[", 
         RowBox[{"[", "a", "]"}], "]"}], ",", " ", "eps", ",", " ", 
        RowBox[{"perms", "[", 
         RowBox[{"[", "b", "]"}], "]"}]}], "}"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"Length", "[", "twoTerm", "]"}]}], "Input",
 CellLabel->
  "In[185]:=",ExpressionUUID->"c24b9804-21ca-419c-b6c7-7b32fa4ab264"],

Cell[BoxData["84"], "Output",
 CellChangeTimes->{3.988820414134801*^9},
 CellLabel->
  "Out[186]=",ExpressionUUID->"8950f2f6-ed47-4c48-9c65-c8279f7bf339"]
}, Open  ]],

Cell["\<\
The search returns 84 two-term identities, derived without input from the \
textbook. They include the three classical Riemann pair-symmetries plus every \
consequence (composing two pair-antisymmetries gives a pair-swap, etc.). \
Extract the textbook three from the discovered list by set intersection.\
\>", "Text",ExpressionUUID->"1026ff9e-9135-4763-bad7-54d9af710d88"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Intersection", "[", 
  RowBox[{"twoTerm", ",", " ", 
   RowBox[{"{", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
        "  ", "1", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
        "  ", "1", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "4", ",", " ", "3"}], "}"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
        " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4", ",", " ", "1", ",", " ", "2"}], "}"}]}], 
      "}"}]}], "\n", "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[187]:=",ExpressionUUID->"15a8465e-27e6-49e5-bfb8-ce509046b01e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
     RowBox[{"-", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4", ",", "1", ",", "2"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", "1", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "4", ",", "3"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", "1", ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1", ",", "3", ",", "4"}], "}"}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.988820414160843*^9},
 CellLabel->
  "Out[187]=",ExpressionUUID->"c917bfcb-64ed-4e06-adde-056315591b68"]
}, Open  ]],

Cell[TextData[{
 "The three textbook generators (slot ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "1", ",", "2", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8440a552-c560-4f71-8de2-a00f3b365a33"],
 " antisym, slot ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "3", ",", "4", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ab019853-910e-4e78-8855-742e49131874"],
 " antisym, pair-swap) are present in the discovered list, but not \
privileged: the projector treats all 84 derived two-term identities on equal \
footing."
}], "Text",ExpressionUUID->"58f933a3-4e20-42d7-9d4e-dd23e527b162"],

Cell[TextData[{
 "Now sweep three-term identities ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "a"], "+", 
    SubscriptBox["\[Sigma]", "b"], "+", 
    SubscriptBox["\[Sigma]", "c"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3ac960cf-96c8-4218-ab17-2cc2d0f0e627"],
 " supported on permutations that fix slot 1 (i.e. act non-trivially only on \
slots ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "3", ",", "4", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"abab28d7-2558-445e-9abd-6d24ada201c7"],
 "). The Bianchi identity will appear here without our naming it. The \
slot-1-fixing positions come straight from ",
 Cell[BoxData[
  TemplateBox[{"Position", "paclet:ref/Position"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b704afd8-97cd-4cc7-816c-9ea997b83315"],
 "; the subset enumerator is ",
 StyleBox["Subsets[*, {3}]", "Code"],
 "."
}], "Text",ExpressionUUID->"116af4dd-a245-4be5-b1d4-2d86f2f428ed"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fixSlot1", " ", "=", " ", 
   RowBox[{"Flatten", " ", "@", " ", 
    RowBox[{"Position", "[", 
     RowBox[{"perms", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "_", ",", " ", "_", ",", " ", "_"}], "}"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"threeTerm", " ", "=", " ", 
   RowBox[{"Cases", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{"fixSlot1", ",", " ", 
       RowBox[{"{", "3", "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a_", ",", " ", "b_", ",", " ", "c_"}], "}"}], " ", "/;", " ", 
       RowBox[{"isRelation", "[", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"b", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"c", " ", "->", " ", "1"}]}], "}"}], ",", " ", "24"}], 
         "]"}], "]"}]}], " ", ":>", "\n", "        ", 
      RowBox[{"perms", "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], "]"}], "]"}]}]}],
     "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"Length", "[", "threeTerm", "]"}]}], "Input",
 CellLabel->
  "In[188]:=",ExpressionUUID->"5a907c19-30ae-47d9-a683-d1cbf30f3e86"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.988820414176426*^9},
 CellLabel->
  "Out[190]=",ExpressionUUID->"63746ccf-1143-4379-858f-421795478b0d"]
}, Open  ]],

Cell[TextData[{
 "Two three-term annihilators. One of them is precisely the cyclic \
permutations of slots ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "3", ",", "4", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"5bdcd139-9dd3-464c-88b3-c23cde5b2556"],
 " acting on ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0a40ac21-0a41-486a-9d3c-ed3234a337d7"],
 ": identity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "(", "2", " ", "\[ThinSpace]", " ", "3", " ", "\[ThinSpace]", " ", "4", 
    ")"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7ab4737e-3309-48ad-b201-cd1f0e215cf2"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "(", "2", " ", "\[ThinSpace]", " ", "4", " ", "\[ThinSpace]", " ", "3", 
    ")"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8b69525a-5c9d-44d2-8fa7-461f459d74d1"],
 ". This is the ",
 StyleBox["first Bianchi identity",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"a", " ", "b", " ", "c", " ", "d"}]], "+", 
    SubscriptBox["R", 
     RowBox[{"a", " ", "c", " ", "d", " ", "b"}]], "+", 
    SubscriptBox["R", 
     RowBox[{"a", " ", "d", " ", "b", " ", "c"}]], "=", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "df3f035c-96b4-4f00-a519-de1fe1fa916f"],
 ", derived here from the projector definition with no textbook input."
}], "Text",ExpressionUUID->"4b268df9-710d-48e7-aeff-5d30cc8d41b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Position", "[", 
  RowBox[{"threeTerm", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3", ",", " ", "4", ",", " ", "2"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "4", ",", " ", "2", ",", " ", "3"}], "}"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[191]:=",ExpressionUUID->"05b3651a-78ca-43cc-8800-35058546be20"],

