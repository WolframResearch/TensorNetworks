 CellChangeTimes->{3.988820412411963*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"de895f26-d6af-405b-aeaf-e0f387bc14e1"]
}, Open  ]],

Cell[TextData[{
 "Project ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "x"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0a7fc294-ab98-4081-9151-e68f4cf6979a"],
 " onto the antisymmetric shape; the result vanishes."
}], "Text",ExpressionUUID->"4fd13c9f-94a9-40c0-9fca-1bd9bdf6a04e"],

