      RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"M2", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[108]:=",ExpressionUUID->"0346fe94-24fc-4ebf-bafc-782697e3dbcc"],

Cell["Compute the dense Frobenius trace as a baseline.", "Text",ExpressionUUID->"900380f3-c481-48db-9997-52a57502cc49"],

