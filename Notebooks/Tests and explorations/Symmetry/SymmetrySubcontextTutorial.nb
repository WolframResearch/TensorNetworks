 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    RowBox[{"\[Mu]", " ", "\[Nu]"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b6658606-f4cf-406b-a3eb-79e2ab6b6229"],
 " (from a 4-potential)"
}], "Subsection",ExpressionUUID->"4d5d4688-3250-4763-b25b-7269ee7b0941"],

Cell[TextData[{
 StyleBox["The electromagnetic field tensor is built as ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", 
     RowBox[{"\[Mu]", " ", "\[Nu]"}]], "=", 
    SubscriptBox["\[PartialD]", "\[Mu]"], " ", 
    SubscriptBox["A", "\[Nu]"], "-", 
    SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
    SubscriptBox["A", "\[Mu]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5e282d24-f9b7-432b-b828-2996070fa83b"],
 StyleBox[", antisymmetric by construction (three ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["E", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "75c35516-4caa-44e5-9e92-87b2bcce3964"],
 StyleBox["-components, three ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["B", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "234139f2-a023-4865-bdb6-613eea4551f4"],
 StyleBox["-components). ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ba4a6017-2b89-44e6-9eec-65a897d5734e"],
 StyleBox[" confirms it lives entirely in the ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8597c4de-c44c-4b9e-8d3c-0d71d539b13d"],
 StyleBox[" class, the structural reason the EM field has six independent \
components in 4D rather than sixteen.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"3879e674-56d4-449b-be91-eccf39782c6f"],

Cell[TextData[{
 "The EM field tensor is the antisymmetrised Jacobian of a 4-potential, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["F", 
     RowBox[{"\[Mu]", " ", "\[Nu]"}]], "=", 
    SubscriptBox["\[PartialD]", "\[Mu]"], " ", 
    SubscriptBox["A", "\[Nu]"], "-", 
    SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
    SubscriptBox["A", "\[Mu]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6c20c2eb-a525-4258-9625-50b91b5b672b"],
 "."
}], "Text",ExpressionUUID->"66a3cf64-ac64-4135-9065-9dd5571e6ccd"],

