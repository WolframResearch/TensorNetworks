Cell[BoxData[
 RowBox[{"YoungProject", "[", 
  RowBox[{"sx", ",", " ", "symTab"}], "]"}]], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"1fed112f-3d40-4a5e-80ae-5441649890a1"],

