      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "}"}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[142]:=",ExpressionUUID->"6bf6a63b-d74d-4683-8a7f-76ef56d9888d"],

Cell["Project onto the mixed-symmetry block.", "Text",ExpressionUUID->"a1a09ef6-934b-4a37-920a-688f4d7e6e87"],

