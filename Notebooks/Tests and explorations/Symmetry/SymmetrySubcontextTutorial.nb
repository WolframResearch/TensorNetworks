Cell["\<\
The central blob is the tensor; the seven labelled legs are its slots. Shared \
legs become bonds between two such nodes, and a tensor network is a \
collection of these stars glued at common legs.\
\>", "Text",ExpressionUUID->"39d6b307-2519-457f-a2d3-81d299e3c0e0"],

Cell["\<\
Two group actions live on this picture, and both recur throughout the \
tutorial:\
\>", "Text",ExpressionUUID->"05c6f6da-f7d4-4283-9a97-eefa53650e3d"],

Cell[TextData[{
 "- ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0c4376a1-f441-4979-9c23-3112234ec52e"],
 ", the ",
 StyleBox["symmetric group",
  FontSlant->"Italic"],
 " on ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f5fd8761-957d-4d57-a55b-45f751162ded"],
 " letters, comprises the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", " ", "!"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9a0d6446-d87e-41dd-94b0-bb5a0a6af9b4"],
 " permutations of the slots. It acts on the diagram by ",
 StyleBox["permuting which leg is which",
  FontWeight->"Bold"],
 ". For rank ",
 Cell[BoxData[
  FormBox["7", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "75824a1b-5b23-40f2-8f27-ffcc89260aee"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[VerticalSeparator]", 
    SubscriptBox["S", "7"], "\[VerticalSeparator]", "=", "5040"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "141b3783-a434-4cc0-a530-7c3ea7dd13c0"],
 ". \n- ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "L", "(", "d", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"23b3e65e-1ff6-4512-870f-79f8fd439a36"],
 ", the ",
 StyleBox["general linear group",
  FontSlant->"Italic"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "\[Times]", "d"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"949d78ee-6681-4599-8011-f8b4d7607d93"],
 " invertible matrices, acts on a single leg of dimension ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "335d9a0a-1908-4b97-b33e-d0c74a2605d4"],
 " by ",
 StyleBox["basis change",
  FontWeight->"Bold"],
 ", and on the full tensor by changing basis at every leg simultaneously. It \
is a continuous group of dimension ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["d", "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"859c5c8e-d7ee-4a19-b611-5fb208e1a564"],
 "."
}], "Text",
 CellChangeTimes->{
  3.988820435092215*^9},ExpressionUUID->"6bbb778f-67ef-4810-a7e5-\
23d7cd69fe53"],

Cell[TextData[{
 "The two actions commute, and Schur-Weyl duality turns that commuting pair \
into a direct-sum decomposition of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{"\[TensorProduct]", " ", "n"}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f9de717b-7a31-4921-a298-fcceb20ad3f1"],
 " into blocks indexed by Young diagrams of size ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dc6a6741-75cb-4a53-b545-920739154fc6"],
 ". The Symmetry functions handle the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2ea025bc-f552-4ad3-be77-e6dac6cd22d4"],
 " side (",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "83222327-f2b6-41fd-afe5-db6ba80ad3e1"],
 " lands a tensor in a chosen block); ",
 Cell[BoxData[
  TemplateBox[{
   "SchurDimension", "paclet:Wolfram/TensorNetworks/ref/SchurDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5177f1e7-7c3c-4e06-96f3-a7f14690795e"],
 " reports the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "L", "(", "d", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"01138b9b-6bda-4fa7-812d-9220d1273c64"],
 " side (the block size at bond dimension ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "17625c30-ecec-499e-9a4f-a6da93fae3b4"],
 ")."
}], "Text",ExpressionUUID->"97821818-eeab-4148-9e7e-8e5dc2563cad"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Two indistinguishable particles on a bond", "Chapter",ExpressionUUID->"06c05460-b008-476b-a847-ac2f5ce4bb87"],

Cell[TextData[{
 "The simplest non-trivial tensor in a tensor network is a rank-2 node ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    RowBox[{"i", "\[NoBreak]", "j"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"aa96bcf5-af2c-4b8d-88e7-7a31bb603ac0"],
 " on a bond between two physical sites, with each index ranging over a ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "06532c9c-a142-4180-941f-aeb621d3bc14"],
 "-dimensional local Hilbert space ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fbd840c7-0b73-4ede-ab9d-fda300a12088"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "\[Element]", "V", " ", "\[TensorProduct]", " ", "V"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "670cf68e-ae0d-4b6b-9820-293e8fa2eb16"],
 ". This rank-2 bond is the elementary building block of every MPS, MERA, and \
PEPS, and the symmetry rule worked out here generalises slot-by-slot to every \
higher-rank tensor in the rest of the tutorial."
}], "Text",ExpressionUUID->"3b70cd2f-ca98-4707-ab33-3be61c5279a2"],

Cell[CellGroupData[{

Cell["Identical particles and the exchange operator", "Section",ExpressionUUID->"c6e90fee-7756-4dfc-a5aa-103094029a14"],

Cell[TextData[{
 "Identical quantum particles carry no intrinsic labels: photons in a cavity, \
electrons in an atom, helium-4 atoms in a superfluid, the indices we attach \
are bookkeeping, not physics. Quantum mechanics enforces this with a sharp \
rule on the two-particle wavefunction ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "(", 
    SubscriptBox["x", "1"], ",", 
    SubscriptBox["x", "2"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ff4f7dc0-16c9-43e2-868c-d8d359c27153"],
 ":"
}], "Text",ExpressionUUID->"ec91298c-4746-48cf-99c0-08d040f01727"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"\[CapitalPsi]", "(", 
   SubscriptBox["x", "2"], ",", 
   SubscriptBox["x", "1"], ")", "\[MediumSpace]", "=", "\[MediumSpace]", " ", 
   "\[PlusMinus]", " ", "\[ThinSpace]", " ", "\[CapitalPsi]", "(", 
   SubscriptBox["x", "1"], ",", 
   SubscriptBox["x", "2"], ")", "."}], 
  TraditionalForm]],ExpressionUUID->"81a3ddf0-ed43-4ad4-ba40-219b923d3d29"]], \
"Text",ExpressionUUID->"66b19b44-eade-4999-9eeb-60a3dfe33815"],

Cell[TextData[{
 "The plus sign is the ",
 StyleBox["bosonic",
  FontSlant->"Italic"],
 " case (integer spin: photons, mesons, He-4, Cooper pairs). The minus sign \
is the ",
 StyleBox["fermionic",
  FontSlant->"Italic"],
 " case (half-integer spin: electrons, protons, He-3); setting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "=", 
    SubscriptBox["x", "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"db09a657-34c7-4a58-b393-79e70dd1cfa8"],
 " forces ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "=", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fbcdb654-6fc2-4d18-96b2-d883dc2519db"],
 ", the Pauli exclusion principle."
}], "Text",ExpressionUUID->"b60a939c-8ceb-4c82-964f-1d36e3eb640b"],

Cell[TextData[{
 "Write the wavefunction in tensor form, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"\[CapitalPsi]"},
     "Ket"], "=", 
    RowBox[{
     RowBox[{
      UnderscriptBox["\[Sum]", 
       RowBox[{"i", "\[NoBreak]", "j"}]], " ", 
      RowBox[{
       SubscriptBox["T", 
        RowBox[{"i", "\[NoBreak]", "j"}]], " ", "\[ThinSpace]", " ", 
       RowBox[{
        TemplateBox[{"i"},
         "Ket"], " ", "\[TensorProduct]", " ", 
        TemplateBox[{"j"},
         "Ket"]}]}]}], "\[Element]", 
     RowBox[{"V", " ", "\[TensorProduct]", " ", "V"}]}]}], TraditionalForm]],
  ExpressionUUID->"cd4a23f8-e460-4d6e-87d8-3965796f7252"],
 ". The ",
 StyleBox["exchange operator",
  FontSlant->"Italic"],
 " (the SWAP gate in quantum computing) ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "12"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2f79dd93-9909-4dec-8958-f5c82730f788"],
 " acts by relabelling the two factors,"
}], "Text",ExpressionUUID->"25523686-19dc-44aa-adc9-8ecddb646446"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["P", "12"], " ", "\[ThinSpace]", "(", 
     RowBox[{
      TemplateBox[{"i"},
       "Ket"], " ", "\[TensorProduct]", " ", 
      TemplateBox[{"j"},
       "Ket"]}], ")"}], "\[MediumSpace]", "=", "\[MediumSpace]", " ", 
    RowBox[{
     TemplateBox[{"j"},
      "Ket"], " ", "\[TensorProduct]", " ", 
     TemplateBox[{"i"},
      "Ket"]}]}], ","}], 
  TraditionalForm]],ExpressionUUID->"81b2ac09-7798-43c4-ae21-37f25653bc10"]], \
"Text",ExpressionUUID->"cdd0eb58-e1f2-471c-a343-3e99e51e1789"],

Cell[TextData[{
 "sending coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", 
     RowBox[{"i", "\[NoBreak]", "j"}]], "\[Rule]", 
    SubscriptBox["T", 
     RowBox[{"j", "\[NoBreak]", "i"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"52b1a07f-ea39-4701-b197-611214644e17"],
 ". ",
 StyleBox["This is the ordinary transpose ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "T"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b02a1415-8018-4910-a2b0-dcf3f6227c12"],
 StyleBox[", not the adjoint ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", "\[Dagger]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6ed01e41-846b-4098-a910-df1ae03983d5"],
 StyleBox[".",
  FontWeight->"Bold"],
 " SWAP relabels slots; no complex conjugation enters. So even for complex ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3ac91b6d-c678-41fe-b644-22c540d4acc7"],
 ", the bosonic and fermionic conditions are"
}], "Text",ExpressionUUID->"9dd495c7-638e-4ed2-931f-af84cf462e10"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   StyleBox["boson", "MR"], " ", ":", " ", "\[MediumSpace]", " ", "T", " ", 
   "\[ThinSpace]", "=", "\[ThinSpace]", " ", 
   SuperscriptBox["T", "T"], ",", 
   "\[ThickSpace]\[ThickSpace]\[ThickSpace]\[ThickSpace]", " ", 
   StyleBox["fermion", "MR"], " ", ":", " ", "\[MediumSpace]", " ", "T", " ", 
   "\[ThinSpace]", "=", "\[ThinSpace]", "-", "\[ThinSpace]", " ", 
   SuperscriptBox["T", "T"], " ", "."}], 
  TraditionalForm]],ExpressionUUID->"5f29708d-10c6-45e0-9b56-22ce437da5ac"]], \
"Text",ExpressionUUID->"5b6b405d-eb2a-4067-a4cf-fdd08461dc96"],

Cell[TextData[{
 "Hermiticity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "=", 
    SuperscriptBox["T", "\[Dagger]"], "=", "(", 
    SuperscriptBox["T", "*"], " ", 
    SuperscriptBox[")", "T"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"303433e4-ef5f-4f17-ad30-61c10511ff8a"],
 ", is a separate constraint outside the symmetric-group story; built-in WL \
captures it via ",
 StyleBox["Hermitian[{1,2}]", "Code"],
 ". On real entries the kernel collapses ",
 StyleBox["Matrices[{n,n}, Reals, Hermitian[{1,2}]]", "Code"],
 " to ",
 StyleBox["Matrices[{n,n}, Reals, Symmetric[{1,2}]]", "Code"],
 " because the conjugation has no imaginary part to act on."
}], "Text",ExpressionUUID->"81326957-3291-4885-b74c-deb339c144ce"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The symmetric / antisymmetric decomposition", "Section",ExpressionUUID->"bc901bca-05f6-47c4-88ac-66a3eb01d404"],

Cell[TextData[{
 "A generic complex matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "\[Element]", "V", " ", "\[TensorProduct]", " ", "V"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fff7d3f6-7872-479f-98ba-cfbb4193a9c1"],
 " is neither symmetric nor antisymmetric, but it splits cleanly:"
}], "Text",ExpressionUUID->"e546b05c-e4ad-4b01-8b99-42f7fc25bfe2"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"T", " ", "\[MediumSpace]", "=", "\[MediumSpace]", " ", 
   FractionBox["1", "2"], "(", "T", "+", 
   SuperscriptBox["T", "T"], ")", "\[MediumSpace]", "+", "\[MediumSpace]", 
   " ", 
   FractionBox["1", "2"], "(", "T", "-", 
   SuperscriptBox["T", "T"], ")", ","}], 
  TraditionalForm]],ExpressionUUID->"71833794-9ad3-43c5-98e4-518f61f05d81"]], \
"Text",ExpressionUUID->"fd94f530-92e0-47e5-be4f-9cc8e3b64401"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", 
     StyleBox["sym", "MR"]], "\[Element]", 
    SuperscriptBox[
     StyleBox["Sym", "MR"], "2"], " ", "V"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"3f55cbdb-eb79-4dc7-91e0-c6c7d5e9a97b"],
 " (dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "(", "d", "+", "1", ")", "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e4f0496a-317f-4e91-a162-2ea254ca7a22"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", 
     StyleBox["anti", "MR"]], "\[Element]", 
    SuperscriptBox["\[CapitalLambda]", "2"], " ", "V"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0c58537c-56f4-4ea1-93cc-05663c66d2af"],
 " (dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "(", "d", "-", "1", ")", "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"1311802c-80f1-4573-bde7-77177b3345a1"],
 "). These are the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ddd7ca46-3d4a-408a-8ce3-de8d65116b95"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "951f54c7-c1ff-43ae-8f1d-7a248cba9d5c"],
 " eigenspaces of SWAP, and their dimensions sum to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["d", "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"624026ab-14a7-4d62-8c93-773d614d4595"],
 ". The Symmetry functions name the two pieces by their symmetry class (the \
partition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4712e70b-69a3-4f31-9fd8-3e8582daf191"],
 " for boson, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c19e2ee5-f271-4baa-bb7d-0697f99a53ca"],
 " for fermion) and produce each with a single call. The naming object is the \
",
 Cell[BoxData[
  TemplateBox[{
   "YoungTableau", "paclet:Wolfram/TensorNetworks/ref/YoungTableau"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f58babd2-f1db-4554-a0d5-3fbb9afd057e"],
 "."
}], "Text",ExpressionUUID->"4bbcf621-eadf-42aa-829f-e82a6030f29f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
   "YoungTableau", "paclet:Wolfram/TensorNetworks/ref/YoungTableau"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5a7e49ce-6f5b-463f-9641-942787f63426"],
 ": the named handle for a symmetry class"
}], "Section",ExpressionUUID->"492c58a4-1792-484a-b777-bf12b9aa3d83"],

Cell[TextData[{
 "A ",
 StyleBox["Young tableau",
  FontSlant->"Italic"],
 " is a left-justified arrangement of boxes (the \"shape\") together with a \
labelling of those boxes by the slot indices ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "2", ",", "\[Ellipsis]", ",", "n", " ", "}"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "89672c73-df4d-4904-ae0b-bfaf75560b03"],
 " of the tensor we plan to act on. ",
 StyleBox["The labelling must be a permutation of ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", "n"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b4b832da-2fea-4baf-99f1-84a6447ca8aa"],
 " (a ",
 StyleBox["standard tableau",
  FontSlant->"Italic"],
 "). For two indices there are exactly two shapes:"
}], "Text",ExpressionUUID->"c0cbf4fb-589b-4a64-86e2-d7cbd67eaec5"],

Cell[TextData[{
 "- one row of two boxes, written ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e9bee26c-4438-461a-a3ad-f1391315d543"],
 ", labels the ",
 StyleBox["symmetric",
  FontSlant->"Italic"],
 " class; - one column of two boxes, written ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f02c911f-6b35-4083-9474-cdfcc92f4195"],
 ", labels the ",
 StyleBox["antisymmetric",
  FontSlant->"Italic"],
 " class."
}], "Text",ExpressionUUID->"f06db275-2234-40e7-a935-a24f254e4dc9"],

