Cell[TextData[{
 StyleBox["HookFactor[par]", "Code"],
 " is the reciprocal of the hook-length product, evaluated by the Frobenius \
determinant formula in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["r", "2"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"44d5f33f-0802-4183-b403-ec9b476531eb"],
 " where ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d3312b03-b662-4a53-9c8a-8983595e33f9"],
 " is the number of rows."
}], "Text",ExpressionUUID->"d970c525-5dc1-4749-af47-20222a9e4014"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookFactor", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "1"}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[126]:=",ExpressionUUID->"f8d03795-7f41-4780-bd39-0304e2b76578"],

Cell[BoxData[
 FractionBox["1", "3"]], "Output",
 CellChangeTimes->{3.988820413376892*^9},
 CellLabel->
  "Out[126]=",ExpressionUUID->"d916871b-ee9e-486d-a981-156215d322ea"]
}, Open  ]],

Cell[TextData[{
 "The irreducible representation dimension is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", " ", "!"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4e9225cc-75d1-4899-b3f9-15e30fefbbf5"],
 " times the hook factor, which is exactly what ",
 Cell[BoxData[
  TemplateBox[{
   "TableauDimension", "paclet:Wolfram/TensorNetworks/ref/TableauDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7fd77f09-8ebf-4789-aedb-84953ba39d93"],
 " packages."
}], "Text",ExpressionUUID->"e936dc76-d324-4a23-91da-8b37bb69a592"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"TableauDimension", "[", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], " ", "==", " ", 
  RowBox[{
   RowBox[{"3", "!"}], " ", "*", " ", 
   RowBox[{"HookFactor", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "1"}], "}"}], "]"}]}]}]], "Input",
 CellLabel->
  "In[127]:=",ExpressionUUID->"2be5f518-b80b-4ee8-8f00-c6cf95d856ef"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988820413383937*^9},
 CellLabel->
  "Out[127]=",ExpressionUUID->"5d1642e7-caf1-4dd8-8400-c7bb5be4839a"]
}, Open  ]],

Cell[TextData[{
 "Read off all three ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "12f90460-8d1d-49b5-a10a-6979d16a1303"],
 " irreducible representation dimensions in one shot."
}], "Text",ExpressionUUID->"c9fdaccb-6b4b-4aba-83d0-80137c93b37d"],

