Cell[BoxData[
 RowBox[{"-", "1.0574609962413515`"}]], "Output",
 CellChangeTimes->{3.988820413541873*^9},
 CellLabel->
  "Out[148]=",ExpressionUUID->"34309449-16c2-4e41-b267-10132a66bcd7"]
}, Open  ]],

