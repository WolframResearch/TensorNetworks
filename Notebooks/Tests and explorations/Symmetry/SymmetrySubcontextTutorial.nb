Cell[TextData[{
 "All four hold. The first three are mono-term and reachable by built-in ",
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "598e1776-54e2-4269-937a-391341e8b854"],
 " (and built-in ",
 Cell[BoxData[
  TemplateBox[{"TensorSymmetry", "paclet:ref/TensorSymmetry"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a998e12e-4dad-4a6d-9643-d575ba98f4a2"],
 " would report them); the last is the Bianchi identity, multi-term, ",
 StyleBox["not",
  FontSlant->"Italic"],
 " reachable by ",
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4aac16ad-5d60-48c6-8770-e65176b9b0c1"],
 ", and the very thing the discovery loop above just produced from scratch."
}], "Text",ExpressionUUID->"31033a32-2544-463a-84ec-7cbd7a0651b0"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Composition with built-in ",
 Cell[BoxData[
  TemplateBox[{"TensorSymmetry", "paclet:ref/TensorSymmetry"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "088b232b-957f-47c2-9076-5be1da7971f0"]
}], "Subsection",ExpressionUUID->"7c398e83-3bda-4b25-84ab-11a68fa72ff4"],

Cell[TextData[{
 StyleBox["A ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "92cc496f-6908-4ff4-a3d2-8ff98da2b6d1"],
 StyleBox["-output tensor is recognised by built-in ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{"TensorSymmetry", "paclet:ref/TensorSymmetry"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3928df7d-fb00-4d70-97fb-dff47aceaac1"],
 StyleBox[", which reports the three mono-term Riemann pair generators (but \
not Bianchi, which is multi-term). The two layers compose cleanly: multi-term \
projection upstream, mono-term detection downstream.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"977feaef-8e3a-4adf-b08e-74519726cc91"],

Cell[TextData[{
 "After projection, the mono-term content of ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b78fe083-46ed-426e-98b5-77e1e25454d2"],
 " is detected by ",
 Cell[BoxData[
  TemplateBox[{"TensorSymmetry", "paclet:ref/TensorSymmetry"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cfd01caa-c30c-4022-b968-1e6abe250a85"],
 ":"
}], "Text",ExpressionUUID->"a257af4f-c087-44cd-bf3c-43737d3b7e30"],

