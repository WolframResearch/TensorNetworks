Cell["All three pass. Now check the first Bianchi identity.", "Text",ExpressionUUID->"503d8d44-c455-4f6d-a350-85c60ad70b3c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{"Flatten", "[", "\n", "    ", 
    RowBox[{"Rmono", " ", "+", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Rmono", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3", ",", " ", "4", ",", " ", "2"}], "}"}]}], 
      "]"}], " ", "+", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Rmono", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4", ",", " ", "2", ",", " ", "3"}], "}"}]}], 
      "]"}]}], "\n", "]"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[178]:=",ExpressionUUID->"fa0c4150-703c-435e-a81b-b3def201640b"],

