   RowBox[{"{", 
    RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"Through", "[", 
    RowBox[{
     RowBox[{"Array", "[", 
      RowBox[{"a", ",", " ", "4"}], "]"}], "[", 
     RowBox[{"Sequence", " ", "@@", " ", "coords"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"J", " ", "=", " ", 
   RowBox[{"Grad", "[", 
    RowBox[{"A", ",", " ", "coords"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"F", " ", "=", " ", 
   RowBox[{
    RowBox[{"Transpose", "[", "J", "]"}], " ", "-", " ", "J"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[52]:=",ExpressionUUID->"1e0daeb1-437c-4eac-8c6f-96b0dc39fdf0"],

