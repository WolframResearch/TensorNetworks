Cell[TextData[{
 "Check pair-swap symmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "(", "1", ",", "2", ")", "\[LeftRightArrow]", "(", "3", ",", "4", ")"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1f6a4060-8b30-47e1-9f3e-5d0f7930d0af"],
 "."
}], "Text",ExpressionUUID->"af52c78e-3a24-4a5e-8aa8-b312abd9d1c6"],

