Cell[TextData[{
 "The other two cells of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"722f7736-f5dd-4925-a3cc-5aa55a998652"],
 " are corners; each has hook length ",
