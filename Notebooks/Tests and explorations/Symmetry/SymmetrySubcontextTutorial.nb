Cell["\<\
The three pieces sum to the original tensor (completeness of the isotypic \
decomposition).\
\>", "Text",ExpressionUUID->"ed02f422-94be-4358-9a5a-a47b78503fbe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{
     "e3", " ", "+", " ", "e21", " ", "+", " ", "e111", " ", "-", " ", "T3"}],
      "]"}], "]"}], "]"}], " ", "<", " ", "tol"}]], "Input",
 CellLabel->
  "In[138]:=",ExpressionUUID->"c6432634-5a53-4486-9a80-1a36396d53d5"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.98882041348151*^9},
 CellLabel->
  "Out[138]=",ExpressionUUID->"a9730d5a-6305-4289-b64d-6defcdcfc151"]
}, Open  ]],

Cell["\<\
And the predicted vanishing of the fermionic piece holds identically:\
\>", "Text",ExpressionUUID->"07aa3fec-ff29-4f3f-a62e-adbf8a627f53"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", "e111", "]"}], "]"}], "]"}], " ", "<", " ", 
  "tol"}]], "Input",
 CellLabel->
  "In[139]:=",ExpressionUUID->"76ba7e90-f0e8-48a2-b051-578b0d9de936"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988820413493169*^9},
 CellLabel->
  "Out[139]=",ExpressionUUID->"cdba1447-56ca-4f34-a104-8c497b7064a8"]
}, Open  ]],

Cell["\<\
The decomposition is exact, computed without any eigenvalue routine. Each \
Symmetry function plays a distinct role:\
\>", "Text",ExpressionUUID->"8a4735e6-a9ce-4028-91dd-3056278764c7"],

Cell[TextData[{
 "- ",
 Cell[BoxData[
  TemplateBox[{
   "YoungTableau", "paclet:Wolfram/TensorNetworks/ref/YoungTableau"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "89496882-9af4-438e-bc7d-c89f7f5bb016"],
 " names each block by its shape. - ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d4ef72d7-f5a9-408c-9911-ddd5c2e9c23f"],
 " projects the input tensor onto that block. - ",
 Cell[BoxData[
  TemplateBox[{
   "TableauDimension", "paclet:Wolfram/TensorNetworks/ref/TableauDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "82b17125-4cc3-47fd-bcb1-61ae57f0191e"],
 " counts standard tableaux per shape: the number of ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "94010e63-099c-443b-a0fc-53f253878558"],
 " calls to sum into the isotypic ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b3606f52-26b4-4b9a-81d8-e493bf0f5470"],
 ". - ",
 Cell[BoxData[
  TemplateBox[{"HookLengths", "paclet:Wolfram/TensorNetworks/ref/HookLengths"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "07c95f12-eb6d-4cab-8005-2378ca8217cd"],
 " feeds ",
 Cell[BoxData[
  TemplateBox[{
   "SchurDimension", "paclet:Wolfram/TensorNetworks/ref/SchurDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "327dbc58-0293-4a1a-a426-28961a72ba00"],
 " for the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "L", "(", "d", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c6b77046-70cb-4ff9-bedc-7ff45f56fae6"],
 " factor."
}], "Text",ExpressionUUID->"d5410cac-ff51-4541-ae89-8b6636ec3b81"],

Cell[TextData[{
 "The projector is insensitive to complex entries: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "12"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e04e5df5-fc6e-44e4-9619-303f550a13bd"],
 " relabels slots, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "\[Rule]", 
    SuperscriptBox["T", "T"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"babaea47-607f-411f-b108-fcf6a4de8d25"],
 " is transpose with no conjugation. Repeat on a random complex rank-3 tensor."
}], "Text",ExpressionUUID->"5a9b366a-d9d4-4f47-bca7-7755f710762f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "11", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T3c", " ", "=", " ", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], " ", "-", " ", "I"}], ",", " ", 
       RowBox[{"1", " ", "+", " ", "I"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[140]:=",ExpressionUUID->"006d02b6-8292-4108-8bb3-2077ab3e8986"],

Cell["Project the complex tensor onto the fully symmetric block.", "Text",ExpressionUUID->"84263ea7-34a0-4295-9236-31e9bbaf7cc7"],

