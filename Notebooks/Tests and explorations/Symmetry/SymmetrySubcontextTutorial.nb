Cell[TextData[{
 "The same block-sparsity holds inside the paclet's TN flow. Build the \
unprojected two-node network over ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b0e7e59c-d0ca-4168-b701-2351c8879bbe"],
 " and ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ef14d75d-8649-4e8f-afda-cd17b976fb66"],
 " with all three indices shared, contract it, and recover the full Frobenius \
product."
}], "Text",ExpressionUUID->"7ae9c622-49d0-4372-bab5-97432071e8f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bareFro", " ", "=", " ", 
  RowBox[{"TensorNetworkContract", " ", "@", "\n", "    ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"T3", ",", " ", "S3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\"", ",", " ", "\"\<k\>\""}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\"", ",", " ", "\"\<k\>\""}], 
        "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", "}"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[155]:=",ExpressionUUID->"3ff23ffb-4200-47f3-9071-139790b916ab"],

Cell[BoxData[
 RowBox[{"-", "1.0574609962413515`"}]], "Output",
 CellChangeTimes->{3.988820413602247*^9},
 CellLabel->
  "Out[155]=",ExpressionUUID->"9a663313-f038-44d0-b730-9fc2452dc6a0"]
}, Open  ]],

Cell[TextData[{
 "Apply ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f39f8bde-f520-44ff-8e17-ca6d5850730f"],
 " to both nodes inside the network, restricting them to a chosen irrep \
sector before the contraction runs. The helper below sums over the standard \
tableaux of a given shape, projects both inputs into that sector, and \
contracts the resulting two-node TN."
}], "Text",ExpressionUUID->"2b86dfcc-92c0-4dbc-9fc8-86ad62be517f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sectorContract", "[", 
    RowBox[{"U_", ",", " ", "V_", ",", " ", "syt_List"}], "]"}], " ", ":=", 
   "\n", "    ", 
   RowBox[{"TensorNetworkContract", " ", "@", " ", 
    RowBox[{"TensorNetwork", "[", "\n", "        ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"YoungProject", "[", 
            RowBox[{"U", ",", " ", 
             RowBox[{"YoungTableau", "[", "#", "]"}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "syt"}], "]"}], ",", "\n", "         ", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"YoungProject", "[", 
            RowBox[{"V", ",", " ", 
             RowBox[{"YoungTableau", "[", "#", "]"}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "syt"}], "]"}]}], "}"}], ",", "\n", "        ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\"", ",", " ", "\"\<k\>\""}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\"", ",", " ", "\"\<k\>\""}], 
         "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", "}"}]}], "\n", "    ", "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[156]:=",ExpressionUUID->"db9febd3-412f-4f51-a0d6-9473486e9b32"],

Cell["\<\
List the three standard-tableau sets and evaluate the three within-sector \
contractions through the paclet's contraction engine.\
\>", "Text",ExpressionUUID->"c54c9dfc-65a2-4737-9634-a3461c08e143"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"syt3", ",", " ", "syt21", ",", " ", "syt111"}], "}"}], " ", "=", 
   " ", 
   RowBox[{"{", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "}"}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", "3", "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "}"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "1", "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}], ",", " ", 
        RowBox[{"{", "3", "}"}]}], "}"}], "}"}]}], "\n", "}"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"sectorContract", "[", 
    RowBox[{"T3", ",", " ", "S3", ",", " ", "syt3"}], "]"}], ",", "\n", " ", 
   RowBox[{"sectorContract", "[", 
    RowBox[{"T3", ",", " ", "S3", ",", " ", "syt21"}], "]"}], ",", "\n", " ", 
   
   RowBox[{"sectorContract", "[", 
    RowBox[{"T3", ",", " ", "S3", ",", " ", "syt111"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->
  "In[157]:=",ExpressionUUID->"0f94cf12-4de7-4cca-b804-1f6732a09af1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "0.905209307273169`"}], ",", 
   RowBox[{"-", "0.15225168896818228`"}], ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.988820413619914*^9},
 CellLabel->
  "Out[158]=",ExpressionUUID->"b887a481-c0f4-4b81-a73c-76682f08ef2a"]
}, Open  ]],

Cell["\<\
The three within-sector contractions sum to the bare Frobenius product.\
\>", "Text",ExpressionUUID->"9fca2bd9-f10d-43f6-a3c3-9039d8473b26"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Chop", "[", 
   RowBox[{"bareFro", " ", "-", " ", 
    RowBox[{"Total", " ", "@", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"sectorContract", "[", 
        RowBox[{"T3", ",", " ", "S3", ",", " ", "syt3"}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"sectorContract", "[", 
        RowBox[{"T3", ",", " ", "S3", ",", " ", "syt21"}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"sectorContract", "[", 
        RowBox[{"T3", ",", " ", "S3", ",", " ", "syt111"}], "]"}]}], "\n", 
      "}"}]}]}], "]"}], " ", "<", " ", "tol"}]], "Input",
 CellLabel->
  "In[159]:=",ExpressionUUID->"88e13894-dd92-40a6-b5b4-7b94ce27813d"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988820413632597*^9},
 CellLabel->
  "Out[159]=",ExpressionUUID->"844709ab-74ae-440a-9df7-9085288a6c8c"]
}, Open  ]],

Cell[TextData[{
 "Mismatched-sector projections give zero by Schur orthogonality: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "3"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b925176c-4b40-4747-a7fd-db185f27322f"],
 " projected onto one shape against ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fa727dee-a0e8-4ec9-8ff1-9b6ff1580c0a"],
 " projected onto a ",
 StyleBox["different",
  FontSlant->"Italic"],
 " shape vanishes for every cross-shape pair."
}], "Text",ExpressionUUID->"97da8e0e-1e76-4625-af89-963118094948"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"crossContract", "[", 
    RowBox[{
    "U_", ",", " ", "V_", ",", " ", "sytU_List", ",", " ", "sytV_List"}], 
    "]"}], " ", ":=", "\n", "    ", 
   RowBox[{"TensorNetworkContract", " ", "@", " ", 
    RowBox[{"TensorNetwork", "[", "\n", "        ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"YoungProject", "[", 
            RowBox[{"U", ",", " ", 
             RowBox[{"YoungTableau", "[", "#", "]"}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "sytU"}], "]"}], ",", "\n", "         ", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"YoungProject", "[", 
            RowBox[{"V", ",", " ", 
             RowBox[{"YoungTableau", "[", "#", "]"}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "sytV"}], "]"}]}], "}"}], ",", "\n", "        ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\"", ",", " ", "\"\<k\>\""}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\"", ",", " ", "\"\<k\>\""}], 
         "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", "}"}]}], "\n", "    ", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Chop", " ", "@", " ", 
  RowBox[{"{", "\n", "    ", 
   RowBox[{
    RowBox[{"crossContract", "[", 
     RowBox[{"T3", ",", " ", "S3", ",", " ", "syt3", ",", "   ", "syt21"}], 
     "]"}], ",", " ", 
    RowBox[{"crossContract", "[", 
     RowBox[{"T3", ",", " ", "S3", ",", " ", "syt3", ",", "   ", "syt111"}], 
     "]"}], ",", "\n", "    ", 
    RowBox[{"crossContract", "[", 
     RowBox[{"T3", ",", " ", "S3", ",", " ", "syt21", ",", "  ", "syt3"}], 
     "]"}], ",", "  ", 
    RowBox[{"crossContract", "[", 
     RowBox[{"T3", ",", " ", "S3", ",", " ", "syt21", ",", "  ", "syt111"}], 
     "]"}], ",", "\n", "    ", 
    RowBox[{"crossContract", "[", 
     RowBox[{"T3", ",", " ", "S3", ",", " ", "syt111", ",", " ", "syt3"}], 
     "]"}], ",", "  ", 
    RowBox[{"crossContract", "[", 
     RowBox[{"T3", ",", " ", "S3", ",", " ", "syt111", ",", " ", "syt21"}], 
     "]"}]}], "\n", "}"}]}]}], "Input",
 CellLabel->
  "In[160]:=",ExpressionUUID->"fce84984-e626-49f5-b38d-b93c6e5d6f09"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9888204136484623`*^9},
 CellLabel->
  "Out[161]=",ExpressionUUID->"9e1a8e99-5cd8-4e26-b46a-a1b7fb00ddd8"]
}, Open  ]],

Cell["\<\
The sum of the three within-block contractions reproduces the full Frobenius \
product.\
\>", "Text",ExpressionUUID->"3347c274-42ca-4754-85be-bf5d5bc0d464"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"froFull", " ", "-", " ", 
   RowBox[{"(", 
    RowBox[{"b3", " ", "+", " ", "b21", " ", "+", " ", "b111"}], ")"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[162]:=",ExpressionUUID->"431c8799-a16a-40be-a44f-2eacc4d773e7"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.988820413654251*^9},
 CellLabel->
  "Out[162]=",ExpressionUUID->"8dff3bff-675e-46e6-8e01-94dd35b87a8e"]
}, Open  ]],

Cell[TextData[{
 "Now demonstrate that every cross-block term vanishes identically: the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "3", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e736d983-ca21-4a3b-b1fb-2211af313c88"],
 " block of ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "29320faf-43e8-4d49-b735-26b4df8cf351"],
 " does not see the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f9ea8cd5-6db3-45b7-ad29-6f2c51807d9b"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e0619d68-1022-4ea3-bdf1-f7951dfd3312"],
 " block of ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f0326422-cd69-4a5e-a27d-559868eeb11a"],
 ", and so on."
}], "Text",ExpressionUUID->"5cbbd1f5-8ea0-455e-a458-d5967bf2c57e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"e3", " ", "*", " ", "f21"}], "]"}], "]"}], ",", "   ", 
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"e3", " ", "*", " ", "f111"}], "]"}], "]"}], ",", "\n", 
    "      ", 
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"e21", " ", "*", " ", "f3"}], "]"}], "]"}], ",", "   ", 
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"e21", " ", "*", " ", "f111"}], "]"}], "]"}], ",", "\n", 
    "      ", 
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"e111", " ", "*", " ", "f3"}], "]"}], "]"}], ",", "  ", 
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"e111", " ", "*", " ", "f21"}], "]"}], "]"}]}], "}"}], 
  "]"}]], "Input",
 CellLabel->
  "In[163]:=",ExpressionUUID->"bfbce013-267c-490c-a755-96a1e276a78b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.988820413667791*^9},
 CellLabel->
  "Out[163]=",ExpressionUUID->"92cdf18b-8697-443a-9903-156661522152"]
}, Open  ]],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d7154cd3-b834-495e-b468-5f40146d1045"],
 " the fully antisymmetric block ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f1e53ec9-cf27-429b-b059-3ff6509362ab"],
 " is identically zero: three mutually orthogonal antisymmetric labels cannot \
fit in a two-dimensional space (Pauli exclusion for three fermions on a \
two-level bond)."
}], "Text",ExpressionUUID->"3b55bf18-31e6-4795-b2c2-4897f2672d4c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", "b111", "]"}]], "Input",
 CellLabel->
  "In[164]:=",ExpressionUUID->"72565dce-2327-4bc0-94d0-833a0abb8f19"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.988820413674024*^9},
 CellLabel->
  "Out[164]=",ExpressionUUID->"a2e5f7c1-4128-4dcb-acfe-db36319b4e01"]
}, Open  ]],

Cell[TextData[{
 "That zero is exact, not numerical: the same Pauli-exclusion zero that \
killed the rank-2 antisymmetric singlet at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "09936645-cbe2-4727-8408-ed85da32a991"],
 ", lifted by one slot. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a7116423-7317-413c-bb2b-22d5c1a2bfd5"],
 " the full Frobenius product on a rank-3 bond is exhausted by only two \
within-block contractions, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "3", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6c5e85c1-13df-468b-88a5-0dad2a776cf5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a3a477f8-50ac-44e9-8e64-cd4b1f7da177"],
 " pieces."
}], "Text",ExpressionUUID->"4f100de1-f1e6-4aea-8b43-2f3893930f1b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"froFull", " ", "-", " ", 
   RowBox[{"(", 
    RowBox[{"b3", " ", "+", " ", "b21"}], ")"}]}], "]"}]], "Input",
 CellLabel->
  "In[165]:=",ExpressionUUID->"7f3a9d13-7321-4378-b5d1-2e2a32ba6da2"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.988820413686294*^9},
 CellLabel->
  "Out[165]=",ExpressionUUID->"f1d8a614-b973-4d3e-924f-bdfc0c5db837"]
}, Open  ]],

Cell[TextData[{
 "The payoff for TN code is concrete: with an ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5172fdec-64d0-42ba-9b95-337021a51f73"],
 " symmetry constraint on the bond, only irreducible representations whose \
diagrams fit in dimension ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d0af6074-4aad-4f82-9ef2-32fb82800f51"],
 " contribute. Diagrams with more than ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "80699769-66cd-4a97-9bdc-e72ec448a47e"],
 " rows give the zero subspace and drop out of the bond enumeration before \
any contraction begins. ",
 Cell[BoxData[
  TemplateBox[{
   "TableauDimension", "paclet:Wolfram/TensorNetworks/ref/TableauDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8848b7ec-812f-4558-8bca-159984d2035a"],
 ", ",
 Cell[BoxData[
  TemplateBox[{"HookFactor", "paclet:Wolfram/TensorNetworks/ref/HookFactor"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dd23d213-4d94-4a7e-bf21-c6bdecfadc93"],
 ", and the diagram itself are exactly the bookkeeping for this \
dimension-aware enumeration."
}], "Text",ExpressionUUID->"cf38f313-d6f0-44d3-91d1-61abe2a8b54a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Riemann tensor as a TN node", "Section",ExpressionUUID->"c30ed456-552d-4dc0-a4d8-0df9420fd1b5"],

Cell[TextData[{
 StyleBox["The Riemann curvature tensor obeys four algebraic symmetries: two \
pair-antisymmetries, a pair-swap symmetry, and the multi-term first Bianchi \
identity. One ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8d883f78-0b48-4240-91bb-fc288bcad787"],
 StyleBox[" onto the ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ac622946-cef3-4605-b516-e0d492fce807"],
 StyleBox[" tableau enforces all four simultaneously, including the Bianchi \
identity that built-in ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "60c95466-7284-4f81-a548-74d1cd5ee588"],
 StyleBox[" cannot reach with any single permutation generator.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"b07fd9d8-4e25-4a9a-bd7c-4ed82fc12958"],

Cell[TextData[{
 "The Riemann curvature tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    RowBox[{"a", " ", "b", " ", "c", " ", "d"}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"cc20eca3-12d8-4e25-91f7-a0dd9e2c1759"],
 " is a rank-4 tensor with four classical symmetries:"
}], "Text",ExpressionUUID->"9fe808dd-8a37-447d-8137-a8e111595a64"],

Cell[TextData[{
 "1. Antisymmetric in the first pair: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"a", " ", "b", " ", "c", " ", "d"}]], "=", "-", 
    SubscriptBox["R", 
     RowBox[{"b", " ", "a", " ", "c", " ", "d"}]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"430342ae-4f9b-4284-a01e-2ad2ba7a65b1"],
 ". 2. Antisymmetric in the second pair: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"a", " ", "b", " ", "c", " ", "d"}]], "=", "-", 
    SubscriptBox["R", 
     RowBox[{"a", " ", "b", " ", "d", " ", "c"}]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"90716b36-f975-4938-93c0-af521c388d43"],
 ". 3. Symmetric under pair swap: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"a", " ", "b", " ", "c", " ", "d"}]], "=", 
    SubscriptBox["R", 
     RowBox[{"c", " ", "d", " ", "a", " ", "b"}]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e6efbd69-4d8a-4103-9f0b-75ec9bdc872d"],
 ". 4. ",
 StyleBox["First Bianchi identity",
  FontSlant->"Italic"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"a", " ", "b", " ", "c", " ", "d"}]], "+", 
    SubscriptBox["R", 
     RowBox[{"a", " ", "c", " ", "d", " ", "b"}]], "+", 
    SubscriptBox["R", 
     RowBox[{"a", " ", "d", " ", "b", " ", "c"}]], "=", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "736df77b-ea33-4de6-bd8f-f890fafe2ef4"],
 "."
}], "Text",ExpressionUUID->"6c3f4f13-f8f7-4e38-bbb7-6d177e45b5cb"],

Cell[TextData[{
 "The first three are ",
 StyleBox["single-term",
  FontSlant->"Italic"],
 " slot symmetries (each says ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "=", "\[PlusMinus]", " ", 
    SuperscriptBox["T", "\[Sigma]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c9317166-1350-4387-a64e-e16dcdbf314f"],
 " for one permutation ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "84ca89f9-d53e-4d31-97fe-d55ffbcf412e"],
 "). Standard WL canonicalisation via ",
 StyleBox["TensorReduce[Arrays[..., sym]]", "Code"],
 " covers them. The fourth, the first Bianchi identity, is ",
 StyleBox["multi-term",
  FontSlant->"Italic"],
 ": a sum of three permutations is zero, and no single ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[Sigma]", ",", "\[Phi]", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c03d6846-c5e9-407e-9834-9a37ce4ac86a"],
 " pair tells you that. ",
 StyleBox["This is the gap the Symmetry functions fill.",
  FontWeight->"Bold"]
}], "Text",ExpressionUUID->"c4238e30-1e23-4e5c-be0c-f8a55c43cfc5"],

Cell[TextData[{
 "All four constraints together are the content of a single ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "4"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ff90021a-12c8-4dec-bfa4-8e6d7b5908c7"],
 " irreducible representation, the one labelled by the partition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c8fd7a7c-09cd-431a-a350-3a40606a7c06"],
 ". The Riemann tensor ",
 StyleBox["is",
  FontSlant->"Italic"],
 " the projection of a generic rank-4 tensor onto this irreducible \
representation, and one ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "187e0018-9e30-4cb9-817e-9d84028c1c7c"],
 " call enforces every constraint at once."
}], "Text",ExpressionUUID->"cee84e1d-8af8-4936-88cc-ee8b1f76ecfb"],

Cell[TextData[{
 "Before doing the projection, inspect the combinatorial data of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"84b83042-b1b5-493d-a402-57111fcd959a"],
 " diagram. First, confirm ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6348161e-74c3-4292-a887-0c0c35ff99b2"],
 " is a valid partition."
}], "Text",ExpressionUUID->"fc4f81ef-708c-45c5-aa57-df0c21c10135"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PartitionQ", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[166]:=",ExpressionUUID->"34c2cf7c-2c80-4469-8ae7-e4dc9eae47c6"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9888204136919603`*^9},
 CellLabel->
  "Out[166]=",ExpressionUUID->"8df63b44-c2b8-45a4-aa25-64fb4736caef"]
}, Open  ]],

Cell[TextData[{
 "Read off the hook-length nested list. The diagram has four cells arranged \
in a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a8d0667f-d94b-4b57-8fea-198cef9f8e90"],
 " square."
}], "Text",ExpressionUUID->"84acbc7b-0fa4-4ab4-829e-cdfc1cbe2b0c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookLengths", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[167]:=",ExpressionUUID->"234509ae-6ca2-4990-90ec-d7e97a5b72a9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9888204137041407`*^9},
 CellLabel->
  "Out[167]=",ExpressionUUID->"ef38d111-3365-479f-bc7b-0de487ebb556"]
}, Open  ]],

Cell[TextData[{
 "The hook-length product is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "3", "\[CenterDot]", "2", "\[CenterDot]", "2", "\[CenterDot]", "1", "=", 
    "12"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "375ba2ce-e099-450a-b902-ca530aa5a19d"],
 ", so the hook factor is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "12"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4023a675-6410-4269-be34-7f74dff5e4cb"],
 "."
}], "Text",ExpressionUUID->"b4efec90-563a-471f-bd2c-f5a1207a68a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookFactor", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[168]:=",ExpressionUUID->"c3138d63-cab6-4b66-9353-d8f7c11ee003"],

Cell[BoxData[
 FractionBox["1", "12"]], "Output",
 CellChangeTimes->{3.988820413709387*^9},
 CellLabel->
  "Out[168]=",ExpressionUUID->"fc4c73c9-3271-4a9d-9f88-a1f83aad9702"]
}, Open  ]],

Cell[TextData[{
 "The irreducible representation dimension is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", " ", "!", "/", "12", "=", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"bb6d2e4f-ce5f-4e2a-94ed-19207fa9251c"],
 ": the Riemann irreducible representation is two-dimensional."
}], "Text",ExpressionUUID->"230343c1-f8b7-4e0e-b6d3-f7e91d9ce4ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauDimension", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[169]:=",ExpressionUUID->"6021210f-0818-49bd-8bed-cad5ffc281cb"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.988820413722818*^9},
 CellLabel->
  "Out[169]=",ExpressionUUID->"8fd77abb-91cd-4564-a3b2-2e5f84a8234e"]
}, Open  ]],

Cell[TextData[{
 "The shape is self-conjugate (a square diagram is its own transpose), which \
is why the Riemann irreducible representation sits \"on the diagonal\" of the \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "4"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2807b294-6101-4eab-b310-da40cefd99bc"],
 " representation table and does not flip statistics under \
partition-conjugation."
}], "Text",ExpressionUUID->"3591d7ec-1847-4190-b19a-9c57fa25017f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransposePartition", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[170]:=",ExpressionUUID->"f636031f-71b5-41eb-b149-555a7fd6005e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "2"}], "}"}]], "Output",
 CellChangeTimes->{3.9888204137300034`*^9},
 CellLabel->
  "Out[170]=",ExpressionUUID->"497876f3-87db-4962-8965-a5185d580e3e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The mono-term-only attempt with built-in ",
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b2ebd9e4-2fab-49b1-9d6b-00b0e688b6a9"]
}], "Subsection",ExpressionUUID->"95cca634-6543-4175-8df0-bec237f2bb9b"],

Cell[TextData[{
 StyleBox["Built-in ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "423ed4f1-d47c-48ea-a67d-59c6c84b1fe1"],
 StyleBox[" with the three mono-term Riemann pair generators leaves an ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "1", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1991efbe-c97c-4583-bf8e-e94c1e9dd262"],
 StyleBox[" Bianchi residue: the boundary the Symmetry functions exist to \
cross.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"8db1848b-0b54-4dd2-93cf-fe7a9ee86936"],

Cell[TextData[{
 "Take a generic rank-4 tensor in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "4"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9ce5efcc-74d3-4c2f-8a45-444112ecc2dd"],
 "."
}], "Text",ExpressionUUID->"4bfff6dd-a655-4b94-b7c7-97a5a8d19209"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T0", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4", ",", " ", "4", ",", " ", "4"}], "}"}]}], 
