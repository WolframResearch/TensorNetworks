 CellLabel->
  "In[171]:=",ExpressionUUID->"e890fed9-f96f-4a8d-b801-95a4956e2c08"],

Cell[TextData[{
 "The three pair symmetries (the mono-term part of the Riemann conditions) \
lift directly into a built-in ",
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bdc72ff5-2d90-49a2-8246-5fa8ef3b9a6e"],
 " generator list."
}], "Text",ExpressionUUID->"8afc2e56-937e-4ac1-84c7-b1e0b9e765c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"riemannGens", " ", "=", " ", 
   RowBox[{"{", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cycles", "[", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], "]"}], ",", "         ", 
       RowBox[{"-", "1"}]}], "}"}], ",", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"antisym", " ", "in", " ", 
       RowBox[{"(", 
        RowBox[{"1", ",", "2"}], ")"}]}], " ", "*)"}], "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cycles", "[", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], "}"}], "]"}], ",", "         ", 
       RowBox[{"-", "1"}]}], "}"}], ",", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"antisym", " ", "in", " ", 
       RowBox[{"(", 
        RowBox[{"3", ",", "4"}], ")"}]}], " ", "*)"}], "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cycles", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}], ",", "  ", 
       "1"}], "}"}]}], "    ", 
    RowBox[{"(*", " ", 
     RowBox[{"pair", "-", "swap"}], " ", "*)"}], "\n", "}"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[173]:=",ExpressionUUID->"70637d61-1259-4f71-a0b9-596e730aea6d"],

Cell["\<\
Apply the built-in projector to obtain a mono-term-symmetrised rank-4 tensor.\
\
\>", "Text",ExpressionUUID->"81a0a6e0-62d6-4035-9f41-09800c26df82"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Rmono", " ", "=", " ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"Symmetrize", "[", 
     RowBox[{"T0", ",", " ", "riemannGens"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[174]:=",ExpressionUUID->"123cd46f-c16c-4374-88fa-81f79f4caf45"],

