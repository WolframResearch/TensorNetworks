Cell[TextData[{
 "The explicit form will matter once we move beyond rank 2, because it lets \
us choose ",
 StyleBox["which", "TI"],
 " slot goes in which row and column."
}], "Text",ExpressionUUID->"5d79e339-a611-4ccf-bd88-b1bf063b04b3"],

Cell["`YoungTableauQ`: validate before you commit", "Section",ExpressionUUID->"63161571-52f6-4c4a-9fa4-02884cf7c9e3"],

Cell[TextData[{
 Cell[BoxData[
 "YoungTableauQ"], "InlineFormula",ExpressionUUID->
  "adbc67f5-4583-4aac-a9d3-d283ec42cb3b"],
 " returns ",
 Cell[BoxData[
 "True"], "InlineFormula",ExpressionUUID->
  "ec45a22a-365c-4007-949a-865f30caf2d3"],
 " if the argument is a ",
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", "...", "]"}]], "InlineFormula",ExpressionUUID->
  "61f1faca-1eee-4f77-9ed9-e7bf358acc98"],
 " whose rows obey the partition shape rule (non-increasing row lengths, \
distinct positive integer entries) and ",
 Cell[BoxData[
 "False"], "InlineFormula",ExpressionUUID->
  "2ca1dfd0-a507-42d0-868d-06e4f07915d5"],
 " otherwise. We will rely on it implicitly: the other Symmetry-subcontext \
functions reject malformed tableaux with informative messages instead of \
crashing. Test it:"
}], "Text",ExpressionUUID->"d07e47f9-ad57-4bbf-b133-c4ac3a4d3c54"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"YoungTableauQ", "[", "symTab", "]"}], 
  "                                ", 
  RowBox[{"(*", " ", "True", " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"YoungTableauQ", "[", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "1", "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], "]"}], "]"}], 
  "           ", 
  RowBox[{"(*", " ", 
   RowBox[{"False", ":", " ", 
    RowBox[{
    "row", " ", "2", " ", "longer", " ", "than", " ", "row", " ", "1"}]}], 
   " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"YoungTableauQ", "[", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], "]"}], "]"}], "        ", 
  RowBox[{"(*", " ", 
   RowBox[{"False", ":", " ", 
    RowBox[{"2", " ", "appears", " ", "twice"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"YoungTableauQ", "[", "\"\<definitely not a tableau\>\"", "]"}], 
  "            ", 
  RowBox[{"(*", " ", "False", " ", "*)"}]}]}], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"aacd6826-d934-447f-a378-62ef205deafa"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"73e31069-a2a3-49c3-88fb-a1bcf3d52134"]
}, Open  ]],

Cell[TextData[{
 "The first call is ",
 Cell[BoxData[
 "True"], "InlineFormula",ExpressionUUID->
  "1e6320f7-3c89-487a-a7d5-c442b02d45d6"],
 ". The next three are ",
 Cell[BoxData[
 "False"], "InlineFormula",ExpressionUUID->
  "52d7c75d-c6ae-48fb-a6e8-0cb51e3821be"],
 ", each for a different reason: increasing row lengths, duplicated slot \
label, wrong head entirely."
}], "Text",ExpressionUUID->"50cc1b59-3191-4b8a-b1d0-49c4e2f2ac59"],

Cell["`TableauShape` and `TableauSize`: rank and partition", "Section",ExpressionUUID->"7505483e-718a-493c-aff1-7e45051d6740"],

Cell[TextData[{
 "Two cheap accessors. ",
 Cell[BoxData[
 "TableauShape"], "InlineFormula",ExpressionUUID->
  "f831e877-8e5a-4ad5-9178-3e08fcf8b046"],
 " returns the partition (a list of row lengths), and ",
 Cell[BoxData[
 "TableauSize"], "InlineFormula",ExpressionUUID->
  "9aa45ffa-9dc0-4c07-b743-b4f193818af5"],
 " returns the total number of boxes ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e4617b0e-213d-4f7b-bf58-567966859394"],
 ". The size is the ",
 StyleBox["rank", "TI"],
 " of the tensor the tableau acts on. Confirm both for the symmetric two-box \
tableau:"
}], "Text",ExpressionUUID->"1362255b-b01e-4467-93fd-9bcf4c9680af"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TableauShape", "[", "symTab", "]"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{"{", "2", "}"}], "   ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"TableauSize", "[", "symTab", "]"}], "     ", 
  RowBox[{"(*", " ", "2", "     ", "*)"}]}]}], "Input",
 CellLabel->"In[6]:= ",ExpressionUUID->"290c3594-f68d-44bd-8f24-1308ebc545da"],

Cell[BoxData["2"], "Output",
 CellLabel->"Out[6]= ",ExpressionUUID->"b8d9157c-b912-431e-a9ec-150eaf973f3a"]
}, Open  ]],

Cell[TextData[{
 "If you ever pass a tensor of the wrong rank to ",
 Cell[BoxData[
 "YoungSymmetrize"], "InlineFormula",ExpressionUUID->
  "ee716356-ccda-4bcf-9d37-5b9d741ab561"],
 " or ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "870e45f9-a773-45ac-aaa8-31858880e96f"],
 ", you will get an error message and a ",
 Cell[BoxData[
 "$Failed"], "InlineFormula",ExpressionUUID->
  "f5318697-ddeb-4303-809b-85d7215a7bcd"],
 " return. ",
 Cell[BoxData[
 "TableauSize"], "InlineFormula",ExpressionUUID->
  "833e9678-bde0-4bd7-bf17-a990345f5c5e"],
 " is how you check rank ahead of time."
}], "Text",ExpressionUUID->"2c75cc2e-e29f-4f97-a857-c09bec9bb514"],

Cell["`YoungSymmetrize`: the unnormalised action", "Section",ExpressionUUID->"f50352fc-e021-4b98-841c-255525f1d481"],

Cell["\<\
The symmetric two-tableau encodes the operator \"sum over both orderings of \
the two slots\":\
\>", "Text",ExpressionUUID->"703ce6db-3ea9-42dd-9a30-a06f033fe5d3"],

Cell[TextData[{
 "$",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     RowBox[{"{", "2", "}"}]], "\[CenterDot]", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"j", "i"}], "TI"]], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b3880c90-bd08-4583-8ec9-2f5472734173"],
 "$"
}], "Text",ExpressionUUID->"90344b86-758c-477a-ac11-179e2743a18e"],

Cell[TextData[{
 "Apply it to our generic ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dfcc0c14-5ade-443a-a740-e7e8646c4d6b"],
 ":"
}], "Text",ExpressionUUID->"40d10c4a-3982-4eba-8e2f-4eb6fede5799"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"YoungSymmetrize", "[", 
  RowBox[{"T", ",", " ", "symTab"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", " ", "a"}], ",", " ", 
       RowBox[{"b", " ", "+", " ", "c"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"b", " ", "+", " ", "c"}], ",", " ", 
       RowBox[{"2", " ", "d"}]}], "}"}]}], "}"}], " ", "*)"}]}]}], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"8a8b5502-5997-4b92-8ef6-b9edf110a843"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", " ", "a"}], ",", 
     RowBox[{"b", "+", "c"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"b", "+", "c"}], ",", 
     RowBox[{"2", " ", "d"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[7]= ",ExpressionUUID->"d96c873d-4f64-4876-a242-9f85308b799a"]
}, Open  ]],

Cell[TextData[{
 "The result is manifestly symmetric, but it is ",
 StyleBox["twice", "TI"],
 " the natural symmetric projection ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "+", 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["T", "TI"]]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"fd1f54ea-f3ed-408f-b4d1-e605fc454b7a"],
 ". That factor of 2 is the size of the row, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    StyleBox["r", "TI"], 
    StyleBox["o", "TI"], 
    StyleBox["w", "TI"], 
    RowBox[{"|", "!"}], "\[LongEqual]", 
    RowBox[{"2", "!"}], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"71b22174-caee-4fd1-b710-ec2553029413"],
 ". In general ",
 Cell[BoxData[
  RowBox[{"YoungSymmetrize", "[", 
   RowBox[{"T", ",", " ", "tab"}], "]"}]], "InlineFormula",ExpressionUUID->
  "cd55fba3-4037-459a-93a3-44b080937c0e"],
 " is the Young symmetriser ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["T", "TI"]], "\[CenterDot]", 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1dcc25e3-c70a-49fa-8b0e-914a239bedd1"],
 ", which satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["T", "TI"], "2"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["n", "TI"], "!", "/", 
      SubscriptBox[
       StyleBox["d", "TI"], "\[Lambda]"]}], ")"}], " ", 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5f6df25a-07a7-4f68-8d2c-36c8fcbe4a80"],
 " rather than ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["T", "TI"], "2"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e7367bd6-49f1-46a2-a08b-f7a8ee3685f4"],
 ". Useful when you want the ",
 StyleBox["unnormalised", "TI"],
 " combination, e.g. for hand calculations."
}], "Text",ExpressionUUID->"1faf0315-7439-4a26-a9b3-7e9e150dfe49"],

Cell[TextData[{
 "The antisymmetric two-tableau gives the operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], "-", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"j", "i"}], "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e3febd53-5b1d-4126-a61f-6a8b86c5381b"],
 ":"
}], "Text",ExpressionUUID->"1b988694-c06b-4f0d-be27-ed1bc672c2c1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"YoungSymmetrize", "[", 
  RowBox[{"T", ",", " ", "antiTab"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", 
       RowBox[{"b", " ", "-", " ", "c"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", " ", "-", " ", "b"}], ",", " ", "0"}], "}"}]}], "}"}], 
   " ", "*)"}]}]}], "Input",
 CellLabel->"In[8]:= ",ExpressionUUID->"8d1f843d-bed7-4961-bc67-11163f47d5e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"b", "-", "c"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "b"}], "+", "c"}], ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[8]= ",ExpressionUUID->"eecfbde0-f8be-4415-a250-ee3fe2b029b2"]
}, Open  ]],

Cell["\<\
The diagonal is zero (the fermionic Pauli principle for the indices) and the \
off-diagonals are equal and opposite. Verify:\
\>", "Text",ExpressionUUID->"68e358a3-04ac-4fc4-b0ac-e02e5b0880db"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ant", " ", "=", " ", 
   RowBox[{"YoungSymmetrize", "[", 
    RowBox[{"T", ",", " ", "antiTab"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ant", " ", "==", " ", 
  RowBox[{"-", 
   RowBox[{"Transpose", "[", "ant", "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",
 CellLabel->"In[9]:= ",ExpressionUUID->"b3fb7e6f-cdb3-4c65-9ab0-e69de8616e5c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[9]= ",ExpressionUUID->"725debe1-3c15-4afe-9949-e05ddb6714a9"]
}, Open  ]],

Cell["`YoungProject`: the idempotent", "Section",ExpressionUUID->"fc04e5b7-31cb-4dce-83b3-0428a5427135"],

Cell[TextData[{
 "For iterative TN algorithms (DMRG, TDVP) you usually want the ",
 StyleBox["projector", "TI"],
 " form, an operator ",
 Cell[BoxData[
  FormBox[
   StyleBox["P", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1a93810c-5256-46cf-92f6-09ce2f4e7507"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["P", "TI"], "2"], "\[LongEqual]", 
    StyleBox["P", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9df52ba6-d27c-49fa-97ac-22b5b5808e07"],
 ". That requires dividing by the prefactor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "!", "/", 
    SubscriptBox[
     StyleBox["d", "TI"], "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e44a35e3-cffa-4d3b-a4ee-2ee9f8e7c5a1"],
 ". ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "33795cd0-8865-46a0-bcbb-26c88161f315"],
 " does it for you:"
}], "Text",ExpressionUUID->"ad463a73-4e1b-406b-8bc9-7a05d57b6063"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Psym", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T", ",", " ", "symTab"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Pant", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T", ",", " ", "antiTab"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"Psym", ",", " ", "Pant"}], "}"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"b", "+", "c"}], ")"}], "/", "2"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"b", "+", "c"}], ")"}], "/", "2"}], ",", " ", "d"}], 
        "}"}]}], "}"}], ",", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"b", "-", "c"}], ")"}], "/", "2"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"c", "-", "b"}], ")"}], "/", "2"}], ",", " ", "0"}], 
        "}"}]}], "}"}]}], "}"}], " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[10]:= ",ExpressionUUID->"b6e1cd8a-34e5-47dc-a214-0101b533ed05"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", 
       FractionBox[
        RowBox[{"b", "+", "c"}], "2"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{"b", "+", "c"}], "2"], ",", "d"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox[
        RowBox[{"b", "-", "c"}], "2"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "b"}], "+", "c"}], ")"}]}], ",", "0"}], "}"}]}], 
    "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[10]= ",ExpressionUUID->"15c37944-524b-4423-9c8f-23c3c77260bd"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
 "Psym"], "InlineFormula",ExpressionUUID->
  "8ec1ecb8-93d6-452e-9560-2b267a58b162"],
 " is exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "+", 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["T", "TI"]]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a9be128d-1523-408d-823e-7f386b4c6288"],
 ". ",
 Cell[BoxData[
 "Pant"], "InlineFormula",ExpressionUUID->
  "14386952-9d18-4383-89df-8c6153f5b458"],
 " is exactly ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "-", 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["T", "TI"]]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"80ebcff5-d8f8-46fa-b178-aceb5808aa74"],
 ". They sum back to ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "20b919b3-82f5-485f-a592-3b07da75097f"],
 ":"
}], "Text",ExpressionUUID->"7ee876ab-8c4b-4b75-95d8-957640ca3517"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Simplify", "[", 
  RowBox[{"Psym", " ", "+", " ", "Pant", " ", "-", " ", "T"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}], " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[11]:= ",ExpressionUUID->"e4d84fd4-7564-4bfa-ab50-bc57cc7ef8ff"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[11]= ",ExpressionUUID->"1774808f-5b10-4821-96aa-160d7f41cbb9"]
}, Open  ]],

Cell[TextData[{
 "That sum-back-to-identity property is no accident. We will see in \
\[Section]4 that on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0fbfcd58-eaea-494d-a35c-bcba22c8d6ad"],
 " the sum of the ",
 StyleBox["isotypic", "TI"],
 " projectors (one per partition of ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "76f8637d-e65b-46b0-9038-4c0160526221"],
 ") is always the identity. For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"78b08716-937d-4bc4-b6f7-987c7471b28d"],
 " there are two partitions, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c8484a59-0d84-4e4b-88be-6558d909501b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"66953aa0-0ccf-48c7-8024-ee67c9a4596f"],
 ", so we get an exact decomposition with two terms."
}], "Text",ExpressionUUID->"9812667d-d044-456c-b6e5-4cb88de1736b"],

Cell[TextData[{
 "Idempotence is the operational reason to prefer ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "819456ea-4d91-4451-be29-56c11c3559db"],
 " over ",
 Cell[BoxData[
 "YoungSymmetrize"], "InlineFormula",ExpressionUUID->
  "ed4d4e79-596a-4c5f-bfdc-52495eaf1d9c"],
 " in iterative code. Project a random matrix twice; the second projection is \
the identity:"
}], "Text",ExpressionUUID->"03947ff1-99e8-46c4-ac21-240b2facc94f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Mnum", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"P1", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"Mnum", ",", " ", "symTab"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"P2", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"P1", ",", " ", "symTab"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"P1", " ", "-", " ", "P2"}], "]"}], "]"}], "]"}], " ", "<", " ", 
  "tol"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"4802ea32-502f-4f08-92ca-1f4a47aa26ca"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[12]= ",ExpressionUUID->"a9084ccd-84ab-4f60-9bcf-e56f590bd4ae"]
}, Open  ]],

Cell[TextData[{
 "So far we have used six of the twelve functions: ",
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "b197aa6d-8b1f-4a7c-b798-4fa18e4ef91f"],
 ", ",
 Cell[BoxData[
 "YoungTableauQ"], "InlineFormula",ExpressionUUID->
  "b9143ec7-3e4d-4783-98fb-c74106d00fbb"],
 ", ",
 Cell[BoxData[
 "TableauShape"], "InlineFormula",ExpressionUUID->
  "93085951-3225-4431-9c89-0e990a865bbd"],
 ", ",
 Cell[BoxData[
 "TableauSize"], "InlineFormula",ExpressionUUID->
  "759d203d-2810-4005-9679-6b806db2f31a"],
 ", ",
 Cell[BoxData[
 "YoungSymmetrize"], "InlineFormula",ExpressionUUID->
  "432d0590-816f-4c3c-8fd2-aa8ca15e22c7"],
 ", ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "59610bad-cb0b-4185-955f-7c5a4126073a"],
 ". That covers everything you need to enforce boson / fermion parity on a \
single bond. The next sections build the combinatorial machinery you need \
before going to higher rank."
}], "Text",ExpressionUUID->"a3db5ac7-7b61-42d5-9cf8-6f914805ef46"],

Cell["\<\
A two-bond TN application: the bond between identical fermions\
\>", "Section",ExpressionUUID->"477ce98b-73b6-4838-b0ed-c33275cb3e70"],

Cell[TextData[{
 "To make the rank-2 case feel like a real tensor-network move, consider a \
one-bond network with a node ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a7a2b5a7-460e-4dcf-bae6-1b82951fb79d"],
 " on the left, a single bond ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e5c86dfe-c730-4b32-8df9-de0273122757"],
 " in the middle, and a node ",
 Cell[BoxData[
  FormBox[
   StyleBox["B", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2cc602f7-d959-4e6f-b39b-cba4c8d3d348"],
 " on the right:"
}], "Text",ExpressionUUID->"4e2a0ed6-6fd1-4679-b85a-9a4ed09d9fa3"],

Cell[TextData[{
 "$",
 Cell[BoxData[
  FormBox[
   RowBox[{"value", " ", 
    RowBox[{"\[LongEqual]", " "}], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox["i", "TI"]], " ", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], " ", 
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["j", "TI"]], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7d5f9226-21ad-4fe3-98c7-db46bb0b3f1c"],
 "$"
}], "Text",ExpressionUUID->"f6562131-b3ff-4e9e-96cc-58a308911e61"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "79487b0b-99dc-4629-984e-949dbe6ae771"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["B", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9bdd4375-cbc6-4e9e-8f8f-6cc84e65c22d"],
 " describe two indistinguishable fermions, the bond ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4eaba719-bd5a-4c2d-96f0-f390ad8b3562"],
 " lives in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[CapitalLambda]", "2"], 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "013370b0-e35d-45f4-9ef8-201274ee7c8f"],
 " and never in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["Sym",
      FontSlant->"Plain"], "2"], 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d289d90c-f1e1-4259-ae3e-48b8ae5b6022"],
 ". Storing both halves of ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "506b2457-db1b-47c5-a4b0-a238677a1bac"],
 " wastes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "+", "1"}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b740e25a-155b-4b8a-8d2f-27bd2490c26d"],
 " slots and admits configurations that the physics forbids. The fix is one \
",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "198dc6be-9284-4bff-b8c8-947d75a70673"],
 " call before any contraction:"
}], "Text",ExpressionUUID->"926b7a93-56a1-473c-94d5-9ffc29fdec21"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "3", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d", " ", "=", " ", "4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"TFermi", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T", ",", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "d"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"B", " ", "=", " ", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "d"}], "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"A", " ", ".", " ", "TFermi", " ", ".", " ", "B"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"a", " ", "scalar"}], ";", " ", 
    RowBox[{"same", " ", "as", " ", 
     RowBox[{"1", "/", "2"}], " ", "*", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"A", ".", "T", ".", "B"}], " ", "-", " ", 
       RowBox[{"B", ".", "T", ".", "A"}]}], ")"}]}]}], " ", "*)"}], "\n", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"The", " ", "wrong"}], ",", " ", 
    RowBox[{
    "unprojected", " ", "contraction", " ", "overcounts", " ", "by", " ", 
     "mixing", " ", "in", " ", "the", "\n", "   ", "symmetric", " ", "piece", 
     " ", "that", " ", "is", " ", "physically", " ", 
     RowBox[{"forbidden", ":"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", " ", ".", " ", "T", " ", ".", " ", "B"}], ")"}], " ", "-", 
    " ", 
    RowBox[{"(", 
     RowBox[{"A", " ", ".", " ", "TFermi", " ", ".", " ", "B"}], ")"}]}], 
   "]"}], " ", ">", " ", "tol"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"True", ":", " ", 
    RowBox[{"they", " ", "differ", " ", "by", " ", "the", " ", "symmetric", " ", 
     RowBox[{"overshoot", "."}]}]}], " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[13]:= ",ExpressionUUID->"dc2d536b-3881-440e-a8d4-81279fbb85b6"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[13]= ",ExpressionUUID->"cbb6a133-d191-42ac-9e67-52ddca8ad391"]
}, Open  ]],

Cell[TextData[{
 "After the projection, any downstream TN operation that respects index types \
(",
 Cell[BoxData[
 "TensorContract"], "InlineFormula",ExpressionUUID->
  "9cb1674d-772a-491d-abb9-05d5eaf4d343"],
 ", ",
 Cell[BoxData[
 "Dot"], "InlineFormula",ExpressionUUID->
  "993e0afd-2361-410f-b64d-ddf95ba12c20"],
 ", SVD on a paired index) preserves the antisymmetric class. The orthogonal \
sector is gone for good."
}], "Text",ExpressionUUID->"275efa1e-736a-4378-b78a-89eb0ee21994"],

Cell["2. Partitions: the bookkeeping layer", "Title",ExpressionUUID->"d81126cc-713b-4609-a389-35a9cd2e43b1"],

Cell[TextData[{
 "Before we walk up to rank 3 and beyond, we need two utilities that deal \
with the ",
 StyleBox["shape", "TI"],
 " of a Young diagram independently of any slot labelling: ",
 Cell[BoxData[
 "PartitionQ"], "InlineFormula",ExpressionUUID->
  "fa9ce991-df16-4705-a354-6b94d70a67b4"],
 " (is this list a legal shape?) and ",
 Cell[BoxData[
 "TransposePartition"], "InlineFormula",ExpressionUUID->
  "0bb9aafe-e1b6-4514-98be-5420f2df148b"],
 " (the mirror that swaps boson-symmetric and fermion-antisymmetric reps)."
}], "Text",ExpressionUUID->"9cef30a4-2c59-4169-a832-b5a6cc3447d6"],

Cell[TextData[{
 "A ",
 StyleBox["partition", "TI"],
 " of ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4c80a024-bddd-4f66-b36b-3a3acae26096"],
 " is a non-increasing list of positive integers summing to ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "39febce7-a827-4207-8afb-052b9d8e2893"],
 ". Geometrically it is the shape of a left-justified Young diagram with ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cc956a47-97fd-4788-a3c2-7abc79744594"],
 " boxes. For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"618be048-e53a-4643-a27c-8ae4f576dc10"],
 ", for example, the partitions are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", "4", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9c7a8a88-a92f-451c-9c33-1543f73afebf"],
 ": five shapes, corresponding to the five irreducible representations of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9ccad742-3fa3-4591-ae58-bd48f442ed57"],
 "."
}], "Text",ExpressionUUID->"52532205-6074-4f0e-a13d-0df321b99be5"],

Cell["`PartitionQ`", "Section",ExpressionUUID->"d62ee8ab-e5e5-4a86-9c57-5c67d47d76ca"],

Cell["\<\
A predicate that says \"yes, this list is a partition (non-increasing, \
positive integers, non-empty)\":\
\>", "Text",ExpressionUUID->"b7e10ca0-b901-4b17-91ec-2932183a3cc1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"PartitionQ", "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "2"}], "}"}], "]"}], "         ", 
  RowBox[{"(*", " ", "True", "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"PartitionQ", "[", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "3"}], "}"}], "]"}], "         ", 
  RowBox[{"(*", " ", 
   RowBox[{"False", ":", " ", 
    RowBox[{
     RowBox[{"not", " ", "non"}], "-", "increasing"}]}], " ", "*)"}]}], "\n", 

 RowBox[{
  RowBox[{"PartitionQ", "[", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}], "      ", 
  RowBox[{"(*", " ", "True", "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"PartitionQ", "[", 
   RowBox[{"{", "}"}], "]"}], "             ", 
  RowBox[{"(*", " ", 
   RowBox[{"False", ":", " ", "empty"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"PartitionQ", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "1", ",", " ", "0"}], "}"}], "]"}], "      ", 
  RowBox[{"(*", " ", 
   RowBox[{"False", ":", " ", 
    RowBox[{"zero", " ", "is", " ", "not", " ", "positive"}]}], " ", 
   "*)"}]}]}], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"538f37c8-de49-4167-8454-065a5b54f391"],

Cell[BoxData["False"], "Output",
 CellLabel->
  "Out[14]= ",ExpressionUUID->"ad2b3522-011d-4d12-b56c-7f952ec28d56"]
}, Open  ]],

Cell[TextData[{
 "The combinatorial functions ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "02683fa7-2b04-4ae0-acd0-10eef2358eb7"],
 ", ",
 Cell[BoxData[
 "HookFactor"], "InlineFormula",ExpressionUUID->
  "e7100bc7-e072-4a5b-aa51-f07c9366ab76"],
 ", and ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "5339acbb-fccc-4f2e-bb50-0211ce6e4ddf"],
 " all accept either a partition (via ",
 Cell[BoxData[
 "PartitionQ"], "InlineFormula",ExpressionUUID->
  "2cb678ff-202c-401c-b0b9-027c3222774a"],
 " validation) or a ",
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "af259641-cb28-46fd-8c86-bb2f6718a58a"],
 " (which they will internally reduce to its shape). When you only need ",
 StyleBox["counting", "TI"],
 " information and have no tensor to act on, passing the bare partition is \
the cheapest path."
}], "Text",ExpressionUUID->"e179e9b1-00d5-4a27-8e08-761944bd44cc"],

Cell["`TransposePartition`", "Section",ExpressionUUID->"6466d268-92f3-4f52-a109-27a55e6fed70"],

Cell[TextData[{
 "The ",
 StyleBox["transpose", "TI"],
 " (or ",
 StyleBox["conjugate", "TI"],
 ") of a partition swaps the roles of rows and columns. Visually, you flip \
the Young diagram across its main diagonal. Operationally, it relates the \
fully symmetric and fully antisymmetric representations: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"{", 
      StyleBox["n", "TI"], "}"}], "\[Prime]"], "\[LongEqual]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "\[Ellipsis]", ",", "1"}], "}"}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5da032f9-8ffe-474b-b34f-5a91cbd65b9d"],
 ". More generally it gives the parity-conjugate representation, where every \
box swaps \"stay symmetric here\" with \"stay antisymmetric here\"."
}], "Text",ExpressionUUID->"a93331f7-27d6-485f-b933-c50235be3600"],

Cell["Compute the transposes of a few familiar shapes:", "Text",ExpressionUUID->"b6651f29-d6a5-46cf-b7c1-c9b3116be041"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TransposePartition", "[", 
   RowBox[{"{", 
    RowBox[{"4", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "2", ",", " ", "1", ",", " ", "1"}], "}"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"TransposePartition", "[", 
   RowBox[{"{", "3", "}"}], "]"}], "          ", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "    ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"TransposePartition", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "]"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{"{", "3", "}"}], "          ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"TransposePartition", "[", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "2"}], "}"}], "]"}], "       ", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "2"}], "}"}], "       ", "*)"}]}]}], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"c3e9392d-f1a6-46b1-a51e-ad0bbede3e22"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "2"}], "}"}]], "Output",
 CellLabel->
  "Out[15]= ",ExpressionUUID->"6b9c7466-76d8-4c63-9aa4-6e180fb5c14a"]
}, Open  ]],

Cell[TextData[{
 "Note that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"52adb986-b4ec-4797-bb69-4fbc94b3d094"],
 " is self-conjugate. Self-conjugate shapes have special status in TN: they \
sit on the diagonal of the Schur-Weyl decomposition and carry their own \
peculiar mixed symmetry."
}], "Text",ExpressionUUID->"03863141-fd79-4ec3-bd42-23acb8066187"],

Cell[TextData[{
 "The TN-relevant identity that uses ",
 Cell[BoxData[
 "TransposePartition"], "InlineFormula",ExpressionUUID->
  "f5da6098-d953-4eff-87f5-7bad20b25257"],
 " is the ",
 StyleBox["parity flip", "TI"],
 ": if your network is built from bosonic tensors at irrep ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f9acb0e0-8734-4131-adea-eced90ff0269"],
 ", the same network rewritten with fermionic tensors lives at irrep ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Lambda]", "\[Prime]"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"501b35d3-7f36-444c-b4fc-196d2b03096a"],
 ". In numerical TN codes this is how you cheaply swap statistics without \
rewriting the algorithm."
}], "Text",ExpressionUUID->"c253211e-ed73-4c91-8bd5-ed63fbebfbdb"],

Cell["\<\
3. Counting before allocating: hook lengths and irrep dimensions\
\>", "Title",ExpressionUUID->"57971f92-93b3-4df2-87f7-9b5fd7d94b8d"],

Cell[TextData[{
 "The combinatorial payoff of Young diagrams in tensor networks is that ",
 StyleBox["they let you size every block of a symmetry-resolved tensor before \
allocating any memory", "TI"],
 ". The dimension formula is the ",
 StyleBox["hook-length formula", "TI"],
 ", which is built from cell-by-cell quantities called ",
 StyleBox["hook lengths", "TI"],
 "."
}], "Text",ExpressionUUID->"585a1ff6-fce2-409e-af56-6b44c9240dd9"],

Cell["`HookLength`: one cell at a time", "Section",ExpressionUUID->"4c38bb34-c6d9-43ab-aaa2-df324485b83a"],

Cell[TextData[{
 "At cell ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"defe00e9-fc26-4993-9f68-f0ef43a657a2"],
 " of a Young diagram, the ",
 StyleBox["hook", "TI"],
 " consists of the cell itself, the cells directly to its right in row ",
 Cell[BoxData[
  FormBox[
   StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d02f741f-34a3-4c90-947a-25870d30740d"],
 ", and the cells directly below it in column ",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a42b2199-33a0-437f-a8ef-87101829de18"],
 ". The ",
 StyleBox["hook length", "TI"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["h", "TI"], "(", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e6c78d03-9894-48a6-8f25-3b94c81e3c04"],
 " is the number of cells in the hook."
}], "Text",ExpressionUUID->"485a9e67-8639-4ee3-9c32-033eb56b73f3"],

Cell[TextData[{
 "The diagram of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"3", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"452f3d9b-da5d-4196-bc6c-2398c372525d"],
 " looks like"
}], "Text",ExpressionUUID->"fa8660e1-2712-4fb3-a1bf-0ae8a49ce2d2"],

Cell["\<\
+---+---+---+
|   |   |   |
+---+---+---+
|   |   |
+---+---+\
\>", "Program",ExpressionUUID->"ec7b73f1-177a-4083-8208-0bff450c28df"],

Cell[TextData[{
 "and the hook at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "1"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5e495727-bf85-4ace-9b83-c372428bd10c"],
 " contains the cell itself, the two cells to its right, and the one cell \
below: four cells in total. Verify:"
}], "Text",ExpressionUUID->"8f1afab7-4038-4966-9f1a-b84ea02d989c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"HookLength", "[", 
   RowBox[{
    RowBox[{"YoungTableau", "[", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}], "    ", 
  RowBox[{"(*", " ", "4", " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"HookLength", "[", 
   RowBox[{
    RowBox[{"YoungTableau", "[", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], "    ", 
  RowBox[{"(*", " ", "3", " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"HookLength", "[", 
   RowBox[{
    RowBox[{"YoungTableau", "[", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{"1", ",", " ", 
    RowBox[{"bottom", "-", 
     RowBox[{"right", " ", "corner"}]}]}], " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[16]:= ",ExpressionUUID->"60684f84-d92f-4275-a6e6-0bda81e571b8"],

Cell[BoxData["1"], "Output",
 CellLabel->
  "Out[16]= ",ExpressionUUID->"bf884f70-a3a1-4d3e-9dc5-536972c2dcce"]
}, Open  ]],

Cell["\<\
The corners of a diagram always have hook length 1. The top-left always has \
the largest hook.\
\>", "Text",ExpressionUUID->"27324459-4058-484c-942f-5c176ffeab0a"],

Cell["`HookLengths`: every cell at once", "Section",ExpressionUUID->"c3466d05-1b40-48c1-952f-1f47e929c9e2"],

Cell[TextData[{
 "For dimension calculations you want all hook lengths in one shot. ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "4bdc30b6-e033-4856-8998-1df3c068567e"],
 " returns the nested list whose ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1c234be3-8f53-408f-b8fb-ecc3395167ce"],
 " entry is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["h", "TI"], "(", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"37cb69c3-1a13-4973-b1e0-a270820f261e"],
 ":"
}], "Text",ExpressionUUID->"110998b6-d932-4f7c-9cc3-0ae6b8e16e25"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"HookLengths", "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "2"}], "}"}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "3", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "1"}], "}"}]}], "}"}], " ", "*)"}], "\n"}], "\n", 
 RowBox[{"HookLengths", "[", 
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"6", ",", " ", "4", ",", " ", "2", ",", " ", "1"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", "1", "}"}]}], "}"}], " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"32dcfd0a-cb5d-4621-9328-53bcfe57eb2a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"6", ",", "4", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", "1", "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[17]= ",ExpressionUUID->"1fabd733-e0c3-47af-874e-ae70565128ab"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "3b1659da-9dba-487c-8c3d-3ea8ecf5315a"],
 " is the function ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "8da8f220-5ebd-4a1f-a532-a3afaeb61ab9"],
 " calls internally. It is also the input the Weyl dimension formula needs \
(see \[Section]4) for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d804afcb-4f0b-4c4a-b4d9-f47b32c86cc0"],
 ", the multiplicity of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "56e84792-4e39-45b0-b2e4-0004f529e376"],
 " irrep ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8a4542b1-2f83-426b-8c83-b1a03616e800"],
 " in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2319ef06-cf38-47cd-a554-1c53ba97ef66"],
 "."
}], "Text",ExpressionUUID->"bd05b196-fb65-4607-8431-a01413882f62"],

Cell["`HookFactor`: the prefactor of the projector", "Section",ExpressionUUID->"b423f428-1146-458a-afda-2d0481ca9c62"],

Cell[TextData[{
 "The product of all hook lengths shows up as the denominator in the Young \
projector's prefactor. ",
 Cell[BoxData[
  RowBox[{"HookFactor", "[", "par", "]"}]], "InlineFormula",ExpressionUUID->
  "1e9a21dd-2c6e-40e4-b9d7-77a81ab67567"],
 " returns ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "\[Product]", 
    StyleBox["h", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0450be28-944a-446c-b98b-45468a0f2972"],
 ", computed by the Frobenius determinant formula in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6f45e5d1-dd10-4801-9623-b0642caac274"],
 " where ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "337b9d56-b58d-4656-b6da-d13b5785c1fa"],
 " is the number of rows (rather than ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    StyleBox["n", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f6d62220-b018-4a95-94c2-c07f23082c7b"],
 " if you actually formed the product). It accepts a partition or a ",
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "3370eed5-80c8-475e-a0a9-6e0a07495b6e"],
 ":"
}], "Text",ExpressionUUID->"880ff3ef-6d6e-4ab0-91ac-700d568a889b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"HookFactor", "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "2"}], "}"}], "]"}], "      ", 
  RowBox[{"(*", " ", 
   RowBox[{"1", "/", "24"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"HookFactor", "[", 
   RowBox[{"{", 
    RowBox[{"4", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"1", "/", "144"}], " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[18]:= ",ExpressionUUID->"91641d17-e4b7-409b-8565-8b28e25cf06c"],

Cell[BoxData[
 FractionBox["1", "144"]], "Output",
 CellLabel->
  "Out[18]= ",ExpressionUUID->"6b4b8ccf-39e4-4450-b020-072d92f94cb4"]
}, Open  ]],

Cell[TextData[{
 "You can confirm by reading off the entries of ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "6e7e8187-b618-44ba-ae5b-c730465d63a5"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "4", "\[CenterDot]", "3", "\[CenterDot]", "1", "\[CenterDot]", "2", "\[CenterDot]",
     "1", "\[LongEqual]", "24"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6a138ef1-d1b8-4054-a68f-776aa78ba8af"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"3", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5a38a93c-73d0-4204-9df7-4d7ab68a1b52"],
 "."
}], "Text",ExpressionUUID->"f16296fc-befd-4cc7-812b-072dcae6ed91"],

Cell[TextData[{
 "The irrep dimension is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "!", "\[CenterDot]", "HookFactor"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "272e6c4e-ff4e-4d9e-b59f-571ce4ec50d3"],
 ", which is ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "2e3778be-20de-44a8-ba56-c0320679db97"],
 "."
}], "Text",ExpressionUUID->"4da3ee6a-174f-4f31-8265-bd09b9f16f87"],

Cell["`TableauDimension`: the size of an isotypic block", "Section",ExpressionUUID->"438af4f8-91ca-48af-b490-de009458f4c8"],

Cell[TextData[{
 "This is the function you call most often in symmetry-resolved TN. It \
returns the dimension of the irreducible representation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["V", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5767b317-b7ac-4b6d-88e2-4c2d92d96168"],
 " of the symmetric group ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8f3a8033-0f52-4376-b693-b2c46428d0bc"],
 " labelled by partition ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "236368ea-7a9d-435c-9cdb-b435d19bb8fa"],
 ". By the hook-length formula,"
}], "Text",ExpressionUUID->"692117b7-535b-4c6f-8ff8-a1ab64762e17"],

Cell[TextData[{
 "$",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    FractionBox[
     RowBox[{
      StyleBox["n", "TI"], "!"}], 
     RowBox[{
      UnderscriptBox["\[Product]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          StyleBox["i", "TI"], ",", 
          StyleBox["j", "TI"]}], ")"}], "\[Element]", "\[Lambda]"}],
       LimitsPositioning->True], 
      StyleBox["h", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["i", "TI"], ",", 
        StyleBox["j", "TI"]}], ")"}]}]], "."}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"795733e2-8ffb-4e42-b34c-cd080c733785"],
 "$"
}], "Text",ExpressionUUID->"c4e0275b-5067-42d3-8b17-2d5e7306f6e3"],

Cell[TextData[{
 "In a symmetry-resolved MPS, this dimension is the ",
 StyleBox["multiplicity space", "TI"],
 " dimension for the block labelled by ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "61e10efc-f3a2-4fdf-9dc0-cb3724b63bdd"],
 ". The full block size factors as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], "\[CenterDot]", "dim", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"82ed6eed-c9b4-4733-867f-482004affdd2"],
 " (we will see ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"685a234e-c6a5-403a-ba66-0efa038bb490"],
 " in \[Section]4), and ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "77c7b273-7823-4cb4-a70d-197ad77bbf84"],
 " is the easy factor."
}], "Text",ExpressionUUID->"2c74e175-d669-4a23-9a4a-fc437a6755e7"],

Cell[TextData[{
 "Read off all the irrep dimensions of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "5"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"50662e70-a9fe-433a-81ad-b3233e6f4570"],
 ":"
}], "Text",ExpressionUUID->"fe001449-6e95-45bc-b023-ee4b5c853001"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"TableauDimension", " ", "/@", " ", 
  RowBox[{"IntegerPartitions", "[", "5", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
    "1", ",", " ", "4", ",", " ", "5", ",", " ", "6", ",", " ", "5", ",", " ",
      "4", ",", " ", "1"}], "}"}], " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[19]:= ",ExpressionUUID->"d733eef5-60f6-486f-aa5f-0ff2c02fe2e8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "4", ",", "5", ",", "6", ",", "5", ",", "4", ",", "1"}], 
  "}"}]], "Output",
 CellLabel->
  "Out[19]= ",ExpressionUUID->"ed359d6e-68cc-413c-884c-44ffdc0ef2f2"]
}, Open  ]],

Cell[TextData[{
 "The pair of ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "37c5ae42-c0bf-404c-a9f6-b9055b8c4120"],
 "s are the trivial (fully symmetric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "5", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1f015ec5-a953-42b2-bf73-a2e3cc02eed7"],
 ") and sign (fully antisymmetric, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "24afcdf6-cc8b-493f-8404-7959a46b10e2"],
 ") representations. The other five are the \"interesting\" irreps."
}], "Text",ExpressionUUID->"fb3740e2-ce33-433c-8f0b-6021ef575801"],

Cell[TextData[{
 "The sum of squares should equal ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["S", "TI"], "5"], "|", "\[LongEqual]", 
    RowBox[{"5", "!"}], "\[LongEqual]", "120"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"42f2ebb5-cc77-4ef9-93f3-f77339e9db54"],
 " (a Plancherel identity that holds for every ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9e0f4c86-5aa2-470a-86ff-6f3d2364fdfe"],
 "):"
}], "Text",ExpressionUUID->"8944d17d-2af4-4019-adc5-ddf12ee08b74"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Total", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"TableauDimension", "[", "#", "]"}], "^", "2"}], " ", "&"}], " ",
    "/@", " ", 
   RowBox[{"IntegerPartitions", "[", "5", "]"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "120", " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[20]:= ",ExpressionUUID->"4908754b-db19-4280-9c87-417c2865d0ef"],

Cell[BoxData["120"], "Output",
 CellLabel->
  "Out[20]= ",ExpressionUUID->"d732edd0-117d-4f55-a7ab-27bd2dc0dc65"]
}, Open  ]],

Cell[TextData[{
 "That identity is what guarantees the Schur-Weyl decomposition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["V", "TI"], 
     RowBox[{"\[CircleTimes]", 
      StyleBox["n", "TI"]}]], "\[LongEqual]", 
    SubscriptBox["\[CirclePlus]", "\[Lambda]"], 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], "\[CircleTimes]", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ad20d9c3-6663-4613-90ce-0b0a5e73a927"],
 " uses every dimension. Nothing is missing, nothing is double-counted."
}], "Text",ExpressionUUID->"188d7722-5a44-4a7c-964d-982db2650027"],

Cell[TextData[{
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "dec334c6-f121-4c48-b84d-662719f0ec20"],
 " accepts either a partition or a tableau:"
}], "Text",ExpressionUUID->"bab0f2cb-95df-44af-87df-fa286e7ce541"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TableauDimension", "[", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], "                          ", 
  
  RowBox[{"(*", " ", "2", " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"TableauDimension", "[", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", "3", "}"}]}], "}"}], "]"}], "]"}], "     ", 
  RowBox[{"(*", " ", "2", " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[21]:= ",ExpressionUUID->"65406b3b-b85a-4333-9f2d-53b0b5ebc370"],

Cell[BoxData["2"], "Output",
 CellLabel->
  "Out[21]= ",ExpressionUUID->"0928f856-5a6e-4c29-8836-9a323ea0d12b"]
}, Open  ]],

Cell["Summary of the combinatorial layer", "Subsection",ExpressionUUID->"2df43f38-bb67-47b6-9ab4-a34045ade718"],

Cell[TextData[{
 Cell[BoxData[
 "PartitionQ"], "InlineFormula",ExpressionUUID->
  "ca5d9b32-e3db-4aee-8a6c-de4a39b15eab"],
 ": shape is a non-empty non-increasing list of positive integers."
}], "Item",ExpressionUUID->"82ed1ce4-e925-40ee-a82c-be2dbd35777f"],

Cell[TextData[{
 Cell[BoxData[
 "TransposePartition"], "InlineFormula",ExpressionUUID->
  "af4d428d-3b44-4fd6-a6a5-eb3ff55baf5f"],
 ": flips the diagram, mapping irrep ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "947ce74d-30d4-449c-a627-964c894fdacd"],
 " to its sign-twist ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Lambda]", "\[Prime]"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0df44f51-403b-4356-b9fa-8c6e6b36431c"],
 "."
}], "Item",ExpressionUUID->"14117c89-b710-4fba-93b2-3440baf656c4"],

Cell[TextData[{
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "85a1e004-974f-4c7f-9423-7011e658a2b4"],
 ", ",
 Cell[BoxData[
 "YoungTableauQ"], "InlineFormula",ExpressionUUID->
  "ba9032a9-920d-483b-b12b-d3f0496b0a3c"],
 ", ",
 Cell[BoxData[
 "TableauShape"], "InlineFormula",ExpressionUUID->
  "1c0eceec-9511-4ce5-981f-5fd92ffd7369"],
 ", ",
 Cell[BoxData[
 "TableauSize"], "InlineFormula",ExpressionUUID->
  "0776c538-2d6e-44ce-863f-d5d40ba0c7a4"],
 ": typed handle and accessors."
}], "Item",ExpressionUUID->"80584861-0c02-4690-9733-b1e3170900bb"],

Cell[TextData[{
 Cell[BoxData[
 "HookLength"], "InlineFormula",ExpressionUUID->
  "e564cc44-1cb9-4df9-b8b0-47e43009dbc7"],
 ", ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "6ad01d82-0b5d-4161-a9a4-9f4254f902e4"],
 ": the cell quantities the dimension formula consumes."
}], "Item",ExpressionUUID->"43964e9d-c8bf-4d8a-9efb-7e08ce71f19a"],

Cell[TextData[{
 Cell[BoxData[
 "HookFactor"], "InlineFormula",ExpressionUUID->
  "3b30cbcc-67d6-4c20-abe2-3a2b0eb33ce5"],
 ": the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "\[Product]", 
    StyleBox["h", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "38147360-2304-4aab-bfc9-6c20afdf8132"],
 " prefactor."
}], "Item",ExpressionUUID->"ca390f60-32b0-40b4-bb6c-1839ffefd071"],

Cell[TextData[{
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "27c63241-4292-4082-8d55-9d4560586677"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "!", "\[CenterDot]", "HookFactor"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d245d1f3-75f4-4dea-907d-f7fcf3770e5e"],
 ", the block size in symmetry-resolved TN."
}], "Item",ExpressionUUID->"f8df653a-d94d-4c3f-9a1c-98f7780ad6b3"],

Cell[TextData[{
 "We can now leave the combinatorics behind and let ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "50b1ba30-44a4-4c4d-8eb5-eaf20258f34d"],
 " carry the load on real tensor-network problems."
}], "Text",ExpressionUUID->"30e0aa3b-2bf3-4105-b8aa-0f446716e8c7"],

Cell["4. Three TN payoffs", "Title",ExpressionUUID->"b216c615-b88e-4aa6-9666-f7e00d42b99c"],

Cell[TextData[{
 "The three examples that follow are the operational core of this tutorial. \
Each one is small enough to inspect by hand and large enough that doing the \
same job without the Symmetry sub-context would be measurably worse. The \
first is the cleanest illustration of the ",
 StyleBox["Schur-Weyl decomposition", "TI"],
 " on three sites. The second is the ",
 StyleBox["Riemann tensor", "TI"],
 ", a classical-gravity rank-4 tensor whose symmetry is exactly the one ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"504e39ef-cf4b-47c6-8f51-e72f1ab472de"],
 " irrep that built-in WL canonicalisation cannot enforce. The third is a ",
 StyleBox["class-function Hamiltonian", "TI"],
 " whose entire spectrum comes from partition combinatorics, no \
diagonalisation needed."
}], "Text",ExpressionUUID->"2eb08dfa-17bc-41b1-ade4-ab8066f24927"],

Cell["\<\
4.1 Schur-Weyl on three sites: how a tensor decomposes by symmetry\
\>", "Section",ExpressionUUID->"0a7d468e-576a-4256-bc7e-9c938dd8f5d2"],

Cell[TextData[{
 "Take ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["C",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fd2d432c-af49-4c7a-a1b9-4f42e42b043f"],
 " and look at the rank-3 tensor space ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d13a0a06-5eb8-4522-97eb-950d21eeaded"],
 ". It has dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["n", "TI"]], "\[LongEqual]", 
    SuperscriptBox["2", "3"], "\[LongEqual]", "8"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6b4351a4-f344-490a-a6e0-76c0647de541"],
 ". The Schur-Weyl theorem says this space splits into pieces labelled by \
partitions of 3 (i.e. irreducible representations of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "3"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ff25a3f2-914f-48d4-a9b4-b840f8293432"],
 "):"
}], "Text",ExpressionUUID->"4bb544ca-7fe2-44c5-8293-409920daf9e6"],

Cell[TextData[{
 "$",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    SubscriptBox["\[CirclePlus]", 
     RowBox[{"\[Lambda]", "\[RightTee]", "3"}]], 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], "\[CircleTimes]", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f8c3ad2d-6753-4daa-95e6-2f6db81e550b"],
 "$"
}], "Text",ExpressionUUID->"8f8c2e7f-fea4-4cd4-baaa-9d33bff6158b"],

Cell[TextData[{
 "The three partitions are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "3", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "06d95769-054a-46d0-8d9c-c76812d50933"],
 " (fully symmetric, bosonic), ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2d66f557-ce59-4e6c-84c7-7857a8b99199"],
 " (mixed symmetry), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"07dde93f-7c7e-4699-88e4-ef08e276470f"],
 " (fully antisymmetric, fermionic). Each block has dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], "\[CenterDot]", "dim", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9c2e4eef-b2aa-4761-b9a3-e723b3d9f106"],
 ". The first factor is ",
 Cell[BoxData[
  RowBox[{"TableauDimension", "[", "par", "]"}]], "InlineFormula",
  ExpressionUUID->"ac48dc7e-caa9-478e-ab61-faa09879af03"],
 ". The second factor is the Weyl dimension formula:"
}], "Text",ExpressionUUID->"fbf6d307-c696-4297-b92a-de1ea3223c18"],

Cell[TextData[{
 "$",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    UnderscriptBox["\[Product]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        StyleBox["i", "TI"], ",", 
        StyleBox["j", "TI"]}], ")"}], "\[Element]", "\[Lambda]"}],
     LimitsPositioning->True], 
    FractionBox[
     RowBox[{
      StyleBox["d", "TI"], "+", 
      StyleBox["j", "TI"], "-", 
      StyleBox["i", "TI"]}], 
     RowBox[{
      StyleBox["h", "TI"], "(", 
      RowBox[{
       StyleBox["i", "TI"], ",", 
       StyleBox["j", "TI"]}], ")"}]], "."}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0b82eb2d-9d46-4f26-98b4-76b1cdc32e3f"],
 "$"
}], "Text",ExpressionUUID->"9c3d1ab1-9a62-4ad7-90e8-e22d44353ab1"],

Cell[TextData[{
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "4b10c134-7af6-418f-8ea2-7d246ee106a5"],
 " feeds the denominator. We write a tiny helper:"
}], "Text",ExpressionUUID->"cd52ef9b-3893-49da-aa02-0f1e6594597e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"schurDim", "[", 
    RowBox[{"par_List", ",", " ", "d_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", " ", "=", " ", 
       RowBox[{"HookLengths", "[", "par", "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"Product", "[", "\n", "        ", 
      RowBox[{
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"d", " ", "+", " ", "j", " ", "-", " ", "i"}], ")"}], "/", 
          
          RowBox[{"h", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", " ", "j"}], "]"}], "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", 
           RowBox[{"par", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
       "        ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "par", "]"}]}], "}"}]}], "\n", "    ", 
      "]"}]}], "\n", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"bacc77e8-6b5c-4288-94e0-07578b36418a"],

Cell[TextData[{
 "Predict the block sizes at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2", ",", 
    StyleBox["n", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0593e88a-ce74-4e63-b495-e06055ad7b1d"],
 ":"
}], "Text",ExpressionUUID->"abfb8e52-1b0b-4c30-ba2f-79507e744b3e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Table", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"par", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TableauDimension", "[", "par", "]"}], ",", " ", 
      RowBox[{"schurDim", "[", 
       RowBox[{"par", ",", " ", "2"}], "]"}], ",", "\n", "            ", 
      RowBox[{
       RowBox[{"TableauDimension", "[", "par", "]"}], " ", "*", " ", 
       RowBox[{"schurDim", "[", 
        RowBox[{"par", ",", " ", "2"}], "]"}]}]}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{"par", ",", " ", 
     RowBox[{"IntegerPartitions", "[", "3", "]"}]}], "}"}]}], "\n", "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "3", "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4", ",", " ", "4"}], "}"}]}], ",", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2", ",", " ", "4"}], "}"}]}], ",", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}]}], "}"}], " ", 
   "*)"}]}]}], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"2f03e320-329a-4db4-a64b-4c91e64b5943"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "3", "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "4", ",", "4"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2", ",", "4"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0"}], "}"}]}]}], "}"}]], "Output",
 CellLabel->
  "Out[23]= ",ExpressionUUID->"b1b9a8e5-1ee3-4a04-a5ea-a0317ee76b5c"]
}, Open  ]],

Cell[TextData[{
 "Read row by row: the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "3", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "17f812b8-58ff-486b-abbc-875e2a920bc7"],
 " block has size ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[CenterDot]", "4", "\[LongEqual]", "4"}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"8aab170b-7801-4c2a-8496-6487e9fdd9ed"],
 " (a four-dimensional bosonic sector). The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4d55a40c-b534-400e-9e77-e0aa6a809e9b"],
 " mixed block has size ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[CenterDot]", "2", "\[LongEqual]", "4"}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"4e57aa9d-b012-41f1-9976-4eba86ebb74e"],
 ". The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"5fa0f3b6-fd5d-4f4b-9ebf-28d776ffd42e"],
 " fermionic block has size ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[CenterDot]", "0", "\[LongEqual]", "0"}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"c832ba2d-baef-4c14-9203-e520edf98e1e"],
 ", ",
 StyleBox["exactly zero", "TI"],
 ", because you cannot antisymmetrise three slots over a two-dimensional \
space (the Pauli principle for three spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3452c163-590a-40ab-a987-c2c9ca862454"],
 " particles forbids it). The sum is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "+", "4", "+", "0", "\[LongEqual]", "8", "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"55321fc7-e642-4c1f-9f7a-7215980a4fc7"],
 ". The decomposition exhausts the tensor space and tells you, without ever \
forming a projector, that any operation involving the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"04fb3b62-2c5d-475d-9242-a805626acc6e"],
 " sector can be skipped."
}], "Text",ExpressionUUID->"ad7e235b-ae84-427a-bb23-8d2c5309ffcb"],

Cell[TextData[{
 "The construction generalises to higher ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5506cd19-2a42-4207-acd3-c759adcdfc87"],
 " and is the foundation of symmetry-resolved DMRG / TDVP: every bond carries \
an exact decomposition by partition ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a1926fe4-3b56-4b74-89e3-15dfbd51bc83"],
 " and the block dimensions are read off in closed form."
}], "Text",ExpressionUUID->"cce3bd15-9d14-48e5-9f35-f93ba5501026"],

Cell[TextData[{
 "Now let us ",
 StyleBox["measure", "TI"],
 " the decomposition explicitly, projector by projector. For each partition \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[RightTee]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"eef6352a-ab6e-490a-8f64-3445adaa2d5f"],
 ", the isotypic projector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6656ac00-2562-431f-8c97-3b8a5e442840"],
 " on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", "3"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ac100e57-9a53-4cd8-a048-e6f40272f45e"],
 " is the sum of the Young projectors over the ",
 StyleBox["standard tableaux", "TI"],
 " of shape ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1c422277-0ea5-40e6-97c4-2bab6d23a63d"],
 ". There is one standard tableau of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "3", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "123f915e-00a1-4361-a169-1d6cfc313b27"],
 " (namely ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f93e3261-b660-4f90-bc6e-f55281b7c82d"],
 "), two of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9e9a9adb-e21b-49d4-a182-eb6460c5fafc"],
 " (namely ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", "3", "}"}]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a305841f-6211-44e0-8ddc-d8c107af71e0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", "2", "}"}]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"57b71819-cdc3-427a-aaa5-123def3861c4"],
 ", two equal to ",
 Cell[BoxData[
  RowBox[{"TableauDimension", "[", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "778ef391-9d87-4788-b0db-55ac454ceec9"],
 "), and one of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"03da970f-4d24-410e-a14b-ca5d8ed81614"],
 " (namely ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", "2", "}"}], ",", 
     RowBox[{"{", "3", "}"}]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"13249850-abc0-46ff-b6fb-cd767fe1e6c4"],
 ")."
}], "Text",ExpressionUUID->"0352d1af-1b12-468f-87d3-aa8901497821"],

Cell[TextData[{
 "Project a random rank-3 tensor in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"102b2ba5-fe9d-47ba-a8e3-58ea76170012"],
 ":"
}], "Text",ExpressionUUID->"0d1fd6e8-e4b4-4b7d-8d21-f911ad308ed4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"T3", " ", "=", " ", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"e3", "   ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T3", ",", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "}"}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e21", "  ", "=", " ", 
   RowBox[{
    RowBox[{"YoungProject", "[", 
     RowBox[{"T3", ",", " ", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", "3", "}"}]}], "}"}], "]"}]}], "]"}], " ", "+", "\n", 
    "       ", 
    RowBox[{"YoungProject", "[", 
     RowBox[{"T3", ",", " ", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "}"}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e111", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T3", ",", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "1", "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}], ",", " ", 
        RowBox[{"{", "3", "}"}]}], "}"}], "]"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[24]:= ",ExpressionUUID->"85dc61b6-9dc0-4bf8-ae8d-bc1681180df3"],

Cell["\<\
The three pieces sum to the original tensor (completeness of the isotypic \
decomposition):\
\>", "Text",ExpressionUUID->"b53cf422-626e-4151-b479-9b1c1d1a166c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{
     "e3", " ", "+", " ", "e21", " ", "+", " ", "e111", " ", "-", " ", "T3"}],
      "]"}], "]"}], "]"}], " ", "<", " ", "tol"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[25]:= ",ExpressionUUID->"73b652da-9aba-44a8-97b9-4c27c1d0ae9a"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[25]= ",ExpressionUUID->"677f07d5-61df-45d8-af35-11381c0f25dd"]
}, Open  ]],

Cell["\<\
And the predicted vanishing of the fermionic piece holds identically:\
\>", "Text",ExpressionUUID->"15b1ca0d-3e38-453c-bc55-07607ad57b64"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", "e111", "]"}], "]"}], "]"}], " ", "<", " ", 
  "tol"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[26]:= ",ExpressionUUID->"adb58011-d542-434f-9fe9-f19d5560f606"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[26]= ",ExpressionUUID->"be51981d-21df-491d-a099-89b69c164f3c"]
}, Open  ]],

Cell["\<\
The decomposition is exact, computed without any eigenvalue routine. The role \
of each Symmetry-subcontext function here:\
\>", "Text",ExpressionUUID->"c603fec1-01ae-4469-829a-1e018759a77a"],

Cell[TextData[{
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "c29689d3-d293-41a6-9a67-574ed606df57"],
 " names each block by its shape."
}], "Item",ExpressionUUID->"1098d9f3-715d-4124-9e02-64fad8142ed1"],

Cell[TextData[{
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "ed900d4c-fce5-4c68-a252-7e6291e79884"],
 " returns the projection of the input tensor onto that block."
}], "Item",ExpressionUUID->"ca9d8557-0269-49cc-a732-9d67731f1ffa"],

Cell[TextData[{
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "7cac34c4-e3a2-48e6-8182-7173720c8874"],
 " says ",
 StyleBox["how many", "TI"],
 " standard tableaux there are per shape, which is how many ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "aef38d10-bafc-4869-8e35-88683b7c6132"],
 " calls to sum into the isotypic ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9d6beccb-aa1f-49d5-a783-0f1215e1ad60"],
 "."
}], "Item",ExpressionUUID->"40d55cde-a33e-4967-b93f-a8179b667f85"],

Cell[TextData[{
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "ea88bbf5-b506-441f-a750-0cec9425a4e7"],
 " feeds ",
 Cell[BoxData[
 "schurDim"], "InlineFormula",ExpressionUUID->
  "62364a02-56d5-4bd3-bc96-e980a63e0c99"],
 " for the GL(",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c93b1ffc-9d95-4a8a-8867-238175524312"],
 ") factor."
}], "Item",ExpressionUUID->"f7575ac9-ea7a-48b4-903d-b62bb3bb23ba"],

Cell["4.2 The Riemann tensor as a TN node", "Section",ExpressionUUID->"01fc6923-4a71-44ee-bd94-cdbe40155e43"],

Cell[TextData[{
 "The Riemann curvature tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"a", "b", "c", "d"}], "TI"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"966f77e7-41bd-4549-b0ac-d13560248ad7"],
 " is a rank-4 tensor with four classical symmetries:"
}], "Text",ExpressionUUID->"edb9c4fd-7e4f-405b-960f-ee72b98d88dd"],

Cell[TextData[{
 "Antisymmetric in the first pair: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]], "\[LongEqual]", "-", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"b", "a", "c", "d"}], "TI"]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"90e74f0c-fc92-4625-a4cf-924977088eb8"],
 "."
}], "ItemNumbered",ExpressionUUID->"404d05b1-68d1-42ad-8801-c3ef39aba026"],

Cell[TextData[{
 "Antisymmetric in the second pair: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]], "\[LongEqual]", "-", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "d", "c"}], "TI"]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c18db837-db95-49d9-8d4f-8badae9aec3d"],
 "."
}], "ItemNumbered",ExpressionUUID->"ea614701-0605-4f64-a9e3-001b968fec23"],

Cell[TextData[{
 "Symmetric under pair swap: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"c", "d", "a", "b"}], "TI"]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b65e9798-ffd7-4f4c-8b58-df83d4610bd5"],
 "."
}], "ItemNumbered",ExpressionUUID->"d97ef832-4d0c-4a93-b201-c212bfde784f"],

Cell[TextData[{
 StyleBox["First Bianchi identity", "TI"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "c", "d", "b"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "d", "b", "c"}], "TI"]], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "97efc00f-5b11-414e-82cd-f1b84b1fee60"],
 "."
}], "ItemNumbered",ExpressionUUID->"9539b3b5-e84a-4711-8ab9-6afedbf0fbb7"],

Cell[TextData[{
 "The first three are ",
 StyleBox["single-term", "TI"],
 " slot symmetries (each says ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "\[PlusMinus]", 
    SuperscriptBox[
     StyleBox["T", "TI"], "\[Sigma]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4479a4a0-15de-4cbb-a14e-5541768e5c91"],
 " for one permutation ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "542eca3f-42b8-49de-898d-6f4a1274d237"],
 "). Standard WL canonicalisation via ",
 Cell[BoxData[
  RowBox[{"TensorReduce", "[", 
   RowBox[{"Arrays", "[", 
    RowBox[{"...", ",", " ", "sym"}], "]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"a4f0a5b8-1e60-47ed-9f0b-72e09e74dd8a"],
 " can enforce them. The fourth, the first Bianchi identity, is ",
 StyleBox["multi-term", "TI"],
 ": a sum of three permutations is zero, and no single ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Sigma]", ",", "\[Phi]"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9891d015-aa5a-4e8f-9bb5-2696bfff49f4"],
 " pair tells you that. Slot-permutation canonicalisation cannot reach it."
}], "Text",ExpressionUUID->"b43f54fb-bdf6-47ed-89ef-7c1f7f3ade7f"],

Cell[TextData[{
 "But all four constraints are the content of a single ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fc49b61f-4c81-4b45-97de-ed890655df37"],
 " irrep, the one labelled by the partition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0363fbff-5597-48eb-a54a-cb971e008156"],
 ". The Riemann tensor is ",
 StyleBox["literally", "TI"],
 " the projection of a generic rank-4 tensor onto this irrep. One ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "e3c64e50-773f-46bc-b7fa-7497f2fd9986"],
 " call enforces everything at once."
}], "Text",ExpressionUUID->"8e2c4253-95e1-49b7-a2d2-55f59a49c30a"],

Cell["\<\
The slot labelling matters here. The two columns of the diagram contain the \
two antisymmetric pairs, and the two rows contain the slots that get \
pair-swap symmetry. So we choose\
\>", "Text",ExpressionUUID->"cd2e98bd-1113-4ab9-9fbe-41cd6745eec0"],

Cell["\<\
+---+---+
| 1 | 3 |
+---+---+
| 2 | 4 |
+---+---+\
\>", "Program",ExpressionUUID->"563e5977-5f4f-49f7-a155-d01038ba2456"],

Cell[TextData[{
 "which is ",
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"7bf44ccf-5649-4511-933a-68e49697bdde"],
 ". Project a generic random tensor:"
}], "Text",ExpressionUUID->"8fa6e7cd-4281-42c1-90ea-e18a606acd3d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T0", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4", ",", " ", "4", ",", " ", "4"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T0", ",", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[27]:= ",ExpressionUUID->"03e2fc0c-59f3-490e-b998-c14714f2e02a"],

Cell["Check the four symmetries in turn.", "Text",ExpressionUUID->"6cd0b845-53a6-4d64-9c9f-5f73a6a4acf6"],

Cell[TextData[{
 "Antisymmetry in slots ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"22ad9748-43db-44ad-aadd-da68a32c8419"],
 ":"
}], "Text",ExpressionUUID->"0e304dfb-f3a4-4ea3-889d-3fb8c22b3ef2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"R", " ", "+", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"R", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "1", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
       "]"}]}], "]"}], "]"}], "]"}], " ", "<", " ", "tol"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[28]:= ",ExpressionUUID->"2d4cf072-3508-461d-ac47-37e644241f42"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[28]= ",ExpressionUUID->"5143e404-972d-400b-a4b2-33b51f8c1738"]
}, Open  ]],

Cell[TextData[{
 "Antisymmetry in slots ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"3", ",", "4"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cf59230e-62be-4484-adea-8dbbd078b495"],
 ":"
}], "Text",ExpressionUUID->"2353f171-cb77-49f0-9ea5-ada900516cc9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"R", " ", "+", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"R", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "4", ",", " ", "3"}], "}"}]}], 
       "]"}]}], "]"}], "]"}], "]"}], " ", "<", " ", "tol"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[29]:= ",ExpressionUUID->"60af6c87-a00c-4b9e-a6d1-f3ec51602254"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[29]= ",ExpressionUUID->"e28a1f47-4435-4136-aec8-959d33a4d08b"]
}, Open  ]],

Cell["Pair-swap symmetry:", "Text",ExpressionUUID->"19771fe3-518c-4091-99f8-420ea25499d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"R", " ", "-", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"R", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4", ",", " ", "1", ",", " ", "2"}], "}"}]}], 
       "]"}]}], "]"}], "]"}], "]"}], " ", "<", " ", "tol"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[30]:= ",ExpressionUUID->"f5a6f1a4-963d-476e-9bea-a1d7fa242ce6"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[30]= ",ExpressionUUID->"076a2d45-bd2d-456a-8462-4d4986d4bbe1"]
}, Open  ]],

Cell[TextData[{
 "First Bianchi identity. ",
 StyleBox["This is the constraint built-in WL canonicalisation cannot reach.",
   "TI"]
}], "Text",ExpressionUUID->"cf90cffa-c850-4399-a2e3-8df62ceea73f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", "\n", "    ", 
     RowBox[{"R", " ", "+", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"R", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "3", ",", " ", "4", ",", " ", "2"}], "}"}]}], 
       "]"}], " ", "+", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"R", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "4", ",", " ", "2", ",", " ", "3"}], "}"}]}], 
       "]"}]}], "\n", "]"}], "]"}], "]"}], " ", "<", " ", "tol"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[31]:= ",ExpressionUUID->"dcef5ff5-2714-4281-a7ef-ec55e665b3a6"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[31]= ",ExpressionUUID->"fa8735a0-3ad4-45fa-9a9b-d58f7cf31c3b"]
}, Open  ]],

Cell[TextData[{
 "All four hold, from one ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "823e0c2f-aeda-45a1-925c-69b3eff2eaca"],
 " call."
}], "Text",ExpressionUUID->"3a45bef1-1597-4279-bca9-582fd3de8c7c"],

Cell[TextData[{
 "The TN reward: once ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d96f8a4e-3abc-4f13-9b25-4316888cfed2"],
 " lives in the right irrep, downstream contractions preserve the structure \
for free. The Euclidean Ricci tensor is the partial trace ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"b", "d"}], "TI"]], "\[LongEqual]", 
    SuperscriptBox["\[Delta]", 
     StyleBox[
      RowBox[{"a", "c"}], "TI"]], 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"d2271f7e-5889-43fb-b175-26b5f5d66286"],
 ", which we write as ",
 Cell[BoxData[
  RowBox[{"TensorContract", "[", 
   RowBox[{"R", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"3bbbe640-2db7-4d98-aff6-1bdd102ceda4"],
 ". It comes out symmetric automatically:"
}], "Text",ExpressionUUID->"0a0f8014-942c-46d3-b992-a895fd799d29"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Ric", " ", "=", " ", 
   RowBox[{"TensorContract", "[", 
    RowBox[{"R", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Ric", " ", "-", " ", 
      RowBox[{"Transpose", "[", "Ric", "]"}]}], "]"}], "]"}], "]"}], " ", "<",
   " ", "tol"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[32]:= ",ExpressionUUID->"00d79830-b5b4-4cf9-ab1a-b04994e06da2"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[32]= ",ExpressionUUID->"835900bb-bc6e-46ca-9980-66c07508d9fe"]
}, Open  ]],

Cell["\<\
No separate re-symmetrisation step. The scalar curvature is the trace of the \
Ricci tensor:\
\>", "Text",ExpressionUUID->"7f3af0b1-fa42-46d8-a3d8-0a05e88e22fd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Tr", "[", "Ric", "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"a", " ", "scalar"}], ";", " ", 
    RowBox[{
    "here", " ", "approximately", " ", "1.18655", " ", "with", " ", "this", " ",
      "random", " ", "seed"}]}], " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[33]:= ",ExpressionUUID->"f7f0ed12-84e2-4936-a667-8c74ee2e6c76"],

Cell[BoxData["1.1865504865364562`"], "Output",
 CellLabel->
  "Out[33]= ",ExpressionUUID->"9eff86d4-bf7a-40e5-b8e8-c7bc0c458b7d"]
}, Open  ]],

Cell[TextData[{
 "If you wanted the Weyl tensor, you would project onto a ",
 StyleBox["different", "TI"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"919beb6e-0008-4f7b-872b-ff3d10df15be"],
 " irrep (the traceless subspace of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"89a7dfc2-4517-457f-b6b9-a8a877159821"],
 "), again with one ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "68f53ece-8066-4877-85da-6a2d60655d8c"],
 " call. The Symmetry sub-context is exactly the tool that puts rank-4 \
curvature tensors into a TN-clean form."
}], "Text",ExpressionUUID->"f2c7a699-17f7-4cba-b5c8-6e7226bbcdd1"],

Cell["4.3 A class-function Hamiltonian and content sums", "Section",ExpressionUUID->"9d45c01f-0d4e-41dd-b6cb-f600ab4eccfb"],

Cell[TextData[{
 "Pure ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"581b42ec-3be0-4036-b95d-d67c98a13381"],
 " values are useful, but the Symmetry sub-context can also pre-compute ",
 StyleBox["eigenvalues", "TI"],
 " of certain Hamiltonians without any diagonalisation. The relevant \
Hamiltonians are ",
 StyleBox["class functions", "TI"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d23b8989-642e-470e-a61d-30b82743aa78"],
 ": operators built from permutations whose value depends only on cycle \
structure. The classic example is the sum-of-all-pair-swaps"
}], "Text",ExpressionUUID->"bc77833f-f786-4fdc-aed4-59cfc115ebea"],

Cell[TextData[{
 "$",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "<", 
      StyleBox["j", "TI"]}],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f0f2f75a-a1fb-41a4-942e-593bdfbfc15d"],
 "$"
}], "Text",ExpressionUUID->"895ed67c-8c2a-4275-956a-e92a5a0bdf2f"],

Cell[TextData[{
 "acting on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cd030dda-26ae-448e-a3d8-fdb2e3d529bb"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e415f86d-dff3-4eee-bec6-328fa4566e74"],
 " is the swap of the ",
 Cell[BoxData[
  FormBox[
   StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ca25b144-d915-479c-b7b9-de9ff55c1578"],
 "th and ",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a531ce75-801a-4aad-8221-e50cd6f25660"],
 "th tensor factors. By Schur-Weyl, ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2c748914-bccc-405d-a776-b5ba8903b788"],
 " commutes with every isotypic projector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f160cdf0-6716-47aa-94e3-ccce14942a7e"],
 " and is therefore ",
 StyleBox["constant on each $\\lambda$-block", "TI"],
 ". The constant is the ",
 StyleBox["content sum", "TI"],
 " of the partition,"
}], "Text",ExpressionUUID->"52913281-18f6-4d42-83b1-1b3fd5833751"],

Cell[TextData[{
 "$",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], 
    RowBox[{"(", "\[Lambda]", ")"}], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        StyleBox["i", "TI"], ",", 
        StyleBox["j", "TI"]}], ")"}], "\[Element]", "\[Lambda]"}],
     LimitsPositioning->True], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["j", "TI"], "-", 
      StyleBox["i", "TI"]}], ")"}], ","}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a97337de-ed41-4499-8857-5f2946edb6a4"],
 "$"
}], "Text",ExpressionUUID->"88a03cf7-93bb-40e2-b74b-c7243406a771"],

Cell[TextData[{
 "a simple sum over diagram cells. For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"827ac3b0-7092-49e9-b34e-dd1b443e180a"],
 " the three partitions give ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], 
    RowBox[{"(", 
     RowBox[{"{", "3", "}"}], ")"}], "\[LongEqual]", "0", "+", "1", "+", "2", 
    "\[LongEqual]", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5fc6d4a2-4679-4363-b457-991b308ef00e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], 
    RowBox[{"(", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], ")"}], "\[LongEqual]", "0", "+", "1", "-",
     "1", "\[LongEqual]", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9da68248-9137-48f8-baf5-7033d33cca8c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], 
    RowBox[{"(", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}], ")"}], "\[LongEqual]", "0", "-",
     "1", "-", "2", "\[LongEqual]", 
    RowBox[{"-", "3"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d0ab5756-85c5-475e-9ed1-b890d9b47234"],
 ". Together with the block multiplicities from \[Section]4.1, ",
 StyleBox["this is the full spectrum of $H$ with multiplicities", "TI"],
 "."
}], "Text",ExpressionUUID->"507c553b-9056-4ca9-9138-57bbc4f12f82"],

Cell["Encode the content sum:", "Text",ExpressionUUID->"2b4a8024-51a5-4181-b026-1c68d3d3d282"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"contentSum", "[", "par_List", "]"}], " ", ":=", "\n", "    ", 
   RowBox[{"Total", " ", "@", " ", 
    RowBox[{"Flatten", " ", "@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"j", " ", "-", " ", "i"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "par", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", 
         RowBox[{"par", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[34]:= ",ExpressionUUID->"2a246a0d-1b6b-4e3c-b162-cf261e74db48"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2", ",", 
    StyleBox["n", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"cd5f6970-e852-4efb-9cec-51e4c619bd9d"],
 " the predicted spectrum is"
}], "Text",ExpressionUUID->"87f15e8d-df3b-4723-9318-767a85c7133c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"predicted", " ", "=", " ", 
  RowBox[{"Sort", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"Flatten", " ", "@", " ", 
     RowBox[{"{", "\n", "        ", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"contentSum", "[", 
          RowBox[{"{", "3", "}"}], "]"}], ",", "       ", 
         RowBox[{
          RowBox[{"TableauDimension", "[", 
           RowBox[{"{", "3", "}"}], "]"}], "       ", "*", " ", 
          RowBox[{"schurDim", "[", 
           RowBox[{
            RowBox[{"{", "3", "}"}], ",", " ", "2"}], "]"}]}]}], "]"}], ",", 
       "\n", "        ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"contentSum", "[", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], ",", "    ", 
         RowBox[{
          RowBox[{"TableauDimension", "[", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], "    ", "*", " ", 
          RowBox[{"schurDim", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", "2"}], "]"}]}]}], 
        "]"}], ",", "\n", "        ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"contentSum", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "]"}], ",", 
         " ", 
         RowBox[{
          RowBox[{"TableauDimension", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "]"}], " ", "*",
           " ", 
          RowBox[{"schurDim", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
            "2"}], "]"}]}]}], "]"}]}], "\n", "    ", "}"}]}], ",", "\n", 
    "    ", "Greater"}], "\n", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
    "3", ",", " ", "3", ",", " ", "3", ",", " ", "3", ",", " ", "0", ",", " ",
      "0", ",", " ", "0", ",", " ", "0"}], "}"}], " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[35]:= ",ExpressionUUID->"c517c54d-810b-4d76-a6f9-bf8fb7706bab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "3", ",", "3", ",", "3", ",", "3", ",", "0", ",", "0", ",", "0", ",", "0"}],
   "}"}]], "Output",
 CellLabel->
  "Out[35]= ",ExpressionUUID->"d6a0c16e-e960-42a3-986e-0b338923a111"]
}, Open  ]],

Cell[TextData[{
 "Four eigenvalues equal to ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4625c876-c392-440d-8804-18b637259dc3"],
 " in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "3", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d88e018a-28b8-4832-9214-cad076bf85c9"],
 " block (four-dimensional), four equal to ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "82e9af1e-e357-4654-979f-71a3bc35fa66"],
 " in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7c4f7cf8-04e8-44b7-b5d3-77026db7ff63"],
 " block (also four-dimensional), and zero copies of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c1badef2-c332-477a-b902-6b37c1f5fc40"],
 " because the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"109cba86-4652-4416-bfbf-623c6f5287b4"],
 " block is empty at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7fa57271-2fff-4d82-842b-33b66ecff578"],
 "."
}], "Text",ExpressionUUID->"32e672a5-acf8-4df2-aa5b-d4d3d111af64"],

Cell[TextData[{
 "Cross-check against an explicit matrix diagonalisation. Build ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d3a88def-cb35-4f27-8481-aaa88ba233e3"],
 " as an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Cross]", "8"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"23e3afe8-51e5-4afa-a538-ceffd4665553"],
 " matrix and call ",
 Cell[BoxData[
 "Eigenvalues"], "InlineFormula",ExpressionUUID->
  "509791e1-a18a-4c89-9509-838311ec942a"],
 ":"
}], "Text",ExpressionUUID->"664fa882-c70a-4471-b372-af01401e06fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"applySwap", "[", 
    RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"perm", " ", "=", " ", 
       RowBox[{"Range", "[", "3", "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"perm", "[", 
        RowBox[{"[", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], "]"}], " ", "=", " ", 
       RowBox[{"perm", "[", 
        RowBox[{"[", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", "a"}], "}"}], "]"}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"ArrayReshape", "[", "\n", "        ", 
       RowBox[{
        RowBox[{"Transpose", "[", "\n", "            ", 
         RowBox[{
          RowBox[{"Normal", " ", "@", " ", 
           RowBox[{"SparseArray", "[", "\n", "                ", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                   "i", ",", " ", "j", ",", " ", "k", ",", " ", "i", ",", " ",
                     "j", ",", " ", "k"}], "}"}], " ", "->", " ", "1"}], ",", 
                 "\n", "                    ", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", "2"}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", " ", "2"}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
               "2"}], "]"}], ",", "\n", "                ", 
             RowBox[{"{", 
              RowBox[{
              "2", ",", " ", "2", ",", " ", "2", ",", " ", "2", ",", " ", "2",
                ",", " ", "2"}], "}"}]}], "\n", "            ", "]"}]}], ",", 
          "\n", "            ", 
          RowBox[{"Join", "[", 
           RowBox[{"perm", ",", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "5", ",", " ", "6"}], "}"}]}], "]"}]}], 
         "\n", "        ", "]"}], ",", "\n", "        ", 
        RowBox[{"{", 
         RowBox[{"8", ",", " ", "8"}], "}"}]}], "\n", "    ", "]"}]}]}], "\n",
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Hmat", " ", "=", " ", 
   RowBox[{
    RowBox[{"applySwap", "[", 
     RowBox[{"1", ",", " ", "2"}], "]"}], " ", "+", " ", 
    RowBox[{"applySwap", "[", 
     RowBox[{"1", ",", " ", "3"}], "]"}], " ", "+", " ", 
    RowBox[{"applySwap", "[", 
     RowBox[{"2", ",", " ", "3"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spectrum", " ", "=", " ", 
   RowBox[{"Sort", "[", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", "Hmat", "]"}], ",", " ", "Greater"}], 
    "]"}]}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
    "3", ",", " ", "3", ",", " ", "3", ",", " ", "3", ",", " ", "0", ",", " ",
      "0", ",", " ", "0", ",", " ", "0"}], "}"}], " ", "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"spectrum", " ", "-", " ", "predicted"}], "]"}], "]"}], " ", "<", 
  " ", "tol"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", "True", " ", "*)"}]}]}], "Input",
 CellLabel->
  "In[36]:= ",ExpressionUUID->"d12bf41d-149e-4136-b129-2bc8b1414e0c"],

Cell[BoxData["True"], "Output",
 CellLabel->
  "Out[36]= ",ExpressionUUID->"45cb6384-e7aa-44bf-8417-a94410ab5bf4"]
}, Open  ]],

Cell[TextData[{
 "The two lists agree exactly. The numerical diagonalisation was a courtesy; \
the spectrum was already determined by the combinatorics of ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "dca374d6-0c74-4bd3-a9e8-1ff5fb5f48a6"],
 ", ",
 Cell[BoxData[
 "schurDim"], "InlineFormula",ExpressionUUID->
  "cfb58ea5-75c9-4687-85c0-28cebf0d6ff3"],
 " (powered by ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "de3f173f-6306-40d3-bd73-2672147b4ee2"],
 "), and ",
 Cell[BoxData[
 "contentSum"], "InlineFormula",ExpressionUUID->
  "bd047b41-9840-42f8-829b-c5cd7e97a23a"],
 "."
}], "Text",ExpressionUUID->"908fe971-710c-41fd-8a4a-1828c7d44501"],

Cell[TextData[{
 "This pattern is what makes the Symmetry sub-context interesting for TN \
simulation of permutation-invariant systems. Hamiltonians that are class \
functions of the permutation group on the sites (e.g. all-to-all exchange \
interactions, certain ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["J", "TI"], "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"242e3520-92af-41ec-837a-935deed745d1"],
 "-",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["J", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"317eea03-f7cc-4e35-82d2-992c2e921b06"],
 " symmetric models, collective spin models) have their entire spectrum \
determined by partitions of ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "549d2233-318d-46b5-99fa-5d7200ae303a"],
 " and block multiplicities. No exact diagonalisation, no Lanczos sweep, no \
SVD: just a sum over the rows of an ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{"IntegerPartitions", 
       RowBox[{"[", 
         StyleBox["n", "TI"], "]"}]}]},
    "Abs"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a7366bf1-2dff-4f90-807d-7d6dbdfbc355"],
 "-entry table."
}], "Text",ExpressionUUID->"9260d916-2d54-42eb-8cb2-5bb22f7f4290"],

Cell["5. Where this leaves us", "Title",ExpressionUUID->"4c9edc47-ad44-4629-b6e9-fb07cb36ab34"],

Cell[TextData[{
 "You have now used every function in the ",
 Cell[BoxData[
 "Wolfram"], "InlineFormula",ExpressionUUID->
  "a3551bd7-cd4c-45ca-94b9-dd16ea3f2a42"],
 "TensorNetworks",
 Cell[BoxData[
 "Symmetry"], "InlineFormula",ExpressionUUID->
  "6c7621e4-6891-40c5-817e-5a964fb20803"],
 "` sub-context at least once on a tensor with a physical reason to exist."
}], "Text",ExpressionUUID->"7f871481-84bc-4e80-a19c-edb3703ca313"],

Cell["Five concrete things you can now do:", "Text",ExpressionUUID->"bd296daf-45ac-49f8-bef8-e79e27398e8c"],

Cell[TextData[{
 "Decide, given a rank-",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "df818adb-4e8e-47bf-92d2-20741d34dcbd"],
 " tensor and a partition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[RightTee]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c6dd657f-9e55-4cdc-a2bd-f3317a0b2abe"],
 ", what the dimension of the corresponding block is: a single ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"TableauDimension", "[", "par", "]"}], " ", "*", " ", 
   RowBox[{"schurDim", "[", 
    RowBox[{"par", ",", " ", "d"}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "f4c8b2e5-cb22-412e-a241-165cb785e79a"],
 " call."
}], "Item",ExpressionUUID->"40775e1f-97a3-4e66-a625-dbc0a56faae2"],

Cell[TextData[{
 "Allocate a symmetry-resolved MPS / MPO with exact block sizes per sector, \
including correctly skipping sectors that vanish (the rank-3 fermionic sector \
at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e84f0098-890f-4301-a34d-178342d46870"],
 ", the rank-4 fully-antisymmetric sector at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LessEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"52916291-3487-43bf-9ea3-46299fc5d732"],
 ", and so on)."
}], "Item",ExpressionUUID->"ff018823-0513-46d2-b570-c10e128e9ba8"],

Cell[TextData[{
 "Enforce multi-term symmetry constraints (Riemann tensor, Weyl tensor, \
mixed-symmetry curvature objects, higher-spin gauge fields) with a single ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "7fd419a0-2dac-4e48-9e7e-1cfaf6ba3241"],
 " call."
}], "Item",ExpressionUUID->"df121fc6-67e3-4041-917c-5d02e02249f7"],

Cell["\<\
Cleanly project a bond onto a single statistics sector (boson, fermion, or \
mixed), and trust that downstream TN operations preserve it.\
\>", "Item",ExpressionUUID->"932bafa9-8f6d-4f9d-bf63-f90a07964ca5"],

Cell[TextData[{
 "For class-function Hamiltonians, read off the entire spectrum from ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "ef8a93b0-a2a2-4e57-be37-3b11515d9e68"],
 ", ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "b6497b73-bd37-4744-87c0-fae938bb2960"],
 ", and ",
 Cell[BoxData[
 "contentSum"], "InlineFormula",ExpressionUUID->
  "697cf38d-d600-473f-912b-61ad47a259d3"],
 " without any numerical diagonalisation."
}], "Item",ExpressionUUID->"91a011a3-36b8-4830-9813-5216a54bdaa3"],

Cell["Three traps worth flagging:", "Text",ExpressionUUID->"aa37d969-13e0-42eb-af80-b27b151f2e22"],

Cell[TextData[{
 Cell[BoxData[
 "YoungSymmetrize"], "InlineFormula",ExpressionUUID->
  "dd3247cc-eb1a-4212-8f66-1d906108c572"],
 " returns the ",
 StyleBox["unnormalised", "TI"],
 " symmetriser ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9b57403d-0691-457c-a51a-3beded78f264"],
 "; if you want a projector (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["P", "TI"], "2"], "\[LongEqual]", 
    StyleBox["P", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8d8e2730-175e-4fb8-9dc1-81e69f8f7515"],
 "), call ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "e394c1a7-b753-4cf7-aaf7-1cb0f589dee9"],
 ". Iterative TN algorithms need the idempotent."
}], "Item",ExpressionUUID->"aa36b11e-f023-4603-9239-346186aea805"],

Cell[TextData[{
 "The Young symmetriser is applied as \"rows first, columns second\": row \
symmetry can be broken by the subsequent column antisymmetrisation. For \
non-trivial mixed-symmetry diagrams (anything other than fully-row or \
fully-column), the ",
 StyleBox["first", "TI"],
 " symmetry imposed is not generally preserved."
}], "Item",ExpressionUUID->"78c213af-f3a3-43db-b91e-131cb6a91092"],

Cell[TextData[{
 "The closed-form block sizes from ",
 Cell[BoxData[
  RowBox[{"TableauDimension", " ", "*", " ", "schurDim"}]], "InlineFormula",
  ExpressionUUID->"b9d4f2e8-6004-4bf5-aa44-0e43e63ce77e"],
 " are exact; the explicit projector ranks measured by ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "1b1fe77d-a6f4-4434-b6c3-d5535cfde02f"],
 " agree with them up to floating-point precision. In production code, prefer \
the closed-form prediction."
}], "Item",ExpressionUUID->"12de32ad-ebaf-486e-9071-0a8d50efcb23"],

