Cell[TextData[{
 "The construction generalises to higher ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "841eafdb-ddd9-4536-aa26-b8ff77db335b"],
 " and is the foundation of symmetry-resolved DMRG / TDVP: every bond carries \
an exact decomposition by partition ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "435f612b-cf78-46a2-a344-d86230bbad98"],
 " and the block dimensions are read off in closed form."
}], "Text",ExpressionUUID->"ffc385ef-2599-4d5b-aba4-f84f3f9dc50a"],

Cell[TextData[{
 "Measure the decomposition explicitly, projector by projector. For each ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[Lambda]", " ", "\[ThinSpace]", " ", ":", " ", "\[ThinSpace]", " ", 
    "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1efb7f15-bcf2-4f85-8bef-7acc3489053e"],
 ", the isotypic projector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e3271158-cc53-4652-9f56-952ba7275ea3"],
 " on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{"\[TensorProduct]", " ", "3"}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c89a6860-43bf-49e8-8f37-15daf34b8a67"],
 " is the sum of single-tableau Young projectors over the standard tableaux \
of shape ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8e192bfe-daa4-4e6c-a831-6032a45928f7"],
 ". There is one of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "3", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"01bc6655-b4a2-4122-bd6a-c8be820d9619"],
 " (namely ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "{", " ", "1", ",", "2", ",", "3", " ", "}", " ", "}"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "85f9f4d0-7bd9-4ac8-a912-d0fab15e4f02"],
 "), two of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"00dcdf36-dcdb-4e34-81af-e5c0c6633e6e"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "{", " ", "{", " ", "1", ",", "2", " ", "}", ",", "{", " ", "3", " ", "}", 
    " ", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8dbabb82-8fd4-4c93-84f2-80c5de5cd3ff"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "{", " ", "{", " ", "1", ",", "3", " ", "}", ",", "{", " ", "2", " ", "}", 
    " ", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "aa1c2fa4-e096-4157-8505-a5b942ecde9b"],
 ", matching ",
 StyleBox["TableauDimension[{2, 1}] = 2", "Code"],
 "), and one of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"88da49b1-7262-4062-9879-74d7cd03578c"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "{", " ", "{", " ", "1", " ", "}", ",", "{", " ", "2", " ", "}", ",", "{", 
    " ", "3", " ", "}", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9e071205-4a81-4625-bc31-db89523065b2"],
 ")."
}], "Text",ExpressionUUID->"e467cdb2-0f17-432e-8aa9-6286344ae9b5"],

Cell[TextData[{
 "Build a random rank-3 tensor in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dacdbd45-f26a-4ce1-9e0e-c074941900fa"],
 "."
}], "Text",ExpressionUUID->"a5714a16-33b0-4a19-8d08-710199b4140d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T3", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[133]:=",ExpressionUUID->"44dc4df6-4a75-47a2-ba8e-bb0057cdf6b8"],

Cell[TextData[{
 "Project onto the fully symmetric block (one standard tableau of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "3", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"49aa781b-3110-4efe-8eb1-330162d6e0b2"],
 ")."
}], "Text",ExpressionUUID->"f3b44c2d-f201-42e4-9c07-fb9d42ec5a95"],

Cell[BoxData[
 RowBox[{
  RowBox[{"e3", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T3", ",", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "}"}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[135]:=",ExpressionUUID->"a02adc60-e432-4b2a-9d03-26a28e64eca5"],

Cell[TextData[{
 "Project onto the mixed-symmetry block (sum over the two standard tableaux \
of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"58184e25-fd76-40b4-90c8-4bf1e03553ae"],
 ")."
}], "Text",ExpressionUUID->"bce530d7-1039-4df5-9ceb-5a23be062446"],

Cell[BoxData[
 RowBox[{
  RowBox[{"e21", " ", "=", " ", 
   RowBox[{
    RowBox[{"YoungProject", "[", 
     RowBox[{"T3", ",", " ", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", "3", "}"}]}], "}"}], "]"}]}], "]"}], " ", "+", "\n", 
    "      ", 
    RowBox[{"YoungProject", "[", 
     RowBox[{"T3", ",", " ", 
      RowBox[{"YoungTableau", "[", 
