Cell[TextData[{
 "The first cross-shape block, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr", "MR"], "(", 
    SubscriptBox["M", 
     RowBox[{"1", ",", "{", " ", "2", " ", "}"}]], "\[CenterDot]", 
    SubscriptBox["M", 
     RowBox[{"2", ",", "{", " ", "1", ",", "1", " ", "}"}]], ")"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "357b61e7-f7df-4406-ae4e-f14ee73c9ce5"],
 ", vanishes."
}], "Text",ExpressionUUID->"6242058f-0924-4779-bb1f-57d7039c877e"],

