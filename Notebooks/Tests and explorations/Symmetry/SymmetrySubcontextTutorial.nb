   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988820412423274*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"f86b22e6-dedb-45d6-a18c-f23121f9a2df"]
}, Open  ]],

Cell[TextData[{
 "Project ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "y"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f110ea4a-0bfa-4d35-ad0a-2cfa138dcfdc"],
 " onto the antisymmetric shape; the result is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "y"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"96396a4a-532f-43a3-9915-84e65aebef1f"],
 " itself."
}], "Text",ExpressionUUID->"436cc36a-7101-4ed6-be39-2265f46fc671"],

