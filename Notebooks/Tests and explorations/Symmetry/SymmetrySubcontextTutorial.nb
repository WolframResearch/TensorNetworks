         RowBox[{"{", "2", "}"}]}], "}"}], "]"}]}], "]"}]}]}], ";"}]], "Input",\

 CellLabel->
  "In[136]:=",ExpressionUUID->"ba9e3b7b-a102-4016-948c-c52628e3ed30"],

Cell[TextData[{
 "Project onto the fully antisymmetric block (one standard tableau of shape \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"4e476dc9-eb7e-45bd-8261-1c8613eb0937"],
 ")."
}], "Text",ExpressionUUID->"3cf99e80-fee4-4911-92f1-03d55b0fa01a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"e111", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T3", ",", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "1", "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}], ",", " ", 
        RowBox[{"{", "3", "}"}]}], "}"}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
