Cell[TextData[{
 "The two spectra match to machine precision, and the combinatorial path \
finishes in sub-millisecond time while the dense diagonalisation takes orders \
of magnitude longer. The gap widens with ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "932e085b-3b6e-4fbd-833a-2a6324eba3c2"],
 " and ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6158f325-f085-425e-96af-53585b6c9ba4"],
 ", because the combinatorial cost is set by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "(", "n", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e3547125-465a-43dd-b36c-ec4831704ef4"],
 " partitions while the diagonalisation cost scales with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["d", "n"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2acdecc8-11c8-420d-92b1-b74098b6c842"],
 "."
}], "Text",ExpressionUUID->"68a9be6d-7843-462e-826f-a4ea5fff2317"],

Cell[TextData[{
 "This is the payoff for permutation-invariant systems. Hamiltonians that are \
class functions of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a3189f56-6b8e-4ee4-8d28-d9e5b85b9172"],
 " on the sites (all-to-all exchange, certain ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["J", "1"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d8b7195d-c01e-4497-9b74-cb957b656634"],
 "-",
 Cell[BoxData[
  FormBox[
   SubscriptBox["J", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9e0655d7-04c6-49db-b56d-277beffe2a2d"],
 " symmetric models, collective spin models) have their full spectrum \
determined by partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "466a7afb-5843-407f-80f5-0393b01c21cc"],
 " and block multiplicities. No exact diagonalisation, no Lanczos sweep, no \
SVD: a single sum over an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[VerticalSeparator]", 
    StyleBox["IntegerPartitions", "MR"], "[", "n", "]", 
    "\[VerticalSeparator]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"20ed9444-c7a1-4088-b024-832a04d5b91c"],
 "-entry table delivers every eigenvalue with multiplicity."
}], "Text",ExpressionUUID->"63ae644f-8aaa-4cfe-8584-b77e545c71c4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Where this leaves us", "Chapter",ExpressionUUID->"2be054ec-805b-4866-830b-00454388748a"],

Cell[TextData[{
 "Every Symmetry function in ",
 StyleBox["Wolfram`TensorNetworks`Symmetry`", "Code"],
 " has appeared at least once on a tensor with a physical reason to exist. \
Five operational capabilities follow:"
}], "Text",ExpressionUUID->"94d5512e-d285-449e-a45c-253c155b8419"],

Cell[TextData[{
 "- ",
 StyleBox["Block-size prediction.",
  FontWeight->"Bold"],
 " For a rank-",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c28fec9c-6fff-46a2-a10e-e0cd085b3cd7"],
 " tensor and partition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[Lambda]", " ", "\[ThinSpace]", " ", ":", " ", "\[ThinSpace]", " ", 
    "n"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5150acac-05bc-4b21-9a1f-ca4b9ce593e9"],
 ", read the size of the ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4673a6c9-de59-465d-bd39-f13032801590"],
 "-isotypic block at any bond dimension ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b505dc56-be1e-43da-8570-ac1f1ca63dc3"],
 " from ",
 StyleBox["TableauDimension[par] * SchurDimension[par, d]", "Code"],
 ", and identify sectors that vanish identically (rank-3 fermionic at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fdca3fa1-00b1-42ef-88fc-7201df0206dd"],
 ", rank-4 fully antisymmetric at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", " ", "\[LessEqual]", " ", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"85079f8c-6264-4620-bf74-af03be655186"],
 ", etc.). Demonstrated in the rank-3 Schur-Weyl table and the rank-4 \
enumeration. - ",
 StyleBox["Multi-term symmetry projection.",
  FontWeight->"Bold"],
 " Enforce all classical Riemann symmetries (the three pair relations plus \
the multi-term first Bianchi identity) with a single ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5e0c9c0c-256a-4cb5-979c-2cc70f94e783"],
 " onto the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"3b6fadaa-5c40-4535-beb3-d3d36bffc644"],
 " tableau, where built-in ",
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e00ec3dc-3b07-4c2c-a352-643cfcb4ac5b"],
 " reaches only the mono-term subset. Demonstrated in the Riemann section, \
which also derives those identities by searching the right-annihilator of ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6d757301-4a72-44b1-815c-2465fca67c0f"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleStruckCapitalC]", "[", 
    SubscriptBox["S", "4"], "]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ea563b60-19ff-4b08-8e6b-521b3d5dd9ce"],
 ". - ",
 StyleBox["Statistics-sector projection that survives contraction.",
  FontWeight->"Bold"],
 " Project a TN bond onto a chosen statistics sector (boson, fermion, or \
mixed); built-in ",
 Cell[BoxData[
  TemplateBox[{"TensorContract", "paclet:ref/TensorContract"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dce3be64-2332-45f5-8c4a-ebfd15bbc0bc"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"Dot", "paclet:ref/Dot"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "66877515-3aa4-45d0-a4bf-4df330219721"],
 " preserve the sector automatically downstream. Demonstrated on the \
fermionic bond and the Ricci partial trace. - ",
 StyleBox["Block-sparse contraction.",
  FontWeight->"Bold"],
 " Replace a dense ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["d", "n"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"adf4bd67-4407-48c3-bc2e-990260a94378"],
 "-element bond contraction by the sum of within-sector contractions over the \
irreducible-representation blocks; cross-sector products are zero by Schur \
orthogonality. Demonstrated at rank 2 (block-sparse trace), rank 3 \
(block-sparse Frobenius), and rank 4 (the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"5", "\[Times]", "5"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e042e838-d387-4cc7-a279-e74caeecb7d2"],
 " same-sector-only diagonal; ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6.4", "\[Times]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"40caba36-3506-483e-a32c-f8cad99d9894"],
 " FLOP saving with one Riemann-like tensor). - ",
 StyleBox["Class-function Hamiltonian spectrum from combinatorics.",
  FontWeight->"Bold"],
 " For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", "=", 
    UnderscriptBox["\[Sum]", 
     RowBox[{"i", "<", "j"}]], " ", 
    SubscriptBox["P", 
     RowBox[{"i", "\[NoBreak]", "j"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5c6b4c89-aa95-4b95-873f-3f7736bc481d"],
 ", every eigenvalue with multiplicity follows from ",
 Cell[BoxData[
  TemplateBox[{
   "TableauDimension", "paclet:Wolfram/TensorNetworks/ref/TableauDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "bde92df8-311c-4b0f-9b5c-2dde54d8a800"],
 ", ",
 Cell[BoxData[
  TemplateBox[{"HookLengths", "paclet:Wolfram/TensorNetworks/ref/HookLengths"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "15512239-2f2d-4f08-b34b-58471351b820"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
   "SchurDimension", "paclet:Wolfram/TensorNetworks/ref/SchurDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "237170c5-2e5c-469b-a5a4-440f99b3e71d"],
 ", and a one-line ",
 StyleBox["contentSum", "Code"],
 " helper, with no diagonalisation. The class-function H section measures \
both paths, with the combinatorial path orders of magnitude faster at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "6", ",", "d", "=", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"78d9297f-6911-441e-b881-2b840ed13761"],
 "."
}], "Text",ExpressionUUID->"d9658e99-7bf2-43a1-a524-0d67557c276f"],

Cell["Three traps worth flagging:", "Text",ExpressionUUID->"41d537a5-2776-4f78-816f-9661544843b9"],

Cell[TextData[{
 "- ",
 Cell[BoxData[
  TemplateBox[{
   "YoungSymmetrize", "paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "598067ce-b244-4921-9af0-c3e15993d52a"],
 " returns the ",
 StyleBox["unnormalised",
  FontSlant->"Italic"],
 " symmetriser ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "T"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fb3d2996-8e6e-48d4-aa84-649d73ae878e"],
 "; for a projector (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["P", "2"], "=", "P"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"381b2c58-826d-44ab-a6e5-08c80bddb748"],
 ") call ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9eb03158-5400-4803-aa6c-72ad509b0762"],
 ". Iterative TN algorithms need the idempotent. - The Young symmetriser is \
applied rows-first, columns-second: row symmetry can be broken by the \
subsequent column antisymmetrisation. For mixed-symmetry diagrams (anything \
other than fully-row or fully-column) the first symmetry imposed is not \
generally preserved. - The validator is strict: tableau slot labels must be a \
permutation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", "n"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"1bd0dfd6-0b71-48e7-9d36-95f57082d45b"],
 ". Distinct positive integers outside that range (e.g. ",
 StyleBox["{{3, 5, 7}, {1, 2}}", "Code"],
 ") are rejected."
}], "Text",ExpressionUUID->"e1321edd-3d65-4a25-a27e-e2287408933b"],

