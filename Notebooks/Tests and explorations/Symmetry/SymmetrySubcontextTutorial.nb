Cell[TextData[{
 "The sum of squared dimensions equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[VerticalSeparator]", 
    SubscriptBox["S", "3"], "\[VerticalSeparator]", "=", "6"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "88237bd6-25f4-48c8-b2fb-c45067344df5"],
 " (the Plancherel identity)."
}], "Text",ExpressionUUID->"d56ac588-06f4-481d-b3da-926beec92071"],

