 CellLabel->
  "In[143]:=",ExpressionUUID->"81236e75-8dd3-4af5-8324-0c0db5a98015"],

Cell["Project onto the fully antisymmetric block.", "Text",ExpressionUUID->"5d33d35d-c00a-40e6-86b6-4d87063a1652"],

