Cell["\<\
The tutorial is structured around two physical settings that together bring \
every function into play:\
\>", "Text",ExpressionUUID->"a1989b74-956b-44f2-ae89-8a00e4df9e17"],

Cell[TextData[{
 "1. ",
 StyleBox["Familiar rank-2 tensors and their TN-bond payoffs",
  FontWeight->"Bold"],
 " introduces ",
 Cell[BoxData[
  TemplateBox[{
   "YoungTableau", "paclet:Wolfram/TensorNetworks/ref/YoungTableau"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "210439e6-1867-49b4-89e6-8f2af8a8503a"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
   "YoungTableauQ", "paclet:Wolfram/TensorNetworks/ref/YoungTableauQ"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "87b738e6-64d1-43f4-9973-e19c019321d8"],
 ", the four accessors (",
 Cell[BoxData[
  TemplateBox[{
   "TableauShape", "paclet:Wolfram/TensorNetworks/ref/TableauShape"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c1f92da9-bbed-48c9-ba8d-4042788f7e55"],
 ", ",
 Cell[BoxData[
  TemplateBox[{"TableauSize", "paclet:Wolfram/TensorNetworks/ref/TableauSize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dc2da7c6-7e34-491c-8cff-5c52c2277076"],
 ", ",
 Cell[BoxData[
  TemplateBox[{"TableauRows", "paclet:Wolfram/TensorNetworks/ref/TableauRows"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "047d5a34-fc5e-4a79-9fb3-b5f6c5ad17e6"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
   "TableauColumns", "paclet:Wolfram/TensorNetworks/ref/TableauColumns"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "88931034-f28d-4c5e-851a-24282eab7948"],
 "), ",
 Cell[BoxData[
  TemplateBox[{
   "YoungSymmetrize", "paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "eccfd1fe-2f8b-4cea-9fde-3e9f906c86d9"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "83aa54ed-f546-4de7-8bf7-e72102581136"],
 " through symmetric / antisymmetric matrices from physics (metric, Pauli, EM \
tensor, ...) and operational TN constructs (singlet/triplet decomposition, \
SWAP-gate eigenspace, fermionic bond), closing with a block-sparse trace \
identity on a rank-2 bond. 2. ",
 StyleBox["Beyond rank 2: three higher-rank payoffs",
  FontWeight->"Bold"],
 " introduces ",
 Cell[BoxData[
  TemplateBox[{"PartitionQ", "paclet:Wolfram/TensorNetworks/ref/PartitionQ"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "651aea9b-3c83-4f4c-9658-0324b8ed0fdd"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
   "TransposePartition", 
    "paclet:Wolfram/TensorNetworks/ref/TransposePartition"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9ae22492-b22e-42a2-b157-4f19a002fadb"],
 ", ",
 Cell[BoxData[
  TemplateBox[{"HookLength", "paclet:Wolfram/TensorNetworks/ref/HookLength"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "41bd33a4-6ef9-4f7a-bd13-c48e6b603b64"],
 ", ",
 Cell[BoxData[
  TemplateBox[{"HookLengths", "paclet:Wolfram/TensorNetworks/ref/HookLengths"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "acd72440-1952-4c5a-b46f-8ba76fea895e"],
 ", ",
 Cell[BoxData[
  TemplateBox[{"HookFactor", "paclet:Wolfram/TensorNetworks/ref/HookFactor"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "3cc39710-e7ef-4087-a911-f5901aa9006b"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
   "TableauDimension", "paclet:Wolfram/TensorNetworks/ref/TableauDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "6bea70ca-ba2d-443c-88c2-5d768a5bad74"],
 " through three larger examples: the Schur-Weyl block decomposition on three \
sites (with a block-sparse Frobenius contraction), the Riemann curvature \
tensor as a rank-4 TN node (with multi-term algebraic identities derived from \
the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f7699a66-4d2e-4ca7-aebf-aa3e74ffa057"],
 " projector, including the first Bianchi identity), and the spectrum of a \
class-function Hamiltonian via content sums."
}], "Text",ExpressionUUID->"80296a99-05b3-48c2-8a1f-95de9d7cd8d9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Where the Symmetry functions sit in WL's tensor stack", "Section",ExpressionUUID->"92beef96-05dc-4599-862e-97bfba6328b8"],

Cell[TextData[{
 "Before any code, fix the structural relationship between the Symmetry \
functions and built-in Wolfram Language tensor symmetry. Built-in WL (since \
9.0) ships a complete language for ",
 StyleBox["mono-term",
  FontSlant->"Italic"],
 " symmetries: relations of the form"
}], "Text",ExpressionUUID->"e508d1d1-8cfb-4266-957a-f642dc60ba29"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"\[Phi]", " ", "\[ThinSpace]", " ", 
   StyleBox["TensorTranspose", "MR"], "[", "T", ",", "\[Sigma]", "]", 
   "\[MediumSpace]", "=", "\[MediumSpace]", " ", "T"}], 
  TraditionalForm]],ExpressionUUID->"bc9e47fb-63e4-4d73-b928-f225da6b3d46"]], \
"Text",ExpressionUUID->"5525991c-e7c0-49f9-91db-07fb8bd8961c"],

Cell[TextData[{
 "for one permutation ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "89a6f00e-19d8-43bc-9a0e-eb856c25c596"],
 " and one root of unity ",
 Cell[BoxData[
  FormBox["\[Phi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f1e03b00-d634-46e7-a3ed-b0c5e9eb8cf9"],
 ". The kernel surface for these is"
}], "Text",ExpressionUUID->"feda6ce1-5958-4f0d-969a-be78113db8fd"],

Cell[TextData[{
 "- named heads ",
 StyleBox["Symmetric[{slots}]", "Code"],
 ", ",
 StyleBox["Antisymmetric[{slots}]", "Code"],
 ", ",
 StyleBox["Hermitian[{1,2}]", "Code"],
 ", ",
 StyleBox["Antihermitian[{1,2}]", "Code"],
 ", ",
 StyleBox["ZeroSymmetric[{slots}]", "Code"],
 ", - generic generators as lists ",
 StyleBox["{ {Cycles[...], phase}, ... }", "Code"],
 ", - the projector ",
 StyleBox["Symmetrize[T, sym]", "Code"],
 " (group-averaging; the idempotent normalised form), - the analyser ",
 StyleBox["TensorSymmetry[T]", "Code"],
 ", - the compressed-storage type ",
 StyleBox["SymmetrizedArray[rules, dims, sym]", "Code"],
 ", - the assumption-layer envelopes ",
 StyleBox["Arrays[...]", "Code"],
 " / ",
 StyleBox["Matrices[...]", "Code"],
 " / ",
 StyleBox["Vectors[...]", "Code"],
 " that drive ",
 Cell[BoxData[
  TemplateBox[{"TensorReduce", "paclet:ref/TensorReduce"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dc42bc55-de14-4935-92d2-ab6405cbc3ba"],
 " / ",
 Cell[BoxData[
  TemplateBox[{"TensorExpand", "paclet:ref/TensorExpand"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2395881b-0d00-41dd-bc9e-a5f03ff4a8ac"],
 "."
}], "Text",ExpressionUUID->"a15d67bb-beb5-46c7-8e53-7af918883546"],

Cell[TextData[{
 "This is everything you need to declare \"this tensor is symmetric in slots \
1, 2\", \"this matrix is Hermitian\", \"this rank-4 tensor antisymmetrises in \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "1", ",", "2", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9f1925d3-a66d-448f-b4e8-c19ca1de62cd"],
 " and in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "3", ",", "4", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4610093a-d00f-42c1-a2f8-f585f7465793"],
 " and is invariant under swapping the pairs\". It is not enough to declare \
\"",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"a", " ", "b", " ", "c", " ", "d"}]], "+", 
    SubscriptBox["R", 
     RowBox[{"a", " ", "c", " ", "d", " ", "b"}]], "+", 
    SubscriptBox["R", 
     RowBox[{"a", " ", "d", " ", "b", " ", "c"}]], "=", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d7bac463-577c-4cbc-af11-985a19965dba"],
 "\": that is a ",
 StyleBox["multi-term",
  FontSlant->"Italic"],
 " relation (three permuted copies summing to zero) and lies outside the \
mono-term language. The same gap is what blocks Young projection onto a \
mixed-symmetry irreducible representation: those projectors are \
sums-with-signs over the group on each row and each column of a Young \
diagram, and the image is defined by satisfying ",
 StyleBox["several",
  FontSlant->"Italic"],
 " permutation relations together, not one."
}], "Text",ExpressionUUID->"b5a374fd-4784-4098-884f-4b9fd9b49940"],

Cell[TextData[{
 "The Symmetry functions in ",
 StyleBox["Wolfram`TensorNetworks`Symmetry`", "Code"],
 " fill exactly this gap. Its ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f8cf809b-e949-4db7-b0b5-f09497833b3b"],
 " produces tensors that lie in ",
 StyleBox["one ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "47129bee-6e57-4dc7-9bd2-7629e3572c27"],
 StyleBox[" irreducible representation",
  FontSlant->"Italic"],
 ", a condition that always implies extra multi-term identities. The Riemann \
curvature tensor is the canonical example: living in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ebde7a15-868d-42f7-a6f5-fd49ca1ac0aa"],
 " irreducible representation simultaneously satisfies pair-antisymmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"a", " ", "b", " ", "c", " ", "d"}]], "=", "-", 
    SubscriptBox["R", 
     RowBox[{"b", " ", "a", " ", "c", " ", "d"}]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6102ed7a-8662-4b24-956c-3a527c3ba56d"],
 ", pair-antisymmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"a", " ", "b", " ", "c", " ", "d"}]], "=", "-", 
    SubscriptBox["R", 
     RowBox[{"a", " ", "b", " ", "d", " ", "c"}]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"949d1a47-0fdc-49ff-a3e9-ad12fc6a97db"],
 ", pair-swap ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"a", " ", "b", " ", "c", " ", "d"}]], "=", 
    SubscriptBox["R", 
     RowBox[{"c", " ", "d", " ", "a", " ", "b"}]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"688fd2a9-5823-478c-9d28-96328d88cb05"],
 ", ",
 StyleBox["and",
  FontSlant->"Italic"],
 " the algebraic first Bianchi identity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"a", " ", "b", " ", "c", " ", "d"}]], "+", 
    SubscriptBox["R", 
     RowBox[{"a", " ", "c", " ", "d", " ", "b"}]], "+", 
    SubscriptBox["R", 
     RowBox[{"a", " ", "d", " ", "b", " ", "c"}]], "=", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e4259df9-a2eb-4cd2-b5f4-334804b5aaf0"],
 ". The three pair conditions are mono-term and reachable by built-in ",
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7e18ac36-a799-46e6-9096-c03ec3632472"],
 "; the Bianchi identity is multi-term and is not."
}], "Text",ExpressionUUID->"e684a270-0dae-4cb5-aa9b-27c4a7fb272f"],

Cell[TextData[{
 "The Riemann-tensor example later in the tutorial makes this concrete: \
built-in ",
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b07fdf67-29ef-487a-b888-aea327d3d59b"],
 " with the three Riemann pair generators leaves a finite Bianchi residual, \
while ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "22b87fd5-f361-4a84-b707-85c19d1ab8cb"],
 " zeroes it. The map between the two layers:"
}], "Text",ExpressionUUID->"dbe014d5-29c3-48e3-8832-f090256e93dc"],

Cell[BoxData[GridBox[{
   {Cell["Operation", "Text",ExpressionUUID->
     "c187f99b-6466-4bee-bc68-dfe01546b3c1"], Cell[
    "Built-in WL", "Text",ExpressionUUID->
     "24cf72f3-e31b-49fd-a4a1-d6f58bf7e4b5"], Cell[
    "Symmetry functions", "Text",ExpressionUUID->
     "9dcb2d07-15a4-4926-87f6-4b0083d99345"]},
   {Cell["Mono-term symmetrise (boson, fermion, Riemann pair)", "Text",
     ExpressionUUID->"ac28a716-e42d-4d18-b3a5-46efc7a8ee31"], Cell[TextData[
    StyleBox["Symmetrize[T, sym]", "Code"]], "Text",ExpressionUUID->
     "2830d2ec-9386-4160-876d-5bae2bd91080"], Cell[
    "(wrapped by the Symmetry functions)", "Text",ExpressionUUID->
     "23a4286b-e430-418f-9f67-1d7af4c91705"]},
   {Cell["Detect mono-term symmetry group", "Text",ExpressionUUID->
     "3f88be00-5e2d-4fb4-b822-7f9ca0dc4c9b"], Cell[TextData[StyleBox[
    "TensorSymmetry[T]", "Code"]], "Text",ExpressionUUID->
     "863fe42e-d7df-4f16-bf82-eda4a672baa1"], Cell[
    "(no analogue)", "Text",ExpressionUUID->
     "d8577337-c4bf-43d9-abcb-2de620a835dd"]},
   {Cell["Compressed storage by orbit", "Text",ExpressionUUID->
     "15342ca0-9fb0-4fed-b2b6-dc64d39ebf4f"], Cell[TextData[Cell[BoxData[
     TemplateBox[{"SymmetrizedArray", "paclet:ref/SymmetrizedArray"},
      "RefLink"]], "Text",
     FontFamily->"Source Sans Pro",ExpressionUUID->
     "82f4fa46-812b-44a0-935b-312c636792f2"]], "Text",ExpressionUUID->
     "b0d4c546-a87a-42b9-bcf3-cfacd16d5cee"], Cell[TextData[{
     "(no analogue; the Symmetry functions emit dense / ",
     Cell[BoxData[
      TemplateBox[{"Normal", "paclet:ref/Normal"},
       "RefLink"]], "Text",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "62b93c5b-247b-4aaa-919a-cef499e63b99"],
     ")"
    }], "Text",ExpressionUUID->"9034dfde-460f-4978-aff9-d8e1f3fb75d6"]},
   {Cell["Single-tableau / mixed-symmetry projection (multi-term)", "Text",
     ExpressionUUID->"faf46a1f-b6ee-489c-a919-d90e0e0e33b1"], Cell[
    "(not supported)", "Text",ExpressionUUID->
     "fca9aea5-918e-44a1-a641-152b269c5b5c"], Cell[TextData[StyleBox[
    "YoungProject[T, tab]", "Code"]], "Text",ExpressionUUID->
     "1d16fb5c-f16f-4823-9565-3a022d1b7c79"]},
   {Cell[TextData[{
     "Irreducible representation dimension ",
     Cell[BoxData[
      FormBox[
       RowBox[{"dim", " ", 
        SubscriptBox["V", "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
      ExpressionUUID->"7e3eff95-b2c2-4a85-944d-6d3e87460fd3"],
     " via hook formula"
    }], "Text",ExpressionUUID->"3a976f1a-4bdc-4750-89be-099c06fa7191"], Cell[
    "(not supported)", "Text",ExpressionUUID->
     "934918fc-a4c3-4ed3-b50b-77a47dacc9d5"], Cell[TextData[StyleBox[
    "TableauDimension[par]", "Code"]], "Text",ExpressionUUID->
     "a5cc5ebc-65d6-44f8-ae12-3f5dc150fb17"]},
   {Cell[TextData[{
     "Hook lengths for ",
     Cell[BoxData[
      FormBox[
       SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",
      ExpressionUUID->"997c1e0c-fd96-465e-85a2-c36955c32c05"],
     " representation theory"
    }], "Text",ExpressionUUID->"bc39eaf5-034b-45d1-88d4-3385473b8484"], Cell[
    "(not supported)", "Text",ExpressionUUID->
     "c06fb1ec-12b4-48ce-afe9-23b1fd645e7a"], Cell[TextData[{
     Cell[BoxData[
      TemplateBox[{
       "HookLength", "paclet:Wolfram/TensorNetworks/ref/HookLength"},
       "RefLink"]], "Text",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "a3b29994-5867-4079-8d4a-1ce4bb8a2c8e"],
     ", ",
     Cell[BoxData[
      TemplateBox[{
       "HookLengths", "paclet:Wolfram/TensorNetworks/ref/HookLengths"},
       "RefLink"]], "Text",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "e5ae4509-7468-4480-9a60-2a8c45787792"],
     ", ",
     Cell[BoxData[
      TemplateBox[{
       "HookFactor", "paclet:Wolfram/TensorNetworks/ref/HookFactor"},
       "RefLink"]], "Text",
      FontFamily->"Source Sans Pro",ExpressionUUID->
      "3d69af5e-07ba-4aac-88cb-e1ab5c487102"]
    }], "Text",ExpressionUUID->"3fe1695b-f13a-41ed-be96-7535e45d9966"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
  GridBoxFrame->{"Columns" -> True, "Rows" -> True},
  GridBoxSpacings->{"Columns" -> {{1}}, "Rows" -> {{0.5}}}]], "Text",Expressio\
nUUID->"bc51b1a8-29b9-456e-b410-f82ac5dfd5a9"],

Cell[TextData[{
 "The two layers compose. ",
 Cell[BoxData[
  TemplateBox[{
   "YoungSymmetrize", "paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d6f6ba6f-97d6-4244-82f8-6e2434a61dde"],
 " is two ",
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "10b95f35-19e9-4b51-947f-d916501e29de"],
 " calls (",
 StyleBox["Symmetric /@ rows", "Code"],
 ", then ",
 StyleBox["Antisymmetric /@ columns", "Code"],
 ") plus the row- and column-stabiliser normalisation factors. The multi-term \
machinery extends the mono-term machinery, not competes with it."
}], "Text",ExpressionUUID->"748787eb-b4dd-4598-8f66-07418865d97d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Setup", "Section",ExpressionUUID->"8f20a277-7356-48c8-bf8d-69efda864049"],

Cell[TextData[{
 "Load the paclet and pull the Symmetry functions into scope; both ",
 Cell[BoxData[
  TemplateBox[{"Needs", "paclet:ref/Needs"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4d2c638f-75b5-4a27-b7fe-b1769741c2d2"],
 " are assumed in every subsequent cell. The ",
 StyleBox["tol", "Code"],
 " constant sets the numerical tolerance for \"is this tensor identity \
satisfied?\" checks throughout."
}], "Text",ExpressionUUID->"a879e8e3-61e6-4a2f-aa52-3b4b1efe0c24"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"PacletInstall", "[", 
    RowBox[{"\"\<https://www.wolfr.am/DevWTN\>\"", ",", 
     RowBox[{"ForceVersionInstall", "->", "True"}]}], "]"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
   "PacletDirectoryLoad", 
    "[", "\"\</Users/mohammadb/Documents/GitHub/TensorNetworks\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<Wolfram`TensorNetworks`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<Wolfram`TensorNetworks`Symmetry`\>\"", "]"}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"tol", " ", "=", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "10"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.988820395011416*^9, 3.9888203969604816`*^9}, {
  3.988820507403432*^9, 3.988820514156137*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"088a67a6-afd4-4d5d-ba73-dad1045842f9"],

Cell[BoxData[
 RowBox[{"{", "\<\"/Users/mohammadb/Documents/GitHub/TensorNetworks\"\>", 
  "}"}]], "Output",
 CellChangeTimes->{3.988820408857712*^9, 3.988820522542729*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"d0d7fae1-c7c6-4d4b-b866-3cd6e572724e"]
