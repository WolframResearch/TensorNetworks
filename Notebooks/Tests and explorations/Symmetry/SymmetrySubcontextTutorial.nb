 RowBox[{
  RowBox[{"TensorNetwork", "[", 
   RowBox[{"{", 
    RowBox[{"Range", "[", "7", "]"}], "}"}], "]"}], "[", "\"\<Hypergraph\>\"",
   "]"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"215828b9-2f80-4f95-9472-b86a07827ea4"],

