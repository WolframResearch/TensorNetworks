Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "4dd3c6c3-3691-4217-b026-ec3d9330c7de"],
 " is idempotent: projecting twice equals projecting once. This is why \
iterative TN algorithms (DMRG, TDVP) use the normalised projector rather than \
the unnormalised ",
 Cell[BoxData[
  TemplateBox[{
   "YoungSymmetrize", "paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "267baf2d-810b-4e0d-a9f0-510de35cdbf4"],
 ", which would blow up by a factor of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", " ", "!", "/", 
    SubscriptBox["d", "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d63c6e00-7ded-4f27-a55c-6211940c9f0a"],
 " on every iteration."
}], "Text",ExpressionUUID->"3c8b1165-5f1f-4a99-b468-b94e22db846c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"YoungProject", "[", 
   RowBox[{
    RowBox[{"YoungProject", "[", 
     RowBox[{"K", ",", " ", "symTab"}], "]"}], ",", " ", "symTab"}], "]"}], 
  " ", "==", " ", 
  RowBox[{"YoungProject", "[", 
   RowBox[{"K", ",", " ", "symTab"}], "]"}]}]], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"d0b3fb92-6d2e-4f3d-8714-2f6ba0d8061e"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988820412567347*^9},
 CellLabel->"Out[46]=",ExpressionUUID->"9993242b-6feb-4041-906d-7c4e7b018949"]
}, Open  ]],

