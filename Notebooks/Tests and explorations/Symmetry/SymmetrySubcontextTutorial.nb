Cell[CellGroupData[{

Cell["Picturing a tensor as a diagram", "Section",ExpressionUUID->"7e3ed7e7-1bc5-4077-b8f6-99e7fd8988a1"],

Cell[TextData[{
 StyleBox["A rank-",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "61885ab0-bcb3-41c6-ac9d-08b14260e2e0"],
 StyleBox[" tensor is a node with ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d4a95bb8-ac13-4ba1-8282-92246fba295a"],
 StyleBox[" labelled legs, one per slot. This is the visual vocabulary every \
tensor-network argument uses when an indexed sum reads more naturally as a \
diagram.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"bed3bd1e-58d3-46c2-b315-d36619e390a1"],

Cell[TextData[{
 "Render a generic rank-",
 Cell[BoxData[
  FormBox["7", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8e449faf-501a-4ca8-afbc-7e5025ae7ede"],
 " tensor as a hypergraph."
}], "Text",ExpressionUUID->"4e14f3bd-62d0-4aeb-91cc-a1aedbc05ad0"],

Cell[CellGroupData[{

