Cell[TextData[{
 "The textbook identity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr", "MR"], "(", "S", "\[CenterDot]", "A", ")", "=", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f9418857-e8c8-4bb9-9163-18ede3574ea8"],
 " for ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bf53fade-689e-4ea0-8634-b9fa31e9a133"],
 " symmetric and ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "17c96e75-231c-4fe8-9c09-46fa08233807"],
 " antisymmetric is the same Schur-orthogonality statement, in one line: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", 
     RowBox[{"i", "\[NoBreak]", "j"}]], " ", 
    SubscriptBox["A", 
     RowBox[{"j", "\[NoBreak]", "i"}]], "=", 
    SubscriptBox["S", 
     RowBox[{"j", "\[NoBreak]", "i"}]], " ", 
    SubscriptBox["A", 
     RowBox[{"j", "\[NoBreak]", "i"}]], "=", "-", 
    SubscriptBox["S", 
     RowBox[{"j", "\[NoBreak]", "i"}]], " ", 
    SubscriptBox["A", 
     RowBox[{"i", "\[NoBreak]", "j"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a59df89b-e3fb-4829-9926-26c8bcd07f61"],
 ", then relabel ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", " ", "\[LeftRightArrow]", " ", "j"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"3418953d-fc13-4cb4-99b9-b51fb04cb485"],
 " to get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr", "MR"], "(", "S", "\[CenterDot]", "A", ")", "=", "-", 
    StyleBox["tr", "MR"], "(", "S", "\[CenterDot]", "A", ")"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6bb78b18-61bd-4aa7-9592-a09d0f946bc0"],
 ". The Symmetry functions turn this into a contraction-path skipping rule: \
whenever a bond connects a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ecb9e8d7-380d-443d-9263-bc68dc7afa6a"],
 "-typed tensor to a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"75e03a4d-8c91-4183-bbf0-9b70e477daff"],
 "-typed one, the contribution is zero by construction. At rank 2 this skips \
50% of the block multiplications; the savings grow with rank, as the rank-3 \
example next shows (at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a27075b6-40b9-4893-8333-293f599da4b0"],
 " the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7a115432-0bf2-4582-a2a9-0f604835e661"],
 " block is empty, so its contraction is skipped before any data is \
touched)."
}], "Text",ExpressionUUID->"cf0d8640-f499-484b-953e-31d8b807a46c"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Beyond rank 2: three higher-rank payoffs", "Chapter",ExpressionUUID->"7471478e-12b6-49f3-af97-25ef1502e22b"],

Cell[TextData[{
 "Rank 2 admits only two Young diagrams (",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"512b4849-cd8a-4e33-8428-3d3b233dda31"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ed24d41e-df18-42f6-bc69-21f600b7be52"],
 "), so ",
 StyleBox["IntegerPartitions[2]", "Code"],
 ", ",
 Cell[BoxData[
  TemplateBox[{"HookLengths", "paclet:Wolfram/TensorNetworks/ref/HookLengths"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "51fdec4d-0789-41c5-9e10-c6142246665a"],
 ", ",
 Cell[BoxData[
  TemplateBox[{"HookFactor", "paclet:Wolfram/TensorNetworks/ref/HookFactor"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "18f72c85-3048-424d-b980-7644c65b8835"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
   "TableauDimension", "paclet:Wolfram/TensorNetworks/ref/TableauDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "dd510b8e-9854-4501-89e2-4e357f7cc5e8"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
   "SchurDimension", "paclet:Wolfram/TensorNetworks/ref/SchurDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "45c31096-14ba-4f23-8b0d-3d83e1924fdc"],
 " all return trivially small answers. At rank 3 and above the toolbox \
switches on: partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "25bd7993-7d50-4c28-b7b5-17b6cc7ad004"],
 " proliferate (three at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "32a80244-28ab-412e-9b6c-dc2c848b40f1"],
 ", five at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "4"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6f20e8c4-0625-4468-801a-b2a10393808d"],
 ", seven at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "5"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "019b4c17-dd6c-499d-8182-a6cc0c64e580"],
 "), each with its own physical interpretation (bosonic, parastatistical, \
fermionic, curvature-like) and bond-dimension growth in ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cd0c8899-e6b5-4984-9da6-cdb28f210cb9"],
 ". Enumeration, sizing, and projection now require the combinatorial layer \
in earnest. The three sections below exercise it on three orthogonal axes, \
each isolating a qualitative capability that the rank-2 examples could not \
show:"
}], "Text",ExpressionUUID->"5f39b32e-212d-447f-aab3-58b82118b623"],

Cell[TextData[{
 "- The ",
 StyleBox["Schur-Weyl decomposition on three sites",
  FontWeight->"Bold"],
 " uses the full partition arithmetic at rank 3: how a generic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4a2001e9-ea2d-47f1-a4ac-8c7d204f5dce"],
 " three-qubit bond splits into bosonic, parastatistical, and fermionic \
blocks, and how ",
 StyleBox["TableauDimension[par] * SchurDimension[par, d]", "Code"],
 " reads off block sizes before any contraction. - The ",
 StyleBox["Riemann curvature tensor",
  FontWeight->"Bold"],
 " is the canonical rank-4 example where built-in ",
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2aefb7ff-868c-4ba4-8cef-902cce8ac015"],
 " falls short: the algebraic first Bianchi identity is a multi-term relation \
that no ",
 StyleBox["{Cycles[...], phase}", "Code"],
 " generator list can express, and it is the explicit content of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "2", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6c1c734e-65e8-4c5d-be38-8a51a7f88414"],
 " Young projector. We derive the Bianchi identity from the projector itself \
rather than verifying it post-hoc. - The ",
 StyleBox["class-function Hamiltonian",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{"i", "<", "j"}]], " ", 
    SubscriptBox["P", 
     RowBox[{"i", "\[NoBreak]", "j"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ff08b96d-5a46-4657-a24b-2ff51c80c044"],
 " closes the arc. Its full spectrum on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{"\[TensorProduct]", " ", "n"}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c4f21137-0459-4766-9c2a-95ffa58ea7f3"],
 " is the content sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "(", "\[Lambda]", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"39d87e5b-a32f-477a-9235-a78ea51bd7da"],
 " over partitions of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ca9f2b67-bff4-43a7-8691-19f0dad78708"],
 ", with multiplicities ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", " ", 
    SubscriptBox["V", "\[Lambda]"], "\[CenterDot]", "dim", " ", 
    SubscriptBox["W", "\[Lambda]"], "(", "d", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"da2e6199-ce77-48e6-9bb8-60e10cccb37a"],
 ". No eigenvalue routine; every spectral line is a closed-form expression in \
the combinatorial functions above."
}], "Text",ExpressionUUID->"32bcb9ac-8eaa-4304-8d66-56aaa34137b9"],

Cell[CellGroupData[{

Cell["\<\
Schur-Weyl on three sites: how a tensor decomposes by symmetry\
\>", "Section",ExpressionUUID->"0cd9648a-0108-455b-91be-4e9d71e7e404"],

Cell[TextData[{
 StyleBox["Three indistinguishable particles split into a bosonic block, a \
fermionic block, and a parastatistical mixed-symmetry block: the canonical \
Schur-Weyl decomposition of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
   "V", " ", "\[TensorProduct]", " ", "V", " ", "\[TensorProduct]", " ", 
    "V"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "eaf66472-4e55-48ef-a635-3aca82bddab5"],
 StyleBox[". ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{"IntegerPartitions", "paclet:ref/IntegerPartitions"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "123a5a64-b0ac-4ef9-8d97-e3ffd574ab90"],
 StyleBox[", ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "TableauDimension", "paclet:Wolfram/TensorNetworks/ref/TableauDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "eac6fedc-0aee-4e78-9d48-534d8c93e168"],
 StyleBox[", and ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "SchurDimension", "paclet:Wolfram/TensorNetworks/ref/SchurDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "784746cf-b7de-4427-b9d6-fe9212b6593f"],
 StyleBox[" deliver all three block sizes in closed form, and ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "13912b46-0972-4138-8594-4d298b310896"],
 StyleBox[" produces the actual tensors in each block.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"c0e47f14-6121-4d6d-97c5-c00e179c585a"],

Cell[TextData[{
 "Take ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "=", 
    SuperscriptBox["\[DoubleStruckCapitalC]", "2"]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8f5dd87c-1c44-4582-a630-0682a3c85306"],
 " and look at the rank-3 tensor space ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "V", " ", "\[TensorProduct]", " ", "V", " ", "\[TensorProduct]", " ", 
    "V"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d121ae88-1ce1-43e9-990f-6e45ed36ce13"],
 ". It has dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["d", "n"], "=", 
    SuperscriptBox["2", "3"], "=", "8"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"454fafa5-1ec6-4908-8a7b-a238fe11eabe"],
 ". The Schur-Weyl theorem says this space splits into pieces labelled by \
partitions of 3 (i.e. irreducible representations of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8ffeb590-c09f-4874-abd9-fad5ad161670"],
 "):"
}], "Text",ExpressionUUID->"f9367d58-e4ea-405b-b53b-2f2068d36e7a"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
  "V", " ", "\[TensorProduct]", " ", "V", " ", "\[TensorProduct]", " ", "V", 
   " ", "\[MediumSpace]", "=", "\[MediumSpace]", " ", 
   SubscriptBox["bigoplus", 
    RowBox[{
    "\[Lambda]", " ", "\[ThinSpace]", " ", ":", " ", "\[ThinSpace]", " ", 
     "3"}]], " ", 
   SubscriptBox["V", "\[Lambda]"], " ", "\[TensorProduct]", " ", 
   SuperscriptBox["S", "\[Lambda]"], "(", 
   SuperscriptBox["\[DoubleStruckCapitalC]", "d"], ")", "."}], 
  TraditionalForm]],ExpressionUUID->"f6076f1f-42c0-4dbf-8ac0-2284bddcacfe"]], \
"Text",ExpressionUUID->"728f049b-4bee-4bce-9058-97bfce456617"],

Cell[TextData[{
 "The three partitions are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "3", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"59c765f4-8c0f-47e3-a3bc-9e88fb0f511f"],
 " (fully symmetric, bosonic), ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"44e1d90f-a531-43ce-9fe9-a9e4a7aae2fe"],
 " (mixed symmetry), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"fc77a343-2bb5-4b7e-9636-35ae5f5f20c8"],
 " (fully antisymmetric, fermionic). Each block has dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", " ", 
    SubscriptBox["V", "\[Lambda]"], "\[CenterDot]", "dim", " ", 
    SuperscriptBox["S", "\[Lambda]"], "(", 
    SuperscriptBox["\[DoubleStruckCapitalC]", "d"], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ed50037b-feb2-463e-8dce-21669b484ddf"],
 ". The first factor is the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "93495ff1-3c62-4886-9410-1ff489c6f208"],
 " irreducible representation dimension; the second is the Weyl dimension \
formula:"
}], "Text",ExpressionUUID->"943d3b09-a712-498a-86ed-006823d9ff58"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"dim", " ", 
   SuperscriptBox["S", "\[Lambda]"], "(", 
   SuperscriptBox["\[DoubleStruckCapitalC]", "d"], ")", "\[MediumSpace]", "=",
    "\[MediumSpace]", " ", 
   UnderscriptBox["\[Product]", 
    RowBox[{"(", "i", ",", "j", ")", "\[Element]", "\[Lambda]"}]], " ", 
   FractionBox[
    RowBox[{"d", "+", "j", "-", "i"}], 
    RowBox[{"h", "(", "i", ",", "j", ")"}]], " ", "."}], 
  TraditionalForm]],ExpressionUUID->"0b370c0c-1335-49d4-900b-fa5a2cb3e352"]], \
"Text",ExpressionUUID->"e882a58e-adc6-4029-823e-1822c4539233"],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "(", "i", ",", "j", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cebd2ff2-f952-47f0-a00a-88847eab16e5"],
 " is the ",
 StyleBox["hook length",
  FontSlant->"Italic"],
 " of cell ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "i", ",", "j", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a249ba3c-e44d-4152-95c5-bf241944a155"],
 ": the number of cells in its hook (itself, the cells to its right in the \
same row, and the cells below it in the same column), computed below by ",
 Cell[BoxData[
  TemplateBox[{"HookLength", "paclet:Wolfram/TensorNetworks/ref/HookLength"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b5e2eade-3b1f-42dc-9d9c-0e5064eced58"],
 " and ",
 Cell[BoxData[
  TemplateBox[{"HookLengths", "paclet:Wolfram/TensorNetworks/ref/HookLengths"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "213eef00-1a8d-4c94-9211-1c0106cb9fa1"],
 "."
}], "Text",ExpressionUUID->"fd0ca482-d567-4440-a606-1a704f92dc15"],

Cell[TextData[{
 "Enumerate the partitions of ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7091b1ed-8b84-417c-b84a-a12333e64b4b"],
 " with the built-in ",
 StyleBox["IntegerPartitions[n]", "Code"],
 ", which returns them in reverse-lexicographic order (fully symmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "n", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"21713644-edd5-40d4-b5e5-342cca93a069"],
 " first, fully antisymmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "\[Ellipsis]", ",", "1", " ", "}"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "61dc195d-e929-4e5d-bc55-74f4a588420b"],
 " last). The list length is the partition counting function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "(", "n", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d29b21f8-dc57-42c6-8c43-38ce874a0475"],
 ", equal to the number of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0a36bf6a-8007-4cfb-a7bb-03e59d97a7c5"],
 " irreducible representations."
}], "Text",ExpressionUUID->"52ca47d9-7e83-4171-909d-1bb6ec9b732e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"parts", " ", "=", " ", 
  RowBox[{"IntegerPartitions", "[", "3", "]"}]}]], "Input",
 CellLabel->
  "In[120]:=",ExpressionUUID->"d9c47e46-f948-4275-9734-332935577d51"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9888204133209476`*^9},
 CellLabel->
  "Out[120]=",ExpressionUUID->"001d4301-a86f-4274-9420-8975234f5c68"]
}, Open  ]],

Cell["\<\
Validate each one is a legal Young-diagram shape (non-increasing, positive \
integers, non-empty).\
\>", "Text",ExpressionUUID->"fca3939b-f4c0-440f-9c0b-e9dbb0fa6866"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PartitionQ", " ", "/@", " ", "parts"}]], "Input",
 CellLabel->
  "In[121]:=",ExpressionUUID->"fa93b362-0513-4285-9480-e9fd2c2cd836"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.988820413326318*^9},
 CellLabel->
  "Out[121]=",ExpressionUUID->"951ed27f-88f7-4934-992d-147d8c933aca"]
}, Open  ]],

Cell[TextData[{
 "For a bond of dimension ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d64fda2f-bc82-4500-8835-683c3d8b0831"],
 ", only diagrams with at most ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3bb3cefb-d297-40ce-a822-77ae80172c6f"],
 " rows contribute; the rest give zero-dimensional Weyl modules. The \
two-argument form ",
 StyleBox["IntegerPartitions[n, d]", "Code"],
 " pre-filters to the irreducible representations that fit in the bond. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f41cc238-157a-4fbc-baf1-605887dedd32"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "41877cc0-fc3e-4e36-b096-bff08157a7e3"],
 " the fermionic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"16edf547-6357-47e4-b59d-297fdfe0b231"],
 " drops out."
}], "Text",ExpressionUUID->"8f37f583-e556-4cba-aa7d-db8548f38575"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", 
  RowBox[{"3", ",", " ", "2"}], "]"}]], "Input",
 CellLabel->
  "In[122]:=",ExpressionUUID->"d3384941-711e-4103-a093-4de692047842"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988820413338051*^9},
 CellLabel->
  "Out[122]=",ExpressionUUID->"ab270b3f-e493-4888-9e6b-0b94ef1d0844"]
}, Open  ]],

Cell[TextData[{
 StyleBox["HookLength[tab, {r, c}]", "Code"],
 " reads a single hook value at one cell of the diagram. The mixed-symmetry \
shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9323d9ae-3b41-4f5c-a40f-aaa0b1987cd6"],
 " has three cells; the top-left cell has hook length ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2af9f230-a003-4716-b7a9-f2d9f090c35b"],
 " (itself, the cell to its right, the cell below)."
}], "Text",ExpressionUUID->"835ee277-9837-45f3-9646-193352261b22"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookLength", "[", 
  RowBox[{
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[123]:=",ExpressionUUID->"cfd82b89-df92-4ee1-a665-50b299ae1016"],

