Cell[TextData[{
 "Each call returns a typed ",
 StyleBox["YoungTableau[...]", "Code"],
 " with a summary display. The constructor accepts two forms. The ",
 StyleBox["partition",
  FontSlant->"Italic"],
 " form just used takes a non-increasing list of row lengths and fills slot \
labels ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", "n"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6db5389d-aa3b-4830-9841-fa328147fc47"],
 " row by row. The ",
 StyleBox["explicit-rows",
  FontSlant->"Italic"],
 " form takes the rows of slot labels directly; the symmetric two-tableau \
equivalent reads:"
}], "Text",ExpressionUUID->"61ad5284-b73e-42df-8a93-6ee8f2189cfe"],

