Cell[CellGroupData[{

Cell[TextData[{
 "Two-spin singlet vs triplet (spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "843d2c0e-a90d-4514-82d1-dcbda4264e69"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "466a736d-f6dd-4f63-9f6c-5c8b427972b6"],
 ")"
}], "Subsection",ExpressionUUID->"1416a020-7cd1-4d34-b9c7-b76c9957f068"],

Cell[TextData[{
 StyleBox["Two spin-",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7ee875bb-5cf8-4e2a-9a9a-3158bd271fb3"],
 StyleBox[" particles couple into a spin-0 singlet (antisymmetric) plus a \
spin-1 triplet (symmetric), the Clebsch-Gordan decomposition ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], " ", "\[TensorProduct]", " ", 
    FractionBox["1", "2"], "=", "0", " ", "\[CirclePlus]", " ", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3b42829f-713f-4b09-a88f-f42f991bc312"],
 StyleBox[". ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ee3a2195-1c1b-4ee0-9a35-68fb16b71fd8"],
 StyleBox[" onto ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"80daa944-8c37-4c08-bb05-8feb83fdf67c"],
 StyleBox[" and ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8a43212b-38f9-4c78-9bf8-35eb3526fd6d"],
 StyleBox[" separates them in one call, one projector per total-spin sector.",
  
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"e1efc742-7382-43dc-bd5f-e4c9a9d5ce04"],

Cell[TextData[{
 "A pair of spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a36b5c09-678b-43e8-8508-2d54afe704b5"],
 " particles has a 4-dimensional Hilbert space ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", " ", "\[TensorProduct]", " ", "V"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b84e944f-d3ed-4268-b55e-0cbb0d2ca552"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9bff435a-e5a3-45f0-9ff2-4674c377d103"],
 ". The two-spin wavefunctions split into one singlet (",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "=", "0"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7646c40e-aea4-49f4-abba-1ad6a30d28d7"],
 ", antisymmetric) and three triplet states (",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "=", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ff9199e1-4d24-423c-8a5e-c4ec34fb66bb"],
 ", symmetric). In coefficient-tensor form a state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"\[CapitalPsi]"},
     "Ket"], "=", 
    RowBox[{
     UnderscriptBox["\[Sum]", 
      RowBox[{"i", "\[NoBreak]", "j"}]], " ", 
     RowBox[{
      SubscriptBox["\[Psi]", 
       RowBox[{"i", "\[NoBreak]", "j"}]], " ", 
      TemplateBox[{
        RowBox[{"i", "\[NoBreak]", "j"}]},
       "Ket"]}]}]}], TraditionalForm]],ExpressionUUID->
  "65483009-00e1-472b-bd32-44e22a606ecc"],
 " has a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ca1cd463-9818-4e22-b430-ecaf0cb56d44"],
 " coefficient matrix ",
 Cell[BoxData[
  FormBox["\[Psi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "da974522-b8d9-4878-84b9-ea6df6239ff7"],
 ": singlet iff ",
 Cell[BoxData[
  FormBox["\[Psi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d2a38301-4260-4d13-95d5-3d78df969337"],
 " is antisymmetric, triplet iff ",
 Cell[BoxData[
  FormBox["\[Psi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "db7774b0-7195-44f5-8bdc-a0628dda6a0e"],
 " is symmetric."
}], "Text",ExpressionUUID->"4597b29c-a7e6-4a45-b09a-1d37da17452e"],

Cell[TextData[{
 "Build the singlet ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"01"},
       "Ket"], "-", 
      TemplateBox[{"10"},
       "Ket"]}], ")"}], "/", 
    SqrtBox["2"]}], TraditionalForm]],ExpressionUUID->
  "ad0148f3-868c-46ca-94e6-10c7789d1c23"],
 " as a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f5b032c6-41c9-4f40-b910-320a9aa71051"],
 " coefficient matrix."
}], "Text",ExpressionUUID->"0101bb0b-a13f-4d30-98b0-63932b382b56"],

Cell[BoxData[
 RowBox[{
  RowBox[{"psiSinglet", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "}"}], "/", 
    RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"9b8648c9-1383-42a5-a36a-694c05494fc3"],

Cell[TextData[{
 "Build the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "z"], "=", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"dc78d188-4c00-438a-9e9f-63a3de25038e"],
 " triplet ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      TemplateBox[{"01"},
       "Ket"], "+", 
      TemplateBox[{"10"},
       "Ket"]}], ")"}], "/", 
    SqrtBox["2"]}], TraditionalForm]],ExpressionUUID->
  "d0908d50-a87d-4994-985a-024ba2599b2f"],
 "."
}], "Text",ExpressionUUID->"fa11e124-e701-484b-8b83-936b786ee55a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"psiTriplet", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], "/", 
    RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[64]:=",ExpressionUUID->"fab86370-6e09-4a32-b0fa-326d35f875e1"],

Cell["\<\
The antisymmetric projection of the singlet returns the singlet itself.\
\>", "Text",ExpressionUUID->"abbfff93-a002-445e-a307-f9f74a6f105c"],

