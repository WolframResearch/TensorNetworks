Cell[TextData[{
 "The two lists agree exactly. The numerical diagonalisation was a courtesy; \
the spectrum was already determined by the combinatorics of ",
 Cell[BoxData[
  TemplateBox[{
   "TableauDimension", "paclet:Wolfram/TensorNetworks/ref/TableauDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9c973c4c-0f03-4b86-988e-25965163f80b"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
   "SchurDimension", "paclet:Wolfram/TensorNetworks/ref/SchurDimension"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0ac28e9c-7b0d-473e-80e4-b17883d3e0fc"],
 " (powered by ",
 Cell[BoxData[
  TemplateBox[{"HookLengths", "paclet:Wolfram/TensorNetworks/ref/HookLengths"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0b073b24-379c-499c-ad53-6b6b684fc9b5"],
 "), and ",
 StyleBox["contentSum", "Code"],
 "."
}], "Text",ExpressionUUID->"58464744-a0e7-4297-a316-3bc5e9ddd9ac"],

Cell[TextData[{
 "That cross-check used an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Times]", "8"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6f93c312-52ce-4914-98cc-8a7fb90c675e"],
 " matrix. The combinatorial path scales with the number of partitions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "(", "n", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"41e122e8-f208-490b-8831-3f74ad1d52ea"],
 ", which grows slowly with ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "63e9851e-448b-46b3-bb90-f56a22d311e3"],
 ", while explicit diagonalisation scales with the matrix dimension ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["d", "n"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bbff2193-c0b1-4e8a-a26e-2b4bd7704b1d"],
 ", which grows quickly. Generalise the helpers and time both paths on a \
larger system."
}], "Text",ExpressionUUID->"14264d98-bb4e-4d9c-9841-b1cb53f97b2f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"applySwapND", "[", 
     RowBox[{"a_", ",", " ", "b_", ",", " ", "n_", ",", " ", "d_"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"perm", " ", "=", " ", 
        RowBox[{"Range", "[", "n", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"perm", "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], "]"}], " ", "=", " ", 
        RowBox[{"perm", "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "a"}], "}"}], "]"}], "]"}]}], ";", "\n", 
       "    ", 
       RowBox[{"ArrayReshape", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"Transpose", "[", "\n", "            ", 
          RowBox[{
           RowBox[{"ArrayReshape", "[", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{"d", "^", "n"}], "]"}], ",", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"d", ",", " ", 
               RowBox[{"2", " ", "n"}]}], "]"}]}], "]"}], ",", "\n", 
           "            ", 
           RowBox[{"Join", "[", 
            RowBox[{"perm", ",", " ", 
             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"n", " ", "+", " ", "1"}], ",", " ", 
               RowBox[{"2", " ", "n"}]}], "]"}]}], "]"}]}], "\n", "        ", 
          "]"}], ",", "\n", "        ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"d", "^", "n"}], ",", " ", 
           RowBox[{"d", "^", "n"}]}], "}"}]}], "\n", "    ", "]"}]}]}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"classFnH", "[", 
     RowBox[{"n_", ",", " ", "d_"}], "]"}], " ", ":=", "\n", "    ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"applySwapND", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", " ", "n", ",", " ", "d"}], 
        "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Subsets", "[", 
       RowBox[{
        RowBox[{"Range", "[", "n", "]"}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"partitionSpectrum", "[", 
    RowBox[{"n_", ",", " ", "d_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Sort", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Flatten", " ", "@", " ", 
      RowBox[{"Map", "[", "\n", "        ", 
       RowBox[{
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"contentSum", "[", "#", "]"}], ",", "\n", "            ", 
           RowBox[{
            RowBox[{"TableauDimension", "[", "#", "]"}], " ", "*", " ", 
            RowBox[{"SchurDimension", "[", 
             RowBox[{"#", ",", " ", "d"}], "]"}]}]}], "]"}], " ", "&"}], ",", 
        "\n", "        ", 
        RowBox[{"IntegerPartitions", "[", "n", "]"}]}], "\n", "    ", "]"}]}],
      ",", "\n", "    ", "Greater"}], "\n", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[225]:=",ExpressionUUID->"0f9d9cb4-3109-4557-9dc7-44694954bd2a"],

