Cell[TextData[{
 "Read the rightmost column: at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "10"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"07904a9c-485c-481e-9c29-f38886edf0b5"],
 " the symmetric subspace is 11-dimensional inside a 1024-dimensional Hilbert \
space, a 93-fold compression. Every TN algorithm that promises to stay in the \
symmetric sector (Dicke-state preparation, Lipkin-Meshkov-Glick spin models, \
permutation-invariant Ans\\[ADoubleDot]tze) only needs to allocate and \
contract ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", "n", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"49541991-6dac-4529-8a55-c89fac46af75"],
 " amplitudes per bond, not ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["2", "n"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"59fe19a4-d9b5-47f9-96d8-89619140af81"],
 ". The ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c2aa32a4-d1ab-4cba-82b0-cd13de1e1c78"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "n", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"56449c9f-87dd-41aa-aa4e-9f82dae18075"],
 " produces the state, the ",
 StyleBox["SchurDimension[{n}, 2]", "Code"],
 " produces the bond size, and built-in ",
 Cell[BoxData[
  TemplateBox[{"TensorContract", "paclet:ref/TensorContract"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "032ee57c-4e10-4f7b-99c3-95788ac11bea"],
 " / ",
 Cell[BoxData[
  TemplateBox[{"Dot", "paclet:ref/Dot"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "de0e7583-a962-4d1e-a2a6-056a5208e4cc"],
 " see and preserve the symmetry sector automatically."
}], "Text",ExpressionUUID->"0012411e-547a-46cc-be3a-ed6040425bb3"],

Cell[TextData[{
 "Time the W-state construction across a sweep of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6239798f-d617-4bd2-ae50-1c2ca59c6dcb"],
 ". The builder below applies the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "n", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b61fc75a-a5e8-4120-a409-a88c3bb42fc5"],
 " Young projector to the single-excitation seed and normalises; the table \
reports ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "4", ",", "6", ",", "8", ",", "10", ",", "12"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ce14f015-41f2-49a3-9a5d-18b2d39afed7"],
 "."
}], "Text",ExpressionUUID->"0748f91f-c17f-4560-b3b3-07e94a02842c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"buildW", "[", "nn_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"raw", " ", "=", " ", 
       RowBox[{"YoungProject", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"Normal", " ", "@", " ", 
          RowBox[{"SparseArray", "[", "\n", "            ", 
           RowBox[{
            RowBox[{
             RowBox[{"Prepend", "[", 
              RowBox[{
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"nn", " ", "-", " ", "1"}]}], "]"}], ",", " ", "2"}],
               "]"}], " ", "->", " ", "1"}], ",", "\n", "            ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"2", ",", " ", "nn"}], "]"}]}], "]"}]}], ",", "\n", 
         "        ", 
         RowBox[{"YoungTableau", "[", 
          RowBox[{"{", "nn", "}"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"raw", " ", "/", " ", 
      RowBox[{"Norm", "[", 
       RowBox[{"Flatten", "[", "raw", "]"}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"nn", ",", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"buildW", "[", "nn", "]"}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"nn", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "4", ",", " ", "6", ",", " ", "8", ",", " ", "10", ",", " ", "12"}], 
      "}"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[106]:=",ExpressionUUID->"d7cf76f2-86d6-4c3a-a8db-cb30c8f1be39"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "0.000332`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "0.000531`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"8", ",", "0.001388`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "0.003906`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"12", ",", "0.0139`"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988820413241478*^9},
 CellLabel->
  "Out[107]=",ExpressionUUID->"a1d50ff9-1c0d-4db9-af02-0d504e155222"]
}, Open  ]],

Cell[TextData[{
 "The construction stays sub-second up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "12"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2c4996f3-bc00-4402-8e1c-9755a1e5f276"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "13"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"219be804-c6aa-47c2-8f1f-97ec90d7e4c3"],
 " and above the internal ",
 Cell[BoxData[
  TemplateBox[{"SymmetrizedArray", "paclet:ref/SymmetrizedArray"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "5d2c9a7c-e0ce-4a80-b1de-d85f9701eadf"],
 " that backs ",
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d907d2f2-533a-4412-9433-03e88024dad5"],
 " runs out of memory enumerating ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6515bf38-3460-4432-8648-641c89b583e1"],
 " orbits, and the recipe stops. The output tensor would still fit (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["2", "20"], "=", "1"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b9d08949-a44c-4559-9e16-29292237e549"],
 " M doubles ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[TildeTilde]", " ", "8"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"803182b5-6247-4d8a-a311-e720debc73fe"],
 " MB even at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "20"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ee80088f-f91b-4cae-ba17-2bef8704cd3d"],
 "); the wall is the symmetriser construction, not the storage. For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", " ", "\[GreaterEqual]", " ", "13"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0fb737c1-ebb3-4e01-8f91-828780f36c1c"],
 ", bypass ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9ed25115-d4b6-4c64-a8da-9784926f28c3"],
 " and build Dicke states directly in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "n", "+", "1", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0267e2b1-a287-48fb-87db-64630c7fb589"],
 "-dimensional symmetric basis from one closed-form binomial amplitude per \
state. The bond size is ",
 StyleBox["SchurDimension[{n}, 2] = n + 1", "Code"],
 " regardless of which route produces the state."
}], "Text",ExpressionUUID->"d52b4970-9113-44f0-9658-7428d1aa9d79"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Block-sparse trace: cross-shape contractions vanish identically\
\>", "Subsection",ExpressionUUID->"4df686ad-fbb5-4082-9009-d4fafab34719"],

Cell[TextData[{
 StyleBox["Contracting two bond tensors block-diagonalises along symmetry \
classes: a symmetric tensor cannot 'see' an antisymmetric one. Projecting \
onto ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"81200231-7c68-469b-a023-8ef9bcdb9e17"],
 StyleBox[" and ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"552f8fd2-929a-4566-9d76-cdb49210644e"],
 StyleBox[" makes this explicit, and Schur orthogonality lets a \
contraction-path optimiser skip cross-shape products before any \
multiplication runs.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"d93b4c36-95b5-4329-b54f-14cc4ade39bf"],

Cell[TextData[{
 "The Frobenius trace ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["tr", "MR"], "(", "A", "\[CenterDot]", "B", ")", "=", 
    UnderscriptBox["\[Sum]", 
     RowBox[{"i", "\[NoBreak]", "j"}]], " ", 
    SubscriptBox["A", 
     RowBox[{"i", "\[NoBreak]", "j"}]], " ", 
    SubscriptBox["B", 
     RowBox[{"j", "\[NoBreak]", "i"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ec2562b4-863d-446d-b60b-61413674d037"],
 " is the basic two-tensor contraction over a rank-2 bond. It admits a \
block-sparse decomposition along symmetry classes: the trace splits into \
pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[Lambda]", ",", "\[Mu]", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"72f14768-d364-497c-99c3-127e3c9c43ba"],
 " and the two cross-shape pairs vanish identically. A symmetry-aware \
contraction-path optimiser skips them before any multiplication."
}], "Text",ExpressionUUID->"e997d21c-a251-43ca-93b8-f759df0af83c"],

Cell[TextData[{
 "Build two random rank-2 tensors at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", "6"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1331ad85-c8c0-41d6-a80f-56977e3d93e7"],
 "."
}], "Text",ExpressionUUID->"40535d45-1b11-4fe3-a0a5-032a55ac8f64"],

