 CellLabel->"In[29]:=",ExpressionUUID->"06b8fc35-c6eb-49d5-b2d7-4d1019d401c3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"-", "\[ImaginaryI]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[ImaginaryI]", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988820412430109*^9},
 CellLabel->"Out[29]=",ExpressionUUID->"a4ae0985-dd34-43ba-b61f-c73bc32edfcf"]
}, Open  ]],

Cell[TextData[{
 "Project ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "y"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0ee7270d-5be1-4ec9-968a-8afad44beb60"],
 " onto the symmetric shape; the result vanishes."
}], "Text",ExpressionUUID->"38a0ebb1-673a-450f-9f03-daf439d711b8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungProject", "[", 
  RowBox[{"sy", ",", " ", "symTab"}], "]"}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"d8b6a87d-e863-4e93-82f7-914277fd5c0d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988820412441627*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"088e57be-cf61-4170-84dd-42f3a0039c10"]
}, Open  ]],

Cell[TextData[{
 "Alongside the projector ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ac86a5d7-2d41-47b7-8a19-1d037d3e270f"],
 ", the Symmetry functions also expose the unnormalised Young symmetriser ",
 Cell[BoxData[
  TemplateBox[{
   "YoungSymmetrize", "paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a019f7a3-da85-4262-98d3-fad9b1ce4850"],
 ", which returns ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "T"], "\[CenterDot]", "T"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b8a6c838-9ed2-4abd-aef9-9db40d842a4e"],
 " instead of the projector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "T"], "=", "(", 
    SubscriptBox["d", "\[Lambda]"], "/", "n", " ", "!", ")", "\[ThinSpace]", " ", 
    SubscriptBox["c", "T"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"326b49e5-17b6-4022-a6c1-e466d9ef313b"],
 ". For a rank-2 tensor and the symmetric tableau, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", 
     RowBox[{"{", " ", "2", " ", "}"}]], "="}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"23a09d05-c36a-44e8-8c1c-eba026d787d3"],
 " row-stabiliser order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", "2", " ", "!", "=", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9528f5d6-562f-4496-837e-b34bd0f7b0ab"],
 ", so the unnormalised version is twice the projection."
}], "Text",ExpressionUUID->"c339f5f3-1707-42ad-9ccf-a5d7fffa6f84"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"YoungSymmetrize", "[", 
   RowBox[{"sx", ",", " ", "symTab"}], "]"}], " ", "==", " ", 
  RowBox[{"2", " ", "*", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"sx", ",", " ", "symTab"}], "]"}]}]}]], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"f113dd66-ff06-4824-9937-bde41568a95f"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988820412446423*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"9a93cb53-5d8c-4f42-85d4-27abcd482309"]
}, Open  ]],

Cell[TextData[{
 "Under the hood ",
 Cell[BoxData[
  TemplateBox[{
   "YoungSymmetrize", "paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a3806900-bc3a-4be8-b70b-3c42ad3625f4"],
 " is built directly on built-in WL's ",
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e055a963-a5cb-4e0d-b22e-d6300959feac"],
 ": it calls ",
 StyleBox["Symmetrize[T, Symmetric /@ TableauRows[tab]]", "Code"],
 " (row symmetrisation) then ",
 StyleBox["Symmetrize[..., Antisymmetric /@ TableauColumns[tab]]", "Code"],
 " (column antisymmetrisation), scaled by the row- and column-stabiliser \
orders to undo ",
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "02c0fc5e-650e-41e9-b60b-a651eb9c9a85"],
 "'s built-in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "\[VerticalSeparator]", "G", "\[VerticalSeparator]"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9b20ee62-ca3c-4987-b1ff-23205ec1bd90"],
 " normalisation. The two ",
 Cell[BoxData[
  TemplateBox[{"Symmetrize", "paclet:ref/Symmetrize"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "726537e6-fa86-49f7-a951-3120c1070e5d"],
 " calls compose because rows and columns of a Young tableau touch disjoint \
slot sets."
}], "Text",ExpressionUUID->"42e9e75d-6bd5-49ad-9438-2342b32c6549"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"YoungSymmetrize", "[", 
   RowBox[{"sx", ",", " ", "symTab"}], "]"}], " ", "==", " ", 
  RowBox[{"2", " ", "*", " ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"Symmetrize", "[", 
     RowBox[{"sx", ",", " ", 
      RowBox[{"Symmetric", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}]}]}]], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"c4bdf8b4-0f6a-41b1-ab8f-934359942941"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9888204124607477`*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"987cfd2a-3280-4098-ab47-f307711fb448"]
}, Open  ]],

Cell[TextData[{
 "The two projections decompose any rank-2 tensor: their sum returns the \
original. This is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "809883ae-f111-445b-b36b-bc068e6831bd"],
 " instance of the general fact that on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["V", 
    RowBox[{"\[TensorProduct]", " ", "n"}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"bf718da4-a387-4c60-8470-75cd703dd934"],
 " the sum of isotypic projectors over all partitions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[Lambda]", " ", "\[ThinSpace]", " ", ":", " ", "\[ThinSpace]", " ", 
    "n"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3b5b00b8-4862-41ad-b10c-6206f8e94db7"],
 " is the identity."
}], "Text",ExpressionUUID->"24850342-3afe-4abb-91c8-613deb4edd72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"YoungProject", "[", 
    RowBox[{"sx", ",", " ", "symTab"}], "]"}], " ", "+", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"sx", ",", " ", "antiTab"}], "]"}]}], " ", "==", " ", 
  "sx"}]], "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"edd32c29-f2a9-4e4d-9d93-80626726f92e"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9888204124656897`*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"b2dc87f2-34cd-4f57-a3da-65e4529bbeba"]
}, Open  ]],

Cell[TextData[{
 "A short census of rank-2 tensors the reader has seen and the shape each one \
lives in follows. Each entry uses the same four-step pattern: build the \
tensor, project onto the symmetric shape and subtract the original, project \
onto the antisymmetric shape and subtract the original, and read the symmetry \
class with the built-in detector. A zero residual on a shape's projection \
means the tensor lies entirely in that shape; anything not in one shape is a \
sum of a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ee373041-6445-40c8-a851-c340d337fe0c"],
 "-piece and a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "1", ",", "1", " ", "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"cf9b2ab7-d3fa-4ff2-9a2c-9f12c9f6c68f"],
 "-piece that ",
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "b18890e5-20fa-4d2c-87f6-1d165d86fb57"],
 " decomposes."
}], "Text",ExpressionUUID->"89b78442-b2f0-4421-b6fd-119f4ecc30bc"],

Cell[CellGroupData[{

Cell[TextData[{
 "Minkowski metric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", 
    RowBox[{"\[Mu]", " ", "\[Nu]"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"62b75aa6-eabb-4d0b-8b67-f55e9f03048a"]
}], "Subsection",ExpressionUUID->"e2a9fd25-6b5f-4570-bdd7-7587ea08cf8f"],

Cell[TextData[{
 StyleBox["The metric of flat spacetime is symmetric by definition: ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", 
     RowBox[{"\[Mu]", " ", "\[Nu]"}]], "=", 
    SubscriptBox["g", 
     RowBox[{"\[Nu]", " ", "\[Mu]"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"865ea5ab-3098-4df0-bbf8-d2719abc5759"],
 StyleBox[" encodes distance, which is reciprocal. ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9a2467b8-5ff5-4546-b120-ac4e5a63f84d"],
 StyleBox[" lands ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["g", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "58124058-2d21-48e9-8637-20e3c093ed05"],
 StyleBox[" entirely in the symmetric ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", " ", "2", " ", "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"07fa0b35-9416-4939-8468-180141d91cce"],
 StyleBox[" class with zero antisymmetric residue, the canonical first sanity \
check that the projector is wired correctly.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"087e85de-d081-4067-8dbb-b6d03ba8112b"],

Cell[TextData[{
 "The Minkowski metric is a diagonal matrix with signature ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "-", ",", "+", ",", "+", ",", "+", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"616a4ba2-295b-4b32-9a1d-2ea4ffcbad71"],
 "."
}], "Text",ExpressionUUID->"d037f886-2a59-4458-8a29-c353ffc83fdc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g", " ", "=", " ", 
  RowBox[{"DiagonalMatrix", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}],
    "]"}]}]], "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"3e2244c1-e2d7-4033-a3de-daaf482e580d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9888204124772797`*^9},
 CellLabel->"Out[34]=",ExpressionUUID->"99c2e779-7ce5-4877-912c-cdd17f48ed02"]
}, Open  ]],

Cell[TextData[{
 "Project ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "154c0a3b-df91-439e-8d9e-69cac3427d19"],
 " onto the symmetric shape and subtract the original."
}], "Text",ExpressionUUID->"fc53cd63-e741-4ffb-ab42-3db5e70395f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"YoungProject", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", "2", "}"}], "]"}]}], "]"}], " ", "-", " ", "g"}], " ", "//",
   " ", "Simplify"}]], "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"e9a57337-f5d6-467f-8212-efcb3720ccae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988820412483419*^9},
 CellLabel->"Out[35]=",ExpressionUUID->"61cf3847-fe87-48ee-94d4-23b4cc919f59"]
}, Open  ]],

Cell[TextData[{
 "Project ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d2319242-d892-427b-ad86-902d418a559e"],
 " onto the antisymmetric shape and subtract the original."
}], "Text",ExpressionUUID->"bc745dbf-ed32-4ee9-a9d4-3f869499c8c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"YoungProject", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}], "]"}], " ", "-", " ", 
   "g"}], " ", "//", " ", "Simplify"}]], "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"86f766ea-3919-4acc-99a2-f907788fff92"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", 
     RowBox[{"-", "1"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.98882041249538*^9},
 CellLabel->"Out[36]=",ExpressionUUID->"78d2e7f1-d5c4-4fb8-b69a-8f0f1585321c"]
}, Open  ]],

Cell["Read the symmetry class from the built-in detector.", "Text",ExpressionUUID->"113c05c5-6ecd-4fc9-b096-c081bf13def3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorSymmetry", "[", "g", "]"}]], "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"ca8f9738-fab4-49f1-bac9-85f1785674d4"],

Cell[BoxData[
 RowBox[{"Symmetric", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2"}], "}"}], "]"}]], "Output",
 CellChangeTimes->{3.98882041250086*^9},
 CellLabel->"Out[37]=",ExpressionUUID->"e275ad74-17ea-4ae6-8622-ac5cac6b60a0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Stress-energy tensor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", 
    RowBox[{"\[Mu]", " ", "\[Nu]"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"754c09bb-722b-487a-89e3-ed604043af78"],
 " (perfect fluid)"
}], "Subsection",ExpressionUUID->"678cc223-a647-491d-8c31-448eb1ed4089"],

Cell[TextData[{
 StyleBox["The stress-energy tensor of a perfect fluid encodes energy and \
momentum flow, which is reciprocal, so ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["T", 
     RowBox[{"\[Mu]", " ", "\[Nu]"}]], "=", 
    SuperscriptBox["T", 
     RowBox[{"\[Nu]", " ", "\[Mu]"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a4f328fd-bd45-4671-9c02-2241ecf18b61"],
 StyleBox[" for any ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", ",", "p", ",", 
    SuperscriptBox["u", "\[Mu]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b03728eb-ef10-40d1-af8b-86b4dcac2e5d"],
 StyleBox[". ",
  FontSlant->"Italic"],
 Cell[BoxData[
  TemplateBox[{
   "YoungProject", "paclet:Wolfram/TensorNetworks/ref/YoungProject"},
   "RefLink"]], "Text",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "fa8f7915-76ef-4958-940d-07cf916fe427"],
 StyleBox[" confirms this symbolically, letting a TN library halve the stored \
components on a stress-energy bond.",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"c6372046-1cc5-473b-8a13-1385c641989d"],

Cell[TextData[{
 "Build the stress-energy tensor of a perfect fluid, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["T", 
     RowBox[{"\[Mu]", " ", "\[Nu]"}]], "=", "(", "\[Rho]", "+", "p", ")", 
    "\[ThinSpace]", " ", 
    SuperscriptBox["u", "\[Mu]"], " ", 
    SuperscriptBox["u", "\[Nu]"], "+", "p", " ", "\[ThinSpace]", " ", 
    SuperscriptBox["g", 
     RowBox[{"\[Mu]", " ", "\[Nu]"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e095e997-f5b7-485b-a254-980df6f57d27"],
 ", from a generic 4-velocity and the Minkowski metric. Here ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c1951108-dbcd-4f9e-8240-0343d1619a23"],
 " is the energy density, ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "894c50fb-8a1f-4340-9e41-4b6a26f39362"],
 " the isotropic pressure, and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["u", "\[Mu]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f9eb128d-f31f-4d1b-be08-70cadf19badb"],
 " the fluid's 4-velocity (normalised ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["u", "\[Mu]"], " ", 
    SubscriptBox["u", "\[Mu]"], "=", "-", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6b0e63e6-4387-4f32-89eb-f013d8531b1a"],
 " in the mostly-plus signature). In the rest frame ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["u", "\[Mu]"], "=", "(", "1", ",", "0", ",", "0", ",", "0",
     ")"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9af2ed6f-4022-4c4c-9412-03a21fa9105b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["T", 
    RowBox[{"\[Mu]", " ", "\[Nu]"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"91870239-5fab-4ea0-b210-3d62eb9250d1"],
 " reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diag", "MR"], "(", "\[Rho]", ",", "p", ",", "p", ",", "p", 
    ")"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a2b5679b-4caa-465b-a06a-66aac94395c4"],
 ". The tensor is manifestly symmetric in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "\[Mu]", ",", "\[Nu]", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a349fbbc-1376-460c-ab4c-325a2a2ba5ee"],
 " for any ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", ",", "p", ",", 
    SuperscriptBox["u", "\[Mu]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"531d8a02-f3bb-4dbf-9396-6296cc54ac62"],
 "."
}], "Text",ExpressionUUID->"b1eaeabf-cd2d-4ed5-bf94-f027ed7da612"],

