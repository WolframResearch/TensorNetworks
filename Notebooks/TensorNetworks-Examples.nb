Cell["\<\
Constructs a TensorNetwork from a graph with tensor data at vertices.\
\>", "Text",ExpressionUUID->"7b42f3f4-300c-452f-aa11-67e26bc4f758"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tng", "=", 
  RowBox[{"ToTensorNetworkGraph", "[", 
   RowBox[{
    RowBox[{"g", "=", 
     RowBox[{"RandomGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", "3"}], "}"}], "]"}]}], ",", 
    RowBox[{"Method", "->", "\"\<RandomComplex\>\""}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9760332709814377`*^9, 3.9760332717964373`*^9}, {
   3.976052436622414*^9, 3.976052439526389*^9}, {3.976053007117465*^9, 
   3.976053008739801*^9}, {3.976053041474777*^9, 3.976053053541726*^9}, {
   3.976069066213396*^9, 3.976069066396285*^9}, {3.9760691088951473`*^9, 
   3.9760691130757837`*^9}, {3.9760700409732533`*^9, 3.97607004119112*^9}, 
   3.976070073049861*^9},
 CellLabel->"In[42]:=",ExpressionUUID->"41cddb19-6d9b-4e9e-8f71-4e5cccf6025d"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
