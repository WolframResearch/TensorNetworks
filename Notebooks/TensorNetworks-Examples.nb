Cell["\<\
In above trees, squares are initial tensors and circles are einsum operations \
performed in a particular way (ArrayDot, Dot, TensorContract or else)\
\>", "Text",
 CellChangeTimes->{{3.9777449300774517`*^9, 
  3.97774497398564*^9}},ExpressionUUID->"03c62898-a785-48a3-9aa3-\
bc331f60ed5d"],

Cell[TextData[{
 "We have added different ways of contracting each path:\n",
 StyleBox["ArrayDotTranspose",
  FontWeight->"Bold"],
 ": it uses ArrayDot[a, b, k] + Transpose + TensorProduct\n",
 StyleBox["Dot",
  FontWeight->"Bold"],
 ": it uses Dot + ArrayReshape + Transpose + TensorProduct\n",
 StyleBox["ArrayDot",
  FontWeight->"Bold"],
 ": it uses ArrayDot[a, b, pairs] + Transpose + TensorProduct\n",
 StyleBox["TensorContract",
  FontWeight->"Bold"],
 ": it uses TensorContract + TensorProduct\n",
 StyleBox["TableSum",
  FontWeight->"Bold"],
 ": it uses Table + Sum + Part"
}], "Text",
 CellChangeTimes->{{3.9776596622947598`*^9, 3.977659693477438*^9}, {
  3.977662047713414*^9, 3.977662053317801*^9}, {3.977662091622571*^9, 
  3.9776622695714693`*^9}},ExpressionUUID->"51aff810-77c1-412c-9391-\
d354e2fa162c"],

