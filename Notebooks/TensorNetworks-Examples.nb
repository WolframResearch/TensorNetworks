          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"TensorNetwork[{A\:2081,A\:2082,\[Ellipsis]}, {h\
\:2081,h\:2082,\[Ellipsis]}] creates a tensor network from tensors A\:1d62 \
