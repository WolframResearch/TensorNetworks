 RowBox[{"Graph", "[", 
  RowBox[{
   RowBox[{"tn", "[", "\"\<Graph\>\"", "]"}], ",", 
   RowBox[{"EdgeLabels", "->", "Automatic"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.976061333535881*^9, 3.9760613734048853`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"ef881530-08cf-4a91-81ae-2d4a5fb180bc"],

