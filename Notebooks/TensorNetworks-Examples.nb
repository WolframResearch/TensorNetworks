Cell[CellGroupData[{

Cell["Core Tensor Network Construction", "Section",
 CellChangeTimes->{{3.976068996864381*^9, 
  3.976068997211047*^9}},ExpressionUUID->"f8f5bb05-1bb2-4b58-8619-\
6391ebed81fc"],

Cell[TextData[{
 StyleBox["TensorNetwork",
  FontWeight->"Bold"],
 " creates a tensor network from tensors and their index structure. At a \
minimal level, one needs a list of tensor and some notation for indices that \
specify where contraction is being done. One can imagine a tensor network as ",
 StyleBox["Inactive[TensorContract][Inactive[TensorProduct][tensors],slots of \
contractions] ",
  FontWeight->"Bold"],
 "or an ",
 ButtonBox["Einstein summation expression",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/PacletRepository/resources/\
Wolfram/QuantumFramework/ref/EinsteinSummation.html"], None},
  ButtonNote->
   "https://resources.wolframcloud.com/PacletRepository/resources/Wolfram/\
QuantumFramework/ref/EinsteinSummation.html"],
 ".",
 StyleBox[" ",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{
  3.976061466587245*^9, {3.976062372315413*^9, 3.976062454445859*^9}, {
   3.9775219301205797`*^9, 3.977521966087789*^9}, {3.97758312324984*^9, 
   3.977583173016361*^9}},ExpressionUUID->"0c088655-7c83-42f8-8e8c-\
1c777e3cb78d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"t1", "=", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "-", "I"}], ",", 
       RowBox[{"1", "+", "I"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "2", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t2", "=", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "-", "I"}], ",", 
       RowBox[{"1", "+", "I"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t3", "=", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "-", "I"}], ",", 
       RowBox[{"1", "+", "I"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "3", ",", "2", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"tn", "=", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t1", ",", "t2", ",", "t3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", "3", ",", "2", ",", "5"}], "}"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.976061167173443*^9, 3.9760611897097473`*^9}, {
  3.976061223849712*^9, 3.976061332419392*^9}, {3.9760619292230177`*^9, 
  3.976061932255529*^9}, {3.976067734422771*^9, 3.976067754046397*^9}, {
