     RowBox[{"\"\<Optimal\>\"", ",", "\"\<flops\>\"", ",", "\"\<max\>\"", 
      ",", "\"\<size\>\"", ",", "\"\<write\>\"", ",", "\"\<combo\>\"", 
      ",", "\"\<limit\>\""}], "}"}]}], "]"}]}]], "Input",
