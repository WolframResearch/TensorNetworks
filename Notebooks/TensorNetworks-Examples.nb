      RowBox[{"tn2", ",", 
       RowBox[{"Method", "->", "#"}]}], "]"}], "&"}], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<Optimal\>\"", ",", "\"\<flops\>\"", ",", "\"\<max\>\"", 
