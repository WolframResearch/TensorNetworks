Cell[TextData[{
 "One can get the corresponding path-dependent contraction using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"TensorNetworkContraction", "[", 
    RowBox[{"NT", ",", "path"}], "]"}], TraditionalForm]],ExpressionUUID->
  "5e9f5d31-1ef0-4b85-aa51-1dcdd0b5a1e6"],
 " and then it can also be visualized using ",
 StyleBox["ContractionTree",
  FontWeight->"Bold"]
}], "Text",
