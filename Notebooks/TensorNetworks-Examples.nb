Cell[TextData[{
 StyleBox["SparseTensorNetwork",
  FontWeight->"Bold"],
 " converts tensors in a TN to SparseArray form for memory efficiency. but \
not sure if it is a good name because only replacing head might not help esp \
since tensors are generated by RandomComplex or RandomReal"
}], "Text",
