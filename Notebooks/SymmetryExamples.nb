Cell[CellGroupData[{

Cell["YoungProject", "Subsection",
 CellChangeTimes->{
  3.97854377415306*^9},ExpressionUUID->"3ab83ad4-68e5-49e7-9220-a49046f89731"],

Cell[TextData[{
 StyleBox["Purpose",
  FontWeight->"Bold"],
 ": Returns the normalized projection of a tensor onto a Young tableau \
symmetry class. The result is idempotent: applying twice gives the same \
result.\n\n",
 StyleBox["Input Patterns:",
  FontWeight->"Bold"],
 "\n",
 StyleBox["YoungProject[tensor, YoungTableau[...]]",
  FontWeight->"Bold"],
 "\tNormalized projection: (d/n!) * YoungSymmetrize[tensor, tab]\n\n",
 StyleBox["Normalization",
  FontWeight->"Bold"],
 ":\nFactor: d/n! where d = TableauDimension[tab] and n = number of boxes\n\
This makes the projector idempotent: P[P[T]] = P[T]"
}], "Text",
 CellChangeTimes->{{3.978543771776065*^9, 
  3.978543814673512*^9}},ExpressionUUID->"d6be7be1-ce44-4076-86ad-\
eb1bf94e843c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Example", " ", "1"}], ":", 
    RowBox[{"Project", " ", "onto", " ", "symmetric", " ", "subspace"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tensor2", "=", 
     RowBox[{"Array", "[", 
      RowBox[{"T", ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"YoungProject", "[", 
     RowBox[{"tensor2", ",", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", "2", "}"}], "]"}]}], "]"}], "==", 
    RowBox[{
     RowBox[{"1", "/", "2"}], 
     RowBox[{"(", 
      RowBox[{"tensor2", "+", 
       RowBox[{"Transpose", "[", "tensor2", "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Normalized", ":", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"2", "!"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"T", "+", 
         RowBox[{"T", "^", "T"}]}], ")"}]}]}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"T", "+", 
        RowBox[{"T", "^", "T"}]}], ")"}], "/", "2"}]}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.97854383536133*^9, 3.978543869872967*^9}},
 CellLabel->
  "In[140]:=",ExpressionUUID->"653f496b-13d7-45d0-91e5-ed60c43a5fde"],

