Cell[CellGroupData[{

Cell["HookLength", "Subsection",
 CellChangeTimes->{
  3.978535567961779*^9},ExpressionUUID->"8833115a-3a35-4ad9-badf-\
7653200a2e6b"],

Cell[TextData[{
 StyleBox["Purpose",
  FontWeight->"Bold"],
 ": Computes the hook length at a specific cell position. Used in the \
hook-length formula for irrep dimensions.\n\n",
 StyleBox["Input Patterns",
  FontWeight->"Bold"],
 ":\n",
 StyleBox["HookLength[YoungTableau[...], {row, col}]",
  FontWeight->"Bold"],
 "\tHook length at position (row, col)\n",
 StyleBox["Formula",
  FontWeight->"Bold"],
 ": hook(r,c) = (cells to right in row r) + (cells below in column c) + 1"
}], "Text",
 CellChangeTimes->{{3.9785355623092947`*^9, 
  3.978535612943677*^9}},ExpressionUUID->"63e39b87-62e2-4f0d-b14e-\
3b15d620aedc"],

