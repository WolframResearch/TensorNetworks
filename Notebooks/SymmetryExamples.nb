     RowBox[{"Check", " ", "if", " ", "tensor", " ", "has", " ", "specific", " ", 
      RowBox[{"symmetry", "--"}]}], "-"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Create", " ", "a", " ", "symmetric", " ", "tensor"}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"tSym", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", " ", "+", " ", "j", " ", "+", " ", "k"}], ")"}], "/", 
        "3."}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Project", " ", "onto", " ", "antisymmetric"}], "-", 
     RowBox[{"should", " ", "give", " ", "zero"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"antiPart", " ", "=", " ", 
     RowBox[{"YoungProject", "[", 
      RowBox[{"tSym", ",", " ", 
       RowBox[{"YoungTableau", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "]"}]}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"Flatten", "[", "antiPart", "]"}], "]"}], "]"}], " ", "<", " ", 
    
    RowBox[{"10", "^", 
     RowBox[{"-", "10"}]}]}], "  ", 
   RowBox[{"(*", 
    RowBox[{"True", "-", 
     RowBox[{"no", " ", "antisymmetric", " ", "component"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Project", " ", "onto", " ", "symmetric"}], "-", 
     RowBox[{"should", " ", "be", " ", "unchanged"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"symPart", " ", "=", " ", 
     RowBox[{"YoungProject", "[", 
      RowBox[{"tSym", ",", " ", 
       RowBox[{"YoungTableau", "[", 
        RowBox[{"{", "3", "}"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"tSym", " ", "-", " ", "symPart"}], "]"}], "]"}], "/", 
     RowBox[{"Norm", "[", 
      RowBox[{"Flatten", "[", "tSym", "]"}], "]"}]}], " ", "<", " ", "0.01", 
    "  ", 
    RowBox[{"(*", "True", "*)"}]}]}]}]], "Input",
