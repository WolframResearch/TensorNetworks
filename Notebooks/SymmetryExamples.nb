Cell[CellGroupData[{

Cell["YoungSymmetrize", "Subsection",
 CellChangeTimes->{
  3.978536710829617*^9},ExpressionUUID->"c65a23dc-d803-4409-8379-\
281d43b83d72"],

Cell[TextData[{
 StyleBox["Purpose",
  FontWeight->"Bold"],
 ": Projects a tensor onto the symmetry class defined by a Young tableau. \
First symmetrizes over rows, then antisymmetrizes over columns.\n\n",
 StyleBox["Input Patterns:",
  FontWeight->"Bold"],
 "\n",
 StyleBox["YoungSymmetrize[tensor, YoungTableau[...]]",
  FontWeight->"Bold"],
 "\tApply Young symmetrizer to tensor\n\n",
 StyleBox["Requirements",
  FontWeight->"Bold"],
 ":\ntensor must be an array (ArrayQ returns True)\nArrayDepth[tensor] must \
equal total number of boxes in tableau (TableauSize)\n\n",
 StyleBox["Algorithm",
  FontWeight->"Bold"],
 ":\n1. Symmetrize over each row - sum over all permutations\n2. Then \
antisymmetrize over each column - sum with signature\n\n",
 StyleBox["Critical",
  FontWeight->"Bold"],
 ": Operations are applied sequentially. The last operation (column \
antisymmetry) is always preserved. Earlier operations (row symmetry) may be \
destroyed by subsequent operations."
}], "Text",
 CellChangeTimes->{{3.978536707177627*^9, 3.9785367715433826`*^9}, {
  3.9785395170558643`*^9, 3.978539599790064*^9}, {3.978542826132333*^9, 
  3.978542887061607*^9}},ExpressionUUID->"2cf6cdbc-a79a-49cd-8626-\
a09dbb0c3a30"],

Cell[TextData[{
 StyleBox["Understanding Symmetry:",
  FontWeight->"Bold"],
 "\n- Symmetric tensor: T[i,j] == T[j,i] for all i,j. Verify: T == \
Transpose[T]\n- Antisymmetric tensor: T[i,j] == -T[j,i] for all i,j. Verify: \
T == -Transpose[T]\n- Antisymmetric tensors have zero diagonal: T[i,i] == 0"
}], "Text",
 CellChangeTimes->{{3.978536707177627*^9, 3.9785367715433826`*^9}, {
  3.9785395170558643`*^9, 3.978539599790064*^9}, {3.978542826132333*^9, 
  3.9785428271166067`*^9}},ExpressionUUID->"706417f6-72f2-48b7-b7d8-\
d17e62eaa819"],

Cell["\<\
SYMMETRIC TENSORS: YoungTableau[{n}] 
Single row = fully symmetric over all indices 

ANTISYMMETRIC TENSORS: YoungTableau[{1,1,...}]
Single column = fully antisymmetric \
\>", "Text",
 CellChangeTimes->{{3.978539835739798*^9, 
  3.9785398656325397`*^9}},ExpressionUUID->"c7c1b269-69ea-49e4-bdd5-\
499925ca4e37"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Fully", " ", "symmetrize", " ", "a", " ", "rank"}], "-", 
     RowBox[{"2", " ", "tensor", "\[IndentingNewLine]", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", "2", "}"}], "]"}]}]}], "=", 
    RowBox[{
     RowBox[{"single", " ", "row", " ", "with", " ", "2", " ", "boxes"}], "=", 
     RowBox[{"symmetric", " ", "in", " ", "indices", " ", 
