Cell["YoungTableau", "Subsection",
 CellChangeTimes->{{3.9785339200343246`*^9, 
  3.9785339308717413`*^9}},ExpressionUUID->"c546471f-a670-48da-8d79-\
ed0b1c776d75"],

Cell[TextData[{
 StyleBox["Purpose",
  FontWeight->"Bold"],
 ": Creates a Young tableau data structure that defines tensor index symmetry \
properties."
}], "Text",
 CellChangeTimes->{{3.9785345368615026`*^9, 
  3.978534538231247*^9}},ExpressionUUID->"a12494c3-fc33-409d-81cd-\
6ed12ba691cc"],

Cell[TextData[{
 StyleBox["YoungTableau[{{i1,i2,...}, {j1,j2,...}, ...}]",
  FontWeight->"Bold"],
 "\tExplicit row specification - each sublist is a row of slot indices\n",
 StyleBox["YoungTableau[{d1, d2, d3, ...}]",
  FontWeight->"Bold"],
 "\tPartition specification - creates standard tableau with d1 >= d2 >= d3 >= \
..."
}], "Text",
 CellChangeTimes->{{3.978533949359954*^9, 
  3.978533968588702*^9}},ExpressionUUID->"887ad985-a6ff-493f-97c9-\
6cce1b21d304"],

Cell[TextData[{
 StyleBox["Validation Rules:",
  FontWeight->"Bold"],
 "\n- Row lengths must be non-increasing (partition condition)\n- All entries \
must be distinct positive integers\n- All integers from 1 to n must appear \
exactly once (standard tableau)"
}], "Text",
 CellChangeTimes->{{3.978533998467997*^9, 
  3.978534009342856*^9}},ExpressionUUID->"569be8ad-46ca-4d85-8b1f-\
9f2d3fc30b15"],

