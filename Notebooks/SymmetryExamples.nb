Cell[CellGroupData[{

Cell["TableauDimension", "Subsection",
 CellChangeTimes->{
  3.9785359436248217`*^9},ExpressionUUID->"28a3a1a3-c9ee-4f6c-ae3e-\
1574b9adf07d"],

Cell[TextData[{
 StyleBox["Purpose",
  FontWeight->"Bold"],
 ": Computes the dimension of the irreducible representation corresponding to \
a Young tableau.\n\n",
 StyleBox["Input Patterns:",
  FontWeight->"Bold"],
 "\n",
 StyleBox["TableauDimension[YoungTableau[...]]",
  FontWeight->"Bold"],
 "\tDimension using hook-length formula\n\n",
 StyleBox["Formula",
  FontWeight->"Bold"],
 ": d = n! / Product[HookLength[tab,{r,c}], all cells]"
}], "Text",
 CellChangeTimes->{{3.9785359392176523`*^9, 
  3.978535996422188*^9}},ExpressionUUID->"f67e483f-32e6-452b-81eb-\
701acb086bc8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tableauDimension", "[", "tab_", "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"shape", "=", 
      RowBox[{"TableauShape", "[", "tab", "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Total", "[", "shape", "]"}], "!"}], "/", 
     RowBox[{"Times", "@@", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"HookLength", "[", 
          RowBox[{"tab", ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "c"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", 
           RowBox[{"Length", "@", "shape"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c", ",", 
           RowBox[{"shape", "[", 
            RowBox[{"[", "r", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.978536465706287*^9, 3.978536492929431*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"fac14225-954f-4464-a9b2-d44c9567d700"],

