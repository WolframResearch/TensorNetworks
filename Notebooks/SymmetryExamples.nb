    RowBox[{"Example", " ", "1"}], ":", 
    RowBox[{
     RowBox[{"Fully", " ", "symmetric"}], "-", 
     RowBox[{"single", " ", "row"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"TableauDimension", "[", 
    RowBox[{"YoungTableau", "[", 
