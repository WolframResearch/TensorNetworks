Cell["YoungSymmetrize-Tensor Symmetrization", "Text",
 CellChangeTimes->{
  3.978525677227119*^9},ExpressionUUID->"e4b2f06b-9e61-42b5-87e2-\
1a73dbdc0311"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Example"}]}], " ", "1"}], ":", 
    RowBox[{
     RowBox[{"Fully", " ", "symmetric", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"single", " ", "row"}], ")"}], "--"}]}], "-"}]}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"t3", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{"1", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"tab3Sym", " ", "=", " ", 
    RowBox[{"YoungTableau", "[", 
     RowBox[{"{", "3", "}"}], "]"}]}], "  ", 
   RowBox[{"(*", 
    RowBox[{"Fully", " ", "symmetric"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"tSymmetric", " ", "=", " ", 
     RowBox[{"YoungSymmetrize", "[", 
      RowBox[{"t3", ",", " ", "tab3Sym"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Verify", " ", 
     RowBox[{"symmetry", ":", 
      RowBox[{
      "all", " ", "permutations", " ", "give", " ", "same", " ", 
       "result"}]}]}], "*)"}], "\n", 
   RowBox[{"tSymmetric", " ", "===", " ", 
    RowBox[{"Transpose", "[", 
     RowBox[{"tSymmetric", ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}]}], "    ", 
   
   RowBox[{"(*", "True", "*)"}], "\n", 
   RowBox[{"tSymmetric", " ", "===", " ", 
    RowBox[{"Transpose", "[", 
     RowBox[{"tSymmetric", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3", ",", " ", "2"}], "}"}]}], "]"}]}], "    ", 
   
   RowBox[{"(*", "True", "*)"}], "\n", 
   RowBox[{"tSymmetric", " ", "===", " ", 
    RowBox[{"Transpose", "[", 
     RowBox[{"tSymmetric", ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2", ",", " ", "1"}], "}"}]}], "]"}], "    ", 
    RowBox[{"(*", "True", "*)"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9785246191846943`*^9, 3.978524619185787*^9}, {
