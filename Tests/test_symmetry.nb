Cell["", "Section",ExpressionUUID->"06873f2d-3454-489a-b045-92b3558f27a5"],

Cell["\<\
VerificationTest[
    qA = {0, 1, -1};
    qB = {0, -1, 1};
    allowed = AllowedContractions[qA, qB];
    Sort[allowed] === Sort[{{1, 1}, {2, 2}, {3, 3}}],
    True,
    TestID -> \"AllowedContractions_SimpleCharges\"
]\
\>", "Input",ExpressionUUID->"09ae8290-33fa-46b9-8035-2125c115c078"],

Cell["\<\
VerificationTest[
    cvA = ChargeVector[{0, 1, -1}];
    cvB = ChargeVector[{0, -1, 1}];
    allowed = AllowedContractions[cvA, cvB];
    Sort[allowed] === Sort[{{1, 1}, {2, 2}, {3, 3}}],
    True,
    TestID -> \"AllowedContractions_ChargeVectors\"
]\
\>", "Input",ExpressionUUID->"65e2702b-9dde-4279-8052-398d5748a76e"],

Cell["\<\
VerificationTest[
    qA = {1, 2, 3};
    qB = {-1, -2, -3};
    allowed = AllowedContractions[qA, qB];
    Sort[allowed] === Sort[{{1, 1}, {2, 2}, {3, 3}}],
    True,
    TestID -> \"AllowedContractions_NonZeroCharges\"
]\
\>", "Input",ExpressionUUID->"0cef8f2b-aa7f-4b18-87f8-1ff823805c07"],

Cell["\<\
VerificationTest[
    qA = {0, 0, 0};
    qB = {0, 0, 0};
    allowed = AllowedContractions[qA, qB];
    Length[allowed] == 9,  (* All pairs allowed *)
    True,
    TestID -> \"AllowedContractions_AllZero\"
]\
\>", "Input",ExpressionUUID->"10c083ef-053a-40b8-80f1-b40b8dca4ba0"],

Cell["\<\
VerificationTest[
    qA = {1, 2, 3};
    qB = {4, 5, 6};  (* No pairs sum to zero *)
    allowed = AllowedContractions[qA, qB];
    allowed === {},
    True,
    TestID -> \"AllowedContractions_NoAllowed\"
]\
\>", "Input",ExpressionUUID->"b2a39058-d244-4693-bd3e-fe1f41f83e3f"],

Cell["", "Section",ExpressionUUID->"2fdd903c-df3c-4afc-a078-600800c22cb3"],

Cell["\<\
VerificationTest[
    ChargesConservedQ[{1, -1, 0}, {-1, 1, 0}],
    True,
    TestID -> \"ChargesConservedQ_Conserved\"
]\
\>", "Input",ExpressionUUID->"80b19092-0b72-4fbd-951f-ca7d3d7b1977"],

Cell["\<\
VerificationTest[
    ChargesConservedQ[{1, 2, 3}, {1, 2, 3}],
    False,
    TestID -> \"ChargesConservedQ_NotConserved\"
]\
\>", "Input",ExpressionUUID->"05766246-794a-46fc-a331-b6c262a1dea7"],

Cell["\<\
VerificationTest[
    cvA = ChargeVector[{1, -1}];
    cvB = ChargeVector[{-1, 1}];
    ChargesConservedQ[cvA, cvB],
    True,
    TestID -> \"ChargesConservedQ_ChargeVectors\"
]\
\>", "Input",ExpressionUUID->"375ca39e-da29-40b8-b4c3-5b18b5c30bb7"],

Cell["", "Section",ExpressionUUID->"a4a5e2fb-c73c-495b-8e2c-0934c3e81fb2"],

Cell["\<\
VerificationTest[
    cv = ChargeVector[{0, 1, 0, -1, 0}];
    indices = IndicesWithCharge[cv, 0];
    Sort[indices] === {1, 3, 5},
    True,
    TestID -> \"IndicesWithCharge_ChargeZero\"
]\
\>", "Input",ExpressionUUID->"06b1a673-ad4f-45b5-a315-72942d37d763"],

Cell["\<\
VerificationTest[
    cv = ChargeVector[{0, 1, 0, -1, 0}];
    indices = IndicesWithCharge[cv, 1];
    indices === {2},
    True,
    TestID -> \"IndicesWithCharge_ChargeOne\"
]\
\>", "Input",ExpressionUUID->"56e876df-1b03-44e8-8cb7-37f07e92a690"],

Cell["\<\
VerificationTest[
    charges = {0, 1, 0, -1, 0};
    indices = IndicesWithCharge[charges, -1];
    indices === {4},
    True,
    TestID -> \"IndicesWithCharge_PlainList\"
]\
\>", "Input",ExpressionUUID->"3b032824-a864-4893-a129-7b001c981af1"],

Cell["\<\
VerificationTest[
    cv = ChargeVector[{1, 2, 3}];
    indices = IndicesWithCharge[cv, 5];  (* Charge not present *)
    indices === {},
    True,
    TestID -> \"IndicesWithCharge_NotFound\"
]\
\>", "Input",ExpressionUUID->"576ce648-75be-4acd-a632-a0eb2d360bf0"],

Cell["", "Section",ExpressionUUID->"57ba7abe-608f-4cce-b604-22a24654d960"],

Cell["\<\
VerificationTest[
    cv = ChargeVector[{1, 2, 3}];
    negated = -cv;
    ChargeVectorQ[negated] && negated[[1]] === {-1, -2, -3},
    True,
    TestID -> \"ChargeVector_Negation\"
]\
\>", "Input",ExpressionUUID->"10036b03-215f-4d1a-aab1-a4d7578c46f3"],

Cell["", "Section",ExpressionUUID->"f0e8707e-2a40-4d5b-9457-abe4c68febc6"],

Cell["\<\
VerificationTest[
    (* Symmetry-filtered contraction should give same result as ArrayDot *)
    (* Note: This test only runs if SymmetryFiltered method is available *)
    If[MemberQ[$TensorNetworkContractionMethods, \"SymmetryFiltered\"],
        Module[{dim = 10, A, B, charges, tn, indexCharges, resultArrayDot, \
resultSymFiltered},
            A = RandomReal[{-1, 1}, {dim, dim}];
            B = RandomReal[{-1, 1}, {dim, dim}];
            charges = Mod[Range[dim], 3] - 1;
            tn = TensorNetwork[{A, B}, {{1, 3}, {3, 2}}, {1, 2}];
            indexCharges = <|3 -> charges|>;
            resultArrayDot = TensorNetworkContract[tn, \"Optimal\", Method -> \
\"ArrayDot\"];
            resultSymFiltered = TensorNetworkContract[tn, \"Optimal\",
                Method -> \"SymmetryFiltered\",
                \"IndexCharges\" -> indexCharges
            ];
            Max[Abs[resultArrayDot - resultSymFiltered]] < 10^-10
        ],
        True  (* Skip test if method not available *)
    ],
    True,
    TestID -> \"SymmetryFiltered_Integration_Consistent\"
]\
\>", "Input",ExpressionUUID->"3241a2f8-a083-4611-bd80-e760aa8d499f"]
},
