Cell["\<\
VerificationTest[
    (* Standard tableau {2,1}: dimension should be 2 *)
    yt = YoungTableau[{2, 1}];
    TableauDimension[yt],
    2,
    TestID -> \"TableauDimension_Partition21\"
]\
\>", "Input",ExpressionUUID->"0bb3694d-2359-4a8d-8217-af9ba26dcd3d"],

Cell["\<\
VerificationTest[
    (* Standard tableau {3}: dimension should be 1 (totally symmetric) *)
    yt = YoungTableau[{3}];
    TableauDimension[yt],
    1,
    TestID -> \"TableauDimension_TotallySymmetric\"
]\
\>", "Input",ExpressionUUID->"22c127b5-4ce1-47cc-9441-02a7f451b890"],

Cell["\<\
VerificationTest[
    (* Standard tableau {1,1,1}: dimension should be 1 (totally \
antisymmetric) *)
