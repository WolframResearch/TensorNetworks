Cell["\<\
VerificationTest[
    yt = YoungTableau[{{1, 2, 3}, {4, 5}}];
    HookLength[yt, {1, 1}],
    4,  (* 3 to the right + 1 below *)
    TestID -> \"HookLength_TopLeftCorner\"
]\
\>", "Input",ExpressionUUID->"c751a519-0f51-4c17-99d2-a4c42673a4af"],

Cell["\<\
VerificationTest[
    yt = YoungTableau[{{1, 2, 3}, {4, 5}}];
    HookLength[yt, {1, 3}],
    1,  (* Corner box *)
    TestID -> \"HookLength_Corner\"
]\
\>", "Input",ExpressionUUID->"e61aaa9f-3a30-47b3-b9cd-3d32f7703e3a"],

Cell["\<\
VerificationTest[
    yt = YoungTableau[{{1, 2, 3}, {4, 5}}];
    HookLength[yt, {2, 1}],
    2,  (* 2 to the right, 0 below *)
    TestID -> \"HookLength_SecondRow\"
]\
\>", "Input",ExpressionUUID->"344a6ba3-96cf-4ac0-9c0f-c11e7a222ff9"],

Cell["\<\
VerificationTest[
