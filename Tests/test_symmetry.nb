Notebook[{
Cell["test_symmetry", "Title",ExpressionUUID->"9a2a9c86-384f-4cd7-bd7a-7f07b1d91748"],

Cell["\<\
Comprehensivetests for Symmetry module (YoungTableaux.wl and \
QuantumNumbers.wl)\
\>", "Subtitle",ExpressionUUID->"dda94891-6661-4db4-929b-d66f492a289e"],

Cell["\<\
(* Tests/test_symmetry.wl *)
(* Comprehensive tests for Symmetry module (YoungTableaux.wl and \
QuantumNumbers.wl) *)

Get[FileNameJoin[{DirectoryName[$InputFileName], \"test_setup.wl\"}]];

(* Load the Symmetry subpackage *)
Needs[\"Wolfram`TensorNetworks`Symmetry`\"];\
\>", "Input",
 InitializationCell->
  True,ExpressionUUID->"4710ef08-685e-4c3c-97e7-c5c9243caccf"],

Cell["", "Section",ExpressionUUID->"f44505c3-4eae-4f56-bd4e-911d14ec6a83"],

Cell["\<\
VerificationTest[
    yt = YoungTableau[{{1, 2, 3}, {4, 5}}];
    YoungTableauQ[yt],
    True,
    TestID -> \"YoungTableau_Constructor_Explicit\"
]\
\>", "Input",ExpressionUUID->"f4926c74-dcb5-403c-aace-bb747fdf5a36"],

Cell["\<\
VerificationTest[
    (* Construct from partition *)
