    TestID -> \"TensorNetworkQ_InvalidInput_Number\"
]\
\>", "Input",ExpressionUUID->"8e426674-4f78-429d-b4e4-21887a3f3e91"],

Cell["\<\
VerificationTest[
    (* Mismatched tensor dimensions and hyperedges *)
    TensorNetworkQ[TensorNetwork[{RandomReal[{-1, 1}, {2, 3}]}, {{1, 2, \
3}}]],
    False,
    TestID -> \"TensorNetworkQ_MismatchedDimensions\"
]\
\>", "Input",ExpressionUUID->"9e1f8b34-0946-496a-9e04-d0536c7d877a"],

Cell["", "Section",ExpressionUUID->"a0ebc41d-153c-4779-aaf8-3aac6d776861"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {IdentityMatrix[3], RandomReal[{-1, 1}, {3, 4, 5}]},
        {{1, 2}, {2, 3, 4}}
    ];
    tn[\"Tensors\"] // Length,
    2,
    TestID -> \"TensorNetwork_Property_Tensors\"
]\
\>", "Input",ExpressionUUID->"18b7695e-62bf-4e06-b68d-c4fca2cdecaa"],

