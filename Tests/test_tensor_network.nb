Notebook[{
Cell["test_tensor_network", "Title",ExpressionUUID->"5d3fc592-e295-43a7-81f4-541a4b562f4f"],

Cell["Comprehensivetests for TensorNetwork.wl", "Subtitle",ExpressionUUID->"f71ce9ed-1079-4fb2-a6fb-c617b76581cb"],

Cell["\<\
(* Tests/test_tensor_network.wl *)
(* Comprehensive tests for TensorNetwork.wl *)

Get[FileNameJoin[{DirectoryName[$InputFileName], \"test_setup.wl\"}]];\
\>", "Input",
 InitializationCell->
  True,ExpressionUUID->"abc10b07-898e-4ae2-a96a-1b091c765907"],

Cell["", "Section",ExpressionUUID->"8ea240c9-fa94-4dbf-9c47-1671ccdae6f8"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}], RandomReal[{-1, 1}, {3, 4}]},
        {{1, 2}, {2, 3}}
    ];
    TensorNetworkQ[tn],
    True,
    TestID -> \"TensorNetwork_Constructor_TwoArguments\"
]\
\>", "Input",ExpressionUUID->"e3099b27-be4f-4b71-a4d1-b41d569d298b"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}], RandomReal[{-1, 1}, {3, 4}]},
        {{1, 2}, {2, 3}},
        {1, 3}
    ];
    tn[\"Output\"],
    {1, 3},
    TestID -> \"TensorNetwork_Constructor_ThreeArguments_ExplicitOutput\"
]\
\>", "Input",ExpressionUUID->"b9256ec0-4429-426d-9efa-f930e659ede1"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}], RandomReal[{-1, 1}, {3, 4}]},
        {{1, 2}, {2, 3}},
        Automatic
    ];
    tn[\"Output\"],
    Automatic,
    TestID -> \"TensorNetwork_Constructor_AutomaticOutput\"
]\
\>", "Input",ExpressionUUID->"c92bce69-034b-41a8-bac2-3d4e5f050a6e"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}], RandomReal[{-1, 1}, {3, 4}]},
        {{1, 2}, {2, 3}},
        Cycles[{{1, 2}}]
    ];
    tn[\"FreeIndices\"],
    {3, 1},
    TestID -> \"TensorNetwork_Constructor_CyclesPermutation\"
]\
\>", "Input",ExpressionUUID->"acbc2233-e18f-4778-bb28-b2a0afa1daff"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}], RandomReal[{-1, 1}, {3, 4}]},
        {{1, 2}, {2, 3}} -> {3, 1}
    ];
    tn[\"FreeIndices\"],
    {3, 1},
    TestID -> \"TensorNetwork_Constructor_RuleForm\"
]\
\>", "Input",ExpressionUUID->"466ea776-d560-4c04-aa9a-0e0f1f7281ce"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[{{1, 2}, {2, 3}}];
    TensorNetworkQ[tn],
    True,
    TestID -> \"TensorNetwork_Constructor_HypergraphOnly\"
]\
\>", "Input",ExpressionUUID->"130d3e34-b442-4faa-b767-8b299f17a216"],

Cell["", "Section",ExpressionUUID->"1ef485be-b66c-467d-aecb-65a1c0f72866"],

Cell["\<\
VerificationTest[
    TensorNetworkQ[TensorNetwork[{RandomReal[{-1, 1}, {2, 3}]}, {{1, 2}}]],
    True,
    TestID -> \"TensorNetworkQ_ValidNetwork\"
]\
\>", "Input",ExpressionUUID->"99a1cf9f-6e57-4b9a-94ac-0f202bef4c95"],

Cell["\<\
VerificationTest[
    (* Empty network - behavior depends on implementation *)
    TensorNetworkQ[TensorNetwork[{}, {}, {}]],
    True,
    TestID -> \"TensorNetworkQ_EmptyNetwork\"
]\
\>", "Input",ExpressionUUID->"107f38ab-9be0-4170-bafb-fd9326290cc5"],

Cell["\<\
VerificationTest[
    TensorNetworkQ[\"not a tensor network\"],
