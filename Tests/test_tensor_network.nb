Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}]},
        {{1, 2}}
    ];
    newTensor = RandomReal[{-1, 1}, {3, 4}];
    tnAdded = TensorNetworkAdd[tn, newTensor, {2, 3}];
    TensorNetworkSize[tnAdded],
    2,
    TestID -> \"TensorNetworkAdd_IncreasesSize\"
]\
\>", "Input",ExpressionUUID->"5926c7b7-ec0b-4d8b-9b89-50294f4f36ee"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}]},
        {{1, 2}},
        {1, 2}
    ];
    newTensor = RandomReal[{-1, 1}, {3, 4}];
    tnAdded = TensorNetworkAdd[tn, newTensor, {2, 3}];
    Sort[tnAdded[\"FreeIndices\"]],
    {1, 3},
    TestID -> \"TensorNetworkAdd_UpdatesFreeIndices\"
]\
\>", "Input",ExpressionUUID->"3c2badb6-9b9f-4c7b-ac93-e8dbbc2fd19a"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}]},
        {{1, 2}},
        {1, 2}
    ];
    newTensor = RandomReal[{-1, 1}, {4, 5}];
    tnAdded = TensorNetworkAdd[tn, newTensor, {3, 4}];
    Sort[tnAdded[\"FreeIndices\"]],
    {1, 2, 3, 4},
    TestID -> \"TensorNetworkAdd_NoContraction\"
]\
\>", "Input",ExpressionUUID->"766c8d87-d3c0-495b-8cfe-af11b2582f26"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}]},
        {{1, 2}},
        {1, 2}
    ];
    newTensor = RandomReal[{-1, 1}, {2, 3}];
    tnAdded = TensorNetworkAdd[tn, newTensor, {1, 2}];
    tnAdded[\"FreeIndices\"],
    {},
    TestID -> \"TensorNetworkAdd_FullContraction\"
]\
\>", "Input",ExpressionUUID->"b9d5af64-2d3d-4b9c-b5ff-ef9b6049fabc"],

Cell["", "Section",ExpressionUUID->"fadae8c6-f20f-40ef-a583-91dcf4b0855c"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}], RandomReal[{-1, 1}, {3, 4}]},
        {{1, 2}, {2, 3}}
    ];
    tnDeleted = TensorNetworkDelete[tn, -1];
    TensorNetworkSize[tnDeleted],
    1,
    TestID -> \"TensorNetworkDelete_DecreasesSize\"
]\
\>", "Input",ExpressionUUID->"a1b753a5-d729-404a-a614-d3a1e0347fb6"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}], RandomReal[{-1, 1}, {3, 4}]},
        {{1, 2}, {2, 3}}
    ];
    tnDeleted = TensorNetworkDelete[tn, 1];
    TensorNetworkSize[tnDeleted],
    1,
    TestID -> \"TensorNetworkDelete_FirstTensor\"
]\
\>", "Input",ExpressionUUID->"7ca08514-96ee-4833-be60-6b52cfa8760b"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2}], RandomReal[{-1, 1}, {3}], RandomReal[{-1, \
1}, {4}]},
        {{1}, {2}, {3}},
        {3, 2, 1}
    ];
    tnDeleted = TensorNetworkDelete[tn, 2];
    tnDeleted[\"FreeIndices\"],
    {3, 1},
    TestID -> \"TensorNetworkDelete_UpdatesFreeIndices\"
]\
\>", "Input",ExpressionUUID->"4bde5b71-c61c-4623-aa5a-2fd9cb6cc13b"],

Cell["\<\
VerificationTest[
    (* Single tensor network *)
    tn = TensorNetwork[{RandomReal[{-1, 1}, {2, 3, 4}]}, {{1, 2, 3}}];
    TensorNetworkQ[tn] && TensorNetworkSize[tn] == 1,
    True,
    TestID -> \"TensorNetwork_SingleTensor\"
]\
\>", "Input",ExpressionUUID->"0e1de847-de37-4481-b8c7-6fd72cc5bb08"],

Cell["\<\
VerificationTest[
    (* Large network *)
    rtn = RandomTensorNetwork[{20, 30}, 2, 2];
    TensorNetworkQ[rtn] && TensorNetworkSize[rtn] == 20,
    True,
    TestID -> \"TensorNetwork_LargeNetwork\"
]\
\>", "Input",ExpressionUUID->"ff79e2fe-d51b-461a-86a2-eb231a95bb48"],

Cell["\<\
VerificationTest[
    (* Complex-valued tensor network *)
    tn = TensorNetwork[
        {RandomComplex[{-1 - I, 1 + I}, {2, 3}], RandomComplex[{-1 - I, 1 + \
I}, {3, 4}]},
        {{1, 2}, {2, 3}}
    ];
    TensorNetworkQ[tn],
    True,
    TestID -> \"TensorNetwork_ComplexTensors\"
]\
\>", "Input",ExpressionUUID->"68d13589-6e33-49fc-8b47-a2c6d8025dd8"],

Cell["\<\
VerificationTest[
    (* Network with vectors *)
    tn = TensorNetwork[{RandomReal[{-1, 1}, {3}], RandomReal[{-1, 1}, {3, \
4}]}, {{1}, {1, 2}}];
    TensorNetworkQ[tn],
    True,
    TestID -> \"TensorNetwork_VectorTensor\"
]\
\>", "Input",ExpressionUUID->"8c185b78-19e5-4f6a-8920-43f9bdb79b43"]
},
FrontEndVersion->"14.3 for Mac OS X ARM (64-bit) (July 22, 2025)",
