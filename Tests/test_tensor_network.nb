Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}], RandomReal[{-1, 1}, {3, 4}]},
        {{1, 2}, {2, 3}}
    ];
    BinaryTensorNetworkQ[tn],
    True,
    TestID -> \"BinaryTensorNetworkQ_IsBinary\"
]\
\>", "Input",ExpressionUUID->"3bcbe4d3-7853-46b8-8855-337a650acf78"],

Cell["\<\
VerificationTest[
    (* Hyperedge with 3 connections is not binary *)
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}], RandomReal[{-1, 1}, {3, 4}], \
RandomReal[{-1, 1}, {4, 3}]},
        {{1, 2}, {2, 3}, {3, 2}}
    ];
    BinaryTensorNetworkQ[tn],
    False,
    TestID -> \"BinaryTensorNetworkQ_NotBinary\"
]\
\>", "Input",ExpressionUUID->"38987d14-846b-4e03-8dac-42be1a44ae66"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}], RandomReal[{-1, 1}, {3, 4}]},
        {{1, 2}, {2, 3}}
    ];
    btn = BinaryTensorNetwork[tn];
    TensorNetworkQ[btn],
    True,
    TestID -> \"BinaryTensorNetwork_PreservesValidity\"
]\
\>", "Input",ExpressionUUID->"0fc891f0-a278-41fd-aa14-05a5701681d2"],

Cell["", "Section",ExpressionUUID->"2b078f80-1bc9-4c42-bce4-f58b35e27ced"],

