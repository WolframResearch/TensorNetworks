    {1, 2},
    TestID -> \"TensorNetworkData_Vertices\"
]\
\>", "Input",ExpressionUUID->"9da54870-32f8-44e5-bd36-cb52a35efdf4"],

Cell["", "Section",ExpressionUUID->"d1114361-9bf6-40d0-8820-8b65427aaf56"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}], RandomReal[{-1, 1}, {3, 4}]},
        {{1, 2}, {2, 3}}
    ];
