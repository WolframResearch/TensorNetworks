Cell["\<\
VerificationTest[
    tn = TensorNetwork[
        {RandomReal[{-1, 1}, {2, 3}], RandomReal[{-1, 1}, {3, 4}]},
        {{1, 2}, {2, 3}}
    ];
    data = TensorNetworkData[tn];
    AssociationQ[data] && KeyExistsQ[data, \"Tensors\"] && KeyExistsQ[data, \
\"Hyperedges\"],
    True,
    TestID -> \"TensorNetworkData_ReturnsAssociation\"
]\
\>", "Input",ExpressionUUID->"5e3b113c-4ce4-47d5-ad4c-27710ae7240a"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[
