Notebook[{
Cell["test_contraction_comprehensive", "Title",ExpressionUUID->"44c99070-b1ce-4446-9802-d70d42a68317"],

Cell["\<\
Comprehensivetests for Contraction.wl - ALL patterns, ALL options, EXACT \
verification\
\>", "Subtitle",ExpressionUUID->"ef2818a4-79a2-413b-b40a-a099f5621350"],

Cell["\<\
(* Tests/test_contraction_comprehensive.wl *)
(* Comprehensive tests for Contraction.wl - ALL patterns, ALL options, EXACT \
verification *)

Get[FileNameJoin[{DirectoryName[$InputFileName], \"test_setup.wl\"}]];\
\>", "Input",
 InitializationCell->
  True,ExpressionUUID->"6e7e04c5-c9e2-4ba4-9a34-9d195230ca95"],

Cell["\<\
VerificationTest[
    A = RandomReal[{-1, 1}, {2, 3}];
    B = RandomReal[{-1, 1}, {3, 4}];
    tn = TensorNetwork[{A, B}, {{1, 2}, {2, 3}}];
    path = TensorNetworkFindContractionPath[tn];
    {
        CanonicalPathQ[path],
        ListQ[path],
        AllTrue[path, MatchQ[#, {_Integer, _Integer}] &]
    },
    {True, True, True},
    TestID -> \"FindContractionPath_FromTensorNetwork_ReturnsCanonicalPath\"
]\
\>", "Input",ExpressionUUID->"81ba4580-d5da-43d4-baf2-f306f8d6e01f"],

Cell["\<\
VerificationTest[
    A = RandomReal[{-1, 1}, {2, 3}];
    B = RandomReal[{-1, 1}, {3, 4}];
    T3 = RandomReal[{-1, 1}, {4, 5}];  (* Renamed from C to avoid conflict \
with built-in *)
    tn = TensorNetwork[{A, B, T3}, {{1, 2}, {2, 3}, {3, 4}}];
    path = TensorNetworkFindContractionPath[tn, Method -> \"Optimal\"];
    {
        CanonicalPathQ[path],
        Length[path] === 2  (* 3 tensors -> 2 contractions *)
    },
    {True, True},
    TestID -> \"FindContractionPath_Method_Optimal\"
]\
\>", "Input",ExpressionUUID->"1045d0a7-7445-4094-9704-b19affeb389d"],

Cell["\<\
VerificationTest[
    A = RandomReal[{-1, 1}, {2, 3}];
    B = RandomReal[{-1, 1}, {3, 4}];
    T3 = RandomReal[{-1, 1}, {4, 5}];  (* Renamed from C to avoid conflict \
with built-in *)
    tn = TensorNetwork[{A, B, T3}, {{1, 2}, {2, 3}, {3, 4}}];
    path = TensorNetworkFindContractionPath[tn, Method -> \"Greedy\"];
    {
        CanonicalPathQ[path],
        Length[path] === 2
    },
    {True, True},
    TestID -> \"FindContractionPath_Method_Greedy\"
]\
\>", "Input",ExpressionUUID->"68c3e786-8f83-4588-9725-a9357dd9cc62"],

Cell["\<\
VerificationTest[
    A = RandomReal[{-1, 1}, {2, 3}];
    B = RandomReal[{-1, 1}, {3, 4}];
    tn = TensorNetwork[{A, B}, {{1, 2}, {2, 3}}];
    pathSize = TensorNetworkFindContractionPath[tn, Method -> \"size\"];
    pathFlops = TensorNetworkFindContractionPath[tn, Method -> \"flops\"];
    {
        CanonicalPathQ[pathSize],
        CanonicalPathQ[pathFlops]
    },
    {True, True},
    TestID -> \"FindContractionPath_Method_SizeAndFlops\"
]\
\>", "Input",ExpressionUUID->"e8c6c9ea-5555-4008-96b3-d4179918b9ed"],

Cell["\<\
VerificationTest[
    A = RandomReal[{-1, 1}, {2, 3}];
    B = RandomReal[{-1, 1}, {3, 4}];
    tn = TensorNetwork[{A, B}, {{1, 2}, {2, 3}}];
    result = TensorNetworkFindContractionPath[tn, \"ReturnParameters\" -> \
False];
    CanonicalPathQ[result],
    True,
    TestID -> \"FindContractionPath_ReturnParameters_False\"
]\
\>", "Input",ExpressionUUID->"b567ae27-930c-4a0a-abd9-3804add549ff"],

Cell["\<\
VerificationTest[
    A = RandomReal[{-1, 1}, {2, 3}];
    B = RandomReal[{-1, 1}, {3, 4}];
    tn = TensorNetwork[{A, B}, {{1, 2}, {2, 3}}];
    result = TensorNetworkFindContractionPath[tn, \"ReturnParameters\" -> \
True];
    {
        ListQ[result],
        Length[result] === 3,
        ListQ[result[[1]]],   (* input *)
        ListQ[result[[2]]],   (* output *)
        AssociationQ[result[[3]]]  (* dimensions *)
    },
    {True, True, True, True, True},
    TestID -> \"FindContractionPath_ReturnParameters_True_Structure\"
]\
\>", "Input",ExpressionUUID->"7d47e58a-a54e-4be2-8735-8abca558dfc7"],

Cell["\<\
VerificationTest[
    A = RandomReal[{-1, 1}, {2, 3}];
    B = RandomReal[{-1, 1}, {3, 4}];
    tn = TensorNetwork[{A, B}, {{1, 2}, {2, 3}}];
    {input, output, dimensions} = TensorNetworkFindContractionPath[tn, \
\"ReturnParameters\" -> True];
    {
        Length[input] === 2,  (* Two tensors *)
        Length[dimensions] > 0
    },
    {True, True},
    TestID -> \"FindContractionPath_ReturnParameters_True_Content\"
]\
\>", "Input",ExpressionUUID->"147533e8-e3f8-432b-921a-803d35aaaa7d"],

