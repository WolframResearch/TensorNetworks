Cell["\<\
VerificationTest[
    mps = RandomTensorNetwork[\"MPS\"[5, 4, 2]];
    {
        TensorNetworkQ[mps],
        Length[mps[\"Tensors\"]] === 5
    },
    {True, True},
    TestID -> \"RandomTensorNetwork_MPS_Basic\"
]\
\>", "Input",ExpressionUUID->"461638fb-ddf5-4c11-8b8a-dbfa094ea9dc"],

Cell["\<\
VerificationTest[
    mps = RandomTensorNetwork[\"MPS\"[5, 4, 2], \"Boundary\" -> \"Open\"];
    ranks = mps[\"Ranks\"];
    {
        ranks[[1]] === 2,   (* First tensor: {bond, physical} *)
        ranks[[-1]] === 2,  (* Last tensor: {bond, physical} *)
        AllTrue[ranks[[2 ;; -2]], # === 3 &]  (* Bulk: {left, right, \
physical} *)
    },
    {True, True, True},
    TestID -> \"RandomTensorNetwork_MPS_Open_Ranks\"
]\
\>", "Input",ExpressionUUID->"6ec665f5-c6e0-4783-a3da-769a4a66f24f"],

Cell["\<\
VerificationTest[
    mps = RandomTensorNetwork[\"MPS\"[5, 4, 2], \"Boundary\" -> \
\"Periodic\"];
    ranks = mps[\"Ranks\"];
    AllTrue[ranks, # === 3 &],  (* All rank-3 for periodic *)
    True,
    TestID -> \"RandomTensorNetwork_MPS_Periodic_AllRank3\"
]\
\>", "Input",ExpressionUUID->"6f62e724-8375-4606-9f1c-147660232e79"],

Cell["\<\
VerificationTest[
    mps = RandomTensorNetwork[\"MPS\"[5, 4, 3], \"Boundary\" -> \"Open\"];
    dims = mps[\"Dimensions\"];
    (* Physical dimension should be 3 *)
    dims[[1, -1]] === 3 && dims[[-1, -1]] === 3,
    True,
    TestID -> \"RandomTensorNetwork_MPS_PhysicalDimension\"
]\
\>", "Input",ExpressionUUID->"6bc4906e-f54a-44ba-80a1-0c2852163ca2"],

