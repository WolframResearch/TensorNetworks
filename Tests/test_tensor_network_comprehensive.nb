Notebook[{
Cell["test_tensor_network_comprehensive", "Title",ExpressionUUID->"b48a8514-2b08-4ffe-a2ae-3683f17e1012"],

Cell["\<\
Comprehensivetests for TensorNetwork.wl - ALL patterns, ALL options, EXACT \
verification\
\>", "Subtitle",ExpressionUUID->"febc306a-e935-475b-8e58-14dcc481acba"],

Cell["\<\
(* Tests/test_tensor_network_comprehensive.wl *)
(* Comprehensive tests for TensorNetwork.wl - ALL patterns, ALL options, \
EXACT verification *)

Get[FileNameJoin[{DirectoryName[$InputFileName], \"test_setup.wl\"}]];\
\>", "Input",
 InitializationCell->
  True,ExpressionUUID->"c2501cbf-434a-406d-b0f9-05946666c00e"],

Cell["\<\
VerificationTest[
    A = {{1, 2, 3}, {4, 5, 6}};
    B = {{1, 2}, {3, 4}, {5, 6}};
    tn = TensorNetwork[{A, B}, {{1, 2}, {2, 3}}];
    {
        TensorNetworkQ[tn],
        tn[\"Tensors\"] === {A, B},
        tn[\"Hyperedges\"] === {{1, 2}, {2, 3}},
        tn[\"Output\"] === Automatic
    },
    {True, True, True, True},
    TestID -> \"TensorNetwork_Constructor_TwoArgs_ExactVerification\"
]\
\>", "Input",ExpressionUUID->"f086cc0c-58b0-4287-8f0b-038d92ff8823"],

Cell["\<\
VerificationTest[
    A = {{1, 2, 3}, {4, 5, 6}};
    B = {{1, 2}, {3, 4}, {5, 6}};
    tn = TensorNetwork[{A, B}, {{1, 2}, {2, 3}}, {1, 3}];
    {
        TensorNetworkQ[tn],
        tn[\"Tensors\"] === {A, B},
        tn[\"Hyperedges\"] === {{1, 2}, {2, 3}},
        tn[\"Output\"] === {1, 3},
        tn[\"FreeIndices\"] === {1, 3}
    },
    {True, True, True, True, True},
    TestID -> \"TensorNetwork_Constructor_ThreeArgs_ExplicitOutput\"
]\
\>", "Input",ExpressionUUID->"c5b1fb09-cd79-4b03-b828-492de275ba36"],

Cell["\<\
VerificationTest[
    A = {{1, 2, 3}, {4, 5, 6}};
    B = {{1, 2}, {3, 4}, {5, 6}};
    tn = TensorNetwork[{A, B}, {{1, 2}, {2, 3}}, {3, 1}];
    {
        tn[\"Output\"] === {3, 1},
        tn[\"FreeIndices\"] === {3, 1}
    },
    {True, True},
    TestID -> \"TensorNetwork_Constructor_ThreeArgs_ReversedOutput\"
]\
\>", "Input",ExpressionUUID->"57032c60-511d-4bd0-94eb-47ca2249785c"],

Cell["\<\
VerificationTest[
    A = {{1, 2, 3}, {4, 5, 6}};
    B = {{1, 2}, {3, 4}, {5, 6}};
    tn = TensorNetwork[{A, B}, {{1, 2}, {2, 3}}, Automatic];
    {
        tn[\"Output\"] === Automatic,
        Sort[tn[\"FreeIndices\"]] === {1, 3}
    },
    {True, True},
    TestID -> \"TensorNetwork_Constructor_ThreeArgs_AutomaticOutput\"
]\
\>", "Input",ExpressionUUID->"a3bebb16-8918-4b82-8679-b507b58b4b8f"],

Cell["\<\
VerificationTest[
    A = {{1, 2, 3}, {4, 5, 6}};
    B = {{1, 2}, {3, 4}, {5, 6}};
    tn = TensorNetwork[{A, B}, {{1, 2}, {2, 3}} -> {3, 1}];
    {
        TensorNetworkQ[tn],
        tn[\"Hyperedges\"] === {{1, 2}, {2, 3}},
        tn[\"FreeIndices\"] === {3, 1}
    },
    {True, True, True},
    TestID -> \"TensorNetwork_Constructor_RuleForm\"
]\
\>", "Input",ExpressionUUID->"4d510751-52f1-44b3-a9a9-f669d18a76d8"],

Cell["\<\
VerificationTest[
    A = {{1, 2, 3}, {4, 5, 6}};
    B = {{1, 2}, {3, 4}, {5, 6}};
    tn = TensorNetwork[{A, B}, {{1, 2}, {2, 3}}, Cycles[{{1, 2}}]];
    {
        TensorNetworkQ[tn],
        tn[\"FreeIndices\"] === {3, 1}  (* Permuted from {1, 3} *)
    },
    {True, True},
    TestID -> \"TensorNetwork_Constructor_CyclesPermutation\"
]\
\>", "Input",ExpressionUUID->"b41d0148-ac80-4a09-90e6-f4384113c323"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[{{1, 2}, {2, 3}}];
    {
        TensorNetworkQ[tn],
        tn[\"Hyperedges\"] === {{1, 2}, {2, 3}},
        Length[tn[\"Tensors\"]] === 2,
        tn[\"Output\"] === Automatic
    },
    {True, True, True, True},
    TestID -> \"TensorNetwork_Constructor_HypergraphOnly\"
]\
\>", "Input",ExpressionUUID->"a6a5ad74-1539-48d9-8833-9048dbfb3b85"],

Cell["\<\
VerificationTest[
    tn = TensorNetwork[{{1, 2}, {2, 3}} -> {1, 3}];
    {
        TensorNetworkQ[tn],
        tn[\"FreeIndices\"] === {1, 3}
    },
    {True, True},
    TestID -> \"TensorNetwork_Constructor_HypergraphWithOutput\"
]\
\>", "Input",ExpressionUUID->"9e7cf6e5-462b-4a58-b6c1-492dc5bd4419"],

Cell["\<\
VerificationTest[
    A = RandomReal[{-1, 1}, {2, 3}];
    B = RandomReal[{-1, 1}, {3, 4}];
    tc = Inactive[TensorContract][Inactive[TensorProduct][A, B], {{2, 3}}];
    tn = TensorNetwork[tc];
    {
        TensorNetworkQ[tn],
        Length[tn[\"Tensors\"]] === 2
    },
    {True, True},
    TestID -> \"TensorNetwork_Constructor_FromTensorContract\"
]\
\>", "Input",ExpressionUUID->"638c668e-0cc1-458e-a57d-fc9a08d031d3"],

Cell["", "Section",ExpressionUUID->"fd1c58ae-5f56-4190-93eb-989fddf88b2e"],

Cell["\<\
VerificationTest[
    TensorNetworkQ[TensorNetwork[{{{1, 2}, {3, 4}}}, {{1, 2}}]],
    True,
    TestID -> \"TensorNetworkQ_ValidSingleTensor\"
]\
\>", "Input",ExpressionUUID->"ea14572f-8d70-42d3-a21d-fc201eb17feb"],

