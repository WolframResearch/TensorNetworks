Cell[CellGroupData[{
Cell["ArrayContract", "ObjectName",ExpressionUUID->"0d332550-ddda-4869-8f0c-ac41277228e8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b9e0658d-a664-4b12-8326-283a4a92e540"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArrayContract",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/ArrayContract"], "[", 
   RowBox[{
    StyleBox["t", "TI"], ",", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "33d45430-47aa-488b-9733-ebcc30cbd330"],
 "\[LineSeparator]contracts the index pairs c in tensor t and simplifies the \
result. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"09434570-2007-41ad-abaf-90a016a9489d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ArrayContract",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/ArrayContract"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["t", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], "2"], ",", "\[Ellipsis]"}], "}"}], ",", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8344ec91-f228-4c90-a8ce-86df7b4b3a7e"],
 "\[LineSeparator]first forms an Inactive[TensorProduct] of the listed \
tensors, then contracts the index pairs c."
}], "Usage",ExpressionUUID->"782453da-7bd8-4488-8a0b-bd5a15bf2fb3"],

