Cell[TextData[{
 "Prepare a tree-form contraction order for a tensor network. Start from a \
linear path produced by ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"a2020001-0002-0002-0002-a20200020001"],
 ", then lift to tree form, using the network's vertex labels as leaves:"
}], "ExampleText",
 CellID->400000001,ExpressionUUID->"a2020002-0002-0002-0002-a20200020002"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "42", "]"}], ";", 
     RowBox[{"RandomTensorNetwork", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"4", ",", "5"}], "}"}], ",", "3"}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->400000002,ExpressionUUID->"a2020003-0002-0002-0002-a20200020003"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PathToTreePath", "[", 
  RowBox[{
   RowBox[{"GreedyContractionPath", "[", "tn", "]"}], ",", 
   RowBox[{"tn", "[", "\"\<Vertices\>\"", "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->400000003,ExpressionUUID->"a2020004-0002-0002-0002-a20200020004"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "3", "}"}], ",", 
       RowBox[{"{", "4", "}"}]}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->400000004,ExpressionUUID->"a2020005-0002-0002-0002-a20200020005"]
}, Open  ]],

