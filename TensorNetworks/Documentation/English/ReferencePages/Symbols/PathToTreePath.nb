Cell["\<\
The tree path round-trips through TreePathToPath to give the same contraction \
order as the original linear path:\
\>", "ExampleText",
 CellID->400000006,ExpressionUUID->"a2020008-0002-0002-0002-a20200020008"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tn", "=", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "42", "]"}], ";", 
     RowBox[{"RandomTensorNetwork", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"4", ",", "5"}], "}"}], ",", "3"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"path", "=", 
   RowBox[{"GreedyContractionPath", "[", "tn", "]"}]}], ";", 
  RowBox[{
   RowBox[{"TreePathToPath", "[", 
    RowBox[{"PathToTreePath", "[", "path", "]"}], "]"}], "===", 
   "path"}]}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->400000007,ExpressionUUID->"a2020009-0002-0002-0002-a20200020009"],

