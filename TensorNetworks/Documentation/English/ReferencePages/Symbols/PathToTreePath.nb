Notebook[{

Cell[CellGroupData[{
Cell["PathToTreePath", "ObjectName",
 CellID->1902586039,ExpressionUUID->"7eef61ab-7515-4326-b0dc-f2054c86a7c4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"709d45c3-e075-449a-8f1e-7383b259990a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PathToTreePath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathToTreePath"], "[",
   StyleBox["path", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "0b4344d1-4ae2-4391-ad0f-5d0cc02884cb"],
 "\[LineSeparator]converts a linear pairwise contraction ",
 Cell[BoxData[
  StyleBox["path", "TI"]], "InlineFormula",ExpressionUUID->
  "b45a013c-c785-4d1b-9772-5fe02707bb16"],
 " to a nested tree-form path with auto-derived integer leaves.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2a1b8c4d-3e5f-6789-0abc-def012345601"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PathToTreePath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathToTreePath"], "[",
   RowBox[{
    StyleBox["path", "TI"], ",",
    StyleBox["indices", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f3c4d5e6-7890-1234-5678-9abcdef01601"],
 "\[LineSeparator]uses the explicit list ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "1234abcd-5678-90ef-1234-567890abc601"],
 " as the leaf labels."
}], "Usage",
 CellChangeTimes->{{3.9786384188213863`*^9, 3.978638418884392*^9}},
 CellID->732053643,ExpressionUUID->"6c1d6a0d-c402-4484-8cb9-8fb52d45133a"],

Cell[TextData[{
 "The tree form is a nested list whose leaves are singleton lists ",
 Cell[BoxData[
  RowBox[{"{",
   StyleBox["x", "TI"], "}"}]], "InlineFormula",ExpressionUUID->
  "2345bcde-6789-01fa-2345-678901bcd602"],
 " and whose non-leaf nodes group two or more children. It is the same form \
recognised by ",
 Cell[BoxData[
  ButtonBox["TreePathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TreePathQ"]],
  "InlineFormula",ExpressionUUID->"3456cdef-7890-12ab-3456-789012cde603"],
 " and consumed by ",
 Cell[BoxData[
  ButtonBox["TreePathToPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TreePathToPath"]],
  "InlineFormula",ExpressionUUID->"4567def0-8901-23bc-4567-890123def604"],
 "."
}], "Notes",
 CellID->1806453462,ExpressionUUID->"c5c67aa4-ec5b-4b89-a72f-006e4f3a4604"],

Cell[TextData[{
 "The required arity \[LongDash] the number of leaves of the resulting tree \
\[LongDash] is ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Count",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Count"], "[",
   RowBox[{
    StyleBox["path", "TI"], ",",
    RowBox[{"{",
     RowBox[{"_", ",", "_"}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"5678ef01-9012-34cd-5678-901234ef0605"],
 " + 1: one leaf for each binary contraction step in ",
 Cell[BoxData[
  StyleBox["path", "TI"]], "InlineFormula",ExpressionUUID->
  "6789f012-0123-45de-6789-012345f01606"],
 ", plus one for the initial tensor count."
}], "Notes",
 CellID->2345006723,ExpressionUUID->"7890a123-1234-56ef-7890-123456a01607"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "8901b234-2345-67f0-8901-234567b01608"],
 " is omitted it defaults to ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Automatic"]], "InlineFormula",ExpressionUUID->
  "9012c345-3456-7801-9012-345678c01609"],
 ", and the leaves are taken from ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Range",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Range"], "[",
   StyleBox["required", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "0123d456-4567-8912-0123-456789d01610"],
 "."
}], "Notes",
 CellID->3456117834,ExpressionUUID->"1234e567-5678-9023-1234-56789ae01611"],

Cell[TextData[{
 "If an explicit ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "2345f678-6789-0134-2345-67890af01612"],
 " list is given whose length does not match the required arity, ",
 Cell[BoxData[
  ButtonBox["PathToTreePath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathToTreePath"]],
  "InlineFormula",ExpressionUUID->"3456a789-7890-1245-3456-78901bf01613"],
 " issues ",
 Cell[BoxData[
  RowBox[{
   StyleBox[
    RowBox[{"PathToTreePath", "::", "indlen"}], "MessageName"]}]],
  "InlineFormula",ExpressionUUID->"4567a890-8901-2356-4567-89012cf01614"],
 " and returns ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "5678b901-9012-3467-5678-90123df01615"],
 "."
}], "Notes",
 CellID->4567228945,ExpressionUUID->"5678b901-9012-3467-5678-90123df01616"],

Cell[TextData[{
 "At each step the underlying fold deletes the contracted positions from the \
working list and appends either the chosen leaf (singleton step) or the pair \
of children (binary step) as a tree-level node, so the order in which \
leaves appear in the output is determined by the path."
}], "Notes",
 CellID->4567228946,ExpressionUUID->"6789c012-0123-4578-6789-01234ef01617"]
}, Open  ]],

