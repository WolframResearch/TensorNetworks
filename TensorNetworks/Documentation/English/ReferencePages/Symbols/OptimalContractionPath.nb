Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"794d0b34-a0cd-4a37-a22e-7b619316af27"],
 " calls ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"c8fbef9d-544c-4991-b2fe-a57955b27ec3"],
 " internally when no path is supplied. Passing the path explicitly gives the \
same value:"
}], "ExampleText",
 CellID->607176065,ExpressionUUID->"21343e8e-cd66-42d6-abc7-142b988448e5"],

Cell[CellGroupData[{

