 RowBox[{"Norm", "[", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"TensorNetworkContract", "[", "tn", "]"}], "]"}], " ", "-", " ", 
    
    RowBox[{"Normal", "[", 
     RowBox[{"TensorNetworkContract", "[", 
      RowBox[{"tn", ",", " ", 
       RowBox[{"OptimalContractionPath", "[", "tn", "]"}]}], "]"}], "]"}]}], 
