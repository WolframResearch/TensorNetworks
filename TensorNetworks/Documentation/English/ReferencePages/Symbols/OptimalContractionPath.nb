Cell["\<\
From the low-level Association of dimensions, indices, and contractions:\
\>", "ExampleText",
 CellID->745112230,ExpressionUUID->"8b725a51-b640-4aa0-9ae8-bf5cf2f41ef1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OptimalContractionPath", "[", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<Dimensions\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "2"}], "}"}]}], "}"}]}], ",", " ", 
    RowBox[{"\"\<Indices\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "k"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "i"}], "}"}]}], "}"}]}], ",", " ", 
    RowBox[{"\"\<Contractions\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "i"}], "}"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "j"}], "}"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "k"}], "}"}], "}"}]}], "}"}]}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->701374659,ExpressionUUID->"b32a70af-5e41-4195-8f4f-2a6be64f860a"],

