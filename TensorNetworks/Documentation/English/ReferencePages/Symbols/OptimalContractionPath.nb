Cell["\<\
Find an optimal path for a small random network (default Method -> \"size\"):\
\
\>", "ExampleText",ExpressionUUID->"ebef124c-ca12-45db-8b3b-c79c1eed0869"],

Cell[BoxData[
 RowBox[{"tn", "=", 
  RowBox[{"RandomTensorNetwork", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"4", ",", "5"}], "}"}], ",", "3"}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"7ad2635e-3b95-4e8f-a001-64f77cbe88dc"],

Cell[BoxData[
 RowBox[{"OptimalContractionPath", "[", "tn", "]"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"b316a8dd-98a0-45a4-85c5-963e8addfdb6"],

Cell["Optimize for FLOP cost instead of intermediate-tensor size:", \
"ExampleText",ExpressionUUID->"2880cd24-679d-4ace-9bab-261a69b2e08d"],

Cell[BoxData[
 RowBox[{"OptimalContractionPath", "[", 
  RowBox[{"tn", ",", 
   RowBox[{"Method", "->", "\"\<flops\>\""}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"63f55a17-a261-4bbb-986d-45669d47c978"],

Cell["Disallow outer products in the search:", "ExampleText",ExpressionUUID->"6e1d8671-433a-4d00-b183-685fea46df11"],

Cell[BoxData[
 RowBox[{"OptimalContractionPath", "[", 
  RowBox[{"tn", ",", 
   RowBox[{"\"\<AllowOuterProducts\>\"", "->", "False"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"99cbc8b2-d6a1-4b0f-a95a-0fc9e0fd1fee"],

