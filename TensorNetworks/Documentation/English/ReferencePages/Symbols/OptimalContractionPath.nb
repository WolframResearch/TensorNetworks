Cell["\<\
Use the low-level Association form (dimensions, indices, contractions) for \
the same calculation:\
\>", "ExampleText",
 CellID->932610186,ExpressionUUID->"cc9d49e4-89c3-4375-81e2-50934fa2b8e3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OptimalContractionPath", "[", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<Dimensions\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "2"}], "}"}]}], "}"}]}], ",", " ", 
    RowBox[{"\"\<Indices\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "k"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "i"}], "}"}]}], "}"}]}], ",", " ", 
    RowBox[{"\"\<Contractions\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "i"}], "}"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "j"}], "}"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "k"}], "}"}], "}"}]}], "}"}]}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->404757254,ExpressionUUID->"01a2b116-87a7-4acb-a9f0-0744d8f2a505"],

