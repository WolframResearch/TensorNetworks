Cell[TextData[{
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"54cd4200-f6e8-4a65-974b-39b1ecd02016"],
 " performs an exhaustive dynamic-programming search; ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"6c28467d-d435-406a-9e87-3925406e97e1"],
 " is a fast heuristic. On the same network they generally agree on small \
inputs but can produce different paths when there is a non-trivial search \
space:"
}], "ExampleText",
 CellID->835788578,ExpressionUUID->"932801e8-2c5e-4384-8c65-4f0533dc08a7"],

