 CellID->814932228,ExpressionUUID->"c4b64150-4a5f-42ad-85ae-5c80a8d2decf"],

Cell[TextData[{
 "Both ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"d7d3eab2-e08e-41bd-9c40-e2ca80eda47f"],
 " and ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"70e61b7d-a50b-4333-9264-5e294f810487"],
 " return the path in the opt_einsum convention: each pair ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["i", "TI"], ",", 
   StyleBox["j", "TI"], "}"}]], "InlineFormula",ExpressionUUID->
  "5c6e098a-6400-4ade-8dc4-169b9eb78543"],
 " removes the tensors at positions ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "4cc69221-a934-41b6-acc3-0f01eb2d4ef4"],
 " and ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "8112ecb8-c7a6-4d18-994a-fb2f941b6f2e"],
 " from the working list and appends their pairwise contraction at the end, \
so a network with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "a4d1b7cc-13b6-498b-86ff-2d42265056e8"],
 " tensors produces a path of length ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "71984c6e-bbe8-4a10-883d-8c1009cd094e"],
 ":"
}], "ExampleText",
 CellID->16831409,ExpressionUUID->"6a5ee7a3-534e-41ab-a10e-fd9b04249db4"],

