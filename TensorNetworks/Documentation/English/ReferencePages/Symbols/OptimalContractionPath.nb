Cell[TextData[{
 "Dynamic-programming search is exponential in the number of tensors in the \
worst case. For networks with more than roughly twenty tensors, prefer ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"fa493f5e-a786-450e-b9bb-d17133fb6231"],
 " or set ",
 Cell[BoxData[
  StyleBox["\"\<PruningThreshold\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "dbfcaed3-6734-4e23-ba5b-0cc6b6ec3009"],
 " to cap the search:"
}], "ExampleText",
 CellID->892103990,ExpressionUUID->"df83804c-8940-49a2-9f85-f0bb13260d38"],

