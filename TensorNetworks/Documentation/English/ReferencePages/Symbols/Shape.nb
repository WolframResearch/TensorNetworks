Cell[CellGroupData[{
Cell["Shape", "ObjectName",ExpressionUUID->"1b3d77fc-fa93-4c3f-b7f0-f1cde40ffd47"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b905885c-ab47-46b2-8df6-6d5f22fbad92"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Shape",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/Shape"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["d", "TI"], "2"], ",", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"a23a7971-d8c0-438a-a356-96f3c04eacd6"],
 "\[LineSeparator]represents an ordered sequence of Dimension objects \
describing the index structure of a tensor. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d72c33bb-b4b2-497b-906c-91e7d634d946"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Shape",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/Shape"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], "1"], ",", 
     SubscriptBox[
      StyleBox["d", "TI"], "2"], ",", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"6b5e4c25-2a94-4310-9828-2efaef1a6e9c"],
 "\[LineSeparator]accepts a list of integer sizes or Dimension objects. \
\[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"21847f57-4ef8-4a18-8de3-9d5f637ad7cc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Shape",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/Shape"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], "1"], ",", "\[Ellipsis]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["n", "TI"], "1"], ",", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"591917df-c2db-497d-8115-85b6fd162163"],
 "\[LineSeparator]pairs integer sizes with index names; a negative name marks \
a lower index."
}], "Usage",ExpressionUUID->"ad9f3e69-604e-4c45-8fb2-da2be9269ca0"],

