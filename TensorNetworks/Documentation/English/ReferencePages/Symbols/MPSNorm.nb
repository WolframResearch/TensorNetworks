 CellID->649402091,ExpressionUUID->"28899ca8-8899-c9dc-2eee-c89955667788"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mpsB", " ", "=", " ",
   RowBox[{"RandomTensorNetwork", "[",
    RowBox[{"\"\<MPS\>\"", "[",
     RowBox[{"6", ",", " ", "4", ",", " ", "2"}], "]"}], "]"}]}],
  ";"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->750511200,ExpressionUUID->"399aadb9-99aa-d9dc-3eee-c8ee66778899"],

Cell[BoxData[
 RowBox[{"Sqrt", "[",
  RowBox[{"2", " ",
   RowBox[{"(",
    RowBox[{"1", "-",
     RowBox[{
      RowBox[{"Re", "[",
       RowBox[{"MPSOverlap", "[",
        RowBox[{"mpsA", ",", " ", "mpsB"}], "]"}], "]"}], "/",
      RowBox[{"(",
       RowBox[{
        RowBox[{"MPSNorm", "[", "mpsA", "]"}], " ",
        RowBox[{"MPSNorm", "[", "mpsB", "]"}]}], ")"}]}]}], ")"}]}],
  "]"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->861620319,ExpressionUUID->"4aabbcdb-aabb-eaff-400d-eaff77889900"],

