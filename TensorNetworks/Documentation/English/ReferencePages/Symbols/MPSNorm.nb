Cell["The squared norm equals the self-overlap:", "ExampleText",
 CellID->860545936,ExpressionUUID->"d1422742-1642-5265-d677-512288990011"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mps", " ", "=", " ", 
   RowBox[{"RandomTensorNetwork", "[", 
    RowBox[{"\"\<MPS\>\"", "[", 
     RowBox[{"6", ",", " ", "4", ",", " ", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"MPSNorm", "[", "mps", "]"}], "^", "2"}], " ", "-", " ", 
   RowBox[{"MPSOverlap", "[", 
    RowBox[{"mps", ",", " ", "mps"}], "]"}]}], "]"}]}], "Input",
 CellLabel->"In[24]:=",
 CellID->949618855,ExpressionUUID->"e2533853-2753-6376-e788-623399001122"],

Cell[BoxData["0"], "Output",
