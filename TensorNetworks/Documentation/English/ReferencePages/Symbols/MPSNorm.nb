Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Bond-dim 1 (product state)", "ExampleSubsection",ExpressionUUID->
   "44088102-0123-4456-789a-b440881020aa"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->440881020,ExpressionUUID->"c9d50970-b0c6-4ee7-9bf7-1e413bff01b1"],

Cell["\<\
A bond-dimension-1 MPS encodes a product state. Its norm is exactly the \
product of the per-site Frobenius norms of its tensors:\
\>", "ExampleText",
 CellID->420182452,ExpressionUUID->"a0011531-0031-4154-a566-405511223344"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}]], "Input",
 CellChangeTimes->{3.9882255227557096`*^9},
 CellLabel->"In[29]:=",
 CellID->531291561,ExpressionUUID->"b1122642-1142-5265-b677-516622334455"],

Cell[BoxData[
 RowBox[{
  RowBox[{"productMPS", " ", "=", " ", 
   RowBox[{"RandomTensorNetwork", "[", 
    RowBox[{"\"\<MPS\>\"", "[", 
     RowBox[{"5", ",", " ", "1", ",", " ", "2"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[30]:=",
 CellID->642300670,ExpressionUUID->"c2233753-2253-6376-c788-627733445566"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MPSNorm", "[", "productMPS", "]"}]], "Input",
 CellLabel->"In[31]:=",
 CellID->753419789,ExpressionUUID->"d3344864-3364-7487-d899-738844556677"],

Cell[BoxData["0.026476137059845424`"], "Output",
 CellChangeTimes->{3.988225526498897*^9},
 CellLabel->"Out[31]=",
 CellID->1903257186,ExpressionUUID->"49f5e46a-52b7-4999-b089-16b00c46bd0f"]
}, Open  ]],

Cell["Verify against the product of per-site Frobenius norms:", "ExampleText",
 CellID->975637007,ExpressionUUID->"f5566a86-5586-96a9-fabb-95aa66778899"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Times", " ", "@@", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{"Flatten", "[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"productMPS", "[", "\"\<Tensors\>\"", "]"}]}], ")"}]}]], "Input",
 CellLabel->"In[32]:=",
 CellID->86756116,ExpressionUUID->"06677b97-6677-a7ba-0bcc-a67733445566"],

Cell[BoxData["0.02647613705984542`"], "Output",
 CellChangeTimes->{3.988225528152817*^9},
 CellLabel->"Out[32]=",
 CellID->531593005,ExpressionUUID->"4fe9dd97-6e64-482b-8e8a-e42380061e68"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "After normalization", "ExampleSubsection",ExpressionUUID->
