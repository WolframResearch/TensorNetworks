Cell[TextData[{
 "The transfer-matrix sweep inside ",
 Cell[BoxData[
  ButtonBox["MPSOverlap",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSOverlap"]],
  "InlineFormula",ExpressionUUID->"9f0054150-f005-3065-9455-3f0066778899"],
 " accumulates floating-point round-off, so ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSOverlap",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSOverlap"], "[",
   RowBox[{
    StyleBox["mps", "TI"], ",", " ",
    StyleBox["mps", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a0011832-0011-4175-a566-401177889900"],
 " can carry a tiny imaginary part or be marginally negative even though it \
is mathematically a non-negative real. ",
 Cell[BoxData[
  ButtonBox["MPSNorm",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"]], "InlineFormula",
  ExpressionUUID->"b1122943-1122-5286-b677-512288990011"],
 " wraps the self-overlap with ",
 Cell[BoxData[
  ButtonBox["Abs",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Abs"]], "InlineFormula",ExpressionUUID->
  "c2233a54-2233-6397-c788-623399001122"],
 " so the result is always a non-negative real scalar:"
}], "ExampleText",
 CellID->516157748,ExpressionUUID->"d3344b65-3344-74a8-d899-734400112233"],

