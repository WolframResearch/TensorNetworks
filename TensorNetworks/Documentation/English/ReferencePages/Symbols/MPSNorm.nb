  RowBox[{
   ButtonBox["MPSNorm",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/MPSNorm"], "[", 
   StyleBox["mps", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "5ef67477-39d5-405b-9268-75b7dca585c3"],
