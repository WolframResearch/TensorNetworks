Notebook[{

Cell[CellGroupData[{
Cell["MPSNorm", "ObjectName",
 CellID->1043258770,ExpressionUUID->"be54547b-4947-481a-8162-f2a1e203bad9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a9906943-bd90-46a2-bb21-a510f4c7bc98"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSNorm",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"], "[", 
   StyleBox["mps", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "5ef67477-39d5-405b-9268-75b7dca585c3"],
 "\[LineSeparator]computes the norm ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[LeftDoubleBracketingBar]", "\[Psi]", "\[RightDoubleBracketingBar]"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4b1f0a02-b5d2-4d4a-8f1e-1a2c3d4e5f6a"],
 " of a matrix-product state."
}], "Usage",
 CellID->1993653282,ExpressionUUID->"5e82b4fa-4295-4182-a61a-f2c786db12c8"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["MPSNorm",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"]], "InlineFormula",
  ExpressionUUID->"7c3a1b22-2d3e-4e0f-8a9b-101122334455"],
 " is equivalent to ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{"Abs", "[", 
     RowBox[{"MPSOverlap", "[", 
      RowBox[{
       StyleBox["mps", "TI"], ",", 
       StyleBox["mps", "TI"]}], "]"}], "]"}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8d4b2c33-3e4f-5f10-9bac-202233445566"],
 "."
}], "Notes",
 CellID->143366433,ExpressionUUID->"a976cc4b-85f2-4a18-843e-a4bac22b8a58"],

Cell[TextData[{
 "Mathematically the self-overlap ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "\[LeftAngleBracket]", "\[Psi]", "|", "\[Psi]", "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9e5c3d44-4f50-6021-acbd-303344556677"],
 " is a non-negative real number. The ",
 Cell[BoxData[
  ButtonBox["Abs",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Abs"]], "InlineFormula",ExpressionUUID->
  "af6d4e55-5061-7132-bdce-404455667788"],
 " guards against tiny negative real or imaginary parts that can appear in \
the transfer-matrix sweep used by ",
 Cell[BoxData[
  ButtonBox["MPSOverlap",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSOverlap"]], 
  "InlineFormula",ExpressionUUID->"b07e5f66-6172-8243-cedf-505566778899"],
 " from floating-point cancellation."
}], "Notes",
 CellID->429722206,ExpressionUUID->"c1810722-1f2c-4843-9aab-eb9bb5add455"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["MPSNorm",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"]], "InlineFormula",
  ExpressionUUID->"d2920833-2f30-9354-dfea-606677889900"],
 " returns ",
 Cell[BoxData[
 "0"], "InlineFormula",ExpressionUUID->"e3a31944-3041-0465-eafb-707788990011"],
 " only when the MPS is identically zero."
}], "Notes",
 CellID->976165333,ExpressionUUID->"f4b42a55-4152-1576-fbac-808899001122"],

Cell[TextData[{
 "The result is the square root of the squared 2-norm returned by ",
 Cell[BoxData[
  ButtonBox["MPSOverlap",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSOverlap"]], 
  "InlineFormula",ExpressionUUID->"15c53b66-5263-2687-0bdc-909900112233"],
 "[",
 Cell[BoxData[
  StyleBox["mps", "TI"]], "InlineFormula",ExpressionUUID->
  "26d64a77-6374-3798-1ced-a0aa11223344"],
 ", ",
 Cell[BoxData[
  StyleBox["mps", "TI"]], "InlineFormula",ExpressionUUID->
  "37e75b88-7485-48a9-2dfe-b1bb22334455"],
 "]. To rescale the MPS itself to unit norm use ",
 Cell[BoxData[
  ButtonBox["MPSNormalize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNormalize"]], 
  "InlineFormula",ExpressionUUID->"48f86c99-8596-59ba-3eaf-c2cc33445566"],
 "."
}], "Notes",
 CellID->82936793,ExpressionUUID->"59a97daa-96a7-6acb-4faf-d3dd44556677"]
}, Open  ]],

