Cell[TextData[{
 "Distance between two MPS via the polarization identity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "(", 
    RowBox[{"a", ",", "b"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e4455a64-4455-8598-e9aa-845511223344"],
 " = ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox[
        RowBox[{"Re", " ", 
         RowBox[{"\[LeftAngleBracket]", 
          RowBox[{"a", "|", "b"}], "\[RightAngleBracket]"}]}], 
        RowBox[{
         RowBox[{
         "\[LeftDoubleBracketingBar]", "a", "\[RightDoubleBracketingBar]"}], " ", 
         RowBox[{
         "\[LeftDoubleBracketingBar]", "b", 
          "\[RightDoubleBracketingBar]"}]}]]}], ")"}]}]], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f5566b75-5566-96a9-fabb-956622334455"],
 ":"
}], "ExampleText",
 CellID->429183873,ExpressionUUID->"06677c86-6677-a7ba-0bcc-a67733445566"],

