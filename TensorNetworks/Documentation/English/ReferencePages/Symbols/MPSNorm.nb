 RowBox[{
  RowBox[{"SeedRandom", "[", "43", "]"}], ";"}]], "Input",
 CellChangeTimes->{3.988225545871668*^9},
 CellLabel->"In[39]:=",
 CellID->538292982,ExpressionUUID->"17788c97-7788-b8cb-1ddd-b78844556677"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mpsA", " ", "=", " ", 
   RowBox[{"RandomTensorNetwork", "[", 
    RowBox[{"\"\<MPS\>\"", "[", 
     RowBox[{"6", ",", " ", "4", ",", " ", "2"}], "]"}], "]"}]}], 
  ";"}]], "Input",
