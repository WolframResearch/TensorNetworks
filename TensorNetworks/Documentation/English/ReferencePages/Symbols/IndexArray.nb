Cell[CellGroupData[{
Cell["IndexArray", "ObjectName",ExpressionUUID->"ea014fbb-c8aa-4cec-927a-afe59c40bfb1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"197564a9-17d9-4ad3-9734-a00f68defe13"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IndexArray",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/IndexArray"], "[", 
   StyleBox["tensor", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e8343c0d-227d-4018-943e-fdb527322893"],
 "\[LineSeparator]wraps tensor as an IndexArray with shape derived from \
ArrayDimensions[tensor]. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"5eb95e31-1bca-42c0-956d-e86b33c230e3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IndexArray",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/IndexArray"], "[", 
   RowBox[{
    StyleBox["tensor", "TI"], ",", 
    StyleBox["shape", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "caa241dc-859b-4d94-a817-d224659f39a6"],
 "\[LineSeparator]wraps tensor with the given Shape, recording named index \
structure and variance. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"35a60304-4a25-4a52-aed6-95ac76017c60"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IndexArray",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/IndexArray"], "[", 
   RowBox[{
    StyleBox["ia", "TI"], ",", 
    StyleBox["shape", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fbb1b9a1-cb6c-4cc2-a786-316f75f6aba4"],
 "\[LineSeparator]returns the IndexArray ia with its Shape replaced."
}], "Usage",ExpressionUUID->"4bbe6737-8f2e-4ef0-ac71-da2cc2ddd9eb"],

