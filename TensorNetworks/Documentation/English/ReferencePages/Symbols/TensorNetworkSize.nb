Cell["The property-form dual gives the same value as the function call:", "ExampleText",
 CellID->630004001,ExpressionUUID->"b0f7a3ab-aaaa-bbbb-cccc-dddd00000001"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "99", "]"}], ";", "\[IndentingNewLine]",
  RowBox[{"tn", "=",
   RowBox[{"RandomTensorNetwork", "[",
    RowBox[{"\"\<MPS\>\"", "[",
     RowBox[{"4", ",", "2", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"{",
   RowBox[{
