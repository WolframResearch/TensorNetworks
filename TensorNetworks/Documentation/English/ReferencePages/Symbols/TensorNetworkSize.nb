Cell["Estimate the total number of stored entries across all tensors by summing the product of each tensor's dimensions over the network:", "ExampleText",
 CellID->630003001,ExpressionUUID->"a182b106-aaaa-bbbb-cccc-dddd00000001"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "123", "]"}], ";", "\[IndentingNewLine]",
  RowBox[{"tn", "=",
   RowBox[{"RandomTensorNetwork", "[",
    RowBox[{"\"\<MPS\>\"", "[",
     RowBox[{"6", ",", "4", ",", "3"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"{",
   RowBox[{
    RowBox[{"TensorNetworkSize", "[", "tn", "]"}], ",",
    RowBox[{"Total", "[",
     RowBox[{
      RowBox[{
       RowBox[{"Times", "@@", "#"}], "&"}], "/@",
      RowBox[{"tn", "[", "\"\<Dimensions\>\"", "]"}]}], "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->630003002,ExpressionUUID->"a182b106-aaaa-bbbb-cccc-dddd00000002"],

Cell[BoxData[
 RowBox[{"{", RowBox[{"6", ",", "216"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->630003003,ExpressionUUID->"a182b106-aaaa-bbbb-cccc-dddd00000003"]
}, Open]]
}, Open]],

