Cell["TensorNetworkSize is equivalent to Length applied to the Tensors property:", "ExampleText",
 CellID->630004020,ExpressionUUID->"b0f7a3ab-aaaa-bbbb-cccc-dddd00000020"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "99", "]"}], ";", "\[IndentingNewLine]",
  RowBox[{"tn", "=",
