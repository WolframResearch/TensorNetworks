Cell["An invalid TensorNetwork expression leaves the call unevaluated rather than returning a misleading count:", "ExampleText",
 CellID->630005020,ExpressionUUID->"1a6ef4b5-aaaa-bbbb-cccc-dddd00000020"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"bad", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"RandomReal", "[",
       RowBox[{
        RowBox[{"{",
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "2"}], "}"}]}], "]"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"{",
       RowBox[{"i", ",", "j", ",", "k"}], "}"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"TensorNetworkSize", "[", "bad", "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->630005021,ExpressionUUID->"1a6ef4b5-aaaa-bbbb-cccc-dddd00000021"],

Cell[BoxData[
 RowBox[{"TensorNetworkSize", "[",
  RowBox[{"TensorNetwork", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"RandomReal", "[",
      RowBox[{
       RowBox[{"{",
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"2", ",", "2"}], "}"}]}], "]"}], "}"}], ",",
    RowBox[{"{",
     RowBox[{"{",
      RowBox[{"i", ",", "j", ",", "k"}], "}"}], "}"}]}], "]"}], "]"}]], "Output",
 CellLabel->"Out[1]=",
