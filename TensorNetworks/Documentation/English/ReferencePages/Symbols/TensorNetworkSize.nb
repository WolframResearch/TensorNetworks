Cell["Count the tensors in a small two-tensor network:", "ExampleText",
 CellID->630001001,ExpressionUUID->"0c51f45e-252b-491f-8836-106f78193b81"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->630001002,ExpressionUUID->"641c1b47-5ea7-4b63-a7e0-baf82f8293f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorNetworkSize", "[", "tn", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->630001003,ExpressionUUID->"215b63e9-2c8e-494a-951c-098bfab5f89b"],

Cell[BoxData[
 "2"], "Output",
 CellLabel->"Out[2]=",
 CellID->630001004,ExpressionUUID->"215b63e9-2c8e-494a-951c-098bfab5f89c"]
}, Open]],

