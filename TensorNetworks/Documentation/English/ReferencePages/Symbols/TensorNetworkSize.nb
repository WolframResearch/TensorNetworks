Cell["Binarizing a hyperedge network inserts spider tensors at each index shared by more than two nodes, so the size grows:", "ExampleText",
 CellID->630005001,ExpressionUUID->"1a6ef4b5-aaaa-bbbb-cccc-dddd00000001"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"hyper", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{"{",
     RowBox[{
      RowBox[{"{",
       RowBox[{"i", ",", "j"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"j", ",", "k"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"j", ",", "l"}], "}"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"binary", "=",
   RowBox[{"BinaryTensorNetwork", "[", "hyper", "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"{",
   RowBox[{
    RowBox[{"TensorNetworkSize", "[", "hyper", "]"}], ",",
    RowBox[{"TensorNetworkSize", "[", "binary", "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->630005002,ExpressionUUID->"1a6ef4b5-aaaa-bbbb-cccc-dddd00000002"],

Cell[BoxData[
 RowBox[{"{", RowBox[{"3", ",", "4"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->630005003,ExpressionUUID->"1a6ef4b5-aaaa-bbbb-cccc-dddd00000003"]
}, Open]],

