    RowBox[{"\"\<MPS\>\"", "[",
     RowBox[{"4", ",", "2", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{
   RowBox[{"TensorNetworkSize", "[", "tn", "]"}], "===",
