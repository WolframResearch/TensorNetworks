Cell["Get the dimension of each index in a tensor network:", "ExampleText",
 CellID->650001001,ExpressionUUID->"8b531dc1-a141-4dad-bcc4-ad5e2649cd64"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->650001002,ExpressionUUID->"9d05756d-e98a-4f54-9a0f-6670b3781435"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndexDimensions", "[", "tn", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->650001003,ExpressionUUID->"ff6f0452-91e6-4a00-952a-00db97e7f066"],

