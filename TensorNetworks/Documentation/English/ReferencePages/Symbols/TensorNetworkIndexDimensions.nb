Cell["\<\
Get the dimension of each index occurrence in a tensor network:\
\>", "ExampleText",
 CellID->650001001,ExpressionUUID->"8b531dc1-a141-4dad-bcc4-ad5e2649cd64"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->650001002,ExpressionUUID->"9d05756d-e98a-4f54-9a0f-6670b3781435"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorNetworkIndexDimensions", "[", "tn", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->650001003,ExpressionUUID->"ff6f0452-91e6-4a00-952a-00db97e7f066"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "2"}], ",", 
   RowBox[{"2", "\[Rule]", "3"}], ",", 
   RowBox[{"2", "\[Rule]", "3"}], ",", 
   RowBox[{"3", "\[Rule]", "4"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->650001004,ExpressionUUID->"a4440001-cccc-4001-dddd-ffffffffff01"]
}, Open  ]],

Cell[TextData[{
 "The shared index ",
 Cell[BoxData[
 "2"], "InlineFormula",ExpressionUUID->"a4440002-cccc-4002-dddd-ffffffffff02"],
 " appears in both tensors, so it contributes two rules with the same \
right-hand side. The free indices ",
 Cell[BoxData[
 "1"], "InlineFormula",ExpressionUUID->"a4440003-cccc-4003-dddd-ffffffffff03"],
 " and ",
 Cell[BoxData[
 "3"], "InlineFormula",ExpressionUUID->"a4440004-cccc-4004-dddd-ffffffffff04"],
 " contribute one rule each."
}], "ExampleText",
 CellID->650001005,ExpressionUUID->"a4440005-cccc-4005-dddd-ffffffffff05"],

Cell["\<\
The same dimensions show up for a structured network such as a 4-site matrix \
product state:\
\>", "ExampleText",
 CellID->650001010,ExpressionUUID->"a4440006-cccc-4006-dddd-ffffffffff06"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TensorNetworkIndexDimensions", "[", 
  RowBox[{"RandomTensorNetwork", "[", 
   RowBox[{"\"\<MPS\>\"", "[", 
    RowBox[{"4", ",", "2", ",", "2"}], "]"}], "]"}], "]"}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->650001011,ExpressionUUID->"a4440007-cccc-4007-dddd-ffffffffff07"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "2"}], ",", 
   RowBox[{"5", "\[Rule]", "2"}], ",", 
   RowBox[{"1", "\[Rule]", "2"}], ",", 
   RowBox[{"2", "\[Rule]", "2"}], ",", 
   RowBox[{"6", "\[Rule]", "2"}], ",", 
   RowBox[{"2", "\[Rule]", "2"}], ",", 
   RowBox[{"3", "\[Rule]", "2"}], ",", 
   RowBox[{"7", "\[Rule]", "2"}], ",", 
   RowBox[{"3", "\[Rule]", "2"}], ",", 
   RowBox[{"8", "\[Rule]", "2"}]}], "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->650001012,ExpressionUUID->"a4440008-cccc-4008-dddd-ffffffffff08"]
}, Open  ]],

Cell[TextData[{
 "Every bond index (",
 Cell[BoxData[
 "1"], "InlineFormula",ExpressionUUID->"a4440009-cccc-4009-dddd-ffffffffff09"],
 ", ",
 Cell[BoxData[
 "2"], "InlineFormula",ExpressionUUID->"a4440010-cccc-4010-dddd-ffffffffff10"],
 ", ",
 Cell[BoxData[
 "3"], "InlineFormula",ExpressionUUID->"a4440011-cccc-4011-dddd-ffffffffff11"],
 ") appears twice; every physical index (",
 Cell[BoxData[
 "5"], "InlineFormula",ExpressionUUID->"a4440012-cccc-4012-dddd-ffffffffff12"],
 ", ",
 Cell[BoxData[
 "6"], "InlineFormula",ExpressionUUID->"a4440013-cccc-4013-dddd-ffffffffff13"],
 ", ",
 Cell[BoxData[
 "7"], "InlineFormula",ExpressionUUID->"a4440014-cccc-4014-dddd-ffffffffff14"],
 ", ",
 Cell[BoxData[
 "8"], "InlineFormula",ExpressionUUID->"a4440015-cccc-4015-dddd-ffffffffff15"],
 ") appears once. The right-hand sides agree across occurrences of the same \
index."
}], "ExampleText",
 CellID->650001020,ExpressionUUID->"a4440016-cccc-4016-dddd-ffffffffff16"],

Cell["\<\
The low-level form takes explicit per-tensor indices and dimensions directly, \
with no TensorNetwork object involved:\
\>", "ExampleText",
 CellID->650001004,ExpressionUUID->"f4ea263b-6414-41d6-af40-a171d20f227e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorNetworkIndexDimensions", "[", 
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"\"\<Indices\>\"", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}]}], ",", 
    RowBox[{"\"\<Dimensions\>\"", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"3", ",", "4"}], "}"}], "}"}]}]}], "\[RightAssociation]"}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->650001030,ExpressionUUID->"a4440017-cccc-4017-dddd-ffffffffff17"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "3"}], ",", 
   RowBox[{"2", "\[Rule]", "4"}]}], "}"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->650001031,ExpressionUUID->"a4440018-cccc-4018-dddd-ffffffffff18"]
}, Open  ]],

Cell["\<\
The two-argument form is equivalent and takes the dimensions from the tensor \
list directly:\
\>", "ExampleText",
 CellID->650001040,ExpressionUUID->"a4440019-cccc-4019-dddd-ffffffffff19"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorNetworkIndexDimensions", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->650001005,ExpressionUUID->"f32f83b0-ff09-404c-99c0-9ebb08ac4627"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "\[Rule]", "2"}], ",", 
   RowBox[{"2", "\[Rule]", "3"}], ",", 
   RowBox[{"2", "\[Rule]", "3"}], ",", 
   RowBox[{"3", "\[Rule]", "4"}]}], "}"}]], "Output",
 CellLabel->"Out[5]=",
 CellID->650001050,ExpressionUUID->"a4440020-cccc-4020-dddd-ffffffffff20"]
}, Open  ]],

