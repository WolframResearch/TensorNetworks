Notebook[{

Cell[CellGroupData[{
Cell["TensorNetworkIndexDimensions", "ObjectName",
 CellID->1628911235,ExpressionUUID->"ad9c492b-f67f-412a-a5ae-9007a334fce3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"beec7a37-6634-4662-97cc-d243bc786854"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkIndexDimensions",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndexDimensions"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "47f2d964-253e-4924-bf23-0822fc18a1fe"],
 "\[LineSeparator]returns the list of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["index", "TI"], "\[Rule]", 
   StyleBox["dimension", "TI"]}]], "InlineFormula",ExpressionUUID->
  "4f3c1189-9bcf-41af-85d9-7d8d5b59404b"],
 " rules for every index occurrence in the tensor network ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "a1110001-aaaa-4001-bbbb-cccccccccc01"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"09638b9e-d564-4d09-ad43-3ca7884966c8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkIndexDimensions",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndexDimensions"], "[", 
   RowBox[{
    StyleBox["indices", "TI"], ",", 
    StyleBox["tensors", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b7e3fa54-2cec-41f3-a485-85a457637440"],
 "\[LineSeparator]computes the rules from an explicit list of per-tensor \
index lists and an explicit list of tensors.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a1110002-aaaa-4002-bbbb-cccccccccc02"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkIndexDimensions",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndexDimensions"], "[", 
   StyleBox["net", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a1110003-aaaa-4003-bbbb-cccccccccc03"],
 "\[LineSeparator]returns the index-dimension rules of the graph form ",
 Cell[BoxData[
  StyleBox["net", "TI"]], "InlineFormula",ExpressionUUID->
  "a1110004-aaaa-4004-bbbb-cccccccccc04"],
 "."
}], "Usage",
 CellChangeTimes->{{3.978638201580255*^9, 3.978638201670823*^9}},
 CellID->989594689,ExpressionUUID->"b5893472-c622-4ead-9cdf-d52a1fb8f0e5"],

Cell[TextData[{
 "The result is a flat list of ",
 Cell[BoxData[
  ButtonBox["Rule",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Rule"]], "InlineFormula",ExpressionUUID->
  "a2220001-aaaa-4005-bbbb-cccccccccc05"],
 " expressions, one per leg of every tensor; an index that appears in ",
 StyleBox["k", "TI"],
 " tensors contributes ",
 StyleBox["k", "TI"],
 " rules with the same right-hand side."
}], "Notes",
 CellID->2004575655,ExpressionUUID->"c5eece7d-2d4c-48d3-9c3a-784214ba2c0c"],

Cell[TextData[{
 "The kernel computes the rules as ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Catenate",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Catenate"], "@", 
   RowBox[{
    ButtonBox["MapThread",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/MapThread"], "[", 
    RowBox[{
     RowBox[{
      ButtonBox["Thread",
       BaseStyle->"Link",
       ButtonData->"paclet:ref/Thread"], "[", 
      RowBox[{
       RowBox[{"#1", "\[Rule]", "#2"}], "&"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["indices", "TI"], ",", 
       StyleBox["dimensions", "TI"]}], "}"}]}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"a2220002-aaaa-4006-bbbb-cccccccccc06"],
 ": each per-tensor index list is paired pointwise with that tensor's \
dimension list."
}], "Notes",
 CellID->2004575656,ExpressionUUID->"a2220003-aaaa-4007-bbbb-cccccccccc07"],

Cell[TextData[{
 "The property form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<IndexDimensions\>\"", "]"}]], 
  "InlineFormula",ExpressionUUID->"a2220004-aaaa-4008-bbbb-cccccccccc08"],
 " is equivalent to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkIndexDimensions",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndexDimensions"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a2220005-aaaa-4009-bbbb-cccccccccc09"],
 "."
}], "Notes",
 CellID->2004575657,ExpressionUUID->"a2220006-aaaa-4010-bbbb-cccccccccc10"],

Cell[TextData[{
 "Internal indices (those that appear in two or more tensors) have the same \
dimension at every occurrence, by the consistency check enforced by ",
 Cell[BoxData[
  ButtonBox["TensorNetworkQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkQ"]], 
  "InlineFormula",ExpressionUUID->"a2220007-aaaa-4011-bbbb-cccccccccc11"],
 ". The repeated rules therefore agree on their right-hand sides."
}], "Notes",
 CellID->2004575658,ExpressionUUID->"a2220008-aaaa-4012-bbbb-cccccccccc12"],

Cell[TextData[{
 "Because the same index can appear multiple times on the left-hand side, the \
output is a ",
 Cell[BoxData[
  ButtonBox["List",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/List"]], "InlineFormula",ExpressionUUID->
  "a2220009-aaaa-4013-bbbb-cccccccccc13"],
 " of rules rather than an ",
 Cell[BoxData[
  ButtonBox["Association",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Association"]], "InlineFormula",ExpressionUUID->
  "a2220010-aaaa-4014-bbbb-cccccccccc14"],
 ". Wrap with ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", "\[Ellipsis]", "\[RightAssociation]"}]], 
  "InlineFormula",ExpressionUUID->"a2220011-aaaa-4015-bbbb-cccccccccc15"],
 " (overwriting duplicates) or ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["GroupBy",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/GroupBy"], "[", 
   ButtonBox["First",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/First"], "]"}]], "InlineFormula",ExpressionUUID->
  "a2220012-aaaa-4016-bbbb-cccccccccc16"],
 " to get a unique-key view."
}], "Notes",
 CellID->2004575659,ExpressionUUID->"a2220013-aaaa-4017-bbbb-cccccccccc13"],

Cell[TextData[{
 "For the graph form returned by ",
 Cell[BoxData[
  ButtonBox["ToTensorNetworkGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]], 
  "InlineFormula",ExpressionUUID->"a2220014-aaaa-4018-bbbb-cccccccccc18"],
 ", the keys are ",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->
  "a2220015-aaaa-4019-bbbb-cccccccccc19"],
 " (output legs) and ",
 Cell[BoxData[
  ButtonBox["Subscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Subscript"]], "InlineFormula",ExpressionUUID->
  "a2220016-aaaa-4020-bbbb-cccccccccc20"],
 " (input legs) encoding the vertex and slot of each leg."
}], "Notes",
 CellID->2004575660,ExpressionUUID->"a2220017-aaaa-4021-bbbb-cccccccccc21"],

Cell[TextData[{
 "The same value is exposed under the ",
 Cell[BoxData[
  ButtonBox["TensorNetworkData",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkData"]], 
  "InlineFormula",ExpressionUUID->"a2220018-aaaa-4022-bbbb-cccccccccc22"],
 " entry computed from the ",
 Cell[BoxData["\"\<Indices\>\""], "InlineFormula",ExpressionUUID->
  "a2220019-aaaa-4023-bbbb-cccccccccc23"],
 " and ",
 Cell[BoxData["\"\<Dimensions\>\""], "InlineFormula",ExpressionUUID->
  "a2220020-aaaa-4024-bbbb-cccccccccc24"],
 " keys."
}], "Notes",
 CellID->2004575661,ExpressionUUID->"a2220021-aaaa-4025-bbbb-cccccccccc25"]
}, Open  ]],

