Cell[TextData[{
 "Wrap with ",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", "\[Ellipsis]", "\[RightAssociation]"}]], 
  "InlineFormula",ExpressionUUID->"a5550008-dddd-4008-eeee-aaaaaaaaaa08"],
 " to collapse duplicates into a unique-key lookup table; later rules \
overwrite earlier ones with the same key, which is safe here because the \
dimensions agree:"
}], "ExampleText",
 CellID->650002010,ExpressionUUID->"a5550009-dddd-4009-eeee-aaaaaaaaaa09"],

