Cell[TextData[{
 "Each index appears once per occurrence; ",
 Cell[BoxData[
  ButtonBox["TensorNetworkIndexDimensions",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndexDimensions"]], 
  "InlineFormula",ExpressionUUID->"a5550003-dddd-4003-eeee-aaaaaaaaaa03"],
 " does not deduplicate, so a shared label appears as many times as the \
number of tensors containing it."
}], "ExampleText",
 CellID->650002002,ExpressionUUID->"a5550004-dddd-4004-eeee-aaaaaaaaaa04"],

