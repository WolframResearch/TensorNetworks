Cell[BoxData[
 RowBox[{
  RowBox[{"mps", " ", "=", " ", 
   RowBox[{"RandomTensorNetwork", "[", 
    RowBox[{"\"\<MPS\>\"", "[", 
     RowBox[{"6", ",", " ", "4", ",", " ", "2"}], "]"}], "]"}]}], 
  ";"}]], "Input",
