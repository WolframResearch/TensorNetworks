Notebook[{

Cell[CellGroupData[{
Cell["MPSOverlap", "ObjectName",
 CellID->735154253,ExpressionUUID->"a6d1112d-b95f-440c-b75d-c48e371fe5ac"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"619eb09e-f4ba-4376-8ee3-a834b53ef3db"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSOverlap",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/MPSOverlap"], "[", 
   RowBox[{
    StyleBox["mps\:2081", "TI"], ",", 
    StyleBox["mps\:2082", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d9bb215b-6bfa-4b39-a999-f6616d695125"],
 "\[LineSeparator]computes the inner product \[LeftAngleBracket]\[Psi]\:2081|\
\[Psi]\:2082\[RightAngleBracket] between two MPS. \[Bullet] The second MPS is \
conjugated in the inner product. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f2173503-d973-49c9-a23a-99bf97fc1066"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSOverlap",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/MPSOverlap"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", 
    StyleBox["mps", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c540fecf-9d91-4492-b28b-9565aebdb765"],
 "\[LineSeparator]returns the squared norm of the MPS."
}], "Usage",
 CellChangeTimes->{{3.9786383801608047`*^9, 3.978638380200629*^9}},
 CellID->1264108980,ExpressionUUID->"928ae0ba-4957-4f27-a98a-3470198a354a"],

