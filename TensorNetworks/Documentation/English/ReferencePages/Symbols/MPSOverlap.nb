Cell["The difference is zero to floating-point precision:", "ExampleText",
 CellID->550555444,ExpressionUUID->"ce0c2633-7447-4794-919b-8e9e2a269f6c"],

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{
