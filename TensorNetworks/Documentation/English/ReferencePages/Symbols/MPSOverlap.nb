Notebook[{

Cell[CellGroupData[{
Cell["MPSOverlap", "ObjectName",
 CellID->536421856,ExpressionUUID->"44865ce6-6964-421b-80f0-7c5943619f7b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1866bd35-1c71-40fb-928e-b4d97b211782"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSOverlap",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSOverlap"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["mps", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["mps", "TI"], "2"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8d61452d-7c6d-4a21-8f4b-6a50a2863671"],
 "\[LineSeparator]computes the inner product ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    SubscriptBox["\[Psi]", "1"], "|", 
    SubscriptBox["\[Psi]", "2"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"97d9104c-0d5f-4bc3-9553-f704a3cc6e91"],
 " between two matrix-product states. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"412de9e2-0ba4-45f7-b60a-00f68c07924d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSOverlap",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSOverlap"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", 
    StyleBox["mps", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "21892f5b-45ee-45e1-85ff-5a79829460e7"],
 "\[LineSeparator]returns the squared norm ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{
     "\[LeftDoubleBracketingBar]", "\[Psi]", "\[RightDoubleBracketingBar]"}], 
     "2"], "=", 
    RowBox[{
    "\[LeftAngleBracket]", "\[Psi]", "|", "\[Psi]", 
     "\[RightAngleBracket]"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3770ff40-43c3-439f-95a8-eb5e85cd761b"],
 "."
}], "Usage",
 CellID->343718104,ExpressionUUID->"7070dfde-a989-488b-8845-d07444525730"],

Cell[TextData[{
 "The second argument is conjugated: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    SubscriptBox["\[Psi]", "1"], "|", 
    SubscriptBox["\[Psi]", "2"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a1923587-8263-4700-bbbe-994088766fc5"],
 " is the standard quantum-mechanical inner product, antilinear in the first \
argument and linear in the second."
}], "Notes",
 CellID->557581098,ExpressionUUID->"a70226dd-5e3b-4a7b-ba34-ff66af94dadb"],

Cell["\<\
The two MPS must have the same number of sites and matching physical \
dimensions on every site.\
\>", "Notes",
 CellID->153824125,ExpressionUUID->"3ebf7231-c39e-469a-9962-d1a9816afdbd"],

Cell[TextData[{
 "Internally, ",
 Cell[BoxData[
  ButtonBox["MPSOverlap",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSOverlap"]], 
  "InlineFormula",ExpressionUUID->"16cb6ada-d0e3-45b0-a0a6-1b992104a3b7"],
 " performs a left-to-right transfer-matrix sweep: at each site the running \
transfer matrix is contracted with the current site's tensor of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9e557358-4583-4555-a8e3-5f519f92e474"],
 " and the conjugate of the corresponding tensor of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2e7a829a-0190-47f0-868e-78eb99c69295"],
 ". The final result is a scalar."
}], "Notes",
 CellID->124046270,ExpressionUUID->"892eedba-0ccd-4b22-b395-2b5025ab29e0"],

Cell[TextData[{
 "The per-site contractions are expressed with ",
 Cell[BoxData[
  ButtonBox["EinsteinSummation",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/EinsteinSummation"]], 
  "InlineFormula",ExpressionUUID->"58f9afc2-0f47-44c3-914a-00f2b378bbe9"],
 " and evaluated with ",
 Cell[BoxData[
  ButtonBox["ActivateTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ActivateTensors"]], 
  "InlineFormula",ExpressionUUID->"b9a372f5-3e79-4165-bd20-50da00506d0d"],
 "."
}], "Notes",
 CellID->583623566,ExpressionUUID->"7a9182ab-28de-4460-8a96-16aeae5dc8c9"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSOverlap",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSOverlap"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", 
    StyleBox["mps", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "05077c78-54c3-4199-b1ea-f37be68cdc01"],
 " is the squared 2-norm of the state; ",
 Cell[BoxData[
  ButtonBox["MPSNorm",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"]], "InlineFormula",
  ExpressionUUID->"389fa891-76ef-46e4-8faf-feff8af64175"],
 " returns its square root: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"MPSNorm", "[", 
    StyleBox["mps", "TI"], "]", "=", 
    SqrtBox[
     RowBox[{"Abs", "[", 
      RowBox[{"MPSOverlap", "[", 
       RowBox[{
        StyleBox["mps", "TI"], ",", 
        StyleBox["mps", "TI"]}], "]"}], "]"}]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6c9e2399-d468-41de-b426-e6f49edc0cfc"],
 "."
}], "Notes",
 CellID->199655225,ExpressionUUID->"6e537c8d-86db-4846-8cb9-46422330a6d6"],

Cell[TextData[{
 "If the two arguments have different numbers of sites, ",
 Cell[BoxData[
  ButtonBox["MPSOverlap",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSOverlap"]], 
  "InlineFormula",ExpressionUUID->"a4e8d3b7-0b25-4582-9d40-d3228b40b4be"],
 " issues the message ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"MPSOverlap", "::", "length"}], "TI"]], "InlineFormula",
  ExpressionUUID->"222541f4-f3ad-43bc-aef9-e562e30c7ce3"],
 " and returns ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "1a7c6d0b-ab5b-4ee8-b1b3-7c4dca6906a6"],
 "."
}], "Notes",
 CellID->958532271,ExpressionUUID->"1e5037e1-03d2-4efb-8d6c-bc7c3b703bab"]
}, Open  ]],

