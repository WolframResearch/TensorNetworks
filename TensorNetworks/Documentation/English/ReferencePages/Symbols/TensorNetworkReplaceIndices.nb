     RowBox[{"Superscript", "[",
      RowBox[{"1", ",", "\"\<bond\>\""}], "]"}]}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->452500032,ExpressionUUID->"a3c8c81e-1234-5678-9abc-de0012345023"]
