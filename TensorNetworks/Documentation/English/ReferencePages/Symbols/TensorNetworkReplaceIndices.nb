 CellID->452500011,ExpressionUUID->"a3c8c81e-1234-5678-9abc-de0012345011"],

Cell["Renaming an index to a label that already exists on another vertex creates a duplicate index name. The result is still a Graph, but it no longer satisfies TensorNetworkGraphQ because the index sets are no longer DuplicateFreeQ:", "ExampleText",
 CellID->452500020,ExpressionUUID->"a3c8c81e-1234-5678-9abc-de0012345012"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "=",
   RowBox[{"ToTensorNetworkGraph", "[", "tn", "]"}]}], ";"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->452500021,ExpressionUUID->"a3c8c81e-1234-5678-9abc-de0012345013"],

Cell[BoxData[
 RowBox[{"TensorNetworkGraphQ", "[",
  RowBox[{"TensorNetworkReplaceIndices", "[",
   RowBox[{"g", ",",
    RowBox[{
     RowBox[{"Superscript", "[",
      RowBox[{"1", ",", "1"}], "]"}], "\[Rule]",
     RowBox[{"Superscript", "[",
      RowBox[{"1", ",", "2"}], "]"}]}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->452500022,ExpressionUUID->"a3c8c81e-1234-5678-9abc-de0012345014"],

