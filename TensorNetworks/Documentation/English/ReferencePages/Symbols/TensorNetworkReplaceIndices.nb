Cell["\<\
Rename g2's first input index to match g1's free output index name so the two \
networks share a label and can be contracted:\
\>", "ExampleText",
 CellID->452300004,ExpressionUUID->"1cd50a07-3284-43aa-9304-16174f2c9ea0"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndices", "[", 
