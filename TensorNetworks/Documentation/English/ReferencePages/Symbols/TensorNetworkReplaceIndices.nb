Notebook[{

Cell[CellGroupData[{
Cell["TensorNetworkReplaceIndices", "ObjectName",
 CellID->1897082303,ExpressionUUID->"99021eee-fbac-4d0f-9013-69a35a06a2b8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0777b8c6-8d88-4fae-b4c8-28fceba18ed0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkReplaceIndices",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/TensorNetworks/ref/TensorNetworkReplaceIndices"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", 
    StyleBox["rules", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "77a52227-926e-430a-ab15-645a6a766f25"],
 "\[LineSeparator]returns a tensor-network ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "0a135a15-a831-4f1c-8100-2b2907c7365a"],
 " whose ",
 Cell[BoxData["\"\<Index\>\""], "InlineFormula",ExpressionUUID->
  "d4fa0ca7-8a8d-4bcc-8c33-7c7e3c8489ef"],
 " annotations have been rewritten by applying ",
 Cell[BoxData[
  StyleBox["rules", "TI"]], "InlineFormula",ExpressionUUID->
  "93c1e612-33e5-46cb-aec9-7ed47f0aa163"],
 " to every per-vertex index list."
}], "Usage",
 CellID->572559512,ExpressionUUID->"c29373c1-0c70-4cc9-982d-705ed0779b9a"],

Cell[TextData[{
 "The input ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "1846198f-1cc6-4d7d-8016-68e37b0c2065"],
 " must satisfy ",
 Cell[BoxData[
  ButtonBox["TensorNetworkGraphQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphQ"]], 
  "InlineFormula",ExpressionUUID->"866558c1-5761-4d94-8484-fb1991a612d1"],
 ". Convert a ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"e9235225-31fd-4b3d-9be6-dd1a5e8b7b17"],
 " object with ",
 Cell[BoxData[
  ButtonBox["ToTensorNetworkGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]], 
  "InlineFormula",ExpressionUUID->"0000efd7-5462-4a1b-9998-cb8c2920809c"],
 " first."
}], "Notes",
 CellID->133495977,ExpressionUUID->"47b43c54-cf27-41e1-9826-bbd2bc9e498d"],

Cell[TextData[{
 "Each vertex's ",
 Cell[BoxData["\"\<Index\>\""], "InlineFormula",ExpressionUUID->
  "7b5d9f70-cece-4a62-b8fe-1ac329a807d7"],
 " annotation is updated by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Replace",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Replace"], "[", 
   RowBox[{
    StyleBox["indices", "TI"], ",", 
    StyleBox["rules", "TI"], ",", 
    RowBox[{"{", "2", "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0d32f1f3-d6e7-4d83-823c-7438a8d75dd9"],
 " \[LongDash] the rules are tried at level 2 of the index pool, so each \
individual ",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->
  "6ca6ac9c-30f6-4ebf-b234-caa2835cf84d"],
 "/",
 Cell[BoxData[
  ButtonBox["Subscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Subscript"]], "InlineFormula",ExpressionUUID->
  "7e2d2bf8-2a2f-4f8f-86ef-6de94df292ff"],
 " expression is matched as a whole."
}], "Notes",
 CellID->452100001,ExpressionUUID->"16675e3a-83d8-4b0f-887f-4df42d3535e0"],

Cell[TextData[{
 StyleBox["rules", "TI"],
 " may be a single rule ",
 Cell[BoxData[
  RowBox[{
   StyleBox["old", "TI"], "\[Rule]", 
   StyleBox["new", "TI"]}]], "InlineFormula",ExpressionUUID->
  "38014f3f-cc23-477a-9623-4d1ed47a265a"],
 " or a list of rules. Standard ",
 Cell[BoxData[
  ButtonBox["Replace",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Replace"]], "InlineFormula",ExpressionUUID->
  "61b143b4-a680-49a2-8509-1133e442a8cf"],
 " semantics apply: rules are tried in order and the first matching rule \
fires per position."
}], "Notes",
 CellID->452100002,ExpressionUUID->"3aedb566-db1b-4edc-ad4a-6b37a3309d37"],

Cell[TextData[{
 "Variance is preserved by the head of the replacement: rewriting ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Superscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Superscript"], "[", 
   RowBox[{
    StyleBox["v", "TI"], ",", 
    StyleBox["k", "TI"]}], "]", "\[Rule]", 
   RowBox[{
    ButtonBox["Superscript",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Superscript"], "[", 
    RowBox[{
     StyleBox["v", "TI"], ",", 
     StyleBox[
      RowBox[{"k", "'"}], "TI"]}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "cc6c8b6d-8f72-4466-b15c-890870035290"],
 " keeps the index contravariant (output); use ",
 Cell[BoxData[
  ButtonBox["Subscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Subscript"]], "InlineFormula",ExpressionUUID->
  "eaf086c9-23e0-45d4-8617-c6c140c0cdbc"],
 " on both sides for an input slot."
}], "Notes",
 CellID->452100003,ExpressionUUID->"3490dcb5-9324-4b7d-bcf4-d86346027fda"],

Cell[TextData[{
 "Only the per-vertex ",
 Cell[BoxData["\"\<Index\>\""], "InlineFormula",ExpressionUUID->
  "504696df-0646-4b12-9b2a-ed7ea529b28d"],
 " annotations are rewritten. Edge tags of the graph, which also reference \
the old index labels, are not updated by ",
 Cell[BoxData[
  ButtonBox["TensorNetworkReplaceIndices",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/TensorNetworks/ref/TensorNetworkReplaceIndices"]], 
  "InlineFormula",ExpressionUUID->"2c53ee34-2ce7-4185-b95d-b49a002bdd17"],
 "."
}], "Notes",
 CellID->452100004,ExpressionUUID->"696d62bb-3442-49d1-a648-d901437a00b5"]
}, Open  ]],

