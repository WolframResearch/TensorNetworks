Cell["Build a small tensor network and convert it to a graph:", "ExampleText",
 CellID->740001001,ExpressionUUID->"e4e06bf0-f8d9-456e-80bd-42c1824591e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->740001002,ExpressionUUID->"0fd26131-9f3d-40a7-8b66-1d0945dbeae9"],

Cell[BoxData[
 RowBox[{"g", "=", 
  RowBox[{"ToTensorNetworkGraph", "[", "tn", "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->740001003,ExpressionUUID->"847742df-ac06-4cbe-836a-6b951058e30d"],

Cell["\<\
The graph's per-vertex index annotations use Superscript/Subscript labels:\
\>", "ExampleText",
 CellID->740001010,ExpressionUUID->"1263ecdf-682d-4e9f-84af-f065fd59b23d"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndices", "[", "g", "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->740001011,ExpressionUUID->"01f52908-9808-43c4-9cfa-bfc108d1d40a"],

Cell["Rename a single free index:", "ExampleText",
 CellID->740001020,ExpressionUUID->"52f4a97c-6c6c-447e-b976-6b0489d88693"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndices", "[", 
  RowBox[{"TensorNetworkReplaceIndices", "[", 
   RowBox[{"g", ",", 
    RowBox[{
     RowBox[{"Superscript", "[", 
      RowBox[{"1", ",", "1"}], "]"}], "\[Rule]", 
     RowBox[{"Superscript", "[", 
      RowBox[{"1", ",", "\"\<i\>\""}], "]"}]}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->740001021,ExpressionUUID->"d4979c82-20bb-4773-b41b-f4d9a9e723c0"],

Cell["\<\
Rename the two free indices in one call by passing a list of rules:\
\>", "ExampleText",
 CellID->740001030,ExpressionUUID->"872dc8b5-16f0-48c5-a2ec-11e220d9065b"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndices", "[", 
  RowBox[{"TensorNetworkReplaceIndices", "[", 
   RowBox[{"g", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Superscript", "[", 
        RowBox[{"1", ",", "1"}], "]"}], "\[Rule]", 
       RowBox[{"Superscript", "[", 
        RowBox[{"1", ",", "\"\<a\>\""}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"2", ",", "2"}], "]"}], "\[Rule]", 
       RowBox[{"Subscript", "[", 
        RowBox[{"2", ",", "\"\<c\>\""}], "]"}]}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->740001031,ExpressionUUID->"0cd9511b-ab91-4fad-9e09-39b263df301e"],

