Cell[CellGroupData[{

Cell["A TensorNetwork object is not a Graph and does not satisfy TensorNetworkGraphQ. Calling TensorNetworkReplaceIndices on it returns unevaluated:", "ExampleText",
 CellID->452500001,ExpressionUUID->"a3c8c81e-1234-5678-9abc-de0012345003"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->452500002,ExpressionUUID->"a3c8c81e-1234-5678-9abc-de0012345004"],

Cell[BoxData[
 RowBox[{"Head", "[",
  RowBox[{"TensorNetworkReplaceIndices", "[",
   RowBox[{"tn", ",",
    RowBox[{"i", "\[Rule]", "a"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->452500003,ExpressionUUID->"a3c8c81e-1234-5678-9abc-de0012345005"],

Cell["Apply ToTensorNetworkGraph first:", "ExampleText",
 CellID->452500004,ExpressionUUID->"a3c8c81e-1234-5678-9abc-de0012345006"],

Cell[BoxData[
 RowBox[{"Head", "[",
  RowBox[{"TensorNetworkReplaceIndices", "[",
   RowBox[{
    RowBox[{"ToTensorNetworkGraph", "[", "tn", "]"}], ",",
    RowBox[{
     RowBox[{"Superscript", "[",
      RowBox[{"1", ",", "1"}], "]"}], "\[Rule]",
     RowBox[{"Superscript", "[",
      RowBox[{"1", ",", "\"\<a\>\""}], "]"}]}]}], "]"}], "]"}]], "Input",
