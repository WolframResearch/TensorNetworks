Cell[CellGroupData[{

Cell["The TN-form analog of TensorNetworkReplaceIndices is a direct Replace at level 2 of the \"Hyperedges\" list:", "ExampleText",
 CellID->452400001,ExpressionUUID->"a95c7127-94ba-4694-bbdd-7a2fdbb1b550"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->452400002,ExpressionUUID->"40ef7241-4f72-4baa-8a67-76d9614eea3b"],

Cell[BoxData[
 RowBox[{"Replace", "[",
  RowBox[{
   RowBox[{"tn", "[", "\"\<Hyperedges\>\"", "]"}], ",",
   RowBox[{"{",
    RowBox[{
     RowBox[{"i", "\[Rule]", "a"}], ",",
     RowBox[{"k", "\[Rule]", "c"}]}], "}"}], ",",
   RowBox[{"{", "2", "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->452400003,ExpressionUUID->"a34b724e-8f64-45b4-b0e5-2b20c865f8b5"],

Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter",ExpressionUUID->"bb510a4f-640b-4c94-a70b-867b0a16dd0a"], $Line = 0; Null]], "ExampleDelimiter",
 CellID->452400010,ExpressionUUID->"f0df7df3-ad3c-42f9-810c-7964c5bf5628"],

Cell["TensorNetworkReplaceIndices operates on the Graph form and rewrites the per-vertex \"Index\" annotations, which use Superscript/Subscript labels:", "ExampleText",
 CellID->452400011,ExpressionUUID->"a3c8c81e-1234-5678-9abc-def012345678"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndices", "[",
  RowBox[{"TensorNetworkReplaceIndices", "[",
   RowBox[{
    RowBox[{"ToTensorNetworkGraph", "[", "tn", "]"}], ",",
    RowBox[{"{",
     RowBox[{
      RowBox[{
       RowBox[{"Superscript", "[",
        RowBox[{"1", ",", "1"}], "]"}], "\[Rule]",
       RowBox[{"Superscript", "[",
        RowBox[{"1", ",", "\"\<a\>\""}], "]"}]}], ",",
      RowBox[{
       RowBox[{"Subscript", "[",
        RowBox[{"2", ",", "2"}], "]"}], "\[Rule]",
       RowBox[{"Subscript", "[",
        RowBox[{"2", ",", "\"\<c\>\""}], "]"}]}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->452400012,ExpressionUUID->"b3c8c81e-1234-5678-9abc-def012345679"],

Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter",ExpressionUUID->"c3c8c81e-1234-5678-9abc-def01234567a"], $Line = 0; Null]], "ExampleDelimiter",
 CellID->452400020,ExpressionUUID->"d3c8c81e-1234-5678-9abc-def01234567b"],

