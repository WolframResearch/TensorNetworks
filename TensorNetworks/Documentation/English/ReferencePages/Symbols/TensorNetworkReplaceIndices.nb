Cell[CellGroupData[{

Cell["Single rule", "ExampleSubsection",
 CellID->452200001,ExpressionUUID->"ac653dcb-aec5-434c-ac89-403ed30279de"],

Cell["A single rule can be passed directly, without wrapping it in a list:", "ExampleText",
 CellID->452200002,ExpressionUUID->"e3d025a4-9837-4293-bdf9-329a3d994ae5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->452200003,ExpressionUUID->"b8d6c538-4608-4ee3-b7df-1271631c6c51"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "=", RowBox[{"ToTensorNetworkGraph", "[", "tn", "]"}]}], ";"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->452200004,ExpressionUUID->"3c768130-16d1-42f8-9a18-ec495474fcac"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndices", "[",
  RowBox[{"TensorNetworkReplaceIndices", "[",
   RowBox[{"g", ",",
    RowBox[{
     RowBox[{"Superscript", "[",
      RowBox[{"1", ",", "1"}], "]"}], "\[Rule]",
     RowBox[{"Superscript", "[",
      RowBox[{"1", ",", "\"\<out\>\""}], "]"}]}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->452200005,ExpressionUUID->"0eacc366-b995-42f9-8371-de589bcde1dd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Multiple rules", "ExampleSubsection",
 CellID->452210001,ExpressionUUID->"6b642561-7710-4f0a-9c31-3965327d8525"],

Cell["A list of rules renames several indices in one call:", "ExampleText",
 CellID->452210002,ExpressionUUID->"a6effa99-ac40-4004-87f7-87cb030b22b3"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndices", "[",
  RowBox[{"TensorNetworkReplaceIndices", "[",
   RowBox[{"g", ",",
    RowBox[{"{",
     RowBox[{
      RowBox[{
       RowBox[{"Superscript", "[",
        RowBox[{"1", ",", "1"}], "]"}], "\[Rule]",
       RowBox[{"Superscript", "[",
        RowBox[{"1", ",", "\"\<a\>\""}], "]"}]}], ",",
      RowBox[{
       RowBox[{"Subscript", "[",
        RowBox[{"2", ",", "2"}], "]"}], "\[Rule]",
       RowBox[{"Subscript", "[",
        RowBox[{"2", ",", "\"\<c\>\""}], "]"}]}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->452210003,ExpressionUUID->"b52df3bd-1052-46b4-aa00-e75bfe28d695"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Working with variance", "ExampleSubsection",
 CellID->452220001,ExpressionUUID->"fe004a7a-963b-4a5b-b792-3eda178f9268"],

Cell["The head of the replacement determines the slot variance. Replacing a Superscript with a Superscript keeps the slot contravariant (output):", "ExampleText",
 CellID->452220002,ExpressionUUID->"de2722d0-1dbb-4913-8a09-aabee9ad2c9e"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndices", "[",
  RowBox[{"TensorNetworkReplaceIndices", "[",
   RowBox[{"g", ",",
    RowBox[{
     RowBox[{"Superscript", "[",
      RowBox[{"1", ",", "1"}], "]"}], "\[Rule]",
     RowBox[{"Superscript", "[",
      RowBox[{"1", ",", "\"\<out\>\""}], "]"}]}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->452220003,ExpressionUUID->"7f53417f-58b3-459d-b3d4-fea10279c33b"],

Cell["A Subscript-to-Subscript rewrite leaves the slot covariant (input):", "ExampleText",
 CellID->452220004,ExpressionUUID->"2b693469-4a02-4ccd-aa76-2bf77da4282e"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndices", "[",
  RowBox[{"TensorNetworkReplaceIndices", "[",
   RowBox[{"g", ",",
    RowBox[{
     RowBox[{"Subscript", "[",
      RowBox[{"2", ",", "2"}], "]"}], "\[Rule]",
     RowBox[{"Subscript", "[",
      RowBox[{"2", ",", "\"\<in\>\""}], "]"}]}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->452220005,ExpressionUUID->"fd8acbd1-50f9-468b-91c4-0b9b86643756"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Round-trip through TensorNetwork", "ExampleSubsection",
 CellID->452230001,ExpressionUUID->"9f133736-f87d-4e89-ada3-740fd06a7191"],

Cell["The result is a Graph; wrap it in TensorNetwork to obtain the TN-form again with the renamed indices visible in the hyperedge list:", "ExampleText",
 CellID->452230002,ExpressionUUID->"a660ccf4-3200-4849-b59a-9284ece5d290"],

Cell[BoxData[
 RowBox[{"TensorNetwork", "[",
  RowBox[{"TensorNetworkReplaceIndices", "[",
   RowBox[{"g", ",",
    RowBox[{"{",
     RowBox[{
      RowBox[{
       RowBox[{"Superscript", "[",
        RowBox[{"1", ",", "1"}], "]"}], "\[Rule]",
       RowBox[{"Superscript", "[",
        RowBox[{"1", ",", "\"\<a\>\""}], "]"}]}], ",",
      RowBox[{
       RowBox[{"Subscript", "[",
        RowBox[{"2", ",", "2"}], "]"}], "\[Rule]",
       RowBox[{"Subscript", "[",
        RowBox[{"2", ",", "\"\<c\>\""}], "]"}]}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->452230003,ExpressionUUID->"e0f77c34-a353-464a-919f-712e5610e0fe"]
