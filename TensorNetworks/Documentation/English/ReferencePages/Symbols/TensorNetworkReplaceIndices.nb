Cell[CellGroupData[{

Cell["Align indices before merging two graphs:", "ExampleText",
 CellID->452300001,ExpressionUUID->"6b4014a4-279f-462f-8714-db3ce9468826"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g1", "=",
   RowBox[{"ToTensorNetworkGraph", "[",
    RowBox[{"TensorNetwork", "[",
     RowBox[{
      RowBox[{"{",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"p", ",", "q"}], "}"}], "}"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->452300002,ExpressionUUID->"1baf47c3-e7f7-421c-966a-773adaf93338"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g2", "=",
   RowBox[{"ToTensorNetworkGraph", "[",
    RowBox[{"TensorNetwork", "[",
     RowBox[{
      RowBox[{"{",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"{",
        RowBox[{"r", ",", "s"}], "}"}], "}"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->452300003,ExpressionUUID->"76c4ae29-26cb-4f0d-aafc-ac8a979e3875"],

Cell["Rename g2's first input index to match g1's free output index name so the two networks share a label and can be contracted:", "ExampleText",
 CellID->452300004,ExpressionUUID->"1cd50a07-3284-43aa-9304-16174f2c9ea0"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndices", "[",
  RowBox[{"TensorNetworkReplaceIndices", "[",
   RowBox[{"g2", ",",
    RowBox[{
     RowBox[{"Subscript", "[",
      RowBox[{"1", ",", "1"}], "]"}], "\[Rule]",
     RowBox[{"Subscript", "[",
      RowBox[{"1", ",", "\"\<bond\>\""}], "]"}]}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->452300005,ExpressionUUID->"ff35a22c-0884-402d-8177-61441ac8e088"],

Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter",ExpressionUUID->"20fae7ce-f2f6-4657-a638-43afc9d8232e"], $Line = 0; Null]], "ExampleDelimiter",
 CellID->452300010,ExpressionUUID->"9bff9ee7-9d77-411b-8577-55b2347a0305"],

Cell["Use descriptive names for free indices to pretty-print a workflow graph:", "ExampleText",
 CellID->452300011,ExpressionUUID->"e2e699a0-d928-494f-8d13-8db3564aff01"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->452300012,ExpressionUUID->"ab456a45-c40a-4750-9167-1a73419d33c6"],

Cell[BoxData[
 RowBox[{"TensorNetworkReplaceIndices", "[",
  RowBox[{
   RowBox[{"ToTensorNetworkGraph", "[", "tn", "]"}], ",",
   RowBox[{"{",
    RowBox[{
     RowBox[{
      RowBox[{"Superscript", "[",
       RowBox[{"1", ",", "1"}], "]"}], "\[Rule]",
      RowBox[{"Superscript", "[",
       RowBox[{"1", ",", "\"\<output\>\""}], "]"}]}], ",",
     RowBox[{
      RowBox[{"Subscript", "[",
       RowBox[{"2", ",", "2"}], "]"}], "\[Rule]",
      RowBox[{"Subscript", "[",
       RowBox[{"2", ",", "\"\<input\>\""}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->452300013,ExpressionUUID->"9f249582-e982-4d04-969f-b7264a1a9daf"]
}, Open  ]]
}, Open  ]],

