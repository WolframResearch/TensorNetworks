      RowBox[{
       RowBox[{"Superscript", "[", 
        RowBox[{"1", ",", "1"}], "]"}], "\[Rule]", 
       RowBox[{"Superscript", "[", 
        RowBox[{"1", ",", "\"\<a\>\""}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"2", ",", "2"}], "]"}], "\[Rule]", 
