\>", "ExampleText",
 CellID->400000007,ExpressionUUID->"d2e3f4a5-0000-1111-2222-d2e3f4a50001"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tn", "=", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "42", "]"}], ";", 
     RowBox[{"RandomTensorNetwork", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"4", ",", "5"}], "}"}], ",", "3"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"userPath", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"TensorNetworkContract", "[", 
       RowBox[{"tn", ",", 
        RowBox[{"CanonicalPath", "[", "userPath", "]"}]}], "]"}], "]"}], "-", 
     
     RowBox[{"Normal", "[", 
      RowBox[{"TensorNetworkContract", "[", "tn", "]"}], "]"}]}], "]"}], 
   "]"}], "]"}]}], "Input",
 CellLabel->"In[3]:=",
