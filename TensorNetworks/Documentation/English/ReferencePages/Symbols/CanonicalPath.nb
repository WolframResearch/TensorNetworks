Cell["\<\
CanonicalPath converts paths with singletons {i} (keep tensor, don't contract \
yet) into canonical form (only pairs). It works as: path \[RightArrow] tree \
\[RightArrow] canonical path\
\>", "Notes",
 CellChangeTimes->{{3.978720410729793*^9, 3.9787204131026993`*^9}, {
  3.978720532454454*^9, 3.97872053654735*^9}},
 CellID->1806453462,ExpressionUUID->"c5c67aa4-ec5b-4b89-a72f-006e4f3a4bc0"]
}, Open  ]],

