Cell[CellGroupData[{
Cell["CanonicalPath", "ObjectName",
 CellID->529924707,ExpressionUUID->"00cd3f91-ac3a-4c98-81f5-24e186a8922e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7598161a-35c1-4dad-b0a9-6fe27a6ea373"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CanonicalPath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPath"], "[", 
   StyleBox["path", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c4677766-f256-4805-a452-a141a7fac6be"],
 "\[LineSeparator]returns the canonical (normalized) form of the contraction ",
 Cell[BoxData[
  StyleBox["path", "TI"]], "InlineFormula",ExpressionUUID->
  "b158f17c-fb1a-4af0-9297-221d4afc3adf"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2a1b8c4d-3e5f-6789-0abc-def012345678"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CanonicalPath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPath"], "[", 
   RowBox[{
    StyleBox["path", "TI"], ",", 
    StyleBox["indices", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f3c4d5e6-7890-1234-5678-9abcdef01234"],
 "\[LineSeparator]uses the explicit index list ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "1234abcd-5678-90ef-1234-567890abcdef"],
 " for the tree-path round-trip."
}], "Usage",
 CellID->829866440,ExpressionUUID->"0c8ae906-1610-435f-8b41-ab962e325350"],

Cell[TextData[{
 "The canonical form is the opt_einsum convention: a list of integer pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], "}"}], ",", "\[Ellipsis]"}], "}"}]], 
  "InlineFormula",ExpressionUUID->"2345bcde-6789-01fa-2345-678901bcdef0"],
 " where each step removes the tensors at positions ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "3456cdef-7890-12ab-3456-789012cdef01"],
 ", ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "4567def0-8901-23bc-4567-890123def012"],
 " from the working list and appends their contraction at the end."
}], "Notes",
 CellID->1806453462,ExpressionUUID->"c5c67aa4-ec5b-4b89-a72f-006e4f3a4bc0"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CanonicalPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPath"]], 
  "InlineFormula",ExpressionUUID->"5678ef01-9012-34cd-5678-901234ef0123"],
 " is implemented via ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TreePathToPath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TreePathToPath"], "[", 
   RowBox[{
    RowBox[{
     ButtonBox["PathToTreePath",
      BaseStyle->"Link",
      ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathToTreePath"], "[", 
     RowBox[{
      StyleBox["path", "TI"], ",", 
      StyleBox["indices", "TI"]}], "]"}], ",", 
    StyleBox["indices", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6789f012-0123-45de-6789-012345f01234"],
 " \[LongDash] the path is converted to a tree path and back, normalizing in \
the process."
}], "Notes",ExpressionUUID->"7890a123-1234-56ef-7890-123456a01234"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "8901b234-2345-67f0-8901-234567b01234"],
 " is ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Automatic"]], "InlineFormula",ExpressionUUID->
  "9012c345-3456-7801-9012-345678c01234"],
 ", the required arity is derived from the path as ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Count",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Count"], "[", 
   RowBox[{
    StyleBox["path", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{"_", ",", "_"}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0123d456-4567-8912-0123-456789d01234"],
 " + 1."
}], "Notes",ExpressionUUID->"1234e567-5678-9023-1234-56789ae01234"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CanonicalPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPath"]], 
  "InlineFormula",ExpressionUUID->"2345f678-6789-0134-2345-67890af01234"],
 " is used internally by ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"3456a789-7890-1245-3456-78901bf01234"],
 " and ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"4567a890-8901-2356-4567-89012cf01234"],
 " to wrap the path-finder output in canonical form."
}], "Notes",ExpressionUUID->"5678b901-9012-3467-5678-90123df01234"]
}, Open  ]],

