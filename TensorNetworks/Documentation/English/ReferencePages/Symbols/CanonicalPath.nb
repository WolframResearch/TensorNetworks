Cell["Tree-path round-trip", "ExampleSubsection",
 CellID->320000001,ExpressionUUID->"a5b6c7d8-5555-6666-7777-a5b6c7d80001"],

Cell[TextData[{
 "Any ",
 Cell[BoxData[
  ButtonBox["PathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathQ"]], "InlineFormula",
  ExpressionUUID->"b6c7d8e9-6666-7777-8888-b6c7d8e90001"],
 "-valid path is first converted to a tree path by ",
 Cell[BoxData[
