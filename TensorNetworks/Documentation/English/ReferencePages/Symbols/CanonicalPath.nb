Cell["Convert a contraction path to canonical form:", "ExampleText",
 CellID->498374651,ExpressionUUID->"78901234-5678-9012-abcd-ef1234567897"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"path", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"PathQ", "@", "path"}], "\[IndentingNewLine]", 
 RowBox[{"CanonicalPath", "[", "path", "]"}]}], "Input",
 CellChangeTimes->{{3.978720172318824*^9, 3.978720193406345*^9}, 
   3.9787202689243*^9, {3.9787252336884737`*^9, 3.978725249745278*^9}},
