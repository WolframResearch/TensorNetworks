Notebook[{

Cell[CellGroupData[{
Cell["IndexedMultiply", "ObjectName", 
      CellID -> 814664892, ExpressionUUID -> 
       "959d0a2c-c8eb-4aca-a14a-b9780af62e1a"],

Cell[TextData[{Cell["   ", "ModInfo", ExpressionUUID -> 
          "7f1117e4-35bb-41e7-9eb3-3bdd16713059"], 
        Cell[BoxData[RowBox[{ButtonBox["IndexedMultiply", BaseStyle -> 
              "Link", ButtonData -> 
              "paclet:Wolfram/TensorNetworks/ref/IndexedMultiply"], "[", 
            RowBox[{RowBox[{"{", RowBox[{StyleBox["i", "TI"], ",", 
                  StyleBox["j", "TI"], ",", "\[Ellipsis]"}], "}"}], ",", 
              RowBox[{"{", RowBox[{StyleBox["A", "TI"], ",", StyleBox["B", 
                   "TI"], ",", "\[Ellipsis]"}], "}"}]}], "]"}]], 
         "InlineFormula", ExpressionUUID -> 
          "b452693d-e539-446b-87c0-d9b28aea9719"], 
        "\[LineSeparator]joins the tensors ", 
        Cell[BoxData[RowBox[{StyleBox["A", "TI"], ",", StyleBox["B", "TI"], 
            ",", "\[Ellipsis]"}]], "InlineFormula", ExpressionUUID -> 
          "e9d0f05b-2869-4b78-a22c-598c52bd56cd"], 
        " by broadcasting along shared indices and returns the pair ", 
        Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["indices", "TI"], ",", 
              StyleBox["tensor", "TI"]}], "}"}]], "InlineFormula", 
         ExpressionUUID -> "c9a8e59a-09b6-451c-9fb9-2359b2dfc503"], "."}], 
      "Usage", CellID -> 223337487, ExpressionUUID -> 
       "56b5606c-031f-499f-8c31-43f079ef6b19"],

Cell[TextData[{Cell[BoxData[ButtonBox["IndexedMultiply", 
           BaseStyle -> "Link", ButtonData -> 
            "paclet:Wolfram/TensorNetworks/ref/IndexedMultiply"]], 
         "InlineFormula", ExpressionUUID -> 
          "4164d88e-0d06-402d-90ec-db14293f438f"], 
        " takes a list of per-tensor index lists ", 
        Cell[BoxData[RowBox[{"{", RowBox[{SubscriptBox[StyleBox["i", "TI"], 
               "1"], ",", SubscriptBox[StyleBox["i", "TI"], "2"], ",", 
              "\[Ellipsis]"}], "}"}]], "InlineFormula", 
         ExpressionUUID -> "8fce51e9-09e8-4f58-b9f4-8d0b4f7a892a"], 
        " whose lengths match the ranks of the corresponding tensors."}], 
      "Notes", CellID -> 984669801, ExpressionUUID -> 
       "58874026-a61e-41bd-8160-723fa63c68f7"],

Cell["Indices may be any \
expression (typically strings or symbols). Each index appearing in more than \
one tensor identifies an axis along which the inputs are aligned and \
broadcast.", "Notes", CellID -> 685904443, ExpressionUUID -> 
       "9fa28ffe-7ab6-46aa-931e-9acaa436ff17"],

Cell["The output indices are \
the union of the input indices in canonical (first-occurrence) order. The \
output tensor has one axis per output index, with dimension equal to the \
maximum size of that index across the inputs.", "Notes", CellID -> 309493800, 
      ExpressionUUID -> "af34db2a-0546-41c8-a459-843e9ac57cd4"],

Cell[TextData[{"Tensors that do not carry every output index are \
extended by repetition: each missing axis is padded with the ", 
        Cell[BoxData[ButtonBox["ArrayPad", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/ArrayPad"]], "InlineFormula", 
         ExpressionUUID -> "bc52cc4e-9554-4d4a-84b0-39af79b4476d"], " mode ", 
        Cell[BoxData["\"Fixed\""], "InlineFormula", ExpressionUUID -> 
          "4e8cec5f-d030-40ad-9958-0a67b1be03d4"], " when the tensor has \
dimension 1 along that axis, and otherwise filled with 1. Tensors that share \
an index but have different sizes along it are aligned by padding the smaller \
dimension with 1."}], "Notes", CellID -> 571753287, 
      ExpressionUUID -> "3c049fea-575c-429b-8d4f-160b660e81e2"],

Cell[TextData[{"Unlike ", Cell[BoxData[ButtonBox["EinsteinSummation", 
           BaseStyle -> "Link", ButtonData -> 
            "paclet:Wolfram/TensorNetworks/ref/EinsteinSummation"]], 
         "InlineFormula", ExpressionUUID -> 
          "5b0d4f89-f790-4bd4-acdc-94185a9e469e"], ", ", 
        Cell[BoxData[ButtonBox["IndexedMultiply", BaseStyle -> "Link", 
           ButtonData -> 
            "paclet:Wolfram/TensorNetworks/ref/IndexedMultiply"]], 
         "InlineFormula", ExpressionUUID -> 
          "788ea413-b9e2-4e79-b23b-8ec1de5c87a9"], " does not contract \
repeated indices; it only broadcasts and multiplies. Repeated indices within \
a single tensor are preserved as separate axes in the output."}], "Notes", 
      CellID -> 40550656, ExpressionUUID -> 
       "c1f42c3a-fbd1-4bbe-9272-c093866f3b2e"],

Cell[TextData[{"When called with disjoint indices across tensors, ", 
        Cell[BoxData[ButtonBox["IndexedMultiply", BaseStyle -> "Link", 
           ButtonData -> 
            "paclet:Wolfram/TensorNetworks/ref/IndexedMultiply"]], 
         "InlineFormula", ExpressionUUID -> 
          "9df6b2a6-576b-4c48-9191-2325896c20ce"], " reduces to ", 
        Cell[BoxData[ButtonBox["TensorProduct", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/TensorProduct"]], "InlineFormula", 
         ExpressionUUID -> "963b0f19-e325-4d72-9902-5b7d350e62d3"], "."}], 
      "Notes", CellID -> 924238015, ExpressionUUID -> 
       "6fb67627-085e-431d-a4ae-e61783bb0ec3"],

Cell[TextData[{"Symbolic tensors (", 
        Cell[BoxData[ButtonBox["ArraySymbol", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/ArraySymbol"]], "InlineFormula", 
         ExpressionUUID -> "32605349-f9d9-4b19-b25d-e63954a9b367"], 
        " inputs and any expressions for which ", 
        Cell[BoxData[ButtonBox["TensorQ", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/TensorQ"]], "InlineFormula", 
         ExpressionUUID -> "be7f050a-4d0d-4401-a45d-b6caa0a55742"], 
        " returns ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/False"]], "InlineFormula", 
         ExpressionUUID -> "28474f4d-b956-4cb5-b9f2-980e478b9303"], 
        ") are handled by wrapping the transposed tensor in an ", 
        Cell[BoxData[ButtonBox["ArraySymbol", BaseStyle -> "Link"]], 
         "InlineFormula", ExpressionUUID -> 
          "f905a546-abc5-4126-8407-51d944db014c"], 
        " of the broadcast shape; the final product is then a symbolic ", 
        Cell[BoxData[ButtonBox["Times", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Times"]], "InlineFormula", 
         ExpressionUUID -> "80a2dc80-3939-486b-af79-818033e2309a"], 
        " of these arrays."}], "Notes", CellID -> 320579364, 
      ExpressionUUID -> "0a832e9c-4a2d-436b-b241-acf3cdb2aa80"],

Cell[TextData[{"If the length of any per-tensor index list does not \
equal the rank of the corresponding tensor, ", 
        Cell[BoxData[ButtonBox["IndexedMultiply", BaseStyle -> "Link", 
           ButtonData -> 
            "paclet:Wolfram/TensorNetworks/ref/IndexedMultiply"]], 
         "InlineFormula", ExpressionUUID -> 
          "e95ca90a-1238-410c-9526-e0354834c022"], " returns a ", 
        Cell[BoxData[ButtonBox["Failure", BaseStyle -> "Link", 
           ButtonData -> "paclet:ref/Failure"]], "InlineFormula", 
         ExpressionUUID -> "54a4dcdf-488c-43fc-9c24-8a79e93c8c48"], 
        " object."}], "Notes", CellID -> 172581409, 
      ExpressionUUID -> "392782a0-3dab-450a-9fe6-44d679631209"]
}, Open  ]],

