   RowBox[{
    SubscriptBox[
     StyleBox["C", "TI"], 
     RowBox[{"i", ",", "j", ",", "k"}]], "=", 
    RowBox[{
     SubscriptBox[
      StyleBox["T", "TI"], 
      RowBox[{"i", ",", "j", ",", "k"}]], 
     SubscriptBox[
      StyleBox["B", "TI"], 
