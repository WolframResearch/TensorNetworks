Cell["\<\
EinsteinSummation with no contracted indices and a free index appearing in \
two tensors equals IndexedMultiply, modulo ActivateTensors:\
\>", "ExampleText",
 CellID->829035141,ExpressionUUID->"4185691e-668e-496e-9660-70ee74396e6e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Amat", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{"\[FormalCapitalA]", ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "3"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"Bmat", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{"\[FormalCapitalB]", ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ActivateTensors", "[", 
   RowBox[{"EinsteinSummation", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\""}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\""}], "}"}]}], "}"}], " ", "->",
       " ", 
      RowBox[{"{", 
       RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\""}], "}"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"Amat", ",", " ", "Bmat"}], "}"}]}], "]"}], "]"}], " ", "===", 
  " ", 
  RowBox[{"Last", " ", "@", " ", 
   RowBox[{"IndexedMultiply", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\""}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\""}], "}"}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"Amat", ",", " ", "Bmat"}], "}"}]}], "]"}]}]}]}], "Input",
