Cell[TextData[{
 "Vectors sharing one index multiply elementwise ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       StyleBox["u", "TI"], "\[SmallCircle]", 
       StyleBox["v", "TI"]}], ")"}], "i"], "=", 
    RowBox[{
     SubscriptBox[
