Notebook[{

Cell[CellGroupData[{
Cell["YoungTableauQ", "ObjectName",
 CellID->223337487,ExpressionUUID->"ab981836-478b-4492-ba25-320d8fcfa091"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1aeecc8c-355b-4ec1-a99d-bc8868a48ea6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["YoungTableauQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableauQ"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "dad23e16-1dd2-4c9c-a462-99ab995cf181"],
 "\[LineSeparator]yields ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "63f33efc-b09f-441c-b7fe-5ca712c84598"],
 " if ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "82b89679-e684-4fa8-99a5-e1613442e5d9"],
 " is a valid ",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"583a190e-837c-48a0-ac42-36474c10069d"],
 " and ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "fc9ff07b-7fd5-4a65-9fed-ad84ef0d8970"],
 " otherwise."
}], "Usage",
 CellID->984669801,ExpressionUUID->"1fe04361-6486-4a0a-a7ba-10075ebf6db7"],

Cell[TextData[{
 "Validity requires that ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "c93e382c-44e3-4cb8-b2b2-9691e34dc48d"],
 " has head ",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"1a196687-8255-433f-b56c-ad8192e5bc5a"],
 ", that its single argument is a list of nonempty lists of distinct positive \
integers, and that the row lengths are non-increasing."
}], "Notes",
 CellID->685904443,ExpressionUUID->"a2adafb9-86d7-4d80-9da9-2d24de4bdcab"],

Cell[TextData[{
 "The result is cached on the expression through the ",
 Cell[BoxData[
 "System`Private`HoldValidQ"], "InlineFormula",ExpressionUUID->
  "e501440d-826e-4451-b01a-1d9f360b7e79"],
 " pattern, so revalidation of the same object is essentially free."
}], "Notes",
 CellID->309493800,ExpressionUUID->"d838d923-8bd5-44e2-9351-376095494762"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["YoungTableauQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableauQ"]], 
  "InlineFormula",ExpressionUUID->"e341484a-8373-4a52-92c2-9eea8c0bbfd2"],
 " returns ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "25d7babe-4a55-4c63-a7db-1fb58ab1e786"],
 " on anything that does not have head ",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"292b311a-1d65-449a-b869-0faedba5c468"],
 " \[LongDash] in particular on bare lists of rows and on integer \
partitions."
}], "Notes",
 CellID->571753287,ExpressionUUID->"f02fe2b5-fdc9-4480-b12e-36630db20603"],

Cell[TextData[{
 "Structural validation accepts any distinct positive integers as entries; it \
does not require the entries to be ",
 Cell[BoxData[
  RowBox[{"1", ",", "\[Ellipsis]", ",", 
   StyleBox["n", "TI"]}]], "InlineFormula",ExpressionUUID->
  "3b0c1d9d-4308-4146-a487-c3534e1d304f"],
 ". Downstream consumers such as ",
 Cell[BoxData[
  ButtonBox["YoungSymmetrize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"]], 
  "InlineFormula",ExpressionUUID->"0226797b-8950-44e4-823f-48e4d1cf90c7"],
 " and ",
 Cell[BoxData[
  ButtonBox["YoungProject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"]], 
  "InlineFormula",ExpressionUUID->"001074f7-0519-4600-9487-f715a91a6c47"],
 " interpret entries as slot indices into the input tensor and therefore \
assume the standard ",
 Cell[BoxData[
  RowBox[{"1", ",", "\[Ellipsis]", ",", 
   StyleBox["n", "TI"]}]], "InlineFormula",ExpressionUUID->
  "81f750c5-9e06-4455-a38d-b90090f2fa2c"],
 " convention."
}], "Notes",
 CellID->40550656,ExpressionUUID->"c298e54f-bb29-4da7-8914-c5f1f4cf64fe"],

Cell[TextData[{
 "This symbol lives in the subpackage context ",
 Cell[BoxData["\"\<Wolfram`TensorNetworks`Symmetry`\>\""], "InlineFormula",
  ExpressionUUID->"ad66f3f8-0c9e-4169-bd5e-f5d28f3cb307"],
 ". Loading the main context with ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Needs",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Needs"], "[", "\"\<Wolfram`TensorNetworks`\>\"", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "64e2e0a6-a394-445f-b09c-9d855cb9ed88"],
 " also loads the symmetry subpackage."
}], "Notes",
 CellID->924238015,ExpressionUUID->"8240b33c-0aff-4756-9e62-9f67d6e94b88"]
}, Open  ]],

