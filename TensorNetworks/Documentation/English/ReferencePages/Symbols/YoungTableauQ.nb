     RowBox[{"{", 
      RowBox[{"40", ",", " ", "50"}], "}"}]}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->923125737,ExpressionUUID->"3372c903-8cdc-42f6-814f-ec5d0db13f83"],

Cell[BoxData["True"], "Output",
