 CellID->966360847,ExpressionUUID->"3d7bf47b-9c75-4394-a5d7-2c40114da422"],

Cell["\<\
The validator only checks distinctness, positivity, and the partition shape; \
entries outside 1..n are accepted:\
\>", "ExampleText",
 CellID->385089207,ExpressionUUID->"2faa248d-47f5-42b7-94d3-e13eb7e48c9f"],

Cell[BoxData[
 RowBox[{"YoungTableauQ", "[", 
