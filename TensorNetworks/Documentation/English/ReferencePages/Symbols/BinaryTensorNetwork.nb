Cell["\<\
Every hyperedge contributes one new spider tensor, so the binarized network \
is larger than the input. Track the size before and after:\
\>", "ExampleText",
 CellID->500000002,ExpressionUUID->"ee500001-0001-0001-0001-000000000001"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tn", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2", ",", " ", "2", ",", " ", "2"}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i1", ",", " ", "i2", ",", " ", "i3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i2", ",", " ", "i4", ",", " ", "i5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i2", ",", " ", "i3", ",", " ", "i6"}], "}"}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bin", " ", "=", " ", 
   RowBox[{"BinaryTensorNetwork", "[", "tn", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.988285400710659*^9, 3.988285403403892*^9}, {
