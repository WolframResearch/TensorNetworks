        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2", ",", " ", "2", ",", " ", "2"}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i1", ",", " ", "i2", ",", " ", "i3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i2", ",", " ", "i4", ",", " ", "i5"}], "}"}], ",", " ", 
