Cell["\<\
BinaryTensorNetworkQ tests the condition that BinaryTensorNetwork establishes \
\[Dash] every index appears in at most two tensors:\
\>", "ExampleText",
 CellID->400000001,ExpressionUUID->"ee400001-0001-0001-0001-000000000001"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tn", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2", ",", " ", "2", ",", " ", "2"}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i1", ",", " ", "i2", ",", " ", "i3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i2", ",", " ", "i4", ",", " ", "i5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i2", ",", " ", "i3", ",", " ", "i6"}], "}"}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bin", " ", "=", " ", 
   RowBox[{"BinaryTensorNetwork", "[", "tn", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9882853829206553`*^9, 3.988285386599712*^9}, {
  3.988287226822363*^9, 3.988287242167329*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"2a2cb479-c2c1-4229-a4b2-8b4b83797401"],

