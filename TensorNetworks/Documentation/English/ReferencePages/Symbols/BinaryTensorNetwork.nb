Cell["\<\
Build a three-tensor network in which the index i2 is shared by all three \
tensors, so the network is not binary:\
\>", "ExampleText",
 CellID->100100001,ExpressionUUID->"ee100001-0001-0001-0001-000000000001"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tensors", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "#1"}], 
        "]"}], " ", "&"}], " ", ")"}], " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "}"}]}]}], 
   ";"}], " "}]], "Input",
 CellLabel->
  "In[101]:=",ExpressionUUID->"67e3e468-d797-41a6-8815-c4a355d75c1e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tn", " ", "=", " ", 
    RowBox[{"TensorNetwork", "[", 
     RowBox[{"tensors", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i1", ",", " ", "i2", ",", " ", "i3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i2", ",", " ", "i4", ",", " ", "i5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i2", ",", " ", "i3", ",", " ", "i6"}], "}"}]}], "}"}]}], 
     "]"}]}], ";"}], " "}]], "Input",
 CellLabel->
  "In[102]:=",ExpressionUUID->"44a221c0-9408-4351-a1a0-720b7387f146"],

