     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"RandomTensorNetwork", "[", 
        RowBox[{"\"\<MPS\>\"", "[", 
         RowBox[{"4", ",", " ", "2", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{
    RowBox[{"BinaryTensorNetwork", "[", "net", "]"}], " ", "===", " ", 
