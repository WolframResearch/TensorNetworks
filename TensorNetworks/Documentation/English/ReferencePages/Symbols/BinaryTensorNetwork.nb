Cell["\<\
Contracting the binary network gives the same tensor as contracting the \
original. Convert the inserted spiders to numerical arrays first with Normal:\
\
\>", "ExampleText",
 CellID->400000010,ExpressionUUID->"ee400002-0001-0001-0001-000000000001"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"binNumeric", " ", "=", " ", 
     RowBox[{"TensorNetwork", "[", 
      RowBox[{
       RowBox[{"Normal", " ", "/@", " ", 
        RowBox[{"bin", "[", "\"\<Tensors\>\"", "]"}]}], ",", " ", 
       RowBox[{"bin", "[", "\"\<Hyperedges\>\"", "]"}], ",", " ", 
       RowBox[{"bin", "[", "\"\<Output\>\"", "]"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"TensorNetworkContract", "[", "binNumeric", "]"}], " ", "-", 
       " ", 
       RowBox[{"TensorNetworkContract", "[", "tn", "]"}]}], "]"}], "]"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"c8cbe2b4-b1fb-4e2f-afa4-608a8bb426fc"],

Cell[BoxData["0.`"], "Output",
 CellChangeTimes->{3.988237899992914*^9, 3.988285392915566*^9, 
  3.9882872473300867`*^9, 3.988305221814803*^9},
 CellLabel->"Out[5]=",
 CellID->1606882242,ExpressionUUID->"544e624c-c5a7-455d-9a6b-e2219c9f2cea"]
}, Open  ]],

