Cell["\<\
BinaryTensorNetworkQ tests the condition that BinaryTensorNetwork establishes \
\[Dash] every index appears in at most two tensors:\
\>", "ExampleText",
 CellID->400000001,ExpressionUUID->"ee400001-0001-0001-0001-000000000001"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tn", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"RandomReal", "[", 
