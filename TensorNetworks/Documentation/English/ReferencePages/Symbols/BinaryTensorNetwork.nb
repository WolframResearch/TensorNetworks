       RowBox[{"{", 
        RowBox[{"i1", ",", " ", "i2", ",", " ", "i3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i2", ",", " ", "i4", ",", " ", "i5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i2", ",", " ", "i3", ",", " ", "i6"}], "}"}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bin", " ", "=", " ", 
   RowBox[{"BinaryTensorNetwork", "[", "tn", "]"}]}], ";"}]}], "Input",
