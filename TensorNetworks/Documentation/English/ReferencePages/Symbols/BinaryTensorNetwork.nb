Cell["\<\
Build a three-tensor network in which the index i2 is shared by all three \
tensors, so the network is not binary:\
\>", "ExampleText",
 CellID->100100001,ExpressionUUID->"ee100001-0001-0001-0001-000000000001"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tensors", " ", "=", " ", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", "2", ",", " ", "2", ",", " ", "2"}], "}"}]}], 
     "]"}]}], ";"}], " "}]], "Input",
 CellChangeTimes->{{3.9882376245594893`*^9, 3.988237651721005*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"67e3e468-d797-41a6-8815-c4a355d75c1e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", " ", "=", " ", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{"tensors", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i1", ",", " ", "i2", ",", " ", "i3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i2", ",", " ", "i4", ",", " ", "i5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i2", ",", " ", "i3", ",", " ", "i6"}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9882377007005587`*^9, 3.988237701106637*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"44a221c0-9408-4351-a1a0-720b7387f146"],

