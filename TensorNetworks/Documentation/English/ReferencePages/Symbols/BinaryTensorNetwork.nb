Cell["\<\
Contracting the binary network gives the same tensor as contracting the \
original. Convert the inserted spiders to numerical arrays first with Normal:\
\
\>", "ExampleText",
 CellID->400000010,ExpressionUUID->"ee400002-0001-0001-0001-000000000001"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"binNumeric", " ", "=", " ", 
     RowBox[{"TensorNetwork", "[", 
      RowBox[{
       RowBox[{"Normal", " ", "/@", " ", 
        RowBox[{"bin", "[", "\"\<Tensors\>\"", "]"}]}], ",", " ", 
       RowBox[{"bin", "[", "\"\<Hyperedges\>\"", "]"}], ",", " ", 
       RowBox[{"bin", "[", "\"\<Output\>\"", "]"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"TensorNetworkContract", "[", "binNumeric", "]"}], " ", "-", 
       " ", 
       RowBox[{"TensorNetworkContract", "[", "tn", "]"}]}], "]"}], "]"}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[403]:=",ExpressionUUID->"c8cbe2b4-b1fb-4e2f-afa4-608a8bb426fc"],

Cell[BoxData["0.`"], "Output",
 CellLabel->
  "Out[403]=",ExpressionUUID->"42eb10b5-e8db-4d2a-b79a-89a6dbc480c3"]
}, Open  ]]
}, Open  ]],

