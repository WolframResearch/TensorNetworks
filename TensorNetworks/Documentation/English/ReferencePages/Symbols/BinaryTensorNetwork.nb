\>", "ExampleText",
 CellChangeTimes->{{3.978654883297071*^9, 3.9786549057188377`*^9}},
 CellID->164740080,ExpressionUUID->"02cef0fc-4647-4e38-93fa-28fc06668148"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{"tensors", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i1", ",", "i2", ",", "i3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i2", ",", "i4", ",", "i5"}], "}"}], ",", 
       RowBox[{"{", 
