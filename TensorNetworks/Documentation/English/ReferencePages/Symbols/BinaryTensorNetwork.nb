Cell["\<\
When an index is shared by four tensors, BinaryTensorNetwork inserts a single \
rank-4 spider:\
\>", "ExampleText",
 CellID->200000002,ExpressionUUID->"ee200001-0001-0001-0001-000000000001"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"tensors4", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "#1"}], 
        "]"}], " ", "&"}], " ", ")"}], " ", "/@", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}]}], ";"}], 
  " "}]], "Input",
 CellLabel->
  "In[201]:=",ExpressionUUID->"ede2b814-d45a-4c9b-8184-c31c3240086a"],

