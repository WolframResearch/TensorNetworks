Cell[CellGroupData[{
Cell["BinaryTensorNetwork", "ObjectName",
 CellID->1683320656,ExpressionUUID->"21c698a0-0d71-4379-90ab-c05dcdd647f4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"45341799-9d07-4e5a-8385-22a883fbd986"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["BinaryTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetwork"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1060427f-9f95-4a47-b3b1-45449ca0b997"],
 "\[LineSeparator]",
 "returns a binary (pairwise) tensor network equivalent to ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "27a5b5f8-aa11-4d3d-9b4f-7fee04122701"],
 ", inserting a ",
 Cell[BoxData[
  ButtonBox["SymbolicDeltaProductArray",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "a2e2282e-dbf0-4d94-bf20-7c9661b42011"],
 " spider for every index that appears in three or more tensors."
}], "Usage",
 CellID->620699814,ExpressionUUID->"f72f14e4-7d6c-4b9a-b44a-7c5f645003d5"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  ButtonBox["BinaryTensorNetworkQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetworkQ"]], 
  "InlineFormula",ExpressionUUID->"b1a01001-0001-0001-0001-000000000001"],
 "[",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "b1a01001-0001-0001-0001-000000000002"],
 "] is ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "b1a01001-0001-0001-0001-000000000003"],
 ", the input network is already binary and ",
 Cell[BoxData[
  ButtonBox["BinaryTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"b1a01001-0001-0001-0001-000000000004"],
 " returns it unchanged."
}], "Notes",
 CellID->100000101,ExpressionUUID->"b1a01001-aaaa-aaaa-aaaa-000000000001"],

Cell[TextData[{
 "Each hyperedge \[Dash] an index ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "b1a01002-0001-0001-0001-000000000001"],
 " shared by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "\[GreaterEqual]", "3"}]], "InlineFormula",
  ExpressionUUID->"b1a01002-0001-0001-0001-000000000002"],
 " tensors \[Dash] is replaced by a fresh rank-",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "b1a01002-0001-0001-0001-000000000003"],
 " ",
 Cell[BoxData[
  ButtonBox["SymbolicDeltaProductArray",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "b1a01002-0001-0001-0001-000000000004"],
 " (a copy tensor) that joins the original ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "b1a01002-0001-0001-0001-000000000005"],
 " tensors through new bond indices, leaving every index in the result shared \
by at most two tensors."
}], "Notes",
 CellID->100000102,ExpressionUUID->"b1a01002-aaaa-aaaa-aaaa-000000000002"],

Cell[TextData[{
 "The third slot of ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"b1a01003-0001-0001-0001-000000000001"],
 " \[Dash] the output index list ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "b1a01003-0001-0001-0001-000000000002"],
 "[",
 Cell[BoxData["\"\<Output\>\""], "InlineFormula",ExpressionUUID->
  "b1a01003-0001-0001-0001-000000000003"],
 "] \[Dash] is forwarded unchanged to the binary network."
}], "Notes",
 CellID->100000103,ExpressionUUID->"b1a01003-aaaa-aaaa-aaaa-000000000003"],

Cell[TextData[{
 "Path-finders ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"b1a01004-0001-0001-0001-000000000001"],
 " and ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"b1a01004-0001-0001-0001-000000000002"],
 " require a binary network. ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"b1a01004-0001-0001-0001-000000000003"],
 " applies ",
 Cell[BoxData[
  ButtonBox["BinaryTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"b1a01004-0001-0001-0001-000000000004"],
 " internally on hyperedge inputs; call it directly when feeding a network to \
a path-finder."
}], "Notes",
 CellID->100000104,ExpressionUUID->"b1a01004-aaaa-aaaa-aaaa-000000000004"],

Cell[TextData[{
 "The binarized network contracts to the same tensor as the original, since \
each inserted ",
 Cell[BoxData[
  ButtonBox["SymbolicDeltaProductArray",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "b1a01005-0001-0001-0001-000000000001"],
 " spider equals a multidimensional ",
 Cell[BoxData[
  ButtonBox["KroneckerDelta",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "b1a01005-0001-0001-0001-000000000002"],
 "."
}], "Notes",
 CellID->100000105,ExpressionUUID->"b1a01005-aaaa-aaaa-aaaa-000000000005"]
}, Open  ]],

