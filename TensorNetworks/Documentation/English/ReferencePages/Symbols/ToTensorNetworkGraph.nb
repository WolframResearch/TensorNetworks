Notebook[{

Cell[CellGroupData[{
Cell["ToTensorNetworkGraph", "ObjectName",
 CellID->470090142,ExpressionUUID->"8f7ef70c-c1b9-b1be-cf38-cee038a35df1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c3b8c77b-188d-b950-1e0b-e554457fa0f8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToTensorNetworkGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"],
   "[", StyleBox["tn", "TI"], "]"
  }]], "InlineFormula",ExpressionUUID->"f7a362e2-c370-87ef-3ff9-f82266c06352"],
 "\[LineSeparator]converts the tensor network ",
 Cell[BoxData[StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->"cdff0267-9e00-0576-275e-776f5ff0f4ce"],
 " into an annotated, directed-acyclic ",
 Cell[BoxData[
  ButtonBox["Graph",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Graph"]],
  "InlineFormula",ExpressionUUID->"3ec8e159-f39b-2774-908c-f083d4964d45"],
 ". \[Bullet]\n",
 Cell["   ", "ModInfo",ExpressionUUID->"166f945d-9d98-c39e-edd2-5b9b1734a387"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToTensorNetworkGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"],
   "[", StyleBox["g", "TI"], "]"
  }]], "InlineFormula",ExpressionUUID->"6e811c8e-735d-a0a1-23fe-b822862d0bf4"],
 "\[LineSeparator]builds a tensor-network graph from the graph ",
 Cell[BoxData[StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->"9d07436c-d821-4715-557e-d0c87aa3fbe5"],
 ", first making it directed and acyclic if necessary. \[Bullet]\n",
 Cell["   ", "ModInfo",ExpressionUUID->"10fee417-c1da-a556-c87f-72989e0e0828"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToTensorNetworkGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"],
   "[", StyleBox["tensors", "TI"], ",", StyleBox["hyperedges", "TI"], "]"
  }]], "InlineFormula",ExpressionUUID->"b8739b98-3094-7d36-a6c7-322dfd411668"],
 "\[LineSeparator]constructs a tensor-network graph directly from a list of ",
 Cell[BoxData[StyleBox["tensors", "TI"]], "InlineFormula",ExpressionUUID->"fc4ee65b-a3b0-303f-4bd7-0d848617bb3f"],
 " and an associated list of ",
 Cell[BoxData[StyleBox["hyperedges", "TI"]], "InlineFormula",ExpressionUUID->"f6342e19-9a88-a749-a0fa-01cd8cc7cc05"],
 " (per-tensor index lists), inserting spider tensors for any index shared by three or more tensors."
}], "Usage",
 CellID->1379006352,ExpressionUUID->"55a05c98-48fd-da42-13b4-c97c84c5505b"],

Cell[TextData[{
 "The result is a ",
 Cell[BoxData[
  ButtonBox["Graph",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Graph"]],
  "InlineFormula",ExpressionUUID->"6088ec59-430a-1f45-1a13-2b9b944db796"],
 " in which every vertex carries a ",
 Cell[BoxData["\"\<Tensor\>\""], "InlineFormula",ExpressionUUID->"67a51aa1-ed91-e965-f257-1ea067280983"],
 " annotation (the underlying tensor) and an ",
 Cell[BoxData["\"\<Index\>\""], "InlineFormula",ExpressionUUID->"bbae333c-2a27-1603-25e7-b9e5e9bc6063"],
 " annotation (a list of ",
 Cell[BoxData[ButtonBox["Superscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->"3dd7d9fa-99c9-fa1c-3912-fbea998d1ac4"],
 "/",
 Cell[BoxData[ButtonBox["Subscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Subscript"]], "InlineFormula",ExpressionUUID->"e06a08f0-fa11-d529-3522-30036d291a1a"],
 " labels marking each output and input slot)."
}], "Notes",
 CellID->308206753,ExpressionUUID->"c747fc10-da58-e1d2-09ba-088db85ea6b7"],

Cell[TextData[{
 "Edge tags are pairs ",
 Cell[BoxData[RowBox[{"{", StyleBox["srcIndex", "TI"], ",", StyleBox["tgtIndex", "TI"], "}"}]], "InlineFormula",ExpressionUUID->"0ce58e8f-8e39-b066-e59e-ed8ab5bde1e1"],
 " that identify the two contracted slots on the connected tensors; the source slot is a ",
 Cell[BoxData[ButtonBox["Superscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->"c0781ebc-134e-b77a-fb18-b6a6e768b3ad"],
 " and the target slot is a ",
 Cell[BoxData[ButtonBox["Subscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Subscript"]], "InlineFormula",ExpressionUUID->"b911884e-bcd3-5bf2-c462-aa18be29ccbd"],
 "."
}], "Notes",
 CellID->492103041,ExpressionUUID->"e71cd138-d6e7-0303-ab84-b8139fb7043c"],

Cell[TextData[{
 "Hyperedges (an index shared by three or more tensors) are converted to binary edges by inserting one spider tensor (a ",
 Cell[BoxData[ButtonBox["SymbolicDeltaProductArray",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/SymbolicDeltaProductArray"]], "InlineFormula",ExpressionUUID->"e9913ad8-e71b-27cd-a20b-ea06890f4b17"],
 ") per hyperedge with a fresh vertex ID. The result is therefore always a binary graph."
}], "Notes",
 CellID->863715318,ExpressionUUID->"e5ace4eb-fe0d-00c1-86e1-40f0b7fc8d6d"],

Cell[TextData[{
 "The returned graph is always acyclic. Cycles in an input graph are broken by ",
 Cell[BoxData[ButtonBox["TensorNetworkRemoveCycles",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkRemoveCycles"]], "InlineFormula",ExpressionUUID->"82065ff2-debf-0667-6a35-e95c48b130a2"],
 ", which inserts a cup/cap pair for every cycle and adds the corresponding identity-matrix tensors."
}], "Notes",
 CellID->282891103,ExpressionUUID->"7fa58d9a-093c-b72b-af92-4606588ed8fc"],

Cell[TextData[{
 "Vertices are numbered ",
 Cell[BoxData[StyleBox["1", "TI"]], "InlineFormula",ExpressionUUID->"9b5a8044-9cdf-b77c-0371-ac53e2f233f3"],
 ", ",
 Cell[BoxData[StyleBox["2", "TI"]], "InlineFormula",ExpressionUUID->"9e864507-fe55-58db-dc8c-524c2719c1cc"],
 ", \[Ellipsis], ",
 Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->"272d2095-6eab-394e-5eb4-2f0adb43dadb"],
 " for the original tensors, then ",
 Cell[BoxData[RowBox[{StyleBox["n", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->"4eac9956-84f2-9d4f-a125-cc5952573313"],
 ", ",
 Cell[BoxData[RowBox[{StyleBox["n", "TI"], "+", "2"}]], "InlineFormula",ExpressionUUID->"408575f3-3ce9-8d91-d9ce-1adee58148e0"],
 ", \[Ellipsis] for any inserted spider, cup, or cap vertices."
}], "Notes",
 CellID->1448413003,ExpressionUUID->"a63a6dfb-bdfb-6723-f2a8-a05a5fcabfe0"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<Method\>\""], "InlineFormula",ExpressionUUID->"e7e6c690-ef6f-e3a9-2700-97201d958d74"],
 " option fills in tensors only for vertices that lack a ",
 Cell[BoxData["\"\<Tensor\>\""], "InlineFormula",ExpressionUUID->"9ff2db63-7c1e-a91e-091b-60f7f16865df"],
 " annotation in the input; pre-annotated vertices keep their original tensor values."
}], "Notes",
 CellID->1130032174,ExpressionUUID->"d93181cc-8f8a-ecc8-6366-6af9e1d178e8"]
}, Open  ]],

