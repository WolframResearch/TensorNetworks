Cell[CellGroupData[{
Cell["ToTensorNetworkGraph", "ObjectName",
 CellID->1605412695,ExpressionUUID->"3d02db17-7446-4e62-b426-4faec2052952"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cac1e1b9-7f64-490f-8feb-3d96649104e7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToTensorNetworkGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/ToTensorNetworkGraph"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3b2fa1a3-ee29-4bf3-bfdb-6281155e80f6"],
 "\[LineSeparator]constructs a tensor network ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "037e87dc-877d-4f25-a76d-9d5dbf75b650"],
 " from a directed acyclic ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "7585352d-f85d-417c-80e3-25e666cfe16f"],
 ". \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"fc2931e8-cce3-430b-a3c4-bbe83a96f325"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToTensorNetworkGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/ToTensorNetworkGraph"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "cd0d743b-858a-485a-91e3-bb28d15c8776"],
 "\[LineSeparator]converts a ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"2f130a47-b60c-4f66-8733-83a1381f6b0a"],
 " object to a graph representation. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"458c313a-8b0e-446a-a974-0c92204d9064"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToTensorNetworkGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/ToTensorNetworkGraph"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], "\[Rule]", "\"\<Symbolic\>\""}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"79a80876-7052-4d2c-bae5-d662d48a8866"],
 "\[LineSeparator]uses symbolic tensor representations."
}], "Usage",
