Cell["From a tensor network. Convert a binary network directly:", "ExampleText",
 CellID->683927884,ExpressionUUID->"b2a8d860-e2bf-76d9-9556-45de25f7730f"],

Cell[BoxData[
  RowBox[{
   RowBox[{"tn", "=", 
    RowBox[{"TensorNetwork", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1377936669,ExpressionUUID->"e1280156-cdff-cfd3-6a17-12d337957050"],

Cell[BoxData[
  RowBox[{"ToTensorNetworkGraph", "[", "tn", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1235303640,ExpressionUUID->"6da19567-c457-5986-85ab-006bb8b1f670"],

Cell["Hyperedges in the network are converted to spider vertices:", "ExampleText",
 CellID->1772936651,ExpressionUUID->"8846b3c6-59cb-0b79-32a9-a969f4e4e54a"],

Cell[BoxData[
  RowBox[{"tnH", "=", 
    RowBox[{"TensorNetwork", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
