Cell["Convert a small tensor network to a graph:", "ExampleText",
 CellID->1054150517,ExpressionUUID->"0529fc02-e64d-0f91-0bb3-c6256245a2b3"],

Cell[BoxData[
  RowBox[{
   RowBox[{"tn", "=", 
    RowBox[{"TensorNetwork", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->764760314,ExpressionUUID->"66a1c01a-aee9-f9c5-ce6e-fe7dcf21ecec"],

Cell[BoxData[
  RowBox[{"ToTensorNetworkGraph", "[", "tn", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->110470096,ExpressionUUID->"815e9875-0a40-0c84-f522-068e61923721"],

Cell["Create a tensor network with one index shared by three tensors:", "ExampleText",
 CellID->1009173119,ExpressionUUID->"1eb45c24-527d-7658-f872-22e76034f3f1"],

Cell[BoxData[
  RowBox[{
   RowBox[{"tnH", "=", 
    RowBox[{"TensorNetwork", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "c"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "d"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->1904302142,ExpressionUUID->"9fb80d0f-89e6-db84-cfc2-d3817f59613a"],

Cell["Convert it to a graph; a spider vertex is inserted for the hyperedge:", "ExampleText",
 CellID->1197864515,ExpressionUUID->"8017bc94-0e90-4826-e545-7a36a031fb44"],

Cell[BoxData[
  RowBox[{"g", "=", RowBox[{"ToTensorNetworkGraph", "[", "tnH", "]"}]}]], "Input",
 CellLabel->"In[4]:=",
 CellID->193741953,ExpressionUUID->"6212e308-23bf-e7c9-fb5c-9776bb17f752"],

Cell["The spider vertex carries a SymbolicDeltaProductArray:", "ExampleText",
 CellID->990205965,ExpressionUUID->"8215fd1b-2e60-89a3-b97a-58df5dc816f7"],

Cell[BoxData[
  RowBox[{"AnnotationValue", "[", RowBox[{RowBox[{"{", RowBox[{"g", ",", "4"}], "}"}], ",", "\"\<Tensor\>\""}], "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->622757621,ExpressionUUID->"8471797c-29a1-d323-1b72-5a61c0d7170f"],

Cell["Build a tensor-network graph from a directed graph, filling in random tensors:", "ExampleText",
 CellID->693695292,ExpressionUUID->"ef813348-36d9-af64-5893-305d2d4fa07b"],

Cell[BoxData[
  RowBox[{"ToTensorNetworkGraph", "[", RowBox[{RowBox[{"Graph", "[", RowBox[{"{", RowBox[{RowBox[{"1", "\[Rule]", "2"}], ",", RowBox[{"2", "\[Rule]", "3"}], ",", RowBox[{"3", "\[Rule]", "4"}]}], "}"}], "]"}], ",", RowBox[{"Method", "\[Rule]", "\"\<Random\>\""}]}], "]"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->719088546,ExpressionUUID->"42d47937-0b32-3316-0f6c-11e212cc970e"],

