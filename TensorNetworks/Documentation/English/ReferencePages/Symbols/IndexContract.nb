Cell["IndexContract", "ObjectName",ExpressionUUID->"b5e747ff-2d8e-4b5f-b34a-d4b9c96e9c1f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"133d0133-47eb-4200-9798-4b4f10e28d60"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IndexContract",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/IndexContract"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["a", "TI"], "1"], ",", 
     SubscriptBox[
      StyleBox["a", "TI"], "2"], ",", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"4434ee83-09e6-4b10-8110-45b4d30a31ba"],
 "\[LineSeparator]contracts every matching pair of free index names across \
the IndexArray or IndexTensor objects a\:1d62, returning a new IndexArray or \
IndexTensor. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ef6db9e6-5557-4775-a0d7-141d56c3581e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IndexContract",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/IndexContract"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["a", "TI"], "1"], ",", "\[Ellipsis]"}], "}"}], ",", 
   StyleBox["output", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "83a382c6-a2c0-4c3e-8670-019bd4868706"],
 "\[LineSeparator]forces the listed names to be the free indices of the \
result."
}], "Usage",
