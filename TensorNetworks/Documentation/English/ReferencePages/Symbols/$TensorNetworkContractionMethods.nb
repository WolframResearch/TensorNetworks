Cell[TextData[{
 "All five engines produce numerically identical results; they differ only \
in the shape of the ",
 Cell[BoxData[
  ButtonBox["Inactive",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Inactive"]], "InlineFormula",
  ExpressionUUID->"b0000002-0000-0000-0000-000000000002"],
