Cell[TextData[{
 "The ",
 Cell[BoxData[StyleBox["\"\<TableSum\>\"", ShowStringCharacters->True]],
  "InlineFormula",ExpressionUUID->"e5000003-0000-0000-0000-000000000003"],
 " engine emits an explicit ",
 Cell[BoxData[
  ButtonBox["Table",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Table"]], "InlineFormula",
  ExpressionUUID->"e5000004-0000-0000-0000-000000000004"],
 " of ",
 Cell[BoxData[
  ButtonBox["Sum",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Sum"]], "InlineFormula",
  ExpressionUUID->"e5000005-0000-0000-0000-000000000005"],
 " of scalar ",
 Cell[BoxData[
  ButtonBox["Part",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Part"]], "InlineFormula",
  ExpressionUUID->"e5000006-0000-0000-0000-000000000006"],
 " accesses; evaluation cost is O(\[Product] dims) without BLAS \
acceleration, so this engine is slow for high-rank dense tensors. Use it for \
audit and pedagogy, not for production contractions."
}], "ExampleText",
 CellID->100500007,ExpressionUUID->"e5000008-0000-0000-0000-000000000008"]
}, Open  ]],

