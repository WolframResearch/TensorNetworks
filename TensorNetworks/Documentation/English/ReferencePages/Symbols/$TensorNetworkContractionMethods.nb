Cell[TextData[{
 "The constant value is ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\<\"ArrayDotTranspose\"\>", ",", "\<\"ArrayDot\"\>", 
    ",", "\<\"Dot\"\>", ",", "\<\"TensorContract\"\>", 
    ",", "\<\"TableSum\"\>"}], "}"}]], "InlineFormula",ExpressionUUID->
  "b0000001-0000-0000-0000-000000000001"],
 "."
}], "Notes",
 CellID->654207662,ExpressionUUID->"e968d889-3111-49ac-940c-0792d9ee852d"],

Cell[TextData[{
 "All five engines produce numerically identical results; they differ only in \
the shape of the ",
 Cell[BoxData[
  ButtonBox["Inactive",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Inactive"]], "InlineFormula",ExpressionUUID->
  "b0000002-0000-0000-0000-000000000002"],
 " expression tree returned by ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
   "InlineFormula",ExpressionUUID->"b0000003-0000-0000-0000-000000000003"],
 " and in the runtime cost of evaluation."
}], "Notes",
 CellID->654207663,ExpressionUUID->"e968d889-3111-49ac-940c-0792d9ee852d"],

Cell[TextData[{
 "The default engine is ",
 Cell[BoxData[
  StyleBox["\"\<ArrayDot\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "b0000004-0000-0000-0000-000000000004"],
 "."
}], "Notes",
 CellID->654207664,ExpressionUUID->"e968d889-3111-49ac-940c-0792d9ee852d"],

Cell["Each engine has the following form and use case:", "Notes",
 CellID->654207665,ExpressionUUID->"e968d889-3111-49ac-940c-0792d9ee852d"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c0000001-0000-0000-0000-000000000001"], Cell[BoxData[
     StyleBox["\"\<ArrayDot\>\"",
      ShowStringCharacters->True]], "TableText",ExpressionUUID->
