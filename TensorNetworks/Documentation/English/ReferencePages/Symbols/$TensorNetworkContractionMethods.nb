Cell["Build a small two-tensor network used in the examples below:", \
"ExampleText",
 CellID->100100004,ExpressionUUID->"e1000004-0000-0000-0000-000000000004"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", " ", "=", " ", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.5", ",", " ", 
          RowBox[{"-", "0.2"}], ",", " ", "0.3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.1", ",", " ", "0.8", ",", " ", 
          RowBox[{"-", "0.4"}]}], "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.6", ",", " ", "0.4", ",", " ", 
          RowBox[{"-", "0.1"}], ",", " ", "0.2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.3"}], ",", " ", "0.5", ",", " ", "0.7", ",", " ", 
          RowBox[{"-", "0.2"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.1", ",", " ", 
          RowBox[{"-", "0.4"}], ",", " ", "0.3", ",", " ", "0.5"}], "}"}]}], 
       "}"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "k"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->100100005,ExpressionUUID->"e1000005-0000-0000-0000-000000000005"],

