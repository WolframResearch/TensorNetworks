Cell[TextData[{
 "All five engines must produce numerically identical results. Any non-zero \
difference outside floating-point rounding is a bug; the diagnostic is the ",
 Cell[BoxData[
  ButtonBox["AssociationMap",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/AssociationMap"]], "InlineFormula",ExpressionUUID->
  "05c04218-daf8-4f44-bf9e-30e0be9fcb4f"],
 " sweep shown in Basic Examples."
}], "Notes",
 CellID->1367621755,ExpressionUUID->"54d77e44-06a2-442a-908b-1aee5bb0e80d"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["\"\<TableSum\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "eede70eb-3675-42d0-a148-43252af57584"],
 " engine emits an explicit ",
 Cell[BoxData[
  ButtonBox["Table",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Table"]], "InlineFormula",ExpressionUUID->
  "adb9ca50-daa9-4231-bbce-57b12dac51ac"],
 " of ",
 Cell[BoxData[
  ButtonBox["Sum",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Sum"]], "InlineFormula",ExpressionUUID->
  "2980e7a6-63a5-4ea9-8e35-fc1385c3aa8f"],
 " of scalar ",
 Cell[BoxData[
  ButtonBox["Part",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Part"]], "InlineFormula",ExpressionUUID->
  "5c7432cb-8f0b-4a10-8a3f-982858f82b0c"],
 " accesses; evaluation cost is ",
 Cell[BoxData[
  RowBox[{"O", 
   RowBox[{"(", 
    RowBox[{"\[Product]", " ", "dims"}], ")"}]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "99fc6a3b-75be-45f0-8c38-4e476c3a9bfd"],
 " without BLAS acceleration, so this engine is slow for high-rank dense \
tensors. Use it for audit and pedagogy, not for production contractions."
}], "Notes",
 CellChangeTimes->{3.988986394045114*^9},
 CellID->1101362444,ExpressionUUID->"150045d5-71fe-463a-9871-413b9e8ef2c7"]
