Cell[TextData[{
 "Truncation throws information away. The fidelity ",
 Cell[BoxData[
  FractionBox[
   RowBox[{
   "\[LeftAngleBracket]", "original", "|", "compressed", 
    "\[RightAngleBracket]"}], 
   RowBox[{
   "\[LeftDoubleBracketingBar]", "original", "\[RightDoubleBracketingBar]", "\[CenterDot]",
     "\[LeftDoubleBracketingBar]", "compressed", 
    "\[RightDoubleBracketingBar]"}]]], "InlineFormula",ExpressionUUID->
  "ae70c2ab-34f8-4a00-b9e4-d9612eb93eee"],
 " measures how much was kept:"
}], "ExampleText",
 CellID->403100098,ExpressionUUID->"b0aaf81f-58a0-41cc-a100-227b51d5aa92"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"compressed", " ", "=", " ", 
   RowBox[{"MPSTruncate", "[", 
    RowBox[{"mps", ",", " ", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mps", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "42", "]"}], ";", " ", 
     RowBox[{"RandomTensorNetwork", "[", 
      RowBox[{"\"\<MPS\>\"", "[", 
       RowBox[{"8", ",", " ", "4", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"fidelity", " ", "=", " ", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"MPSOverlap", "[", 
     RowBox[{"mps", ",", " ", "compressed"}], "]"}], "]"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"MPSNorm", "[", "mps", "]"}], "*", 
     RowBox[{"MPSNorm", "[", "compressed", "]"}]}], ")"}]}]}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->82375921,ExpressionUUID->"66484eb9-c806-4d68-8e57-d117e8f33582"],

