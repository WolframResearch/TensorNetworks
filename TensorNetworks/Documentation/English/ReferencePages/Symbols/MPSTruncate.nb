Notebook[{

Cell[CellGroupData[{
Cell["MPSTruncate", "ObjectName",
 CellID->666091537,ExpressionUUID->"324ba07f-2ec5-4f64-9fec-d2031c9b5360"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a4734244-4918-4833-813e-4b50d2e0b01a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSTruncate",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSTruncate"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", 
    StyleBox["maxBond", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f882f946-a103-476b-a1a4-3ac863a6e23b"],
 "\[LineSeparator]compresses an MPS by truncating every bond to at most ",
 Cell[BoxData[
  StyleBox["maxBond", "TI"]], "InlineFormula",ExpressionUUID->
  "a379635e-68d3-4897-b23c-10b7d19e4889"],
 " singular values. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a986e856-253d-487c-ae7d-c2c882dbab7b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSTruncate",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSTruncate"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", 
    StyleBox["maxBond", "TI"], ",", 
    RowBox[{"\"\<Normalize\>\"", "->", "False"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"d1e42a22-057a-4096-b469-d2549982e35b"],
 "\[LineSeparator]returns the compressed MPS without rescaling to unit norm."
}], "Usage",
 CellID->819643179,ExpressionUUID->"f36e43e9-fded-43cd-8745-267c391a5ce2"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["MPSTruncate",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSTruncate"]], 
  "InlineFormula",ExpressionUUID->"717fff44-a5a5-4de3-8799-826a28b4fe30"],
 " calls ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSCanonicalForm",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalForm"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", "\"\<Left\>\"", ",", 
    RowBox[{"\"\<MaxBond\>\"", "->", 
     StyleBox["maxBond", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "134df479-4f5d-4c9f-92e5-75c34df56fc0"],
 " to produce a left-canonical MPS with bonds capped at ",
 Cell[BoxData[
  StyleBox["maxBond", "TI"]], "InlineFormula",ExpressionUUID->
  "39975633-3f6d-4edd-9819-b7d2c106082f"],
 ", and then applies ",
 Cell[BoxData[
  ButtonBox["MPSNormalize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNormalize"]], 
  "InlineFormula",ExpressionUUID->"a4a7f8f6-0466-4b5d-8094-aeedec52a0f2"],
 " when ",
 Cell[BoxData[
  RowBox[{"\"\<Normalize\>\"", "->", "True"}]], "InlineFormula",
  ExpressionUUID->"092f5c34-6187-4e4d-bbac-5027cc61b34a"],
 " (the default)."
}], "Notes",
 CellID->799716906,ExpressionUUID->"8cd4457e-b291-4037-8106-973a5a50b8d1"],

Cell[TextData[{
 "The compression is variational. At each bond the SVD retains the ",
 Cell[BoxData[
  StyleBox["maxBond", "TI"]], "InlineFormula",ExpressionUUID->
  "f02e2e75-1c44-4996-b590-51b3f6e4e662"],
 " largest singular values and discards the rest; the truncation error scales \
with the squared sum of the discarded singular values."
}], "Notes",
 CellID->120777033,ExpressionUUID->"601ef8b6-b85a-434d-be2d-7e522b26ea27"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  RowBox[{"\"\<Normalize\>\"", "->", "False"}]], "InlineFormula",
  ExpressionUUID->"57e7a7e4-3c4f-406e-92aa-c22faf12f861"],
 " the returned MPS satisfies ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSCanonicalQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalQ"], "[", 
   RowBox[{
    StyleBox["result", "TI"], ",", "\"\<Left\>\""}], "]"}]], "InlineFormula",
  ExpressionUUID->"ab0c7726-5d16-4122-8c9b-b0e56540eca7"],
 " exactly. With ",
 Cell[BoxData[
  RowBox[{"\"\<Normalize\>\"", "->", "True"}]], "InlineFormula",
  ExpressionUUID->"9347dc70-df4a-4eda-b9e4-b367ff923b7d"],
 " the per-site rescale of ",
 Cell[BoxData[
  ButtonBox["MPSNormalize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNormalize"]], 
  "InlineFormula",ExpressionUUID->"b62ac683-f26a-4da0-b2f3-54be1ae4e753"],
 " breaks the strict left-isometry, but the bond structure and free indices \
are preserved."
}], "Notes",
 CellID->481468153,ExpressionUUID->"e703e6a4-a2ea-4338-8bd6-4992c6092a70"],

Cell[TextData[{
 "If every bond of ",
 Cell[BoxData[
  StyleBox["mps", "TI"]], "InlineFormula",ExpressionUUID->
  "22f8e557-5c23-4449-b314-563dd521ed8f"],
 " is already at most ",
 Cell[BoxData[
  StyleBox["maxBond", "TI"]], "InlineFormula",ExpressionUUID->
  "b8c418a0-2668-421a-afa3-92901683041f"],
 ", no singular values are discarded and ",
 Cell[BoxData[
  ButtonBox["MPSTruncate",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSTruncate"]], 
  "InlineFormula",ExpressionUUID->"829a3f27-3b58-4356-beac-c0b9c71fbdab"],
 " reduces to a left-canonicalize-and-normalize round trip."
}], "Notes",
 CellID->826388419,ExpressionUUID->"e33d55e2-0d1f-43f8-aa13-272b88f472cd"],

Cell[TextData[{
 "The underlying decomposition is the system function ",
 Cell[BoxData[
  ButtonBox["SingularValueDecomposition",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/SingularValueDecomposition"]], "InlineFormula",
  ExpressionUUID->"ed15639b-14b6-46b5-996c-4cef45f88d86"],
 ", applied bond by bond during the left-canonical sweep of ",
 Cell[BoxData[
  ButtonBox["MPSCanonicalForm",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalForm"]], 
  "InlineFormula",ExpressionUUID->"2feb7b78-e73c-4b49-b298-ae219be147ee"],
 "."
}], "Notes",
 CellID->832348281,ExpressionUUID->"fdc94676-439c-46e8-9497-320103c77bd6"],

Cell["The following option can be given:", "Notes",
 CellID->414452195,ExpressionUUID->"d4ef3afe-eea7-4b5f-8eb4-783fd3bc12f4"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b9db7cbb-795d-47f0-8ad7-516eebf9cc7c"], Cell[
    "\"Normalize\"", "TableText",ExpressionUUID->
     "227e0a67-e96d-4c46-acd9-257acedead44"], Cell[TextData[Cell[BoxData[
     ButtonBox["True",
      BaseStyle->"Link",
      ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
     "752ff231-d587-4417-842d-c2860f549b03"]], "TableText",ExpressionUUID->
     "53c425fc-4619-4755-bed3-2fb2dc2cab2b"], Cell[
    "whether to rescale the compressed MPS to unit norm", "TableText",
     ExpressionUUID->"301dce8f-01bd-4e75-99ba-1d3eb2f23bdd"]}
  }]], "3ColumnTableMod",
 CellID->461355566,ExpressionUUID->"7c18732b-6bb2-4edb-a23e-a81a672bdc9f"]
}, Open  ]],

