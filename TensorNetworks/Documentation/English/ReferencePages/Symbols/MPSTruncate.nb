  $Line = 0; Null]], "ExampleSubsection",
 CellID->473139344,ExpressionUUID->"e9355529-1ab7-4cb6-82be-a6cc11466ac5"],

Cell["\<\
Without normalization, MPSTruncate is exactly MPSCanonicalForm with a \
\"MaxBond\" option:\
\>", "ExampleText",
 CellID->261357300,ExpressionUUID->"8a5327a5-a00e-4bd0-9303-6e5b0d279df2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mps", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "42", "]"}], ";", " ", 
     RowBox[{"RandomTensorNetwork", "[", 
      RowBox[{"\"\<MPS\>\"", "[", 
       RowBox[{"8", ",", " ", "4", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", " ", "=", " ", 
   RowBox[{"MPSTruncate", "[", 
    RowBox[{"mps", ",", " ", "2", ",", " ", 
     RowBox[{"\"\<Normalize\>\"", " ", "->", " ", "False"}]}], "]"}]}], ";", 
  " ", 
  RowBox[{"b", " ", "=", " ", 
   RowBox[{"MPSCanonicalForm", "[", 
    RowBox[{"mps", ",", " ", "\"\<Left\>\"", ",", " ", 
     RowBox[{"\"\<MaxBond\>\"", " ", "->", " ", "2"}]}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"Max", "[", 
    RowBox[{"Norm", " ", "/@", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "[", "\"\<Tensors\>\"", "]"}], " ", "-", " ", 
        RowBox[{"b", "[", "\"\<Tensors\>\"", "]"}]}], ",", " ", "1"}], 
      "]"}]}], "]"}], " ", "<", " ", 
   RowBox[{"10", "^", 
    RowBox[{"(", 
     RowBox[{"-", "10"}], ")"}]}]}]}]}], "Input",
 CellLabel->"In[12]:=",
 CellID->186021806,ExpressionUUID->"fb4dc1a0-d6e3-4e38-b681-3d00d30e49aa"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[12]=",
 CellID->444913927,ExpressionUUID->"c08ad9ea-bd87-41a5-acc7-cca84768f9f9"]
}, Open  ]],

