Cell[CellGroupData[{
Cell["MPSTruncate", "ObjectName",
 CellID->1701875359,ExpressionUUID->"ab328fe8-de52-4837-a3dd-a634ade537df"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c8fbf651-b454-47b0-99ee-f60511baa54a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSTruncate",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/MPSTruncate"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", 
    StyleBox["maxBond", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1edf1094-65aa-4fad-affa-d94b2efb0105"],
 "\[LineSeparator]compresses an MPS by truncating all bonds to at most ",
 Cell[BoxData[
  StyleBox["maxBond", "TI"]], "InlineFormula",ExpressionUUID->
  "3a165838-8805-489e-a292-81a80a29f2e3"],
 ". \[Bullet] The result is in left-canonical form. \[Bullet] Truncation \
error depends on discarded singular values."
}], "Usage",
 CellChangeTimes->{{3.978638396071204*^9, 3.978638396111384*^9}},
 CellID->1084464320,ExpressionUUID->"eb27e53f-944c-4e3a-bd67-3f76d73a51cc"],

