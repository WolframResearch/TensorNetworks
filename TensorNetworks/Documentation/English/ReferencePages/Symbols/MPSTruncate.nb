    RowBox[{
     RowBox[{"SeedRandom", "[", "42", "]"}], ";", " ", 
     RowBox[{"RandomTensorNetwork", "[", 
      RowBox[{"\"\<MPS\>\"", "[", 
       RowBox[{"8", ",", " ", "4", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"full", " ", "=", " ", 
   RowBox[{"MPSSchmidtValues", "[", 
    RowBox[{"mps", ",", " ", "4"}], "]"}]}], ";", " ", 
  RowBox[{"kept", " ", "=", " ", 
   RowBox[{"MPSSchmidtValues", "[", 
    RowBox[{"compressed", ",", " ", "4"}], "]"}]}], ";", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Length", "[", "full", "]"}], ",", " ", 
    RowBox[{"Length", "[", "kept", "]"}]}], "}"}]}]}], "Input",
