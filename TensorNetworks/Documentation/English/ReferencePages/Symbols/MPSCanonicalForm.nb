Cell[BoxData[
 InterpretationBox[Cell[
  "Prepare an MPS for DMRG-style updates", "ExampleSubsection",ExpressionUUID->
   "2665cbce-24cf-49c8-95ab-6e5b42bc3668"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->100000083,ExpressionUUID->"b8b2e11d-37d5-442b-8fea-951eed7ac1f6"],

Cell["\<\
A DMRG sweep updates a single site at a time. The local update is done in the \
mixed canonical form whose orthogonality center sits on the active site \
\[Dash] all other tensors then act trivially on the state:\
\>", "ExampleText",
 CellID->100000084,ExpressionUUID->"904f10af-f173-44db-af0c-2e1ca9e53b7a"],

Cell[BoxData[
 RowBox[{"mps4", " ", "=", " ", 
  RowBox[{"BlockRandom", "[", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";", " ", 
    RowBox[{"RandomTensorNetwork", "[", 
     RowBox[{"\"\<MPS\>\"", "[", 
      RowBox[{"6", ",", " ", "4", ",", " ", "2"}], "]"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->100000085,ExpressionUUID->"d707c46b-d59b-4cc0-ae57-471c43c1e2b7"],

Cell[CellGroupData[{

