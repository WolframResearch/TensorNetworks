Cell["\<\
Build a six-site MPS with bond dimension 4 and physical dimension 2, then \
transform it to canonical form. With no form argument MPSCanonicalForm \
defaults to left-canonical:\
\>", "ExampleText",
 CellID->100000021,ExpressionUUID->"45041be4-0cac-4a56-a3af-cd17fbb8b925"],

Cell[BoxData[
 RowBox[{"mps", " ", "=", " ", 
  RowBox[{"BlockRandom", "[", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";", " ", 
    RowBox[{"RandomTensorNetwork", "[", 
     RowBox[{"\"\<MPS\>\"", "[", 
      RowBox[{"6", ",", " ", "4", ",", " ", "2"}], "]"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->100000022,ExpressionUUID->"286778e9-fc9b-42ed-921a-b71aee0f4d53"],

