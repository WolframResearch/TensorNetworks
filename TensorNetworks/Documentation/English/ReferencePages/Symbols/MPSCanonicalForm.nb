Notebook[{

Cell[CellGroupData[{
Cell["MPSCanonicalForm", "ObjectName",
 CellID->100000001,ExpressionUUID->"db9b15ed-d8e1-4ac2-9d2b-7f49ce78aaca"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7cf7aba3-7347-430a-8bc9-19cec2774198"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSCanonicalForm",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalForm"], "[", 
   StyleBox["mps", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "516cf5b5-826f-47b5-b83f-671b9fce6797"],
 "\[LineSeparator]transforms ",
 Cell[BoxData[
  StyleBox["mps", "TI"]], "InlineFormula",ExpressionUUID->
  "2beba3e1-cef1-4fb3-97e0-c2d99928552b"],
 " into left-canonical form. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e98ad5ce-5100-4fc7-ac86-2e69eba443a8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSCanonicalForm",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalForm"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", "\"\<Left\>\""}], "]"}]], "InlineFormula",
  ExpressionUUID->"efde3ca9-ad78-4b62-a8ad-d72a7e450c56"],
 "\[LineSeparator]puts every tensor in left-isometric form where ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["A", "\[Dagger]"], ".", "A", "=", "I"}]], "InlineFormula",
  ExpressionUUID->"270f7168-6abb-42df-8306-c2e398863580"],
 ". \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"defc9ed5-45ac-47e2-bf7d-ecda518b253a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSCanonicalForm",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalForm"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", "\"\<Right\>\""}], "]"}]], "InlineFormula",
  ExpressionUUID->"5e7e8439-f4a9-452c-9cd6-9ca7571f6bdb"],
 "\[LineSeparator]puts every tensor in right-isometric form where ",
 Cell[BoxData[
  RowBox[{"A", ".", 
   SuperscriptBox["A", "\[Dagger]"], "=", "I"}]], "InlineFormula",
  ExpressionUUID->"2e9f21d5-550a-4855-8271-df711435775a"],
 ". \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"210977b6-2240-4a20-b86b-c6f09d61615a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSCanonicalForm",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalForm"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<Mixed\>\"", ",", 
      StyleBox["k", "TI"]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f67f0726-d9c8-40c7-9ca5-6cc166ce5660"],
 "\[LineSeparator]puts ",
 Cell[BoxData[
  StyleBox["mps", "TI"]], "InlineFormula",ExpressionUUID->
  "bce5f196-f664-482f-b0c0-ce09cc5c4dac"],
 " in mixed canonical form with the orthogonality center at site ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "4600aac6-dbad-417c-8195-1eaa4ed6665f"],
 "."
}], "Usage",
 CellID->100000002,ExpressionUUID->"8b92b2d0-03cb-4e07-9757-b14710b92cd2"],

Cell[TextData[{
 "The MPS routines assume the open-boundary tensor layout used by ",
 Cell[BoxData[
  ButtonBox["RandomTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"e9b17bb3-5d10-4a7a-a0b6-0752913b27d1"],
 "[\"MPS\"]: bulk tensors with shape {leftBond, rightBond, physical}, and \
boundary tensors at sites 1 and ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "c9a40c6c-c43f-4ba5-a66e-231109278a99"],
 " with shape {bond, physical}."
}], "Notes",
 CellID->100000003,ExpressionUUID->"0221dee8-8be3-4534-a73c-8011c7b08592"],

Cell[TextData[{
 "Left-canonical form makes every tensor ",
 Cell[BoxData[
  SuperscriptBox["A", 
   RowBox[{"[", 
    StyleBox["i", "TI"], "]"}]]], "InlineFormula",ExpressionUUID->
  "bc99d6c5-1265-4315-8b65-70de9dd0259c"],
 " satisfy ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["A", "\[Dagger]"], ".", "A", "=", "I"}]], "InlineFormula",
  ExpressionUUID->"a4e605fe-6eca-4947-8f45-e24d42e17b20"],
 " when the bulk tensor is reshaped as a (leftBond \[Times] physical) \
\[Times] rightBond matrix; right-canonical form gives ",
 Cell[BoxData[
  RowBox[{"A", ".", 
   SuperscriptBox["A", "\[Dagger]"], "=", "I"}]], "InlineFormula",
  ExpressionUUID->"e0814f37-375b-43ef-b685-6b0c3fc4d2cc"],
 " when reshaped as leftBond \[Times] (rightBond \[Times] physical)."
}], "Notes",
 CellID->100000004,ExpressionUUID->"f4d6541e-a94a-4e80-940d-6160733b88de"],

Cell[TextData[{
 "Mixed canonical form left-canonicalizes sites 1 through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "7c0ff0d9-c9bb-46d9-8c1c-ae0f4d30dd13"],
 " and right-canonicalizes sites ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "ab8f1f7c-e6bc-4893-9c9d-d362f3242ce7"],
 " through ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "1db90957-7897-4b19-bb6e-43cfba87fa71"],
 ", leaving site ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "8e0f6ced-1a06-43b2-84e9-53054e52604f"],
 " as the orthogonality center carrying the full spectral weight. This is the \
standard form for measurement on site ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "08ade6c0-903b-49d9-a6c9-63a91e183c0a"],
 " and for DMRG-style local updates."
}], "Notes",
 CellID->100000005,ExpressionUUID->"b7261669-73ea-492f-bb65-f0a6bf6aa9a5"],

Cell[TextData[{
 "Canonicalization proceeds by sweeping ",
 Cell[BoxData[
  ButtonBox["SingularValueDecomposition",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/SingularValueDecomposition"]], "InlineFormula",
  ExpressionUUID->"4247711e-78c5-4b1b-bc55-38266bee25d5"],
 " from one boundary to the other; with ",
 Cell[BoxData[
  RowBox[{"\"\<MaxBond\>\"", "\[Rule]", 
   StyleBox["D", "TI"]}]], "InlineFormula",ExpressionUUID->
  "a39b706e-ff88-40a8-9677-00182b9260df"],
 " every bond is capped at dimension ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",ExpressionUUID->
  "50c16820-6e7b-44cd-b79b-3d918e3beba6"],
 ", and with ",
 Cell[BoxData[
  RowBox[{"\"\<Tolerance\>\"", "\[Rule]", "\[Epsilon]"}]], "InlineFormula",
  ExpressionUUID->"f0264826-3419-4d8a-9e87-b7b7d22a23d5"],
 " singular values not exceeding ",
 Cell[BoxData[
 "\[Epsilon]"], "InlineFormula",ExpressionUUID->
  "d5c25c5a-95ed-43d3-898f-5337a83122d3"],
 " are dropped."
}], "Notes",
 CellID->100000006,ExpressionUUID->"15f238c4-81af-43e3-8da0-0833b6fd7a05"],

Cell[TextData[{
 "Without truncation options the result represents the same network as the \
input up to a gauge transformation; ",
 Cell[BoxData[
  ButtonBox["MPSOverlap",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSOverlap"]], 
  "InlineFormula",ExpressionUUID->"fe8ba693-83a5-4279-940b-11e2b89ae15b"],
 " between the input and its canonical form equals ",
 Cell[BoxData[
  ButtonBox["MPSNorm",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"]], "InlineFormula",
  ExpressionUUID->"cfc04619-a15a-48f6-b5fb-b326495dd399"],
 "[mps]",
 Cell[BoxData["\[CenterDot]"], "InlineFormula",ExpressionUUID->
  "a3adffc4-1856-4dc8-aafc-c634f41405de"],
 Cell[BoxData[
  ButtonBox["MPSNorm",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"]], "InlineFormula",
  ExpressionUUID->"d0044882-7585-401a-b85e-b69bb7f3f9dd"],
 "[canon]."
}], "Notes",
 CellID->100000007,ExpressionUUID->"f8494cd5-cab7-49b8-b2ff-2086b356a606"],

Cell["The following options can be given:", "Notes",
 CellID->100000008,ExpressionUUID->"3db87403-6ec5-4f95-bbb9-7eb97dd26e95"],

