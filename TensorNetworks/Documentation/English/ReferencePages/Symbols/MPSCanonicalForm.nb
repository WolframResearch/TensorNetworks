Cell[TextData[{
 "MPSCanonicalForm requires the open-boundary MPS tensor layout produced by \
",
 Cell[BoxData[
  ButtonBox["RandomTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"faba3fde-4e05-46ec-8d08-d1798ee2d9af"],
 "[\"MPS\"]: rank-3 bulk tensors and rank-2 boundaries. Inputs that are not \
tensor networks at all leave the call unevaluated:"
}], "ExampleText",
 CellID->100000119,ExpressionUUID->"61afb4ad-449a-4d1c-bf3b-b1fc2a657772"],

