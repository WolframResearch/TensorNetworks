Cell[TextData[{
 "Without truncation, canonicalization is a gauge transformation: ",
 Cell[BoxData[
  ButtonBox["MPSOverlap",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSOverlap"]], 
  "InlineFormula",ExpressionUUID->"3aea6ffd-fe64-4166-b42b-352a26648785"],
 " between the input and its canonical form equals ",
 Cell[BoxData[
  ButtonBox["Norm",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Norm"]], "InlineFormula",ExpressionUUID->
  "6fe79bd2-75df-46d8-a27a-9bc64e4c3784"],
 "[",
 Cell[BoxData[
  ButtonBox["MPSNorm",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"]], "InlineFormula",
  ExpressionUUID->"ed051ac0-c3cc-4117-9ad4-8e4d6125144a"],
 "[mps]]^2:"
}], "ExampleText",
 CellID->100000113,ExpressionUUID->"50b7e245-bae2-4b16-96a4-fc8a75e76d01"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"MPSOverlap", "[", 
     RowBox[{
      RowBox[{"MPSCanonicalForm", "[", "mps5", "]"}], ",", " ", "mps5"}], 
     "]"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"MPSNorm", "[", "mps5", "]"}], "^", "2"}]}], ",", " ", 
   RowBox[{"10", "^", 
    RowBox[{"(", 
     RowBox[{"-", "10"}], ")"}]}]}], "]"}]], "Input",
 CellLabel->"In[5]:=",
