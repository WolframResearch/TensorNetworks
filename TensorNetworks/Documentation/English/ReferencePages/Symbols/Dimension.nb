Notebook[{

Cell[CellGroupData[{
Cell["Dimension", "ObjectName",ExpressionUUID->"18f92ca1-532a-40ae-8149-839cf68a85e0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"966bfafc-5ab5-4d64-94d7-76e881db2d82"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Dimension",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/Dimension"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", 
    StyleBox["name", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e6d7600e-9b7b-4144-b88f-74b61bc8572f"],
 "\[LineSeparator]represents a tensor index of size d with the given name. A \
negative size denotes a covariant (lower) index; positive denotes \
contravariant (upper). \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"20d5d71c-1b31-4f31-91e7-a6d92b87f444"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Dimension",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/Dimension"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", 
    StyleBox["name", "TI"], ",", 
    StyleBox["indices", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b54cb45f-8d0e-4eda-a27a-64d03b649167"],
 "\[LineSeparator]additionally records the explicit basis labels for the \
index. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"795e2237-1da4-4a86-bdef-0efbad6b7f98"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Dimension",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/Dimension"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", 
    StyleBox["name", "TI"], ",", 
    StyleBox["indices", "TI"], ",", 
    StyleBox["pos", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "23e90974-ac7a-4c22-8c2a-f0a98e925c42"],
 "\[LineSeparator]marks the index as contracted at the specified position pos."
}], "Usage",ExpressionUUID->"0529d29d-c06a-4ed8-95da-2a79af59d564"],

