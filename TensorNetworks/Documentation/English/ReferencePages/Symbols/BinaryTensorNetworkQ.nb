Cell["BinaryTensorNetwork is the constructive inverse of BinaryTensorNetworkQ: it inserts one spider tensor per hyperedge index so the result is binary. On an already-binary network it acts as the identity:", "ExampleText",
 CellID->503030005,ExpressionUUID->"7a1f10c2-3a25-4d3a-8b1e-1a2bd8a9e027"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"hyper", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{"{",
     RowBox[{
      RowBox[{"{",
       RowBox[{"i", ",", "j"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"j", ",", "k", ",", "l"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"j", ",", "k", ",", "m"}], "}"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"btn", "=",
   RowBox[{"BinaryTensorNetwork", "[", "hyper", "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"{",
   RowBox[{
    RowBox[{"BinaryTensorNetworkQ", "[", "hyper", "]"}], ",",
    RowBox[{"BinaryTensorNetworkQ", "[", "btn", "]"}], ",",
    RowBox[{
     RowBox[{"Length", "[",
      RowBox[{"hyper", "[", "\"\<Tensors\>\"", "]"}], "]"}], "\[Rule]",
     RowBox[{"Length", "[",
      RowBox[{"btn", "[", "\"\<Tensors\>\"", "]"}], "]"}]}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->503030006,ExpressionUUID->"7a1f10c2-3a25-4d3a-8b1e-1a2bd8a9e028"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{"False", ",", "True", ",",
   RowBox[{"3", "\[Rule]", "4"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->503030007,ExpressionUUID->"7a1f10c2-3a25-4d3a-8b1e-1a2bd8a9e029"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

