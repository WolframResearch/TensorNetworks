Notebook[{

Cell[CellGroupData[{
Cell["BinaryTensorNetworkQ", "ObjectName",
 CellID->1252125267,ExpressionUUID->"24323776-7361-45a1-b429-f416c74a835e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8270be21-e40c-4964-b3d3-83246b24be31"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["BinaryTensorNetworkQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetworkQ"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "721d26e2-ad83-47ec-95d3-a73e08ecacec"],
 "\[LineSeparator]yields ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "15c25303-07b5-4dde-a184-19489b59b40f"],
 " if every index of ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "a1d3b250-37f0-4d50-8c45-9a7d2f2b41a1"],
 " appears in at most two tensors, i.e. the network has no hyperedges, and ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "2b6e2c0a-2c1d-4a8d-9f81-7e4f33f57bbd"],
 " otherwise."
}], "Usage",
 CellChangeTimes->{{3.978638458735116*^9, 3.9786384587857933`*^9}},
 CellID->1277105516,ExpressionUUID->"27d63849-ddba-48d5-bf2d-258a05f98cd7"],

Cell[TextData[{
 "A tensor network is ",
 StyleBox["binary",
  FontSlant->"Italic"],
 " when every shared index connects exactly two tensors, so the entire \
network can be contracted by a sequence of pairwise operations. Indices that \
appear in three or more tensors are called ",
 StyleBox["hyperedges",
  FontSlant->"Italic"],
 " and require spider (delta) tensors to be replaced by pairwise contractions \
before standard path-finders can run."
}], "Notes",
 CellID->213355647,ExpressionUUID->"7a1fde0b-a4ce-4b7f-96da-93b5c7ae2a34"],

Cell[TextData[{
 "The check is ",
 Cell[BoxData[
  RowBox[{"AllTrue", "[", 
   RowBox[{
    RowBox[{"Counts", "[", 
     RowBox[{"Catenate", "@", 
      RowBox[{
       StyleBox["tn", "TI"], "[", "\"\<Hyperedges\>\"", "]"}]}], "]"}], ",", 
    RowBox[{
     RowBox[{"#", "\[LessEqual]", "2"}], "&"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"4d9cd2a7-2f7b-4f12-bb24-9b2dfa6b71f1"],
 ": tally the occurrences of every index across all hyperedge lists and \
confirm none exceeds two."
}], "Notes",
 CellID->963907769,ExpressionUUID->"957a2bd1-e387-44a2-8cca-a414d8241bcd"],

Cell[TextData[{
 "The MPS, TT, MPO, PEPS, TTN, and MERA topologies generated by ",
 Cell[BoxData[
  ButtonBox["RandomTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"6f3a4e80-2d2f-4f48-8d3e-2f9c9c2a4c81"],
 " are binary by construction; a hand-built ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"7c6a90c5-7283-4d6a-8f72-2c5b87a23c4f"],
 " with three or more tensors sharing the same index is not."
}], "Notes",
 CellID->333931128,ExpressionUUID->"e58941f6-e3d6-47c8-ab9d-8038ba04f5fe"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<BinaryQ\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"a7f96e25-93f7-4fd2-9b8a-5c4e7d0a3a91"],
 " is the property-dispatch dual of ",
 Cell[BoxData[
  ButtonBox["BinaryTensorNetworkQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetworkQ"]], 
  "InlineFormula",ExpressionUUID->"f8a325fd-24da-4cf5-a5df-c01a65912951"],
 "; the two forms return the same Boolean."
}], "Notes",
 CellID->263307568,ExpressionUUID->"eec47f3c-fa15-45f2-bbde-2644aba77fc7"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["BinaryTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"b1f3612c-058e-437d-8490-1e2cfa63db94"],
 " converts a network with hyperedges into a binary one by inserting one ",
 Cell[BoxData[
  ButtonBox["SymbolicDeltaProductArray",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/TensorNetworks/ref/SymbolicDeltaProductArray"]], 
  "InlineFormula",ExpressionUUID->"e26c4d70-7d12-4a73-9a52-3a9bbf8b3d35"],
 " spider per offending index; on a binary input it is the identity."
}], "Notes",
 CellID->839855718,ExpressionUUID->"a755409d-060d-4a15-b969-e6f548f48833"]
}, Open  ]],

