      RowBox[{"{",
       RowBox[{"j", ",", "k", ",", "l"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"j", ",", "k", ",", "m"}], "}"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"{",
   RowBox[{
    RowBox[{"BinaryTensorNetworkQ", "[", "hyper", "]"}], ",",
    RowBox[{"BinaryTensorNetworkQ", "[",
     RowBox[{"BinaryTensorNetwork", "[", "hyper", "]"}], "]"}]}], "}"}]}]], "Input",
