Cell["Use BinaryTensorNetworkQ as a gate before a pairwise contraction path-finder: a binary input proceeds directly, a hyperedge input is routed through BinaryTensorNetwork first:", "ExampleText",
 CellID->502020001,ExpressionUUID->"7a1f10c2-3a25-4d3a-8b1e-1a2bd8a9e020"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"preparePairwise", "[", "net_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"BinaryTensorNetworkQ", "[", "net", "]"}], ",", "net", ",", 
     RowBox[{"BinaryTensorNetwork", "[", "net", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hyper", "=", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "k", ",", "l"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "k", ",", "m"}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"BinaryTensorNetworkQ", "[", 
  RowBox[{"preparePairwise", "[", "hyper", "]"}], "]"}]}], "Input",
 CellLabel->"In[56]:=",
 CellID->502020002,ExpressionUUID->"7a1f10c2-3a25-4d3a-8b1e-1a2bd8a9e021"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988239783657275*^9},
 CellLabel->"Out[58]=",
 CellID->1624921872,ExpressionUUID->"6fdb77cf-7066-411d-b4b3-e35932135ff4"]
}, Open  ]]
}, Open  ]],

