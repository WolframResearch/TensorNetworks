Cell["The property-dispatch form tn[\"BinaryQ\"] returns the same Boolean as BinaryTensorNetworkQ[tn]:", "ExampleText",
 CellID->503030001,ExpressionUUID->"7a1f10c2-3a25-4d3a-8b1e-1a2bd8a9e023"],

Cell[CellGroupData[{

