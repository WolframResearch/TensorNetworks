Cell["A pairwise binary chain has only two-tensor indices, so the predicate is True:", "ExampleText",
 CellID->590001001,ExpressionUUID->"d9bb5c47-368c-4a67-ac51-8d52a3e84fed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BinaryTensorNetworkQ", "[", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->"In[41]:=",
