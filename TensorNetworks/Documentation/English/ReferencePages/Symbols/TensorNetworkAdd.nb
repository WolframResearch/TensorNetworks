Cell[BoxData[
 InterpretationBox[Cell[
  "Glue two networks by adding tensors of one into the other", 
   "ExampleSubsection",ExpressionUUID->"4030775c-99a1-4a1a-b390-b2834e5dfab0"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->735037896,ExpressionUUID->"58785bc8-adb8-4303-ba81-0d7c3ee52ee2"],

Cell["\<\
TensorNetworkAdd lets you merge two networks one tensor at a time, treating \
the second network's tensor list and hyperedge list as an append-stream:\
\>", "ExampleText",
 CellID->648855929,ExpressionUUID->"9d3237b5-dc52-4f10-93a0-9e6b21a1e3db"],

Cell[BoxData[
 RowBox[{
  RowBox[{"leftTN", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"rightTN", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "z"}], "}"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"merged", " ", "=", " ", 
   RowBox[{"Fold", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"TensorNetworkAdd", "[", 
       RowBox[{"#1", ",", " ", 
        RowBox[{"#2", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"#2", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "&"}], " ", ",", " ", 
     "leftTN", ",", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"rightTN", "[", "\"\<Tensors\>\"", "]"}], ",", " ", 
        RowBox[{"rightTN", "[", "\"\<Hyperedges\>\"", "]"}]}], "}"}], "]"}]}],
     "]"}]}]}]], "Input",
 CellLabel->"In[]:=",
 CellID->826869022,ExpressionUUID->"93b0db3f-da83-41a9-83b8-3ea161a9473c"],

