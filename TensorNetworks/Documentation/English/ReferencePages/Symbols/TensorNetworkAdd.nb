 RowBox[{
  RowBox[{"chainTN2", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
