Cell["\<\
Adding a tensor to an existing TensorNetwork gives the same hyperedge \
structure as building the full network in one call:\
\>", "ExampleText",
 CellID->106016653,ExpressionUUID->"c4353c2a-7dd0-41c0-bd2f-9ca7e05f362b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tnIncremental", " ", "=", " ", 
   RowBox[{"TensorNetworkAdd", "[", 
    RowBox[{
     RowBox[{"TensorNetwork", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"idx1", ",", " ", "idx2"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"idx2", ",", " ", "idx3"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"idx3", ",", " ", "idx1"}], "}"}]}], "}"}]}], "]"}], ",", 
     " ", "t4", ",", " ", 
     RowBox[{"{", 
      RowBox[{"idx1", ",", " ", "idx5"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"tnAtOnce", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t1", ",", " ", "t2", ",", " ", "t3", ",", " ", "t4"}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"idx1", ",", " ", "idx2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"idx2", ",", " ", "idx3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"idx3", ",", " ", "idx1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"idx1", ",", " ", "idx5"}], "}"}]}], "}"}]}], "]"}]}], ";", 
  " ", 
  RowBox[{
   RowBox[{"tnIncremental", "[", "\"\<Hyperedges\>\"", "]"}], " ", "===", " ", 
   RowBox[{"tnAtOnce", "[", "\"\<Hyperedges\>\"", "]"}]}]}]], "Input",
 CellLabel->"In[]:=",
 CellID->548898237,ExpressionUUID->"798ffd05-3a8c-4816-9d19-5829ac2bc7ff"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[]=",
 CellID->195414487,ExpressionUUID->"1722b8d2-e92f-4eb3-b927-3d929e87960b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "TensorNetworkDelete inverts the last TensorNetworkAdd", 
   "ExampleSubsection",ExpressionUUID->"2de67dd7-841f-4701-b107-016b045e3ea8"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->584850052,ExpressionUUID->"aa1b5a15-77bd-4388-a94d-ee78e7ddc2d4"],

Cell["\<\
The added tensor is appended at the end, so deleting the last vertex restores \
the previous network:\
\>", "ExampleText",
 CellID->422786488,ExpressionUUID->"1b511d02-0182-4b94-868e-69ca2cd4fa77"],

Cell[BoxData[
 RowBox[{
  RowBox[{"base", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"idx1", ",", " ", "idx2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"idx2", ",", " ", "idx3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"idx3", ",", " ", "idx1"}], "}"}]}], "}"}]}], "]"}]}], ";", 
  " ", 
  RowBox[{
   RowBox[{
    RowBox[{"TensorNetworkDelete", "[", 
     RowBox[{"TensorNetworkAdd", "[", 
      RowBox[{"base", ",", " ", "t4", ",", " ", 
       RowBox[{"{", 
        RowBox[{"idx1", ",", " ", "idx5"}], "}"}]}], "]"}], "]"}], 
    "[", "\"\<Hyperedges\>\"", "]"}], " ", "===", " ", 
   RowBox[{"base", "[", "\"\<Hyperedges\>\"", "]"}]}]}]], "Input",
 CellLabel->"In[]:=",
 CellID->210534189,ExpressionUUID->"a52b3857-5da9-4608-b1f0-bdfdd5629c36"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[]=",
 CellID->402409348,ExpressionUUID->"594acd4b-4f9f-4898-aaed-086beed909cd"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Output dimensions update with the free-index set", "ExampleSubsection",
   ExpressionUUID->"380d7395-a258-4094-b26e-11aa9581499a"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->713082034,ExpressionUUID->"b2456a7f-38d1-440d-83ce-13f0566ef472"],

Cell["\<\
Indices that go from free to contracted are dropped from the output list; new \
free indices are appended:\
\>", "ExampleText",
 CellID->853198738,ExpressionUUID->"12f42fa1-b445-488a-b112-ec33dc8ba649"],

Cell[BoxData[
 RowBox[{
  RowBox[{"baseOut", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", " ", "v"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"v", ",", " ", "w"}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "w"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"baseOut", "[", "\"\<Output\>\"", "]"}]}]], "Input",
 CellLabel->"In[]:=",
 CellID->204036608,ExpressionUUID->"abaf65b2-81aa-4194-996e-09c7af85f591"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"u", ",", "w"}], "}"}]], "Output",
 CellLabel->"Out[]=",
 CellID->836073542,ExpressionUUID->"a87b0f2b-21a5-4faf-bd6f-8377ee5cf15a"],

Cell["\<\
After appending a tensor sharing w and introducing q, w drops out and q is \
added:\
\>", "ExampleText",
 CellID->412304842,ExpressionUUID->"4bc8c2a3-7c72-4b6b-b12b-dfe9d79cb346"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TensorNetworkAdd", "[", 
   RowBox[{"baseOut", ",", " ", 
    RowBox[{"RandomReal", "[", 
     RowBox[{"1", ",", " ", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"w", ",", " ", "q"}], "}"}]}], "]"}], "[", "\"\<Output\>\"", 
  "]"}]], "Input",
 CellLabel->"In[]:=",
 CellID->894988919,ExpressionUUID->"73c9ef40-6e7d-42fc-ba8a-f5e7113a39f0"],

Cell[BoxData[
 RowBox[{"{", 
