    RowBox[{"tn", ",", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{"1", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", "onlyOne", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"TensorNetworkQ", "[", "bad", "]"}]}]], "Input",
 CellLabel->"In[]:=",
 CellID->137457322,ExpressionUUID->"e1663fe2-f831-4bf8-872d-a2bb5f29cd73"],

