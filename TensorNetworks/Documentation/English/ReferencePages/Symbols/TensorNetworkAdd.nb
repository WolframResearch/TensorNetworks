Cell[CellGroupData[{

Cell["\<\
Build a triangle tensor network with three free indices contracted pairwise:\
\>", "ExampleText",
 CellID->251832066,ExpressionUUID->"ccc3c316-f18f-4f1f-aa24-1b5cf7081d1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"t1", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"1", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"t2", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"1", ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"t3", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"1", ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "2"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"t4", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"1", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"tn", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"idx1", ",", " ", "idx2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"idx2", ",", " ", "idx3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"idx3", ",", " ", "idx1"}], "}"}]}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[]:=",
 CellID->438498585,ExpressionUUID->"1c7292a6-44ea-4e51-9b1a-eb685e20f8a0"],

