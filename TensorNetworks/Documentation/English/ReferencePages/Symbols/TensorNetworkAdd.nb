Cell[CellGroupData[{
Cell["TensorNetworkAdd", "ObjectName",
 CellID->770668428,ExpressionUUID->"e9edbdc7-3a0c-4d2b-a489-0dc5f6268bc5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"085e699e-479f-4fa6-810b-85fbe31a1496"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkAdd",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkAdd"], "[", 
   RowBox[{
    StyleBox["tn", "TI"], ",", 
    StyleBox["tensor", "TI"], ",", 
    StyleBox["indices", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "62642e81-0d9d-49c1-8cc1-0616a70ac7e6"],
 "\[LineSeparator]appends ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "70e4d274-ae8d-4729-bc8e-b070fae12a16"],
 " to the tensor network ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "975ab4d9-0ca6-4ced-bfe0-e118007ea13b"],
 " with the given hyperedge ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "5e18c0a1-862e-40ac-b179-6c5cfd60ad6c"],
 ". \[Bullet]",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7389d0d2-e234-4e4c-be66-1d76ac35cc96"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkAdd",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkAdd"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", 
    StyleBox["tensor", "TI"], ",", 
    StyleBox["index", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f8bfebb6-b473-4c0a-8fc6-d0e7b7d9940f"],
 "\[LineSeparator]appends ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "def7ddb7-5c00-4b55-9d46-c0bcc4e15437"],
 " to a ",
 Cell[BoxData[
  ButtonBox["ToTensorNetworkGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]], 
  "InlineFormula",ExpressionUUID->"1e89ec01-1599-4d36-9e33-21561e165221"],
 " annotated graph, connecting it at ",
 Cell[BoxData[
  StyleBox["index", "TI"]], "InlineFormula",ExpressionUUID->
  "00585df0-a9db-4b22-b943-a4a397118686"],
 ". \[Bullet]",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"45d3ab22-852b-4924-ab2f-6baead00f9c1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkAdd",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkAdd"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", 
    RowBox[{
     ButtonBox["Labeled",
      BaseStyle->"Link",
      ButtonData->"paclet:ref/Labeled"], "[", 
     RowBox[{
      StyleBox["tensor", "TI"], ",", 
      StyleBox["label", "TI"]}], "]"}], ",", 
    StyleBox["index", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1d89054b-515d-4406-a85a-924be901a5e1"],
 "\[LineSeparator]attaches a vertex ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "d11e6a8f-64c5-4cf2-a7e2-5197f7dce8b7"],
 " in the Graph form. \[Bullet]",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8e10e34f-7634-4a13-ae73-cf5ba71ab288"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkAdd",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkAdd"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", 
    StyleBox["tensor", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "88ae1de2-ebd7-4b8c-bb0d-178ade42a9d9"],
 "\[LineSeparator]selects indices automatically from the current free indices \
of ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "ea494083-9a53-4d4e-a6ad-c9e86c50f4ae"],
 "."
}], "Usage",
 CellID->856571380,ExpressionUUID->"f7b396b8-0940-47bf-8ed4-3101c415a224"],

Cell[TextData[{
 "The length of ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "7c50ef92-5ce3-40ac-aaaa-f616336221c6"],
 " must equal the rank of ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "8fbbb674-cae6-4c53-bb30-98274671fe01"],
 "; otherwise the resulting expression is held and not a valid network."
}], "Notes",
 CellID->828190185,ExpressionUUID->"13ccda3b-be77-40ab-98ca-1e5a88ce2a3a"],

Cell[TextData[{
 "Any index in ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "d673c736-33dc-451f-adf6-97e48b58193e"],
 " that already occurs in the network becomes a contraction in the result; \
indices not yet present are added to the free-index set."
}], "Notes",
 CellID->677432820,ExpressionUUID->"e6006d94-ce98-4847-bfab-cf116be83116"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "8b32d196-2229-4967-b3e6-79a74db0896c"],
 " was constructed with an explicit ",
 Cell[BoxData["\"\<Output\>\""], "InlineFormula",ExpressionUUID->
  "13d019cb-408f-43d5-a228-b24bd0a3a2ac"],
 " list, the output of the new network drops any index that is no longer free \
and appends the new free indices contributed by ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "a70d46c6-9deb-42bc-963f-2ba62b67d616"],
 "; otherwise it stays ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Automatic"]], "InlineFormula",ExpressionUUID->
  "df8e7f1d-2293-46db-8531-72de5585e1e6"],
 "."
}], "Notes",
 CellID->274546240,ExpressionUUID->"f88f637d-d245-4315-baac-ea5ee9ee023d"],

Cell[TextData[{
 "In the Graph form, each new edge is directed: the new vertex receives a ",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->
  "d5e337e1-c5b5-4d9c-a505-83e545644e5c"],
 "-indexed leg where it meets a ",
 Cell[BoxData[
  ButtonBox["Subscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Subscript"]], "InlineFormula",ExpressionUUID->
  "0cceaa8c-82af-419f-92cf-cfd253c60f14"],
 "-indexed leg of the existing graph, and vice versa, so that every \
contracted edge connects one output index to one input index."
}], "Notes",
 CellID->619953794,ExpressionUUID->"f49f240e-3d2a-401f-a754-ec369898bd0a"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["index", "TI"]], "InlineFormula",ExpressionUUID->
  "19e25715-206b-4867-9b96-085002e93d08"],
 " is ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Automatic"]], "InlineFormula",ExpressionUUID->
  "e753ec3f-3f90-44c5-9f87-7607b9fe64a4"],
 " in the Graph form, indices are taken in order from ",
 Cell[BoxData[
  ButtonBox["TensorNetworkFreeIndices",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkFreeIndices"]],
   "InlineFormula",ExpressionUUID->"54fcccd4-bec2-4cde-a472-6753fb7edd3d"],
 "[",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "52b48c57-3288-4ef4-bab6-c74ec3234f44"],
 "], up to the rank of ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "5c39f12e-1ca1-401a-91b4-8bd333b441e6"],
 ". Any remaining slots become fresh free indices on the new vertex."
}], "Notes",
 CellID->921589582,ExpressionUUID->"470363e4-5c7a-4df5-b678-eb73cc138137"],

Cell[TextData[{
 "Calling ",
 Cell[BoxData[
  ButtonBox["TensorNetworkAdd",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkAdd"]], 
  "InlineFormula",ExpressionUUID->"fdfebf20-144a-47c9-a0b5-69e919c017d9"],
 " with a list of disjoint indices is the incremental analogue of \
constructing the whole network at once with ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"31704b11-d537-4f5e-8667-a423b0495865"],
 "[",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["tensors", "TI"], ",", "\[Ellipsis]"}], "}"}]], "InlineFormula",
  ExpressionUUID->"5221d453-236f-4044-a189-bf01a9a6d381"],
 ",",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["indices", "TI"], ",", "\[Ellipsis]"}], "}"}]], "InlineFormula",
  ExpressionUUID->"16351a12-f028-4591-b84b-2cbeacdc773e"],
 "]."
}], "Notes",
 CellID->238691610,ExpressionUUID->"13d3532a-a802-4199-95cb-0d34a4996953"]
}, Open  ]],

