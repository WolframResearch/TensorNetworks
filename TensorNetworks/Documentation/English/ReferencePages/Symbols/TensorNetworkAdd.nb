}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell["\<\
Automatic index in the Graph form may not pick the bonds you want\
\>", "ExampleSubsection",ExpressionUUID->
   "e297f77c-a1e7-4fff-9ea2-f630fa77febd"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->882820785,ExpressionUUID->"cc6cf0c7-df5a-4dba-9477-01ba25fa16a5"],

Cell["\<\
When the index argument is Automatic, TensorNetworkAdd binds the new tensor \
to the first available free indices.  If the graph has multiple free legs and \
a specific wiring is needed, pass the index list explicitly:\
\>", "ExampleText",
 CellID->637780549,ExpressionUUID->"dd688c14-5d30-42d1-b74a-6d1ea2599506"],

Cell[BoxData[
 RowBox[{
  RowBox[{"chainII", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"aa", ",", " ", "bb"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"bb", ",", " ", "cc"}], "}"}]}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"gII", " ", "=", " ", 
   RowBox[{"ToTensorNetworkGraph", "[", "chainII", "]"}]}], ";", " ", 
  RowBox[{"TensorNetworkFreeIndices", "[", "gII", "]"}]}]], "Input",
 CellLabel->"In[]:=",
 CellID->507111352,ExpressionUUID->"03de3751-5188-4222-9a37-3cec7d259890"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{"1", "1"},
    "Superscript"], ",", 
   SubscriptBox["2", "2"]}], "}"}]], "Output",
 CellLabel->"Out[]=",
 CellID->325600338,ExpressionUUID->"5034b1a8-19c8-4551-8d1e-659b60eb1904"],

Cell["\<\
With Automatic, the appended vertex (index 3) is wired to both free legs in \
sorted order:\
\>", "ExampleText",
 CellID->634560371,ExpressionUUID->"a7898812-7d54-4883-bd8b-96dde0dc922d"],

Cell[BoxData[
 RowBox[{"AnnotationValue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"TensorNetworkAdd", "[", 
      RowBox[{"gII", ",", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
     "3"}], "}"}], ",", " ", "\"\<Index\>\""}], "]"}]], "Input",
 CellLabel->"In[]:=",
 CellID->122716627,ExpressionUUID->"d429d059-99f5-4171-9e53-3a699a720341"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{"3", "2"},
    "Superscript"], ",", 
   SubscriptBox["3", "1"]}], "}"}]], "Output",
 CellLabel->"Out[]=",
 CellID->991392149,ExpressionUUID->"fd12ff24-259e-47e2-9346-aff0a8036e8c"]
}, Open  ]]
}, Open  ]],

