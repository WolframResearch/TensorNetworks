        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", "c"}], "}"}]}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"gLabeled", " ", "=", " ", 
   RowBox[{"ToTensorNetworkGraph", "[", "chainTN2", "]"}]}]}]], "Input",
