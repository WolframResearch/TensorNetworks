Cell[CellGroupData[{
Cell["PartitionQ", "ObjectName",
 CellID->430010001,ExpressionUUID->"eebb648d-434e-4486-ae35-c67af868a1fd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a2b04edc-6e25-4597-b698-956b594c1657"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PartitionQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/PartitionQ"], "[",
   StyleBox["list", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7992fe70-a5b9-4ad5-aee8-cbc44adf381b"],
 "\[LineSeparator]yields ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "430020001-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 " if ",
 Cell[BoxData[
  StyleBox["list", "TI"]], "InlineFormula",ExpressionUUID->
  "430020002-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 " is a valid integer partition: a non-empty list of positive integers in \
non-increasing order."
}], "Usage",
 CellID->430010002,ExpressionUUID->"18fab301-2d60-43a2-85ef-a0384a33cd33"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["PartitionQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PartitionQ"]],
  "InlineFormula",ExpressionUUID->"430030001-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 " returns ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "430030002-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 " for any non-empty list whose every element is a positive ",
 Cell[BoxData[
  ButtonBox["Integer",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Integer"]], "InlineFormula",ExpressionUUID->
  "430030003-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 " and the entries are weakly decreasing (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[StyleBox["p", "TI"], StyleBox["1", "TI"]], "\[GreaterEqual]",
   SubscriptBox[StyleBox["p", "TI"], StyleBox["2", "TI"]], "\[GreaterEqual]",
   "\[Ellipsis]", "\[GreaterEqual]",
   SubscriptBox[StyleBox["p", "TI"], StyleBox["r", "TI"]], ">", "0"}]],
  "InlineFormula",ExpressionUUID->"430030004-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 "), and ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "430030005-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 " otherwise."
}], "Notes",
 CellID->430010003,ExpressionUUID->"430030006-aaaa-bbbb-cccc-aaaaaaaaaaaa"],

Cell[TextData[{
 "Repeated values are allowed: ",
 Cell[BoxData[
  RowBox[{"PartitionQ", "[",
   RowBox[{"{",
    RowBox[{"3", ",", "3", ",", "2"}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"430030101-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 " is ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "430030102-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 ", since the order is non-strictly decreasing. The single-element list ",
 Cell[BoxData[
  RowBox[{"{", StyleBox["n", "TI"], "}"}]], "InlineFormula",ExpressionUUID->
  "430030103-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 " satisfies ",
 Cell[BoxData[
  ButtonBox["PartitionQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PartitionQ"]],
  "InlineFormula",ExpressionUUID->"430030104-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 " for any positive integer ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "430030105-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 "."
}], "Notes",
 CellID->430010004,ExpressionUUID->"430030106-aaaa-bbbb-cccc-aaaaaaaaaaaa"],

Cell[TextData[{
 "The empty list ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "430030201-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 " returns ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "430030202-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 " because the kernel definition requires at least one entry. Zero entries, \
negative integers, and non-integer values all fail the per-element check."
}], "Notes",
 CellID->430010005,ExpressionUUID->"430030203-aaaa-bbbb-cccc-aaaaaaaaaaaa"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["PartitionQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PartitionQ"]],
  "InlineFormula",ExpressionUUID->"430030301-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 " is the input guard used by ",
 Cell[BoxData[
  ButtonBox["TransposePartition",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TransposePartition"]],
  "InlineFormula",ExpressionUUID->"430030302-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 ", ",
 Cell[BoxData[
  ButtonBox["HookLengths",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookLengths"]],
  "InlineFormula",ExpressionUUID->"430030303-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 ", ",
 Cell[BoxData[
  ButtonBox["HookFactor",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"]],
  "InlineFormula",ExpressionUUID->"430030304-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 ", and ",
 Cell[BoxData[
  ButtonBox["TableauDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"]],
  "InlineFormula",ExpressionUUID->"430030305-aaaa-bbbb-cccc-aaaaaaaaaaaa"],
 ", which all dispatch only on partition-valued input."
}], "Notes",
 CellID->430010006,ExpressionUUID->"430030306-aaaa-bbbb-cccc-aaaaaaaaaaaa"]
}, Open  ]],

