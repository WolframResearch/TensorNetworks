Cell[CellGroupData[{
Cell["PartitionQ", "ObjectName",
 CellID->430010001,ExpressionUUID->"eebb648d-434e-4486-ae35-c67af868a1fd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a2b04edc-6e25-4597-b698-956b594c1657"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PartitionQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/PartitionQ"], "[", 
   StyleBox["list", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7992fe70-a5b9-4ad5-aee8-cbc44adf381b"],
 "\[LineSeparator]yields ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "43002000-1aaa-abbb-bccc-caaaaaaaaaaa"],
 " if ",
 Cell[BoxData[
  StyleBox["list", "TI"]], "InlineFormula",ExpressionUUID->
  "43002000-2aaa-abbb-bccc-caaaaaaaaaaa"],
 " is a valid integer partition: a non-empty list of positive integers in \
non-increasing order."
}], "Usage",
 CellID->430010002,ExpressionUUID->"18fab301-2d60-43a2-85ef-a0384a33cd33"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["PartitionQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PartitionQ"]], 
  "InlineFormula",ExpressionUUID->"43003000-1aaa-abbb-bccc-caaaaaaaaaaa"],
 " returns ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "43003000-2aaa-abbb-bccc-caaaaaaaaaaa"],
 " for any non-empty list whose every element is a positive ",
 Cell[BoxData[
  ButtonBox["Integer",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Integer"]], "InlineFormula",ExpressionUUID->
  "43003000-3aaa-abbb-bccc-caaaaaaaaaaa"],
 " and the entries are weakly decreasing (",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["1", "TI"]], "\[GreaterEqual]", 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["2", "TI"]], "\[GreaterEqual]", "\[Ellipsis]", "\[GreaterEqual]", 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["r", "TI"]], ">", "0"}]], "InlineFormula",ExpressionUUID->
  "43003000-4aaa-abbb-bccc-caaaaaaaaaaa"],
 "), and ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "43003000-5aaa-abbb-bccc-caaaaaaaaaaa"],
 " otherwise."
}], "Notes",
 CellID->430010003,ExpressionUUID->"43003000-6aaa-abbb-bccc-caaaaaaaaaaa"],

Cell[TextData[{
 "Repeated values are allowed: ",
 Cell[BoxData[
  RowBox[{"PartitionQ", "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3", ",", "2"}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"43003010-1aaa-abbb-bccc-caaaaaaaaaaa"],
 " is ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "43003010-2aaa-abbb-bccc-caaaaaaaaaaa"],
 ", since the order is non-strictly decreasing. The single-element list ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["n", "TI"], "}"}]], "InlineFormula",ExpressionUUID->
  "43003010-3aaa-abbb-bccc-caaaaaaaaaaa"],
 " satisfies ",
 Cell[BoxData[
  ButtonBox["PartitionQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PartitionQ"]], 
  "InlineFormula",ExpressionUUID->"43003010-4aaa-abbb-bccc-caaaaaaaaaaa"],
 " for any positive integer ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "43003010-5aaa-abbb-bccc-caaaaaaaaaaa"],
 "."
}], "Notes",
 CellID->430010004,ExpressionUUID->"43003010-6aaa-abbb-bccc-caaaaaaaaaaa"],

Cell[TextData[{
 "The empty list ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "43003020-1aaa-abbb-bccc-caaaaaaaaaaa"],
 " returns ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "43003020-2aaa-abbb-bccc-caaaaaaaaaaa"],
 " because the kernel definition requires at least one entry. Zero entries, \
negative integers, and non-integer values all fail the per-element check."
}], "Notes",
 CellID->430010005,ExpressionUUID->"43003020-3aaa-abbb-bccc-caaaaaaaaaaa"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["PartitionQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PartitionQ"]], 
  "InlineFormula",ExpressionUUID->"43003030-1aaa-abbb-bccc-caaaaaaaaaaa"],
 " is the input guard used by ",
 Cell[BoxData[
  ButtonBox["TransposePartition",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TransposePartition"]], 
  "InlineFormula",ExpressionUUID->"43003030-2aaa-abbb-bccc-caaaaaaaaaaa"],
 ", ",
 Cell[BoxData[
  ButtonBox["HookLengths",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookLengths"]], 
  "InlineFormula",ExpressionUUID->"43003030-3aaa-abbb-bccc-caaaaaaaaaaa"],
 ", ",
 Cell[BoxData[
  ButtonBox["HookFactor",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"]], 
  "InlineFormula",ExpressionUUID->"43003030-4aaa-abbb-bccc-caaaaaaaaaaa"],
 ", and ",
 Cell[BoxData[
  ButtonBox["TableauDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"]], 
  "InlineFormula",ExpressionUUID->"43003030-5aaa-abbb-bccc-caaaaaaaaaaa"],
 ", which all dispatch only on partition-valued input."
}], "Notes",
 CellID->430010006,ExpressionUUID->"43003030-6aaa-abbb-bccc-caaaaaaaaaaa"]
}, Open  ]],

