Cell["\<\
Get the per-tensor index specifications for a tensor network:\
\>", "ExampleText",
 CellID->620001001,ExpressionUUID->"a51ff44b-0e54-4438-be96-03c4cb67fdd2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->620001002,ExpressionUUID->"e0b68733-50c3-4ff0-9cf9-f07b5fc8f14f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorNetworkIndices", "[", "tn", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->620001003,ExpressionUUID->"40840a57-cd00-4f67-9dfb-272c1bfee13a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "i"},
      "Superscript"], ",", 
     TemplateBox[{"1", "j"},
      "Superscript"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"2", "j"},
      "Superscript"], ",", 
     TemplateBox[{"2", "k"},
      "Superscript"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->620001004,ExpressionUUID->"c0001001-aaaa-4001-bbbb-200000000001"]
}, Open  ]],

Cell[TextData[{
 "Each inner list holds the slot labels of one tensor; every label carries \
the tensor's 1-based position as its ",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->
  "c0001002-aaaa-4002-bbbb-200000000002"],
 " tag. The shared hyperedge ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "c0001003-aaaa-4003-bbbb-200000000003"],
 " appears in both tensors as ",
 Cell[BoxData[
  SuperscriptBox["1", "j"]], "InlineFormula",ExpressionUUID->
  "c0001004-aaaa-4004-bbbb-200000000004"],
 " and ",
 Cell[BoxData[
  SuperscriptBox["2", "j"]], "InlineFormula",ExpressionUUID->
  "c0001005-aaaa-4005-bbbb-200000000005"],
 "; the free indices ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "c0001006-aaaa-4006-bbbb-200000000006"],
 " and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "c0001007-aaaa-4007-bbbb-200000000007"],
 " carry a single labeled occurrence."
}], "ExampleText",
 CellID->620001010,ExpressionUUID->"c0001008-aaaa-4008-bbbb-200000000008"],

Cell["The property syntax exposes the same value:", "ExampleText",
 CellID->620001020,ExpressionUUID->"c0001009-aaaa-4009-bbbb-200000000009"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", "[", "\"\<Indices\>\"", "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->620001021,ExpressionUUID->"c0001010-aaaa-4010-bbbb-200000000010"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "i"},
      "Superscript"], ",", 
     TemplateBox[{"1", "j"},
      "Superscript"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"2", "j"},
      "Superscript"], ",", 
     TemplateBox[{"2", "k"},
      "Superscript"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->620001022,ExpressionUUID->"c0001011-aaaa-4011-bbbb-200000000011"]
}, Open  ]],

