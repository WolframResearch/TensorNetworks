Notebook[{

Cell[CellGroupData[{
Cell["TensorNetworkIndices", "ObjectName",
 CellID->1627759359,ExpressionUUID->"1e52e765-8db9-4cd3-813f-f40d9deb0794"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ae4c25ff-f901-4479-a874-2c5dd9d92487"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkIndices",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndices"], "[",
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ef1deb25-de1a-448c-ba81-7c184a121075"],
 "\[LineSeparator]returns the per-tensor index specifications for the tensor network ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->"a0001001-aaaa-4001-bbbb-000000000001"],
 ", with each index labeled ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Superscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Superscript"], "[",
   RowBox[{
    StyleBox["v", "TI"], ",", StyleBox["k", "TI"]}], "]"}]], "InlineFormula",
  ExpressionUUID->"a0001002-aaaa-4002-bbbb-000000000002"],
 " where ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",ExpressionUUID->"a0001003-aaaa-4003-bbbb-000000000003"],
 " is the 1-based tensor position and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->"a0001004-aaaa-4004-bbbb-000000000004"],
 " is the local slot identifier from the hyperedge specification.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a0001005-aaaa-4005-bbbb-000000000005"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkIndices",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndices"], "[",
   StyleBox["net", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a0001006-aaaa-4006-bbbb-000000000006"],
 "\[LineSeparator]returns the per-vertex index lists annotated on the graph form ",
 Cell[BoxData[
  StyleBox["net", "TI"]], "InlineFormula",ExpressionUUID->"a0001007-aaaa-4007-bbbb-000000000007"],
 " produced by ",
 Cell[BoxData[
  ButtonBox["ToTensorNetworkGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]],
  "InlineFormula",ExpressionUUID->"a0001008-aaaa-4008-bbbb-000000000008"],
 "."
}], "Usage",
 CellID->957367580,ExpressionUUID->"9d10e4d6-c161-4b8c-8780-e6444a2bdf97"],

Cell[TextData[{
 "For the ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]],
  "InlineFormula",ExpressionUUID->"a0002001-aaaa-4001-bbbb-000000000010"],
 " form, indices are labeled ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["v", "TI"],
   StyleBox["k", "TI"]]], "InlineFormula",ExpressionUUID->"a0002002-aaaa-4002-bbbb-000000000011"],
 ". The position ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",ExpressionUUID->"a0002003-aaaa-4003-bbbb-000000000012"],
 " ranges over the tensor list and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->"a0002004-aaaa-4004-bbbb-000000000013"],
 " is the integer or symbolic label written by the user inside the hyperedge ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",ExpressionUUID->"a0002005-aaaa-4005-bbbb-000000000014"],
 ". This is the canonical per-tensor labeling used internally by ",
 Cell[BoxData[
  ButtonBox["TensorNetworkData",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkData"]],
  "InlineFormula",ExpressionUUID->"a0002006-aaaa-4006-bbbb-000000000015"],
 " and ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContractions",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContractions"]],
  "InlineFormula",ExpressionUUID->"a0002007-aaaa-4007-bbbb-000000000016"],
 "."
}], "Notes",
 CellID->1529433736,ExpressionUUID->"b13d51cf-e38e-41ce-adf7-3f9ef4a0da55"],

Cell[TextData[{
 "The property form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Indices\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"a0003001-bbbb-4001-cccc-000000000020"],
 " is equivalent to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkIndices",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndices"], "[",
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->"a0003002-bbbb-4002-cccc-000000000021"],
 ": both return the same ",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->
  "a0003003-bbbb-4003-cccc-000000000022"],
 "-labeled list."
}], "Notes",
 CellID->1529433737,ExpressionUUID->"a0003004-bbbb-4004-cccc-000000000023"],

Cell[TextData[{
 "The raw integer or symbolic labels written by the user are exposed under a different key, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Hyperedges\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"a0004001-cccc-4001-dddd-000000000030"],
 ". ",
 Cell[BoxData[
  ButtonBox["TensorNetworkIndices",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndices"]],
  "InlineFormula",ExpressionUUID->"a0004002-cccc-4002-dddd-000000000031"],
 " wraps every label in a ",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->
  "a0004003-cccc-4003-dddd-000000000032"],
 " tagged with the tensor position; the hyperedge pool keeps the bare label."
}], "Notes",
 CellID->1529433738,ExpressionUUID->"a0004004-cccc-4004-dddd-000000000033"],

Cell[TextData[{
 "For the graph form, ",
 Cell[BoxData[
  ButtonBox["TensorNetworkIndices",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndices"]],
  "InlineFormula",ExpressionUUID->"a0005001-dddd-4001-eeee-000000000040"],
 " reads the ",
 Cell[BoxData["\"\<Index\>\""], "InlineFormula",ExpressionUUID->"a0005002-dddd-4002-eeee-000000000041"],
 " annotation off each vertex. Labels there are a mix of ",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->
  "a0005003-dddd-4003-eeee-000000000042"],
 " (output legs) and ",
 Cell[BoxData[
  ButtonBox["Subscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Subscript"]], "InlineFormula",ExpressionUUID->
  "a0005004-dddd-4004-eeee-000000000043"],
 " (input legs) reflecting the variance assigned by the acyclic orientation of the graph."
}], "Notes",
 CellID->1529433739,ExpressionUUID->"a0005005-dddd-4005-eeee-000000000044"],

Cell[TextData[{
 "The number of inner lists equals ",
 Cell[BoxData[
  ButtonBox["TensorNetworkSize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkSize"]],
  "InlineFormula",ExpressionUUID->"a0006001-eeee-4001-ffff-000000000050"],
 "[",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->"a0006002-eeee-4002-ffff-000000000051"],
 "]; the length of each inner list equals the rank of the corresponding tensor, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Ranks\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"a0006003-eeee-4003-ffff-000000000052"],
 "."
}], "Notes",
 CellID->1529433740,ExpressionUUID->"a0006004-eeee-4004-ffff-000000000053"]
}, Open  ]],

