Cell[TextData[{
 "The middle vertex carries ",
 Cell[BoxData[
  SubscriptBox["2", "1"]], "InlineFormula",ExpressionUUID->
  "d0002010-cccc-4010-dddd-310000000010"],
 " (the incoming bond from vertex 1) and ",
 Cell[BoxData[
  SuperscriptBox["2", "2"]], "InlineFormula",ExpressionUUID->
  "d0002011-cccc-4011-dddd-310000000011"],
 " (the outgoing bond toward vertex 3). The slot labels are reassigned \
starting from 1 on each vertex; they do not match the original hyperedge \
labels."
}], "ExampleText",
