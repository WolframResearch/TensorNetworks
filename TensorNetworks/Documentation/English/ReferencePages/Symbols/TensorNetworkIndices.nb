Cell[TextData[{
 "When a hyperedge is shared by three or more tensors, ",
 Cell[BoxData[
  ButtonBox["TensorNetworkIndices",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndices"]],
  "InlineFormula",ExpressionUUID->"f1001014-ffff-4014-aaaa-600000000014"],
 " still returns one ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["v", "TI"],
   StyleBox["k", "TI"]]], "InlineFormula",ExpressionUUID->"f1001015-ffff-4015-aaaa-600000000015"],
 " label per leg; the shared label appears in three or more positions of the flattened list. To collapse such hyperedges into pairwise edges with explicit copy tensors, use ",
 Cell[BoxData[
  ButtonBox["BinaryTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetwork"]],
  "InlineFormula",ExpressionUUID->"f1001016-ffff-4016-aaaa-600000000016"],
 "."
}], "ExampleText",
 CellID->620006030,ExpressionUUID->"f1001017-ffff-4017-aaaa-600000000017"]
