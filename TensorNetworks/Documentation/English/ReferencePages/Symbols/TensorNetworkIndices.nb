Cell["A structured network exposes the same per-tensor labeling:", \
"ExampleText",
 CellID->620002002,ExpressionUUID->"d0001003-bbbb-4003-cccc-300000000003"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mps", "=", 
   RowBox[{"RandomTensorNetwork", "[", 
    RowBox[{"\"\<MPS\>\"", "[", 
     RowBox[{"3", ",", "2", ",", "2"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[4]:=",
 CellID->620002003,ExpressionUUID->"d0001004-bbbb-4004-cccc-300000000004"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorNetworkIndices", "[", "mps", "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->620002004,ExpressionUUID->"d0001005-bbbb-4005-cccc-300000000005"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1"},
      "Superscript"], ",", 
     TemplateBox[{"1", "4"},
      "Superscript"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"2", "1"},
      "Superscript"], ",", 
     TemplateBox[{"2", "2"},
      "Superscript"], ",", 
     TemplateBox[{"2", "5"},
      "Superscript"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"3", "2"},
      "Superscript"], ",", 
     TemplateBox[{"3", "6"},
      "Superscript"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[5]=",
 CellID->620002005,ExpressionUUID->"d0001006-bbbb-4006-cccc-300000000006"]
}, Open  ]],

Cell[TextData[{
 "The two boundary tensors have rank 2 (one bond, one physical leg); the bulk \
tensor has rank 3 (two bonds, one physical leg). The slot label ",
 Cell[BoxData[
 "1"], "InlineFormula",ExpressionUUID->"d0001007-bbbb-4007-cccc-300000000007"],
 " is shared by tensors 1 and 2, and label ",
 Cell[BoxData[
 "2"], "InlineFormula",ExpressionUUID->"d0001008-bbbb-4008-cccc-300000000008"],
 " by tensors 2 and 3 -- these are the two MPS bonds. The labels ",
 Cell[BoxData[
  RowBox[{"4", ",", " ", "5", ",", " ", "6"}]], "InlineFormula",
  ExpressionUUID->"d0001009-bbbb-4009-cccc-300000000009"],
 " appear only once and are the physical legs."
}], "ExampleText",
 CellID->620002010,ExpressionUUID->"d0001010-bbbb-4010-cccc-300000000010"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Graph form", "ExampleSubsection",ExpressionUUID->
