Cell[TextData[{
 "The labeling convention depends on the input form. For a ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]],
  "InlineFormula",ExpressionUUID->"f1001001-ffff-4001-aaaa-600000000001"],
 " object every leg is tagged with ",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->
  "f1001002-ffff-4002-aaaa-600000000002"],
 " regardless of bond direction; for a graph produced by ",
 Cell[BoxData[
  ButtonBox["ToTensorNetworkGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]],
  "InlineFormula",ExpressionUUID->"f1001003-ffff-4003-aaaa-600000000003"],
 ", labels mix ",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->
  "f1001004-ffff-4004-aaaa-600000000004"],
 " and ",
 Cell[BoxData[
  ButtonBox["Subscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Subscript"]], "InlineFormula",ExpressionUUID->
  "f1001005-ffff-4005-aaaa-600000000005"],
 " to encode the variance of each leg. The two views are not interchangeable as lookup keys:"
}], "ExampleText",
 CellID->620006001,ExpressionUUID->"f1001006-ffff-4006-aaaa-600000000006"],

