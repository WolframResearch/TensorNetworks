Notebook[{

Cell[CellGroupData[{
Cell["PathIndexContractions", "ObjectName",
 CellID->96265889,ExpressionUUID->"f73f0117-4f93-491c-850a-e07900eb7fd3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9fcbed49-cb1d-4213-975d-764584f5979f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PathIndexContractions",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathIndexContractions"], "[", 
   RowBox[{
    StyleBox["path", "TI"], ",", 
    StyleBox["indices", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a824c7aa-5b8c-47f3-bc49-eef8a56d2f50"],
 "\[LineSeparator]returns the sequence of index sets contracted at each step \
of ",
 Cell[BoxData[
  StyleBox["path", "TI"]], "InlineFormula",ExpressionUUID->
  "116aa332-9f8e-41da-967d-0dff58543683"],
 ", given the per-tensor index lists ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "2de37f15-4516-47c6-8565-6c9f71f34084"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8df7d31c-c9b4-4022-a602-64bf636db537"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PathIndexContractions",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathIndexContractions"], "[", 
   RowBox[{
    StyleBox["path", "TI"], ",", 
    StyleBox["indices", "TI"], ",", 
    StyleBox["contractions", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2f8f79b4-78fc-4bd4-a37d-7e9a8ad59534"],
 "\[LineSeparator]returns the symbolic index sums at each step, mapping the \
integer positions in ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "a24795e8-7897-47b2-be3d-1a5019571966"],
 " back to the labels in ",
 Cell[BoxData[
  StyleBox["contractions", "TI"]], "InlineFormula",ExpressionUUID->
  "9b6e6735-9c8e-4ea3-bed6-dd782e1d307e"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"19efcd42-8798-420e-8c1c-b5d779821f59"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PathIndexContractions",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathIndexContractions"], "[", 
   RowBox[{
    StyleBox["path", "TI"], ",", 
    StyleBox["data", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1f95ef1f-b3e4-41b3-ade9-11a238ab387c"],
 "\[LineSeparator]takes an association with keys ",
 Cell[BoxData["\"\<Indices\>\""], "InlineFormula",ExpressionUUID->
  "b6b8dd2d-21b6-42a0-97ff-9210c457dcd9"],
 " and ",
 Cell[BoxData["\"\<Contractions\>\""], "InlineFormula",ExpressionUUID->
  "225d86d5-0441-43f0-a235-9d803f003b8d"],
 ", such as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Data\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"2c2dfc68-0acb-4574-8995-4fbd5588d3db"],
 "."
}], "Usage",
 CellID->350868027,ExpressionUUID->"b734c8a5-23b2-4925-88ff-aafa540cda91"],

Cell[TextData[{
 "At each path step ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "7bb21550-c6ed-4f23-a6e0-eb8dc46bff1f"],
 ", the function computes the intersection of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["indices", "TI"], "[", 
   RowBox[{"[", 
    StyleBox["i", "TI"], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "06f5f98c-ef54-40a8-874f-5b07e546b66a"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["indices", "TI"], "[", 
   RowBox[{"[", 
    StyleBox["j", "TI"], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "96051bf7-03df-44ea-b2be-0f3045824508"],
 " \[LongDash] the indices that get contracted away at that step \[LongDash] \
and replaces the two tensor entries with the union of their remaining indices."
}], "Notes",
 CellID->485380691,ExpressionUUID->"ba24421a-d1e9-4185-805e-7e8106a2b7c2"],

Cell[TextData[{
 "The result is a list of per-step contraction sets. Each entry is the set of \
indices summed at that step. Outer-product steps (no shared indices) produce \
an empty contraction and are removed from the output, so the result length is \
at most ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Length",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Length"], "[", 
   StyleBox["path", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "47fb1a0c-f9f5-4eff-b367-4e466685c786"],
 "."
}], "Notes",
 CellID->391808238,ExpressionUUID->"5b31e664-6647-4652-b9a5-f0ece18571f6"],

Cell[TextData[{
 "In the 2-argument form, contractions are tracked by integer position within \
each tensor's index list. In the 3-argument form, the additional ",
 Cell[BoxData[
  StyleBox["contractions", "TI"]], "InlineFormula",ExpressionUUID->
  "2556128a-cb70-445b-a485-6e304ad16640"],
 " argument supplies symbolic labels (e.g. bond names) that the integer \
positions are mapped back to, which is useful for tracing each contraction to \
a user-specified index name."
}], "Notes",
 CellID->474963129,ExpressionUUID->"13c4eef2-4000-4f35-8376-5fe667110fd4"],

Cell[TextData[{
 "The association form accepts any value with keys ",
 Cell[BoxData["\"\<Indices\>\""], "InlineFormula",ExpressionUUID->
  "88186bbd-033c-4c1f-bc97-9e4c8e65ca5c"],
 " and ",
 Cell[BoxData["\"\<Contractions\>\""], "InlineFormula",ExpressionUUID->
  "712b5d61-5cae-4824-85a2-90c7e3a18ce6"],
 ", and returns the catenated symbolic contractions. A ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"afaef8f7-e29d-479f-8601-71401899a962"],
 " object exposes such an association via ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Data\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"35a51d36-23ca-495f-b1a5-9117585acaf6"],
 "."
}], "Notes",
 CellID->480064946,ExpressionUUID->"200401d0-0d44-4233-899f-fe65e39d9683"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["PathIndexContractions",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathIndexContractions"]], 
  "InlineFormula",ExpressionUUID->"4859560a-7296-482b-97e8-f5bab5beba85"],
 " is used internally by ",
 Cell[BoxData[
  ButtonBox["ContractionTree",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ContractionTree"]], 
  "InlineFormula",ExpressionUUID->"f5d2e11d-809f-4254-8411-0b9545ce4d1c"],
 " and by cost-estimation utilities that compare contraction paths."
}], "Notes",
 CellID->135647371,ExpressionUUID->"48b6c334-e699-4679-8216-953c4278ad05"],

Cell[TextData[{
 "The length of ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "75139778-7977-40fd-a7c3-2c34c3e486dd"],
 " must equal ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Length",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Length"], "[", 
   StyleBox["path", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "befecf44-eafd-4341-9468-3fe3b6ee41fa"],
 " + 1. A mismatch issues ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["PathIndexContractions",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathIndexContractions"], "::",
    "indlen"}]], "InlineFormula",ExpressionUUID->
  "121ee1ba-4d81-4f45-aaa1-515325ef3523"],
 " and returns ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "04a90114-660d-4931-a598-564ea692f3fb"],
 ". For a network with hyper-edges, use the binarized form: ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["BinaryTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetwork"], "[", 
   StyleBox["tn", "TI"], "]", "[", "\"\<Hyperedges\>\"", "]"}]], 
  "InlineFormula",ExpressionUUID->"28f34b9a-3cb5-412a-b26e-bd55ef4c0e76"],
 "."
}], "Notes",
 CellID->399968130,ExpressionUUID->"43e1df1c-2b8c-44bf-950b-976280c03eb5"]
}, Open  ]],

