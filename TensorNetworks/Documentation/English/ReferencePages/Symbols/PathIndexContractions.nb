      RowBox[{"\"\<b\>\"", ",", " ", "\"\<c\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<c\>\"", ",", " ", "\"\<d\>\""}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
