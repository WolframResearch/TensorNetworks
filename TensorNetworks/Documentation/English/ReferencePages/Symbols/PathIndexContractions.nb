 CellLabel->"In[6]:=",
 CellID->553601913,ExpressionUUID->"fad2f424-0ef6-4ff8-8b5e-2e062e3d45c6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "6"}], "}"}], ",", 
