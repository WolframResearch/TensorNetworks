Cell["\<\
Find the indices contracted at each step of a path with integer index lists:\
\>", "ExampleText",
 CellID->413679692,ExpressionUUID->"8cee95e5-b70a-4ff2-83b1-626a2841c254"],

Cell[BoxData[
 RowBox[{"PathIndexContractions", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->223337487,ExpressionUUID->"bf6b770f-5326-4e47-8388-e58272a64e2a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", "3", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->984669801,ExpressionUUID->"b047a8b6-3def-437d-bd74-c46e04d16cda"],

