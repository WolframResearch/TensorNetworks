Cell[CellGroupData[{
Cell["CanonicalPathQ", "ObjectName",
 CellID->2046147001,ExpressionUUID->"905cd50b-4be1-4a71-95f1-43e1fec758f9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"eeca18a3-15f9-47e6-82b5-24d059a9b7a9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CanonicalPathQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPathQ"], "[",
   StyleBox["path", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "146266be-f882-4af3-ac1a-cf02aee1c648"],
 "\[LineSeparator]yields True if ",
 Cell[BoxData[
  StyleBox["path", "TI"]], "InlineFormula",ExpressionUUID->
  "a1111111-1111-1111-1111-111111111101"],
 " is a list of integer pairs \[LongDash] the canonical opt_einsum form \
\[LongDash] and False otherwise."
}], "Usage",
 CellID->1937006396,ExpressionUUID->"7a622c75-3d2b-4e04-96be-f0b308a703fe"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["CanonicalPathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPathQ"]],
  "InlineFormula",ExpressionUUID->"a1111111-1111-1111-1111-111111111102"],
 " is the stricter sibling of ",
 Cell[BoxData[
  ButtonBox["PathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathQ"]],
  "InlineFormula",ExpressionUUID->"a1111111-1111-1111-1111-111111111103"],
 ". Where ",
 Cell[BoxData[
  ButtonBox["PathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathQ"]],
  "InlineFormula",ExpressionUUID->"a1111111-1111-1111-1111-111111111104"],
 " accepts singletons or pairs, ",
 Cell[BoxData[
  ButtonBox["CanonicalPathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPathQ"]],
  "InlineFormula",ExpressionUUID->"a1111111-1111-1111-1111-111111111105"],
 " requires every step to be a pair ",
 Cell[BoxData[
  RowBox[{"{",
   RowBox[{
    RowBox[{"_", "Integer"}], ",",
    RowBox[{"_", "Integer"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "a1111111-1111-1111-1111-111111111106"],
 "."
}], "Notes",
 CellID->1561892699,ExpressionUUID->"fad8acf9-f145-4097-bc44-b0e09861c72f"],

Cell[TextData[{
 "The canonical form is the output produced by ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]],
  "InlineFormula",ExpressionUUID->"a1111111-1111-1111-1111-111111111107"],
 " and ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]],
  "InlineFormula",ExpressionUUID->"a1111111-1111-1111-1111-111111111108"],
 ". Path-execution routines such as ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]],
  "InlineFormula",ExpressionUUID->"a1111111-1111-1111-1111-111111111109"],
 " and ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
  "InlineFormula",ExpressionUUID->"a1111111-1111-1111-1111-11111111110a"],
 " accept paths satisfying ",
 Cell[BoxData[
  ButtonBox["CanonicalPathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPathQ"]],
  "InlineFormula",ExpressionUUID->"a1111111-1111-1111-1111-11111111110b"],
 " directly."
}], "Notes",
 CellID->2222000001,ExpressionUUID->"a2222222-2222-2222-2222-222222222201"],

Cell[TextData[{
 "The empty list ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "a2222222-2222-2222-2222-222222222202"],
 " is rejected: the underlying pattern requires one or more integer pairs."
}], "Notes",
 CellID->2222000002,ExpressionUUID->"a2222222-2222-2222-2222-222222222203"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  ButtonBox["CanonicalPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPath"]],
  "InlineFormula",ExpressionUUID->"a2222222-2222-2222-2222-222222222204"],
 " to normalize a ",
 Cell[BoxData[
  ButtonBox["PathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathQ"]],
  "InlineFormula",ExpressionUUID->"a2222222-2222-2222-2222-222222222205"],
 "-but-not-",
 Cell[BoxData[
  ButtonBox["CanonicalPathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPathQ"]],
  "InlineFormula",ExpressionUUID->"a2222222-2222-2222-2222-222222222206"],
 " path to the canonical form."
}], "Notes",
 CellID->2222000003,ExpressionUUID->"a2222222-2222-2222-2222-222222222207"]
}, Open  ]],

