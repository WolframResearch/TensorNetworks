 CellLabel->"In[2]:=",
 CellID->598374653,ExpressionUUID->"34567890-1234-5678-abcd-ef1234567903"],

Cell["A path with reversed order is not canonical:", "ExampleText",
 CellID->598374654,ExpressionUUID->"45678901-2345-6789-abcd-ef1234567904"],

Cell[BoxData[
 RowBox[{"nonCanonicalPath", "=",
  RowBox[{"{",
   RowBox[{
    RowBox[{"{",
     RowBox[{"2", ",", "1"}], "}"}], ",",
    RowBox[{"{",
     RowBox[{"4", ",", "3"}], "}"}]}], "}"}]}]], "Input",
 CellLabel->"In[3]:=",
 CellID->598374655,ExpressionUUID->"56789012-3456-7890-abcd-ef1234567905"],

