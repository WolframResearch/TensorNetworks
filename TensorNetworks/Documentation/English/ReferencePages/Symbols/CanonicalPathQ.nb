Cell["Check if a contraction path is in canonical form:", "ExampleText",
 CellID->598374651,ExpressionUUID->"12345678-9012-3456-abcd-ef1234567901"],

Cell[BoxData[
 RowBox[{"canonicalPath", "=",
  RowBox[{"{",
   RowBox[{
    RowBox[{"{",
     RowBox[{"1", ",", "2"}], "}"}], ",",
    RowBox[{"{",
     RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:=",
