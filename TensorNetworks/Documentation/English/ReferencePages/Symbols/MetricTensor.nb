Cell[CellGroupData[{
Cell["MetricTensor", "ObjectName",ExpressionUUID->"9feafcac-8cd3-4a94-ae83-b4aa6a52b046"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"eec24153-37ba-45d9-b649-7597dc7a7054"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MetricTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/MetricTensor"], "[", 
   StyleBox["name", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "732049d7-9005-4de7-878b-34fffa7820a7"],
 "\[LineSeparator]returns a built-in metric tensor by name, e.g. \
\"Euclidean\", \"Minkowski\", \"Schwarzschild\", \"Kerr\", \"FLRW\". \
\[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"9278f101-970c-430f-85bf-70ee23ebf9a3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MetricTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/MetricTensor"], "[", 
   RowBox[{
    StyleBox["matrix", "TI"], ",", 
    StyleBox["coords", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "96f21df5-5829-4333-8d36-068921431c84"],
 "\[LineSeparator]constructs a metric from an explicit matrix and coordinate \
list. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a31c9924-15b6-43b6-b19c-967b09a0925b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MetricTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/MetricTensor"], "[", "]"}]],
   "InlineFormula",ExpressionUUID->"0a3f4926-07cc-4996-8bbb-e5522b467086"],
 "\[LineSeparator]returns the list of available built-in metric names."
}], "Usage",
 CellID->2003795485,ExpressionUUID->"0e738703-0d30-4a89-9adf-78949de63d5a"],

