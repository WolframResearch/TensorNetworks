Cell[CellGroupData[{
Cell["RandomTensorNetwork", "ObjectName",
 CellID->1315828927,ExpressionUUID->"d40e9107-59c5-44fb-b47e-de5f7fbc921d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"36416cd5-e702-4016-888d-6b2a91345370"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/RandomTensorNetwork"], "[", 
   
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["n", "TI"], ",", 
      StyleBox["m", "TI"]}], "}"}], ",", 
    StyleBox["maxDim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "563af883-70e2-401a-8e5a-b78e0288282b"],
 "\[LineSeparator]creates a random tensor network based on RandomGraph[{n,m}] \
with dimensions up to ",
 Cell[BoxData[
  StyleBox["maxDim", "TI"]], "InlineFormula",ExpressionUUID->
  "1a2042fa-1e72-435b-a7d7-57e464499315"],
 ". \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"3d4d994b-52b6-4c22-9577-a9ab2dea3c76"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/RandomTensorNetwork"], "[", 
   
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["n", "TI"], ",", 
      StyleBox["m", "TI"]}], "}"}], ",", 
    RowBox[{"{", 
     StyleBox["dim", "TI"], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5c1598bd-bfb4-4a19-aa64-cf6d36f49f8c"],
 "\[LineSeparator]uses fixed dimension dim for all indices. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f4ea398a-6728-46cf-8bc1-79e24afe5c8d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/RandomTensorNetwork"], "[", 
   
   RowBox[{
    StyleBox["graph", "TI"], ",", 
    StyleBox["maxDim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3599ef16-b0d4-460f-89f2-4ebfc4e0f31f"],
 "\[LineSeparator]creates a tensor network from the specified ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "5c978ca8-c9b3-41dd-b3aa-9f918f5a29a2"],
 ". \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"cc31b5f7-ff4e-46ee-8c5a-7fb8db76303d"],
 "RandomTensorNetwork[\"MPS\"[length,bondDim,physicalDim]\[LineSeparator]] \
creates a Matrix ",
 Cell[BoxData[
  ButtonBox["Product",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "914950c9-ae44-4549-95ac-27fe84c3209d"],
 " State. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a9c8d97f-5a5d-4603-994f-6105b1c53747"],
 "RandomTensorNetwork[\"TT\"[length,bondDim]\[LineSeparator]] creates a \
Tensor Train (no physical indices). \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ac3533e9-ec44-4682-903d-f18f6232d103"],
 "RandomTensorNetwork[\"MPO\"[length,bondDim,physicalDim]\[LineSeparator]] \
creates a Matrix ",
 Cell[BoxData[
  ButtonBox["Product",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "40c15777-ad01-4f0d-ba9e-56e898c810ec"],
 " Operator. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e7343fe0-5e3a-4b12-9f43-27fb883fa9bb"],
 "RandomTensorNetwork[\"PEPS\"[{rows,cols},bondDim,physicalDim]\
\[LineSeparator]] creates a Projected Entangled Pair State. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e93a6df8-7360-4a48-bc51-0310a9922fbd"],
 "RandomTensorNetwork[\"TTN\"[depth,bondDim,branching]\[LineSeparator]] \
creates a ",
 Cell[BoxData[
  ButtonBox["Tree",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "ca40a5c2-b54c-4d60-9a5f-eb3ecaaffe2b"],
 " Tensor Network. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"0e87e258-7ea7-4afb-ae47-2bfbbea42e20"],
 "RandomTensorNetwork[\"MERA\"[width,bondDim,layers]\[LineSeparator]] creates \
a Multi-scale Entanglement Renormalization Ansatz."
}], "Usage",
