Cell["\<\
A randomly generated graph can be disconnected; the resulting tensor network \
factorizes accordingly:\
\>", "ExampleText",
 CellID->483411904,ExpressionUUID->"7f25057e-582e-48b3-85fe-58d3620dbd90"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", "=", 
     RowBox[{"RandomGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "2"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"TensorNetwork", "[", "g", "]"}], ",", 
     RowBox[{"ConnectedGraphQ", "[", "g", "]"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.988135443281665*^9, 3.98813546535602*^9}},
 CellLabel->"In[48]:=",
 CellID->432672764,ExpressionUUID->"04836f66-8603-4a8d-82d3-04f579fbc9d6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"TensorNetwork", "[", 
    GraphicsBox[
     NamespaceBox["NetworkGraphics",
      DynamicModuleBox[{Typeset`graph = HoldComplete[
        Graph[{1, 2, 3, 4}, {Null, 
          SparseArray[
          Automatic, {4, 4}, 0, {
           1, {{0, 1, 2, 3, 4}, {{2}, {1}, {4}, {3}}}, Pattern}]}]]}, 
       TagBox[
        GraphicsGroupBox[
         GraphicsComplexBox[{{1.12501, -0.12501}, {
