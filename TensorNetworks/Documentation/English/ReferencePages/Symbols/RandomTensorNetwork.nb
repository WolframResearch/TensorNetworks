Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"BlockRandom", "[", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "15", "]"}], ";", " ", 
       RowBox[{"RandomTensorNetwork", "[", "#1", "]"}]}], "]"}], 
     "[", "\"\<BinaryQ\>\"", "]"}], " ", "&"}], " ", ")"}], " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<MPS\>\"", "[", 
     RowBox[{"4", ",", " ", "2", ",", " ", "2"}], "]"}], ",", " ", 
    RowBox[{"\"\<TT\>\"", "[", 
     RowBox[{"4", ",", " ", "2"}], "]"}], ",", " ", 
