     "f1e36dbe-0fb2-4e69-bb13-22ddaf1adfdc"], "\"\<Boundary\>\"", "\"\<Open\>\
\"", Cell["\<\
for chain topologies (MPS, TT, MPO), choose \"Open\" or \"Periodic\"\
\>", "TableText",ExpressionUUID->"e24484f4-2283-48c5-beef-e77dcdcb9648"]}
  }]], "3ColumnTableMod",
 CellID->172581409,ExpressionUUID->"39f6b4e8-7c62-4a29-bf33-288d4e9f84da"]
}, Open  ]],

