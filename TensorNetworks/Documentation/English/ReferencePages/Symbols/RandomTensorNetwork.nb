Cell[CellGroupData[{
Cell["RandomTensorNetwork", "ObjectName",
 CellID->323675147,ExpressionUUID->"6fad7d1d-62aa-4e53-a020-21ff29bcc4dd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"835ff2c6-ae89-469c-9de7-62866c91bbbe"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["n", "TI"], ",", 
      StyleBox["m", "TI"]}], "}"}], ",", 
    StyleBox["maxDim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fbad3337-9d7b-4578-a3b7-199d2c34b0f4"],
 "\[LineSeparator]",
 "creates a random tensor network with graph ",
 Cell[BoxData[
  RowBox[{"RandomGraph", "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["n", "TI"], ",", 
     StyleBox["m", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "1234e258-b7d2-4549-8f20-4825f6a56bc2"],
 " and bond dimensions up to ",
 Cell[BoxData[
  StyleBox["maxDim", "TI"]], "InlineFormula",ExpressionUUID->
  "4d6ce308-9ee4-40e5-85fc-91ba15dd87b5"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6b335b11-1931-43d3-a06e-ee06de13834b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", 
    StyleBox["maxDim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1434fa48-15ab-4ac2-8bc1-6fafb6db8a78"],
 "\[LineSeparator]",
 "uses an arbitrary ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "6fd0370c-7daf-412e-9c10-232e12339abf"],
 " and samples each bond dimension from ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", 
    StyleBox["maxDim", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "a21dcbad-5a30-4aee-9c30-16662584ad0f"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"65693d15-a221-4038-9cbf-a64b0cb72df6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", 
    RowBox[{"{", 
     StyleBox["dim", "TI"], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "72461cf7-2ec6-485a-bd30-97e49de3e0a1"],
 "\[LineSeparator]",
 "makes every bond dimension exactly ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",ExpressionUUID->
  "5a718580-7a6b-4dca-9868-0438cab4cc04"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7fd119d8-fb2a-477d-b53b-f8d2c821d547"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", 
    StyleBox["dim", "TI"], ",", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "80e15902-8539-4190-aa6b-43855a35475f"],
 "\[LineSeparator]",
 "adds up to ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",ExpressionUUID->
  "f6999b92-de25-4d30-9731-bbb93378ea0a"],
 " free legs per vertex on top of its degree.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e73ae13d-ae37-4f11-87b3-0fdace1d200a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"], "[", 
   RowBox[{"\"\<MPS\>\"", "[", 
    RowBox[{
     StyleBox["n", "TI"], ",", 
     StyleBox["\[Chi]", "TI"], ",", 
     StyleBox["d", "TI"]}], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "e05c0b8e-84d1-4bf6-a2c9-0ecfad66f777"],
 "\[LineSeparator]",
 "creates a random Matrix Product State of length ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "a34d31d9-0936-458a-b1a1-ee656df6bd4b"],
 ", bond dimension ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",ExpressionUUID->
  "1d89b011-c03e-4a81-8a93-4be06113bc88"],
 " and physical dimension ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "076cd81c-260f-4b40-b147-0a4200275eff"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"dfe78ebb-0998-4500-abf0-f9503117228f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"], "[", 
   RowBox[{"\"\<TT\>\"", "[", 
    RowBox[{
     StyleBox["n", "TI"], ",", 
     StyleBox["\[Chi]", "TI"]}], "]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"635897b4-24b7-456e-95df-34da9b6b967e"],
 "\[LineSeparator]",
 "creates a Tensor Train of length ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "320c2e5a-2c9b-4a00-8b43-9c88e2a206e3"],
 " and bond dimension ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",ExpressionUUID->
  "c01c44cd-5a94-4fe9-8eff-4203e3da9a4f"],
 " (no physical legs).",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5a8ed9f5-7c27-4f80-a49e-39baba94b22e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"], "[", 
   RowBox[{"\"\<MPO\>\"", "[", 
    RowBox[{
     StyleBox["n", "TI"], ",", 
     StyleBox["\[Chi]", "TI"], ",", 
     StyleBox["d", "TI"]}], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "25eff35b-3341-46fc-bcac-051dcfaa3938"],
 "\[LineSeparator]",
 "creates a random Matrix Product Operator of length ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "762041d2-8249-4bbc-a24a-b6ba28298036"],
 " with bond dimension ",
 Cell[BoxData[
  StyleBox["\[Chi]", "TI"]], "InlineFormula",ExpressionUUID->
  "1ac7ef6c-a330-451b-9d45-dbc2997e0ea7"],
 " and physical dimension ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "fb7b8a51-6e78-426d-9fa6-8b7dd25c42fa"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"50a1967f-e459-4e12-8d28-d90512ff14be"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"], "[", 
   RowBox[{"\"\<PEPS\>\"", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["rows", "TI"], ",", 
       StyleBox["cols", "TI"]}], "}"}], ",", 
     StyleBox["\[Chi]", "TI"], ",", 
     StyleBox["d", "TI"]}], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "e39aa791-5a0d-438e-ab8a-72a0ec6904de"],
 "\[LineSeparator]",
 "creates a Projected Entangled Pair State on a ",
 Cell[BoxData[
  RowBox[{
   StyleBox["rows", "TI"], "\[Times]", 
   StyleBox["cols", "TI"]}]], "InlineFormula",ExpressionUUID->
  "584f1e68-5f2f-4c0f-bbe5-4c01ea1cfd2a"],
 " grid.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3749b88a-402b-4bb9-bc8c-14da5278c4f4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"], "[", 
   RowBox[{"\"\<TTN\>\"", "[", 
    RowBox[{
     StyleBox["depth", "TI"], ",", 
     StyleBox["\[Chi]", "TI"], ",", 
     StyleBox["b", "TI"]}], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "d6dda7a6-1dc5-446a-b950-31ec8c52fb74"],
 "\[LineSeparator]",
 "creates a Tree Tensor Network of binary depth ",
 Cell[BoxData[
  StyleBox["depth", "TI"]], "InlineFormula",ExpressionUUID->
  "286290ad-f0a1-40a3-a09b-91fc64e902e2"],
 " with branching factor ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula",ExpressionUUID->
  "562d2464-20ed-432e-a3b3-3a0b65c4a00d"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f5b32c65-f6cb-4b77-9d50-4f6f117b0ca7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"], "[", 
   RowBox[{"\"\<MERA\>\"", "[", 
    RowBox[{
     StyleBox["w", "TI"], ",", 
     StyleBox["\[Chi]", "TI"], ",", 
     StyleBox["L", "TI"]}], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "2d70a119-49fd-48e0-b7d2-e9d88eb7e6fd"],
 "\[LineSeparator]",
 "creates a Multi-scale Entanglement Renormalization Ansatz of width ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",ExpressionUUID->
  "b84f75d3-c0c5-46ed-aa5d-9e2c57e1ee09"],
 " and ",
 Cell[BoxData[
  StyleBox["L", "TI"]], "InlineFormula",ExpressionUUID->
  "4d5f97a4-1a7c-49b7-8492-c2834853651f"],
 " coarse-graining layers."
}], "Usage",
 CellID->511957263,ExpressionUUID->"4b01e8c1-5b5d-421f-b924-3250dbc8de09"],

Cell[TextData[{
 "The result of ",
 Cell[BoxData[
  ButtonBox["RandomTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"65cc38c0-13f0-4a7a-b68d-fd3dc441a877"],
 " is a ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"05f1bf8d-6160-42d2-b64f-73c059d8edf5"],
 " object; all its property accessors apply (",
 Cell[BoxData["\"\<Tensors\>\""], "InlineFormula",ExpressionUUID->
  "178fa1a1-c711-47a4-83d9-9ee7c99468ac"],
 ", ",
 Cell[BoxData["\"\<Hyperedges\>\""], "InlineFormula",ExpressionUUID->
  "356755ad-ea1c-4d6d-929f-544e48b74b13"],
 ", ",
 Cell[BoxData["\"\<FreeIndices\>\""], "InlineFormula",ExpressionUUID->
  "99c0967b-6043-48b7-8c09-5f135170f01b"],
 ", ",
 Cell[BoxData["\"\<Bonds\>\""], "InlineFormula",ExpressionUUID->
  "2289455d-66d1-4813-b861-98be2295d757"],
 ", \[Ellipsis])."
}], "Notes",
 CellID->223337487,ExpressionUUID->"179ac1e3-b7a9-44d4-a9e5-601005a08912"],

Cell[TextData[{
 "For the general graph form, the rank of each vertex is sampled uniformly \
from ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"VertexDegree", "["}], 
    StyleBox["v", "TI"], "]", ",", 
    RowBox[{"VertexDegree", "["}], 
    StyleBox["v", "TI"], "]", "+", 
    StyleBox["r", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "c6843ec3-d2b7-4bea-b154-481eedf7fec7"],
 "; the extra legs are free indices of the resulting network."
}], "Notes",
 CellID->984669801,ExpressionUUID->"27f88cb5-52b8-4505-875d-e5a89ebbe8a2"],

Cell[TextData[{
 "Free leg dimensions match bond dimensions: with the ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["dim", "TI"], "}"}]], "InlineFormula",ExpressionUUID->
  "0e4fca57-8ac5-44aa-8382-30710d11d5d3"],
 " form every index has dimension ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",ExpressionUUID->
  "66fba665-10f7-408f-a1ea-beb0284c4b8a"],
 "; with the ",
 Cell[BoxData[
  StyleBox["maxDim", "TI"]], "InlineFormula",ExpressionUUID->
  "a94c5c02-511f-44fa-b8ff-31f29ba3288e"],
 " form every index dimension is an independent random integer in ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", 
    StyleBox["maxDim", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "2b08c827-3cc4-4dc2-91a0-ac589aef60e0"],
 "."
}], "Notes",
 CellID->685904443,ExpressionUUID->"f6320c4d-dc93-475e-be80-4b88742fdb3e"],

Cell[TextData[{
 "For named topologies the indices are integer labels assigned in a fixed, \
predictable layout. For an MPS of length ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "6b428b44-696d-4f50-a4dc-723bd66894dc"],
 ", bond indices use ",
 Cell[BoxData[
  RowBox[{"1", ",", "\[Ellipsis]", ",", 
   RowBox[{
    StyleBox["n", "TI"], "-", "1"}]}]], "InlineFormula",ExpressionUUID->
  "d94a272d-e770-4d54-a863-4c320f451428"],
 " and physical indices use ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["n", "TI"], "+", "1"}], ",", "\[Ellipsis]", ",", 
   RowBox[{"2", 
    StyleBox["n", "TI"]}]}]], "InlineFormula",ExpressionUUID->
  "91e53e28-5c00-460a-b12e-63808142d28f"],
 "."
}], "Notes",
 CellID->309493800,ExpressionUUID->"37831d77-08be-4780-a964-6254076e692e"],

Cell[TextData[{
 "For an MPO of length ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "0958f8aa-59df-4f67-bbb0-9978bc0ed913"],
 ", physical input indices start at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "aa725820-bd52-4876-89ad-da0b20294aba"],
 " and physical output indices at ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"2", 
    StyleBox["n", "TI"]}], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "27f65508-e085-4d99-9e80-56f76362a1c1"],
 "; this leaves the bulk bond labels ",
 Cell[BoxData[
  RowBox[{"1", ",", "\[Ellipsis]", ",", 
   RowBox[{
    StyleBox["n", "TI"], "-", "1"}]}]], "InlineFormula",ExpressionUUID->
  "0c1c0fc2-44f1-4de4-bdb5-2c71365a940a"],
 " untouched."
}], "Notes",
 CellID->571753287,ExpressionUUID->"f6ede094-4856-42f1-a28f-95fb862bd5f9"],

Cell[TextData[{
 "The scalar-arguments form ",
 Cell[BoxData[
  RowBox[{"\"\<PEPS\>\"", "[", 
   RowBox[{
    StyleBox["rows", "TI"], ",", 
    StyleBox["cols", "TI"], ",", 
    StyleBox["\[Chi]", "TI"], ",", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5bd24b4b-3352-4f39-bfa9-ab3c5a55f310"],
 " is equivalent to the list-arguments form ",
 Cell[BoxData[
  RowBox[{"\"\<PEPS\>\"", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["rows", "TI"], ",", 
      StyleBox["cols", "TI"]}], "}"}], ",", 
    StyleBox["\[Chi]", "TI"], ",", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c3a06de3-dfbb-41ce-a7e4-91cb85123864"],
 "."
}], "Notes",
 CellID->40550656,ExpressionUUID->"b663d135-22a5-428f-932e-d24013b44698"],

Cell[TextData[{
 "Tensor entries are independent draws from a uniform distribution on ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"-", "1"}], ",", "1"}], "}"}]], "InlineFormula",ExpressionUUID->
  "f6326fb1-6380-48fc-b050-8ce336da8cba"],
 " (real) or on a complex square of side ",
 Cell[BoxData[
 "2"], "InlineFormula",ExpressionUUID->"988ca1d8-18c4-4059-be19-669e1d460a4b"],
 " centered at the origin (",
 Cell[BoxData["\"\<Complex\>\""], "InlineFormula",ExpressionUUID->
  "e3f1683f-20df-49a4-83f6-e3124a109e88"],
 "). The state is not normalized."
}], "Notes",
 CellID->924238015,ExpressionUUID->"17e499d8-59e2-4197-9ded-ed06080feaf3"],

Cell["The following options can be given: ", "Notes",
 CellID->320579364,ExpressionUUID->"ad50cb28-3de7-445f-8e48-4eabaa207d07"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "381c10c5-7b67-4d39-84e2-450f24e886a6"], 
    ButtonBox["Method",
