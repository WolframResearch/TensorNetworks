     RowBox[{"SeedRandom", "[", "17", "]"}], ";", " ", 
     RowBox[{"RandomTensorNetwork", "[", 
      RowBox[{
       RowBox[{"\"\<PEPS\>\"", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "2"}], "}"}], ",", " ", "2", ",", " ", "2"}],
         "]"}], ",", " ", 
       RowBox[{"\"\<Boundary\>\"", " ", "->", " ", "\"\<Periodic\>\""}]}], 
      "]"}]}], "]"}], "[", "\"\<Hyperedges\>\"", "]"}], " ", "===", " ", 
  RowBox[{
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "17", "]"}], ";", " ", 
     RowBox[{"RandomTensorNetwork", "[", 
      RowBox[{"\"\<PEPS\>\"", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}], ",", " ", "2", ",", " ", "2"}], 
       "]"}], "]"}]}], "]"}], "[", "\"\<Hyperedges\>\"", "]"}]}]], "Input",
