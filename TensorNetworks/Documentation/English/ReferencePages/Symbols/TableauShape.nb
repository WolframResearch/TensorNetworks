     RowBox[{"5", ",", " ", "3", ",", " ", "2"}], "}"}], "]"}], "]"}], " ", "===",
   " ", 
  RowBox[{"{", 
   RowBox[{"5", ",", " ", "3", ",", " ", "2"}], "}"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->153749453,ExpressionUUID->"fa0bec43-46f3-4329-8419-29419cd4f4c5"],

