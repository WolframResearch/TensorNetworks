Cell["\<\
TableauShape composed with the partition-form constructor of YoungTableau is \
the identity on valid partitions:\
\>", "ExampleText",
 CellID->833297435,ExpressionUUID->"3bb5b68f-b13e-4eee-9e29-cdce892b7439"],

Cell[BoxData[
 RowBox[{
