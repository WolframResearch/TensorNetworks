Cell[CellGroupData[{

Cell["Non-tableau input", "ExampleSubsection",
 CellID->901776430,ExpressionUUID->"888d1b1e-62e3-4dff-91c6-3db7766988ea"],

Cell["\<\
A bare list of lists is not a YoungTableau; the function issues a message and \
returns $Failed:\
\>", "ExampleText",
 CellID->664136013,ExpressionUUID->"935d2271-df2b-441f-ae53-bbbc48828656"],

Cell[BoxData[
 RowBox[{"TableauShape", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"{", "3", "}"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->597503020,ExpressionUUID->"5947dd3c-2498-403f-a4db-bc98872977bf"],

Cell[BoxData["$Failed"], "Output",
