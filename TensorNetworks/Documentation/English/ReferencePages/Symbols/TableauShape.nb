Notebook[{

Cell[CellGroupData[{
Cell["TableauShape", "ObjectName",
 CellID->223337487,ExpressionUUID->"284db63b-666e-4058-8534-5d953c13e183"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"31477a18-48c2-470a-ac50-4b02515cf381"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauShape",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"], "[", 
   StyleBox["tableau", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "60b1ef47-a24d-4152-9fa2-72c51fa45eab"],
 "\[LineSeparator]returns the partition (list of row lengths) of a Young \
tableau."
}], "Usage",
 CellID->984669801,ExpressionUUID->"32027eec-898f-4758-a32a-e28da999c340"],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Length",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Length"], "/@", 
   StyleBox["rows", "TI"]}]], "InlineFormula",ExpressionUUID->
  "d4715f09-c382-4db0-bb98-1a744d76fc88"],
 " where ",
 Cell[BoxData[
  StyleBox["rows", "TI"]], "InlineFormula",ExpressionUUID->
  "f35ad8ec-512c-467a-b406-f6cbb0ab0b26"],
 " is the row data of the input ",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"cf617751-1c8c-410b-adba-f54dd918d410"],
 "."
}], "Notes",
 CellID->685904443,ExpressionUUID->"7483accb-24a3-43e0-9cb6-fea6319c4f47"],

Cell[TextData[{
 "The returned list always satisfies ",
 Cell[BoxData[
  ButtonBox["PartitionQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PartitionQ"]], 
  "InlineFormula",ExpressionUUID->"1ee45439-7806-4411-a2b4-c0b7a49502f0"],
 " (non-increasing positive integers); validity of the input is guaranteed by \
the ",
 Cell[BoxData[
  ButtonBox["YoungTableauQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableauQ"]], 
  "InlineFormula",ExpressionUUID->"008e8044-a5c5-43af-a8d5-93d339aa4035"],
 " check on the argument."
}], "Notes",
 CellID->309493800,ExpressionUUID->"8705b5f1-b318-4414-a189-16f5afeba829"],

Cell[TextData[{
 "The total of the shape equals the size: ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Total",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Total"], "[", 
   ButtonBox["TableauShape",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"], "[", 
   StyleBox["yt", "TI"], "]", "]"}]], "InlineFormula",ExpressionUUID->
  "4ee6239b-ffc5-4fed-87b3-43bb29e91332"],
 " == ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauSize",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauSize"], "[", 
   StyleBox["yt", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2bc65388-fdc2-4d31-9752-8929d78164e3"],
 "."
}], "Notes",
 CellID->571753287,ExpressionUUID->"4fea5355-9b99-492b-a65a-98b4304843a3"],

Cell[TextData[{
 "The conjugate (transpose) partition is given by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TransposePartition",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TransposePartition"], "[", 
   
   ButtonBox["TableauShape",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"], "[", 
   StyleBox["yt", "TI"], "]", "]"}]], "InlineFormula",ExpressionUUID->
  "6280183a-3efb-4210-ae04-8eb405ea33d8"],
 ", which records the column lengths of the Young diagram."
}], "Notes",
 CellID->40550656,ExpressionUUID->"31d6d544-c769-4ba3-b8b4-51b92a13d8ac"],

Cell[TextData[{
 "The irrep dimension ",
 Cell[BoxData[
  ButtonBox["TableauDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"]], 
  "InlineFormula",ExpressionUUID->"ae3855c9-5785-4566-8e89-8a2cae2e024c"],
 " depends only on the shape, so two tableaux with the same ",
 Cell[BoxData[
  ButtonBox["TableauShape",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"]], 
  "InlineFormula",ExpressionUUID->"7653a8ec-3a97-4426-9b14-5a0ead6db597"],
 " always carry the same irreducible representation of the symmetric group."
}], "Notes",
 CellID->924238015,ExpressionUUID->"10863066-6def-4fa0-aa75-599cf33dd043"],

Cell[TextData[{
 "Non-",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"0d800b7a-5f3b-4ca6-a877-764a581955d0"],
 " input issues ",
 Cell[BoxData[
  RowBox[{"TableauShape", "::", "noyt"}]], "InlineFormula",ExpressionUUID->
  "81ec27f7-c5d0-4224-9944-ee95a8042487"],
 " and returns ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "48dfa8be-a5df-4e5c-8b8b-a6310b337e3d"],
 "."
}], "Notes",
 CellID->320579364,ExpressionUUID->"225937b0-9444-4aa5-8301-3144ad291e3e"]
}, Open  ]],

