Cell[CellGroupData[{

Cell["Conjugate partition via TransposePartition", "ExampleSubsection",
 CellID->33497448,ExpressionUUID->"b969ca05-4532-47d7-a70c-31635d0f16a8"],

Cell["\<\
Transposing the shape produces the column lengths of the Young diagram:\
\>", "ExampleText",
 CellID->612310210,ExpressionUUID->"71a8045e-ae61-477a-b152-b45fbee07eb8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransposePartition", "[", 
  RowBox[{"TableauShape", "[", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{"4", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}], "]"}], 
