Cell[TextData[{
 "Hand a contracted tensor network to a downstream ",
 Cell[BoxData[
  ButtonBox["NetGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NetGraph"]], "InlineFormula",ExpressionUUID->
  "57cfbd0b-7945-4535-9133-d189d799ae36"],
 " pipeline. Inspect the output-port shape of the converted network:"
}], "ExampleText",
 CellID->300000002,ExpressionUUID->"ef792560-65e0-4526-b4ad-06538ecf015d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "42", "]"}], ";", " ", 
   RowBox[{"g", " ", "=", " ", 
    RowBox[{"ToTensorNetworkGraph", "[", 
     RowBox[{"RandomTensorNetwork", "[", 
      RowBox[{"\"\<MPS\>\"", "[", 
       RowBox[{"3", ",", " ", "2", ",", " ", "2"}], "]"}], "]"}], "]"}]}], ";",
    " ", 
   RowBox[{"netGraph", " ", "=", " ", 
    RowBox[{"TensorNetworkToNetGraph", "[", "g", "]"}]}], ";"}], 
  " "}]], "Input",
 CellLabel->"In[1]:=",
 CellID->300000003,ExpressionUUID->"78735b20-9941-445c-aab1-bdfb33622426"],

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"netGraph", ",", " ", "\"\<OutputPortNames\>\""}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->300000004,ExpressionUUID->"b2a64a68-d965-4112-90c3-03ee7f238550"],

Cell[BoxData[
 RowBox[{"{", "\<\"Output\"\>", "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->300000005,ExpressionUUID->"c4e52520-c2f0-4335-b652-5f087d6cb93d"],

Cell[TextData[{
 "The resulting object can be extended with additional layers (for example a ",
 Cell[BoxData[
  ButtonBox["NetTrain",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NetTrain"]], "InlineFormula",ExpressionUUID->
  "10107bf6-69e4-4b40-b92f-3de288fc7b5d"],
 "-able regression head) or used to export the tensor-network structure to \
other ML frameworks via the standard ",
 Cell[BoxData[
  ButtonBox["NetGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NetGraph"]], "InlineFormula",ExpressionUUID->
  "b483ff09-5d91-4505-a2e4-92f1748d3ec9"],
 " export utilities."
}], "ExampleText",
 CellID->300000006,ExpressionUUID->"62e9b837-4780-4537-b93e-2c3c824b0a33"]
}, Open  ]],

