Notebook[{

Cell[CellGroupData[{
Cell["TensorNetworkToNetGraph", "ObjectName",
 CellID->402315044,ExpressionUUID->"643299e7-c521-48d7-af28-2250908fe8fb"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3e900116-257e-4b50-a232-82af0fa087e7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkToNetGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkToNetGraph"], 
   "[", 
   StyleBox["net", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "dd3364d4-c36d-43f2-bb29-229ef1e3fd60"],
 "\[LineSeparator]converts the tensor-network graph ",
 Cell[BoxData[
  StyleBox["net", "TI"]], "InlineFormula",ExpressionUUID->
  "4806134e-24f3-4679-b587-65cfc2de529a"],
 " into a Wolfram Neural ",
 Cell[BoxData[
  ButtonBox["NetGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NetGraph"]], "InlineFormula",ExpressionUUID->
  "b475cdc7-fe9f-4fe0-bf4c-ce04466ec49b"],
 ", using ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"e8a1d26e-a2e1-4adb-899e-4807a4cd4d0e"],
 " to choose the contraction order.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ba57ed07-435b-4129-97d0-b31da7cc3bd1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkToNetGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkToNetGraph"], 
   "[", 
   RowBox[{
    StyleBox["net", "TI"], ",", 
    StyleBox["path", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0a487a28-24f7-429d-8a62-01da45ed8aa6"],
 "\[LineSeparator]uses the explicit contraction ",
 Cell[BoxData[
  StyleBox["path", "TI"]], "InlineFormula",ExpressionUUID->
  "9997a771-7062-44f9-b2d6-111ed042320e"],
 "."
}], "Usage",
 CellID->1430423752,ExpressionUUID->"b7e1ae50-9120-4495-b25b-20999cb31c1a"],

Cell[TextData[{
 "The result is a ",
 Cell[BoxData[
  ButtonBox["NetGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NetGraph"]], "InlineFormula",ExpressionUUID->
  "97853f0b-1a87-433a-9942-f9a00f3bb2dc"],
 " object. Each pairwise contraction step in ",
 Cell[BoxData[
  StyleBox["path", "TI"]], "InlineFormula",ExpressionUUID->
  "c9ff1f77-a528-4ee5-9847-b1e17fdaf844"],
 " is realized as a sub-network of ",
 Cell[BoxData[
  ButtonBox["TransposeLayer",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TransposeLayer"]], "InlineFormula",ExpressionUUID->
  "4dedb3d4-a678-4ab3-8df4-754650e06fdf"],
 " + ",
 Cell[BoxData[
  ButtonBox["ReshapeLayer",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ReshapeLayer"]], "InlineFormula",ExpressionUUID->
  "49b6e792-ae8f-44c1-b826-7ff9a93813c3"],
 " + ",
 Cell[BoxData[
  ButtonBox["DotLayer",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/DotLayer"]], "InlineFormula",ExpressionUUID->
  "bab06c7e-12e4-43c1-8fb9-073918dbf2e0"],
 " that performs the contraction as a matrix multiplication."
}], "Notes",
 CellID->100000001,ExpressionUUID->"ce00e650-b747-4f82-9585-d4946a5f93a8"],

Cell[TextData[{
 "Numeric tensors are wrapped in ",
 Cell[BoxData[
  ButtonBox["NumericArray",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NumericArray"]], "InlineFormula",ExpressionUUID->
  "69cc265b-ef7c-45d8-abf3-d4fd808477d0"],
 " inside ",
 Cell[BoxData[
  ButtonBox["NetArrayLayer",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NetArrayLayer"]], "InlineFormula",ExpressionUUID->
  "8e412e1f-a0e6-476d-833b-f87be5728c62"],
 " nodes after passing through ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Chop",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Chop"], " ", "\[SmallCircle]", " ", 
   ButtonBox["FullSimplify",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/FullSimplify"], " ", "\[SmallCircle]", " ", 
   ButtonBox["N",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/N"], " ", "\[SmallCircle]", " ", 
   ButtonBox["Normal",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Normal"]}]], "InlineFormula",ExpressionUUID->
  "6bcc600d-e7f7-41d5-ad6e-6b71c07477db"],
 "."
}], "Notes",
 CellID->100000002,ExpressionUUID->"19199c88-3d51-46cc-8359-94d051954b9d"],

Cell[TextData[{
 "Tensors containing symbolic elements (free symbols at the entry level) are \
translated into a ",
 Cell[BoxData[
  ButtonBox["FunctionLayer",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/FunctionLayer"]], "InlineFormula",ExpressionUUID->
  "16ae71da-de44-4706-a221-ae5e6fb569b5"],
 " that exposes those symbols as named input ports of the resulting ",
 Cell[BoxData[
  ButtonBox["NetGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NetGraph"]], "InlineFormula",ExpressionUUID->
  "15b339f5-5629-4c72-9db4-f5683d8c1ca7"],
 "; supplying numeric values for those ports evaluates the contraction."
}], "Notes",
 CellID->100000003,ExpressionUUID->"cc08e426-08b4-4276-b62d-7a5e142c970a"],

Cell[TextData[{
 "The intermediate output of each contraction step is labelled ",
 Cell[BoxData[
  StyleBox["\"\<T1\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "756f8454-9002-4975-9a9c-083f92403bb4"],
 ", ",
 Cell[BoxData[
  StyleBox["\"\<T2\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "5aecfa85-708b-4e6c-ac9e-2796e35016e9"],
 ", \[Ellipsis] inside the assembled ",
 Cell[BoxData[
  ButtonBox["NetGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NetGraph"]], "InlineFormula",ExpressionUUID->
  "252b2b2e-d7b3-4569-81e0-8ba92730b257"],
 "; the top-level output port of the final network is the standard ",
 Cell[BoxData[
  StyleBox["\"\<Output\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "eeb0ebc7-1570-4810-9288-549e605a8dd3"],
 "."
}], "Notes",
 CellID->100000004,ExpressionUUID->"1d4c0937-fe45-486c-93cb-5bea438b96dd"],

Cell[TextData[{
 "Evaluating the returned ",
 Cell[BoxData[
  ButtonBox["NetGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NetGraph"]], "InlineFormula",ExpressionUUID->
  "e858cb36-c12b-4f37-b292-5472f20bf489"],
 " reproduces ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"2415905a-ad44-4049-a59e-4cc04666e243"],
 " to single-precision floating-point accuracy (the internal arithmetic of ",
 Cell[BoxData[
  ButtonBox["NetGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NetGraph"]], "InlineFormula",ExpressionUUID->
  "56eee953-3008-49fb-93e2-06c48f2838b8"],
 " is ",
 Cell[BoxData[
  StyleBox["\"\<Real32\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "2aa18b6c-6176-4adf-9ba7-b1da4d7bc832"],
 ")."
}], "Notes",
 CellID->100000005,ExpressionUUID->"186d00ae-2e81-4942-add5-18b158c98552"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetworkToNetGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkToNetGraph"]], 
  "InlineFormula",ExpressionUUID->"a0ca5c30-c9d2-4c20-9ebf-61246de16bb8"],
 " returns its input unevaluated when ",
 Cell[BoxData[
  StyleBox["net", "TI"]], "InlineFormula",ExpressionUUID->
  "8e13ef4b-86c5-4442-a43d-ed54aaab61b1"],
 " is not a ",
 Cell[BoxData[
  ButtonBox["TensorNetworkGraphQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphQ"]], 
  "InlineFormula",ExpressionUUID->"8ba62e40-6f73-41af-aac3-6d3285fa901f"],
 " graph."
}], "Notes",
 CellID->100000006,ExpressionUUID->"3c712962-1c79-4612-88bc-8463d2f55a6c"]
}, Open  ]],

