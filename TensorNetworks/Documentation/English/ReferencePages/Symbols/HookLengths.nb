Notebook[{

Cell[CellGroupData[{
Cell["HookLengths", "ObjectName",ExpressionUUID->"76025829-692e-4df6-a188-bb517847f647"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4a871576-9d8b-4075-a6b4-d0a38dc93e26"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HookLengths",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/HookLengths"], "[", 
   StyleBox["partition", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "92fa8e81-b1d2-4a49-9cce-f42da43a523a"],
 "\[LineSeparator]returns the nested list of hook lengths for the Young \
diagram of the integer partition ",
 Cell[BoxData[
  StyleBox["partition", "TI"]], "InlineFormula",ExpressionUUID->
  "e0df8a4f-27d7-471d-843a-6c80e8f0bf9b"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1c81258f-d50f-4977-8c15-fc73cbe84427"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HookLengths",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/HookLengths"], "[", 
   StyleBox["tableau", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "fc847c53-2b65-4e63-9488-852471143bac"],
 "\[LineSeparator]returns the hook lengths for the underlying partition of \
the ",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:WolframTensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"fc13b31f-5b39-4d78-b32e-45b9de82e085"],
 " ",
 Cell[BoxData[
  StyleBox["tableau", "TI"]], "InlineFormula",ExpressionUUID->
  "6f9602c7-3a83-4d35-93a1-bcc506c93f76"],
 "."
}], "Usage",
 CellID->223337487,ExpressionUUID->"92883c3e-c39b-4422-b8d0-073ad789cb84"],

Cell[TextData[{
 "The result of ",
 Cell[BoxData[
  ButtonBox["HookLengths",
   BaseStyle->"Link",
   ButtonData->"paclet:WolframTensorNetworks/ref/HookLengths"]], 
  "InlineFormula",ExpressionUUID->"ba408940-7d7e-4def-8ee2-2aeb7f2160bf"],
 " has the same nested-list shape as the input partition: row ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "814bc8d1-1ee9-4dfa-9e89-94f49efb9140"],
 " of the output contains ",
 Cell[BoxData[
  RowBox[{
   StyleBox["partition", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["i", "TI"], "\[RightDoubleBracket]"}]], "InlineFormula",
  ExpressionUUID->"ee13c5b9-2366-4a3b-babd-97a3a7fe0b17"],
 " hook-length entries."
}], "Notes",
 CellID->984669801,ExpressionUUID->"3ac52241-c311-4a89-abd4-88faae2d94c3"],

Cell[TextData[{
 "The hook length at cell ",
 Cell[BoxData[
  RowBox[{"(", 
   StyleBox["i", "TI"], ",", 
   StyleBox["j", "TI"], ")"}]], "InlineFormula",ExpressionUUID->
  "ab48aa34-b66f-4f22-b40c-29488a7b164f"],
 " is computed as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["partition", "TI"], "\[LeftDoubleBracket]", 
   StyleBox["i", "TI"], "\[RightDoubleBracket]", "-", 
   StyleBox["j", "TI"], "+", 
   StyleBox["partition", "TI"], "'", "\[LeftDoubleBracket]", 
   StyleBox["j", "TI"], "\[RightDoubleBracket]", "-", 
   StyleBox["i", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "70686f02-0235-4fd2-9f84-eb81ba36325d"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["partition", "TI"], "'"}]], "InlineFormula",ExpressionUUID->
  "100cb116-b631-4436-b67e-9afc44398d4d"],
 " is the transposed partition. The whole nested list is built in time linear \
in the total number of cells."
}], "Notes",
 CellID->685904443,ExpressionUUID->"6a4bc4cf-7ddd-4d9f-8b1f-05dacc66935c"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["HookLengths",
   BaseStyle->"Link",
   ButtonData->"paclet:WolframTensorNetworks/ref/HookLengths"]], 
  "InlineFormula",ExpressionUUID->"58e61170-4c94-48bd-98f8-3ce8c58499a0"],
 " precomputes ",
 Cell[BoxData[
  ButtonBox["TransposePartition",
   BaseStyle->"Link",
   ButtonData->"paclet:WolframTensorNetworks/ref/TransposePartition"]], 
  "InlineFormula",ExpressionUUID->"4590dbff-6e2e-4d25-8260-d1a7fabcb39f"],
 " once and reuses it for every cell, so it is faster than calling ",
 Cell[BoxData[
  ButtonBox["HookLength",
   BaseStyle->"Link",
   ButtonData->"paclet:WolframTensorNetworks/ref/HookLength"]], 
  "InlineFormula",ExpressionUUID->"f438a976-4bc4-4265-b4c7-d516c34bbdd1"],
 " on each cell separately."
}], "Notes",
 CellID->309493800,ExpressionUUID->"0d7fe6d4-3303-435c-89cc-9642670d238d"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["HookLengths",
   BaseStyle->"Link",
   ButtonData->"paclet:WolframTensorNetworks/ref/HookLengths"]], 
  "InlineFormula",ExpressionUUID->"78749487-65d7-4e1e-a230-2299113224e7"],
 " accepts both a bare partition list and a ",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:WolframTensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"c9b38b57-ff08-4055-bdff-ebbdde180105"],
 "; both forms give identical output for the same shape."
}], "Notes",
 CellID->571753287,ExpressionUUID->"41139435-1285-429d-b419-cc801f222413"],

Cell[TextData[{
 "Non-partition and non-tableau input produces a ",
 Cell[BoxData[
  RowBox[{"::", "notpar"}]], "InlineFormula",ExpressionUUID->
  "4cea932d-b2ed-43ad-86a4-3ec94a43404f"],
 " message and returns ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:WolframTensorNetworks/ref/$Failed"]], "InlineFormula",
  ExpressionUUID->"1c9eef74-6106-42d6-a238-7020b915655c"],
 "."
}], "Notes",
 CellID->40550656,ExpressionUUID->"17d1c0aa-74d8-4ba7-ba07-a3eabdc784b5"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["HookLengths",
   BaseStyle->"Link",
   ButtonData->"paclet:WolframTensorNetworks/ref/HookLengths"]], 
  "InlineFormula",ExpressionUUID->"51f44f99-bca1-4fe5-b27d-c7bbe1153019"],
 " underlies ",
 Cell[BoxData[
  ButtonBox["HookFactor",
   BaseStyle->"Link",
   ButtonData->"paclet:WolframTensorNetworks/ref/HookFactor"]], 
  "InlineFormula",ExpressionUUID->"b0ac46a3-6f14-4bec-b2af-c41fa03a9703"],
 " (which equals ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   RowBox[{"(", 
    RowBox[{"Times", "@@", 
     RowBox[{"Flatten", "[", 
      RowBox[{"HookLengths", "[", 
       StyleBox["partition", "TI"], "]"}], "]"}]}], ")"}]}]], "InlineFormula",
  ExpressionUUID->"49ff5f88-1c90-48c3-9332-b1802e7612de"],
 ") and ",
 Cell[BoxData[
  ButtonBox["TableauDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:WolframTensorNetworks/ref/TableauDimension"]], 
  "InlineFormula",ExpressionUUID->"8c80c5b3-2c3d-44f8-8b97-f4d8bbce93e2"],
 " (which equals ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Total", "[", 
    StyleBox["partition", "TI"], "]"}], "!", " ", 
   RowBox[{"HookFactor", "[", 
    StyleBox["partition", "TI"], "]"}]}]], "InlineFormula",ExpressionUUID->
  "b8a652d2-6fe0-4a24-b363-2b831c1edf1f"],
 ")."
}], "Notes",
 CellID->924238015,ExpressionUUID->"fa4a89d8-7fdb-49ee-9186-6f93e4e03c17"]
}, Open  ]],

