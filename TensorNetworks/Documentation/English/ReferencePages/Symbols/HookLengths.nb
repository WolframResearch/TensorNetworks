Cell["\<\
Verify the hook length formula: the dimension of the irrep equals n! divided \
by the product of all hook lengths.\
\>", "ExampleText",
 CellID->710389379,ExpressionUUID->"9146601b-0abd-4997-a7fa-9a774c7e0294"],

Cell[BoxData[{
 RowBox[{"par", "=", 
  RowBox[{"{", 
   RowBox[{"4", ",", "2", ",", "1"}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Total", "[", "par", "]"}], "!"}], "/", 
  RowBox[{"Times", "@@", 
   RowBox[{"Flatten", "[", 
    RowBox[{"HookLengths", "[", "par", "]"}], "]"}]}]}], "\n", 
 RowBox[{"TableauDimension", "[", "par", "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->552745575,ExpressionUUID->"dff72f08-ca1f-46a0-aaf5-6a882b57a841"],

