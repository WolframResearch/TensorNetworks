Notebook[{

Cell[CellGroupData[{
Cell["MPSEntanglementEntropy", "ObjectName",
 CellID->1587606103,ExpressionUUID->"bbc5b2a3-16c8-47bd-bed9-c4a16104cd07"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"265300b6-3a35-438d-9f8f-0c32caf13761"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSEntanglementEntropy",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/MPSEntanglementEntropy"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", 
    StyleBox["site", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ba9ee4ac-72c6-40bd-a803-5200d6e2869f"],
 "\[LineSeparator]computes the von Neumann entanglement entropy S = -\[Sum] p \
log(p) at the bond between ",
 Cell[BoxData[
  StyleBox["site", "TI"]], "InlineFormula",ExpressionUUID->
  "f4b87348-b9ce-47ca-9ffd-3aab0dcd3114"],
 " and site+1. \[Bullet] Returns 0 for a product state. \[Bullet] Returns \
log(",
 Cell[BoxData[
  ButtonBox["D",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "a9500390-3d7d-4822-b02d-fd813fbc7edc"],
 ") for a maximally entangled state with bond dimension D. \[Bullet] Uses \
natural logarithm."
}], "Usage",
 CellChangeTimes->{{3.978638356984488*^9, 3.9786383570699177`*^9}},
 CellID->411459146,ExpressionUUID->"853977db-9983-4906-9bba-9c55c104d070"],

Cell["XXXX", "Notes",
 CellID->496523482,ExpressionUUID->"0675bd11-b0b3-4f28-8113-b5a58f8449af"]
}, Open  ]],

