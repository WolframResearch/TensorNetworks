Notebook[{

Cell[CellGroupData[{
Cell["MPSEntanglementEntropy", "ObjectName",
 CellID->840375077,ExpressionUUID->"391b2a25-b551-47c2-a86f-0a086c7c076d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fbd2b060-486f-42df-8ce7-b6fc41f42534"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSEntanglementEntropy",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSEntanglementEntropy"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", 
    StyleBox["site", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e552efb2-ca23-4cd9-a50e-035f882a201d"],
 "\[LineSeparator]computes the von Neumann entanglement entropy at the bond \
between ",
 Cell[BoxData[
  StyleBox["site", "TI"]], "InlineFormula",ExpressionUUID->
  "c09eb10b-fe54-4886-852a-b4dfe403e51b"],
 " and ",
 Cell[BoxData[
  StyleBox["site", "TI"]], "InlineFormula",ExpressionUUID->
  "729d8285-9fcf-4135-8752-ab845a85980d"],
 "+1."
}], "Usage",
 CellID->218403120,ExpressionUUID->"61d033f8-be74-4823-8e91-8256caa88cdd"],

Cell[TextData[{
 "The entropy is computed as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], "=", 
    RowBox[{"-", 
     UnderscriptBox["\[Sum]", 
      StyleBox["i", "TI"]]}], 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["i", "TI"]], " ", "log", " ", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["i", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"817162c2-6edf-41ee-80bf-b5583b7c18e0"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["i", "TI"]], "=", 
    SuperscriptBox[
     SubscriptBox["\[Lambda]", 
      StyleBox["i", "TI"]], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7afc7f47-ce9f-438b-a006-0c1b942acfe5"],
 " are the squared Schmidt values across the bond returned by ",
 Cell[BoxData[
  ButtonBox["MPSSchmidtValues",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSSchmidtValues"]], 
  "InlineFormula",ExpressionUUID->"f61e39ee-8867-4deb-9f1c-4cf0980d44ae"],
 "."
}], "Notes",
 CellID->885638628,ExpressionUUID->"68b91110-cc44-4364-9c5c-3a35a7e13d5b"],

Cell[TextData[{
 "The natural logarithm is used (base ",
 Cell[BoxData[
  StyleBox["e", "TI"]], "InlineFormula",ExpressionUUID->
  "46c30138-d54b-4ea4-903a-e77ca3c4ba49"],
 "); divide by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Log",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Log"], "[", "2", "]"}]], "InlineFormula",
  ExpressionUUID->"04b3154d-96ad-4d61-a4d0-23109a381b35"],
 " to convert to bits."
}], "Notes",
 CellID->449076938,ExpressionUUID->"a4bc1106-7593-41cb-9825-faa7d72e4cb5"],

Cell[TextData[{
 "A product state has a single nonzero Schmidt value at every bond, so the \
entropy is ",
 Cell[BoxData[
 "0"], "InlineFormula",ExpressionUUID->"72710052-cd36-409b-b932-4b30a122c894"],
 "."
}], "Notes",
 CellID->825016070,ExpressionUUID->"17ac1590-ea46-4ec6-967e-07723a39a867"],

Cell[TextData[{
 "A maximally entangled state with bond dimension ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",ExpressionUUID->
  "f8d25e94-5ef2-4ebe-bd40-0bb29d2758d9"],
 " (uniform Schmidt spectrum) has entropy ",
 Cell[BoxData[
  RowBox[{"log", " ", 
   StyleBox["D", "TI"]}]], "InlineFormula",ExpressionUUID->
  "7bb4f3f3-973d-4426-a7bf-1991ec82c4d3"],
 "."
}], "Notes",
 CellID->398082721,ExpressionUUID->"6d6cab42-a505-4aed-afdf-6901cc76096a"],

Cell[TextData[{
 "The entropy is bounded above by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"log", " ", "min", "(", 
    SuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["site", "TI"]], ",", 
    SuperscriptBox[
     StyleBox["d", "TI"], 
     RowBox[{
      StyleBox["N", "TI"], "-", 
      StyleBox["site", "TI"]}]], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"83532531-0c15-4bcf-9576-cbce7a1ae50b"],
 ", where ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "7603adf4-ee92-44f1-9412-0ead7938d7a1"],
 " is the physical dimension and ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",ExpressionUUID->
  "bb063e1d-c273-46e8-a6b6-72f72d246098"],
 " is the MPS length."
}], "Notes",
 CellID->171535639,ExpressionUUID->"73fa717b-e21e-4ddf-af16-0b8a7fcf52f0"],

Cell[TextData[{
 "Only strictly positive Schmidt weights enter the sum, so ",
 Cell[BoxData[
  RowBox[{"0", " ", "log", " ", "0"}]], "InlineFormula",ExpressionUUID->
  "135c3e2a-d1f5-43bd-a911-a96d9be31c47"],
 " contributions do not raise an indeterminate-form message."
}], "Notes",
 CellID->811948859,ExpressionUUID->"768acc6c-2312-4c2d-8d1e-b0f611464f38"],

Cell[TextData[{
 "Valid values of ",
 Cell[BoxData[
  StyleBox["site", "TI"]], "InlineFormula",ExpressionUUID->
  "a12c03ee-019e-4457-bbe7-7aad2e8ca0f2"],
 " are ",
 Cell[BoxData[
 "1"], "InlineFormula",ExpressionUUID->"34da6df8-635d-44bf-b6e3-45783d57b685"],
 " through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "f56fc71e-05e8-4318-b0c7-88080a0bc487"],
 " \[LongDash] the indices label bonds, not sites; out-of-range values return \
",
 Cell[BoxData[
 "0"], "InlineFormula",ExpressionUUID->"be9069c9-ab81-4450-8567-b41f4d8684e0"],
 "."
}], "Notes",
 CellID->605774093,ExpressionUUID->"eb70f307-a865-4c70-b8b9-2c29a00564ae"]
}, Open  ]],

