  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"60fed3aa-40e9-4669-bc41-ed53e59396ee"],
 "."
}], "Notes",
 CellID->883219945,ExpressionUUID->"f92c5350-87d8-4807-8e23-b1f7017c4f0e"]
}, Open  ]],

