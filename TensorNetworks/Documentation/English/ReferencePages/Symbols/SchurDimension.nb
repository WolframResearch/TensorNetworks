Cell[TextData[{
 "Compute the cell-by-cell numerators ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "+", 
   StyleBox["j", "TI"], "-", 
   StyleBox["i", "TI"]}]], "InlineFormula",ExpressionUUID->
  "be014b09-6197-4f77-9c82-0d9a67a225c1"],
 " and hook lengths for shape {3,2} at ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", "3"}]], "InlineFormula",ExpressionUUID->
  "b5a3a05a-c3b1-49d5-8f29-085b2095b1a0"],
 "; their product is 15:"
}], "ExampleText",
 CellID->261492031,ExpressionUUID->"44079847-7fc6-413d-8610-f086eaa18ba6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"partition", ",", " ", "hooks", ",", " ", "nums"}], "}"}], ",", 
   " ", 
   RowBox[{
    RowBox[{"partition", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}]}], ";", " ", 
    RowBox[{"hooks", " ", "=", " ", 
     RowBox[{"HookLengths", "[", "partition", "]"}]}], ";", " ", 
    RowBox[{"nums", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"3", " ", "+", " ", "j", " ", "-", " ", "i"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "partition", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", 
         RowBox[{"partition", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", " ", 
    RowBox[{"{", 
     RowBox[{"nums", ",", " ", "hooks", ",", " ", 
      RowBox[{"Times", " ", "@@", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"nums", "/", "hooks"}], "]"}]}]}], "}"}]}]}], "]"}]], "Input",\

 CellLabel->"In[1]:=",
 CellID->129656520,ExpressionUUID->"ec6ecacb-ade9-44e9-ae25-a6149129b184"],

