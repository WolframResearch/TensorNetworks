Notebook[{

Cell[CellGroupData[{
Cell["SchurDimension", "ObjectName",ExpressionUUID->"193714b3-ac8e-4778-8d31-9501efd07990"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"342fef3d-e52e-4da8-bf8c-5d4aae79ae6d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SchurDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/SchurDimension"], "[", 
   RowBox[{
    StyleBox["partition", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "877ec65a-ca54-4708-993e-7c6d17114d87"],
 "\[LineSeparator]gives the dimension of the ",
 Cell[BoxData[
  RowBox[{"GL", "(", 
   StyleBox["d", "TI"], ")"}]], "InlineFormula",ExpressionUUID->
  "336678da-f9d3-489a-a828-5de67926e520"],
 " Weyl module corresponding to the integer ",
 StyleBox["partition", " TI"],
 " via the hook-content formula. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"322e440c-9b65-43be-bcef-a1c40cd6b004"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SchurDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/SchurDimension"], "[", 
   RowBox[{
    StyleBox["tableau", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f534b14e-22c1-4c00-9c08-40bcdd4019e4"],
 "\[LineSeparator]does the same when the input is a Young ",
 StyleBox["tableau", " TI"],
 "."
}], "Usage",ExpressionUUID->"6080bb6d-601a-49de-88ee-b24354bc0422"],

Cell[TextData[{
 "The dimension of the Weyl module labelled by a partition ",
 Cell[BoxData[
  StyleBox["par", "TI"]], "InlineFormula",ExpressionUUID->
  "93659640-1daf-4936-8fc6-3252f9a3bf78"],
 " is given by the hook-content formula ",
 Cell[BoxData[
  RowBox[{"dim", "=", 
   UnderoverscriptBox["\[Product]", 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], ",", " ", 
      StyleBox["j", "TI"]}], ")"}], ""], 
   FractionBox[
    RowBox[{
     StyleBox["d", "TI"], "+", 
     StyleBox["j", "TI"], "-", 
     StyleBox["i", "TI"]}], 
    RowBox[{
     StyleBox["h", "TI"], "(", 
     RowBox[{
      StyleBox["i", "TI"], ",", " ", 
      StyleBox["j", "TI"]}], ")"}]]}]], "InlineFormula",ExpressionUUID->
  "4e6d72ca-b089-464a-9233-092f28940dc2"],
 ", where the product runs over the cells ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    StyleBox["i", "TI"], ",", " ", 
    StyleBox["j", "TI"]}], ")"}]], "InlineFormula",ExpressionUUID->
  "ba2d1799-d958-4307-b589-df844a84a854"],
 " of the Young diagram of ",
 Cell[BoxData[
  StyleBox["par", "TI"]], "InlineFormula",ExpressionUUID->
  "b9a6124e-fe0e-478c-bceb-50d262b6f217"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["h", "TI"], "(", 
   RowBox[{
    StyleBox["i", "TI"], ",", " ", 
    StyleBox["j", "TI"]}], ")"}]], "InlineFormula",ExpressionUUID->
  "d310b8b2-c2c7-49f3-8dac-187b8e57b115"],
 " is the hook length at ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    StyleBox["i", "TI"], ",", " ", 
    StyleBox["j", "TI"]}], ")"}]], "InlineFormula",ExpressionUUID->
  "40600638-3bf0-40d9-83b9-cc20dc74fdc2"],
 ", and the numerator ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "+", 
   StyleBox["j", "TI"], "-", 
   StyleBox["i", "TI"]}]], "InlineFormula",ExpressionUUID->
  "703c6db1-0b3b-446b-963e-3fa1eef7d42e"],
 " is the content of that cell shifted by ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "c77006e2-156c-419f-b580-be9153cb03f4"],
 "."
}], "Notes",
 CellID->208094422,ExpressionUUID->"2cf80063-3c4b-41b9-9c2b-7b1f48b5531c"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["SchurDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/SchurDimension"], "[", 
   RowBox[{
    StyleBox["par", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "22bce793-e74b-4dbd-9b88-7d3b714498ee"],
 " equals the Schur polynomial ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["s", "TI"], "\[Lambda]"]], "InlineFormula",ExpressionUUID->
  "9da42286-f95d-4370-a1d4-d6035e54f102"],
 " evaluated at the all-ones point ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["x", "TI"], "1"], "=", "\[CenterEllipsis]", "=", 
   SubscriptBox[
    StyleBox["x", "TI"], 
    StyleBox["d", "TI"]], "=", "1"}]], "InlineFormula",ExpressionUUID->
  "6ca5d969-01fd-49fd-b7d3-7ee866b4a0cc"],
 ", equivalently the character of the irreducible polynomial ",
 Cell[BoxData[
  RowBox[{"GL", "(", 
   StyleBox["d", "TI"], ")"}]], "InlineFormula",ExpressionUUID->
  "ca14f046-97c4-4877-ad66-9ce768b9eb4f"],
 " representation labelled by ",
 Cell[BoxData[
  StyleBox["par", "TI"]], "InlineFormula",ExpressionUUID->
  "e55442ed-69b0-4ce5-9fa2-bf7be0220cd6"],
 " evaluated at the identity."
}], "Notes",
 CellID->483402012,ExpressionUUID->"486bd154-f657-4b0a-837a-4bc2e3aa788e"],

Cell[TextData[{
 "Numerically equals the rank of the single-tableau Young projector on ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"(", 
    SuperscriptBox["\[DoubleStruckCapitalC]", 
     StyleBox["d", "TI"]], ")"}], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]]], "InlineFormula",ExpressionUUID->
  "9170b2d4-5bcf-4955-90d8-293c71afac7c"],
 ", where ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "Total", "[", 
   StyleBox["par", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "6ef78602-c70f-48aa-ae45-f2f917f83f08"],
 "."
}], "Notes",
 CellID->563462862,ExpressionUUID->"be022b5d-44a0-4491-8b8b-d368302739dc"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "9b313504-0f38-49f6-9283-f661fcacb630"],
 " may be numeric or symbolic. For symbolic ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "9a795e0a-2dfa-4961-8d57-1c299ec89e33"],
 " the result is a polynomial in ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "cc5dccf1-c36b-4647-8c68-e3da123b16ca"],
 " of degree ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "d7c06716-7e7b-4a14-93f8-4253b484d2f6"],
 "; pipe through ",
 Cell[BoxData[
  ButtonBox["Factor",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Factor"]], "InlineFormula",ExpressionUUID->
  "5e4c2c2e-af42-4b48-a443-e9cf8e59405b"],
 " or ",
 Cell[BoxData[
  ButtonBox["Simplify",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Simplify"]], "InlineFormula",ExpressionUUID->
  "7dad951d-559c-40af-ac12-53883b210b50"],
 " for a closed form."
}], "Notes",
 CellID->34517557,ExpressionUUID->"1388c92f-8c9c-4282-9c19-bb09bde66fc6"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["SchurDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/SchurDimension"], "[", 
   RowBox[{
    StyleBox["yt", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "79e99e90-3fd4-4c19-869e-955dd922eb05"],
 " is shorthand for ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["SchurDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/SchurDimension"], "[", 
   RowBox[{
    ButtonBox["TableauShape",
     BaseStyle->"Link",
     ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"], "[", 
    StyleBox["yt", "TI"], "]", ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0e96f70d-ee9e-4695-a21b-b8f0fdbc3569"],
 ": the value depends only on the shape of the tableau, never on how the \
boxes are filled."
}], "Notes",
 CellID->278497590,ExpressionUUID->"cac76c11-fa88-4090-9d4f-874708ff739d"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SchurDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/SchurDimension"]], 
  "InlineFormula",ExpressionUUID->"d227cd80-0182-4147-92c6-e2acbf8424d6"],
