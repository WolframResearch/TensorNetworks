     RowBox[{
      RowBox[{"1", "\[Rule]", "2"}], ",", 
      RowBox[{"2", "\[Rule]", "3"}], ",", 
      RowBox[{"3", "\[Rule]", "1"}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->813100002,ExpressionUUID->"ab400002-1000-4000-8000-000000000042"],

Cell[BoxData[
 RowBox[{"gAcyc", "=", 
  RowBox[{"TensorNetworkRemoveCycles", "[", "gCyc", "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->813100003,ExpressionUUID->"ab400003-1000-4000-8000-000000000043"],

Cell["\<\
The acyclic result is suitable for the downstream graph algorithms \
(FindCycle, TopologicalSort, contraction-path engines):\
