Cell["\<\
Prepare a cyclic graph for sequential pairwise contraction. The contraction \
engines require an acyclic graph, so cycles must be removed first:\
\>", "ExampleText",
 CellID->813100001,ExpressionUUID->"ab400001-1000-4000-8000-000000000041"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gCyc", "=", 
   RowBox[{"Graph", "[", 
