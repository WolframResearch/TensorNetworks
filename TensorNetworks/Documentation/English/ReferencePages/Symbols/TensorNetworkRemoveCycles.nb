   "ab500009-1000-4000-8000-000000000059"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->813200009,ExpressionUUID->"ab50000a-1000-4000-8000-00000000005a"],

Cell[CellGroupData[{

Cell["The cup and cap tensors, reshaped from length d^2 vectors back to {d, d}, are identity matrices:", "ExampleText",
 CellID->813200010,ExpressionUUID->"ab50000b-1000-4000-8000-00000000005b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"res", "=",
   RowBox[{"TensorNetworkRemoveCycles", "[", "gC", "]"}]}], ";"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->813200011,ExpressionUUID->"ab50000c-1000-4000-8000-00000000005c"],

Cell[BoxData[
 RowBox[{"ArrayReshape", "[",
  RowBox[{
   RowBox[{"AnnotationValue", "[",
    RowBox[{
     RowBox[{"{", RowBox[{"res", ",", "3"}], "}"}], ",",
     "\"\<Tensor\>\""}], "]"}], ",",
   RowBox[{"{", RowBox[{"2", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->813200012,ExpressionUUID->"ab50000d-1000-4000-8000-00000000005d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "3fa3d5de-0f8a-40aa-9196-ee291ef8c22d"],
  $Line = 0; Null]], "ExampleSection",
 CellID->1135993930,ExpressionUUID->"f2ecea9a-72f0-4a3f-a646-7f62e102562f"],

Cell[CellGroupData[{

Cell["TensorNetwork[\[Ellipsis]] objects are not accepted directly; the head requires a directed Graph. The call is held unevaluated when DirectedGraphQ is False:", "ExampleText",
 CellID->813300001,ExpressionUUID->"ab600001-1000-4000-8000-000000000061"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{", RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{", RowBox[{"3", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{", RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{", RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}],
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->813300002,ExpressionUUID->"ab600002-1000-4000-8000-000000000062"],

Cell[BoxData[
 RowBox[{"DirectedGraphQ", "[", "tn", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->813300003,ExpressionUUID->"ab600003-1000-4000-8000-000000000063"],

Cell[BoxData[
 RowBox[{"Head", "[",
  RowBox[{"TensorNetworkRemoveCycles", "[", "tn", "]"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->813300004,ExpressionUUID->"ab600004-1000-4000-8000-000000000064"],

Cell["Convert via ToTensorNetworkGraph instead, which internally handles cycle removal:", "ExampleText",
 CellID->813300005,ExpressionUUID->"ab600005-1000-4000-8000-000000000065"],

Cell[BoxData[
 RowBox[{"ToTensorNetworkGraph", "[", "tn", "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->813300006,ExpressionUUID->"ab600006-1000-4000-8000-000000000066"]
}, Open  ]],

Cell[BoxData[
 InterpretationBox[Cell["\t", "ExampleDelimiter",ExpressionUUID->
   "ab600007-1000-4000-8000-000000000067"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->813300007,ExpressionUUID->"ab600008-1000-4000-8000-000000000068"],

Cell[CellGroupData[{

Cell["The vertex count grows by exactly two per cycle. Loops over VertexList in downstream code must account for the inflation:", "ExampleText",
 CellID->813300009,ExpressionUUID->"ab600009-1000-4000-8000-000000000069"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gN", "=",
   RowBox[{"Graph", "[",
    RowBox[{"{",
     RowBox[{
      RowBox[{"1", "\[Rule]", "2"}], ",",
      RowBox[{"2", "\[Rule]", "1"}], ",",
      RowBox[{"3", "\[Rule]", "4"}], ",",
      RowBox[{"4", "\[Rule]", "3"}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->813300010,ExpressionUUID->"ab60000a-1000-4000-8000-00000000006a"],

Cell[BoxData[
 RowBox[{"VertexCount", "[",
  RowBox[{"TensorNetworkRemoveCycles", "[", "gN", "]"}], "]"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->813300011,ExpressionUUID->"ab60000b-1000-4000-8000-00000000006b"]
}, Open  ]],

Cell[BoxData[
 InterpretationBox[Cell["\t", "ExampleDelimiter",ExpressionUUID->
   "ab60000c-1000-4000-8000-00000000006c"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->813300012,ExpressionUUID->"ab60000d-1000-4000-8000-00000000006d"],

Cell[CellGroupData[{

Cell["The cup/cap insertion preserves the contracted value: the identity tensor contributes a Kronecker-delta contraction, which is mathematically invisible to the network's contracted value:", "ExampleText",
 CellID->813300014,ExpressionUUID->"ab60000e-1000-4000-8000-00000000006e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"r", "=",
   RowBox[{"TensorNetworkRemoveCycles", "[",
    RowBox[{"Graph", "[",
     RowBox[{"{",
      RowBox[{
       RowBox[{"1", "\[Rule]", "2"}], ",",
       RowBox[{"2", "\[Rule]", "1"}]}], "}"}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->813300015,ExpressionUUID->"ab60000f-1000-4000-8000-00000000006f"],

Cell[BoxData[
 RowBox[{"ArrayReshape", "[",
  RowBox[{
   RowBox[{"AnnotationValue", "[",
    RowBox[{
     RowBox[{"{", RowBox[{"r", ",", "3"}], "}"}], ",",
     "\"\<Tensor\>\""}], "]"}], ",",
   RowBox[{"{", RowBox[{"2", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->813300016,ExpressionUUID->"ab600010-1000-4000-8000-000000000070"]
}, Open  ]]
}, Open  ]],

