Cell[CellGroupData[{

Cell["Annotated TN graph", "ExampleSubsection",
 CellID->812200001,ExpressionUUID->"ab200001-1000-4000-8000-000000000021"],

Cell["\<\
Annotated TN graph. A cyclic graph whose edges already carry {Superscript, \
Subscript} tags keeps that variance pattern on the inserted cup and cap:\
\>", "ExampleText",
 CellID->812200002,ExpressionUUID->"ab200002-1000-4000-8000-000000000022"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gA", "=", 
   RowBox[{"Graph", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"DirectedEdge", "[", 
       RowBox[{"1", ",", "2", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Superscript", "[", 
           RowBox[{"1", ",", "1"}], "]"}], ",", 
          RowBox[{"Subscript", "[", 
           RowBox[{"2", ",", "1"}], "]"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"DirectedEdge", "[", 
       RowBox[{"2", ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Superscript", "[", 
           RowBox[{"2", ",", "2"}], "]"}], ",", 
          RowBox[{"Subscript", "[", 
           RowBox[{"1", ",", "2"}], "]"}]}], "}"}]}], "]"}]}], "}"}], "]"}]}],
   ";"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->812200003,ExpressionUUID->"ab200003-1000-4000-8000-000000000023"],

Cell[BoxData[
 RowBox[{
  RowBox[{"out", "=", 
   RowBox[{"TensorNetworkRemoveCycles", "[", "gA", "]"}]}], ";"}]], "Input",
