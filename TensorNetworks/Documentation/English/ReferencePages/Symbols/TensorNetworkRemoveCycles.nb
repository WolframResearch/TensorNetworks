Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Applications", "ExampleSection",ExpressionUUID->
   "e104a8dc-8814-4964-9235-259d4df7f2df"],
  $Line = 0; Null]], "ExampleSection",
 CellID->144946656,ExpressionUUID->"c10ba571-7ad3-47b7-b7b8-cd085b9d83b3"],

Cell[CellGroupData[{

Cell["Prepare a cyclic graph for sequential pairwise contraction. The contraction engines require an acyclic graph, so cycles must be removed first:", "ExampleText",
 CellID->813100001,ExpressionUUID->"ab400001-1000-4000-8000-000000000041"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gCyc", "=",
   RowBox[{"Graph", "[",
    RowBox[{"{",
     RowBox[{
      RowBox[{"1", "\[Rule]", "2"}], ",",
      RowBox[{"2", "\[Rule]", "3"}], ",",
      RowBox[{"3", "\[Rule]", "1"}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->813100002,ExpressionUUID->"ab400002-1000-4000-8000-000000000042"],

Cell[BoxData[
 RowBox[{"gAcyc", "=",
  RowBox[{"TensorNetworkRemoveCycles", "[", "gCyc", "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->813100003,ExpressionUUID->"ab400003-1000-4000-8000-000000000043"],

Cell["The acyclic result is suitable for the downstream graph algorithms (FindCycle, TopologicalSort, contraction-path engines):", "ExampleText",
 CellID->813100004,ExpressionUUID->"ab400004-1000-4000-8000-000000000044"],

Cell[BoxData[
 RowBox[{"AcyclicGraphQ", "[", "gAcyc", "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->813100005,ExpressionUUID->"ab400005-1000-4000-8000-000000000045"],

Cell[BoxData[
 RowBox[{"TopologicalSort", "[", "gAcyc", "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->813100006,ExpressionUUID->"ab400006-1000-4000-8000-000000000046"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "927c9b60-5bfe-41b1-a307-3491e4dcab3f"],
  $Line = 0; Null]], "ExampleSection",
 CellID->871991694,ExpressionUUID->"ba35007c-7ade-4959-8f1f-17d984f7a168"],

Cell[CellGroupData[{

Cell["ToTensorNetworkGraph calls TensorNetworkRemoveCycles on any cyclic directed input:", "ExampleText",
 CellID->813200001,ExpressionUUID->"ab500001-1000-4000-8000-000000000051"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gC", "=",
   RowBox[{"Graph", "[",
    RowBox[{"{",
     RowBox[{
      RowBox[{"1", "\[Rule]", "2"}], ",",
      RowBox[{"2", "\[Rule]", "1"}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->813200002,ExpressionUUID->"ab500002-1000-4000-8000-000000000052"],

Cell[BoxData[
 RowBox[{"VertexCount", "[",
  RowBox[{"TensorNetworkRemoveCycles", "[", "gC", "]"}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->813200003,ExpressionUUID->"ab500003-1000-4000-8000-000000000053"],

Cell[BoxData[
 RowBox[{"VertexCount", "[",
  RowBox[{"ToTensorNetworkGraph", "[", "gC", "]"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->813200004,ExpressionUUID->"ab500004-1000-4000-8000-000000000054"]
}, Open  ]],

