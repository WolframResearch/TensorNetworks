Cell["Multi-cycle graph", "ExampleSubsection",
 CellID->812300001,ExpressionUUID->"ab300001-1000-4000-8000-000000000031"],

Cell["\<\
Multi-cycle graph. Each cycle is broken in turn and adds two vertices, so a \
graph with two disjoint 2-cycles grows by four vertices in total:\
\>", "ExampleText",
 CellID->812300002,ExpressionUUID->"ab300002-1000-4000-8000-000000000032"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gMulti", "=", 
   RowBox[{"Graph", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "\[Rule]", "2"}], ",", 
      RowBox[{"2", "\[Rule]", "1"}], ",", 
      RowBox[{"3", "\[Rule]", "4"}], ",", 
      RowBox[{"4", "\[Rule]", "3"}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->812300003,ExpressionUUID->"ab300003-1000-4000-8000-000000000033"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"VertexCount", "[", "gMulti", "]"}], ",", 
   RowBox[{"VertexCount", "[", 
    RowBox[{"TensorNetworkRemoveCycles", "[", "gMulti", "]"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[9]:=",
 CellID->812300004,ExpressionUUID->"ab300004-1000-4000-8000-000000000034"],

Cell["The output is acyclic:", "ExampleText",
 CellID->812300005,ExpressionUUID->"ab300005-1000-4000-8000-000000000035"],

