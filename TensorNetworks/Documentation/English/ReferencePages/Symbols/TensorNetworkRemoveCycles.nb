Notebook[{

Cell[CellGroupData[{
Cell["TensorNetworkRemoveCycles", "ObjectName",
 CellID->1843487481,ExpressionUUID->"6464d452-1e46-4d29-8abe-6ba6821de9a9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d5c6d3c8-a8b7-4483-8419-73fb30756570"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkRemoveCycles",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/TensorNetworks/ref/TensorNetworkRemoveCycles"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e6c17db7-1f20-4e7f-a44a-5efdbcbf9364"],
 "\[LineSeparator]returns an acyclic ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "7a4ab103-9b41-4cc8-b6a4-6e6c20bdc101"],
 " by inserting one cup/cap pair of identity tensors for each cycle in the \
directed input ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "f9b1b51c-71e7-4d44-9ae5-fa019d6e6f37"],
 "."
}], "Usage",
 CellID->1747517898,ExpressionUUID->"837768f8-2fe0-4171-b3eb-2b2466f4551a"],

Cell[TextData[{
 "The input ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "a01a1ac1-eeb8-4d8c-9d70-1e2c9c7ee9b1"],
 " must satisfy ",
 Cell[BoxData[
  ButtonBox["DirectedGraphQ",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/DirectedGraphQ"]], "InlineFormula",ExpressionUUID->
  "61e4f5b4-c6ae-4ddc-aa1e-6e4d9efc4ad9"],
 "; undirected input is held unevaluated. The caller ",
 Cell[BoxData[
  ButtonBox["ToTensorNetworkGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]], 
  "InlineFormula",ExpressionUUID->"5a6c2e2c-7e21-4d6e-b3bc-1b80a7f1f9c1"],
 " handles undirected graphs upstream via ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["DirectedGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/DirectedGraph"], "[", 
   StyleBox["g", "TI"], ",", "\"\<Acyclic\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"a5db0fa7-1fcb-44dc-a92a-3a5a51b6f8a3"],
 "."
}], "Notes",
 CellID->810000001,ExpressionUUID->"b5a8b7a8-3b78-4d36-a8d8-bf04f3e0a001"],

Cell[TextData[{
 "Each cup/cap pair represents an identity contraction. The cup vertex \
carries ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Flatten",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Flatten"], "[", 
   RowBox[{
    ButtonBox["IdentityMatrix",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/IdentityMatrix"], "[", 
    StyleBox["d", "TI"], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "a8be7ddb-d0f0-4af9-907a-2d51b15e57ff"],
 " (the rank-2 identity reshaped to a rank-1 length-",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "^", "2"}]], "InlineFormula",ExpressionUUID->
  "c9f4ce1f-9a72-4612-aaad-7eb8b7e7c01b"],
 " vector); the cap vertex carries the same. Reshaping either tensor back to ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["d", "TI"], ",", 
   StyleBox["d", "TI"], "}"}]], "InlineFormula",ExpressionUUID->
  "d83c8c9a-d33b-490a-a85d-23a35d44b101"],
 " recovers ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["IdentityMatrix",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/IdentityMatrix"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e9b50ed7-3f78-4eea-b8e1-3a8c70ed1003"],
 "."
}], "Notes",
 CellID->810000002,ExpressionUUID->"b5a8b7a8-3b78-4d36-a8d8-bf04f3e0a002"],

Cell[TextData[{
 "For annotated tensor-network graphs (with ",
 Cell[BoxData["\"\<Tensor\>\""], "InlineFormula",ExpressionUUID->
  "a1d1c0c0-86cd-490e-9d2b-1de2a87b3c01"],
 ", ",
 Cell[BoxData["\"\<Index\>\""], "InlineFormula",ExpressionUUID->
  "a1d1c0c0-86cd-490e-9d2b-1de2a87b3c02"],
 ", and ",
 Cell[BoxData[
  RowBox[{"{", 
   ButtonBox["Superscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Superscript"], ",", 
   ButtonBox["Subscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Subscript"], "}"}]], "InlineFormula",
  ExpressionUUID->"a1d1c0c0-86cd-490e-9d2b-1de2a87b3c03"],
 " edge tags), the cup vertex is given two ",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->
  "a1d1c0c0-86cd-490e-9d2b-1de2a87b3c04"],
 " labels (the contravariant end) and the cap vertex two ",
 Cell[BoxData[
  ButtonBox["Subscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Subscript"]], "InlineFormula",ExpressionUUID->
  "a1d1c0c0-86cd-490e-9d2b-1de2a87b3c05"],
 " labels (the covariant end); the broken edge's original tag slots are \
inherited as the second component of each index."
}], "Notes",
 CellID->810000003,ExpressionUUID->"b5a8b7a8-3b78-4d36-a8d8-bf04f3e0a003"],

Cell[TextData[{
 "The function processes one cycle at a time via ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindCycle",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/FindCycle"], "[", 
   StyleBox["net", "TI"], ",", 
   ButtonBox["Infinity",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Infinity"], ",", "1", "]"}]], "InlineFormula",
  ExpressionUUID->"d2c2c2c2-2222-4444-aaaa-bbbbcccc0001"],
 " in a ",
 Cell[BoxData[
  ButtonBox["While",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/While"]], "InlineFormula",ExpressionUUID->
  "d2c2c2c2-2222-4444-aaaa-bbbbcccc0002"],
 " loop \[Dash] each iteration breaks one cycle and re-runs ",
 Cell[BoxData[
  ButtonBox["FindCycle",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/FindCycle"]], "InlineFormula",ExpressionUUID->
  "d2c2c2c2-2222-4444-aaaa-bbbbcccc0003"],
 " on the rewritten graph until no cycles remain."
}], "Notes",
 CellID->810000004,ExpressionUUID->"b5a8b7a8-3b78-4d36-a8d8-bf04f3e0a004"],

Cell[TextData[{
 "Vertex labels in the input are canonicalized to integers by ",
 Cell[BoxData[
  ButtonBox["IndexGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/IndexGraph"]], "InlineFormula",ExpressionUUID->
  "d2c2c2c2-3333-4444-aaaa-bbbbcccc0001"],
 " before cycle removal; the new cup and cap vertices are allocated as fresh \
integers starting from ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Max",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Max"], "[", 
   RowBox[{
    ButtonBox["VertexList",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/VertexList"], "[", 
    StyleBox["net", "TI"], "]"}], "]", "+", "1"}]], "InlineFormula",
  ExpressionUUID->"d2c2c2c2-3333-4444-aaaa-bbbbcccc0002"],
 "."
}], "Notes",
 CellID->810000005,ExpressionUUID->"b5a8b7a8-3b78-4d36-a8d8-bf04f3e0a005"],

Cell["\<\
Each cycle adds exactly two vertices (one cup, one cap) and rewrites three \
edges (the broken edge is replaced by cup\[Rule]cap, cup\[Rule]target, source\
\[Rule]cap).\
\>", "Notes",
 CellID->810000006,ExpressionUUID->"b5a8b7a8-3b78-4d36-a8d8-bf04f3e0a006"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ToTensorNetworkGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]], 
  "InlineFormula",ExpressionUUID->"d2c2c2c2-4444-4444-aaaa-bbbbcccc0001"],
 " calls ",
 Cell[BoxData[
  ButtonBox["TensorNetworkRemoveCycles",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/TensorNetworks/ref/TensorNetworkRemoveCycles"]], 
  "InlineFormula",ExpressionUUID->"d2c2c2c2-4444-4444-aaaa-bbbbcccc0002"],
 " automatically on any cyclic directed input, so direct calls are rare in \
typical usage."
}], "Notes",
 CellID->810000007,ExpressionUUID->"b5a8b7a8-3b78-4d36-a8d8-bf04f3e0a007"]
}, Open  ]],

