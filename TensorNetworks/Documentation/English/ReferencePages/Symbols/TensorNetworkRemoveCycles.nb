Cell[CellGroupData[{

Cell["Unannotated directed graph", "ExampleSubsection",
 CellID->812100001,ExpressionUUID->"ab100001-1000-4000-8000-000000000011"],

Cell["Unannotated directed graph. A raw cyclic Graph gets cup/cap vertices and untagged DirectedEdges:", "ExampleText",
 CellID->812100002,ExpressionUUID->"ab100002-1000-4000-8000-000000000012"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gU", "=",
   RowBox[{"Graph", "[",
    RowBox[{"{",
     RowBox[{
      RowBox[{"1", "\[Rule]", "2"}], ",",
      RowBox[{"2", "\[Rule]", "3"}], ",",
      RowBox[{"3", "\[Rule]", "1"}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->812100003,ExpressionUUID->"ab100003-1000-4000-8000-000000000013"],

Cell[BoxData[
 RowBox[{"EdgeList", "[",
  RowBox[{"TensorNetworkRemoveCycles", "[", "gU", "]"}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->812100004,ExpressionUUID->"ab100004-1000-4000-8000-000000000014"],

Cell["The new vertices carry the labels \"Cup\" and \"Cap\":", "ExampleText",
 CellID->812100005,ExpressionUUID->"ab100005-1000-4000-8000-000000000015"],

Cell[BoxData[
 RowBox[{"AnnotationValue", "[",
