 InterpretationBox[Cell["\t", "ExampleDelimiter",ExpressionUUID->
   "ab500005-1000-4000-8000-000000000055"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->813200005,ExpressionUUID->"ab500006-1000-4000-8000-000000000056"],

Cell[CellGroupData[{

Cell["The result has no cycles, as detected by FindCycle:", "ExampleText",
 CellID->813200007,ExpressionUUID->"ab500007-1000-4000-8000-000000000057"],

Cell[BoxData[
 RowBox[{"FindCycle", "[",
  RowBox[{"TensorNetworkRemoveCycles", "[", "gC", "]"}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->813200008,ExpressionUUID->"ab500008-1000-4000-8000-000000000058"]
}, Open  ]],

