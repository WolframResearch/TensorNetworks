Cell["A simple directed 3-cycle is broken by inserting one cup/cap pair:", "ExampleText",
 CellID->811000001,ExpressionUUID->"fd955856-81a2-4037-8bb5-6d402cccbac1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "=",
   RowBox[{"Graph", "[",
    RowBox[{"{",
     RowBox[{
      RowBox[{"1", "\[Rule]", "2"}], ",",
      RowBox[{"2", "\[Rule]", "3"}], ",",
      RowBox[{"3", "\[Rule]", "1"}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->811000002,ExpressionUUID->"c43c0e9a-8570-452b-a2c3-001172988baa"],

Cell[BoxData[
 RowBox[{"TensorNetworkRemoveCycles", "[", "g", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->811000003,ExpressionUUID->"d82c0785-5e2d-4f2c-adbc-82eeffe95c3d"],

Cell["The result is acyclic:", "ExampleText",
 CellID->811000004,ExpressionUUID->"ab000004-1000-4000-8000-000000000004"],

Cell[BoxData[
 RowBox[{"AcyclicGraphQ", "[",
  RowBox[{"TensorNetworkRemoveCycles", "[", "g", "]"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->811000005,ExpressionUUID->"ab000005-1000-4000-8000-000000000005"],

Cell["Each cycle adds two vertices (a cup and a cap) to the input:", "ExampleText",
 CellID->811000006,ExpressionUUID->"ab000006-1000-4000-8000-000000000006"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VertexCount", "[", "g", "]"}], ",",
  RowBox[{"VertexCount", "[",
   RowBox[{"TensorNetworkRemoveCycles", "[", "g", "]"}], "]"}]}]], "Input",
 CellLabel->"In[4]:=",
 CellID->811000007,ExpressionUUID->"ab000007-1000-4000-8000-000000000007"],

Cell["The cup and cap carry a flattened identity matrix as their tensor:", "ExampleText",
 CellID->811000008,ExpressionUUID->"ab000008-1000-4000-8000-000000000008"],

Cell[BoxData[
 RowBox[{
  RowBox[{"res", "=",
   RowBox[{"TensorNetworkRemoveCycles", "[", "g", "]"}]}], ";"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->811000009,ExpressionUUID->"ab000009-1000-4000-8000-000000000009"],

Cell[BoxData[
 RowBox[{"AnnotationValue", "[",
  RowBox[{
   RowBox[{"{", RowBox[{"res", ",",
    RowBox[{"VertexList", "[", "res", "]"}]}], "}"}], ",",
   "VertexLabels"}], "]"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->811000010,ExpressionUUID->"ab00000a-1000-4000-8000-00000000000a"],

