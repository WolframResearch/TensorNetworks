  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "g1010002-0001-0001-0001-000000000002"],
 " for any one-element list, irrespective of the element. In particular, a \
single-element list whose element is itself a multi-element list still \
matches the leaf pattern:"
}], "ExampleText",
 CellID->400200001,ExpressionUUID->"g1010003-0001-0001-0001-000000000003"],

Cell[BoxData[
 RowBox[{"TreePathQ", "[",
  RowBox[{"{",
