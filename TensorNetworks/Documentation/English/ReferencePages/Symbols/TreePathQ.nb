Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
 CellID->400200003,ExpressionUUID->"g1010005-0001-0001-0001-000000000005"],

Cell[TextData[{
 "Rejection only takes effect once a parent has at least two children \
\[LongDash] then every child must itself satisfy ",
 Cell[BoxData[
  ButtonBox["TreePathQ",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "g1010006-0001-0001-0001-000000000006"],
 ". The singleton-leaf rule is the easiest gotcha: users coming from ",
 Cell[BoxData[
  ButtonBox["PathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathQ"]], "InlineFormula",
  ExpressionUUID->"g1010007-0001-0001-0001-000000000007"],
 " often write ",
 Cell[BoxData[
  RowBox[{"{",
   RowBox[{"1", ",", "2"}], "}"}]], "InlineFormula",ExpressionUUID->
  "g1010008-0001-0001-0001-000000000008"],
 " for an interior child where ",
 Cell[BoxData[
  RowBox[{"{",
   RowBox[{
    RowBox[{"{", "1", "}"}], ",",
    RowBox[{"{", "2", "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "g1010009-0001-0001-0001-000000000009"],
 " is required."
}], "ExampleText",
 CellID->400200004,ExpressionUUID->"g1010010-0001-0001-0001-000000000010"],

