 Cell[BoxData[
  ButtonBox["TreePathQ",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "f1010002-0001-0001-0001-000000000002"],
 " accepts the nested binary-tree form. The two predicates disagree on a \
linear path with at least two contractions:"
}], "ExampleText",
 CellID->300200001,ExpressionUUID->"f1010003-0001-0001-0001-000000000003"],

Cell[BoxData[
