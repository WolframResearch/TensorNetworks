Cell[TextData[{
 "The base case ",
 Cell[BoxData[
  RowBox[{"TreePathQ", "[",
   RowBox[{"{",
    StyleBox["x", "TI"], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "g1010001-0001-0001-0001-000000000001"],
 " returns ",
