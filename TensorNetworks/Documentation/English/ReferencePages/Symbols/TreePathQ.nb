Cell[CellGroupData[{
Cell["TreePathQ", "ObjectName",
 CellID->744076458,ExpressionUUID->"c54cb2f2-2d1c-4ae3-838d-a86710a9f494"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2a8b9b84-a2e2-4f28-9b7a-c8bfec8cf951"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TreePathQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TreePathQ"], "[",
   StyleBox["treePath", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "796739d7-8670-4fd9-8748-193a7f113bec"],
 " \[LineSeparator]yields ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "abc12345-6789-0abc-def1-234567890abc"],
 " if ",
 StyleBox["treePath", "TI"],
 " is a valid tree-form contraction path \[LongDash] a nested list whose \
non-leaf nodes recursively decompose into ",
 Cell[BoxData[
  RowBox[{"TreePathQ", "[",
   StyleBox["_", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "def12345-6789-0abc-def1-234567890def"],
 " children, and ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "abc22345-6789-0abc-def1-234567890aaa"],
 " otherwise."
}], "Usage",
 CellChangeTimes->{3.9786383025308323`*^9},
 CellID->895753125,ExpressionUUID->"8f600d51-5a90-4929-b7d4-356352356ae9"],

Cell[TextData[{
 "The tree form is the binary-tree structure used internally by ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
  "InlineFormula",ExpressionUUID->"11111111-1111-1111-1111-111111111111"],
 " and produced by ",
 Cell[BoxData[
  ButtonBox["PathToTreePath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathToTreePath"]],
  "InlineFormula",ExpressionUUID->"22222222-2222-2222-2222-222222222222"],
 "."
}], "Notes",
 CellID->1062406405,ExpressionUUID->"3dfee479-a7a5-4da7-81d4-6cdcfeb8d0c3"],

Cell[TextData[{
 "Any single-element list ",
 Cell[BoxData[
  RowBox[{"{",
   StyleBox["x", "TI"], "}"}]], "InlineFormula",ExpressionUUID->
  "33333333-3333-3333-3333-333333333333"],
 " is treated as a leaf and returns ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "44444444-4444-4444-4444-444444444444"],
 " regardless of what ",
 StyleBox["x", "TI"],
 " is. A multi-element list ",
 Cell[BoxData[
  RowBox[{"{",
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], "1"], ",", "\[Ellipsis]", ",",
    SubscriptBox[
     StyleBox["x", "TI"], "n"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "55555555-5555-5555-5555-555555555555"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "\[GreaterEqual]", "2"}]], "InlineFormula",
  ExpressionUUID->"66666666-6666-6666-6666-666666666666"],
 " satisfies ",
 Cell[BoxData[
  ButtonBox["TreePathQ",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "77777777-7777-7777-7777-777777777777"],
 " only when every child ",
 SubscriptBox[
  StyleBox["x", "TI"],
  StyleBox["i", "TI"]],
 " itself satisfies ",
 Cell[BoxData[
  ButtonBox["TreePathQ",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "88888888-8888-8888-8888-888888888888"],
 "."
}], "Notes",
 CellID->1062406406,ExpressionUUID->"3dfee479-a7a5-4da7-81d4-6cdcfeb8d0c4"],

Cell[TextData[{
 "The empty list ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "99999999-9999-9999-9999-999999999999"],
 " returns ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"],
 "; a non-list expression also returns ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"],
 "."
}], "Notes",
 CellID->1062406407,ExpressionUUID->"3dfee479-a7a5-4da7-81d4-6cdcfeb8d0c5"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TreePathQ",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "cccccccc-cccc-cccc-cccc-cccccccccccc"],
 " is the tree-form sibling of ",
 Cell[BoxData[
  ButtonBox["PathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathQ"]], "InlineFormula",
  ExpressionUUID->"dddddddd-dddd-dddd-dddd-dddddddddddd"],
 " (linear path of integer pairs) and ",
 Cell[BoxData[
  ButtonBox["CanonicalPathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPathQ"]],
  "InlineFormula",ExpressionUUID->"eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee"],
 " (canonical linear path)."
}], "Notes",
 CellID->1062406408,ExpressionUUID->"3dfee479-a7a5-4da7-81d4-6cdcfeb8d0c6"]
}, Open  ]],

