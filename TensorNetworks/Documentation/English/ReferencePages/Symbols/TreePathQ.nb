Cell[BoxData["False"], "Output",
 CellLabel->"Out[2]=",
 CellID->300200005,ExpressionUUID->"f1010007-0001-0001-0001-000000000007"],

Cell[TextData[{
 "Conversely, the nested tree-form rejects the linear test:"
}], "ExampleText",
 CellID->300200006,ExpressionUUID->"f1010008-0001-0001-0001-000000000008"],

Cell[BoxData[
 RowBox[{"PathQ", "[",
  RowBox[{"{",
