Cell[CellGroupData[{

Cell["Hook-length formula for TableauDimension", "ExampleSubsection",
 CellID->94084543,ExpressionUUID->"11d8a17e-0a4c-42ab-8d07-93d3740e49ef"],

Cell["\<\
TableauDimension equals n! divided by the product of all hook lengths:\
\>", "ExampleText",
 CellID->711255105,ExpressionUUID->"17722390-42d7-4605-97dc-ab5cf9d59356"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"par", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "2", ",", " ", "1"}], "}"}]}], ",", " ", "yt", ",",
      " ", "n", ",", " ", "prod"}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"yt", " ", "=", " ", 
     RowBox[{"YoungTableau", "[", "par", "]"}]}], ";", " ", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"TableauSize", "[", "yt", "]"}]}], ";", " ", 
    RowBox[{"prod", " ", "=", " ", 
     RowBox[{"Times", " ", "@@", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"HookLength", "[", 
          RowBox[{"yt", ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "j"}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", "par", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", 
           RowBox[{"par", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]}], ";", 
    " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"n", "!"}], "/", "prod"}], ",", " ", 
      RowBox[{"TableauDimension", "[", "yt", "]"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->228053912,ExpressionUUID->"d4644ed8-c295-4d1e-b041-e0b22b04476c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"35", ",", "35"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->503933676,ExpressionUUID->"aecbf5ab-d163-4f52-b897-a166e29b8bd4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Relation to TransposePartition", "ExampleSubsection",
 CellID->602132282,ExpressionUUID->"8b118a16-83b1-4f16-829f-0b3e8cd2fed8"],

Cell["\<\
The leg length at cell {row, col} is TransposePartition[shape][[col]] minus \
row; the arm length is shape[[row]] minus col:\
\>", "ExampleText",
 CellID->627088002,ExpressionUUID->"887c6263-0593-475a-b316-fe84fb064007"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"yt", " ", "=", " ", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "3", ",", " ", "1"}], "}"}], "]"}]}], ",", " ",
      "shape", ",", " ", "trans", ",", " ", 
     RowBox[{"row", " ", "=", " ", "2"}], ",", " ", 
     RowBox[{"col", " ", "=", " ", "2"}], ",", " ", "arm", ",", " ", "leg"}], 
    "}"}], ",", " ", 
   RowBox[{
    RowBox[{"shape", " ", "=", " ", 
     RowBox[{"TableauShape", "[", "yt", "]"}]}], ";", " ", 
    RowBox[{"trans", " ", "=", " ", 
     RowBox[{"TransposePartition", "[", "shape", "]"}]}], ";", " ", 
    RowBox[{"arm", " ", "=", " ", 
     RowBox[{
      RowBox[{"shape", "[", 
       RowBox[{"[", "row", "]"}], "]"}], " ", "-", " ", "col"}]}], ";", " ", 
    RowBox[{"leg", " ", "=", " ", 
     RowBox[{
      RowBox[{"trans", "[", 
       RowBox[{"[", "col", "]"}], "]"}], " ", "-", " ", "row"}]}], ";", " ", 
    RowBox[{"{", 
     RowBox[{"arm", ",", " ", "leg", ",", " ", 
      RowBox[{"arm", " ", "+", " ", "leg", " ", "+", " ", "1"}], ",", " ", 
      RowBox[{"HookLength", "[", 
