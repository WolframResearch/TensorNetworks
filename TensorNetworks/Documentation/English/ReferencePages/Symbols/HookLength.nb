Cell[CellGroupData[{

Cell["Arm + leg + 1 decomposition", "ExampleSubsection",
 CellID->333073458,ExpressionUUID->"08c15ac9-6cb8-442a-ab91-c77172319226"],

Cell["\<\
Recover HookLength from the arm length and the leg length read off the \
partition and its transpose:\
\>", "ExampleText",
 CellID->285959069,ExpressionUUID->"8fe8c8d9-9b55-4423-99e0-375d3bbb1b9a"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"par", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], ",", " ", "trans", ",", " ", 
     "arm", ",", " ", "leg"}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"trans", " ", "=", " ", 
     RowBox[{"TransposePartition", "[", "par", "]"}]}], ";", " ", 
    RowBox[{"arm", " ", "=", " ", 
     RowBox[{
      RowBox[{"par", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}]}], ";", " ", 
    RowBox[{"leg", " ", "=", " ", 
     RowBox[{
      RowBox[{"trans", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "1"}]}], ";", " ", 
    RowBox[{"{", 
     RowBox[{"arm", ",", " ", "leg", ",", " ", 
      RowBox[{"arm", " ", "+", " ", "leg", " ", "+", " ", "1"}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->273658469,ExpressionUUID->"37304d2a-74af-4a75-83ba-0c426a66f2d7"],

