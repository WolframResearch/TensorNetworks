Cell["Sweep HookLength over every cell of the shape {3, 2}:", "ExampleText",
 CellID->867359008,ExpressionUUID->"a2f93dcc-ba96-4647-b61c-bf9b63fc8aed"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"yt", " ", "=", " ", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}], "]"}]}], ",", " ", "par"}], 
    "}"}], ",", " ", 
   RowBox[{
    RowBox[{"par", " ", "=", " ", 
     RowBox[{"TableauShape", "[", "yt", "]"}]}], ";", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"HookLength", "[", 
       RowBox[{"yt", ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "j"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", 
        RowBox[{"Length", "[", "par", "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", 
        RowBox[{"par", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[1]:=",
