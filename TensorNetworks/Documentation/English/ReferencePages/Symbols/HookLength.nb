 CellID->674045227,ExpressionUUID->"9db62977-6804-4294-bffa-30950061b034"],

Cell["\<\
Tabulate the arm length, leg length, and hook length at each cell of a {4, 3, \
1} tableau:\
\>", "ExampleText",
 CellID->187773221,ExpressionUUID->"4be32ea3-d268-4891-a89a-5037cae06f99"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"yt", " ", "=", " ", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "3", ",", " ", "1"}], "}"}], "]"}]}], ",", " ",
      "par", ",", " ", "trans"}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"par", " ", "=", " ", 
     RowBox[{"TableauShape", "[", "yt", "]"}]}], ";", " ", 
    RowBox[{"trans", " ", "=", " ", 
     RowBox[{"TransposePartition", "[", "par", "]"}]}], ";", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"par", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", "j"}], ",", " ", 
        RowBox[{
         RowBox[{"trans", "[", 
          RowBox[{"[", "j", "]"}], "]"}], " ", "-", " ", "i"}], ",", " ", 
        RowBox[{"HookLength", "[", 
         RowBox[{"yt", ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "j"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", 
        RowBox[{"Length", "[", "par", "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", 
        RowBox[{"par", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",\

 CellLabel->"In[1]:=",
 CellID->380263754,ExpressionUUID->"31ab9642-83eb-473b-842a-6f52ee2966b0"],

