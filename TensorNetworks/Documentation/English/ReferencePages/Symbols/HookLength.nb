 CellID->511509163,ExpressionUUID->"511ef9e7-8e68-4240-8f9a-efda8dd9183f"],

Cell["\<\
A bare list of lists is not a YoungTableau; HookLength issues \
HookLength::noyt and returns $Failed:\
\>", "ExampleText",
 CellID->796052776,ExpressionUUID->"f3dd47ad-50fa-45f2-bf3b-c11957395cb0"],

