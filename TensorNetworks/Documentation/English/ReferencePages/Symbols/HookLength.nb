Cell[CellGroupData[{

Cell["Explicit verification of the hook-length formula", "ExampleSubsection",
 CellID->748000704,ExpressionUUID->"a1d29987-5780-40c2-a936-60cfb46da53a"],

Cell["\<\
Multiply the hook lengths gathered cell-by-cell and divide n! by the product \
to recover TableauDimension:\
\>", "ExampleText",
 CellID->189939563,ExpressionUUID->"71d787c0-1662-482c-9048-b88afabe55fc"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"yt", " ", "=", " ", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}]}], ",", " ",
      "par", ",", " ", "hookProduct", ",", " ", "n"}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"par", " ", "=", " ", 
     RowBox[{"TableauShape", "[", "yt", "]"}]}], ";", " ", 
    RowBox[{"hookProduct", " ", "=", " ", 
     RowBox[{"Times", " ", "@@", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"HookLength", "[", 
          RowBox[{"yt", ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "j"}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", "par", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", 
           RowBox[{"par", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]}], ";", 
    " ", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"TableauSize", "[", "yt", "]"}]}], ";", " ", 
    RowBox[{"{", 
     RowBox[{"hookProduct", ",", " ", 
      RowBox[{
       RowBox[{"n", "!"}], "/", "hookProduct"}]}], "}"}]}]}], "]"}]], "Input",\

 CellLabel->"In[1]:=",
 CellID->578540782,ExpressionUUID->"db06c36e-ee49-4b99-8cc8-2f26316c7879"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"144", ",", "35"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->145241831,ExpressionUUID->"859259b5-151a-4db2-b164-d7dcbb902807"],

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
