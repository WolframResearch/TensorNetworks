Cell[CellGroupData[{

Cell["Relation to HookFactor", "ExampleSubsection",
 CellID->930186400,ExpressionUUID->"2b5ad091-330a-4bd0-bf9c-86423f24c9cd"],

Cell["\<\
The reciprocal of the product of all hook lengths equals HookFactor of the \
partition:\
\>", "ExampleText",
 CellID->84039412,ExpressionUUID->"1278f870-24ca-4aec-8275-80f73f7933b7"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"par", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "2"}], "}"}]}], ",", " ", "yt", ",", " ", 
     "prod"}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"yt", " ", "=", " ", 
     RowBox[{"YoungTableau", "[", "par", "]"}]}], ";", " ", 
    RowBox[{"prod", " ", "=", " ", 
     RowBox[{"Times", " ", "@@", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"HookLength", "[", 
          RowBox[{"yt", ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "j"}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", "par", "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", 
           RowBox[{"par", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}]}], ";", 
    " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "prod"}], ",", " ", 
      RowBox[{"HookFactor", "[", "par", "]"}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->658346876,ExpressionUUID->"0b860d99-2c84-4fd1-89ec-dc55c214f429"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", "24"], ",", 
   FractionBox["1", "24"]}], "}"}]], "Output",
