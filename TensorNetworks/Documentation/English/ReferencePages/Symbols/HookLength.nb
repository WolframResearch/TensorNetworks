Cell[CellGroupData[{

Cell["Out-of-bounds positions are not flagged", "ExampleSubsection",
 CellID->227503105,ExpressionUUID->"5287978a-b6eb-4c58-b981-28c2eeaef6fb"],

Cell["\<\
HookLength performs no range check on the {row, col} pair. A column index \
just past the row length returns a negative integer with no warning:\
\>", "ExampleText",
 CellID->669525788,ExpressionUUID->"3dfddf72-8673-42df-b5f8-85e88a33633f"],

Cell[BoxData[
