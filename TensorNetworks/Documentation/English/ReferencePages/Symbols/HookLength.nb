Cell["Relation to HookLengths", "ExampleSubsection",
 CellID->894838096,ExpressionUUID->"fe8475ee-7aee-49c9-b0ca-7396f8ed1e86"],

Cell["\<\
Sweeping HookLength over every cell of a tableau reproduces HookLengths for \
the same partition:\
\>", "ExampleText",
 CellID->445805580,ExpressionUUID->"1cebf4c1-8b27-4cdd-a864-805ae3637451"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"yt", " ", "=", " ", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "3", ",", " ", "1"}], "}"}], "]"}]}], ",", " ",
      "par"}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"par", " ", "=", " ", 
     RowBox[{"TableauShape", "[", "yt", "]"}]}], ";", " ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"HookLength", "[", 
        RowBox[{"yt", ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "j"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "par", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", 
         RowBox[{"par", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], " ", "===", " ", 
     RowBox[{"HookLengths", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "3", ",", " ", "1"}], "}"}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->280544844,ExpressionUUID->"58d7a553-7392-4b35-9d33-95e21b8c915e"],

