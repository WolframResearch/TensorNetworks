Notebook[{

Cell[CellGroupData[{
Cell["HookLength", "ObjectName",
 CellID->205104285,ExpressionUUID->"cff3a5fd-c963-449f-9865-870702772fc8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6e0291dd-f55d-4a7e-970b-a427281a3467"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HookLength",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookLength"], "[", 
   RowBox[{
    StyleBox["tableau", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["row", "TI"], ",", " ", 
      StyleBox["col", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"33c5691a-8871-4577-8837-2f9b1251667b"],
 "\[LineSeparator]computes the hook length at position {",
 Cell[BoxData[
  StyleBox["row", "TI"]], "InlineFormula",ExpressionUUID->
  "aeb4d748-e8e0-46de-bcc3-ee91c2e47ab3"],
 ", ",
 Cell[BoxData[
  StyleBox["col", "TI"]], "InlineFormula",ExpressionUUID->
  "0dcff481-e637-4b45-b380-0cd9ddde03cd"],
 "} of a Young tableau."
}], "Usage",
 CellID->44604555,ExpressionUUID->"d9bcd107-af8c-4403-80fa-38c456a203be"],

Cell[TextData[{
 "The hook length is the sum of the ",
 StyleBox["arm length",
  FontSlant->"Italic"],
 " (cells to the right in the row, excluding the current cell), the ",
 StyleBox["leg length",
  FontSlant->"Italic"],
 " (cells below in the column, excluding the current cell), and 1 (the \
current cell itself)."
}], "Notes",
 CellID->939791471,ExpressionUUID->"2629f3f1-0547-4cb6-b771-2383b4121f01"],

Cell[TextData[{
 "The position is given as a 1-indexed pair ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["row", "TI"], ",", " ", 
    StyleBox["col", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "94073bdb-d5f2-4def-a374-4d95a20afe2f"],
 " measured from the top-left corner of the Young diagram."
}], "Notes",
 CellID->231465331,ExpressionUUID->"97d9f6b0-b961-4ae2-a082-dffbdfb3d34f"],

Cell[TextData[{
 "The leg length is read from ",
 Cell[BoxData[
  ButtonBox["TransposePartition",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TransposePartition"]], 
  "InlineFormula",ExpressionUUID->"ff27d2f4-8edd-4964-a197-390cb8b902b8"],
 " of the tableau shape; the arm length is read directly from the row."
}], "Notes",
 CellID->989779741,ExpressionUUID->"a0523942-5953-49e8-b4d3-ddb6e28c794c"],

Cell[TextData[{
 "Hook lengths drive the hook-length formula for the dimension of an \
irreducible representation of the symmetric group: ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", 
   FractionBox[
    RowBox[{
     StyleBox["n", "TI"], "!"}], 
    RowBox[{"\[Product]", " ", 
     SubscriptBox[
      StyleBox["h", "TI"], 
      RowBox[{
       StyleBox["i", "TI"], ",", 
       StyleBox["j", "TI"]}]]}]]}]], "InlineFormula",ExpressionUUID->
  "e4757e14-35b6-4cf8-8a84-434436678acf"],
 " where ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["h", "TI"], 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}]]], "InlineFormula",ExpressionUUID->
  "6f887a13-294d-488a-bdca-98ce50bf4251"],
 " is ",
 Cell[BoxData[
  ButtonBox["HookLength",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookLength"]], 
  "InlineFormula",ExpressionUUID->"b0b68de0-a09b-4a87-8e22-9ed14a1aa7a1"],
 " at cell ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "dc015b70-6358-4917-aaa2-181c80b15ace"],
 "."
}], "Notes",
 CellID->489670234,ExpressionUUID->"099a4b49-0dd2-4109-9d64-486644535688"],

Cell[TextData[{
 "For the partition ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", " ", "2"}], "}"}]], "InlineFormula",ExpressionUUID->
  "fb012df1-a277-4fdc-80f9-de314048646a"],
 " the hook lengths fill the diagram as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"4", ",", " ", "3", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "1"}], "}"}]}], "}"}]], "InlineFormula",
  ExpressionUUID->"9e6e4b55-aae6-462f-99e0-1121c4e35ea1"],
 "; the top-right corner cell ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "3"}], "}"}]], "InlineFormula",ExpressionUUID->
  "172f24e2-ba30-48e6-b9db-2c8d95aba907"],
 " always has hook length 1."
}], "Notes",
 CellID->249175810,ExpressionUUID->"4ab10347-c022-4927-914d-2e9eff3c9d01"],

Cell[TextData[{
 "Sweeping ",
 Cell[BoxData[
  ButtonBox["HookLength",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookLength"]], 
  "InlineFormula",ExpressionUUID->"bdd0d659-d5c9-417f-86e6-4df398771114"],
 " over every cell of a tableau reproduces ",
 Cell[BoxData[
  ButtonBox["HookLengths",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookLengths"]], 
  "InlineFormula",ExpressionUUID->"b38a42e9-43c0-4ebe-a7b0-67f6863eee54"],
 "; using ",
 Cell[BoxData[
  ButtonBox["HookLengths",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookLengths"]], 
  "InlineFormula",ExpressionUUID->"82baa161-2beb-40ae-a2a4-5ce5b8076d7a"],
 " directly is faster when all cells are needed."
}], "Notes",
 CellID->139574301,ExpressionUUID->"9e212ceb-b070-4fe6-941d-a8bf27799a67"],

Cell[TextData[{
 "Non-",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"b9064822-0b86-4269-8492-53f07aa3a09c"],
 " input issues ",
 Cell[BoxData[
  RowBox[{"HookLength", "::", "noyt"}]], "InlineFormula",ExpressionUUID->
  "d9acab6f-fbb5-4d77-bd7c-fd5544329862"],
 " and returns ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "4e76070b-95eb-4731-8de1-4a029a338b0d"],
 "."
}], "Notes",
 CellID->567945448,ExpressionUUID->"566216db-81c7-4b13-8a44-8f4822ecc396"]
}, Open  ]],

