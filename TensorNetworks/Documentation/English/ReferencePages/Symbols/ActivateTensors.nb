        RowBox[{"-", "0.34966058843392167`"}], ",", "0.9466493772228066`"}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.48240795699145744`"}], ",", "0.10116320880771523`", ",",
         "0.4345732974888721`", ",", "0.5087052010942732`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
       "0.7206975987469231`", ",", "0.9939316893743566`", ",", 
        "0.4784521923178975`", ",", 
        RowBox[{"-", "0.9232708884461172`"}]}], "}"}]}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], "}"}]}], "]"}]], "Output",
 CellLabel->"Out[1]=",
