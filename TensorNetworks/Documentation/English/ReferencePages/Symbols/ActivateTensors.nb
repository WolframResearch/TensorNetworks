Cell["Activate inactive tensor operations in an expression:", "ExampleText",
 CellID->438084562,ExpressionUUID->"1b7cdf17-f2e0-429e-bdb6-3551beb246e7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"A", " ", "=", " ", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"expr", " ", "=", " ", 
   RowBox[{
    RowBox[{"Inactive", "[", "TensorContract", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Inactive", "[", "TensorProduct", "]"}], "[", 
      RowBox[{"A", ",", " ", "B"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}], "}"}]}], "]"}]}]}]}], "Input",
 CellChangeTimes->{3.988228592142045*^9},
 CellLabel->"In[18]:=",
 CellID->128911953,ExpressionUUID->"482df942-9e18-4244-abe9-19a2f4e34592"],

