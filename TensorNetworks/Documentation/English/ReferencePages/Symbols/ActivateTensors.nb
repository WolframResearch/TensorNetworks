Cell["Activate a transpose of an inactive contraction:", "ExampleText",
 CellID->259372422,ExpressionUUID->"3e1b4ab1-05dd-45b6-a190-77576fd20a3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ActivateTensors", "[", 
  RowBox[{
   RowBox[{"Inactive", "[", "Transpose", "]"}], "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Inactive", "[", "TensorContract", "]"}], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Inactive", "[", "TensorProduct", "]"}], "[", 
       RowBox[{"A", ",", " ", "B"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"Cycles", "[", 
