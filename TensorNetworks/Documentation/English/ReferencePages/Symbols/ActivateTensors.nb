Cell["\<\
Hand-build an inactive contraction tree for the trace of a matrix product, \
then activate:\
\>", "ExampleText",
 CellID->999852605,ExpressionUUID->"b8e1d2fa-9748-4b14-82ed-7cd0984f2d50"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BlockRandom", "[", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "101", "]"}], ";", " ", 
    RowBox[{"Q", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ";", " ", 
    RowBox[{"R", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ";", " ", 
    RowBox[{"S", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], " ", "]"}], ";",
   " ", 
  RowBox[{"tree", " ", "=", " ", 
   RowBox[{
    RowBox[{"Inactive", "[", "TensorContract", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Inactive", "[", "TensorProduct", "]"}], "[", 
      RowBox[{"Q", ",", " ", "R", ",", " ", "S"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "5"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "1"}], "}"}]}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->720625785,ExpressionUUID->"aba28300-d9b0-4ba5-8715-73b3a4cefe39"],

