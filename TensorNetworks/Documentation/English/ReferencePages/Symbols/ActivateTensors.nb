Cell["\<\
TensorNetworkContract is ActivateTensors applied to TensorNetworkContraction \
(which by default returns an inactive expression):\
\>", "ExampleText",
 CellID->306183806,ExpressionUUID->"a1dc4b8e-1e66-40c2-9883-82533cd905a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BlockRandom", "[", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "202", "]"}], ";", " ", 
    RowBox[{"U1", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ";", " ", 
    RowBox[{"U2", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], " ", "]"}], ";",
   " ", 
  RowBox[{"tn", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"U1", ",", " ", "U2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "k"}], "}"}]}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->995461501,ExpressionUUID->"f6c5665a-0539-47d9-ab90-3d0ddb591f68"],

