Cell["Activate inactive tensor operations in an expression:", "ExampleText",
 CellID->100000001,ExpressionUUID->"a1000001-0000-0000-0000-000000000001"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"expr", "=", 
  RowBox[{"Inactive", "[", "TensorContract", "]"}], "[", 
  RowBox[{
   RowBox[{"Inactive", "[", "TensorProduct", "]"}], "[", 
   RowBox[{"A", ",", "B"}], "]"}], ",", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], "}"}], "]"}]}], "Input",
 CellLabel->"In[142]:=",
 CellID->100000002,ExpressionUUID->"a1000002-0000-0000-0000-000000000002"],

