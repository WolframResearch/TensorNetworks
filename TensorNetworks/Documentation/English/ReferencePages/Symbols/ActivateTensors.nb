Cell["\<\
BinaryTensorNetwork inserts a SymbolicDeltaProductArray spider at every \
hyper-edge (an index shared by three or more tensors):\
\>", "ExampleText",
 CellID->460241905,ExpressionUUID->"bf7d77f1-d050-44b2-9b31-40fceb7766bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BlockRandom", "[", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
    RowBox[{"T1", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}]}], ";", 
    " ", 
    RowBox[{"T2", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], 
   " ", "]"}], ";", " ", 
  RowBox[{"tnHyper", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"T1", ",", " ", "T2", ",", " ", "T1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "a", ",", " ", "b"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "c", ",", " ", "d"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "e", ",", " ", "f"}], "}"}]}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->605455597,ExpressionUUID->"1a8d7187-6105-45cb-8c04-97195c531540"],

