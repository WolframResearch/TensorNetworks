Cell["\<\
Composing ActivateTensors with EinsteinSummation reproduces the conventional \
matrix product:\
\>", "ExampleText",
 CellID->874426259,ExpressionUUID->"2b80297e-7815-4d1c-a62b-10da166a2997"],

Cell[BoxData[
 RowBox[{"BlockRandom", "[", 
  RowBox[{
   RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
   RowBox[{"M1", " ", "=", " ", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
