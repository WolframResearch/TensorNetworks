Cell["Activate inactive tensor operations in an expression:", "ExampleText",
 CellID->438084562,ExpressionUUID->"1b7cdf17-f2e0-429e-bdb6-3551beb246e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"B", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"expr", " ", "=", " ", 
   RowBox[{
    RowBox[{"Inactive", "[", "TensorContract", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Inactive", "[", "TensorProduct", "]"}], "[", 
      RowBox[{"A", ",", " ", "B"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3"}], "}"}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->128911953,ExpressionUUID->"482df942-9e18-4244-abe9-19a2f4e34592"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"TensorContract"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[TensorContract]"], "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.14818943256807504`"}], ",", 
        RowBox[{"-", "0.21795368025166306`"}], ",", 
        RowBox[{"-", "0.3058612929806812`"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.09251873862870985`"}], ",", "0.11192668407624007`", ",", 
        RowBox[{"-", "0.42166149326522095`"}]}], "}"}]}], "}"}], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    RowBox[{"{", 
