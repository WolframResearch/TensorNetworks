Notebook[{

Cell[CellGroupData[{
Cell["ActivateTensors", "ObjectName",
 CellID->490324697,ExpressionUUID->"8c4fb9ab-8e03-4a95-9640-fad4b51d81bc"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2bef6887-d577-4fcf-8a01-d3ad1496d8ec"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ActivateTensors",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/ActivateTensors"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "af12cd9e-652b-493c-bd32-ad5bdae0605d"],
 "\[LineSeparator]activates ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Inactive",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Inactive"], "[", 
   ButtonBox["TensorProduct",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/TensorProduct"], "]"}]], "InlineFormula",
  ExpressionUUID->"917b8529-76aa-4fac-9da2-3a6333768a73"],
 ", ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Inactive",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Inactive"], "[", 
   ButtonBox["TensorContract",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/TensorContract"], "]"}]], "InlineFormula",
  ExpressionUUID->"2ae22687-28ab-4d5e-b2db-488c12874fbf"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Inactive",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Inactive"], "[", 
   ButtonBox["Transpose",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Transpose"], "]"}]], "InlineFormula",
  ExpressionUUID->"04670c63-44e0-464c-9018-c84c07740113"],
 " in ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "e6d37703-b149-45a8-b7c5-d51fb4f3f0f1"],
 ", returning the evaluated tensor."
}], "Usage",
 CellID->965925690,ExpressionUUID->"8f304118-3de8-4b8f-b29f-89b470c6fa5d"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ActivateTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ActivateTensors"]], 
  "InlineFormula",ExpressionUUID->"92c72a31-23f2-4f0d-a08f-cc71ce306eab"],
 " runs the activation in two passes. The inner pass activates ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorContract"]], "InlineFormula",ExpressionUUID->
  "54c562fe-7cac-4635-9ff0-1c6ce5a34282"],
 " only; the outer pass activates remaining heads, including ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorProduct"]], "InlineFormula",ExpressionUUID->
  "c7fc5fc3-d09b-41d2-bded-04df44feffed"],
 " and ",
 Cell[BoxData[
  ButtonBox["Transpose",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Transpose"]], "InlineFormula",ExpressionUUID->
  "7b98daf4-af16-410e-af8b-772579a3d6d8"],
 ". Two passes are required because activating the outer ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorProduct"]], "InlineFormula",ExpressionUUID->
  "4e1c9ddc-5989-4a5d-b12b-16ce98b0ac5a"],
 " can expose new ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorContract"]], "InlineFormula",ExpressionUUID->
  "bc74902a-cbe1-4604-a54d-eb2e68f4199f"],
 " heads inside."
}], "Notes",
 CellID->348285897,ExpressionUUID->"2eec9200-b874-4fa2-a94b-d862bc5cb32f"],

Cell[TextData[{
 "Before activation the expression is rewritten by two replacement rules. ",
 Cell[BoxData[
  RowBox[{"GeneralizedPower", "[", 
   ButtonBox["TensorProduct",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/TensorProduct"], ",", 
   StyleBox["t", "TI"], ",", 
   StyleBox["n", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "73dc32e1-6ea3-409f-ac03-993633036e02"],
 " expands to a ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorProduct"]], "InlineFormula",ExpressionUUID->
  "4eb9309f-a9d1-46ce-a5cd-9c20432630ad"],
 " of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "3f68439a-0a02-4fcd-b404-7893dc36b829"],
 " copies of ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "829b3b36-13c7-4fa3-a78d-d9b12573627c"],
 ". This pattern arises in ",
 Cell[BoxData[
  ButtonBox["EinsteinSummation",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/EinsteinSummation"]], 
  "InlineFormula",ExpressionUUID->"9d299ba5-0e99-4767-9897-530258dccad1"],
 " when an output index appears more times than in any input \[LongDash] the \
multiplicity broadcasting case."
}], "Notes",
 CellID->571749302,ExpressionUUID->"6b7d5a07-73f7-4bca-b3fb-333798dd802b"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SymbolicIdentityArray",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/SymbolicIdentityArray"]], 
  "InlineFormula",ExpressionUUID->"4964753d-8bb1-4527-a847-9177470ad267"],
 " and ",
 Cell[BoxData[
  ButtonBox["SymbolicDeltaProductArray",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/TensorNetworks/ref/SymbolicDeltaProductArray"]], 
  "InlineFormula",ExpressionUUID->"37ad033c-210d-45a5-bf88-bbbd9b2de9ba"],
 " are converted via ",
 Cell[BoxData[
  ButtonBox["Normal",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Normal"]], "InlineFormula",ExpressionUUID->
  "76803a55-5d8b-4b61-8700-478daa3f77c2"],
 " before activation. Those symbolic forms are not numerically evaluable, so \
the contraction primitives cannot reduce them in place. ",
 Cell[BoxData[
  ButtonBox["BinaryTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"e0f5c73b-8bbd-4759-b817-1ee6d0d24866"],
 " introduces ",
 Cell[BoxData[
  ButtonBox["SymbolicDeltaProductArray",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/TensorNetworks/ref/SymbolicDeltaProductArray"]], 
  "InlineFormula",ExpressionUUID->"9b5a66a4-719a-4277-824b-0e7b77dda213"],
 " spider tensors at every hyper-edge."
}], "Notes",
 CellID->553828313,ExpressionUUID->"7efcb916-34ec-4e7a-9eb1-8262130df0b7"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  ButtonBox["ActivateTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ActivateTensors"]], 
  "InlineFormula",ExpressionUUID->"bbf4c5ee-6b5e-4085-9dbc-286755a728aa"],
 " to collapse the symbolic contraction tree returned by ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
   "InlineFormula",ExpressionUUID->"0af24088-fab6-4392-a2b6-636ae18ae708"],
 " into a numerical tensor. The shortcut ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"063190d9-f7c8-4029-ba76-ee185d794594"],
 " is ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContraction",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"],
    "[", 
   StyleBox["\[Ellipsis]", "TI"], ",", "\"\<Inactive\>\"", "->", 
   ButtonBox["False",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/False"], "]"}]], "InlineFormula",ExpressionUUID->
  "56851305-6e10-4c03-a76d-bcef464afcd5"],
 ", which is equivalent to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ActivateTensors",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/ActivateTensors"], "[", 
   ButtonBox["TensorNetworkContraction",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"],
    "[", 
   StyleBox["\[Ellipsis]", "TI"], "]", "]"}]], "InlineFormula",ExpressionUUID->
  "42016497-edae-46c4-8215-6d77788d87dd"],
 "."
}], "Notes",
 CellID->184915461,ExpressionUUID->"8cb1b991-7015-4668-bac2-da82c4b0e092"],

Cell[TextData[{
 "Expressions with no ",
 Cell[BoxData[
  ButtonBox["Inactive",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Inactive"]], "InlineFormula",ExpressionUUID->
  "e98af549-4841-4a8a-8a6f-2dbceb00fd27"],
 " heads pass through unchanged."
}], "Notes",
 CellID->492646041,ExpressionUUID->"b0993abc-898a-4864-82cb-b6029b871704"]
}, Open  ]],

