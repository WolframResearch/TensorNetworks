Cell["GreedyContractionPath", "ObjectName",ExpressionUUID->"58d88825-eca1-4b09-9a31-6794c91fed6b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"753c23e0-c672-4512-8451-6bf282db4093"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GreedyContractionPath",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/GreedyContractionPath"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "f7231720-de28-40ae-ad46-a9732e96e5b6"],
 "\[LineSeparator]finds a contraction path through the TensorNetwork tn using \
a greedy heuristic. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a8a5c209-1c43-4a2d-a8d8-2127e86e8972"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GreedyContractionPath",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/GreedyContractionPath"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "24b491b7-2f87-4624-93c0-aded20d49ee6"],
 "\[LineSeparator]finds a path for a TensorNetwork graph. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"8142536e-c699-4891-9674-0793244f5d6d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GreedyContractionPath",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/GreedyContractionPath"], "[", 
   RowBox[{
    StyleBox["inputs", "TI"], ",", 
    StyleBox["output", "TI"], ",", 
    StyleBox["sizeDict", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fd0c7dae-0e98-49ac-ae68-aeba3840e528"],
 "\[LineSeparator]low-level form taking explicit per-tensor index lists, the \
output indices and a size-per-index Association."
}], "Usage",ExpressionUUID->"ef0195aa-002d-4036-b34a-bd1ab62f56b8"],

