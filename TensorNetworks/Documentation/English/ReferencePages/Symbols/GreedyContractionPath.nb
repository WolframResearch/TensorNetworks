Cell["Find a greedy contraction path for a small random network:", \
"ExampleText",ExpressionUUID->"3130c60a-ccef-422d-9363-98548845f7c0"],

Cell[BoxData[
 RowBox[{"tn", "=", 
  RowBox[{"RandomTensorNetwork", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"4", ",", "5"}], "}"}], ",", "3"}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"f1cf0b30-f430-4cca-89ef-4a454ea91095"],

Cell[BoxData[
 RowBox[{"GreedyContractionPath", "[", "tn", "]"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"156350bb-4f1f-4791-90e6-207e68f9d6fa"],

Cell["Tune the heuristic with the \"MemoryWeight\" option:", "ExampleText",
 CellID->654969832,ExpressionUUID->"d1d88456-426b-4753-ac98-0f7db1e8cb79"],

Cell[BoxData[
 RowBox[{"GreedyContractionPath", "[", 
  RowBox[{"tn", ",", 
   RowBox[{"\"\<MemoryWeight\>\"", "->", "0.5"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"2d1cc454-cd9e-4381-88b6-f1bdbb6b247b"],

Cell["Use a fixed RandomSeed for reproducibility:", "ExampleText",ExpressionUUID->"1e63aeb0-e50b-417d-895c-b8388b0380d4"],

Cell[BoxData[
 RowBox[{"GreedyContractionPath", "[", 
  RowBox[{"tn", ",", 
   RowBox[{"\"\<RandomSeed\>\"", "->", "42"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1464857440,ExpressionUUID->"e6cf9139-94ab-4195-a177-359265dbf30e"],

