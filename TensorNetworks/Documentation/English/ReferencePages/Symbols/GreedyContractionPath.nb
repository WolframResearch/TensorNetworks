Cell["GreedyContractionPath", "ObjectName",
 CellID->543117191,ExpressionUUID->"62d6fd00-e6e1-4d3a-82a4-243263ee67f6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0150e312-ee96-4d7f-83ac-1f2041561b9e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GreedyContractionPath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e8d01a2b-c6ef-44e3-ad15-89e3d29233e9"],
 "\[LineSeparator]finds a contraction path through the TensorNetwork ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "336decbc-ac54-41de-8ffd-6d79f8d44e30"],
 " using a greedy cost-minimization heuristic. ",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"353b64ee-3ce4-465f-9f3b-730636a7e98e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GreedyContractionPath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2fe2f9de-87c3-43cd-af66-069fda20a862"],
 "\[LineSeparator]finds a path for a TensorNetwork ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "4e218064-d115-4a8e-81ad-a8510ba1db6e"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2d90af73-d99b-4c5b-b7f8-e9a598e40087"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GreedyContractionPath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"], "[", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"\"\<Dimensions\>\"", "\[Rule]", 
     StyleBox["dims", "TI"], ",", "\"\<Indices\>\"", "\[Rule]", 
     StyleBox["inds", "TI"], ",", "\"\<Contractions\>\"", "\[Rule]", 
     StyleBox["cs", "TI"]}], "\[RightAssociation]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"9154f23a-d5fb-401f-94ce-fcfdd1bdc516"],
 "\[LineSeparator]finds a path from explicit network data in association \
form. ",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7795076f-c10d-4ca6-91c7-d56d68f7d326"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GreedyContractionPath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e0229562-1556-4112-a2ec-fdd3cdc20adb"],
 "\[LineSeparator]finds a path for an ",
 Cell[BoxData[
  ButtonBox["Inactive",
   BaseStyle->"Link",
