Cell[TextData[{
 "The greedy heuristic is not provably optimal.  On small networks where ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"fff0e21f-01ca-4202-b7df-0d00354a739e"],
 " is fast enough, prefer it:"
}], "ExampleText",
