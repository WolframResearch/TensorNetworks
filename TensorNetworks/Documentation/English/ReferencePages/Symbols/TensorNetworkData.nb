Cell["Get the complete data of a tensor network as an association:", \
"ExampleText",
 CellID->600001001,ExpressionUUID->"9fc70d1a-e58b-447f-8460-89f0df4d164e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"t1", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"1", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t2", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"1", ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t3", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"1", ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t4", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"1", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"indices", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"idx1", ",", " ", "idx2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"idx2", ",", " ", "idx3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"idx3", ",", " ", "idx1"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"tn", " ", "=", " ", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t1", ",", "t2", ",", " ", "t3"}], "}"}], ",", " ", "indices"}], 
   "]"}]}]}], "Input",
