Cell[TextData[{
 "Each key is also reachable through property dispatch on the ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"d5b47e75-0a5e-4725-81d3-c885b7e65e00"],
 " object: ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkData",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkData"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "5f1f3bbb-e261-439a-b6d1-d985d54d456d"],
 " is equivalent to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Data\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"bae58bd6-304a-45db-bd6e-f4fbf331a31a"],
 ", and individual entries can be retrieved as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<\>", 
   StyleBox["Key", "TI"], "\"\<\>", "]"}]], "InlineFormula",ExpressionUUID->
  "eb7cdbab-51ef-4f7f-bad9-1cb92a068910"],
 "."
}], "Notes",
 CellID->43408292,ExpressionUUID->"1de471a2-eaca-4eab-b62b-8d17b28ce935"],

Cell[TextData[{
 "The result of ",
 Cell[BoxData[
  ButtonBox["TensorNetworkData",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkData"]], 
  "InlineFormula",ExpressionUUID->"44621ba9-e78d-4d63-b67f-172b67f1b099"],
 " is cached on first call through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Data\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"02949e1c-450f-42d2-abaa-d11f9583ee07"],
 ", so repeated access from any of the per-key dispatch shortcuts (",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Indices\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"4bd3dd44-e933-4c53-8e51-431fa92307fc"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Bonds\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"69981236-3892-43de-ba1f-0f7dcf83e94a"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Contractions\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"0ee74151-6f12-4fbf-a314-7f57347d0fe2"],
 ", ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<ContractionIndices\>\"", "]"}]], 
  "InlineFormula",ExpressionUUID->"7a79c62a-da1d-4807-aaf5-e8337edd1cc6"],
 ") is free after the first evaluation."
}], "Notes",
 CellID->231369246,ExpressionUUID->"46ef400f-cc20-45b3-b07e-bed817941146"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<Indices\>\""], "InlineFormula",ExpressionUUID->
  "36d6b160-0569-4bad-9969-2c81770001d3"],
 " and ",
 Cell[BoxData["\"\<Contractions\>\""], "InlineFormula",ExpressionUUID->
  "885a1bbe-6ec9-48dc-8c83-282562488ba4"],
 " keys carry the qualified form ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Superscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Superscript"], "[", 
   StyleBox["v", "TI"], ",", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "68e97dbb-bebf-4057-bf6a-5d6df590eea3"],
 ", which records both the tensor index ",
 Cell[BoxData[
  StyleBox["v", "TI"]], "InlineFormula",ExpressionUUID->
  "e0d267d4-58fa-4a52-8240-f975d03431f5"],
 " and the raw hyperedge label ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "2f765905-d37e-42b0-8963-c384ef7ec76e"],
 "; ",
 Cell[BoxData["\"\<Hyperedges\>\""], "InlineFormula",ExpressionUUID->
  "fd1736a6-eb2c-4a35-99bd-7177f19fe561"],
 " and ",
 Cell[BoxData["\"\<ContractionIndices\>\""], "InlineFormula",ExpressionUUID->
  "e356f341-6f26-43cb-95dc-21300112de32"],
 " carry only the raw label."
}], "Notes",
 CellID->145428327,ExpressionUUID->"b699fae2-f656-4ea7-987f-a07a74f45600"]
}, Open  ]],

