     Cell[TextData[
       {"Each key is also reachable through property dispatch on the ", 
        Cell[BoxData[ButtonBox["TensorNetwork", BaseStyle -> "Link", 
           ButtonData -> "paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
         "InlineFormula", ExpressionUUID -> 
          "d5b47e75-0a5e-4725-81d3-c885b7e65e00"], " object: ", 
        Cell[BoxData[RowBox[{ButtonBox["TensorNetworkData", 
             BaseStyle -> "Link", ButtonData -> 
              "paclet:Wolfram/TensorNetworks/ref/TensorNetworkData"], "[", 
            StyleBox["tn", "TI"], "]"}]], "InlineFormula", 
         ExpressionUUID -> "5f1f3bbb-e261-439a-b6d1-d985d54d456d"], 
        " is equivalent to ", Cell[BoxData[RowBox[{StyleBox["tn", "TI"], "[", 
            "\"Data\"", "]"}]], "InlineFormula", ExpressionUUID -> 
          "bae58bd6-304a-45db-bd6e-f4fbf331a31a"], 
        ", and individual entries can be retrieved as ", 
        Cell[BoxData[RowBox[{StyleBox["tn", "TI"], "[", "\"", 
            StyleBox["Key", "TI"], "\"", "]"}]], "InlineFormula", 
         ExpressionUUID -> "eb7cdbab-51ef-4f7f-bad9-1cb92a068910"], "."}], 
      "Notes", CellID -> 43408292, ExpressionUUID -> 
       "1de471a2-eaca-4eab-b62b-8d17b28ce935"], 
     Cell[TextData[{"The result of ", 
        Cell[BoxData[ButtonBox["TensorNetworkData", BaseStyle -> "Link", 
           ButtonData -> 
