         ExpressionUUID -> "fd1736a6-eb2c-4a35-99bd-7177f19fe561"], " and ", 
        Cell[BoxData["\"ContractionIndices\""], "InlineFormula", 
         ExpressionUUID -> "e356f341-6f26-43cb-95dc-21300112de32"], 
        " carry only the raw label."}], "Notes", CellID -> 145428327, 
      ExpressionUUID -> "b699fae2-f656-4ea7-987f-a07a74f45600"]}, Open]], 
