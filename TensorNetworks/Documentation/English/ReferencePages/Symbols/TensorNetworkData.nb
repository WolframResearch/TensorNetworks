        Cell[BoxData[RowBox[{StyleBox["tn", "TI"], "[", "\"Contractions\"", 
            "]"}]], "InlineFormula", ExpressionUUID -> 
          "0ee74151-6f12-4fbf-a314-7f57347d0fe2"], ", ", 
        Cell[BoxData[RowBox[{StyleBox["tn", "TI"], "[", 
            "\"ContractionIndices\"", "]"}]], "InlineFormula", 
         ExpressionUUID -> "7a79c62a-da1d-4807-aaf5-e8337edd1cc6"], 
        ") is free after the first evaluation."}], "Notes", 
      CellID -> 231369246, ExpressionUUID -> 
       "46ef400f-cc20-45b3-b07e-bed817941146"], 
     Cell[TextData[{"The ", Cell[BoxData["\"Indices\""], "InlineFormula", 
         ExpressionUUID -> "36d6b160-0569-4bad-9969-2c81770001d3"], " and ", 
        Cell[BoxData["\"Contractions\""], "InlineFormula", 
