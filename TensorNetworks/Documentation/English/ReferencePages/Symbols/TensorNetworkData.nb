        " keys carry the qualified form ", 
        Cell[BoxData[RowBox[{ButtonBox["Superscript", BaseStyle -> "Link", 
             ButtonData -> "paclet:ref/Superscript"], "[", 
            StyleBox["v", "TI"], ",", StyleBox["k", "TI"], "]"}]], 
