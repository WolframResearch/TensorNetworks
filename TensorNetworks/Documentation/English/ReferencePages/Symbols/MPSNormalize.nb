Notebook[{

Cell[CellGroupData[{
Cell["MPSNormalize", "ObjectName",
 CellID->550131370,ExpressionUUID->"c5ec643f-f09a-47b5-9e2d-6d5a07badebd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2e36c429-8cc6-4d74-927e-8b8ef608e30a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSNormalize",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNormalize"], "[", 
   StyleBox["mps", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "936e46b5-1ac8-4975-8fff-cb1a6b8b6e70"],
 "\[LineSeparator]rescales the MPS ",
 Cell[BoxData[
  StyleBox["mps", "TI"]], "InlineFormula",ExpressionUUID->
  "17969d75-fa7b-4b6b-ba99-f39838304329"],
 " to unit norm by dividing every tensor by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSNorm",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"], "[", 
   StyleBox["mps", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "82904fac-c6a4-436e-9c65-e03d29adad3f"],
 Cell[BoxData[
  SuperscriptBox["", 
   RowBox[{"1", "/", 
    StyleBox["n", "TI"]}]]], "InlineFormula",ExpressionUUID->
  "0def4c09-18e9-4cd5-adf4-ffe961e16026"],
 "."
}], "Usage",
 CellID->353581795,ExpressionUUID->"d5049fc2-5e7c-4f86-ba53-851d58ef68ef"],

Cell[TextData[{
 "Every tensor in the network is divided by the same per-site factor ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{
    ButtonBox["MPSNorm",
     BaseStyle->"Link",
     ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"], "[", 
    StyleBox["mps", "TI"], "]"}], 
   RowBox[{"1", "/", 
    StyleBox["n", "TI"]}]]], "InlineFormula",ExpressionUUID->
  "33c50464-34ff-4a47-9589-cd79916b1ed2"],
 ", where ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "228967d8-017f-46ab-8a3f-f7686a28471e"],
 " is the length of ",
 Cell[BoxData[
  StyleBox["mps", "TI"]], "InlineFormula",ExpressionUUID->
  "e06d359b-6cf8-4b8e-8df1-61970ad45ce6"],
 ". The rescale is distributed symmetrically and does not concentrate the \
scale factor on any single boundary site."
}], "Notes",
 CellID->146356434,ExpressionUUID->"71479549-5630-4312-85ed-5183f1836236"],

Cell[TextData[{
 "After rescaling, ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSNorm",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"], "[", 
   ButtonBox["MPSNormalize",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNormalize"], "[", 
   StyleBox["mps", "TI"], "]", "]"}]], "InlineFormula",ExpressionUUID->
  "643acf73-aeee-4b18-8201-38016f2e8afa"],
 " equals 1 up to floating-point noise."
}], "Notes",
 CellID->98510946,ExpressionUUID->"925044cb-d18a-4641-a974-30aab94364c8"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSNorm",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"], "[", 
   StyleBox["mps", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "92e26338-16a7-4422-8c8c-882b3783900c"],
 " is exactly zero, ",
 Cell[BoxData[
  ButtonBox["MPSNormalize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNormalize"]], 
  "InlineFormula",ExpressionUUID->"b6f3876c-41a7-45f6-a4a4-960ed8e8188a"],
 " returns ",
 Cell[BoxData[
  StyleBox["mps", "TI"]], "InlineFormula",ExpressionUUID->
  "c74740aa-8ce5-4510-9612-c42f392cbd9c"],
 " unchanged."
}], "Notes",
 CellID->10903666,ExpressionUUID->"fc790fe5-f03f-4b0b-932c-011b0428a4af"],

Cell[TextData[{
 "The tensor shapes are preserved: ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Dimensions",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Dimensions"], "/@", 
   ButtonBox["MPSNormalize",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNormalize"], "[", 
   StyleBox["mps", "TI"], "]", "[", "\"\<Tensors\>\"", "]"}]], 
  "InlineFormula",ExpressionUUID->"2f6a592e-c73a-4fbf-9dbe-6aba5acd30fc"],
 " matches ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Dimensions",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Dimensions"], "/@", 
   StyleBox["mps", "TI"], "[", "\"\<Tensors\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"08609f0b-c589-422c-ab04-c7cd0c6f1ea3"],
 "."
}], "Notes",
 CellID->490158967,ExpressionUUID->"ae805318-00cb-4973-98ed-84975c6f74d1"],

Cell[TextData[{
 "Scaling a single boundary tensor by ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   ButtonBox["MPSNorm",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"], "[", 
   StyleBox["mps", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e39cae02-04ae-4e43-a5f4-7d0cc76e8aa5"],
 " is equivalent up to gauge; the symmetric per-site convention used by ",
 Cell[BoxData[
  ButtonBox["MPSNormalize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNormalize"]], 
  "InlineFormula",ExpressionUUID->"fb64e514-c054-4083-84a2-87ec7ca49922"],
 " is preferred when downstream operations consume the tensors directly."
}], "Notes",
 CellID->438656392,ExpressionUUID->"201d8de9-1d10-44d5-8bd6-b8c70f2766f3"]
}, Open  ]],

