Notebook[{

Cell[CellGroupData[{
Cell["MPSNormalize", "ObjectName",
 CellID->1853654855,ExpressionUUID->"e7f70762-7cfb-447e-92b2-59217a123516"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b77cfc77-bc80-4231-8d32-c3e7238159af"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSNormalize",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/MPSNormalize"], "[", 
   StyleBox["mps", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d4e21207-798c-4028-902d-812df8987adb"],
 "\[LineSeparator]returns an MPS normalized to unit norm. \[Bullet] ",
 Cell[BoxData[
  ButtonBox["After",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "e27321ab-40e0-4ffb-824f-5b4972be655b"],
 " normalization,",
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSNorm",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSNorm"], "[", 
   StyleBox["result", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "12042cce-838e-4cf1-9b7c-1bac0237d264"],
 " \[TildeEqual] 1.0. \[Bullet] The physical state is preserved; only the \
overall scale factor changes."
}], "Usage",
 CellChangeTimes->{{3.9786383729081306`*^9, 3.978638373119913*^9}},
 CellID->831880956,ExpressionUUID->"a7edd0bb-089b-43a5-982f-686a270b150e"],

