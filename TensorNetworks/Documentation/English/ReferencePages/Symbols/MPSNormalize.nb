Cell["\<\
Build a six-site MPS with bond dimension 4 and physical dimension 2, then \
rescale it to unit norm. The result is a new TensorNetwork object with the \
same tensor shapes:\
\>", "ExampleText",
 CellID->343700338,ExpressionUUID->"3412d77f-f00e-4e85-9569-97d778c215e2"],

Cell[BoxData[
 RowBox[{"mps", " ", "=", " ", 
  RowBox[{"BlockRandom", "[", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";", " ", 
