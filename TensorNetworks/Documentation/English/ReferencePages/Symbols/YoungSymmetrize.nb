Cell["\<\
Decompose a rank-2 tensor into its symmetric and antisymmetric pieces using \
the two YoungSymmetrize calls:\
\>", "ExampleText",
 CellID->275929603,ExpressionUUID->"68cd6b2f-2a31-486c-af8b-8c3d732a35ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "5", ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"7", ",", " ", "8", ",", " ", "9"}], "}"}]}], "}"}]}], "}"}], 
   ",", " ", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"\"\<sym\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"YoungSymmetrize", "[", 
        RowBox[{"t", ",", " ", 
         RowBox[{"YoungTableau", "[", 
          RowBox[{"{", "2", "}"}], "]"}]}], "]"}], "/", "2"}]}], ",", " ", 
     RowBox[{"\"\<antisym\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"YoungSymmetrize", "[", 
        RowBox[{"t", ",", " ", 
         RowBox[{"YoungTableau", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}], "]"}], "/", 
       "2"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[9]:=",
 CellID->810519186,ExpressionUUID->"c4da3ec2-07c0-4917-92cc-40be3086f267"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"sym\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "3", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "5", ",", "7"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"5", ",", "7", ",", "9"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"antisym\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1", ",", "0"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[9]=",
 CellID->677209572,ExpressionUUID->"95e92019-02e6-4748-818b-a28f14139686"]
}, Open  ]],

