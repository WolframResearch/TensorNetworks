Cell["\<\
Symmetrize a rank-2 tensor over the row of the totally symmetric tableau {2}; \
the result is the unnormalized symmetric part \!\(\(\*StyleBox[\"t\", \"TI\"]\
\)+\*SuperscriptBox[\(\*StyleBox[\"t\", \"TI\"]\), \"T\"]\):\
\>", "ExampleText",
 CellID->706411693,ExpressionUUID->"63e8d912-3711-4212-8fda-fe373872c921"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungSymmetrize", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", "2", "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->720968092,ExpressionUUID->"d35fe145-27d1-43c6-83a8-2f8f2bc30005"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "8"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->767425063,ExpressionUUID->"276f7705-3114-4345-be95-04c873fd4493"]
}, Open  ]],

Cell["\<\
Antisymmetrize over the column of the totally antisymmetric tableau {1,1}; \
the result is the unnormalized antisymmetric part \!\(\(\*StyleBox[\"t\", \
\"TI\"]\)-\*SuperscriptBox[\(\*StyleBox[\"t\", \"TI\"]\), \"T\"]\):\
\>", "ExampleText",
 CellID->881915684,ExpressionUUID->"18172038-2b90-4a38-9e19-feb0fa5da012"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungSymmetrize", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->132959009,ExpressionUUID->"1e13b8b3-e632-4b59-bb74-a0028396243c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"-", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->786445265,ExpressionUUID->"7033958d-364c-47c7-bdff-7625cdb50cc1"]
}, Open  ]],

Cell["\<\
Apply the mixed-symmetry projector of shape {2,1} to a rank-3 symbolic array:\
\
\>", "ExampleText",
 CellID->173175353,ExpressionUUID->"90334e4f-3c95-48d2-87b7-cf2d8e0dc654"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungSymmetrize", "[", 
  RowBox[{
   RowBox[{"Array", "[", 
    RowBox[{"a", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "1"}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->771321129,ExpressionUUID->"d84b2881-228f-4fbb-98c6-4d37bec52f38"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"a", "[", 
          RowBox[{"1", ",", "1", ",", "2"}], "]"}]}], "-", 
        RowBox[{"a", "[", 
         RowBox[{"1", ",", "2", ",", "1"}], "]"}], "-", 
        RowBox[{"a", "[", 
         RowBox[{"2", ",", "1", ",", "1"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
