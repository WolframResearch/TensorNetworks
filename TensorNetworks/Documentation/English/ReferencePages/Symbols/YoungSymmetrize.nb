Cell["\<\
YoungSymmetrize delivers twice the symmetric or antisymmetric part of a \
rank-2 tensor:\
\>", "ExampleText",
 CellID->253469380,ExpressionUUID->"451135ad-6156-4802-aab9-0b1b69c21a0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"YoungSymmetrize", "[", 
      RowBox[{"t", ",", " ", 
       RowBox[{"YoungTableau", "[", 
        RowBox[{"{", "2", "}"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"YoungSymmetrize", "[", 
      RowBox[{"t", ",", " ", 
       RowBox[{"YoungTableau", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",
