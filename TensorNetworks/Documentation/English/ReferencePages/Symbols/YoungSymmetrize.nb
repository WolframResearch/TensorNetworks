Cell["\<\
Apply YoungSymmetrize with shape {2,1}; the tableau is \
YoungTableau[{{1,2},{3}}], so column 1 contains slot indices {1,3}. Swapping \
those tensor indices flips the sign of the result, confirming column \
antisymmetry survives:\
\>", "ExampleText",
 CellID->33497448,ExpressionUUID->"8e096d90-5b09-4006-979e-c8e702ebbbc8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"t", " ", "=", " ", 
      RowBox[{"Array", "[", 
       RowBox[{"a", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}]}], ",", 
     " ", "sym"}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"sym", " ", "=", " ", 
     RowBox[{"YoungSymmetrize", "[", 
      RowBox[{"t", ",", " ", 
       RowBox[{"YoungTableau", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "1"}], "}"}], "]"}]}], "]"}]}], ";", " ", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{"sym", " ", "+", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"sym", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "2", ",", " ", "1"}], "}"}]}], "]"}]}], 
      "]"}], " ", "===", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->612310210,ExpressionUUID->"36ccb7d4-0de0-4636-b6ca-3899c0529060"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]=",
 CellID->684013741,ExpressionUUID->"a707f8fa-2eba-4131-9ee5-946331dbbfdc"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "YoungProject leaves a Young-symmetrized tensor invariant", 
   "ExampleSubsection",ExpressionUUID->"c80d144d-3b67-48ad-ae7b-822a6923db55"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->998418271,ExpressionUUID->"2c8b6942-1070-44bf-9e92-5d1d81b921ad"],

Cell["\<\
Because the image of YoungSymmetrize already lives in the target irrep, \
applying YoungProject to it reproduces the input:\
\>", "ExampleText",
 CellID->901776430,ExpressionUUID->"e1f817ee-4eef-4aed-968a-3bf2bf98fee4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "yt", ",", " ", "sym"}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "3"}], "}"}]}], "]"}]}], ";", " ", 
    RowBox[{"yt", " ", "=", " ", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", "2", "}"}], "]"}]}], ";", " ", 
    RowBox[{"sym", " ", "=", " ", 
     RowBox[{"YoungSymmetrize", "[", 
      RowBox[{"t", ",", " ", "yt"}], "]"}]}], ";", " ", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"YoungProject", "[", 
          RowBox[{"sym", ",", " ", "yt"}], "]"}], " ", "-", " ", "sym"}], 
        "]"}], "]"}], "]"}], " ", "<", " ", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"-", "12"}], ")"}]}]}]}]}], "]"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->497436519,ExpressionUUID->"f879d578-2972-40e0-b964-c30965cdf2fd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[7]=",
 CellID->485646894,ExpressionUUID->"6697345c-d426-4c02-b430-37107bbbb3a0"]
}, Open  ]]
}, Open  ]],

