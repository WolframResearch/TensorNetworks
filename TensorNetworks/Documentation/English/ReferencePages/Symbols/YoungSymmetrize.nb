Cell["\<\
Recover the original tensor by averaging the two halves; YoungSymmetrize \
delivers exactly twice each part:\
\>", "ExampleText",
 CellID->638979752,ExpressionUUID->"0e3ee96d-b3f1-404d-af09-c79df32a9a1d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "5", ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"7", ",", " ", "8", ",", " ", "9"}], "}"}]}], "}"}]}], "}"}], 
   ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"YoungSymmetrize", "[", 
        RowBox[{"t", ",", " ", 
         RowBox[{"YoungTableau", "[", 
          RowBox[{"{", "2", "}"}], "]"}]}], "]"}], " ", "+", " ", 
       RowBox[{"YoungSymmetrize", "[", 
        RowBox[{"t", ",", " ", 
         RowBox[{"YoungTableau", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}], "]"}]}], ")"}], "/", 
     "2"}], " ", "===", " ", "t"}]}], "]"}]], "Input",
