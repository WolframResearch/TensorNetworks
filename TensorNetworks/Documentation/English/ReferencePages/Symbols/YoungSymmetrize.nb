Cell["\<\
The factor of two is the n!/d shortfall against YoungProject:\
\>", "ExampleText",
 CellID->116411454,ExpressionUUID->"e93cf38f-afff-4de2-ac58-f3e3a33dee0c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"t", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"yt", " ", "=", " ", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", "2", "}"}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"YoungSymmetrize", "[", 
     RowBox[{"t", ",", " ", "yt"}], "]"}], " ", "==", " ", 
