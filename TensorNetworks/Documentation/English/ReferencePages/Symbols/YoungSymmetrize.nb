Notebook[{

Cell[CellGroupData[{
Cell["YoungSymmetrize", "ObjectName",
 CellID->223337487,ExpressionUUID->"ab2d1195-413e-4272-bdb8-4e6303bb74de"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"65afacea-3853-4869-b282-dafac1ebeff2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["YoungSymmetrize",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"], "[", 
   RowBox[{
    StyleBox["tensor", "TI"], ",", 
    StyleBox["tableau", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "77be6a99-953e-419c-8801-27709faa1752"],
 "\[LineSeparator]returns the unnormalized Young-symmetrized ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "07e4ddf8-e403-4300-9342-af1354bb0622"],
 " obtained by first symmetrizing over the rows of ",
 Cell[BoxData[
  StyleBox["tableau", "TI"]], "InlineFormula",ExpressionUUID->
  "d583d981-31d1-4759-94b8-e2025d0ad34e"],
 " and then antisymmetrizing over its columns."
}], "Usage",
 CellID->984669801,ExpressionUUID->"f6cbabe1-62e3-48c5-ae1a-6e06237eff1c"],

Cell[TextData[{
 "The result equals ",
 Cell[BoxData[
  FractionBox[
   RowBox[{
    StyleBox["n", "TI"], "!"}], 
   StyleBox["d", "TI"]]], "InlineFormula",ExpressionUUID->
  "923f33f6-b02c-4b20-bd6a-7cfd436fcde8"],
 " ",
 Cell[BoxData[
  ButtonBox["YoungProject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"]], 
  "InlineFormula",ExpressionUUID->"96149ac9-3fff-4824-ad15-4444b3c098d9"],
 "[",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "928f9d77-1d76-4c43-9c94-c31367521b2d"],
 ", ",
 Cell[BoxData[
  StyleBox["yt", "TI"]], "InlineFormula",ExpressionUUID->
  "aadbf07b-e994-44ee-b74d-96c76fa5a88e"],
 "], where ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "0afa062c-1965-41cf-93cb-c20960356e34"],
 " is ",
 Cell[BoxData[
  ButtonBox["TableauSize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauSize"]], 
  "InlineFormula",ExpressionUUID->"b64ab8a5-2aed-4aaa-b1f8-440d210b2e32"],
 "[",
 Cell[BoxData[
  StyleBox["yt", "TI"]], "InlineFormula",ExpressionUUID->
  "b316b488-cd4b-4cd4-adc3-5f31b67c418e"],
 "] and ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "ec3f3e23-2177-42c2-90c3-d33b5549005d"],
 " is ",
 Cell[BoxData[
  ButtonBox["TableauDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"]], 
  "InlineFormula",ExpressionUUID->"90c42789-1d7b-4356-af59-c652811e6170"],
 "[",
 Cell[BoxData[
  StyleBox["yt", "TI"]], "InlineFormula",ExpressionUUID->
  "15397195-fc56-465c-acdc-6d7dca624f12"],
 "]. ",
 Cell[BoxData[
  ButtonBox["YoungSymmetrize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"]], 
  "InlineFormula",ExpressionUUID->"33b00c49-d273-491e-b3c0-27b45c7f201e"],
 " is the raw Young operator without the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "/", 
   RowBox[{
    StyleBox["n", "TI"], "!"}]}]], "InlineFormula",ExpressionUUID->
  "638b1918-e14d-4942-ae94-bb276755cf7b"],
 " normalization that makes ",
 Cell[BoxData[
  ButtonBox["YoungProject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"]], 
  "InlineFormula",ExpressionUUID->"86a02c0d-abf3-4656-bed0-fe0b41f402d3"],
 " idempotent."
}], "Notes",
 CellID->685904443,ExpressionUUID->"40beda8a-b4fd-4528-aeba-f794ce5b3879"],

Cell[TextData[{
 "The rows are symmetrized first (",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["b", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",ExpressionUUID->
  "f7905b68-fa63-4ddc-91d5-f33180282fb7"],
 "), then the columns are antisymmetrized (",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a", "TI"], 
   StyleBox["T", "TI"]]], "InlineFormula",ExpressionUUID->
  "5c4a0555-e0fb-452d-acb1-c18678b5daf8"],
 "), so that the column antisymmetry of the Young symmetrizer ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["T", "TI"]], "=", 
   SubscriptBox[
    StyleBox["a", "TI"], 
    StyleBox["T", "TI"]], " ", 
   SubscriptBox[
    StyleBox["b", "TI"], 
    StyleBox["T", "TI"]]}]], "InlineFormula",ExpressionUUID->
  "b98c22b8-0c1c-481f-8e06-83b86666ad52"],
 " survives in the output."
}], "Notes",
 CellID->309493800,ExpressionUUID->"305a396e-251b-492b-a3a6-8a8a03d928ec"],

Cell[TextData[{
 "For a rank-2 ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "0622d946-4d6f-46c7-8833-f7829057d562"],
 " and shape ",
 Cell[BoxData[
  RowBox[{"{", "2", "}"}]], "InlineFormula",ExpressionUUID->
  "78c4939e-bbb6-4227-a10f-5acd2e56da4d"],
 ", ",
 Cell[BoxData[
  ButtonBox["YoungSymmetrize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"]], 
  "InlineFormula",ExpressionUUID->"b932a8aa-c178-4aa7-9994-fc6ea735133d"],
 " returns ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "+", 
   $CellContext`TransposeBox[
    StyleBox["t", "TI"]]}]], "InlineFormula",ExpressionUUID->
  "b17831ef-e899-4b85-bf6a-b78da3a7a146"],
 " (twice the symmetric part); for shape ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "1"}], "}"}]], "InlineFormula",ExpressionUUID->
  "e936e7af-a677-4af5-87a2-ade0e03a6566"],
 " it returns ",
 Cell[BoxData[
  RowBox[{
   StyleBox["t", "TI"], "-", 
   $CellContext`TransposeBox[
    StyleBox["t", "TI"]]}]], "InlineFormula",ExpressionUUID->
  "6cb5ac74-7162-4cb0-89f1-2b8bebeaf978"],
 " (twice the antisymmetric part). The factor of two is exactly the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "!", "/", 
   StyleBox["d", "TI"]}]], "InlineFormula",ExpressionUUID->
  "a2144785-bdb9-4bb4-8ddf-6b48798b3d76"],
 " = 2 normalization missing relative to ",
 Cell[BoxData[
  ButtonBox["YoungProject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"]], 
  "InlineFormula",ExpressionUUID->"b524836c-d6ad-4508-b1be-7f319fcf143d"],
 "."
}], "Notes",
 CellID->571753287,ExpressionUUID->"06f6f1bd-cddc-416a-a446-5da56bab59d6"],

Cell[TextData[{
 "The output is unnormalized: applying ",
 Cell[BoxData[
  ButtonBox["YoungSymmetrize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"]], 
  "InlineFormula",ExpressionUUID->"efb77da4-4ce1-4b4e-a6b7-30c558a2aea0"],
 " twice scales the result by an extra factor and is not idempotent. The \
idempotent operator is ",
 Cell[BoxData[
  ButtonBox["YoungProject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"]], 
  "InlineFormula",ExpressionUUID->"999debfb-3d28-47a5-a221-82a93b0f7b29"],
 "; for explicit irrep projectors use that symbol instead."
}], "Notes",
 CellID->40550656,ExpressionUUID->"1b9b1680-6195-46cf-bc1d-93413c8f5697"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "3ced6d20-d156-4f0e-a704-58b0bd35a369"],
 " rank must equal ",
 Cell[BoxData[
  ButtonBox["TableauSize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauSize"]], 
  "InlineFormula",ExpressionUUID->"cd641d79-267f-4a90-bea8-d1f8541b0c14"],
 "[",
 Cell[BoxData[
  StyleBox["tableau", "TI"]], "InlineFormula",ExpressionUUID->
  "730cd94d-1875-4f17-81e7-33b46ea7502b"],
 "]; mismatched ranks issue ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"YoungSymmetrize", "::", "rank"}], "TI"]], "InlineFormula",
  ExpressionUUID->"90751952-a216-4bdc-b91f-d57a6a294533"],
 " and return ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "f3ae2321-d227-4989-90cd-2cf7e66cd5be"],
 ". Inputs whose second argument is not a valid ",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"fc18bf48-bb0e-4dba-b04b-0ae29e38653f"],
 " leave ",
 Cell[BoxData[
  ButtonBox["YoungSymmetrize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"]], 
  "InlineFormula",ExpressionUUID->"c06f2faa-4f24-4e4b-834b-6ff17d805af6"],
 " unevaluated."
}], "Notes",
 CellID->924238015,ExpressionUUID->"079e8d34-020b-4836-852c-5fd0fece14b4"]
}, Open  ]],

