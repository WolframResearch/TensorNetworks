Cell["\<\
For a rank-2 tensor, YoungSymmetrize on shape {2} equals t + Transpose[t]; \
for shape {1,1} it equals t - Transpose[t]:\
\>", "ExampleText",
 CellID->369624580,ExpressionUUID->"2a01d580-d5a8-4dde-b9e9-432e40dfe974"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"YoungSymmetrize", "[", 
       RowBox[{"t", ",", " ", 
        RowBox[{"YoungTableau", "[", 
         RowBox[{"{", "2", "}"}], "]"}]}], "]"}], " ", "===", " ", 
      RowBox[{"t", " ", "+", " ", 
       RowBox[{"Transpose", "[", "t", "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"YoungSymmetrize", "[", 
       RowBox[{"t", ",", " ", 
        RowBox[{"YoungTableau", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}], "]"}], " ", "===", 
      " ", 
      RowBox[{"t", " ", "-", " ", 
       RowBox[{"Transpose", "[", "t", "]"}]}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[13]:=",
 CellID->241061482,ExpressionUUID->"f58092f4-0216-4604-a189-3d63011ba2bf"],

