Cell["\<\
Extract the second slice along the first index of a 3x3 IndexArray:\
\>", "ExampleText",ExpressionUUID->"db5b615c-1049-4d8c-ae9a-07f757c0292a"],

Cell[BoxData[
 RowBox[{"IndexPart", "[", 
  RowBox[{
   RowBox[{"IndexArray", "[", 
    RowBox[{"IdentityMatrix", "[", "3", "]"}], "]"}], ",", 
   RowBox[{"{", "2", "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->392645522,ExpressionUUID->"90781c47-5887-427c-823a-c9d6a85529b1"],

Cell["Empty position list returns the original array:", "ExampleText",ExpressionUUID->"2e273b2e-b7c7-458b-9a7b-85633d1caa1e"],

Cell[BoxData[
 RowBox[{"IndexPart", "[", 
  RowBox[{
   RowBox[{"IndexArray", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}], ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"b74f9c96-a00f-4dc3-a112-8e9ff611fbd1"]
