     RowBox[{"IntegerPartitions", "[", "k", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", "#1", "]"}], "!"}], "*", 
        RowBox[{"HookFactor", "[", "#1", "]"}]}], " ", "===", " ", 
       RowBox[{"TableauDimension", "[", "#1", "]"}]}], " ", "&"}]}], " ", 
    "]"}], ",", " ", 
