Notebook[{

Cell[CellGroupData[{
Cell["HookFactor", "ObjectName",ExpressionUUID->"3bb2113b-0235-4aec-9186-948de0bcd5b4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"609c0702-0617-450a-8f58-7041b47c7b4a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HookFactor",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"], "[", 
   StyleBox["partition", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d01b62ce-ad56-4502-898e-3eb045f05f38"],
 "\[LineSeparator]computes ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   RowBox[{"\[Product]", " ", 
    StyleBox["h", "TI"]}]}]], "InlineFormula",ExpressionUUID->
  "efcdeebf-f869-4d96-83e5-7a6b616cbaea"],
 ", the reciprocal product of the hook lengths of the Young diagram of ",
 StyleBox["partition", "TI"],
 ", evaluated by the Frobenius determinant formula. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"7f10cb92-0a68-4c9a-b5ca-d1d0e31607ce"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HookFactor",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"], "[", 
   StyleBox["tableau", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "fe3ff393-d24d-4743-bfbb-0825b34028f8"],
 "\[LineSeparator]does the same for the underlying partition of a Young ",
 StyleBox["tableau", "TI"],
 "."
}], "Usage",ExpressionUUID->"4eec7a6b-9f95-4343-94f2-82ae229ddb5d"],

Cell[TextData[{
 "The hook-length formula expresses the symmetric-group irrep dimension as ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", 
   FractionBox[
    RowBox[{
     StyleBox["n", "TI"], "!"}], 
    RowBox[{"\[Product]", " ", 
     StyleBox["h", "TI"]}]]}]], "InlineFormula",ExpressionUUID->
  "a1cd06a6-121e-4e4d-8304-96a71765f199"],
 ". ",
 Cell[BoxData[
  ButtonBox["HookFactor",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"]], 
  "InlineFormula",ExpressionUUID->"c0fc3a75-2093-4d44-8bc4-4f58d39c1d52"],
 " is the dimension-free piece ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   RowBox[{"\[Product]", " ", 
    StyleBox["h", "TI"]}]}]], "InlineFormula",ExpressionUUID->
  "bb04d649-6dcc-4a8d-844c-b590a2529e02"],
 " of that formula: the irrep dimension is then ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "!", "\[CenterDot]", 
   ButtonBox["HookFactor",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"], "[", 
   StyleBox["par", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "8a1ecad9-8357-4b03-8025-e76bbef62607"],
 "."
}], "Notes",
 CellID->223337487,ExpressionUUID->"7bbfdc95-3e26-4290-8708-8b9c306a623a"],

Cell[TextData[{
 "Internally ",
 Cell[BoxData[
  ButtonBox["HookFactor",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"]], 
  "InlineFormula",ExpressionUUID->"1b4ed894-2bda-4df7-be53-5be19c55cf0b"],
 " uses the Frobenius determinant form ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["HookFactor",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"], "[", 
   StyleBox["par", "TI"], "]", "=", 
   FractionBox[
    RowBox[{
     UnderscriptBox["\[Product]", 
      RowBox[{
       StyleBox["i", "TI"], "<", 
       StyleBox["j", "TI"]}]], 
     RowBox[{"(", 
      SubscriptBox[
       StyleBox["l", "TI"], 
       StyleBox["i", "TI"]], "-", 
      SubscriptBox[
       StyleBox["l", "TI"], 
       StyleBox["j", "TI"]], ")"}]}], 
    RowBox[{"\[Product]", 
     RowBox[{
      SubscriptBox[
       StyleBox["l", "TI"], 
       StyleBox["i", "TI"]], "!"}]}]]}]], "InlineFormula",ExpressionUUID->
  "13af21d9-d0e5-493d-a12f-200c51285f65"],
 " where ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["l", "TI"], 
    StyleBox["i", "TI"]], "=", 
   StyleBox["par", "TI"], "[", 
   StyleBox["i", "TI"], "]", "+", 
   StyleBox["r", "TI"], "-", 
   StyleBox["i", "TI"]}]], "InlineFormula",ExpressionUUID->
  "e518e5d4-0de3-456c-b305-8a879454e370"],
 " are the strictly decreasing shifted parts and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["r", "TI"], "=", 
   ButtonBox["Length",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Length"], "[", 
   StyleBox["par", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2912618d-51e6-4a18-8aa5-d563cd3f01f8"],
 ". This is ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"\[ScriptCapitalO]", "\[ThinSpace]", 
    RowBox[{"(", 
     StyleBox["r", "TI"], ")"}]}], "2"]], "InlineFormula",ExpressionUUID->
  "c54cdf4d-19c9-4a2c-8940-b6787821ff60"],
 " in the number of rows, faster than the naive ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"\[ScriptCapitalO]", "\[ThinSpace]", 
    RowBox[{"(", 
     StyleBox["n", "TI"], ")"}]}], "2"]], "InlineFormula",ExpressionUUID->
  "b745c1c3-2900-4766-a321-1c5b0d0156f0"],
 " evaluation that explicitly forms every hook length \[LongDash] especially \
for partitions with few rows but many boxes."
}], "Notes",
 CellID->984669801,ExpressionUUID->"ef15f6bb-3007-44fe-b442-204d66413da0"],

Cell[TextData[{
 "The result is a positive rational number bounded above by 1; ",
 Cell[BoxData[
  ButtonBox["HookFactor",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"]], 
  "InlineFormula",ExpressionUUID->"10ba4dff-cbf9-49c4-a6c5-1c9a98153428"],
 " is exactly ",
 Cell[BoxData[
  RowBox[{"1", "/", 
   RowBox[{
    StyleBox["n", "TI"], "!"}]}]], "InlineFormula",ExpressionUUID->
  "31ab2d76-eaa0-4243-aac6-756e3de7f45c"],
 " for both the single-row partition ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["n", "TI"], "}"}]], "InlineFormula",ExpressionUUID->
  "81fcb179-b31a-4c25-aa8c-fe6b8b901149"],
 " (fully symmetric irrep) and the single-column partition ",
 Cell[BoxData[
  RowBox[{"{", "1", ",", "\[Ellipsis]", ",", "1", "}"}]], "InlineFormula",
  ExpressionUUID->"0120721b-e9ae-4a68-a55f-f7d53f5700a2"],
 " (fully antisymmetric irrep)."
}], "Notes",
 CellID->685904443,ExpressionUUID->"797f6ae0-3bee-404d-8021-873585ad3f94"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["HookFactor",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"], "[", 
   StyleBox["yt", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "0a8f93f3-1256-4c49-a9f7-f94c76b16f5d"],
 " is shorthand for ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["HookFactor",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"], "[", 
   ButtonBox["TableauShape",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"], "[", 
   StyleBox["yt", "TI"], "]", "]"}]], "InlineFormula",ExpressionUUID->
  "4f5ce08b-b385-40ca-b501-c26c7b60a3ae"],
 ": the value depends only on the shape of the tableau, never on the \
particular filling of its boxes."
}], "Notes",
 CellID->309493800,ExpressionUUID->"f3d015b6-ef16-4a9c-ad0f-ec08a30edd50"],

Cell[TextData[{
 "Conjugation preserves the value: ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["HookFactor",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"], "[", 
   StyleBox["par", "TI"], "]", "===", 
   ButtonBox["HookFactor",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"], "[", 
   ButtonBox["TransposePartition",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TransposePartition"], "[", 
   
   StyleBox["par", "TI"], "]", "]"}]], "InlineFormula",ExpressionUUID->
  "a303dbb2-14fc-4299-9f6f-de0285087ee1"],
 ". A partition and its transpose label dual irreps of the symmetric group; \
both have the same dimension and the same ",
 Cell[BoxData[
  ButtonBox["HookFactor",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"]], 
  "InlineFormula",ExpressionUUID->"c42194d3-1ffc-4436-bfff-465ef0b8e574"],
 "."
}], "Notes",
 CellID->571753287,ExpressionUUID->"0b855fe2-3602-41b4-9af6-dff9d6a9d87d"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["HookFactor",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"]], 
  "InlineFormula",ExpressionUUID->"72b214b8-f8f8-4e3f-baa7-d9dba7a7843e"],
 " returns ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "5cae5747-6e3f-4fb6-9be7-e4dd76978ec3"],
 " and emits ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"HookFactor", "::", "notpar"}], "MR"]], "InlineFormula",
  ExpressionUUID->"5d8457f7-46c5-40be-be57-a89939a2b0eb"],
 " when given anything other than an integer partition (a list of weakly \
decreasing positive integers) or a Young tableau."
}], "Notes",
 CellID->40550656,ExpressionUUID->"8475d16c-8aaf-4566-8354-f27adf83a909"]
}, Open  ]],

