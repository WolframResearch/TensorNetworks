 CellID->478423877,ExpressionUUID->"9d4b1908-bddb-4693-bdd5-2d3f54741059"],

Cell["\<\
Cache HookFactor over the partitions of n to amortize repeated dimension \
queries; for n = 8 the cache is just 22 rationals:\
\>", "ExampleText",
 CellID->109865355,ExpressionUUID->"ec6b30c3-a6ac-4731-867c-595f9cb3c73c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AssociationThread", "[", 
  RowBox[{
   RowBox[{"IntegerPartitions", "[", "8", "]"}], " ", "->", " ", 
   RowBox[{"HookFactor", " ", "/@", " ", 
    RowBox[{"IntegerPartitions", "[", "8", "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->875289481,ExpressionUUID->"936c493d-8b97-4c90-abf3-8397c2786c23"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "8", "}"}], "\[Rule]", 
    FractionBox["1", "40320"]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"7", ",", "1"}], "}"}], "\[Rule]", 
    FractionBox["1", "5760"]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"6", ",", "2"}], "}"}], "\[Rule]", 
    FractionBox["1", "2016"]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"6", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
    FractionBox["1", "1920"]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"5", ",", "3"}], "}"}], "\[Rule]", 
    FractionBox["1", "1440"]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"5", ",", "2", ",", "1"}], "}"}], "\[Rule]", 
    FractionBox["1", "630"]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"5", ",", "1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
    FractionBox["1", "1152"]}], ",", 
   RowBox[{
    RowBox[{"{", 
