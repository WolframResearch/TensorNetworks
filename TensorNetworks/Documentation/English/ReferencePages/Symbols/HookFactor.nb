Cell["\<\
Build the full table of irrep dimensions for S_5 by multiplying HookFactor by \
5!:\
\>", "ExampleText",
 CellID->488247794,ExpressionUUID->"37af4a80-672c-41ce-b30b-f8d94c81e117"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AssociationThread", "[", 
  RowBox[{
   RowBox[{"IntegerPartitions", "[", "5", "]"}], " ", "->", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"5", "!"}], "*", 
       RowBox[{"HookFactor", "[", "#1", "]"}]}], " ", "&"}], " ", ")"}], " ", 
    "/@", " ", 
    RowBox[{"IntegerPartitions", "[", "5", "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->660282859,ExpressionUUID->"8cec24c4-cc52-4f5d-8efa-7640cf379cb1"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "5", "}"}], "\[Rule]", "1"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"4", ",", "1"}], "}"}], "\[Rule]", "4"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "2"}], "}"}], "\[Rule]", "5"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "1", ",", "1"}], "}"}], "\[Rule]", "6"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "2", ",", "1"}], "}"}], "\[Rule]", "5"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "1", ",", "1", ",", "1"}], "}"}], "\[Rule]", "4"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
    "1"}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->76739115,ExpressionUUID->"fedbfb4a-4b7e-4094-bd49-db7dbf66d2a9"]
}, Open  ]],

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "c9435e24-6552-46f8-8994-3ada6c81eaa7"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->947876932,ExpressionUUID->"e18dd744-3eb1-44d9-b295-6e8a57b78ad4"],

Cell[TextData[{
 "The sum-of-squares identity ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["par", "TI"]], 
   SuperscriptBox[
    StyleBox["d", "TI"], "2"], "=", 
   RowBox[{
    StyleBox["n", "TI"], "!"}]}]], "InlineFormula",ExpressionUUID->
  "27792780-1533-47f4-aff5-1e8f1fabd829"],
 " rewrites entirely in terms of HookFactor as ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["par", "TI"]], 
   SuperscriptBox[
    RowBox[{
     RowBox[{
      StyleBox["n", "TI"], "!"}], "\[CenterDot]", 
     ButtonBox["HookFactor",
      BaseStyle->"Link",
      ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"], "[", 
     StyleBox["par", "TI"], "]"}], "2"], "=", 
   RowBox[{
    StyleBox["n", "TI"], "!"}]}]], "InlineFormula",ExpressionUUID->
  "766b0493-51a1-4c50-80bd-b6fd66e2bfaf"],
 "; verified for n = 5:"
}], "ExampleText",
 CellID->325452594,ExpressionUUID->"0407d88c-f8da-4af1-82f6-10768bf608f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"5", "!"}], "*", 
        RowBox[{"HookFactor", "[", "#1", "]"}]}], ")"}], "^", "2"}], " ", 
     "&"}], " ", ")"}], " ", "/@", " ", 
   RowBox[{"IntegerPartitions", "[", "5", "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->53675367,ExpressionUUID->"095bb4ff-b29c-4852-a3d6-9876c5bfad2e"],

Cell[BoxData["120"], "Output",
 CellLabel->"Out[2]=",
 CellID->977923689,ExpressionUUID->"066666c0-e5cf-43d4-870b-79434b451b59"]
}, Open  ]],

