Cell["\<\
Pre-compute a contraction path once and reuse it for an ensemble of \
structurally identical networks. For ensembles of size O(100), the \
path-search amortizes to zero per-instance cost:\
\>", "ExampleText",
 CellID->458113666,ExpressionUUID->"d82df936-8a99-41e3-9a84-55c9226e2130"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";", " ", 
  RowBox[{"tens1", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", "4"}], 
    "]"}]}], ";", " ", 
  RowBox[{"tens2", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", "4"}], 
    "]"}]}], ";", " ", 
  RowBox[{"ensemble", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"TensorNetwork", "[", 
      RowBox[{"tens1", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "k"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "l"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"l", ",", " ", "m"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"TensorNetwork", "[", 
      RowBox[{"tens2", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "k"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "l"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"l", ",", " ", "m"}], "}"}]}], "}"}]}], "]"}]}], "}"}]}], ";",
   " ", 
  RowBox[{"path", " ", "=", " ", 
   RowBox[{"OptimalContractionPath", "[", 
    RowBox[{"First", "[", "ensemble", "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->458113666,ExpressionUUID->"d8f56a0c-e16e-4e4c-adaa-63154ca167d0"],

