Cell["Contract a tensor network to obtain the result:", "ExampleText",
 CellID->120000001,ExpressionUUID->"c1000001-0000-0000-0000-000000000001"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=",
   RowBox[{"RandomReal", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{
  RowBox[{"B", "=",
   RowBox[{"RandomReal", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"4", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
 RowBox[{"tn", "=",
  RowBox[{"TensorNetwork", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{"A", ",", "B"}], "}"}], ",",
    RowBox[{"{",
     RowBox[{
      RowBox[{"{",
       RowBox[{"i", ",", "j"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]",
 RowBox[{"TensorNetworkContract", "[", "tn", "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->120000002,ExpressionUUID->"c1000002-0000-0000-0000-000000000002"]
}, Open  ]],

