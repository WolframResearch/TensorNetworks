Cell["\<\
Passing \"Greedy\" as the path is equivalent to wrapping the greedy path \
explicitly:\
\>", "ExampleText",
 CellID->208976091,ExpressionUUID->"62bf34d2-de6c-46d5-b1df-5d5c6a93bacb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tn", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"A", ",", " ", "B"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TensorNetworkContract", "[", 
   RowBox[{"tn", ",", " ", "\"\<Greedy\>\""}], "]"}], " ", "===", " ", 
  RowBox[{"TensorNetworkContract", "[", 
   RowBox[{"tn", ",", " ", 
    RowBox[{"GreedyContractionPath", "[", "tn", "]"}]}], "]"}]}]}], "Input",
 CellLabel->"In[3]:=",
 CellID->155554451,ExpressionUUID->"d5e717d5-1bd4-4073-bbb7-671e406fbc07"],

