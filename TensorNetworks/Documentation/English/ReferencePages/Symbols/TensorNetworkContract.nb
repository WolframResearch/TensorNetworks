Cell[CellGroupData[{
Cell["TensorNetworkContract", "ObjectName",
 CellID->175797813,ExpressionUUID->"05f213aa-60b7-4a60-82fc-f8bc8b690a05"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c26b4a32-9395-496a-981e-d394bc738469"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContract",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d45951d7-82c6-43cc-9f58-0309289aa3a8"],
 "\[LineSeparator]contracts the entire tensor network ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "7c3c4a15-2c1b-43a8-849b-6671c7ebd401"],
 " to a single tensor.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"dd03c9ed-733f-4216-8589-7c9a15f1cc5e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContract",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"], "[", 
   RowBox[{
    StyleBox["tn", "TI"], ",", 
    StyleBox["path", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "892ca2a0-4149-4671-a8a7-836f85f4af7e"],
 "\[LineSeparator]uses the explicit canonical contraction ",
 Cell[BoxData[
  StyleBox["path", "TI"]], "InlineFormula",ExpressionUUID->
  "f8d895b6-da9e-4159-9ac5-1bfc3d6486b6"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ac4d87dc-c4c3-4eea-bc0d-19f3f43d9503"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContract",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"], "[", 
   RowBox[{
    StyleBox["tn", "TI"], ",", 
    StyleBox["\"\<method\>\"", "TI"]}], "]"}]], "InlineFormula",
  ExpressionUUID->"3454fdfc-094f-4d9a-ab19-d26036b1f7da"],
 "\[LineSeparator]dispatches to ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"fd00018a-8dfd-4a0c-8a54-99556e87724a"],
 " or ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"3fa9a856-b28d-4fc5-8aed-a1bbaf339dfb"],
 " using the named cost function.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a2bf2541-e986-4ce2-b3bc-8b3e2b13d65c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContract",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3397034f-f041-4d27-a9bd-329b9f30ae7a"],
 "\[LineSeparator]works directly on a tensor-network ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "6ac6da75-dcc9-41ca-8494-1069293a46a6"],
 " ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "f2fea0e7-222e-4dd5-a8c1-0f120fb83b03"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2ea5eb2a-0451-4a7b-94e0-1215fa59fcd4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContract",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "12e296c8-1e6e-4e69-869e-7e0b8929bc27"],
 "\[LineSeparator]accepts the low-level ",
 Cell[BoxData[
  ButtonBox["Association",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Association"]], "InlineFormula",ExpressionUUID->
  "66bae910-0cad-4b21-9f2e-820ccdf0b363"],
 " ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "b2302f4d-189a-440a-9c66-68d7ca75084b"],
 " produced by ",
 Cell[BoxData[
  ButtonBox["TensorNetworkData",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkData"]], 
  "InlineFormula",ExpressionUUID->"9f318fa3-b756-4e28-ab6a-f9490d19eef9"],
 "."
}], "Usage",
 CellID->946322640,ExpressionUUID->"2b7cb6e4-4944-4946-a50a-2166931fdf07"],

Cell["\<\
Returns the fully evaluated tensor (the contraction result), not an Inactive \
expression.\
\>", "Notes",
 CellID->133266929,ExpressionUUID->"2c463918-d42b-4cf4-b3a2-aaf1e833c7a0"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"286e1ce5-dc60-47fe-b208-ccdb3501b04b"],
 " is the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\"\<Inactive\>\"",
    ShowStringCharacters->True], "\[Rule]", 
   ButtonBox["False",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/False"]}]], "InlineFormula",ExpressionUUID->
  "ef928697-43e0-4843-a947-43e759deef29"],
 " shortcut for ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
   "InlineFormula",ExpressionUUID->"98e6ab05-45c2-4c5d-9d9e-9e5c205e9486"],
 "; the two return the same value once ",
 Cell[BoxData[
  ButtonBox["ActivateTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ActivateTensors"]], 
  "InlineFormula",ExpressionUUID->"b4a2b287-99f8-44cc-b9af-531c3bd250c2"],
 " is applied to the inactive form."
}], "Notes",
 CellID->367562884,ExpressionUUID->"302dc38b-8be4-4afc-8f74-f012a7fce055"],

Cell[TextData[{
 "When no ",
 Cell[BoxData[
  StyleBox["path", "TI"]], "InlineFormula",ExpressionUUID->
  "98f75d96-f84d-4da6-a064-9c0c9a54c8d0"],
 " is supplied, the contraction is delegated to ",
 Cell[BoxData[
  ButtonBox["EinsteinSummation",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/EinsteinSummation"]], "InlineFormula",
  ExpressionUUID->"76a5e124-2b4d-40cd-8f58-83a258f37b55"],
 " on the network's indices and tensors. To use a search-derived path, pass \
it explicitly or use the ",
 Cell[BoxData[
  StyleBox["\"\<method\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "eeafdac4-a2a3-434a-969c-3b56133c6bae"],
 " string form."
}], "Notes",
 CellID->260645513,ExpressionUUID->"61c2e32f-dfd3-4faf-8bce-cd5b61f0a600"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["path", "TI"]], "InlineFormula",ExpressionUUID->
  "f9871b5d-ab10-49f1-abd5-f346d7b7e442"],
 " is a string, it dispatches as follows: ",
 Cell[BoxData[
  StyleBox["\"\<Greedy\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "0e38d624-51dd-4f9c-bf99-d33a55752118"],
 " calls ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"87852a6b-dfe1-4d5d-82e0-0d9bab34e674"],
 "; ",
 Cell[BoxData[
  StyleBox["\"\<Optimal\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "baa8f646-0763-42bd-8451-016a03d4f0d1"],
 ", ",
 Cell[BoxData[
  StyleBox["\"\<flops\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "70f7d97d-c674-406c-ab76-f786c3d0bf70"],
 ", ",
 Cell[BoxData[
  StyleBox["\"\<max\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "d847df6f-9211-4ca2-8bf8-bebefcf28240"],
 ", ",
 Cell[BoxData[
  StyleBox["\"\<size\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "4eac95fc-3dab-40c1-aabd-a1218e754242"],
 ", ",
 Cell[BoxData[
  StyleBox["\"\<write\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "ac6d39d7-6e94-4d75-8a98-016ec9a53281"],
 ", ",
 Cell[BoxData[
  StyleBox["\"\<combo\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "1e48c9c0-2af6-4a20-9724-0110446aea1e"],
 ", or ",
 Cell[BoxData[
  StyleBox["\"\<limit\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "b03230a1-7f9f-4537-9ef4-7ae02d2e896e"],
 " call ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"c6ac2fba-c200-4818-b524-cc3945646a43"],
 " with the corresponding cost function."
}], "Notes",
 CellID->443089438,ExpressionUUID->"f69434dc-9a9d-45ee-bb40-bda1d6305da6"],

Cell[TextData[{
 "When the network has a hyper-edge (an index shared by three or more \
tensors), ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"54a1fe92-3594-42b3-86b7-fa9c732b6b58"],
 " first calls ",
 Cell[BoxData[
  ButtonBox["BinaryTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"aaa0c106-f752-4011-9ade-026252632a29"],
 " to insert copy tensors and reduce the network to pairwise edges before \
contracting."
}], "Notes",
 CellID->273965426,ExpressionUUID->"8b4178e5-d2de-4ef6-9cef-48b33d83c748"],

