Cell["\<\
Passing \"Inactive\" -> True recovers TensorNetworkContraction's behavior:\
\>", "ExampleText",
 CellID->260645513,ExpressionUUID->"478ce1e7-3a18-4c50-9fea-6e2ad8086b60"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tn", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"A", ",", " ", "B"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TensorNetworkContract", "[", 
   RowBox[{"tn", ",", " ", 
    RowBox[{"\"\<Inactive\>\"", " ", "->", " ", "True"}]}], "]"}], " ", "===",
   " ", 
  RowBox[{"TensorNetworkContraction", "[", "tn", "]"}]}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->443089438,ExpressionUUID->"bf5eaf65-f33a-416c-92b1-f8d192200ef9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]=",
 CellID->273965426,ExpressionUUID->"0d1bd327-d7f3-492c-a011-6c4faf886941"]
}, Open  ]],

