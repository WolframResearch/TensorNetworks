Cell["Auto-binarization", "ExampleSubsection",
 CellID->875395060,ExpressionUUID->"8e477e2d-ce5f-4c79-8aef-499a4a1c4346"],

Cell["\<\
Hyper-edge networks (an index shared by three or more tensors) are \
auto-binarized via BinaryTensorNetwork before contraction. Here three vectors \
share index i:\
\>", "ExampleText",
 CellID->661510580,ExpressionUUID->"5daed420-3d15-473c-914c-7d1921ce1ef8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"v", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"w", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"x", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"hyper", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "w", ",", " ", "x"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "i", "}"}], ",", " ", 
       RowBox[{"{", "i", "}"}], ",", " ", 
       RowBox[{"{", "i", "}"}]}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->848300949,ExpressionUUID->"e4e8845f-0d36-4e01-afa3-add608ced5fc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorNetworkContract", "[", "hyper", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->661510580,ExpressionUUID->"9a5a967e-b36f-4cd4-83de-0f98346cb7f2"],

Cell[BoxData[
