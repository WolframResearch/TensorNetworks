Cell[CellGroupData[{
Cell["MPSCanonicalQ", "ObjectName",
 CellID->200000001,ExpressionUUID->"a0000001-0001-4000-8000-000000000001"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a0000001-0001-4000-8000-000000000002"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSCanonicalQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalQ"], "[",
   RowBox[{
    StyleBox["mps", "TI"], ",", "\"\<Left\>\""}], "]"}]], "InlineFormula",
  ExpressionUUID->"a0000001-0001-4000-8000-000000000003"],
 "\[LineSeparator]returns ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000004"],
 " if every tensor of ",
 Cell[BoxData[
  StyleBox["mps", "TI"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000005"],
 " except the last is left-isometric. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a0000001-0001-4000-8000-000000000006"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSCanonicalQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalQ"], "[",
   RowBox[{
    StyleBox["mps", "TI"], ",", "\"\<Right\>\""}], "]"}]], "InlineFormula",
  ExpressionUUID->"a0000001-0001-4000-8000-000000000007"],
 "\[LineSeparator]returns ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000008"],
 " if every tensor of ",
 Cell[BoxData[
  StyleBox["mps", "TI"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000009"],
 " except the first is right-isometric. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a0000001-0001-4000-8000-00000000000a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSCanonicalQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalQ"], "[",
   RowBox[{
    StyleBox["mps", "TI"], ",",
    RowBox[{"{",
     RowBox[{"\"\<Mixed\>\"", ",",
      StyleBox["k", "TI"]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-00000000000b"],
 "\[LineSeparator]returns ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-00000000000c"],
 " if sites before ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-00000000000d"],
 " are left-isometric and sites after ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-00000000000e"],
 " are right-isometric. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a0000001-0001-4000-8000-00000000000f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSCanonicalQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalQ"], "[",
   RowBox[{
    StyleBox["mps", "TI"], ",",
    StyleBox["form", "TI"], ",",
    StyleBox["tol", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000010"],
 "\[LineSeparator]uses Frobenius-norm tolerance ",
 Cell[BoxData[
  StyleBox["tol", "TI"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000011"],
 " when comparing each Gram matrix to the identity."
}], "Usage",
 CellID->200000002,ExpressionUUID->"a0000001-0001-4000-8000-000000000012"],

Cell[TextData[{
 "The default tolerance is ",
 Cell[BoxData[
  SuperscriptBox["10",
   RowBox[{"-", "10"}]]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000013"],
 ". ",
 Cell[BoxData[
  ButtonBox["MPSCanonicalQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalQ"]],
  "InlineFormula",ExpressionUUID->"a0000001-0001-4000-8000-000000000014"],
 " forms each isometry candidate, multiplies it by its conjugate transpose, \
and accepts the form when ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    ButtonBox["Norm",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Norm"], "[",
    RowBox[{
     RowBox[{"M", "-", "I"}], ",", "\"\<Frobenius\>\""}], "]"}], "<",
   StyleBox["tol", "TI"]}]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000015"],
 "."
}], "Notes",
 CellID->200000003,ExpressionUUID->"a0000001-0001-4000-8000-000000000016"],

Cell[TextData[{
 "A tensor is left-isometric when, reshaped as a (leftBond \[Times] physical) \
\[Times] rightBond matrix ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000017"],
 ", it satisfies ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox[
    StyleBox["M", "TI"], "\[Dagger]"], ".",
   StyleBox["M", "TI"], "=", "I"}]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000018"],
 ". A boundary tensor of shape {bond, physical} is reshaped to {physical, \
bond} before the same check is applied."
}], "Notes",
 CellID->200000004,ExpressionUUID->"a0000001-0001-4000-8000-000000000019"],

Cell[TextData[{
 "A tensor is right-isometric when, reshaped as leftBond \[Times] (rightBond \
\[Times] physical) ",
 Cell[BoxData[
  StyleBox["M", "TI"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-00000000001a"],
 ", it satisfies ",
 Cell[BoxData[
  RowBox[{
   StyleBox["M", "TI"], ".",
   SuperscriptBox[
    StyleBox["M", "TI"], "\[Dagger]"], "=", "I"}]], "InlineFormula",
  ExpressionUUID->"a0000001-0001-4000-8000-00000000001b"],
 ". A boundary tensor is treated as the matrix itself."
}], "Notes",
 CellID->200000005,ExpressionUUID->"a0000001-0001-4000-8000-00000000001c"],

Cell[TextData[{
 "For the mixed form, ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-00000000001d"],
 " is the orthogonality center. Sites ",
 Cell[BoxData[
  RowBox[{"1", ",", "\[Ellipsis]", ",",
   RowBox[{
    StyleBox["k", "TI"], "-", "1"}]}]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-00000000001e"],
 " must be left-isometric and sites ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["k", "TI"], "+", "1"}], ",", "\[Ellipsis]", ",",
   StyleBox["n", "TI"]}]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-00000000001f"],
 " must be right-isometric; the tensor at site ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000020"],
 " is unconstrained. The function returns ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000021"],
 " when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "<", "1"}]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000022"],
 " or ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ">",
   StyleBox["n", "TI"]}]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000023"],
 "."
}], "Notes",
 CellID->200000006,ExpressionUUID->"a0000001-0001-4000-8000-000000000024"],

Cell[TextData[{
 "Networks whose tensor shapes do not match the open-boundary MPS layout used \
by ",
 Cell[BoxData[
  ButtonBox["RandomTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"]],
  "InlineFormula",ExpressionUUID->"a0000001-0001-4000-8000-000000000025"],
 "[\"MPS\"] are accepted as input; ",
 Cell[BoxData[
  ButtonBox["MPSCanonicalQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalQ"]],
  "InlineFormula",ExpressionUUID->"a0000001-0001-4000-8000-000000000026"],
 " returns ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "a0000001-0001-4000-8000-000000000027"],
 " (no error) when the isometry check fails for any tensor."
}], "Notes",
 CellID->200000007,ExpressionUUID->"a0000001-0001-4000-8000-000000000028"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  ButtonBox["MPSCanonicalForm",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalForm"]],
  "InlineFormula",ExpressionUUID->"a0000001-0001-4000-8000-000000000029"],
 " to construct a canonical MPS in the first place; ",
 Cell[BoxData[
  ButtonBox["MPSCanonicalQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalQ"]],
  "InlineFormula",ExpressionUUID->"a0000001-0001-4000-8000-00000000002a"],
 " is its inverse: a post-condition check that the constructed network \
satisfies the isometry property of its declared form."
}], "Notes",
 CellID->200000008,ExpressionUUID->"a0000001-0001-4000-8000-00000000002b"]
}, Open  ]],

