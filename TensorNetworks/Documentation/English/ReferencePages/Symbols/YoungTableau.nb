Cell["Construct a Young tableau from explicit rows:", "ExampleText",
 CellID->706411693,ExpressionUUID->"873f016c-3125-4de0-874f-4111948dc566"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableau", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"4", ",", " ", "5"}], "}"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->720968092,ExpressionUUID->"8e1ff91b-0876-48e6-8f5a-8f760b438873"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["YoungTableau",
    "SummaryHead"], "[", 
   DynamicModuleBox[{Typeset`open$$ = False, Typeset`embedState$$ = "Ready"}, 
    
    TemplateBox[{
      PaneSelectorBox[{False -> GridBox[{{
            PaneBox[
             ButtonBox[
              DynamicBox[
               FEPrivate`FrontEndResource["FEBitmaps", "SummaryBoxOpener"]], 
              ButtonFunction :> (Typeset`open$$ = True), Appearance -> None, 
              BaseStyle -> {}, Evaluator -> Automatic, Method -> 
              "Preemptive"], Alignment -> {Center, Center}, ImageSize -> 
             Dynamic[{
               Automatic, 
                3.5 (CurrentValue["FontCapHeight"]/AbsoluteCurrentValue[
                 Magnification])}]], 
            GraphicsBox[{
              EdgeForm[
               GrayLevel[0.5]], 
              GrayLevel[1], {{
                RectangleBox[{0, -1}, {1, 0}], 
                RectangleBox[{1, -1}, {2, 0}], 
                RectangleBox[{2, -1}, {3, 0}]}, {
                RectangleBox[{0, -2}, {1, -1}], 
                RectangleBox[{1, -2}, {2, -1}]}}, 
              GrayLevel[0], {{
                InsetBox[
                 FormBox[
                  StyleBox["1", 10, StripOnInput -> False], 
                  TraditionalForm], {0.5, -0.5}], 
                InsetBox[
                 FormBox[
                  StyleBox["2", 10, StripOnInput -> False], 
                  TraditionalForm], {1.5, -0.5}], 
                InsetBox[
                 FormBox[
                  StyleBox["3", 10, StripOnInput -> False], 
                  TraditionalForm], {2.5, -0.5}]}, {
                InsetBox[
                 FormBox[
                  StyleBox["4", 10, StripOnInput -> False], 
                  TraditionalForm], {0.5, -1.5}], 
                InsetBox[
                 FormBox[
                  StyleBox["5", 10, StripOnInput -> False], 
                  TraditionalForm], {1.5, -1.5}]}}}, ImageSize -> {48, 32}], 
            GridBox[{{
               RowBox[{
                 TagBox["\"Shape: \"", "SummaryItemAnnotation"], 
                 "\[InvisibleSpace]", 
                 TagBox[
                  RowBox[{"{", 
                    RowBox[{"3", ",", "2"}], "}"}], "SummaryItem"]}]}, {
               RowBox[{
