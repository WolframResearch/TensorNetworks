Notebook[{

Cell[CellGroupData[{
Cell["YoungTableau", "ObjectName",
 CellID->223337487,ExpressionUUID->"0ee2f921-e4f8-44e0-8559-54c4f4c29b0a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e0622465-9898-4ec9-a0d4-a2a24d0eee9f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["YoungTableau",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"], "[", 
   StyleBox["rows", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "972df276-e8cb-44d7-bbcd-5697f16f2487"],
 "\[LineSeparator]represents a Young tableau, where ",
 Cell[BoxData[
  StyleBox["rows", "TI"]], "InlineFormula",ExpressionUUID->
  "7ee12a46-3879-4139-9d08-7cabe029f937"],
 " is a list of lists of slot indices.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"82bcd31f-64a3-4137-b07c-1f2333887a34"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["YoungTableau",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"], "[", 
   StyleBox["partition", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "853b655e-b566-4ed3-ad69-38056a9c7aaa"],
 "\[LineSeparator]constructs a standard tableau from an integer ",
 Cell[BoxData[
  StyleBox["partition", "TI"]], "InlineFormula",ExpressionUUID->
  "a36f5345-3eb4-46fa-a0f0-28267815fa1e"],
 ", auto-filling rows in reading order."
}], "Usage",
 CellID->984669801,ExpressionUUID->"c899fce4-407f-4d47-a080-71023a011b09"],

Cell[TextData[{
 "This symbol lives in the subpackage context ",
 Cell[BoxData["\"\<Wolfram`TensorNetworks`Symmetry`\>\""], "InlineFormula",
  ExpressionUUID->"7aaa11b5-18d2-4e3b-a544-dda0089fba9e"],
 ". Load it explicitly with ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Needs",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Needs"], "[",
   "\"\<Wolfram`TensorNetworks`Symmetry`\>\"",
   "]"}]], "InlineFormula",ExpressionUUID->
  "42f17c50-f0cc-439b-9992-2d8d92371ec5"],
 "; loading only the main context does not auto-load this subpackage."
}], "Notes",
 CellID->685904443,ExpressionUUID->"c160f18a-0ba0-4653-88da-551599a52716"],

Cell[TextData[{
 "A valid Young tableau has rows of non-increasing length and distinct \
positive-integer entries. The convenience check ",
 Cell[BoxData[
  ButtonBox["YoungTableauQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableauQ"]], 
  "InlineFormula",ExpressionUUID->"30502e9a-1101-4372-8674-a9333d808c31"],
 " caches its result via the ",
 Cell[BoxData[
 "System`Private`HoldValidQ"], "InlineFormula",ExpressionUUID->
  "3dc76867-ae59-492b-91b3-b783acf50dd2"],
 " pattern, so validation is paid for once per object."
}], "Notes",
 CellID->309493800,ExpressionUUID->"9f25c923-c4d9-48d5-aa24-462ade08933c"],

Cell[TextData[{
 "For a standard tableau the entries are a permutation of ",
 Cell[BoxData[
  RowBox[{"1", ",", "\[Ellipsis]", ",", 
   StyleBox["n", "TI"]}]], "InlineFormula",ExpressionUUID->
  "c4745ba4-5281-4ae3-87af-f0373f91f108"],
 " where ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "7aa9e386-2b56-4d3f-a7ad-00044f9f1b5d"],
 " is the total number of boxes; downstream symmetrizers such as ",
 Cell[BoxData[
  ButtonBox["YoungSymmetrize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"]], 
  "InlineFormula",ExpressionUUID->"aa41ffe4-a666-46cc-96c6-b8a7193db6ba"],
 " and ",
 Cell[BoxData[
  ButtonBox["YoungProject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"]], 
  "InlineFormula",ExpressionUUID->"98d4b1a6-80c2-4cd2-9edb-2e84bdd9310d"],
 " require this convention."
}], "Notes",
 CellID->571753287,ExpressionUUID->"f8df15e0-c0b5-47ff-9053-e74f3b7f01ad"],

Cell[TextData[{
 "The partition-form constructor numbers cells left-to-right, top-to-bottom: ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["YoungTableau",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"], "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2"}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "5932ec07-6fa1-4192-9718-3eb0d0df8b9c"],
 " produces ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["YoungTableau",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "5"}], "}"}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"2c8b19f7-4a06-4e37-ade5-9d6dfecd0c1e"],
 "."
}], "Notes",
 CellID->40550656,ExpressionUUID->"cac9fbdc-202b-4c9a-b9d1-220b732da5e0"],

Cell["\<\
The summary-box icon shows the underlying Young diagram, drawn from the same \
row data; the displayed properties are the shape (partition), the filling \
label, and the irrep dimension via the hook-length formula.\
\>", "Notes",
 CellID->924238015,ExpressionUUID->"e9b1eba0-bb94-49a2-9a82-2ecb3cf4f607"],

Cell[TextData[{
 "The filling label reads \"Canonical\" when the stored rows are the \
row-reading standard Young tableau of the shape (the default produced by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["YoungTableau",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"], "[",
   StyleBox["partition", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1c5e3d9f-4a2b-4e8f-b1d6-3a9c7e2f5b4d"],
 "), \"Standard\" when the rows and columns are strictly increasing but \
the filling is not the canonical one, and \"Explicit\" otherwise. The label \
is content-based, so a hand-typed canonical filling such as ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["YoungTableau",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"], "[",
   RowBox[{"{",
    RowBox[{
     RowBox[{"{",
      RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"4", ",", "5"}], "}"}], ",",
     RowBox[{"{", "6", "}"}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"5b4d9f8e-2c3e-4a7b-9f1d-6e8a3c5b2d1f"],
 " also reads \"Canonical\"."
}], "Notes",
 CellID->138472659,ExpressionUUID->"8f4d2a91-3e5b-4c6f-9d2e-7a8b1c5e3d9f"],

Cell[TextData[{
 "Property accessors include ",
 Cell[BoxData[
  ButtonBox["TableauShape",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"]], 
  "InlineFormula",ExpressionUUID->"3060395e-b9f8-4e3f-8912-cc5ad9f11306"],
 ", ",
 Cell[BoxData[
  ButtonBox["TableauSize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauSize"]], 
  "InlineFormula",ExpressionUUID->"4d4f5a20-e774-4f48-9e83-14c9dc25b4be"],
 ", ",
 Cell[BoxData[
  ButtonBox["TableauRows",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauRows"]],
  "InlineFormula",ExpressionUUID->"a1b2c3d4-1111-4abc-9def-012345678901"],
 ", ",
 Cell[BoxData[
  ButtonBox["TableauColumns",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauColumns"]],
  "InlineFormula",ExpressionUUID->"b2c3d4e5-2222-4def-9abc-012345678902"],
 ", ",
 Cell[BoxData[
  ButtonBox["TableauDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"]],
  "InlineFormula",ExpressionUUID->"ffdd5bef-15bd-4c6b-ae4b-cb6aa17cb805"],
 ", ",
 Cell[BoxData[
  ButtonBox["HookLengths",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookLengths"]], 
  "InlineFormula",ExpressionUUID->"bb98b8fd-ea52-4127-a589-0912f3d418b4"],
 ", and ",
 Cell[BoxData[
  ButtonBox["HookFactor",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"]], 
  "InlineFormula",ExpressionUUID->"1c80c68f-4d08-4875-94a9-7c45a5765e64"],
 "."
}], "Notes",
 CellID->320579364,ExpressionUUID->"95ad25a7-5c69-450d-8f0f-5606c4d0654f"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["StandardTableauQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/StandardTableauQ"]],
  "InlineFormula",ExpressionUUID->"e5f6a7b8-3030-4abc-9def-012345678905"],
 " tests whether the filling is a standard Young tableau, that is, whether \
rows and columns are strictly increasing; the canonical filling always \
satisfies this."
}], "Notes",
 CellID->582940163,ExpressionUUID->"a7b8c9d0-4141-4bcd-9efa-012345678906"]
}, Open  ]],

