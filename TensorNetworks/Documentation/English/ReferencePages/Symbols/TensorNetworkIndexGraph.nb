Cell[CellGroupData[{

Cell["Visualize index dependency to spot tightly coupled tensors. Indices that lie inside one tensor's complete subgraph cannot be contracted independently from the rest of that tensor:", "ExampleText",
 CellID->540001101,ExpressionUUID->"e0001001-0001-0001-0001-000000000001"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tnApp", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"3", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{", RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{", RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->540001102,ExpressionUUID->"e0001001-0001-0001-0001-000000000002"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndexGraph", "[",
  RowBox[{
   RowBox[{"ToTensorNetworkGraph", "[", "tnApp", "]"}], ",",
   RowBox[{"VertexLabels", "\[Rule]", "\"\<Name\>\""}]}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->540001103,ExpressionUUID->"e0001001-0001-0001-0001-000000000003"],

Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter",ExpressionUUID->"e0001001-0001-0001-0001-000000000004"], $Line = 0; Null]], "ExampleDelimiter",
 CellID->540001110,ExpressionUUID->"e0001001-0001-0001-0001-000000000005"],

Cell["Inspect the connectivity for a contraction-path study. The list of vertices is exactly the indices a path-finder must visit, and the edge list shows which pairs the contraction order must respect:", "ExampleText",
 CellID->540001111,ExpressionUUID->"e0001001-0001-0001-0001-000000000006"],

Cell[BoxData[
 RowBox[{"VertexList", "[",
  RowBox[{"TensorNetworkIndexGraph", "[", RowBox[{"ToTensorNetworkGraph", "[", "tnApp", "]"}], "]"}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->540001112,ExpressionUUID->"e0001001-0001-0001-0001-000000000007"],

Cell[BoxData[
 RowBox[{"EdgeList", "[",
  RowBox[{"TensorNetworkIndexGraph", "[", RowBox[{"ToTensorNetworkGraph", "[", "tnApp", "]"}], "]"}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->540001113,ExpressionUUID->"e0001001-0001-0001-0001-000000000008"]
}, Open  ]]
