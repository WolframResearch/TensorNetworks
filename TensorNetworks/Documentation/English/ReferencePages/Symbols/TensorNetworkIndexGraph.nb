Notebook[{

Cell[CellGroupData[{
Cell["TensorNetworkIndexGraph", "ObjectName",
 CellID->1629203374,ExpressionUUID->"440cc5c8-41b5-4d08-bf5d-e78786038c1a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5099acd2-48e0-4395-a934-ee39c7301454"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkIndexGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndexGraph"],
   "[", StyleBox["graph", "TI"], "]"
  }]], "InlineFormula",ExpressionUUID->"7e5de497-e587-45c2-8a34-d1143a84046a"],
 "\[LineSeparator]returns a ",
 Cell[BoxData[
  ButtonBox["Graph",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Graph"]],
  "InlineFormula",ExpressionUUID->"a1d31c0f-1c10-4e6b-8a1d-3a8a2c8e0001"],
 " whose vertices are the individual indices of the tensor-network graph ",
 Cell[BoxData[StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->"a1d31c0f-1c10-4e6b-8a1d-3a8a2c8e0002"],
 " and whose edges encode both contractions between tensors and co-occurrence of indices within each tensor."
}], "Usage",
 CellID->1604607568,ExpressionUUID->"ce406bd3-e144-4e53-93f4-7d8891396d8a"],

Cell[TextData[{
 "The input ",
 Cell[BoxData[StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->"b2e42d1f-2e21-5f7c-9e2b-4b9b3d9f1001"],
 " must be an annotated tensor-network graph satisfying ",
 Cell[BoxData[ButtonBox["TensorNetworkGraphQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphQ"]],
  "InlineFormula",ExpressionUUID->"b2e42d1f-2e21-5f7c-9e2b-4b9b3d9f1002"],
 ". Build one with ",
 Cell[BoxData[ButtonBox["ToTensorNetworkGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]],
  "InlineFormula",ExpressionUUID->"b2e42d1f-2e21-5f7c-9e2b-4b9b3d9f1003"],
 " or read it from a ",
 Cell[BoxData[ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]],
  "InlineFormula",ExpressionUUID->"b2e42d1f-2e21-5f7c-9e2b-4b9b3d9f1004"],
 " object via the ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",ExpressionUUID->"b2e42d1f-2e21-5f7c-9e2b-4b9b3d9f1005"],
 " property. The diagnostic check ",
 Cell[BoxData[RowBox[{ButtonBox["TensorNetworkGraphQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphQ"], "[", "True", "]"}]],
  "InlineFormula",ExpressionUUID->"b2e42d1f-2e21-5f7c-9e2b-4b9b3d9f1006"],
 " (verbose mode) is used, so invalid inputs leave the expression unevaluated and print messages."
}], "Notes",
 CellID->539756350,ExpressionUUID->"ecd1743f-0e1c-45b6-af7d-1ffc4516f605"],

Cell[TextData[{
 "Vertices of the returned graph are individual indices (each a ",
 Cell[BoxData[ButtonBox["Superscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Superscript"]],
  "InlineFormula",ExpressionUUID->"c4a3b9c0-1010-4d7e-9c2b-3d5e6f7a8b01"],
 " or ",
 Cell[BoxData[ButtonBox["Subscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Subscript"]],
  "InlineFormula",ExpressionUUID->"c4a3b9c0-1010-4d7e-9c2b-3d5e6f7a8b02"],
 " labeled by its parent tensor's vertex id), so the vertex set is ",
 Cell[BoxData[RowBox[{ButtonBox["Catenate",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Catenate"], "[",
   RowBox[{ButtonBox["TensorNetworkIndices",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndices"], "[", StyleBox["graph", "TI"], "]"}], "]"}]],
  "InlineFormula",ExpressionUUID->"c4a3b9c0-1010-4d7e-9c2b-3d5e6f7a8b03"],
 "."
}], "Notes",
 CellID->540001001,ExpressionUUID->"d1e2f3c4-5a6b-7c8d-9e0f-aabbccdd0101"],

Cell[TextData[{
 "Edges come in two kinds:"
}], "Notes",
 CellID->540001002,ExpressionUUID->"d1e2f3c4-5a6b-7c8d-9e0f-aabbccdd0102"],

Cell[TextData[{
 "\[Bullet] Contraction edges: one directed edge per inter-tensor index contraction, obtained from ",
 Cell[BoxData[RowBox[{ButtonBox["EdgeTags",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/EdgeTags"], "[", StyleBox["graph", "TI"], "]"}]],
  "InlineFormula",ExpressionUUID->"d1e2f3c4-5a6b-7c8d-9e0f-aabbccdd0201"],
 ". Each tag is a pair ",
 Cell[BoxData[RowBox[{"{", StyleBox["srcIndex", "TI"], ",", StyleBox["tgtIndex", "TI"], "}"}]],
  "InlineFormula",ExpressionUUID->"d1e2f3c4-5a6b-7c8d-9e0f-aabbccdd0202"],
 " and becomes the directed edge ",
 Cell[BoxData[RowBox[{StyleBox["srcIndex", "TI"], "\[DirectedEdge]", StyleBox["tgtIndex", "TI"]}]],
  "InlineFormula",ExpressionUUID->"d1e2f3c4-5a6b-7c8d-9e0f-aabbccdd0203"],
 "."
}], "Notes",
 CellID->540001003,ExpressionUUID->"d1e2f3c4-5a6b-7c8d-9e0f-aabbccdd0203b"],

Cell[TextData[{
 "\[Bullet] Co-occurrence edges: for each tensor vertex of ",
 Cell[BoxData[StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->"d1e2f3c4-5a6b-7c8d-9e0f-aabbccdd0301"],
 ", every pair of indices on that tensor is connected by an undirected edge. Equivalently, each tensor contributes a complete subgraph over its own index list."
}], "Notes",
 CellID->540001004,ExpressionUUID->"d1e2f3c4-5a6b-7c8d-9e0f-aabbccdd0302"],

Cell[TextData[{
 "Additional ",
 Cell[BoxData[ButtonBox["Graph",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Graph"]],
  "InlineFormula",ExpressionUUID->"e2f3c4d5-6b7c-8d9e-0a1b-aabbccdd0401"],
 " options are forwarded to the returned graph, and ",
 Cell[BoxData[RowBox[{ButtonBox["VertexLabels",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/VertexLabels"], "\[Rule]", ButtonBox["Automatic",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Automatic"]}]],
  "InlineFormula",ExpressionUUID->"e2f3c4d5-6b7c-8d9e-0a1b-aabbccdd0402"],
 " is supplied by default so each vertex is labeled with its index."
}], "Notes",
 CellID->540001005,ExpressionUUID->"e2f3c4d5-6b7c-8d9e-0a1b-aabbccdd0403"],

Cell[TextData[{
 "The index graph is complementary to ",
 Cell[BoxData[ButtonBox["ToTensorNetworkGraph",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]],
  "InlineFormula",ExpressionUUID->"f3c4d5e6-7c8d-9e0f-1a2b-aabbccdd0501"],
 ": in the tensor-network graph, vertices are tensors and edges are contracted indices; in the index graph, vertices are indices and edges record both contractions between tensors and co-occurrence within a tensor."
}], "Notes",
 CellID->540001006,ExpressionUUID->"f3c4d5e6-7c8d-9e0f-1a2b-aabbccdd0502"]
}, Open  ]],

