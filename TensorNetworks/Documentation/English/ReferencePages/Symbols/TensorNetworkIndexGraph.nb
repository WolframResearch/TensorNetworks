Cell[CellGroupData[{

Cell["From a simple TN", "ExampleSubsection",
 CellID->530001001,ExpressionUUID->"c0001001-0001-0001-0001-000000000001"],

Cell["\<\
A triangle of three rank-2 tensors has six indices (two per tensor) and three \
contractions:\
\>", "ExampleText",
 CellID->530001002,ExpressionUUID->"c0001001-0001-0001-0001-000000000002"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tnTri", "=", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "c"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "a"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->530001003,ExpressionUUID->"c0001001-0001-0001-0001-000000000003"],

Cell[BoxData[
 RowBox[{"graphTri", "=", 
  RowBox[{"ToTensorNetworkGraph", "[", "tnTri", "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->530001004,ExpressionUUID->"c0001001-0001-0001-0001-000000000004"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndexGraph", "[", "graphTri", "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->530001005,ExpressionUUID->"c0001001-0001-0001-0001-000000000005"],

Cell["\<\
Six vertices (one per index) and six edges (three contraction edges plus \
three co-occurrence edges, one per tensor):\
\>", "ExampleText",
 CellID->530001006,ExpressionUUID->"c0001001-0001-0001-0001-000000000006"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"VertexCount", "[", 
    RowBox[{"TensorNetworkIndexGraph", "[", "graphTri", "]"}], "]"}], ",", 
   RowBox[{"EdgeCount", "[", 
    RowBox[{"TensorNetworkIndexGraph", "[", "graphTri", "]"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->530001007,ExpressionUUID->"c0001001-0001-0001-0001-000000000007"]
}, Open  ]],

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "d0001001-0001-0001-0001-000000000001"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->530001100,ExpressionUUID->"d0001001-0001-0001-0001-000000000002"],

Cell[CellGroupData[{

Cell["From an MPS", "ExampleSubsection",
 CellID->530002001,ExpressionUUID->"c0002001-0001-0001-0001-000000000001"],

Cell["\<\
The MPS chain structure shows up as a linear backbone in the index graph: \
each interior site contributes one local triangle, and adjacent triangles are \
linked by a contraction edge:\
\>", "ExampleText",
 CellID->530002002,ExpressionUUID->"c0002001-0001-0001-0001-000000000002"],

Cell[BoxData[
 RowBox[{"mpsG", "=", 
  RowBox[{"ToTensorNetworkGraph", "[", 
   RowBox[{"RandomTensorNetwork", "[", 
    RowBox[{"\"\<MPS\>\"", "[", 
