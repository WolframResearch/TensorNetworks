Cell[CellGroupData[{

Cell["TensorNetworkIndexGraph is complementary to ToTensorNetworkGraph: vertex and edge roles are swapped:", "ExampleText",
 CellID->550001001,ExpressionUUID->"f0001001-0001-0001-0001-000000000001"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tnRel", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"3", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{", RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{", RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->550001002,ExpressionUUID->"f0001001-0001-0001-0001-000000000002"],

Cell[BoxData[
 RowBox[{"graphRel", "=", RowBox[{"ToTensorNetworkGraph", "[", "tnRel", "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->550001003,ExpressionUUID->"f0001001-0001-0001-0001-000000000003"],

Cell["ToTensorNetworkGraph: vertices are tensors, edges are contracted indices:", "ExampleText",
 CellID->550001004,ExpressionUUID->"f0001001-0001-0001-0001-000000000004"],

Cell[BoxData[
 RowBox[{"VertexList", "[", "graphRel", "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->550001005,ExpressionUUID->"f0001001-0001-0001-0001-000000000005"],

