Cell["Build an annotated tensor-network graph from a small TensorNetwork:", "ExampleText",
 CellID->720001001,ExpressionUUID->"c3fcd24d-ead9-4ed1-9435-f0527212cced"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->720001002,ExpressionUUID->"e7a76158-efea-4608-bf16-b41195b329ab"],

Cell[BoxData[
 RowBox[{"graph", "=", RowBox[{"ToTensorNetworkGraph", "[", "tn", "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->720001003,ExpressionUUID->"a0cc33f5-e189-4c76-a788-33681a80ea1e"],

Cell["Get the index-connectivity graph; vertices are individual indices and edges connect indices that share a tensor or a contraction:", "ExampleText",
 CellID->720001004,ExpressionUUID->"b0001001-0001-0001-0001-000000000001"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndexGraph", "[", "graph", "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->720001005,ExpressionUUID->"b0001001-0001-0001-0001-000000000002"],

Cell["Build the index graph for a 4-site MPS:", "ExampleText",
 CellID->720001006,ExpressionUUID->"b0001001-0001-0001-0001-000000000003"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndexGraph", "[",
  RowBox[{"ToTensorNetworkGraph", "[",
   RowBox[{"RandomTensorNetwork", "[",
    RowBox[{"\"\<MPS\>\"", "[",
     RowBox[{"4", ",", "2", ",", "2"}], "]"}], "]"}], "]"}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->720001007,ExpressionUUID->"b0001001-0001-0001-0001-000000000004"],

Cell["Forward Graph options to control layout and styling:", "ExampleText",
 CellID->720001008,ExpressionUUID->"b0001001-0001-0001-0001-000000000005"],

Cell[BoxData[
 RowBox[{"TensorNetworkIndexGraph", "[",
  RowBox[{"graph", ",",
   RowBox[{"VertexSize", "\[Rule]", "Large"}], ",",
   RowBox[{"GraphLayout", "\[Rule]", "\"\<RadialEmbedding\>\""}]}], "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->720001009,ExpressionUUID->"b0001001-0001-0001-0001-000000000006"]
}, Open  ]],

