   RowBox[{"VertexCount", "[", RowBox[{"TensorNetworkIndexGraph", "[", RowBox[{"ToTensorNetworkGraph", "[", "tnBig", "]"}], "]"}], "]"}], ",",
   RowBox[{"EdgeCount", "[", RowBox[{"TensorNetworkIndexGraph", "[", RowBox[{"ToTensorNetworkGraph", "[", "tnBig", "]"}], "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[6]:=",
