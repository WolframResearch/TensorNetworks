Cell["For a network of N tensors with average rank R, the index graph has N*R vertices and roughly N*R*(R-1)/2 co-occurrence edges plus one edge per contraction. Large or high-rank networks can look cluttered:", "ExampleText",
 CellID->560001201,ExpressionUUID->"a0001200-0001-0001-0001-000000000003"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tnBig", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"Table", "[",
      RowBox[{
       RowBox[{"RandomReal", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", "4"}], "]"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{", RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",",
       RowBox[{"{", RowBox[{"c", ",", "d", ",", "e"}], "}"}], ",",
       RowBox[{"{", RowBox[{"e", ",", "f", ",", "a"}], "}"}], ",",
       RowBox[{"{", RowBox[{"b", ",", "d", ",", "f"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->560001202,ExpressionUUID->"a0001200-0001-0001-0001-000000000004"],

Cell[BoxData[
 RowBox[{"{",
