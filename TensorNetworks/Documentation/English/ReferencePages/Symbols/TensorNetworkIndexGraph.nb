 CellID->550001006,ExpressionUUID->"f0001001-0001-0001-0001-000000000006"],

Cell[BoxData[
 RowBox[{"VertexList", "[", RowBox[{"TensorNetworkIndexGraph", "[", "graphRel", "]"}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->550001007,ExpressionUUID->"f0001001-0001-0001-0001-000000000007"],

