Cell[CellGroupData[{

Cell["Required tensor rank for YoungSymmetrize", "ExampleSubsection",
 CellID->928652029,ExpressionUUID->"fd7173f7-3438-48cd-92c8-8886ddff8c74"],

Cell["\<\
The rank of the tensor passed to YoungSymmetrize must equal TableauSize of \
the tableau; here both equal 3 and the output has the same shape as the input:\
\>", "ExampleText",
 CellID->609703154,ExpressionUUID->"27a2464c-8abc-41de-8130-613999bc3f8a"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"yt", " ", "=", " ", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", "3", "}"}]}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"t", " ", "=", " ", 
      RowBox[{"Array", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"a", ",", " ", "##1"}], "]"}], " ", "&"}], " ", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "3", ",", " ", "3"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"TableauSize", "[", "yt", "]"}], ",", " ", 
     RowBox[{"ArrayDepth", "[", "t", "]"}], ",", " ", 
     RowBox[{"Dimensions", "[", 
      RowBox[{"YoungSymmetrize", "[", 
       RowBox[{"t", ",", " ", "yt"}], "]"}], "]"}]}], "}"}]}], "]"}]], "Input",\

 CellLabel->"In[1]:=",
 CellID->764935853,ExpressionUUID->"febedea8-a67f-4de1-8444-15a402531179"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "3", ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "3", ",", "3"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->183815344,ExpressionUUID->"109e648d-f53b-4d4e-a052-c4415f8b001c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bookkeeping for YoungProject", "ExampleSubsection",
 CellID->1293753,ExpressionUUID->"94619539-eedd-4a08-ab96-b999bcce88cf"],

Cell["\<\
Use TableauSize[yt] to size a rank-n tensor before applying YoungProject; the \
projector preserves dimensions:\
\>", "ExampleText",
 CellID->191557248,ExpressionUUID->"5a52d7ef-1169-4ff7-ba75-dba23927b6fb"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"yt", " ", "=", " ", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]}], ",", " ", 
     RowBox[{"dim", " ", "=", " ", "2"}]}], "}"}], ",", " ", 
   RowBox[{"Dimensions", "[", 
    RowBox[{"YoungProject", "[", 
     RowBox[{
      RowBox[{"Array", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"a", ",", " ", "##1"}], "]"}], " ", "&"}], " ", ",", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"dim", ",", " ", 
          RowBox[{"TableauSize", "[", "yt", "]"}]}], "]"}]}], "]"}], ",", " ",
       "yt"}], "]"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->820061258,ExpressionUUID->"42c8d44d-d663-47a6-abb3-12458ac0b771"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->942320786,ExpressionUUID->"e29722de-11c7-45f6-ac84-d7c1c8bc1acd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Specht-module bookkeeping", "ExampleSubsection",
 CellID->306544506,ExpressionUUID->"0521c2e0-4217-4b36-9167-844f7024323c"],

Cell["\<\
TableauSize gives the symmetric-group degree n labelling a partition; the sum \
of squared irrep dimensions over partitions of n equals n!:\
\>", "ExampleText",
 CellID->699280929,ExpressionUUID->"ea051130-f218-4666-97ce-6d5219345ca2"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"TableauSize", "[", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "2"}], "}"}], "]"}], "]"}]}], "}"}], ",", " ", 
   
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"TableauDimension", "[", 
         RowBox[{"YoungTableau", "[", "par", "]"}], "]"}], "^", "2"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"par", ",", " ", 
         RowBox[{"IntegerPartitions", "[", "n", "]"}]}], "}"}]}], "]"}], ",", 
     " ", 
     RowBox[{"n", "!"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->718179333,ExpressionUUID->"2ae42fac-a6ea-41db-9a02-9bd0044421bc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"120", ",", "120"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->524642045,ExpressionUUID->"126e4a6c-dc7f-44c2-b8ad-24621a2e08ee"]
}, Open  ]]
}, Open  ]],

