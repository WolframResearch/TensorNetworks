Notebook[{

Cell[CellGroupData[{
Cell["TableauSize", "ObjectName",
 CellID->223337487,ExpressionUUID->"ec7dbdad-9434-4124-a811-cd780569cc8e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d3219baa-2d24-4cc8-ba0d-01838318eec2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauSize",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauSize"], "[", 
   StyleBox["tableau", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ef4bbeab-448a-4f12-b420-8fcd77d9aa98"],
 "\[LineSeparator]returns the total number of boxes in a Young tableau, i.e. \
the sum of its row lengths."
}], "Usage",
 CellID->984669801,ExpressionUUID->"7c3fd359-20bd-4c8c-8416-9a5ea5bd0dcd"],

Cell[TextData[{
 "This symbol lives in the subpackage context ",
 Cell[BoxData["\"\<Wolfram`TensorNetworks`Symmetry`\>\""], "InlineFormula",
  ExpressionUUID->"88f70124-d192-4034-ba41-9a1e8ba81dd2"],
 ". Loading the main context with ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Needs",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Needs"], "[", "\"\<Wolfram`TensorNetworks`\>\"", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "11366d6a-28b1-4295-9fee-2d0e60eb2c6c"],
 " also loads the symmetry subpackage."
}], "Notes",
 CellID->685904443,ExpressionUUID->"4d797a0b-aed4-4d51-ae7d-eb632e4e4341"],

Cell[TextData[{
 "For a tableau ",
 Cell[BoxData[
  StyleBox["yt", "TI"]], "InlineFormula",ExpressionUUID->
  "a2157139-d79e-4590-8fe0-5b86b201dded"],
 " whose rows are ",
 Cell[BoxData[
  StyleBox["rows", "TI"]], "InlineFormula",ExpressionUUID->
  "cee65003-60b9-400f-9a23-a33ea2315f0a"],
 ", ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauSize",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauSize"], "[", 
   StyleBox["yt", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "f7c23a5c-6258-4df0-b9fb-07e8aaf38ed1"],
 " equals ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Total",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Total"], "[", 
   RowBox[{
    ButtonBox["Length",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Length"], "/@", 
    StyleBox["rows", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2921fac7-1d5b-4f8b-b6e3-581ad2e178b9"],
 "."
}], "Notes",
 CellID->309493800,ExpressionUUID->"73ee6f7c-01c4-4a67-a264-120cb3bc7043"],

Cell[TextData[{
 "Equivalent to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Total",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Total"], "[", 
   RowBox[{
    ButtonBox["TableauShape",
     BaseStyle->"Link",
     ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"], "[", 
    StyleBox["yt", "TI"], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "a6b142b6-ce1e-4cd9-ac47-1b6673e04602"],
 "; the size is the sum of the partition stored as the tableau's shape."
}], "Notes",
 CellID->571753287,ExpressionUUID->"3dee7d23-d86f-43b1-bce7-ffbc57aac01c"],

Cell[TextData[{
 "Issues ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauSize",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauSize"], "::", 
   "noyt"}]], "InlineFormula",ExpressionUUID->
  "889eeb10-ae60-429a-a679-e9e591a51321"],
 " and returns ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "2540b003-ee85-41d3-8208-22df0658d4e5"],
 " when called on anything other than a valid ",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"7f481f5c-35a9-478d-984d-7783cbf37aa1"],
 "; use ",
 Cell[BoxData[
  ButtonBox["YoungTableauQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableauQ"]], 
  "InlineFormula",ExpressionUUID->"029dd19a-67b8-4807-960c-c98feb4e9292"],
 " to test inputs first."
}], "Notes",
 CellID->40550656,ExpressionUUID->"7caf1fb9-1c79-44c8-87ba-a87ce6ff14bf"],

Cell[TextData[{
 "The tensor rank required by ",
 Cell[BoxData[
  ButtonBox["YoungSymmetrize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"]], 
  "InlineFormula",ExpressionUUID->"83be8e3e-2096-4a77-a160-195ea333d6be"],
 " and ",
 Cell[BoxData[
  ButtonBox["YoungProject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"]], 
  "InlineFormula",ExpressionUUID->"5d8bc5fc-d60e-4eff-9fbe-86e5dfcf3f2a"],
 " matches ",
 Cell[BoxData[
  ButtonBox["TableauSize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauSize"]], 
  "InlineFormula",ExpressionUUID->"593be2c7-c7b2-4b0f-b2aa-2a24475056a7"],
 " of the tableau, since one slot of the tensor is consumed by each box of \
the diagram."
}], "Notes",
 CellID->924238015,ExpressionUUID->"d586529b-68c2-47b5-adfd-8a10a96ffc10"]
}, Open  ]],

