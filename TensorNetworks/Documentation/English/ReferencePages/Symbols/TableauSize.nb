   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"TableauSize", "[", "yt", "]"}], "!"}], "*", 
      RowBox[{"HookFactor", "[", "yt", "]"}]}], ",", " ", 
     RowBox[{"TableauDimension", "[", "yt", "]"}]}], "}"}]}], "]"}]], "Input",\

