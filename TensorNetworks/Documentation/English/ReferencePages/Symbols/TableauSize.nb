      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"TableauSize", "[", "yt", "]"}], ",", " ", 
     RowBox[{"ArrayDepth", "[", 
      RowBox[{"Array", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"a", ",", " ", "##1"}], "]"}], " ", "&"}], " ", ",", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"2", ",", " ", 
          RowBox[{"TableauSize", "[", "yt", "]"}]}], "]"}]}], "]"}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->710389379,ExpressionUUID->"2ff2a39c-5927-4dd0-9a00-3be4b9e5fb49"],

