Cell["\<\
Without activation, the result equals an inactive TensorContract over the \
TensorProduct of the inputs:\
\>", "ExampleText",
 CellID->794423356,ExpressionUUID->"4d129f3d-1c50-4c0b-aa78-8a64ad882451"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"EinsteinSummation", "[", 
   RowBox[{"\"\<ij,jk->ik\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<A\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<B\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}]}], "}"}]}], "]"}], " ", 
  "===", " ", 
  RowBox[{
   RowBox[{"Inactive", "[", "TensorContract", "]"}], "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Inactive", "[", "TensorProduct", "]"}], "[", 
     RowBox[{
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<A\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<B\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[3]:=",
 CellID->305207011,ExpressionUUID->"4b629806-c7d5-4e45-ad9b-246d73c28604"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]=",
 CellID->260572064,ExpressionUUID->"ce57a7f6-7e3b-4308-a43e-cd0f8c4d0089"]
}, Open  ]],

