     RowBox[{"{", 
      RowBox[{"1", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "7"}], "}"}]}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{
  3.967992755938796*^9, {3.967992851159418*^9, 3.967992867809469*^9}, 
   3.967992950627055*^9, 3.9679936852257977`*^9, 3.988135609700098*^9},
 CellLabel->"Out[1]=",
