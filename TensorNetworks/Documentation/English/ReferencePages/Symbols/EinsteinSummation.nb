Cell["\<\
When an output index appears more often than in the input, the result is \
silently broadcast via repeated TensorProduct \[LongDash] this can be \
unexpected:\
\>", "ExampleText",
 CellID->914565704,ExpressionUUID->"0682557f-00a4-42aa-a008-0e669bcd9bee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "i", "}"}], ",", " ", 
      RowBox[{"{", "j", "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "j", ",", " ", "i", ",", " ", "j"}], "}"}]}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<v\>\"", ",", " ", "n1"}], "]"}], ",", " ", 
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<w\>\"", ",", " ", "n2"}], "]"}]}], "}"}]}], "]"}]], "Input",\

