Cell[TextData[{
 "Using ",
 Cell[BoxData[
  ButtonBox["EinsteinSummation",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/QuantumFramework/ref/EinsteinSummation"]], 
  "InlineFormula",ExpressionUUID->"07ed5ae8-ca93-4881-8eec-acf6314b7aa4"],
 ", compute the reduced density matrix of the physical site, obtained by \
tracing out the virtual/environment legs:"
}], "ExampleText",
 CellChangeTimes->{{3.967994334940988*^9, 3.967994351693418*^9}},
 CellID->246965726,ExpressionUUID->"835be62e-cd09-49a4-a080-57b801617632"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"einsum", "=", 
   RowBox[{"ActivateTensor", "@", 
    RowBox[{"EinsteinSummation", "[", 
     RowBox[{"\"\<\[Alpha]i\[Beta],\[Alpha]j\[Beta]\>\"", ",", 
      RowBox[{"{", 
       RowBox[{"A", ",", 
        RowBox[{"Conjugate", "@", "A"}]}], "}"}]}], "]"}]}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.967994082471691*^9, 3.967994100560186*^9}, {
  3.9679941886483717`*^9, 3.967994190249535*^9}},
 CellLabel->"In[8]:=",
 CellID->1198520043,ExpressionUUID->"994ac9d5-68f7-4a62-812a-8c2336a026a1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"11.50152104384415`", ",", 
     RowBox[{
      RowBox[{"-", "0.4315194138183502`"}], "-", 
      RowBox[{"0.4602106926030406`", " ", "\[ImaginaryI]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "0.4315194138183502`"}], "+", 
      RowBox[{"0.4602106926030407`", " ", "\[ImaginaryI]"}]}], ",", 
     "9.720869354612576`"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9679940849324617`*^9, 3.967994100926475*^9}},
 CellLabel->"Out[8]=",
 CellID->1322298301,ExpressionUUID->"7f53a3f4-a767-4b83-92ef-55aa7b377f3b"]
}, Open  ]],

Cell["\<\
Compute the reduced density matrix manually by running over indices:\
\>", "ExampleText",
 CellChangeTimes->{{3.967994355303793*^9, 3.967994369784486*^9}},
 CellID->110872936,ExpressionUUID->"cbf13c6f-e979-42ab-b4f9-b81fc21f4d2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"[", 
          RowBox[{"\[Alpha]", ",", "i", ",", "\[Beta]"}], "]"}], "]"}], 
        RowBox[{"Conjugate", "@", 
         RowBox[{"A", "[", 
          RowBox[{"[", 
           RowBox[{"\[Alpha]", ",", "j", ",", "\[Beta]"}], "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Beta]", ",", "5"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9679941088215227`*^9, 3.9679941939834223`*^9}},
 CellLabel->"In[10]:=",
 CellID->1642932422,ExpressionUUID->"6d4379b2-dd44-455b-8fcb-e0cfd8107bf4"],

