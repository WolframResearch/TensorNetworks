     "0.32695878970791803`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "0.36131981722611073`"}], ",", 
     RowBox[{"-", "0.17543398084607187`"}], ",", 
     RowBox[{"-", "0.9644430660641903`"}]}], "}"}]}], "}"}]], "Output",
