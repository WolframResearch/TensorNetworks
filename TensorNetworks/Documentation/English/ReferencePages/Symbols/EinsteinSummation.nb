Cell[TextData[{
 "Calculate the Choi state using ",
 Cell[BoxData[
  ButtonBox["EinsteinSummation",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/EinsteinSummation"]], 
  "InlineFormula",ExpressionUUID->"d0bd860a-6fc3-48fb-9678-f62ffc20d71f"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{3.9676379295638227`*^9, 3.967637957229968*^9}},
 CellID->1191765216,ExpressionUUID->"12b1d92e-613b-48d4-b9f8-4576204e946a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[ScriptCapitalE]\[Rho]", "=", 
  RowBox[{"ActivateTensors", "@", 
   RowBox[{"EinsteinSummation", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "k", ",", "j", ",", "l"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "l"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"J", ",", "\[Rho]"}], "}"}]}], "]"}]}]}]], "Input",
