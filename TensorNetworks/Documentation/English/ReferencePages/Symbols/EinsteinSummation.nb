Cell["\<\
For numerical input, an Einstein summation is equivalent to an explicit \
Sum/Table expression:\
\>", "ExampleText",
 CellID->626408756,ExpressionUUID->"387ada2d-cfa5-41fe-84da-f63adfb41549"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "3", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"AA", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"BB", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->73541598,ExpressionUUID->"9d64985c-0e99-497f-9fa3-dca443561ff3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ActivateTensors", " ", "@", " ", 
   RowBox[{"EinsteinSummation", "[", 
    RowBox[{"\"\<ijk,jl->ikl\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"AA", ",", " ", "BB"}], "}"}]}], "]"}]}], " ", "==", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"AA", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", " ", "j", ",", " ", "k"}], "]"}], "]"}], " ", 
       RowBox[{"BB", "[", 
        RowBox[{"[", 
         RowBox[{"j", ",", " ", "l"}], "]"}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"l", ",", " ", "2"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->812776510,ExpressionUUID->"1d1b314c-abb8-42a3-bb28-4f35efcb9962"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]=",
 CellID->124001233,ExpressionUUID->"0e40aea2-7f68-4529-94ae-b89588e0e718"]
}, Open  ]],

