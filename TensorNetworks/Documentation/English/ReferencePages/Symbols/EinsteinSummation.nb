   RowBox[{"EinsteinSummation", "::", "length"}], "TI"]], "InlineFormula",
  ExpressionUUID->"47673446-72fb-4dc9-8d0e-4f2a705f455a"],
 ", ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"EinsteinSummation", "::", "shape"}], "TI"]], "InlineFormula",
  ExpressionUUID->"8c0c5554-58a0-4eb1-89d9-aa61b9cacddb"],
 ", ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"EinsteinSummation", "::", "dim"}], "TI"]], "InlineFormula",
