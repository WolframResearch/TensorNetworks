Cell[BoxData[
 RowBox[{"J", "=", 
  RowBox[{"SparseArray", "@", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "-", "I"}], ",", 
       RowBox[{"1", "+", "I"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"dOut", ",", "dIn", ",", "dOut", ",", "dIn"}], "}"}]}], 
