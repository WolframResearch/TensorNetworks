Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"meanB", "=", 
  RowBox[{"Tr", "[", 
   RowBox[{
    RowBox[{"ArrayReshape", "[", 
     RowBox[{"\[Rho]", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"in", " ", "out"}], ",", " ", 
        RowBox[{"in", " ", "out"}]}], "}"}]}], "]"}], ".", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"I\[Delta]", ",", "B"}], "]"}]}], "]"}]}]], "Input",
