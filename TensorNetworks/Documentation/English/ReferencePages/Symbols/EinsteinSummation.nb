Cell[BoxData[
 RowBox[{"einsum", "=", 
  RowBox[{"ActivateTensors", "@", 
   RowBox[{"EinsteinSummation", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "j", ",", "k"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "l", ",", "m"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"LeviCivitaTensor", "[", "3", "]"}], ",", 
       RowBox[{"LeviCivitaTensor", "[", "3", "]"}]}], "}"}]}], 
    "]"}]}]}]], "Input",
