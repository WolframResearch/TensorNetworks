      RowBox[{"{", 
       RowBox[{"2", ",", "3", ",", "2"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"SparseArray", "@", 
    RowBox[{"RandomComplex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "-", "I"}], ",", 
        RowBox[{"1", "+", "I"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "2"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Activate", "@", 
   RowBox[{"EinsteinSummation", "[", 
    RowBox[{"\"\<ijk,jl->lk\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"A", ",", " ", "B"}], "}"}]}], "]"}]}], "==", 
  RowBox[{"Activate", "@", 
   RowBox[{"EinsteinSummation", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
