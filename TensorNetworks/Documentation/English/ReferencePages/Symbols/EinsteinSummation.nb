   RowBox[{"a", ",", "b"}], "}"}], "=", 
  RowBox[{"RandomReal", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9673950945359383`*^9, 3.967395127976256*^9}, {
  3.967395185012199*^9, 3.967395187917376*^9}},
 CellLabel->"In[9]:=",
