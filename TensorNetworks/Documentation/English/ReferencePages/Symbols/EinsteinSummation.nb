  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", "i", "}"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "i"}], "}"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"ArraySymbol", "[", 
     RowBox[{"\"\<v\>\"", ",", " ", "n"}], "]"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->669536822,ExpressionUUID->"fda2d0b9-1acf-43c3-910b-1cb99494ac21"],

