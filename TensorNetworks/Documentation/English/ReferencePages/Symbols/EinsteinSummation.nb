Cell["\<\
Set the dimensions (assuming J has the dimension {dOut,dIn,dOut,dIn} and \
\[Rho]'s dimension is {dIn,dIn}):\
\>", "ExampleText",
 CellChangeTimes->{{3.967637847982287*^9, 3.967637895738798*^9}},
 CellID->1733748340,ExpressionUUID->"72549e23-cd96-46bd-b0fd-0749a9c13793"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dOut", ",", "dIn"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"3", ",", "5"}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.967637803204801*^9, 3.9676378209206467`*^9}},
 CellLabel->"In[7]:=",
 CellID->896649605,ExpressionUUID->"38a1f30f-39ee-422b-b8f6-8d6392ac7bda"],

Cell["Generate \[Rho] randomly as a complex-valued matrix:", "ExampleText",
 CellChangeTimes->{{3.967637898115075*^9, 3.967637911544779*^9}},
 CellID->2081187944,ExpressionUUID->"980dd319-4a62-4add-922b-c27a203ec9da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Rho]", "=", 
  RowBox[{"SparseArray", "@", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", "=", 
       RowBox[{"RandomComplex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "-", "I"}], ",", 
           RowBox[{"1", "+", "I"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"dIn", ",", "dIn"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"a", ".", 
      RowBox[{"ConjugateTranspose", "[", "a", "]"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.967636725691271*^9, 3.967636726062749*^9}, {
  3.967636802768589*^9, 3.967636830608654*^9}, {3.967637825850177*^9, 
  3.96763782793054*^9}},
 CellLabel->"In[8]:=",
