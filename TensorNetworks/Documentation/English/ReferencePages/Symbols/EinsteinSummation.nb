Cell["\<\
Compute the inner product of two two-qubit states encoded as 2\[Times]2 \
tensors. Define a Bell state and a computational-basis product state:\
\>", "ExampleText",
 CellID->910907258,ExpressionUUID->"5de4c944-cf7b-4f21-be53-237a110af53f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bell", ",", " ", "prod"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->127639744,ExpressionUUID->"350e1830-1cf5-4372-9c2d-9c4390eef278"],

Cell["\<\
The two-tensor contraction sums over both qubit indices and produces the \
overlap scalar:\
\>", "ExampleText",
 CellID->116650904,ExpressionUUID->"b21c9f8e-5274-4008-b8b8-ffcd115ec2d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ActivateTensors", " ", "@", " ", 
  RowBox[{"EinsteinSummation", "[", 
   RowBox[{"\"\<ij,ij->\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Conjugate", " ", "@", " ", "bell"}], ",", " ", "prod"}], 
     "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->693949335,ExpressionUUID->"e24fdaf2-a723-443b-8b6a-9d6351b46358"],

