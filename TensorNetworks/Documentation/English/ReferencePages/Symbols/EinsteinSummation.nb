Cell["Partial trace over the middle subsystem:", "ExampleText",
 CellChangeTimes->{{3.967485232922933*^9, 3.967485235345604*^9}},
 CellID->434068391,ExpressionUUID->"5e65a5e5-c1db-4830-9e4c-6168bc692641"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]f1", "=", 
   RowBox[{"ActivateTensor", "@", 
    RowBox[{"EinsteinSummation", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j", ",", "k", ",", "l", ",", "j", ",", "n"}], 
         "}"}], "}"}], "->", 
       RowBox[{"{", 
        RowBox[{"i", ",", "l", ",", "k", ",", "n"}], "}"}]}], ",", 
      RowBox[{"{", "\[Rho]", "}"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9674040417572412`*^9, 3.9674040637128687`*^9}},
 CellLabel->"In[4]:=",
 CellID->1630515460,ExpressionUUID->"b7542bf6-98dd-4da7-b83d-63c45a5d5ea6"],

Cell["Execute partial trace by running over indices:", "ExampleText",
 CellChangeTimes->{{3.967485559847115*^9, 3.967485577447195*^9}},
 CellID->677305673,ExpressionUUID->"4babaf41-2f62-472c-81fa-af82f864a2bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]f2", "=", 
   RowBox[{"TensorTranspose", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"\[Rho]", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "k", ",", "l", ",", "j", ",", "n"}], 
           "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "dim"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "dim"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "dim"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "dim"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "dim"}], "}"}]}], "]"}], ",", 
     RowBox[{"Cycles", "@", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.967404068113379*^9, 3.967404132223192*^9}, {
   3.967485252145174*^9, 3.967485318913422*^9}, 3.96748541196174*^9, {
   3.967485463061117*^9, 3.9674854645323677`*^9}},
 CellLabel->"In[5]:=",
 CellID->2118113032,ExpressionUUID->"c6f77e86-3fc9-4f5e-8149-8c02c5c9a7da"],

Cell["Double check the results:", "ExampleText",
 CellChangeTimes->{{3.96739817593923*^9, 3.96739818661907*^9}, 
   3.9673987473897038`*^9},
 CellID->29270271,ExpressionUUID->"f2506137-e8f2-40ff-87c3-98aa2b634bd6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]f1", "-", "\[Rho]f2"}], "//", "Chop"}], "//", "Flatten"}], 
  "//", "DeleteDuplicates"}]], "Input",
 CellChangeTimes->{{3.9673986685644817`*^9, 3.967398671318634*^9}, {
  3.9674853075924273`*^9, 3.9674853094629507`*^9}},
 CellLabel->"In[6]:=",
 CellID->171689534,ExpressionUUID->"17be2f5e-fc0b-4317-8380-dd33cbf752f1"],

Cell[BoxData[
 RowBox[{"{", "0", "}"}]], "Output",
 CellChangeTimes->{{3.967485309949791*^9, 3.967485321704403*^9}, 
   3.9674854056578283`*^9, {3.967485465945406*^9, 3.96748547105873*^9}},
 CellLabel->"Out[6]=",
 CellID->108834778,ExpressionUUID->"a2a00fc0-bde3-4d83-baf6-f6a072c9c849"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "8fa58d27-9ce5-4844-97d2-564dfccbbbfe"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->317052892,ExpressionUUID->"a1b3cb23-0f0a-4e9f-b3fe-f32bd842ebac"],

Cell[TextData[{
 "Channel action via Choi state where a general quantum channel \
\[ScriptCapitalE] (noise, gate, measurement-prep) acting on a state \[Rho], \
and Choi ",
 Cell[BoxData[
 "J"], "InlineFormula",ExpressionUUID->"678ac3c8-abe2-45b6-8e27-84310ddcc386"],
 " encodes the map (useful for tomography/verification). It can written as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[ScriptCapitalE]", 
    SubscriptBox[
     RowBox[{"(", "\[Rho]", ")"}], "ij"]}], "=", 
   RowBox[{
    SubscriptBox["\[Sum]", "kl"], 
    RowBox[{
     SubscriptBox["J", 
      RowBox[{"ik", ",", "jl"}]], 
     SubscriptBox["\[Rho]", "kl"]}]}]}]], "InlineFormula",ExpressionUUID->
  "b31aeaa5-7ffd-46a5-9844-3004fef5e027"],
 " or ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[ScriptCapitalE]", 
    RowBox[{"(", "\[Rho]", ")"}]}], "=", 
   RowBox[{
    SubscriptBox["Tr", "in"], "[", 
    RowBox[{"J", 
     RowBox[{"(", 
      RowBox[{"I", "\[CircleTimes]", 
       SuperscriptBox["\[Rho]", "T"]}], ")"}]}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"8ed01d07-2ac8-48ce-a16d-dd749f20a861"],
 " with the trace being over ",
 Cell[BoxData[
  RowBox[{"k", ",", "l"}]], "InlineFormula",ExpressionUUID->
  "a6825d5b-25f8-4535-bf01-0ae0c11e7b2c"]
}], "ExampleText",
 CellChangeTimes->{{3.9676363895144*^9, 3.9676365866925983`*^9}},
 CellID->1530823392,ExpressionUUID->"dec6e40b-f07e-4d46-876d-09f085665dde"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", "k", ",", "j", ",", "l"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "l"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<J\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "3", ",", "3", ",", "3"}], "}"}]}], "]"}], ",", 
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<\[Rho]\>\"", ",", 
       RowBox[{"{", 
