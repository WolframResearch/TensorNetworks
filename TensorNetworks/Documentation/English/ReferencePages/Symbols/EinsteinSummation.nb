Cell[TextData[{
 "Unitary evolution of a density matrix ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[Rho]", "mn"], "=", 
   RowBox[{
    SubscriptBox["\[Sum]", "ij"], 
    RowBox[{
     SubscriptBox["U", "mi"], 
     SubscriptBox["\[Rho]", "ij"], 
     SubsuperscriptBox["U", "nj", "*"]}]}]}]], "InlineFormula",ExpressionUUID->
  "7b741af6-7f60-4002-b671-a14cea783ec8"]
}], "ExampleText",
 CellChangeTimes->{{3.9673981985974283`*^9, 3.967398256990777*^9}},
 CellID->1910415201,ExpressionUUID->"241e6517-9439-4557-a056-25ff36c139e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", "i"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "j"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "j"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<U\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n"}], "}"}]}], "]"}], ",", 
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<\[Rho]\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n"}], "}"}]}], "]"}], ",", 
     RowBox[{"Conjugate", "@", 
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<U\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}]}], "}"}]}], "]"}]], "Input",\

 CellChangeTimes->{{3.967398272291*^9, 3.967398309575803*^9}},
 CellLabel->"In[1]:=",
 CellID->1448886547,ExpressionUUID->"ee98e8cd-2083-42e8-b152-b03c95ba2a33"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"TensorContract"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[TensorContract]"], "[", 
  RowBox[{
   RowBox[{
    TemplateBox[{"\"U\"", "2", "n", "n"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    TemplateBox[{"\"\[Rho]\"", "2", "n", "n"},
