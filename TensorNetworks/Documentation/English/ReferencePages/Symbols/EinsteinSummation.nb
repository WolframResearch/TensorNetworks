Cell[TextData[{
 "Generate a random density in the Hilbert space of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalH]", "3"], "\[CircleTimes]", 
   SubscriptBox["\[ScriptCapitalH]", "3"], "\[CircleTimes]", 
   SubscriptBox["\[ScriptCapitalH]", "3"]}]], "InlineFormula",ExpressionUUID->
  "e026aa6d-494c-4826-b418-a42810f56abd"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{3.967485109047409*^9, 3.967485211842648*^9}, {
  3.96748554761841*^9, 3.967485550743032*^9}},
 CellID->1013727489,ExpressionUUID->"4f1f7fac-4d44-4bb8-be73-71f7722fb6d5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dim", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Rho]", "=", 
  RowBox[{
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"I", " ", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{"GaussianUnitaryMatrixDistribution", "[", 
        RowBox[{"dim", "^", "3"}], "]"}], "]"}]}], ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"dim", ",", "6"}], "]"}]}], "]"}], "//", 
   "SparseArray"}]}]}], "Input",
 CellChangeTimes->{{3.9674039163657427`*^9, 3.967403956069662*^9}, {
  3.967404006179269*^9, 3.9674040376230917`*^9}, {3.967485357480117*^9, 
  3.9674853591850767`*^9}},
 CellLabel->"In[2]:=",
