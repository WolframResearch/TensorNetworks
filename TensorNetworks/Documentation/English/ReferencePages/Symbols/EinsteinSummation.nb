Cell["Generate J randomly as a complex-valued tensor:", "ExampleText",
 CellChangeTimes->{{3.967637914524576*^9, 3.967637926358427*^9}},
 CellID->1654945322,ExpressionUUID->"f13f5fcc-32d5-47f6-8758-8e821fa57f6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"J", "=", 
  RowBox[{"SparseArray", "@", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "-", "I"}], ",", 
       RowBox[{"1", "+", "I"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"dOut", ",", "dIn", ",", "dOut", ",", "dIn"}], "}"}]}], 
    "]"}]}]}]], "Input",
