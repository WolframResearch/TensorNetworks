Cell[TextData[{
 "Double-epsilon identity ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Sum]", "i"], 
    RowBox[{
     SubscriptBox["\[Epsilon]", "ijk"], 
     SubscriptBox["\[Epsilon]", "ilm"]}]}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Delta]", "jl"], 
     SubscriptBox["\[Delta]", "km"]}], "-", 
    RowBox[{
     SubscriptBox["\[Delta]", "jm"], 
     SubscriptBox["\[Delta]", "kl"]}]}]}]], "InlineFormula",ExpressionUUID->
  "13c9cfb0-473f-48bd-8730-d67c2069e19f"]
}], "ExampleText",
 CellChangeTimes->{{3.967395322756762*^9, 3.967395389275858*^9}, {
  3.9673956414966917`*^9, 3.9673956436371193`*^9}},
 CellID->589178024,ExpressionUUID->"c252f20c-7231-4814-8980-91089633d71c"],

