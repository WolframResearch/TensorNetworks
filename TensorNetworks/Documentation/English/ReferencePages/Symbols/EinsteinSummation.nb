Cell[TextData[{
 "Partial trace of a bipartite density matrix ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[Rho]", "A"], "=", 
   RowBox[{
    SubscriptBox["Tr", "B"], "[", 
    SubscriptBox["\[Rho]", "AB"], "]"}]}]], "InlineFormula",ExpressionUUID->
  "f52abfaf-ae20-4ed0-a54d-b89baca2e525"],
 " which can be written as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[Rho]", "ik"], "=", 
   RowBox[{
    SubscriptBox["\[Sum]", "j"], 
    SubscriptBox["\[Rho]", 
     RowBox[{"ij", ",", "kj"}]]}]}]], "InlineFormula",ExpressionUUID->
  "216f9ce6-6eb6-42ad-af74-15ab192e388b"]
}], "ExampleText",
 CellChangeTimes->{{3.9674855209318933`*^9, 3.967485530794991*^9}, {
