Cell["Partial trace over the middle subsystem:", "ExampleText",
 CellChangeTimes->{{3.967485232922933*^9, 3.967485235345604*^9}},
 CellID->434068391,ExpressionUUID->"5e65a5e5-c1db-4830-9e4c-6168bc692641"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]f1", "=", 
   RowBox[{"ActivateTensors", "@", 
    RowBox[{"EinsteinSummation", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j", ",", "k", ",", "l", ",", "j", ",", "n"}], 
         "}"}], "}"}], "->", 
       RowBox[{"{", 
        RowBox[{"i", ",", "l", ",", "k", ",", "n"}], "}"}]}], ",", 
      RowBox[{"{", "\[Rho]", "}"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9674040417572412`*^9, 3.9674040637128687`*^9}},
 CellLabel->"In[5]:=",
 CellID->1630515460,ExpressionUUID->"b7542bf6-98dd-4da7-b83d-63c45a5d5ea6"],

Cell["Execute partial trace by running over indices:", "ExampleText",
 CellChangeTimes->{{3.967485559847115*^9, 3.967485577447195*^9}},
 CellID->677305673,ExpressionUUID->"4babaf41-2f62-472c-81fa-af82f864a2bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]f2", "=", 
   RowBox[{"TensorTranspose", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"\[Rho]", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "k", ",", "l", ",", "j", ",", "n"}], 
           "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "dim"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "dim"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "dim"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "dim"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "dim"}], "}"}]}], "]"}], ",", 
     RowBox[{"Cycles", "@", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.967404068113379*^9, 3.967404132223192*^9}, {
   3.967485252145174*^9, 3.967485318913422*^9}, 3.96748541196174*^9, {
   3.967485463061117*^9, 3.9674854645323677`*^9}},
 CellLabel->"In[6]:=",
 CellID->2118113032,ExpressionUUID->"c6f77e86-3fc9-4f5e-8149-8c02c5c9a7da"],

Cell["Double check the results:", "ExampleText",
 CellChangeTimes->{{3.96739817593923*^9, 3.96739818661907*^9}, 
   3.9673987473897038`*^9},
 CellID->29270271,ExpressionUUID->"f2506137-e8f2-40ff-87c3-98aa2b634bd6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]f1", "-", "\[Rho]f2"}], "//", "Chop"}], "//", "Flatten"}], 
  "//", "DeleteDuplicates"}]], "Input",
