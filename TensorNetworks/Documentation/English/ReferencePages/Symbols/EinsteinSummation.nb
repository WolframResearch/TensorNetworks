Cell[TextData[{
 "Calculate he Choi state based on summations (we used ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "4b49107e-b27c-4476-a64e-ceec1f67ff88"],
 " and ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "73a06175-70ad-4305-b36a-8358e0c83c98"],
 " instead of explicit summation)"
}], "ExampleText",
 CellChangeTimes->{{3.9676379604333553`*^9, 3.96763803022165*^9}},
 CellID->1181770974,ExpressionUUID->"53cf1378-90f8-4604-99bb-e7696ba25085"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[ScriptCapitalE]\[Rho]2", "=", 
  RowBox[{"TensorContract", "[", 
   RowBox[{
    RowBox[{"TensorProduct", "[", 
     RowBox[{"J", ",", 
      RowBox[{"Transpose", "@", "\[Rho]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"4", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.967636995225953*^9, 3.9676370109697247`*^9}, {
   3.967637257826664*^9, 3.967637329352994*^9}, 3.9676374560302763`*^9, {
