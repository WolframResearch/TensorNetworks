 TemplateBox[{
   RowBox[{
     TemplateBox[{"TensorContract"}, "InactiveHead", BaseStyle -> "Inactive", 
      Tooltip -> "Inactive[TensorContract]", SyntaxForm -> "Symbol"], "[", 
     RowBox[{
       RowBox[{
         RowBox[{"Inactive", "[", "TensorProduct", "]"}], "[", 
         TemplateBox[{"\"\[Rho]\"", "6", "n", "n", "n", "n", "n", "n"}, 
          "ArraySymbol2", SyntaxForm -> OverscriptBox], "]"}], ",", 
       RowBox[{"{", 
         RowBox[{"{", 
