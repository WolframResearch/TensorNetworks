Cell[TextData[{
 "Compute the mean-value of ",
 Cell[BoxData[
 "B"], "InlineFormula",ExpressionUUID->"7b78870e-12fa-470a-9f81-9030b31672bc"],
 " using the trace formula:"
}], "ExampleText",
 CellChangeTimes->{{3.9679938391741047`*^9, 3.967993860402343*^9}},
 CellID->550173316,ExpressionUUID->"4584eefd-e8be-47a8-b570-818ecd0fb58c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"meanB", "=", 
  RowBox[{"Tr", "[", 
   RowBox[{
    RowBox[{"ArrayReshape", "[", 
     RowBox[{"\[Rho]", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"in", " ", "out"}], ",", " ", 
        RowBox[{"in", " ", "out"}]}], "}"}]}], "]"}], ".", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"I\[Delta]", ",", "B"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9679931058546333`*^9, 3.967993154166613*^9}, {
