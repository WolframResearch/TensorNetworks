Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "8fa58d27-9ce5-4844-97d2-564dfccbbbfe"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->317052892,ExpressionUUID->"a1b3cb23-0f0a-4e9f-b3fe-f32bd842ebac"],

Cell[TextData[{
 "Channel action via Choi state where a general quantum channel \
\[ScriptCapitalE] (noise, gate, measurement-prep) acting on a state \[Rho], \
and Choi ",
 Cell[BoxData[
 "J"], "InlineFormula",ExpressionUUID->"678ac3c8-abe2-45b6-8e27-84310ddcc386"],
 " encodes the map (useful for tomography/verification). It can written as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[ScriptCapitalE]", 
    SubscriptBox[
     RowBox[{"(", "\[Rho]", ")"}], "ij"]}], "=", 
   RowBox[{
    SubscriptBox["\[Sum]", "kl"], 
    RowBox[{
     SubscriptBox["J", 
      RowBox[{"ik", ",", "jl"}]], 
     SubscriptBox["\[Rho]", "kl"]}]}]}]], "InlineFormula",ExpressionUUID->
  "b31aeaa5-7ffd-46a5-9844-3004fef5e027"],
 " or ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[ScriptCapitalE]", 
    RowBox[{"(", "\[Rho]", ")"}]}], "=", 
   RowBox[{
    SubscriptBox["Tr", "in"], "[", 
    RowBox[{"J", 
     RowBox[{"(", 
      RowBox[{"I", "\[CircleTimes]", 
       SuperscriptBox["\[Rho]", "T"]}], ")"}]}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"8ed01d07-2ac8-48ce-a16d-dd749f20a861"],
 " with the trace being over ",
 Cell[BoxData[
  RowBox[{"k", ",", "l"}]], "InlineFormula",ExpressionUUID->
  "a6825d5b-25f8-4535-bf01-0ae0c11e7b2c"]
}], "ExampleText",
 CellChangeTimes->{{3.9676363895144*^9, 3.9676365866925983`*^9}},
 CellID->1530823392,ExpressionUUID->"dec6e40b-f07e-4d46-876d-09f085665dde"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", "k", ",", "j", ",", "l"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "l"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<J\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "3", ",", "3", ",", "3"}], "}"}]}], "]"}], ",", 
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<\[Rho]\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.967398272291*^9, 3.967398309575803*^9}, {
  3.967403435969823*^9, 3.9674035399009867`*^9}, {3.967636601915436*^9, 
  3.967636666951153*^9}, {3.967636704408762*^9, 3.967636710007308*^9}},
 CellLabel->"In[1]:=",
 CellID->357513707,ExpressionUUID->"89eb171f-b201-4be0-aa0f-823e63f01e35"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"TensorContract"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[TensorContract]"], "[", 
  RowBox[{
   RowBox[{
    TemplateBox[{"\"J\"", "4", "3", "3", "3", "3"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    TemplateBox[{"\"\[Rho]\"", "2", "3", "3"},
     "ArraySymbol2"]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "6"}], "}"}]}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{
  3.967636667468651*^9, {3.967636707009645*^9, 3.967636710439403*^9}, 
   3.9676369577746983`*^9, 3.967637794056602*^9, 3.988135609526741*^9},
 CellLabel->"Out[1]=",
 CellID->1349833562,ExpressionUUID->"ef55cd0d-6570-4904-bd83-bcb1506f7785"]
}, Open  ]],

Cell["\<\
Set the dimensions (assuming J has the dimension {dOut,dIn,dOut,dIn} and \
\[Rho]'s dimension is {dIn,dIn}):\
\>", "ExampleText",
 CellChangeTimes->{{3.967637847982287*^9, 3.967637895738798*^9}},
 CellID->1733748340,ExpressionUUID->"72549e23-cd96-46bd-b0fd-0749a9c13793"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dOut", ",", "dIn"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"3", ",", "5"}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.967637803204801*^9, 3.9676378209206467`*^9}},
 CellLabel->"In[2]:=",
 CellID->896649605,ExpressionUUID->"38a1f30f-39ee-422b-b8f6-8d6392ac7bda"],

Cell["Generate \[Rho] randomly as a complex-valued matrix:", "ExampleText",
 CellChangeTimes->{{3.967637898115075*^9, 3.967637911544779*^9}},
 CellID->2081187944,ExpressionUUID->"980dd319-4a62-4add-922b-c27a203ec9da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Rho]", "=", 
  RowBox[{"SparseArray", "@", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", "=", 
       RowBox[{"RandomComplex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "1"}], "-", "I"}], ",", 
           RowBox[{"1", "+", "I"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"dIn", ",", "dIn"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"a", ".", 
      RowBox[{"ConjugateTranspose", "[", "a", "]"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.967636725691271*^9, 3.967636726062749*^9}, {
  3.967636802768589*^9, 3.967636830608654*^9}, {3.967637825850177*^9, 
  3.96763782793054*^9}},
 CellLabel->"In[3]:=",
 CellID->1351136524,ExpressionUUID->"4de61d39-e512-4e5c-9392-7ac9dca9ece0"],

