Cell[BoxData[
 InterpretationBox[
  StyleBox[
   RowBox[{
    RowBox[{"Inactive", "[", "TensorContract", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Inactive", "[", "TensorProduct", "]"}], "[", 
      RowBox[{
       RowBox[{"ArraySymbol", "[", 
        RowBox[{"\"\<A\>\"", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
