Cell[TextData[{
 "Calculate the cross product via Levi-Civita ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"a", "\[Times]", "b"}], ")"}], "i"], "=", 
   RowBox[{
    SubscriptBox["\[Sum]", "jk"], 
    RowBox[{
     SubscriptBox["\[Epsilon]", "ijk"], 
     SubscriptBox["a", "j"], 
     SubscriptBox["b", "k"]}]}]}]], "InlineFormula",ExpressionUUID->
  "52abd811-9528-4ece-bba7-297405992f79"]
}], "ExampleText",
 CellChangeTimes->{{3.967395017153284*^9, 3.967395086125053*^9}},
 CellID->689176208,ExpressionUUID->"a2f486d5-b39d-4857-a5ad-512c566042fc"],

