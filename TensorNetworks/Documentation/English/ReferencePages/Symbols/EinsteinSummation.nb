Cell["\<\
An inactive EinsteinSummation expression can be lifted into a TensorNetwork \
for path optimization and large-scale contraction:\
\>", "ExampleText",
 CellID->512388827,ExpressionUUID->"2c18c323-77ed-4a7e-8f2b-b5b4a0b5c11d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorNetwork", " ", "@", " ", 
  RowBox[{"EinsteinSummation", "[", 
   RowBox[{"\"\<ij,jk,kl->il\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<A\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<B\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<C\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "2"}], "}"}]}], "]"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->640559245,ExpressionUUID->"5c08abb1-080a-43fc-825b-226797fc93be"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["TensorNetwork",
    "SummaryHead"], "[", 
   DynamicModuleBox[{Typeset`open$$ = False, Typeset`embedState$$ = "Ready"}, 
    
    TemplateBox[{
      PaneSelectorBox[{False -> GridBox[{{
            PaneBox[
             ButtonBox[
              DynamicBox[
               FEPrivate`FrontEndResource["FEBitmaps", "SummaryBoxOpener"]], 
              ButtonFunction :> (Typeset`open$$ = True), Appearance -> None, 
              BaseStyle -> {}, Evaluator -> Automatic, Method -> 
              "Preemptive"], Alignment -> {Center, Center}, ImageSize -> 
             Dynamic[{
               Automatic, 
                3.5 (CurrentValue["FontCapHeight"]/AbsoluteCurrentValue[
                 Magnification])}]], 
            GraphicsBox[{
              Opacity[0.5], 
              Arrowheads[{{Medium, 0.5}}], 
              AbsoluteThickness[Medium], {{
                Opacity[1], 
                Arrowheads[{{Small, 0.5}}], {
                 Directive[
                  Arrowheads[{{0.03, 0.5}}], 
                  LightDarkSwitched[
                   Opacity[0.7, 
                    Hue[0.63, 0.7, 0.5]], 
                   GrayLevel[1]]], {
                  LineBox[{{0., 3.0000000000000004`}, {1., 2.4}}], 
                  Opacity[1], {}}}}, {
                Opacity[1], 
                Arrowheads[{{Small, 0.5}}], {
                 Directive[
                  Arrowheads[{{0.03, 0.5}}], 
                  LightDarkSwitched[
                   Opacity[0.7, 
                    Hue[0.63, 0.7, 0.5]], 
                   GrayLevel[1]]], {
