Cell[TextData[{
 "Generate a random density in the Hilbert space of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalH]", "3"], "\[CircleTimes]", 
   SubscriptBox["\[ScriptCapitalH]", "5"]}]], "InlineFormula",ExpressionUUID->
  "7998daf4-65e1-4bd9-b600-28b7ce2fbd4a"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{3.967485109047409*^9, 3.967485211842648*^9}, {
  3.96748554761841*^9, 3.967485550743032*^9}, {3.967587290912994*^9, 
  3.9675872930451727`*^9}},
 CellID->2033413685,ExpressionUUID->"45701e79-2560-4bf5-89ba-2c073b926726"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dim", "=", 
   RowBox[{"3", "*", "5"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Rho]", "=", 
  RowBox[{
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"I", " ", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{"GaussianUnitaryMatrixDistribution", "[", 
        RowBox[{"dim", "^", "3"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "5", ",", "3", ",", "5"}], "}"}]}], "]"}], "//", 
   "SparseArray"}]}]}], "Input",
 CellChangeTimes->{{3.9674039163657427`*^9, 3.967403956069662*^9}, {
  3.967404006179269*^9, 3.9674040376230917`*^9}, {3.967485357480117*^9, 
