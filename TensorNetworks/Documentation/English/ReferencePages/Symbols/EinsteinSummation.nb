     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    RowBox[{"Conjugate", "[", 
     TemplateBox[{"\"U\"", "2", "n", "n"},
      "ArraySymbol2"], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "6"}], "}"}]}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.9673983130828333`*^9, 3.967398766792344*^9},
 CellLabel->"Out[1]=",
 CellID->1878485362,ExpressionUUID->"20098ab2-c6a1-41c1-99cb-4724709f1d87"]
}, Open  ]],

