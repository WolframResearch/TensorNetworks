Cell[BoxData[
 RowBox[{"delta", "=", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", "=", "3"}], "}"}], ",", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"#1", ",", "#3"}], "]"}], " ", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"#2", ",", "#4"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"#1", ",", "#4"}], "]"}], " ", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"#2", ",", "#3"}], "]"}]}]}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n", ",", "n", ",", "n"}], "}"}]}], "]"}]}], "]"}], 
   "//", "SparseArray"}]}]], "Input",
