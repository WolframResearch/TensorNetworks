        RowBox[{"1", "+", "I"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"SparseArray", "@", 
    RowBox[{"RandomComplex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "-", "I"}], ",", 
        RowBox[{"1", "+", "I"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.967392746383511*^9, 3.967392767921207*^9}, {
  3.9673929204775667`*^9, 3.967392927544922*^9}, {3.9673929619239883`*^9, 
  3.967392965463582*^9}, {3.96739461834795*^9, 3.96739462327594*^9}, {
  3.967394895824483*^9, 3.967394898814637*^9}},
 CellLabel->"In[5]:=",
 CellID->1701224330,ExpressionUUID->"5f1da3bb-cb55-4df8-9148-31b5b7c9fe0e"],

Cell[TextData[{
 "Calculate the inner product of two tensors as ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{"A", ",", " ", "B"}], "\[RightAngleBracket]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"Tr", "[", 
     RowBox[{
      RowBox[{"SuperDagger", "[", "A", "]"}], " ", "B"}], "]"}], " ", "=", 
    " ", 
    RowBox[{
     SubscriptBox["\[Sum]", "ij"], 
     RowBox[{
      SubsuperscriptBox["A", "ij", "*"], 
      SubscriptBox["B", "ij"]}]}]}]}]], "InlineFormula",ExpressionUUID->
  "dafabec8-0de5-4c13-9969-332e4f414ccb"]
}], "ExampleText",
 CellChangeTimes->{{3.967394556004354*^9, 3.9673945855384493`*^9}, {
  3.967394634648604*^9, 3.967394646792983*^9}, {3.9673947076020727`*^9, 
  3.967394710965029*^9}, {3.967394931277439*^9, 3.967394950755397*^9}, {
  3.967395050416658*^9, 3.9673950504167347`*^9}},
 CellID->1048148243,ExpressionUUID->"0ede8964-7511-4df8-b04e-91b5d3eb734c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"einsum", "=", 
  RowBox[{"ActivateTensors", "@", 
   RowBox[{"EinsteinSummation", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Conjugate", "@", "A"}], ",", "B"}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9673945891336203`*^9, 3.967394593836988*^9}, {
  3.967394719409004*^9, 3.9673947417534237`*^9}, {3.967395859283062*^9, 
  3.9673958601316137`*^9}},
 CellLabel->"In[10]:=",
 CellID->1390559519,ExpressionUUID->"2318175d-5cbb-4e7b-82c0-3e187bc2600a"],

Cell[BoxData[
 RowBox[{"0.8873325468907033`", "\[VeryThinSpace]", "-", 
  RowBox[{"1.3409547517628577`", " ", "\[ImaginaryI]"}]}]], "Output",
 CellChangeTimes->{3.967394742709428*^9, 3.967394901360732*^9, 
