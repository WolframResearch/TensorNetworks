 CellID->421733970,ExpressionUUID->"2228a82d-2808-474f-896a-f96631a3ca33"],

Cell["\<\
For numerical input, an Einstein summation is equivalent to an explicit \
Sum/Table expression:\
\>", "ExampleText",
 CellID->626408756,ExpressionUUID->"387ada2d-cfa5-41fe-84da-f63adfb41549"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "3", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"AA", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"BB", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->73541598,ExpressionUUID->"9d64985c-0e99-497f-9fa3-dca443561ff3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ActivateTensors", " ", "@", " ", 
   RowBox[{"EinsteinSummation", "[", 
    RowBox[{"\"\<ijk,jl->ikl\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"AA", ",", " ", "BB"}], "}"}]}], "]"}]}], " ", "==", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"AA", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", " ", "j", ",", " ", "k"}], "]"}], "]"}], " ", 
       RowBox[{"BB", "[", 
        RowBox[{"[", 
         RowBox[{"j", ",", " ", "l"}], "]"}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"l", ",", " ", "2"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->812776510,ExpressionUUID->"1d1b314c-abb8-42a3-bb28-4f35efcb9962"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]=",
 CellID->124001233,ExpressionUUID->"0e40aea2-7f68-4529-94ae-b89588e0e718"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "876c7bde-11e5-41e0-ba03-4e31b8d4a714"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->918889618,ExpressionUUID->"c7c59e83-409f-486a-8880-4c0266a9a44b"],

Cell["\<\
Without activation, the result equals an inactive TensorContract over the \
TensorProduct of the inputs:\
\>", "ExampleText",
 CellID->794423356,ExpressionUUID->"4d129f3d-1c50-4c0b-aa78-8a64ad882451"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"EinsteinSummation", "[", 
   RowBox[{"\"\<ij,jk->ik\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<A\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<B\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}]}], "}"}]}], "]"}], " ", 
  "===", " ", 
  RowBox[{
   RowBox[{"Inactive", "[", "TensorContract", "]"}], "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Inactive", "[", "TensorProduct", "]"}], "[", 
     RowBox[{
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<A\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<B\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[3]:=",
 CellID->305207011,ExpressionUUID->"4b629806-c7d5-4e45-ad9b-246d73c28604"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]=",
 CellID->260572064,ExpressionUUID->"ce57a7f6-7e3b-4308-a43e-cd0f8c4d0089"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "a7982eba-e0ea-43d8-b2de-5dbde3c1a8dd"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->66043357,ExpressionUUID->"d0aee4dd-2bc8-4d0d-9709-d1c3f5c4e875"],

Cell["\<\
When a single tensor has a repeated index, EinsteinSummation dispatches to \
IndexedMultiply before TensorContract:\
\>", "ExampleText",
 CellID->60906122,ExpressionUUID->"84e9ee9b-9418-42fe-8bf4-042b1b9078f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{"\"\<iij\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{"ArraySymbol", "[", 
     RowBox[{"\"\<T\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "n", ",", " ", "n"}], "}"}]}], "]"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->641439478,ExpressionUUID->"e214d2de-59c9-4046-a5e5-8ffc85661e3a"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"TensorContract"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[TensorContract]"], "[", 
  RowBox[{
   TemplateBox[{"\"T\"", "3", "n", "n", "n"},
    "ArraySymbol2"], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "}"}]}], "]"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->430276818,ExpressionUUID->"118e6072-9d5a-4874-95c9-00cc5377711b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "00c2f81c-de92-46c1-99a8-2f614689e4a8"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->730837359,ExpressionUUID->"6477ee29-626b-4b51-a098-9bf6dbeb6afc"],

Cell["\<\
For numerical input the activated result agrees with the system \
TensorContract/TensorProduct chain:\
\>", "ExampleText",
 CellID->691738876,ExpressionUUID->"982b3f00-01e2-492e-9ee9-ea5b515dd280"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "4", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"P", ",", " ", "Q"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[5]:=",
 CellID->685784885,ExpressionUUID->"5db63e9e-ebfb-46ca-b87d-c1781a28eaf8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ActivateTensors", " ", "@", " ", 
   RowBox[{"EinsteinSummation", "[", 
    RowBox[{"\"\<ij,jk->ik\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"P", ",", " ", "Q"}], "}"}]}], "]"}]}], " ", "==", " ", 
  RowBox[{"TensorContract", "[", 
   RowBox[{
    RowBox[{"TensorProduct", "[", 
     RowBox[{"P", ",", " ", "Q"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[6]:=",
 CellID->855215181,ExpressionUUID->"9d57e135-e188-4f89-9549-e29909f14e2e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[6]=",
 CellID->697373392,ExpressionUUID->"faaf126c-9b26-4fd8-a324-832d1b564d02"]
}, Open  ]]
}, Open  ]]
}, Closed]],

