Cell["\<\
The einsum-string parser splits indices one character at a time. \
Multi-character names are misread, so use the list form for them:\
\>", "ExampleText",
 CellID->427213468,ExpressionUUID->"2571f2fe-8c7f-44b2-bbc7-4a862e0c42b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"alpha", ",", " ", "beta"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"beta", ",", " ", "gamma"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"alpha", ",", " ", "gamma"}], "}"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"n1", ",", " ", "n2"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<B\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"n2", ",", " ", "n3"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->387381085,ExpressionUUID->"4855042e-1894-48a0-8c81-27a53b822c17"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"TensorContract"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[TensorContract]"], "[", 
  RowBox[{
   RowBox[{
    TemplateBox[{"\"A\"", "2", "n1", "n2"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    TemplateBox[{"\"B\"", "2", "n2", "n3"},
     "ArraySymbol2"]}], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], "}"}]}], "]"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->942729184,ExpressionUUID->"100fc8c4-ab5e-46dc-a395-4db99f6a3faf"]
}, Open  ]],

