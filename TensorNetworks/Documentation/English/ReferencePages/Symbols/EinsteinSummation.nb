Cell[TextData[{
 "Expectation value of a local operator ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", "B", "\[RightAngleBracket]"}], "=", 
   RowBox[{
    RowBox[{"Tr", "[", 
     RowBox[{
      SubscriptBox["\[Rho]", "AB"], 
      RowBox[{"(", 
       RowBox[{"I", "\[CircleTimes]", "B"}], ")"}]}], "]"}], "=", 
    RowBox[{
     SubscriptBox["\[Sum]", "ijkl"], 
     RowBox[{
      SubscriptBox["\[Rho]", "ijkl"], 
      SubscriptBox["\[Delta]", "ik"], 
      SubscriptBox["B", "lj"]}]}]}]}]], "InlineFormula",ExpressionUUID->
  "8e971ccb-4f72-4013-9d64-be9156c8023b"]
}], "ExampleText",
 CellChangeTimes->{{3.9679935582293663`*^9, 3.967993682243886*^9}},
 CellID->606007621,ExpressionUUID->"f1345c90-b513-47ed-9220-e669ce56b25c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{"\"\<ijkl,ik,lj\>\"", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<\[Rho]\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"in", ",", "out", ",", "in", ",", "out"}], "}"}]}], "]"}], ",", 
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<I\[Delta]\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"in", ",", "in"}], "}"}]}], "]"}], ",", 
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<P\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"out", ",", "out"}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.967992679997563*^9, 3.9679928673148127`*^9}, {
  3.9679936391361847`*^9, 3.9679936479413643`*^9}},
 CellLabel->"In[24]:=",
 CellID->599825065,ExpressionUUID->"ac6efc31-0044-41f1-99e7-91e784cc3942"],

