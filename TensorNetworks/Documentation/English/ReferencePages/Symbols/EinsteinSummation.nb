Cell["This can be done by feeding the indices as string too:", "ExampleText",
 CellChangeTimes->{{3.967919171329701*^9, 3.96791917878687*^9}},
 CellID->1167935804,ExpressionUUID->"45aa8fb3-748f-4eca-af87-2f8861fd3cd8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{"\"\<ijkljn->ilkn\>\"", ",", 
   RowBox[{"{", 
    RowBox[{"ArraySymbol", "[", 
     RowBox[{"\"\<\[Rho]\>\"", ",", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"n", ",", "6"}], "]"}]}], "]"}], "}"}]}], "]"}]], "Input",
