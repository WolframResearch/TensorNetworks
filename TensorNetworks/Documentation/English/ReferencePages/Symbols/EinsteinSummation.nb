Cell["\<\
Compute the reduced density matrix manually by running over indices:\
\>", "ExampleText",
 CellChangeTimes->{{3.967994355303793*^9, 3.967994369784486*^9}},
 CellID->110872936,ExpressionUUID->"cbf13c6f-e979-42ab-b4f9-b81fc21f4d2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"[", 
          RowBox[{"\[Alpha]", ",", "i", ",", "\[Beta]"}], "]"}], "]"}], 
        RowBox[{"Conjugate", "@", 
         RowBox[{"A", "[", 
          RowBox[{"[", 
           RowBox[{"\[Alpha]", ",", "j", ",", "\[Beta]"}], "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Beta]", ",", "5"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9679941088215227`*^9, 3.9679941939834223`*^9}},
 CellLabel->"In[10]:=",
 CellID->1642932422,ExpressionUUID->"6d4379b2-dd44-455b-8fcb-e0cfd8107bf4"],

