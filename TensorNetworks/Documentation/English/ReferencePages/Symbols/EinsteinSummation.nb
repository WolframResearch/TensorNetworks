Cell["Get the tensor on the right-side of above equation:", "ExampleText",
 CellChangeTimes->{{3.967395638289001*^9, 3.967395661033763*^9}},
 CellID->2088793296,ExpressionUUID->"158aeb7d-3cd4-4df9-a862-4e2ae79e9849"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"delta", "=", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", "=", "3"}], "}"}], ",", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"#1", ",", "#3"}], "]"}], " ", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"#2", ",", "#4"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"#1", ",", "#4"}], "]"}], " ", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"#2", ",", "#3"}], "]"}]}]}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n", ",", "n", ",", "n"}], "}"}]}], "]"}]}], "]"}], 
   "//", "SparseArray"}]}]], "Input",
 CellChangeTimes->{{3.9673954649982653`*^9, 3.9673954678738747`*^9}, {
  3.96739549856711*^9, 3.9673955004838047`*^9}, {3.967395598383232*^9, 
