Cell[TextData[{
 "Frobenius inner product via Hadamard then trace ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Sum]", "ij"], 
    RowBox[{
     SubscriptBox["A", "ij"], 
     SubscriptBox["B", "ij"]}]}], "=", 
   RowBox[{"Tr", "[", 
    RowBox[{
     SuperscriptBox["A", "T"], "\[SmallCircle]", "B"}], "]"}]}]], 
  "InlineFormula",ExpressionUUID->"b962d08b-49be-48ab-821a-624a5b421aae"],
 " with \[SmallCircle] representing the Hadamard product:"
}], "ExampleText",
 CellChangeTimes->{{3.96763843268156*^9, 3.967638518368226*^9}},
 CellID->425778728,ExpressionUUID->"ad7bcaec-9035-4a91-bd89-1c8464dd2f60"],

