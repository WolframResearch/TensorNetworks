Cell[CellGroupData[{
Cell["EinsteinSummation", "ObjectName",
 CellID->621891010,ExpressionUUID->"f3a35fe5-7efa-4b0a-9021-1e52fa6eb673"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e5fd1188-3607-4a20-bf1f-265ceeb5ed5e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EinsteinSummation",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/EinsteinSummation"], "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["i\:2081", "TI"], ",", 
       StyleBox["i\:2082", "TI"], ",", "\[Ellipsis]"}], "}"}], "\[Rule]", 
     StyleBox["out", "TI"]}], ",", 
    RowBox[{"{", 
     RowBox[{"A\:2081", ",", "A\:2082", ",", "\[Ellipsis]"}], "}"}]}], "]"}]],
   "InlineFormula",ExpressionUUID->"bcd254b6-5f16-4e1a-b96f-26f0e6c46d47"],
 "\[LineSeparator]contracts the tensors A\:2081,A\:2082,\[Ellipsis] according \
to the index specification. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2298afdb-f48c-47c8-838a-42136641db4d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EinsteinSummation",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/EinsteinSummation"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["i\:2081", "TI"], ",", 
      StyleBox["i\:2082", "TI"], ",", "\[Ellipsis]"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"A\:2081", ",", "A\:2082", ",", "\[Ellipsis]"}], "}"}]}], "]"}]],
   "InlineFormula",ExpressionUUID->"0ebd7e75-21de-4ef6-9685-9526e2eaeff9"],
 "\[LineSeparator]automatically determines output indices from indices \
appearing exactly once. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"358a0da5-7b2d-4e06-91c6-9a56b14a58bd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EinsteinSummation",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/EinsteinSummation"], "[", 
   RowBox[{"\"\<\!\(\*StyleBox[RowBox[{\"ij\", \",\", RowBox[{\"jk\", \"->\", \
\"ik\"}]}], \"TI\"]\)\>\"", ",", 
    RowBox[{"{", 
     RowBox[{"A", ",", "B"}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "861f6b34-b545-4ad9-a96d-aae5695d549f"],
 "\[LineSeparator]uses string notation where commas separate tensor indices \
and-> specifies output."
}], "Usage",
 CellChangeTimes->{{3.978637636644114*^9, 3.9786376366803427`*^9}, {
  3.978637676185402*^9, 3.978637694015869*^9}},
 CellID->319295121,ExpressionUUID->"2df3516b-a00b-42dc-a2c8-cf309bdb03d1"],

Cell["\<\
The indices can be list of any expression, or a string. If a string is \
provided, it will be split by delimiters matching \",\" and \"->\".\
\>", "Notes",
 CellChangeTimes->{{3.9673922976192703`*^9, 3.967392403302842*^9}},
 CellID->1925551234,ExpressionUUID->"188faf47-9f59-413e-8b44-ff0d87eaf436"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["EinsteinSummation",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/QuantumFramework/ref/EinsteinSummation"]], 
  "InlineFormula",ExpressionUUID->"ad7c69d1-a776-4bc4-a6af-9af5af1e5c60"],
 " accepts tensors of any kind, symbolic or explicit, including all types of \
arrays."
}], "Notes",
 CellChangeTimes->{{3.967392438507124*^9, 3.967392509192812*^9}},
 CellID->1645193739,ExpressionUUID->"a8113a82-4c09-4913-9251-7b04913ffcbf"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["EinsteinSummation",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/QuantumFramework/ref/EinsteinSummation"]], 
  "InlineFormula",ExpressionUUID->"60f2f740-fb24-4e6f-a76e-494c19e24ccb"],
 " returns an expression with ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "2c57e386-2eac-47f2-8805-87d361eff205"],
 " and ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "a55770bc-d8cb-4ef7-815a-216aafaa6f37"],
 " left inactive (and possibly a ",
 Cell[BoxData[
  ButtonBox["TensorTranspose",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "822930ac-a95a-45a9-95d7-38e740603da1"],
 ")."
}], "Notes",
 CellChangeTimes->{{3.967392438507124*^9, 3.967392509192812*^9}, {
  3.96739257231642*^9, 3.967392616683941*^9}},
