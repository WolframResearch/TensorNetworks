Cell[TextData[{
 "Partial trace of a bipartite density matrix ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[Rho]", "A"], "=", 
   RowBox[{
    SubscriptBox["Tr", "B"], "[", 
    SubscriptBox["\[Rho]", "AB"], "]"}]}]], "InlineFormula",ExpressionUUID->
  "f52abfaf-ae20-4ed0-a54d-b89baca2e525"],
 " which can be written as ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[Rho]", "ik"], "=", 
   RowBox[{
    SubscriptBox["\[Sum]", "j"], 
    SubscriptBox["\[Rho]", 
     RowBox[{"ij", ",", "kj"}]]}]}]], "InlineFormula",ExpressionUUID->
  "216f9ce6-6eb6-42ad-af74-15ab192e388b"]
}], "ExampleText",
 CellChangeTimes->{{3.9674855209318933`*^9, 3.967485530794991*^9}, {
  3.9675872442740583`*^9, 3.967587258274179*^9}, {3.967587683635633*^9, 
  3.967587727173951*^9}},
 CellID->1099325274,ExpressionUUID->"7dce505b-56c7-4a2e-abbc-7d4a80eaec32"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"i", ",", "j", ",", "k", ",", "j"}], "}"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"ArraySymbol", "[", 
     RowBox[{"\"\<\[Rho]\>\"", ",", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"n", ",", "4"}], "]"}]}], "]"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.967398272291*^9, 3.967398309575803*^9}, {
  3.967403435969823*^9, 3.9674035399009867`*^9}, {3.9675872685551357`*^9, 
  3.967587280158971*^9}},
 CellLabel->"In[1]:=",
 CellID->2129960568,ExpressionUUID->"4207e42f-04cb-448c-a99d-8cf450ae0dd1"],

