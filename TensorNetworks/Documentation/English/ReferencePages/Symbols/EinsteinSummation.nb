        SyntaxForm -> "\[TensorProduct]"], 
       TemplateBox[{"\"w\"", "1", "n2"}, "ArraySymbol2", SyntaxForm -> 
        OverscriptBox]}], ")"}], "2", "\[TensorProduct]"},
  "GeneralizedPower"]], "Output",
