Cell["\<\
The einsum-string parser tokenises one character per index, so unicode named \
characters (Greek letters) work directly:\
\>", "ExampleText",
 CellID->116609067,ExpressionUUID->"5e7a5385-cd9e-4905-8bc6-d605ff4eb43e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{"\"\<\[Alpha]i\[Beta],\[Alpha]j\[Beta]\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"n1", ",", " ", "n2", ",", " ", "n3"}], "}"}]}], "]"}], ",", 
     " ", 
     RowBox[{"Conjugate", " ", "@", " ", 
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<A\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"n1", ",", " ", "n2", ",", " ", "n3"}], "}"}]}], "]"}]}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
