Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"einsum", "=", 
  RowBox[{"ActivateTensor", "@", 
   RowBox[{"EinsteinSummation", "[", 
    RowBox[{"\"\<ijkl,ik,lj\>\"", ",", 
     RowBox[{"{", 
      RowBox[{"\[Rho]", ",", "I\[Delta]", ",", "B"}], "}"}]}], 
    "]"}]}]}]], "Input",
