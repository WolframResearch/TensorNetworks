     RowBox[{
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], 
       RowBox[{"B", "[", 
        RowBox[{"[", 
         RowBox[{"j", ",", "l"}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
