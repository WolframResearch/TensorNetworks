  RowBox[{"\"\<i,ij,j->\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<x\>\"", ",", " ", "n"}], "]"}], ",", " ", 
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<M\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "n"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<x\>\"", ",", " ", "n"}], "]"}]}], "}"}]}], "]"}]], "Input",\

