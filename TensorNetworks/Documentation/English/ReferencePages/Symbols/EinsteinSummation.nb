Cell["\<\
Multiply two matrices via the einsum-string form, then activate to a \
numerical result:\
\>", "ExampleText",
 CellID->61913009,ExpressionUUID->"49f87f2c-fc7a-488e-b66e-0b4b4517fcb0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Amat", ",", " ", "Bmat"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"ActivateTensors", " ", "@", " ", 
  RowBox[{"EinsteinSummation", "[", 
   RowBox[{"\"\<ij,jk->ik\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{"Amat", ",", " ", "Bmat"}], "}"}]}], "]"}]}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->663686473,ExpressionUUID->"6bffbc20-1217-4854-9e91-81d646ec554b"],

