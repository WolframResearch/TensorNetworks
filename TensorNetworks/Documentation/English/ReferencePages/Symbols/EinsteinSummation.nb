Cell["Numerically, with a 3\[Times]3 symmetric matrix:", "ExampleText",
 CellID->238040375,ExpressionUUID->"1bfe23a0-b0bf-4ce5-96b2-131d0570c422"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Msym", " ", "=", " ", 
   RowBox[{
    RowBox[{"SymmetrizedArray", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i_", ",", " ", "j_"}], "}"}], " ", ":>", " ", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "]"}]}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"Symmetric", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], "]"}], " ", "//", " ", 
    "Normal"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xvec", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "3"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[2]:=",
