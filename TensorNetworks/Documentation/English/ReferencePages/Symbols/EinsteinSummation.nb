Cell["Partial trace over the middle subsystem:", "ExampleText",
 CellChangeTimes->{{3.967485232922933*^9, 3.967485235345604*^9}},
 CellID->1310426311,ExpressionUUID->"5abd3f27-9bd2-42af-94d4-9f18241896f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]f1", "=", 
   RowBox[{"ActivateTensor", "@", 
    RowBox[{"EinsteinSummation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"i", ",", "j", ",", "k", ",", "j"}], "}"}], "}"}], ",", 
      RowBox[{"{", "\[Rho]", "}"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9674040417572412`*^9, 3.9674040637128687`*^9}, 
   3.9675873301666403`*^9},
 CellLabel->"In[4]:=",
 CellID->1890208992,ExpressionUUID->"596181c9-4f27-421e-8554-6b113b630db1"],

Cell["Execute partial trace by running over indices:", "ExampleText",
 CellChangeTimes->{{3.967485559847115*^9, 3.967485577447195*^9}},
 CellID->1016938473,ExpressionUUID->"f081881f-bc64-47fa-88ce-39dfa9fb8641"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]f2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j", ",", "k", ",", "j"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "5"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.967404068113379*^9, 3.967404132223192*^9}, {
   3.967485252145174*^9, 3.967485318913422*^9}, 3.96748541196174*^9, {
   3.967485463061117*^9, 3.9674854645323677`*^9}, {3.9675873389614573`*^9, 
   3.967587389790905*^9}},
 CellLabel->"In[5]:=",
 CellID->2010052885,ExpressionUUID->"84fee0a8-e107-4cab-8e21-319045089ae7"],

