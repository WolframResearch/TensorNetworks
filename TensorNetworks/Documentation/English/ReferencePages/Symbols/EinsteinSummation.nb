     RowBox[{"-", "0.6784002998376057`"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.1618892007329693`", ",", 
     RowBox[{"-", "0.7166324717254531`"}], ",", 
     RowBox[{"-", "0.598084945239405`"}]}], "}"}]}], "}"}]], "Output",
