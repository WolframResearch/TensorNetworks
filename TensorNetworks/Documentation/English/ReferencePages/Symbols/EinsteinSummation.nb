Cell["\<\
Consider a tripartite system, with each qudit of dimension 3 (or a 3-qutrit \
system).\
\>", "ExampleText",
 CellChangeTimes->{{3.9674855209318933`*^9, 3.967485530794991*^9}},
 CellID->747816263,ExpressionUUID->"004ccb7d-c7da-4078-afdf-91e379ff7142"],

Cell["Partial trace over the middle subsystem 3-qutrit density:", \
"ExampleText",
 CellChangeTimes->{{3.9674854898793173`*^9, 3.9674855430781937`*^9}},
 CellID->1677530249,ExpressionUUID->"0ab23b84-9d1d-4e49-94f4-a4b86d3a3a08"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"i", ",", "j", ",", "k", ",", "l", ",", "j", ",", "n"}], "}"}], 
     "}"}], "->", 
    RowBox[{"{", 
     RowBox[{"i", ",", "l", ",", "k", ",", "n"}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"ArraySymbol", "[", 
     RowBox[{"\"\<\[Rho]\>\"", ",", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"n", ",", "6"}], "]"}]}], "]"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.967398272291*^9, 3.967398309575803*^9}, {
   3.967403435969823*^9, 3.9674035399009867`*^9}, 3.967919136556525*^9},
 CellLabel->"In[1]:=",
 CellID->1471290886,ExpressionUUID->"0f1e29a6-0e78-4f60-b5e2-2d3326ba64ad"],

