Cell[TextData[{
 "Contract a 3-tensor with its conjugate over two legs (reduced density) ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[Rho]", "ij"], "=", 
   RowBox[{
    SubscriptBox["\[Sum]", "\[Alpha]\[Beta]"], 
    RowBox[{
     SubscriptBox["A", "\[Alpha]i\[Beta]"], 
     SubsuperscriptBox["A", "\[Alpha]j\[Beta]", "*"]}]}]}]], "InlineFormula",
  ExpressionUUID->"f363e908-344d-4aa9-862f-b22d30de0a83"]
}], "ExampleText",
 CellChangeTimes->{{3.967993925332115*^9, 3.967993977974572*^9}, {
  3.967994231915806*^9, 3.9679942332716312`*^9}},
 CellID->517582775,ExpressionUUID->"3c110f40-0113-4347-93a9-adf996cbba1d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{"\"\<\[Alpha]i\[Beta],\[Alpha]j\[Beta]\>\"", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ArraySymbol", "[", 
      RowBox[{"\"\<A\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"n1", ",", "n2", ",", "n3"}], "}"}]}], "]"}], ",", 
     RowBox[{"Conjugate", "@", 
      RowBox[{"ArraySymbol", "[", 
       RowBox[{"\"\<A\>\"", ",", 
        RowBox[{"{", 
         RowBox[{"n1", ",", "n2", ",", "n3"}], "}"}]}], "]"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.967993994206996*^9, 3.967994042259417*^9}},
 CellLabel->"In[4]:=",
 CellID->1803673602,ExpressionUUID->"7a92d615-d9a4-46a1-af26-85d6ae5e1495"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"TensorContract"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[TensorContract]"], "[", 
  RowBox[{
   RowBox[{
    TemplateBox[{"\"A\"", "3", "n1", "n2", "n3"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    RowBox[{"Conjugate", "[", 
     TemplateBox[{"\"A\"", "3", "n1", "n2", "n3"},
      "ArraySymbol2"], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "6"}], "}"}]}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{{3.967994003809972*^9, 3.967994042707898*^9}},
 CellLabel->"Out[4]=",
 CellID->559078924,ExpressionUUID->"d6a297d2-b512-43f3-8616-d37dfb304412"]
}, Open  ]],

Cell["Generate a random complex-valued 3-tensor:", "ExampleText",
 CellChangeTimes->{{3.9679942157830057`*^9, 3.9679942363456287`*^9}},
 CellID->1685441399,ExpressionUUID->"27ab4b3c-ee0b-4608-a829-c6b104f44039"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "-", "I"}], ",", 
       RowBox[{"1", "+", "I"}]}], "}"}], ",", 
