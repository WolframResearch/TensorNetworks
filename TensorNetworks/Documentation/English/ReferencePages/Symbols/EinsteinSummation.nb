Cell[CellGroupData[{
Cell["EinsteinSummation", "ObjectName",
 CellID->621891010,ExpressionUUID->"f3a35fe5-7efa-4b0a-9021-1e52fa6eb673"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"601a6738-2326-4048-b865-c61bd1febb6c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EinsteinSummation",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/EinsteinSummation"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["i", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["i", "TI"], "2"], ",", "\[Ellipsis]"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["A", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["A", "TI"], "2"], ",", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"c2ce0420-290e-4a39-84b2-5bf3683af709"],
 "\[LineSeparator]returns an inactive expression contracting the tensors ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["A", "TI"], "1"], ",", 
   SubscriptBox[
    StyleBox["A", "TI"], "2"], ",", "\[Ellipsis]"}]], "InlineFormula",
  ExpressionUUID->"35837eac-43cd-4c94-b59f-37540995e8d4"],
 " over indices that appear more than once, with the output indices \
automatically taken to be those appearing exactly once.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e11d02f3-2557-45b6-92d5-534a23585222"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EinsteinSummation",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/EinsteinSummation"], "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["i", "TI"], "1"], ",", 
       SubscriptBox[
        StyleBox["i", "TI"], "2"], ",", "\[Ellipsis]"}], "}"}], "\[Rule]", 
     StyleBox["out", "TI"]}], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["A", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["A", "TI"], "2"], ",", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"55cca264-7683-4d14-9daa-e3e4f678c634"],
 "\[LineSeparator]uses ",
 Cell[BoxData[
  StyleBox["out", "TI"]], "InlineFormula",ExpressionUUID->
  "9ec88a19-cba5-44a5-adb1-414318b70c96"],
 " as the explicit list of output indices.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"49783070-1ab4-4607-82db-b555a1b63493"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EinsteinSummation",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/EinsteinSummation"], "[", 
   RowBox[{
    StyleBox["\"\<spec\>\"", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["A", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["A", "TI"], "2"], ",", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"f542115e-4e2a-42cb-b592-964ca4d63b6f"],
 "\[LineSeparator]parses ",
 Cell[BoxData[
  StyleBox["\"\<spec\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "7c382622-14f6-4382-86ee-c9cd9c369838"],
 " as an einsum-style string such as ",
 Cell[BoxData[
  StyleBox["\"\<ij,jk->ik\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "ad93075c-e541-4fef-8c66-554c1585a5fc"],
 " in which commas separate the per-tensor index lists and ",
 Cell[BoxData[
  StyleBox["\"\<->\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "65e005d2-54dd-449e-b6e4-3d726a20e3fb"],
 " separates input indices from output."
}], "Usage",
 CellID->387566558,ExpressionUUID->"b410f70f-9609-40f3-af8b-9f52666a7346"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["EinsteinSummation",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/EinsteinSummation"]], 
  "InlineFormula",ExpressionUUID->"7a34af69-828a-44aa-86c8-095153d743a8"],
 " accepts tensors of any kind, dense or sparse, including symbolic ",
 Cell[BoxData[
  ButtonBox["ArraySymbol",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "908dbab3-f11e-40f1-8b67-afb7166e45ba"],
 " tensors."
}], "Notes",
 CellID->388740678,ExpressionUUID->"57d1c61f-17be-439b-8bfa-2d2d2ebf54e2"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["EinsteinSummation",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/EinsteinSummation"]], 
  "InlineFormula",ExpressionUUID->"01c1f881-2ab6-41f9-a467-0c11f7b2ddfa"],
 " returns an expression with ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "12e0701a-9c22-48ca-998c-6598aa140ee3"],
 " and ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "f82e32e5-cc5d-4bb4-9bff-7e50c7f94974"],
 " left ",
 Cell[BoxData[
  ButtonBox["Inactive",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "a9f33065-3937-429e-aa1f-c5ce34a2fefa"],
 " (and possibly a final ",
 Cell[BoxData[
  ButtonBox["Transpose",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "7e97ee6b-447b-49f2-8e3b-fc4a679a721f"],
 ")."
}], "Notes",
 CellID->637531148,ExpressionUUID->"9cca0dbb-a506-45ef-a250-10e89834b2d0"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  ButtonBox["ActivateTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ActivateTensors"]], 
  "InlineFormula",ExpressionUUID->"b6460512-85ef-4d85-8166-690f3e4fa054"],
 " (or ",
 Cell[BoxData[
  ButtonBox["Activate",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "da7741f0-c031-4a32-aeb6-12860c70947e"],
 ") to evaluate the inactive expression to a numerical or symbolic tensor."
}], "Notes",
 CellID->372169404,ExpressionUUID->"bb78a3be-eab7-4bb5-bde7-f7f652ec3034"],

Cell["\<\
Indices may be any expressions. When the index spec is a string it is split \
on \",\" and \"->\" and each character of an input segment becomes one index, \
so the string form is convenient for single-character indices only; use the \
list form for multi-character or symbolic indices.\
\>", "Notes",
 CellID->52194391,ExpressionUUID->"0f9b400e-e010-4b5d-870d-3fdbd01c90c0"],

Cell[TextData[{
 "Repeated indices within a single tensor are contracted first via ",
 Cell[BoxData[
  ButtonBox["IndexedMultiply",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/IndexedMultiply"]], 
  "InlineFormula",ExpressionUUID->"b7c96bb2-6cb6-442b-abf9-357961f1bdcc"],
 " before the cross-tensor ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "4f535dba-47ba-4a84-8c2b-41a89edc4e09"],
 " is applied."
}], "Notes",
 CellID->535714205,ExpressionUUID->"43a7e788-9a3e-4b6a-bfaa-f0b5677a59ef"],

Cell[TextData[{
 "Tensors whose index list is the empty list ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "745d9bd9-2e4c-4087-b656-033788ba8357"],
 " are treated as scalars and factored out as a multiplicative prefactor."
}], "Notes",
 CellID->381450864,ExpressionUUID->"39fc526c-53da-4a54-84b0-dfc948f78761"],

Cell[TextData[{
 "When an output index occurs more times than it appears in the input, the \
result is broadcast via repeated ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "c984946d-e50a-4382-9f3f-b3e3b3fbf557"],
 "."
}], "Notes",
 CellID->331848204,ExpressionUUID->"fafde12d-6de9-41aa-8e93-726045e55b5e"],

