Cell[TextData[{
 "Define a random matrix \[Rho] in the Hilbert space of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[ScriptCapitalH]", "3"], "\[CircleTimes]", 
   SubscriptBox["\[ScriptCapitalH]", "5"]}]], "InlineFormula",ExpressionUUID->
  "cb78f501-ab3e-4b68-921b-a6dcf674e65a"],
 ", and a random matrix ",
 Cell[BoxData[
 "B"], "InlineFormula",ExpressionUUID->"7c576070-2655-4ee1-a92f-2a53328cd33b"],
 " in the Hilbert space of ",
 Cell[BoxData[
  SubscriptBox["\[ScriptCapitalH]", "5"]], "InlineFormula",ExpressionUUID->
  "ba53a54c-4162-493e-b9e5-b03b7ee39d14"],
 ":"
}], "ExampleText",
 CellChangeTimes->{{3.9679936961403093`*^9, 3.967993789401017*^9}},
 CellID->1532496064,ExpressionUUID->"2248136b-292f-4761-a5ec-c4fe7ddd8011"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"in", "=", "3"}], ";", 
  RowBox[{"out", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]", "=", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "-", "I"}], ",", 
       RowBox[{"1", "+", "I"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"in", ",", "out", ",", "in", ",", "out"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"I\[Delta]", "=", 
   RowBox[{"IdentityMatrix", "[", "in", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "-", "I"}], ",", 
       RowBox[{"1", "+", "I"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"out", ",", "out"}], "}"}]}], "]"}]}], ";"}]}], "Input",
