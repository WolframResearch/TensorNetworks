Cell["Define two random complex-valued tensors:", "ExampleText",
 CellChangeTimes->{{3.9673927214164762`*^9, 3.967392745165921*^9}, {
  3.967392911876747*^9, 3.967392918242161*^9}},
 CellID->679227684,ExpressionUUID->"744f30c5-1151-4657-9f19-34b94bf837ef"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"SparseArray", "@", 
    RowBox[{"RandomComplex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "-", "I"}], ",", 
        RowBox[{"1", "+", "I"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3", ",", "2"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"SparseArray", "@", 
    RowBox[{"RandomComplex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "-", "I"}], ",", 
        RowBox[{"1", "+", "I"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "2"}], "}"}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.967392746383511*^9, 3.967392767921207*^9}, {
  3.9673929204775667`*^9, 3.967392927544922*^9}, {3.9673929619239883`*^9, 
  3.967392965463582*^9}},
 CellLabel->"In[1]:=",
 CellID->766834192,ExpressionUUID->"7b42a97c-0afe-4cde-88bf-8c6c009b526d"],

