Cell["\<\
The column lengths form the conjugate partition of the tableau shape:\
\>", "ExampleText",ExpressionUUID->"d52d0508-1153-4aba-bc4b-4083140e7fb4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"yt", " ", "=", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "6"}], "}"}], ",", " ", 
      RowBox[{"{", "7", "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Length", " ", "/@", " ", 
   RowBox[{"TableauColumns", "[", "yt", "]"}]}], " ", "==", " ", 
  RowBox[{"TransposePartition", "[", 
   RowBox[{"TableauShape", "[", "yt", "]"}], "]"}]}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9a21fa77-4f8a-4c49-84b2-cd9e509905da"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b291289e-4e20-4e22-93d0-76c530d1e681"]
}, Open  ]],

