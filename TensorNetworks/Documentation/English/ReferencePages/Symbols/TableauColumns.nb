Notebook[{

Cell[CellGroupData[{
Cell["TableauColumns", "ObjectName",
 CellID->128988309,ExpressionUUID->"5e686b59-c041-489e-9c2f-c82538e29017"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"007be015-fb42-4b28-9c4b-2fbaa22d0dab"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauColumns",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauColumns"], "[", 
   StyleBox["tableau", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "982dac79-736e-444d-93cb-aac2f12e94e3"],
 "\[LineSeparator]returns the column slot lists of a Young tableau."
}], "Usage",
 CellID->129489681,ExpressionUUID->"aad7e502-6b8c-45f5-9e58-6ec3f74fc95b"],

Cell[TextData[{
 "This symbol lives in the subpackage context ",
 Cell[BoxData["\"\<Wolfram`TensorNetworks`Symmetry`\>\""], "InlineFormula",
  ExpressionUUID->"d3ab09cc-5507-4fd7-9cd5-2c562c167e62"],
 ". Load it explicitly with ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Needs",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Needs"], 
   "[", "\"\<Wolfram`TensorNetworks`Symmetry`\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"b50cf322-c546-46ad-9c2b-b4ce07ecd671"],
 "; loading only the main context does not auto-load this subpackage."
}], "Notes",
 CellID->797221435,ExpressionUUID->"8f11163d-8409-493f-95c5-c6337ad22406"],

Cell[TextData[{
 "Column ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "e1028814-7e86-4ab9-9a3b-f80dc196f1f2"],
 " collects the slot at position ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "cad12a79-b57a-4f7b-9c16-a393d7e7f33b"],
 " of every row that reaches position ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "9b18b9b3-1b7c-4c7f-9231-732b4d123373"],
 "; the routine handles ragged shapes."
}], "Notes",
 CellID->557450933,ExpressionUUID->"695d0d61-0a80-46b7-9adf-7c1fd25f44a7"],

Cell[TextData[{
 "The result satisfies ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Length",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Length"], "/@", " ", "TableauColumns", "[", 
   StyleBox["yt", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7b215c7c-7f1c-4de0-9443-eb83a6d88e48"],
 " equals ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TransposePartition",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TransposePartition"], "[", 
   
   RowBox[{
    ButtonBox["TableauShape",
     BaseStyle->"Link",
     ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"], "[", 
    StyleBox["yt", "TI"], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "08d4ddca-7e7d-4ccf-928a-6509e35304da"],
 " (the conjugate partition)."
}], "Notes",
 CellID->420699443,ExpressionUUID->"c4b24026-9d40-4823-9d99-bfb9b4cda0ae"],

Cell[TextData[{
 Cell[BoxData[
 "TableauColumns"], "InlineFormula",ExpressionUUID->
  "2cb2bcb9-8b6c-47f2-93d9-1c0cc256efbe"],
 " is what ",
 Cell[BoxData[
  ButtonBox["YoungSymmetrize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"]], 
  "InlineFormula",ExpressionUUID->"40a48c10-931c-4733-983f-bcc90af7d1ea"],
 " consults to drive its column antisymmetrization step; pair with ",
 Cell[BoxData[
  ButtonBox["TableauRows",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauRows"]], 
  "InlineFormula",ExpressionUUID->"ec9d83ee-94b4-40af-9ce7-9abfbdadfa10"],
 " to feed both to the kernel's ",
 Cell[BoxData[
  ButtonBox["Symmetrize",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Symmetrize"]], "InlineFormula",ExpressionUUID->
  "cf38f75f-7bb1-4a9c-91ca-4df9669cce76"],
 "."
}], "Notes",
 CellID->544170992,ExpressionUUID->"f5a2e629-4b79-4e87-9cea-8f6e2c304eea"],

Cell[TextData[{
 "Issues ",
 Cell[BoxData[
  RowBox[{"TableauColumns", "::", "noyt"}]], "InlineFormula",ExpressionUUID->
  "9b009008-a581-4a08-970c-ab1c84f7250f"],
 " and returns ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "45eb8105-1d08-4c66-92b3-1c449010c8f4"],
 " when called on anything other than a valid ",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"24476741-a904-4243-9fa0-20175fc37567"],
 "."
}], "Notes",
 CellID->155464230,ExpressionUUID->"e94f0ea2-d63e-4293-9064-d6a4561db001"]
}, Open  ]],

