Cell[CellGroupData[{
Cell["TableauColumns", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2df89fa0-df83-4bf1-942a-d7af1fed34c8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauColumns",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauColumns"], "[", 
   StyleBox["tableau", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "10ea3dec-461d-429a-be83-831b62f915aa"],
 " returns the column slot lists of ",
 StyleBox["tableau", "TI"],
 ", with column ",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "20087459-e099-4e14-b4bf-95bce337fd7f"],
 " collecting the slot at position ",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f982a28c-657f-4c8d-b837-1f3cacbae625"],
 " of every row reaching position ",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "98d10e75-6459-4617-a7c7-abf05208e0c5"],
 "."
}], "Usage",ExpressionUUID->"f66a9c12-52ef-4b8c-a712-53a4ca2b3395"],

Cell[TextData[{
 "The column lengths give the conjugate (transpose) partition of ",
 StyleBox["tableau", "TI"],
 "'s shape \[LongDash] equivalent to ",
 Cell[BoxData[
  ButtonBox["TransposePartition",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TransposePartition"]], 
  "InlineFormula",ExpressionUUID->"4e5bb95b-dcd8-4b1a-ac29-397f8ac9bfa6"],
 " applied to ",
 Cell[BoxData[
  ButtonBox["TableauShape",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"]], 
  "InlineFormula",ExpressionUUID->"3f08cc55-9fe3-4372-a143-5cc9afc26712"],
 "."
}], "Notes",ExpressionUUID->"75422fca-221d-4fea-94e4-27f9bd93b1e7"],

Cell["\<\
Ragged tableau shapes are handled: short rows simply contribute no entry to \
their missing columns.\
\>", "Notes",ExpressionUUID->"975f31bf-6488-4bab-8974-a1a6154a0d9b"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"8741c50e-b748-443f-8d97-570880908146"],
 " is atomic, so columns are not directly accessible via ",
 Cell[BoxData[
  ButtonBox["Part",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Part"]], "InlineFormula",ExpressionUUID->
  "b28b6865-7836-4307-920b-9dce2fa0ed8c"],
 "; ",
 Cell[BoxData[
  ButtonBox["TableauColumns",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauColumns"]], 
  "InlineFormula",ExpressionUUID->"f1748d44-91f8-4530-bb4e-0b83591b8804"],
 " is the canonical accessor."
}], "Notes",ExpressionUUID->"332381e0-274c-48e2-a32b-1b4d8b6e246a"]
}, Open  ]],

