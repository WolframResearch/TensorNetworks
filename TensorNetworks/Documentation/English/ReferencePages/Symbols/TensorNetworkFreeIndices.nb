Cell["Get the uncontracted (free) indices in a tensor network:", "ExampleText",
 CellID->610001001,ExpressionUUID->"610001001-free-text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->610001002,ExpressionUUID->"610001002-free-input1"],

Cell[BoxData[
 RowBox[{"TensorNetworkFreeIndices", "[", "tn", "]"}]], "Input",
