Cell[CellGroupData[{
Cell["TensorNetworkDelete", "ObjectName",
 CellID->1810190673,ExpressionUUID->"0ee1e5e5-9a92-47d1-91be-d5162a241f73"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d2a4927d-8515-4389-9ef6-18460c2724d9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkDelete",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkDelete"], "[", 
   RowBox[{
    StyleBox["tn", "TI"], ",", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "14d2d31d-2da9-45b7-a30c-fe037391c528"],
 "\[LineSeparator]removes the ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "9c83f956-ff6b-4bc0-8f4b-ca99bca98800"],
 "th tensor from the tensor network ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "e552cbc4-16fa-481c-b813-02941445c511"],
 ". \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b5ddfed8-3d47-45d4-8840-73de27829239"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkDelete",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkDelete"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2ac020be-9940-4f2d-8822-3737a7ee7e6a"],
 "\[LineSeparator]removes the last tensor (default ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   RowBox[{"-", "1"}]}]], "InlineFormula",ExpressionUUID->
  "2853cc0c-bc20-4b8b-b124-ce39b4dc03f1"],
 "). \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b99d764b-8312-4d75-9e67-7ae0407a0cca"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkDelete",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkDelete"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3369f322-e878-40ce-a88d-620745ebdb6e"],
 "\[LineSeparator]operates on the annotated ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "d7c874eb-5004-4bc0-8890-6b361acd6cab"],
 " form, removing the ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "dc9f08ae-15ee-4d53-86d4-5a27ea8865e9"],
 "th vertex and its incident edges."
}], "Usage",
 CellID->473814062,ExpressionUUID->"5d93244c-0d03-4434-bd78-eed14c8a09a1"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "78e4309c-9c09-44c7-815c-4d6cd0f300d7"],
 " can be negative; ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   RowBox[{"-", "1"}]}]], "InlineFormula",ExpressionUUID->
  "5a2488ba-7e31-4f1e-8b79-836d988709a7"],
 " refers to the last tensor, ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], "=", 
   RowBox[{"-", "2"}]}]], "InlineFormula",ExpressionUUID->
  "9aa2929b-6df5-4fc3-a7c6-2dd271e884ea"],
 " the second-to-last, and so on. \[Bullet] \n",
 "The result has exactly one fewer tensor than the input network. \[Bullet] \n\
",
 "When the network was constructed with an explicit ",
 Cell[BoxData[
  StyleBox["Output", "TI"]], "InlineFormula",ExpressionUUID->
  "ce7a8069-83f1-4e0e-ba1a-533e648daf60"],
 " specification, the indices that appeared on the removed tensor are dropped \
from the ",
 Cell[BoxData[
  StyleBox["Output", "TI"]], "InlineFormula",ExpressionUUID->
  "f70db106-fe36-40b4-9c79-867247efe5d8"],
 " spec. Surviving network indices that were previously contracted with the \
removed tensor become free in the resulting network. \[Bullet] \n",
 "When the ",
 Cell[BoxData[
  StyleBox["Output", "TI"]], "InlineFormula",ExpressionUUID->
  "ff833e75-c952-495c-8868-5955a8521270"],
 " is ",
 Cell[BoxData[
 "Automatic"], "InlineFormula",ExpressionUUID->
  "e4a11985-8a19-451d-af9b-9328ade021a5"],
 ", the free-index set is recomputed from the remaining hyperedges. \[Bullet] \
\n",
 "In Graph form, the corresponding vertex is removed with ",
 Cell[BoxData[
  ButtonBox["VertexDelete",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/VertexDelete"]], "InlineFormula",ExpressionUUID->
  "37fae237-b466-42cb-8a17-5d56fd892ad4"],
 "; incident edges are removed automatically."
}], "Notes",
 CellID->523576958,ExpressionUUID->"a74f8704-c063-4fbe-b871-cb84a0d8b13b"]
}, Open  ]],

