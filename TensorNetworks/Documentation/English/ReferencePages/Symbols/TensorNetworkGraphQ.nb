Cell["Build a valid annotated tensor-network graph and test it:", \
"ExampleText",
 CellID->569026814,ExpressionUUID->"f0013537-7342-44c1-9761-53034a0d92fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "42", "]"}], ";", " ", 
   RowBox[{"g", " ", "=", " ", 
    RowBox[{"ToTensorNetworkGraph", "[", 
     RowBox[{"RandomTensorNetwork", "[", 
      RowBox[{"\"\<MPS\>\"", "[", 
       RowBox[{"4", ",", " ", "2", ",", " ", "2"}], "]"}], "]"}], "]"}]}], 
   ";"}], " "}]], "Input",
 CellLabel->"In[1]:=",
 CellID->9363782,ExpressionUUID->"0d449841-804e-4fb7-9edb-df611ad511e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorNetworkGraphQ", "[", "g", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->916877872,ExpressionUUID->"4d0ac371-e3ad-4ac9-ac78-3bf5044ba787"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]=",
 CellID->634672516,ExpressionUUID->"77667b33-843d-43f7-9472-28e7475500c9"]
}, Open  ]],

Cell["\<\
A plain Graph carries no \"Tensor\" or \"Index\" annotations, so the \
predicate returns False:\
\>", "ExampleText",
 CellID->660138774,ExpressionUUID->"caae25e6-9e49-4c99-9730-b2c3f07118d7"],

Cell[CellGroupData[{

Cell[BoxData[
