Notebook[{

Cell[CellGroupData[{
Cell["TensorNetworkGraphQ", "ObjectName",
 CellID->10837472,ExpressionUUID->"39a78bbb-f8a3-4723-81af-57863b5adc7a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1874dd80-e635-4309-8dd0-f8525a97de7b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkGraphQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphQ"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a57d9c67-d2be-45cb-aa91-0fe24f435009"],
 "\[LineSeparator]yields ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "a3460cec-9e49-4835-bcdc-284f6d5ca202"],
 " if ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "ee48ffd1-d9ff-404a-ac26-5dea9486437d"],
 " is a valid annotated tensor-network graph, and ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "df0c594f-5f0a-4e9a-81b1-51ca3deb8155"],
 " otherwise.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e36da4bb-5d68-40a2-91ef-2eefed0bca14"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkGraphQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphQ"], "[", 
   StyleBox["graph", "TI"], ",", Cell[BoxData[
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
    "f8073905-6e51-4581-b35d-5f81569553de"], "]"}]], "InlineFormula",
  ExpressionUUID->"86c013fb-564a-4d79-8865-b40c6c1c5c9d"],
 "\[LineSeparator]prints diagnostic messages when ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "d949c2b7-cec3-41b5-b1bf-3777e9c1e4f6"],
 " fails validation.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fd66a197-a6b0-48eb-bd96-fd977d01bdf8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkGraphQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphQ"], "[",
    Cell[BoxData[
    ButtonBox["True",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
    "d9902fa8-e6c1-42cc-9c67-692d14d80851"], "]"}]], "InlineFormula",
  ExpressionUUID->"f192b071-d290-44a8-a7b5-b689fb798cd2"],
 "\[LineSeparator]is the curried form: it returns a predicate that, applied \
to a graph, runs the verbose check."
}], "Usage",
 CellID->39237040,ExpressionUUID->"d0ebea4d-ded0-4f92-9248-683880030796"],

Cell[TextData[{
 "A valid tensor-network graph is a ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "e50c03b5-01af-41d1-8dca-fefd8d225493"],
 " in which every vertex carries two annotations: a ",
 Cell[BoxData["\"\<Tensor\>\""], "InlineFormula",ExpressionUUID->
  "8bb157db-81ac-47bc-afc4-66537add14da"],
 " (the underlying array) and an ",
 Cell[BoxData["\"\<Index\>\""], "InlineFormula",ExpressionUUID->
  "8a7c2b31-5bde-4313-9661-987bdcd72826"],
 " (a duplicate-free list of ",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->
  "2089fda5-b411-4f73-80e8-7454d52429fa"],
 " or ",
 Cell[BoxData[
  ButtonBox["Subscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Subscript"]], "InlineFormula",ExpressionUUID->
  "e342ffff-ba47-45a3-bb71-c89be5b24206"],
 " labels)."
}], "Notes",
 CellID->549479864,ExpressionUUID->"bcec1485-cc3c-4242-88de-fe47c28c471b"],

Cell[TextData[{
 "Two consistency rules must hold across the vertex annotations: each \
tensor's rank equals the length of its ",
 Cell[BoxData["\"\<Index\>\""], "InlineFormula",ExpressionUUID->
  "1cdb27a6-430a-42dc-9d14-199bffe34808"],
 " list, and the sum of all tensor ranks equals the count of distinct indices \
across all vertices."
}], "Notes",
 CellID->467505362,ExpressionUUID->"d20a15ea-7a2d-4a0e-bd0b-2ea43a8e3ca1"],

Cell[TextData[{
 "Edges in the graph may carry ",
 Cell[BoxData[
  RowBox[{"{", 
   SubscriptBox[
    StyleBox["src", "TI"], 
    StyleBox["i", "TI"]], ",", 
   SubscriptBox[
    StyleBox["tgt", "TI"], 
    StyleBox["j", "TI"]], "}"}]], "InlineFormula",ExpressionUUID->
  "a3d9545f-5e44-4f3d-923d-881a1dcc8ae2"],
 " tags identifying which output and input slots are contracted along that \
edge; ",
 Cell[BoxData[
  ButtonBox["TensorNetworkGraphQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphQ"]], 
  "InlineFormula",ExpressionUUID->"c04306d7-0f72-4eb5-9de4-ee0a7a922e21"],
 " focuses on the vertex annotations and does not separately validate edge \
tags."
}], "Notes",
 CellID->763104260,ExpressionUUID->"6a41eac3-da93-4af2-b703-b75b31cb1651"],

Cell[TextData[{
 "When the second argument is ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "f6454e38-d1cb-445e-9b53-30439c7380b5"],
 ", a failing check prints one of four diagnostic message tags: ",
 Cell[BoxData[
  StyleBox["msg1", "TI"]], "InlineFormula",ExpressionUUID->
  "32a5059f-2208-4109-85e3-b726a2305866"],
 " (vertices not annotated with tensors), ",
 Cell[BoxData[
  StyleBox["msg2", "TI"]], "InlineFormula",ExpressionUUID->
  "2baf115a-4a50-4dd0-962c-2fa8ca961594"],
 " (indices not a duplicate-free list of ",
 Cell[BoxData[
  ButtonBox["Subscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Subscript"]], "InlineFormula",ExpressionUUID->
  "d854add3-7cf1-4b3f-9911-3f058afbf516"],
 "/",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->
  "1b3a9603-0f40-493e-ae2b-1a78ceb6a057"],
 " heads), ",
 Cell[BoxData[
  StyleBox["msg3", "TI"]], "InlineFormula",ExpressionUUID->
  "af5e6308-1409-425b-9b41-f8b17daac984"],
 " (tensor ranks and indices incompatible), and ",
 Cell[BoxData[
  StyleBox["msg4", "TI"]], "InlineFormula",ExpressionUUID->
  "b6f30546-9a73-4cfa-80af-135d1be3a366"],
 " (edges not tagged with indices). Both vertex-annotation checks are \
exercised in current builds; ",
 Cell[BoxData[
  StyleBox["msg1", "TI"]], "InlineFormula",ExpressionUUID->
  "571765fc-ce3b-4c9d-a969-909cc218c9e0"],
 " and ",
 Cell[BoxData[
  StyleBox["msg4", "TI"]], "InlineFormula",ExpressionUUID->
  "2f74ed4f-124d-40d7-b51b-0ef872a60d31"],
 " are reserved for stricter checks added in future revisions."
}], "Notes",
 CellID->681341819,ExpressionUUID->"7e6f67f5-8029-4111-93ec-1ef193827992"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetworkGraphQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphQ"]], 
  "InlineFormula",ExpressionUUID->"8a427309-a1db-4822-b59d-38348107bbb6"],
 " is the graph-form sibling of ",
 Cell[BoxData[
  ButtonBox["TensorNetworkQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkQ"]], 
  "InlineFormula",ExpressionUUID->"c87f9aed-151f-45bd-9d3c-6d859d7d91fb"],
 ": the latter tests ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"4043d0d7-bf97-4d19-aa4c-0e20b7582744"],
 "[\[Ellipsis]] expressions, while ",
 Cell[BoxData[
  ButtonBox["TensorNetworkGraphQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphQ"]], 
  "InlineFormula",ExpressionUUID->"385b9e9e-21a9-46bb-b764-0d59455bf9cf"],
 " tests the annotated ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "1d889de9-09a7-4548-b670-411901f68ba7"],
 " produced by ",
 Cell[BoxData[
  ButtonBox["ToTensorNetworkGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]], 
  "InlineFormula",ExpressionUUID->"58209251-63e2-48fa-ac5a-c128ae66485c"],
 "."
}], "Notes",
 CellID->728410217,ExpressionUUID->"eeef1e8e-b5ac-47c4-b086-3a95038dbd72"],

Cell[TextData[{
 "Downstream functions including ",
 Cell[BoxData[
  ButtonBox["TensorNetworkGraphData",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphData"]], 
  "InlineFormula",ExpressionUUID->"622863a4-4520-47e4-890c-c0ccb927b53d"],
 ", ",
 Cell[BoxData[
  ButtonBox["TensorNetworkIndices",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndices"]], 
  "InlineFormula",ExpressionUUID->"13a50f96-55f4-4769-9c2c-671a2601303b"],
 ", ",
 Cell[BoxData[
  ButtonBox["TensorNetworkTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkTensors"]], 
  "InlineFormula",ExpressionUUID->"8c2dfc00-cff0-4840-b895-4762279748e5"],
 ", and ",
 Cell[BoxData[
  ButtonBox["TensorNetworkIndexGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkIndexGraph"]], 
  "InlineFormula",ExpressionUUID->"18989d87-ca20-45ec-ac37-15f829c06e88"],
 " are guarded by ",
 Cell[BoxData[
  ButtonBox["TensorNetworkGraphQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphQ"]], 
  "InlineFormula",ExpressionUUID->"77b36946-1119-4534-b11a-883606139530"],
 ", so they remain unevaluated on an invalid graph rather than producing a \
wrong answer."
}], "Notes",
 CellID->466949057,ExpressionUUID->"e3927e85-d18e-4d13-87d9-674a0be37d1a"]
}, Open  ]],

