Cell["\<\
TensorNetworkGraphQ tests the Graph form; TensorNetworkQ tests the \
TensorNetwork[\[Ellipsis]] form. The two predicates partition the inputs \
accepted by the paclet, mirroring the GraphQ split:\
\>", "ExampleText",
 CellID->292478144,ExpressionUUID->"c083bb29-76f3-42d1-9635-7942b49d2540"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "k"}], "}"}]}], "}"}], "]"}]}], ";", " ", 
  RowBox[{"g", " ", "=", " ", 
   RowBox[{"ToTensorNetworkGraph", "[", "tn", "]"}]}], ";", " ", 
  RowBox[{"{", 
   RowBox[{
