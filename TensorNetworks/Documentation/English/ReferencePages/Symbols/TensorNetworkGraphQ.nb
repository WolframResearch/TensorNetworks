Cell["Valid annotated graphs", "ExampleSubsection",
 CellID->345607620,ExpressionUUID->"b84511a8-ab40-498d-8ff5-ca3d679b7535"],

Cell["\<\
Every graph produced by ToTensorNetworkGraph satisfies TensorNetworkGraphQ by \
construction:\
\>", "ExampleText",
