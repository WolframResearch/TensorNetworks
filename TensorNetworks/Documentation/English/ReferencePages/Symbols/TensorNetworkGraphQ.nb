Cell["\<\
Use TensorNetworkGraphQ as a gate so downstream code only processes valid \
graphs:\
\>", "ExampleText",
 CellID->741256548,ExpressionUUID->"ed844f87-eb40-48de-bfae-1a06c6c23d5f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"safeTensors", "[", "g_", "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TensorNetworkGraphQ", "[", "g", "]"}], ",", " ", 
     RowBox[{"Length", "[", 
      RowBox[{"TensorNetworkTensors", "[", "g", "]"}], "]"}], ",", " ", 
     "$Failed"}], "]"}]}], ";", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"safeTensors", "[", 
     RowBox[{"ToTensorNetworkGraph", "[", 
      RowBox[{"RandomTensorNetwork", "[", 
       RowBox[{"\"\<MPS\>\"", "[", 
        RowBox[{"4", ",", " ", "2", ",", " ", "2"}], "]"}], "]"}], "]"}], 
     "]"}], ",", " ", 
    RowBox[{"safeTensors", "[", 
     RowBox[{"Graph", "[", 
      RowBox[{"{", 
       RowBox[{"1", " ", "->", " ", "2"}], "}"}], "]"}], "]"}]}], 
   "}"}]}]], "Input",
 CellLabel->"In[13]:=",
 CellID->989520905,ExpressionUUID->"6249f4c5-ea9c-49fa-b6c7-c6133947f443"],

