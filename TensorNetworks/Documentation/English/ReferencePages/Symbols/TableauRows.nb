Cell[CellGroupData[{
Cell["TableauRows", "ObjectName",
 CellID->332218033,ExpressionUUID->"d5fa10e9-29d3-454e-9b5e-a30bd1407cc4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fc4cac54-c0e0-420f-945f-bbcb8e2aee0b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauRows",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauRows"], "[", 
   StyleBox["tableau", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "6bff1d0e-9449-47ff-98f3-a80140a28528"],
 "\[LineSeparator]returns the inner row list of a Young tableau as a list of \
lists of slot indices."
}], "Usage",
 CellID->676974430,ExpressionUUID->"c28a4a4e-1d3f-4c63-9690-b5ef3953161b"],

Cell[TextData[{
 "This symbol lives in the subpackage context ",
 Cell[BoxData["\"\<Wolfram`TensorNetworks`Symmetry`\>\""], "InlineFormula",
  ExpressionUUID->"8b88f808-bfcc-4198-9a57-ed9224002050"],
 ". Load it explicitly with ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Needs",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Needs"], 
   "[", "\"\<Wolfram`TensorNetworks`Symmetry`\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"e83fa106-69c7-4360-9cbc-fd96d727ecf1"],
 "; loading only the main context does not auto-load this subpackage."
}], "Notes",
 CellID->588238102,ExpressionUUID->"96e976fd-18d9-43be-9fc4-7ee0128469f3"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"543cd770-d08a-4eee-9c55-2f2c6376b57f"],
 " object is atomic (",
 Cell[BoxData[
 "AtomQ"], "InlineFormula",ExpressionUUID->
  "83abb107-1904-4d06-967f-6b2c901f7cb1"],
 " is ",
 Cell[BoxData[
 "True"], "InlineFormula",ExpressionUUID->
  "445d1c33-f7a9-443d-9126-65edaefb85d3"],
 "), so ",
 Cell[BoxData[
  ButtonBox["First",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/First"]], "InlineFormula",ExpressionUUID->
  "5bf82e92-fdec-470a-9923-3432d46315c7"],
 " and ",
 Cell[BoxData[
  ButtonBox["Part",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Part"]], "InlineFormula",ExpressionUUID->
  "988dd271-974c-4222-9794-34774e81d382"],
 " do not unpack it. ",
 Cell[BoxData[
 "TableauRows"], "InlineFormula",ExpressionUUID->
  "ab7a0ac9-ccc4-4c13-9fc3-b1a52c280af5"],
 " is the supported accessor for the row data."
}], "Notes",
 CellID->259372522,ExpressionUUID->"a920020c-9898-4dec-9450-684e3df4f9c6"],

Cell[TextData[{
 "The result satisfies ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Length",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Length"], "/@", " ", "TableauRows", "[", 
   StyleBox["yt", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3a0cb936-3d60-4bf1-94dc-ffcc4f806053"],
 " equals ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauShape",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"], "[", 
   StyleBox["yt", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "8f7b1933-9ae6-425f-9df0-d002c3919967"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Flatten",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Flatten"], "[", 
   RowBox[{"TableauRows", "[", 
    StyleBox["yt", "TI"], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "47a8ee76-5668-429c-91c8-51f428ad5a96"],
 " is a permutation of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Range",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Range"], "[", 
   RowBox[{
    ButtonBox["TableauSize",
     BaseStyle->"Link",
     ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauSize"], "[", 
    StyleBox["yt", "TI"], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "ebce7273-a111-4a8f-9522-25ae2e18ee44"],
 "."
}], "Notes",
 CellID->232160514,ExpressionUUID->"846724bf-933e-42bf-91a5-fd5d88a4bbf6"],

Cell[TextData[{
 "Issues ",
 Cell[BoxData[
  RowBox[{"TableauRows", "::", "noyt"}]], "InlineFormula",ExpressionUUID->
  "90d3947b-756d-4fbc-916c-fccc18ce6608"],
 " and returns ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "365a7c03-1849-4d83-90c6-e388db793c5e"],
 " when called on anything other than a valid ",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"d42384b5-b017-41bc-9605-e77dfccda376"],
 "."
}], "Notes",
 CellID->258926829,ExpressionUUID->"3b963ad2-ceb1-4fd6-99f4-118dc6bba63b"]
}, Open  ]],

