Cell["Scan per-tensor Frobenius norms during a contraction-tree audit:", "ExampleText",
 CellID->640003001,ExpressionUUID->"11fd7822-aaaa-bbbb-cccc-dddd00000001"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";", "\[IndentingNewLine]",
  RowBox[{"tn", "=",
   RowBox[{"RandomTensorNetwork", "[",
    RowBox[{"\"\<MPS\>\"", "[",
     RowBox[{"5", ",", "2", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{
   RowBox[{
    RowBox[{"Norm", "[",
     RowBox[{"Flatten", "[", "#", "]"}], "]"}], "&"}], "/@",
   RowBox[{"TensorNetworkTensors", "[", "tn", "]"}]}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->640003002,ExpressionUUID->"11fd7822-aaaa-bbbb-cccc-dddd00000002"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{"0.4142158401140085`", ",", "1.4005547912586063`", ",",
   "1.806600034946447`", ",", "1.5798340200498489`", ",",
   "1.3820351300878695`"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->640003003,ExpressionUUID->"11fd7822-aaaa-bbbb-cccc-dddd00000003"]
}, Open]],

Cell[BoxData[""], "ExampleDelimiter",
 CellID->640003010,ExpressionUUID->"11fd7822-aaaa-bbbb-cccc-dddd00000010"],

Cell["Modify individual tensors and rebuild the network with the new list, the existing hyperedges, and the existing output:", "ExampleText",
 CellID->640003020,ExpressionUUID->"11fd7822-aaaa-bbbb-cccc-dddd00000020"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "8", "]"}], ";", "\[IndentingNewLine]",
  RowBox[{"tn", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"ts", "=",
   RowBox[{"TensorNetworkTensors", "[", "tn", "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"tn2", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"MapAt", "[",
      RowBox[{"Minus", ",", "ts", ",",
       RowBox[{"{", "1", "}"}]}], "]"}], ",",
     RowBox[{"tn", "[", "\"\<Hyperedges\>\"", "]"}], ",",
     RowBox[{"tn", "[", "\"\<Output\>\"", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"{",
   RowBox[{
    RowBox[{
     RowBox[{"tn", "[", "\"\<Tensors\>\"", "]"}], "[",
     RowBox[{"[",
      RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}], ",",
    RowBox[{
     RowBox[{"tn2", "[", "\"\<Tensors\>\"", "]"}], "[",
     RowBox[{"[",
      RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->640003021,ExpressionUUID->"11fd7822-aaaa-bbbb-cccc-dddd00000021"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{
   RowBox[{"-", "0.9820298896972313`"}], ",", "0.9820298896972313`"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->640003022,ExpressionUUID->"11fd7822-aaaa-bbbb-cccc-dddd00000022"]
}, Open]]
}, Open]],

