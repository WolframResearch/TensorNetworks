Cell["When the graph form is built from a graph whose vertices were not in topological order, the returned list is in the topological-sort order of the directed graph rather than the order of the original TensorNetwork expression:", "ExampleText",
 CellID->640005020,ExpressionUUID->"3f4449bd-aaaa-bbbb-cccc-dddd00000020"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "=",
   RowBox[{"Graph", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"DirectedEdge", "[",
        RowBox[{"3", ",", "1"}], "]"}], ",",
       RowBox[{"DirectedEdge", "[",
        RowBox[{"1", ",", "2"}], "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"VertexList", "[",
   RowBox[{"ToTensorNetworkGraph", "[", "g", "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->640005021,ExpressionUUID->"3f4449bd-aaaa-bbbb-cccc-dddd00000021"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{"3", ",", "1", ",", "2"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->640005022,ExpressionUUID->"3f4449bd-aaaa-bbbb-cccc-dddd00000022"]
}, Open]],

