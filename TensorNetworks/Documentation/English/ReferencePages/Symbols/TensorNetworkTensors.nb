Cell[CellGroupData[{
Cell["TensorNetworkTensors", "ObjectName",
 CellID->298741655,ExpressionUUID->"84bfd063-7153-4063-8038-5396b8814282"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d1f48d10-6421-4060-8078-40bec5fbd7a0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkTensors",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkTensors"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "fd519901-e184-4b0e-a511-4d871dbce789"],
 "\[LineSeparator]returns the list of tensors stored in ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "a1d4e0a0-1111-4111-8111-411111111111"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d1f48d10-6421-4060-8078-40bec5fbd7a1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkTensors",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkTensors"], "[", 
   StyleBox["net", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "fd519901-e184-4b0e-a511-4d871dbce790"],
 "\[LineSeparator]gives the list of tensors stored as ",
 Cell[BoxData["\"\<Tensor\>\""], "InlineFormula",ExpressionUUID->
  "a1d4e0a0-1111-4111-8111-411111111112"],
 " annotations on the vertices of the tensor-network graph ",
 Cell[BoxData[
  StyleBox["net", "TI"]], "InlineFormula",ExpressionUUID->
  "a1d4e0a0-1111-4111-8111-411111111113"],
 "."
}], "Usage",
 CellID->134228899,ExpressionUUID->"733028ac-65c4-47fb-ae1a-587424d08145"],

Cell[TextData[{
 "For the ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"b1d4e0a0-2222-4222-8222-422222222221"],
 " form, ",
 Cell[BoxData[
  ButtonBox["TensorNetworkTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkTensors"]], 
  "InlineFormula",ExpressionUUID->"b1d4e0a0-2222-4222-8222-422222222222"],
 " returns the raw tensor list as stored, with no canonicalization and no ",
 Cell[BoxData[
  ButtonBox["Inactive",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Inactive"]], "InlineFormula",ExpressionUUID->
  "b1d4e0a0-2222-4222-8222-422222222223"],
 " wrapping. The list aligns with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Hyperedges\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"b1d4e0a0-2222-4222-8222-422222222224"],
 " and is indexed by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Range",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Range"], "[", 
   RowBox[{
    ButtonBox["TensorNetworkSize",
     BaseStyle->"Link",
     ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkSize"], "[", 
    
    StyleBox["tn", "TI"], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "b1d4e0a0-2222-4222-8222-422222222225"],
 "."
}], "Notes",
 CellID->2112323698,ExpressionUUID->"36678288-c6cd-4440-8ee0-659d8da9d1ab"],

Cell[TextData[{
 "For the graph form, the tensors are returned in the order of ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["VertexList",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/VertexList"], "[", 
   StyleBox["net", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c1d4e0a0-3333-4333-8333-433333333331"],
 ", which for graphs produced by ",
 Cell[BoxData[
  ButtonBox["ToTensorNetworkGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]], 
  "InlineFormula",ExpressionUUID->"c1d4e0a0-3333-4333-8333-433333333332"],
 " is the topological-sort order of the underlying directed graph. This may \
differ from the order in the originating ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"c1d4e0a0-3333-4333-8333-433333333333"],
 " expression when the input graph's vertices were not already topologically \
sorted."
}], "Notes",
 CellID->2112323699,ExpressionUUID->"36678288-c6cd-4440-8ee0-659d8da9d1ac"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetworkTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkTensors"]], 
  "InlineFormula",ExpressionUUID->"d1d4e0a0-4444-4444-8444-444444444441"],
 " is the property-form dual ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Tensors\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"d1d4e0a0-4444-4444-8444-444444444442"],
 ": the function and property forms return the same list."
}], "Notes",
 CellID->2112323700,ExpressionUUID->"36678288-c6cd-4440-8ee0-659d8da9d1ad"],

Cell[TextData[{
 "Individual tensors can be raw numerical arrays, ",
 Cell[BoxData[
  ButtonBox["SparseArray",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/SparseArray"]], "InlineFormula",ExpressionUUID->
  "e1d4e0a0-5555-4555-8555-455555555551"],
 " objects, or symbolic ",
 Cell[BoxData[
  ButtonBox["ArraySymbol",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ArraySymbol"]], "InlineFormula",ExpressionUUID->
  "e1d4e0a0-5555-4555-8555-455555555552"],
 ", ",
 Cell[BoxData[
  ButtonBox["MatrixSymbol",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/MatrixSymbol"]], "InlineFormula",ExpressionUUID->
  "e1d4e0a0-5555-4555-8555-455555555553"],
 ", or ",
 Cell[BoxData[
  ButtonBox["VectorSymbol",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/VectorSymbol"]], "InlineFormula",ExpressionUUID->
  "e1d4e0a0-5555-4555-8555-455555555554"],
 " entries; ",
 Cell[BoxData[
  ButtonBox["SparseTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/SparseTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"e1d4e0a0-5555-4555-8555-455555555555"],
 " converts all of them to ",
 Cell[BoxData[
  ButtonBox["SparseArray",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/SparseArray"]], "InlineFormula",ExpressionUUID->
  "e1d4e0a0-5555-4555-8555-455555555556"],
 "."
}], "Notes",
 CellID->2112323701,ExpressionUUID->"36678288-c6cd-4440-8ee0-659d8da9d1ae"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetworkTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkTensors"]], 
  "InlineFormula",ExpressionUUID->"f1d4e0a0-6666-4666-8666-466666666661"],
 " is guarded by ",
 Cell[BoxData[
  ButtonBox["TensorNetworkQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkQ"]], 
  "InlineFormula",ExpressionUUID->"f1d4e0a0-6666-4666-8666-466666666662"],
 ": an invalid ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"f1d4e0a0-6666-4666-8666-466666666663"],
 "[\[Ellipsis]] expression leaves the call unevaluated."
}], "Notes",
 CellID->2112323702,ExpressionUUID->"36678288-c6cd-4440-8ee0-659d8da9d1af"]
}, Open  ]],

