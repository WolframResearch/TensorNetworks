 CellID->640001020,ExpressionUUID->"911cc3e2-a853-40a6-bac5-620bd69ff604"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";", "\[IndentingNewLine]",
  RowBox[{"Map", "[",
   RowBox[{"Dimensions", ",",
