Cell["Get the list of tensors in a tensor network:", "ExampleText",
 CellID->640001001,ExpressionUUID->"911cc3e2-a853-40a6-bac5-620bd69ff69c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->640001002,ExpressionUUID->"1b9b8502-e58b-48e4-8af6-2bc20b06a98c"],

Cell[BoxData[
 RowBox[{"TensorNetworkTensors", "[", "tn", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->640001003,ExpressionUUID->"004af4fe-6881-4c72-acd5-f5aeaed90fb1"],

Cell["\<\
A hypergraph-only network is auto-filled with symbolic ArraySymbol tensors:\
