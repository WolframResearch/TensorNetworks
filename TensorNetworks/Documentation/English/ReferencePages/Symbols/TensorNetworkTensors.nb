}, Open]],

Cell[BoxData[""], "ExampleDelimiter",
 CellID->640002013,ExpressionUUID->"c69c356c-aaaa-bbbb-cccc-dddd00000013"],

Cell["The sparse form replaces every nonzero-rank tensor with a SparseArray:", "ExampleText",
 CellID->640002020,ExpressionUUID->"c69c356c-aaaa-bbbb-cccc-dddd00000020"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "11", "]"}], ";", "\[IndentingNewLine]",
  RowBox[{"tn", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"Map", "[",
   RowBox[{"Head", ",",
    RowBox[{"TensorNetworkTensors", "[",
     RowBox[{"SparseTensorNetwork", "[", "tn", "]"}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->640002021,ExpressionUUID->"c69c356c-aaaa-bbbb-cccc-dddd00000021"],

Cell[BoxData[
 RowBox[{"{",
  RowBox[{"SparseArray", ",", "SparseArray"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->640002022,ExpressionUUID->"c69c356c-aaaa-bbbb-cccc-dddd00000022"]
}, Open]],

