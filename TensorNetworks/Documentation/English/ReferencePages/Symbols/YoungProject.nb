Cell["Project a rank-2 tensor onto the totally symmetric class:", \
"ExampleText",
 CellID->469889671,ExpressionUUID->"f78ec379-8259-4603-97f3-a535116e41fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungProject", "[", 
  RowBox[{
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[FormalCapitalT]", "##"], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", "2", "}"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.988984506211727*^9, 3.988984522338399*^9}},
 CellLabel->"In[1]:=",
 CellID->631627224,ExpressionUUID->"aab37848-7e44-4d66-86c0-88c998a62edc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[FormalCapitalT]", 
      RowBox[{"1", ",", "1"}]], ",", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[FormalCapitalT]", 
         RowBox[{"1", ",", "2"}]], "+", 
        SubscriptBox["\[FormalCapitalT]", 
         RowBox[{"2", ",", "1"}]]}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[FormalCapitalT]", 
         RowBox[{"1", ",", "2"}]], "+", 
        SubscriptBox["\[FormalCapitalT]", 
         RowBox[{"2", ",", "1"}]]}], ")"}]}], ",", 
     SubscriptBox["\[FormalCapitalT]", 
      RowBox[{"2", ",", "2"}]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9889845231829853`*^9},
 CellLabel->"Out[1]=",
 CellID->2094525656,ExpressionUUID->"a997ec1d-6c8e-457e-b767-55481f48ab6b"]
}, Open  ]],

Cell["Project the same tensor onto the antisymmetric class:", "ExampleText",
 CellID->337089098,ExpressionUUID->"ff54a48e-4d23-4ecb-8dc0-4d4559fb5c45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungProject", "[", 
  RowBox[{
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[FormalCapitalT]", "##"], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{3.988984530833123*^9},
 CellLabel->"In[2]:=",
 CellID->985590089,ExpressionUUID->"f4c7c7ec-fcf2-4c6c-8db2-924a78bdf922"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
