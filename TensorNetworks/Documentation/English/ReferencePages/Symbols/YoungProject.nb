  RowBox[{
   StyleBox["t", "TI"], "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "3", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   StyleBox["once", "TI"], "=", 
   RowBox[{"YoungProject", "[", 
    RowBox[{
     StyleBox["t", "TI"], ",", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   StyleBox["twice", "TI"], "=", 
   RowBox[{"YoungProject", "[", 
    RowBox[{
     StyleBox["once", "TI"], ",", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{
