Cell["\<\
For a rank-2 tensor, projection onto YoungTableau[{2}] equals the symmetric \
part (t + Transpose[t])/2:\
\>", "ExampleText",
 CellID->478937689,ExpressionUUID->"298c4f5f-d970-4a93-9469-2b60935d20a9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   StyleBox["t", "TI"], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"YoungProject", "[", 
   RowBox[{
    StyleBox["t", "TI"], ",", 
    RowBox[{"YoungTableau", "[", 
     RowBox[{"{", "2", "}"}], "]"}]}], "]"}], "==", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     StyleBox["t", "TI"], "+", 
     RowBox[{"Transpose", "[", 
      StyleBox["t", "TI"], "]"}]}], ")"}], "/", "2"}]}]}], "Input",
 CellLabel->"In[13]:=",
 CellID->581773701,ExpressionUUID->"05d21e74-af83-4bdd-949a-4ec812b1e870"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[13]=",
 CellID->218663887,ExpressionUUID->"12c45e8e-35f0-4749-9bb7-7aa7b2e1aef9"]
}, Open  ]]
