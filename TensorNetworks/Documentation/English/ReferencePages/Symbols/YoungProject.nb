Cell["\<\
Decompose a rank-2 tensor into its symmetric and antisymmetric irreducible \
components:\
\>", "ExampleText",
 CellID->558789917,ExpressionUUID->"034cba16-a5d6-4669-b301-379f569a1353"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   StyleBox["t", "TI"], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "5", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"7", ",", "8", ",", "9"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<sym\>\"", "->", 
    RowBox[{"YoungProject", "[", 
     RowBox[{
      StyleBox["t", "TI"], ",", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", "2", "}"}], "]"}]}], "]"}]}], ",", 
   RowBox[{"\"\<antisym\>\"", "->", 
    RowBox[{"YoungProject", "[", 
     RowBox[{
      StyleBox["t", "TI"], ",", 
      RowBox[{"YoungTableau", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "]"}]}], "]"}]}]}], "}"}]}], "Input",
