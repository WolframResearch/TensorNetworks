Cell["\<\
YoungProject is YoungSymmetrize rescaled by TableauDimension/TableauSize!:\
\>", "ExampleText",
 CellID->685623545,ExpressionUUID->"4ffe3f9d-3039-4eee-b993-cccedfa21190"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   StyleBox["yt", "TI"], "=", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   StyleBox["t", "TI"], "=", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[FormalCapitalT]", "##"], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"YoungProject", "[", 
   RowBox[{"t", ",", "yt"}], "]"}], "==", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"TableauDimension", "[", "yt", "]"}], "/", 
     RowBox[{
      RowBox[{"TableauSize", "[", "yt", "]"}], "!"}]}], ")"}], "*", 
   RowBox[{"YoungSymmetrize", "[", 
    RowBox[{"t", ",", 
     StyleBox["yt", "TI"]}], "]"}]}]}]}], "Input",
