    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "3", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"AssociationMap", "[", 
  RowBox[{
   RowBox[{"Function", "[", 
    RowBox[{
     StyleBox["shape", "TI"], ",", 
