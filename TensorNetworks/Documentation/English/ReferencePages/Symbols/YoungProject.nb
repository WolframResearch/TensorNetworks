Notebook[{

Cell[CellGroupData[{
Cell["YoungProject", "ObjectName",
 CellID->131187114,ExpressionUUID->"fce0d5be-267c-4a3e-ad97-a21a18d75d3d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"51e4471d-8cd4-40c8-a973-29cf23de3a39"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["YoungProject",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"], "[", 
   RowBox[{
    StyleBox["tensor", "TI"], ",", 
    StyleBox["tableau", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "523f0b73-340f-442f-8a8a-4b0ed064bdde"],
 "\[LineSeparator]returns the normalized projection of ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "30ef249c-16b8-474d-b761-349580ffaca5"],
 " onto the symmetry class labelled by the Young ",
 Cell[BoxData[
  StyleBox["tableau", "TI"]], "InlineFormula",ExpressionUUID->
  "d27924a9-c719-4549-ba1b-3ee13ef894df"],
 "; the operator is idempotent."
}], "Usage",
 CellID->952787092,ExpressionUUID->"445cbaf7-fe0a-4dc4-aeb3-0b8fb90880f2"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["YoungProject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"]], 
  "InlineFormula",ExpressionUUID->"a26cae10-656b-4475-881c-c8b7774cb7bd"],
 "[",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "e4bd5a52-f80b-4488-8350-62059b726199"],
 ", ",
 Cell[BoxData[
  StyleBox["yt", "TI"]], "InlineFormula",ExpressionUUID->
  "859e2dda-f48b-424b-bff6-f1cd849e66a4"],
 "] = ",
 Cell[BoxData[
  FractionBox[
   StyleBox["d", "TI"], 
   RowBox[{
    StyleBox["n", "TI"], "!"}]]], "InlineFormula",ExpressionUUID->
  "551d4cb1-d54a-46bf-b5c8-c0baf90f1cad"],
 " ",
 Cell[BoxData[
  ButtonBox["YoungSymmetrize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"]], 
  "InlineFormula",ExpressionUUID->"77b75613-479a-4a3d-80b2-43cfafa776e4"],
 "[",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "e9ffbc8f-6101-486c-be17-401a77128763"],
 ", ",
 Cell[BoxData[
  StyleBox["yt", "TI"]], "InlineFormula",ExpressionUUID->
  "9c47c96d-be88-48a9-989b-906ec8a92006"],
 "], where ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "1aaad655-0ebe-4f40-a34c-bd021a91ff2e"],
 " is ",
 Cell[BoxData[
  ButtonBox["TableauSize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauSize"]], 
  "InlineFormula",ExpressionUUID->"9ef1e712-b45a-4616-91fe-9ab573f8ce62"],
 "[",
 Cell[BoxData[
  StyleBox["yt", "TI"]], "InlineFormula",ExpressionUUID->
  "78ddbc88-e766-4c18-b6e0-876b4ae4252b"],
 "] and ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "f3cd7fd5-8769-4b39-8ca7-7714209691b6"],
 " is ",
 Cell[BoxData[
  ButtonBox["TableauDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"]], 
  "InlineFormula",ExpressionUUID->"65f8e509-0907-42f9-8ef0-fdc66cb39658"],
 "[",
 Cell[BoxData[
  StyleBox["yt", "TI"]], "InlineFormula",ExpressionUUID->
  "fdfb009e-6190-4a43-ac15-eb1b1a1d9289"],
 "]. The normalization ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "/", 
   RowBox[{
    StyleBox["n", "TI"], "!"}]}]], "InlineFormula",ExpressionUUID->
  "f09d5c3a-e606-43e2-b6eb-5544a6c10cc6"],
 " makes the projector idempotent."
}], "Notes",
 CellID->495042975,ExpressionUUID->"bc92486a-02dd-476a-8f83-09df02dcb7b6"],

Cell[TextData[{
 "Idempotency: ",
 Cell[BoxData[
  ButtonBox["YoungProject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"]], 
  "InlineFormula",ExpressionUUID->"6245fc7b-e8c7-4e30-95dc-6d5a96aea4e2"],
 "[",
 Cell[BoxData[
  ButtonBox["YoungProject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"]], 
  "InlineFormula",ExpressionUUID->"ba18a673-8108-4bdd-809a-b1c9f021ea96"],
 "[",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "25628e28-ed1a-4533-8353-f378b6ea0772"],
 ", ",
 Cell[BoxData[
  StyleBox["yt", "TI"]], "InlineFormula",ExpressionUUID->
  "52613df9-6579-4323-af62-c0a052b02b8c"],
 "], ",
 Cell[BoxData[
  StyleBox["yt", "TI"]], "InlineFormula",ExpressionUUID->
  "f987f157-f0cf-40b9-b6bb-3cea61e9aac6"],
 "] is equal to ",
 Cell[BoxData[
  ButtonBox["YoungProject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"]], 
  "InlineFormula",ExpressionUUID->"be7e3966-b9de-40d7-8bf2-3da8b6b94aac"],
 "[",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "3f8e5d38-23ab-4f85-87cd-ee71a92158ab"],
 ", ",
 Cell[BoxData[
  StyleBox["yt", "TI"]], "InlineFormula",ExpressionUUID->
  "215b3266-6f5e-4ffe-8bbe-5738ced52679"],
 "]. This is the defining property of a projector and is the source of the ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "/", 
   RowBox[{
    StyleBox["n", "TI"], "!"}]}]], "InlineFormula",ExpressionUUID->
  "11d46584-8f3f-4347-946e-49f0a57522d7"],
 " factor."
}], "Notes",
 CellID->856099490,ExpressionUUID->"b1f08e82-bf8e-4bd6-b172-0bd9d89f44c0"],

Cell[TextData[{
 "For a rank-2 ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "6b51f624-dcf2-45b0-973b-66aa3d419a93"],
 ", projecting onto ",
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", "2", "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "acfb1aa5-3fd2-4994-9498-33a2f9234947"],
 " yields the symmetric part ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    StyleBox["t", "TI"], "+", 
    $CellContext`TransposeBox[
     StyleBox["t", "TI"]]}], ")", "/", "2"}]], "InlineFormula",ExpressionUUID->
  "50ecf29b-fc80-4217-a0f3-ff02fa8b46dc"],
 ", and projecting onto ",
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "d31c370d-06f3-49b4-ba12-ff5d661a98db"],
 " yields the antisymmetric part ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    StyleBox["t", "TI"], "-", 
    $CellContext`TransposeBox[
     StyleBox["t", "TI"]]}], ")", "/", "2"}]], "InlineFormula",ExpressionUUID->
  "9820bbeb-5df7-40be-b163-4bbb2ff8cacb"],
 "."
}], "Notes",
 CellID->514389114,ExpressionUUID->"ec28e3dd-effc-4ba9-a6e8-26108aa58b77"],

Cell[TextData[{
 "Summing the Young projectors over all standard tableaux of every shape of \
size ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "c0326cc1-f4c5-4bdc-bfdf-cc9a1d9a65bb"],
 " recovers the identity on rank-",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "65eddd09-db1f-483b-9b04-04236d2d5ed6"],
 " tensors. For rank 2 this reduces to ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"YoungProject", "[", 
    RowBox[{
     StyleBox["t", "TI"], ",", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", "2", "}"}], "]"}]}], "]"}], "+", 
   RowBox[{"YoungProject", "[", 
    RowBox[{
     StyleBox["t", "TI"], ",", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "]"}]}], "]"}], "=", 
   StyleBox["t", "TI"]}]], "InlineFormula",ExpressionUUID->
  "4836e23c-0c22-4026-841e-3aa22f14728b"],
 ", reflecting the Schur-Weyl decomposition of the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["S", "TI"], 
   StyleBox["n", "TI"]]], "InlineFormula",ExpressionUUID->
  "118afd54-78f5-4489-bd17-bcf0551526d3"],
 " action."
}], "Notes",
 CellID->477979075,ExpressionUUID->"ab7e3b46-eb7e-447f-9cc3-e29e0dc90ad0"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "ee079a2e-2aa2-4a47-b962-b0bac2fa003c"],
 " rank must equal ",
 Cell[BoxData[
  ButtonBox["TableauSize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauSize"]], 
  "InlineFormula",ExpressionUUID->"0b8cdd0b-22de-4a19-90d3-1f5d7855c822"],
 "[",
 Cell[BoxData[
  StyleBox["tableau", "TI"]], "InlineFormula",ExpressionUUID->
  "08d7a790-60c9-4dd3-8f7c-f52a742e58ce"],
 "]; mismatched ranks return ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "d000ff63-ccdf-42c0-a94e-67a143184730"],
 " (via ",
 Cell[BoxData[
  ButtonBox["YoungSymmetrize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"]], 
  "InlineFormula",ExpressionUUID->"77241dec-6120-405a-b3e7-f04716785b9c"],
 "). Inputs that are not a valid ",
 Cell[BoxData[
  ButtonBox["YoungTableau",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableau"]], 
  "InlineFormula",ExpressionUUID->"1d3cb10d-ca46-4d9e-9f84-9ca913ce4a30"],
 " leave ",
 Cell[BoxData[
  ButtonBox["YoungProject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"]], 
  "InlineFormula",ExpressionUUID->"b60e2bad-1208-4bce-9998-531abefa2be0"],
 " unevaluated."
}], "Notes",
 CellID->620900360,ExpressionUUID->"4379a1c1-b96b-40dc-bddf-9ddce1c7c0ad"]
}, Open  ]],

