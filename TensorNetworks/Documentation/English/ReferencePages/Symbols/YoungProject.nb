Cell["\<\
For a rank-2 tensor, projection onto YoungTableau[{2}] equals the symmetric \
part (t + Transpose[t])/2:\
\>", "ExampleText",
 CellID->478937689,ExpressionUUID->"298c4f5f-d970-4a93-9469-2b60935d20a9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   StyleBox["t", "TI"], "=", 
   RowBox[{"Array", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[FormalCapitalT]", "##"], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"YoungProject", "[", 
   RowBox[{
    StyleBox["t", "TI"], ",", 
    RowBox[{"YoungTableau", "[", 
     RowBox[{"{", "2", "}"}], "]"}]}], "]"}], "==", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     StyleBox["t", "TI"], "+", 
     RowBox[{"Transpose", "[", 
      StyleBox["t", "TI"], "]"}]}], ")"}], "/", "2"}]}]}], "Input",
 CellChangeTimes->{{3.988984777863594*^9, 3.988984793358624*^9}},
