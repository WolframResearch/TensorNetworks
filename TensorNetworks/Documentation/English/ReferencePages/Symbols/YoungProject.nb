Cell["Project a rank-2 tensor onto the totally symmetric class:", \
"ExampleText",
 CellID->469889671,ExpressionUUID->"f78ec379-8259-4603-97f3-a535116e41fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungProject", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", "2", "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->631627224,ExpressionUUID->"aab37848-7e44-4d66-86c0-88c998a62edc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", 
     FractionBox["5", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["5", "2"], ",", "4"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->479975586,ExpressionUUID->"c4bb4fe4-0218-4f75-9049-6b2ac8f0a26a"]
}, Open  ]],

Cell["Project the same tensor onto the antisymmetric class:", "ExampleText",
 CellID->337089098,ExpressionUUID->"ff54a48e-4d23-4ecb-8dc0-4d4559fb5c45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungProject", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->985590089,ExpressionUUID->"f4c7c7ec-fcf2-4c6c-8db2-924a78bdf922"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"-", 
      FractionBox["1", "2"]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "2"], ",", "0"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->82276612,ExpressionUUID->"b811d144-ef18-4bfe-996c-40262780f835"]
}, Open  ]],

Cell["Projection is idempotent:", "ExampleText",
 CellID->277238324,ExpressionUUID->"94584f31-a909-49f8-8456-73d4a11def0b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"YoungProject", "[", 
   RowBox[{
    RowBox[{"YoungProject", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
