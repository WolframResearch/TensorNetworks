Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "A 3-tensor chain", "ExampleSubsection",ExpressionUUID->
   "9195a13c-daa7-485e-919f-6af15b1c0492"],
  $Line = 0; Null]], "ExampleSubsection",
 CellID->1225640039,ExpressionUUID->"1163073c-8bed-43a4-b8a9-a987879ea8ad"],

Cell["\<\
Build a chain of three tensors sharing pairwise indices 2 and 3:\
\>", "ExampleText",
 CellID->1225640040,ExpressionUUID->"cbefaca2-76e5-4c06-8ab5-9df7a2ae7a62"],

Cell[BoxData[
 RowBox[{"tn", "=", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[4]:=",
 CellID->1225640041,ExpressionUUID->"fc01403e-1535-4a07-8e79-8da14a4875e3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorNetworkContractions", "[", "tn", "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->1225640042,ExpressionUUID->"a1c08443-b863-48e6-a05f-a94a05542e8a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1"},
      "Superscript"], ",", 
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"1", "2"},
        "Superscript"], ",", 
       TemplateBox[{"2", "2"},
        "Superscript"]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"1", "2"},
        "Superscript"], ",", 
       TemplateBox[{"2", "2"},
        "Superscript"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"2", "3"},
        "Superscript"], ",", 
       TemplateBox[{"3", "3"},
        "Superscript"]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"2", "3"},
        "Superscript"], ",", 
       TemplateBox[{"3", "3"},
        "Superscript"]}], "}"}], ",", 
     TemplateBox[{"3", "4"},
      "Superscript"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[5]=",
 CellID->1225640043,ExpressionUUID->"697bb3b9-cba2-473d-8c14-dc00d9503fd3"]
}, Open  ]]
}, Open  ]],

