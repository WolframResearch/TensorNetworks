      RowBox[{
       TemplateBox[{"1", "j"},
        "Superscript"], ",", 
       TemplateBox[{"2", "j"},
        "Superscript"]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"1", "j"},
        "Superscript"], ",", 
       TemplateBox[{"2", "j"},
        "Superscript"]}], "}"}], ",", 
     TemplateBox[{"2", "k"},
      "Superscript"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->680001022,ExpressionUUID->"2bc537ef-1a09-4a24-9967-0671ee4ad28f"]
}, Open  ]],

