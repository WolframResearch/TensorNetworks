 CellID->668993450,ExpressionUUID->"a750c370-db67-49d0-9add-98393c2ee26f"],

Cell[BoxData[
 RowBox[{"mps", "=", 
  RowBox[{"RandomTensorNetwork", "[", 
   RowBox[{"\"\<MPS\>\"", "[", 
    RowBox[{"4", ",", "2", ",", "2"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[6]:=",
 CellID->668993451,ExpressionUUID->"52878e52-2db5-4588-b424-550a7214a409"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorNetworkContractions", "[", "mps", "]"}]], "Input",
 CellLabel->"In[7]:=",
 CellID->668993452,ExpressionUUID->"06c77d42-0ef9-417f-8726-f4940ded91ef"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"1", "1"},
        "Superscript"], ",", 
       TemplateBox[{"2", "1"},
        "Superscript"]}], "}"}], ",", 
     TemplateBox[{"1", "5"},
      "Superscript"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"1", "1"},
        "Superscript"], ",", 
       TemplateBox[{"2", "1"},
        "Superscript"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"2", "2"},
        "Superscript"], ",", 
       TemplateBox[{"3", "2"},
        "Superscript"]}], "}"}], ",", 
     TemplateBox[{"2", "6"},
      "Superscript"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"2", "2"},
        "Superscript"], ",", 
       TemplateBox[{"3", "2"},
        "Superscript"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"3", "3"},
        "Superscript"], ",", 
       TemplateBox[{"4", "3"},
        "Superscript"]}], "}"}], ",", 
