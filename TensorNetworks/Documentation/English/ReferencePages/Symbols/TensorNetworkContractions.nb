Notebook[{

Cell[CellGroupData[{
Cell["TensorNetworkContractions", "ObjectName",
 CellID->112304840,ExpressionUUID->"cad917d1-649a-4820-a379-c3a15dfab277"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b6fdfe10-f5e0-43c0-a329-67727ab25be8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContractions",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/TensorNetworks/ref/TensorNetworkContractions"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "5aa67362-1e52-4dcd-9dd9-5eae89995d50"],
 "\[LineSeparator]returns the list of index contractions in the tensor \
network ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "ce08bd6b-30ce-4106-affa-8428c829884c"],
 ", with each shared index replaced by the canonical list of its per-tensor \
labeled occurrences."
}], "Usage",
 CellID->2016803814,ExpressionUUID->"e91722e2-2938-4337-83e7-958ae0256a24"],

Cell[TextData[{
 "The per-tensor labeling of indices is the same one returned by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Indices\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"ef550a95-d042-4d4c-84c9-2fe05c75b9fe"],
 ": the leg in position ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "6f2b9106-d939-4f62-9e75-d8808ffa3498"],
 " of tensor ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "c2f6e1df-688c-4f36-9274-304a87f7e6cd"],
 " is written ",
 Cell[BoxData[
  SuperscriptBox[
   StyleBox["i", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula",ExpressionUUID->
  "4c0754d3-9774-454b-9367-34af01170c9e"],
 "."
}], "Notes",
 CellID->1904918230,ExpressionUUID->"756ad02e-7655-450e-b90c-22bdd1b86da3"],

Cell[TextData[{
 "Every occurrence of a shared (contracted) index is replaced by the same \
list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SuperscriptBox[
     StyleBox["i", "TI"], "1"], ",", 
    SuperscriptBox[
     StyleBox["i", "TI"], "2"], ",", "\[Ellipsis]"}], "}"}]], "InlineFormula",
  ExpressionUUID->"3f854d35-a04a-49aa-aabd-634c0898b54b"],
 " that collects the per-tensor labels of every leg sharing that index. Free \
indices keep their single per-tensor label."
}], "Notes",
 CellID->1904918231,ExpressionUUID->"4b9b2c28-3538-49dc-b1aa-e1cf016b1be8"],

Cell[TextData[{
 "The property-form ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Contractions\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"cc77f48c-d710-4829-8476-04bb0ea47fb3"],
 " is equivalent to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContractions",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/TensorNetworks/ref/TensorNetworkContractions"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "62e7defa-8626-47c5-952f-91f22a0bd8ad"],
 "."
}], "Notes",
 CellID->1904918232,ExpressionUUID->"8e1da001-9f8f-4322-8c1f-52d2c2213d11"],

Cell[TextData[{
 "The same value is exposed in the ",
 Cell[BoxData[
  ButtonBox["TensorNetworkData",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkData"]], 
  "InlineFormula",ExpressionUUID->"59f61265-fcdf-41a6-ab37-a0b24f2c371e"],
 " association under the key ",
 Cell[BoxData["\"\<Contractions\>\""], "InlineFormula",ExpressionUUID->
  "922b624f-fb46-4306-a046-37c1f2aa150f"],
 ". The companion key ",
 Cell[BoxData["\"\<ContractionIndices\>\""], "InlineFormula",ExpressionUUID->
  "5e2bba5d-b145-405e-b106-678573fffa98"],
 " keeps only the original integer or symbolic index labels rather than the \
per-tensor labeled view."
}], "Notes",
 CellID->1904918233,ExpressionUUID->"9610ce2b-96d4-4e80-a93f-150686e495fb"]
}, Open  ]],

