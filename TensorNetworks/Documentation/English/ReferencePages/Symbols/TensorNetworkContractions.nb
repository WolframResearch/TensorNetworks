Cell[TextData[{
 "Count the contracted (bond) edges of a network. Every shared index \
contributes one inner list to ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContractions",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/TensorNetworks/ref/TensorNetworkContractions"]], 
  "InlineFormula",ExpressionUUID->"80ccd924-b060-4cbb-8b46-0672e9595fe3"],
 ", so the count of unique inner lists equals the number of contraction edges:"
}], "ExampleText",
 CellID->1696005300,ExpressionUUID->"c3a7f546-debd-41d8-9345-0783ab21d9b4"],

Cell[BoxData[
 RowBox[{"mps", "=", 
  RowBox[{"RandomTensorNetwork", "[", 
   RowBox[{"\"\<MPS\>\"", "[", 
    RowBox[{"4", ",", "2", ",", "2"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[8]:=",
 CellID->1696005301,ExpressionUUID->"094be2c3-0355-40bb-8739-8c00dbc3ae20"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Length", "@", 
  RowBox[{"Union", "@", 
   RowBox[{"Cases", "[", 
    RowBox[{
     RowBox[{"Catenate", "[", 
      RowBox[{"TensorNetworkContractions", "[", "mps", "]"}], "]"}], ",", 
     "_List"}], "]"}]}]}]], "Input",
 CellLabel->"In[9]:=",
 CellID->1696005302,ExpressionUUID->"e9017d32-b35a-4f86-97b8-b4fc57e72599"],

