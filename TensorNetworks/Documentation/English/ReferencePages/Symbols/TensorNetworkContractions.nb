Cell["Get the list of index contractions in a tensor network:", "ExampleText",
 CellID->680001001,ExpressionUUID->"17842b6a-ce39-422b-8ad7-ba4410fac17a"],

Cell[BoxData[
 RowBox[{"tn", "=", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", "j"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->680001002,ExpressionUUID->"94e29030-3b4c-4d3d-886e-d5aca8018075"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorNetworkContractions", "[", "tn", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->680001003,ExpressionUUID->"2e62ae8d-bf2c-4394-8200-7a3a5ada3557"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "i"},
      "Superscript"], ",", 
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"1", "j"},
        "Superscript"], ",", 
       TemplateBox[{"2", "j"},
        "Superscript"]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"1", "j"},
        "Superscript"], ",", 
       TemplateBox[{"2", "j"},
        "Superscript"]}], "}"}], ",", 
     TemplateBox[{"2", "k"},
      "Superscript"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]=",
 CellID->680001004,ExpressionUUID->"d5a0fb03-43d1-4a9e-b9a8-041e44274bf0"]
}, Open  ]],

Cell[TextData[{
 "The shared index ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "828804e9-8b72-4572-9850-f344f5a636a9"],
 " has been replaced everywhere it appears by the list ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SuperscriptBox["1", "j"], ",", 
    SuperscriptBox["2", "j"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "7bfac4c8-77f6-443c-8274-4128243b1420"],
 " of its two per-tensor labels, while the free indices ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "6e3aaf89-3aa3-47d2-9d3b-b9c3b8e4261d"],
 " and ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "4c9bd026-78b8-4812-8094-a9bca1ed8e24"],
 " keep a single labeled occurrence ",
 Cell[BoxData[
  SuperscriptBox["1", "i"]], "InlineFormula",ExpressionUUID->
  "33a49a5d-d3ba-4eaf-8d2d-e04eb0ca7147"],
 " and ",
 Cell[BoxData[
  SuperscriptBox["2", "k"]], "InlineFormula",ExpressionUUID->
  "6c05ca6c-6783-4dac-ac59-faaef81790de"],
 "."
}], "ExampleText",
 CellID->680001011,ExpressionUUID->"4906adf7-31f5-46ef-b0e6-b7fbaa1336ea"],

Cell["\<\
The same contraction structure is exposed under property syntax:\
\>", "ExampleText",
 CellID->680001020,ExpressionUUID->"46debd3f-3f69-4412-809b-1528a7de3231"],

Cell[CellGroupData[{

Cell[BoxData[
