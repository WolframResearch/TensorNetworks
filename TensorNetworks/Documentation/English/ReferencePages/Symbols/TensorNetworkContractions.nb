Cell["Get the list of index contractions in a tensor network:", "ExampleText",
 CellID->680001001,ExpressionUUID->"680001001-contrs-text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->680001002,ExpressionUUID->"680001002-contrs-input1"],

