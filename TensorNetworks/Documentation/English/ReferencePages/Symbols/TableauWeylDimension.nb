   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "0914603d-b54a-45e2-842c-69d66e4363b2"],
 " and emits ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"TableauWeylDimension", "::", "noyt"}], "MR"]], "InlineFormula",
  ExpressionUUID->"11d19b0c-bc73-4c01-8b92-e40c397cfee5"],
 " for any other input. For a bare partition, use ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["SchurDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/SchurDimension"], "[", 
   RowBox[{
    StyleBox["partition", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "174a90e6-ca20-4eb5-8529-7b64a4fa6c31"],
 " instead."
}], "Notes",
 CellID->694070807,ExpressionUUID->"37d051ff-1ac6-4564-badf-8aa368524133"]
}, Open  ]],

