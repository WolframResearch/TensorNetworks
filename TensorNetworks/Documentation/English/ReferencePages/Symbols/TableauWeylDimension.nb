Cell["\<\
All standard fillings of a given shape return the same value:\
\>", "ExampleText",
 CellID->47895663,ExpressionUUID->"e46346e6-3dee-4932-a759-cd05f213c52a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"shape", ",", " ", "fillings"}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{"shape", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "2"}], "}"}]}], ";", " ", 
    RowBox[{"fillings", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"YoungTableau", "[", "shape", "]"}], ",", " ", 
       RowBox[{"YoungTableau", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "5"}], "}"}], ",", " ", 
          RowBox[{"{", 
