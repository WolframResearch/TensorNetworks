  "34f3eb96-4ae1-4661-8b3b-5adc08aa4352"],
 "\[LineSeparator]gives the ",
 Cell[BoxData[
  RowBox[{"GL", "(", 
   StyleBox["d", "TI"], ")"}]], "InlineFormula",ExpressionUUID->
  "65e21a97-92b6-437f-82b9-704b729c90bb"],
 " Weyl module dimension for the partition underlying the Young ",
 StyleBox["tableau", " TI"],
 "."
}], "Usage",ExpressionUUID->"9ab874d1-aa26-411b-b078-f4b9b78286b0"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TableauWeylDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauWeylDimension"]], 
  "InlineFormula",ExpressionUUID->"6d18b4ae-889e-4655-b59f-3090ea9c36ff"],
 " is the tableau-keyed companion to ",
 Cell[BoxData[
  ButtonBox["TableauDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"]], 
  "InlineFormula",ExpressionUUID->"69f18ef1-b595-4f2a-a7c1-58b015f58d0b"],
 ". While ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"], "[", 
   StyleBox["tab", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2667d698-ff62-4775-8ca0-75757da50242"],
 " returns the dimension dim ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["V", "TI"], "\[Lambda]"]], "InlineFormula",ExpressionUUID->
  "5c2f66a9-1a35-4df6-9a34-7c2e79f50576"],
 " of the ",
 Cell[BoxData[
  SubscriptBox["S", 
   StyleBox["n", "TI"]]], "InlineFormula",ExpressionUUID->
  "bc4f8c62-7add-4324-ab47-38dd31f8310f"],
 " irrep (independent of ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "c37086bb-2c57-43e7-bda9-27d3fde1adfe"],
 "), ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauWeylDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauWeylDimension"], "[", 
   RowBox[{
    StyleBox["tab", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "888fec9e-5608-47ec-b7cb-f2dfb18d9a2c"],
 " returns the dimension dim ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["W", "TI"], "\[Lambda]"], "(", 
   StyleBox["d", "TI"], ")"}]], "InlineFormula",ExpressionUUID->
  "0fd0f508-ce3f-412e-9703-40d5e1d53376"],
 " of the ",
 Cell[BoxData[
  RowBox[{"GL", "(", 
   StyleBox["d", "TI"], ")"}]], "InlineFormula",ExpressionUUID->
  "2f4ec783-cc10-4d0e-a165-8ebd29237b22"],
 " Weyl module."
}], "Notes",
 CellID->714398160,ExpressionUUID->"153644dd-bce7-463b-bb66-ea22be4bfafc"],

Cell[TextData[{
 "The product ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"], "[", 
   StyleBox["tab", "TI"], "]", "\[CenterDot]", 
   ButtonBox["TableauWeylDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauWeylDimension"], "[", 
   RowBox[{
    StyleBox["tab", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c5420f5e-4bdf-4fea-8ec3-7b1a7a17f08c"],
 " is the size of the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["\[Lambda]", "TI"], ""]], "InlineFormula",ExpressionUUID->
  "f9e79818-1d56-4a69-ac02-cc0b0b999142"],
 "-isotypic block of ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"(", 
    SuperscriptBox["\[DoubleStruckCapitalC]", 
     StyleBox["d", "TI"]], ")"}], 
   RowBox[{"\[CircleTimes]", 
    StyleBox["n", "TI"]}]]], "InlineFormula",ExpressionUUID->
  "a88e7eca-1000-4f8b-887f-031bd3dfd70a"],
 " under the Schur-Weyl duality of ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["S", 
    StyleBox["n", "TI"]], "\[Times]", 
   RowBox[{"GL", "(", 
    StyleBox["d", "TI"], ")"}]}]], "InlineFormula",ExpressionUUID->
  "634e56a9-9693-4695-a69f-97a91241d627"],
 "."
}], "Notes",
 CellID->580864946,ExpressionUUID->"55ced9b4-f528-4a29-b2af-103abb68bfd7"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauWeylDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauWeylDimension"], "[", 
   RowBox[{
    StyleBox["tab", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "afc4b599-4c57-47cb-be2a-080ca067dfff"],
 " is equivalent to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["SchurDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/SchurDimension"], "[", 
   RowBox[{
    ButtonBox["TableauShape",
     BaseStyle->"Link",
     ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"], "[", 
    StyleBox["tab", "TI"], "]", ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "cf4175f3-ab84-4158-9424-e30170b50b6c"],
 ": the value depends only on the shape of ",
 Cell[BoxData[
  StyleBox["tab", "TI"]], "InlineFormula",ExpressionUUID->
  "38f46095-7c11-4e6d-9350-df7d884182ab"],
 ", never on how the boxes are filled."
}], "Notes",
 CellID->615678339,ExpressionUUID->"e0ca7f36-6cef-492e-a303-927f246f622e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "40d67893-7f94-4707-ac91-778b2b212bd9"],
 " may be numeric or symbolic. For symbolic ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "32f3016c-fb9d-4e79-94b9-5f3680f83375"],
 " the result is a polynomial in ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "d070312f-3a9f-4fe0-9a2b-098592f51351"],
 " of degree ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", 
   ButtonBox["TableauSize",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauSize"], "[", 
   StyleBox["tab", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d086a9cd-9e1f-43f2-93af-5d8897a0a172"],
 "; pipe through ",
 Cell[BoxData[
  ButtonBox["Factor",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Factor"]], "InlineFormula",ExpressionUUID->
  "32f6ccb6-64fb-4b77-88c6-42f9f7cc9acb"],
 " or ",
 Cell[BoxData[
  ButtonBox["Simplify",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Simplify"]], "InlineFormula",ExpressionUUID->
  "1bd9e458-e618-449d-8a86-cb48c4320084"],
 " for a closed form."
}], "Notes",
 CellID->624783894,ExpressionUUID->"e0528010-f222-42d0-8526-b5811d5c50e5"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TableauWeylDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauWeylDimension"]], 
  "InlineFormula",ExpressionUUID->"ee909416-de17-4171-a8ac-3bb34ffff455"],
