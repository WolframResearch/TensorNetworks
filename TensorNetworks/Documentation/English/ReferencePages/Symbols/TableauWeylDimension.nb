Cell["TableauWeylDimension", "ObjectName",ExpressionUUID->"584f7648-7645-4eb9-b35e-f3ef5a74309c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1bf4dca8-1b06-42cb-87fe-71fa0fa068ff"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauWeylDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauWeylDimension"], "[", 
