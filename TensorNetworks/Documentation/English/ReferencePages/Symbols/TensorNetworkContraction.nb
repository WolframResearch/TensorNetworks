Cell["\<\
Construct a small two-tensor network used in the examples below:\
\>", "ExampleText",
 CellID->101550257,ExpressionUUID->"a0ae2332-8515-4630-acfd-bfaf176be041"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", " ", "=", " ", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.5", ",", " ", 
          RowBox[{"-", "0.2"}], ",", " ", "0.3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.1", ",", " ", "0.8", ",", " ", 
          RowBox[{"-", "0.4"}]}], "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.6", ",", " ", "0.4", ",", " ", 
          RowBox[{"-", "0.1"}], ",", " ", "0.2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.3"}], ",", " ", "0.5", ",", " ", "0.7", ",", " ", 
          RowBox[{"-", "0.2"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.1", ",", " ", 
          RowBox[{"-", "0.4"}], ",", " ", "0.3", ",", " ", "0.5"}], "}"}]}], 
       "}"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "k"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->100985944,ExpressionUUID->"f2344e4e-511d-42e7-8e8c-7054a7d50bc2"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["TensorNetwork",
    "SummaryHead"], "[", 
   DynamicModuleBox[{Typeset`open$$ = False, Typeset`embedState$$ = "Ready"}, 
    
    TemplateBox[{
      PaneSelectorBox[{False -> GridBox[{{
            PaneBox[
             ButtonBox[
              DynamicBox[
               FEPrivate`FrontEndResource["FEBitmaps", "SummaryBoxOpener"]], 
              ButtonFunction :> (Typeset`open$$ = True), Appearance -> None, 
              BaseStyle -> {}, Evaluator -> Automatic, Method -> 
              "Preemptive"], Alignment -> {Center, Center}, ImageSize -> 
             Dynamic[{
               Automatic, 
                3.5 (CurrentValue["FontCapHeight"]/AbsoluteCurrentValue[
                 Magnification])}]], 
            GraphicsBox[{
              Opacity[0.5], 
              Arrowheads[{{Medium, 0.5}}], 
              AbsoluteThickness[Medium], {{
                Opacity[1], 
                Arrowheads[{{Small, 0.5}}], {
                 Directive[
                  Arrowheads[{{0.03, 0.5}}], 
                  LightDarkSwitched[
