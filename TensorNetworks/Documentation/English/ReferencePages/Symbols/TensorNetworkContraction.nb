Cell[CellGroupData[{
Cell["TensorNetworkContraction", "ObjectName",
 CellID->108749939,ExpressionUUID->"f06cf6dc-0af8-4f12-885a-07129eed7fd3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2470630b-e945-425a-acca-bb5417399eed"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContraction",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"],
    "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a21afa30-9c11-4aec-8151-37e1931a7df7"],
 "\[LineSeparator]returns an inactive contraction expression for the tensor \
network using an auto-selected path \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"0f38ec96-bde0-405b-8830-d7a293aa6ae4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContraction",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"],
    "[", 
   RowBox[{
    StyleBox["tn", "TI"], ",", 
    StyleBox["path", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1690c938-a815-4cad-b1e0-2945592defdf"],
 "\[LineSeparator]uses the explicit canonical contraction path \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b11894b6-3faf-4bb6-85af-93a413bc0150"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContraction",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"],
    "[", 
   RowBox[{
    StyleBox["tn", "TI"], ",", 
    StyleBox["treePath", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "31f58dc9-ea48-41c4-80de-c2f718372387"],
 "\[LineSeparator]uses a tree-structured contraction path \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"9351e0a3-6893-4802-9904-e3ab0abae176"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContraction",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"],
    "[", 
   RowBox[{
    StyleBox["tn", "TI"], ",", "\"\<Greedy\>\""}], "]"}]], "InlineFormula",
  ExpressionUUID->"d6cc2e18-9545-4564-93ff-91aa3ecba333"],
 "\[LineSeparator]auto-computes a greedy contraction path \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"4034785e-d66a-45db-9384-d8cf843e5348"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContraction",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"],
    "[", 
   RowBox[{
    StyleBox["tn", "TI"], ",", 
    StyleBox["method", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "39fe294b-18f3-4684-9297-0ece91c45273"],
 "\[LineSeparator]uses method-string \"Optimal\", \"flops\", \"max\", \
\"size\", \"write\", \"combo\", or \"limit\" \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"debb233c-8ff6-4d31-9834-0ad59907c138"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContraction",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"],
    "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3ff5213f-67c6-420e-857e-fad2bfccc8fa"],
 "\[LineSeparator]operates on a tensor-network Graph \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"fdcd3252-f7e8-4df8-b79e-5ce76af7c2d0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkContraction",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"],
    "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7086bd95-cac2-4f24-92e4-812aa95b444b"],
 "\[LineSeparator]accepts the low-level Association of network data"
}], "Usage",
 CellID->100007051,ExpressionUUID->"99f381c1-9bd3-4469-aca3-73c3699beeba"],

Cell[TextData[{
 "By default ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
   "InlineFormula",ExpressionUUID->"c7c11af9-83bc-4708-a137-842731a2f421"],
 " returns an ",
 Cell[BoxData[
  ButtonBox["Inactive",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Inactive"]], "InlineFormula",ExpressionUUID->
  "165cbfad-3aa4-47de-b52b-d1d915b8fb61"],
 " expression tree (",
 Cell[BoxData[
  RowBox[{"\"\<Inactive\>\"", " ", "\[Rule]", " ", "True"}]], "InlineFormula",
  ExpressionUUID->"1e442e81-6e55-464a-ac60-bd7e065bc0cd"],
 ") that you can inspect, transform, or pass to ",
 Cell[BoxData[
  ButtonBox["ContractionTree",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ContractionTree"]], 
  "InlineFormula",ExpressionUUID->"2b886a8d-f633-4097-a15e-5675f93b0126"],
 "."
}], "Notes",
 CellID->100069661,ExpressionUUID->"6673a846-6dda-4e91-a0a1-86fecb866975"],

Cell[TextData[{
 "Setting ",
 Cell[BoxData[
  RowBox[{"\"\<Inactive\>\"", " ", "\[Rule]", " ", "False"}]], 
  "InlineFormula",ExpressionUUID->"8666ed9c-ef80-41ca-bf5e-c0919317566f"],
 " evaluates the tree and returns the numerical tensor; this is the path ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"a6e4243f-8dbe-4e36-883e-9485cc20b09a"],
 " takes."
}], "Notes",
 CellID->100115598,ExpressionUUID->"e8d07990-f0f5-49d1-b17a-1ddf67003c59"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ActivateTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ActivateTensors"]], "InlineFormula",ExpressionUUID->
  "88c60700-0d62-4449-b470-8bdce9bc958a"],
 " collapses a returned tree into a numerical tensor; this is useful when the \
tree has already been inspected and only the value is needed."
}], "Notes",
 CellID->100207168,ExpressionUUID->"5f03cf2e-614c-491c-a9c2-d2287569557d"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  ButtonBox["Method",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Method"]], "InlineFormula",ExpressionUUID->
  "6e9433a7-f72d-490a-9ecc-737f605c319b"],
 " option selects one of five binary-contraction engines: \"ArrayDot\" \
(default), \"ArrayDotTranspose\", \"Dot\", \"TensorContract\", and \"TableSum\
\". All engines produce numerically identical results after activation; they \
differ only in the internal representation of the tree. The full list is in \
",
 Cell[BoxData[
  ButtonBox["$TensorNetworkContractionMethods",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/TensorNetworks/ref/$TensorNetworkContractionMethods"]], 
  "InlineFormula",ExpressionUUID->"424d6dcb-c4ad-4d7d-8f2f-a1119b269adb"],
 "."
}], "Notes",
 CellID->100296076,ExpressionUUID->"d81ff468-13c6-4bf2-90af-b754e936f5a5"],

Cell[TextData[{
 "For a single-tensor network (no contraction indices), ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
   "InlineFormula",ExpressionUUID->"2a5203f3-d48d-42e2-9e5f-7d189322f2b3"],
 " returns the tensor directly via the ",
 Cell[BoxData[
  ButtonBox["EinsteinSummation",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/EinsteinSummation"]], 
  "InlineFormula",ExpressionUUID->"ecc55dc4-6d3d-4fb6-ac80-c8c3713240ee"],
 " fallback path."
}], "Notes",
 CellID->100373856,ExpressionUUID->"e650c8a1-dead-4445-8b4a-05c1a537b7a9"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  StyleBox["path", "TI"]], "InlineFormula",ExpressionUUID->
  "7ae6fb45-e052-4218-8308-bd6ace1422a2"],
 " is a list of integer pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], "}"}], ",", "\[Ellipsis]", "}"}]], 
  "InlineFormula",ExpressionUUID->"ad0a455b-5aa9-46d7-b00f-e7fb10e02ee5"],
 " in opt_einsum convention; a ",
 Cell[BoxData[
  StyleBox["treePath", "TI"]], "InlineFormula",ExpressionUUID->
  "76fff2f5-efdf-4bdb-a154-122115644176"],
 " is the tree-structured form produced by ",
 Cell[BoxData[
  ButtonBox["PathToTreePath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathToTreePath"]], 
  "InlineFormula",ExpressionUUID->"aa72c3f3-c4e4-44cf-88c0-3e3f03c36e43"],
 "."
}], "Notes",
 CellID->100378548,ExpressionUUID->"24526407-d1c8-4b51-af03-a6175c0da5d9"],

Cell["The following options can be given: ", "Notes",
 CellID->100388739,ExpressionUUID->"eeffc829-ae60-4289-86f9-5ab7ce585436"],

