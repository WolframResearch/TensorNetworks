Cell[CellGroupData[{
Cell["TensorNetworkFindContractionPath", "ObjectName",
 CellID->915395088,ExpressionUUID->"d03cf043-9f61-409d-b6d9-676edd3f6d74"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"25fd838a-458a-47e7-87e1-39ff887792c8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkFindContractionPath",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/TensorNetworks/ref/TensorNetworkFindContractionPath"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3e2003e0-472b-4c3a-85fc-b5c51f28cd22"],
 "\[LineSeparator]is deprecated; forwards to OptimalContractionPath. \
\[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"9a55318c-afcd-402e-a1c1-c5dd4ac6ea5c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkFindContractionPath",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/TensorNetworks/ref/TensorNetworkFindContractionPath"], "[", 
   RowBox[{
    StyleBox["tn", "TI"], ",", 
    RowBox[{
     ButtonBox["Method",
      BaseStyle->"Link"], "\[Rule]", 
     StyleBox["m", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6e243ed1-f11a-4809-8ba9-1cb05429dbb0"],
 "\[LineSeparator]selects the path-finder by Method m. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b538a38f-07d1-45ec-9d58-9f565c0b0b93"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkFindContractionPath",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/TensorNetworks/ref/TensorNetworkFindContractionPath"], "[", 
   RowBox[{
    StyleBox["tn", "TI"], ",", 
    RowBox[{"\"\<ReturnParameters\>\"", "\[Rule]", "True"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"f3716807-b912-4927-b325-ee7569b2a0d7"],
 "\[LineSeparator]returns the internal parameter-extraction result instead of \
a path."
}], "Usage",
 CellID->101096578,ExpressionUUID->"9f9592f8-342c-4fb7-9225-bac7e8656a06"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetworkFindContractionPath",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/TensorNetworks/ref/TensorNetworkFindContractionPath"]], 
  "InlineFormula",ExpressionUUID->"069c31fe-d1b8-4c08-bcba-c26522ddf536"],
 " is deprecated. New code should call ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"c6778a86-16f3-4772-8c2c-e5ffc135ce0e"],
 " or ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"50780187-7bf3-4e5c-bd13-704995f54d2a"],
 " directly."
}], "Notes",
 CellID->953507544,ExpressionUUID->"ebd01df8-65cd-4129-85d1-82a2f3e6eadd"],

Cell[TextData[{
 "The function issues ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"General", "::", "deprec"}], "Code"]], "InlineFormula",
  ExpressionUUID->"5c5039cf-9e4c-4ba8-8379-f3dee672d630"],
 " on every call. The tag is the system-wide ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"General", "::", "deprec"}], "Code"]], "InlineFormula",
  ExpressionUUID->"5bda6aab-f7dc-4175-acac-f9fdde1c104e"],
 ", not a symbol-specific message, so ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Off",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Off"], "[", 
   StyleBox[
    RowBox[{"General", "::", "deprec"}], "Code"], "]"}]], "InlineFormula",
  ExpressionUUID->"5784b1c7-23e0-494b-8eb2-766c27ab8040"],
 " suppresses it."
}], "Notes",
 CellID->63827770,ExpressionUUID->"483b0f71-8f8f-426e-a81b-6f92e671d234"],

Cell[TextData[{
 "The default ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link"], "\[Rule]", "\"\<Optimal\>\""}]], "InlineFormula",
  ExpressionUUID->"f7a548af-5bf0-4dc5-96d0-1e4937a9a6e9"],
 " forwards to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["OptimalContractionPath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"], "[", 
   StyleBox["tn", "TI"], ",", 
   RowBox[{
    ButtonBox["Method",
     BaseStyle->"Link"], "\[Rule]", "\"\<size\>\""}], "]"}]], "InlineFormula",
  ExpressionUUID->"d61f4eef-f91c-4bc6-b13a-82f9650c9d6b"],
 ", matching OptimalContractionPath's own documented default."
}], "Notes",
 CellID->578885598,ExpressionUUID->"c41b2410-828d-4b29-bde1-243f0c4c56d8"],

Cell[TextData[{
 "Method values \"flops\", \"max\", \"size\", \"write\", \"combo\", and \
\"limit\" forward to ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"a67d5642-b548-4b1d-a1a3-2d502ef4d6c7"],
 " with that Method. Any other value, including \"Greedy\", forwards to ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"f88b7d7f-821e-40a8-a67b-7b9b2b4bbf19"],
 "."
}], "Notes",
 CellID->977705294,ExpressionUUID->"b7ca3aad-3b0d-4f5f-a08a-e62c86a09b6a"],

Cell["\<\
With \"ReturnParameters\" -> True the function returns the result of an \
internal parameter-extraction helper instead of a path. This option is \
intended for inspecting what the path-finder receives and is not part of the \
supported public API.\
\>", "Notes",
 CellID->202408814,ExpressionUUID->"fe76fbf4-6423-4f37-88d0-3cc232154848"],

Cell["The following options can be given: ", "Notes",
 CellID->480826635,ExpressionUUID->"48f79f99-e633-4dac-880c-11800cfbb059"],

