Cell["\<\
Find an optimized contraction path for a tensor network. \
TensorNetworkFindContractionPath is deprecated; its call issues \
General::deprec and forwards to OptimalContractionPath or \
GreedyContractionPath:\
\>", "ExampleText",
 CellID->837897429,ExpressionUUID->"1a958295-b199-4e77-b177-539d00d74d04"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Hold", "[", 
   RowBox[{"tn", " ", "=", " ", 
    RowBox[{"RandomTensorNetwork", "[", 
     RowBox[{"\"\<MPS\>\"", "[", 
      RowBox[{"10", ",", " ", "5", ",", " ", "4"}], "]"}], "]"}]}], "]"}], 
  " ", "/.", " ", 
  RowBox[{
   RowBox[{"Hold", "[", "x_", "]"}], " ", ":>", " ", "x"}]}]], "Input",
 CellLabel->"In[1]:=",
