Cell[CellGroupData[{

Cell["Different engines", "ExampleSubsection",
 CellID->869948634,ExpressionUUID->"bfb7cace-e178-42ad-8da2-2b10728194dd"],

Cell[TextData[{
 "The default contraction engine (",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Method"], "->", 
   StyleBox["\"\<ArrayDot\>\"",
    ShowStringCharacters->True]}]], "InlineFormula",ExpressionUUID->
  "d5b612cb-2d01-4ed8-b103-9fca1d8ade9e"],
 ") composes pairwise contractions out of ",
 Cell[BoxData[
  ButtonBox["ArrayDot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ArrayDot"]], "InlineFormula",ExpressionUUID->
  "8a2a2e96-ef2a-49c6-845a-35c931a6c787"],
 ", ",
 Cell[BoxData[
  ButtonBox["Transpose",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Transpose"]], "InlineFormula",ExpressionUUID->
  "547e0931-1eb1-48dc-b124-e734ab8c8a97"],
 ", and ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorProduct"]], "InlineFormula",ExpressionUUID->
  "c19b0d7a-090b-4d2d-b55b-e0604f648789"],
 ". Switching to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Method",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Method"], "->", 
   StyleBox["\"\<TensorContract\>\"",
    ShowStringCharacters->True]}]], "InlineFormula",ExpressionUUID->
  "f1e1b46b-31b7-4a64-8a9e-14e42b403919"],
 " replaces ",
 Cell[BoxData[
  ButtonBox["ArrayDot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ArrayDot"]], "InlineFormula",ExpressionUUID->
  "86c4c2a9-74b8-415f-a5cb-652d94d408fa"],
 " nodes with ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorContract"]], "InlineFormula",ExpressionUUID->
  "680bd12c-35cc-4155-9969-c7ce1f7200bb"],
 "/",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorProduct"]], "InlineFormula",ExpressionUUID->
  "dcaea435-ebd0-44d4-a1c4-86949932e314"],
 " nodes:"
}], "ExampleText",
