 CellID->654017635,ExpressionUUID->"7a2053ca-d7a8-4c6d-9965-9c94bca0001e"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "e09a6bc4-1ab6-40af-a1b2-0f777b515d5d"],
 " is normally an ",
 Cell[BoxData[
  ButtonBox["Inactive",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Inactive"]], "InlineFormula",ExpressionUUID->
  "6f824d8e-dc60-46a8-a3db-634f5b1b4041"],
 " contraction tree such as the one produced by ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
   "InlineFormula",ExpressionUUID->"f068df42-62a7-429e-8523-8505208146bb"],
 "; the recognized inactive heads are ",
 Cell[BoxData[
  ButtonBox["ArrayDot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ArrayDot"]], "InlineFormula",ExpressionUUID->
  "98370140-bcc1-4f64-b5f1-5c189c490a1b"],
 ", ",
 Cell[BoxData[
  ButtonBox["Dot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Dot"]], "InlineFormula",ExpressionUUID->
  "c2d90a19-d972-47d0-9d4b-86b872f11ec8"],
 ", ",
 Cell[BoxData[
  ButtonBox["Transpose",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Transpose"]], "InlineFormula",ExpressionUUID->
  "9163d135-7626-46b0-bc12-6bf3e7d9b6db"],
 ", ",
 Cell[BoxData[
  ButtonBox["ArrayReshape",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ArrayReshape"]], "InlineFormula",ExpressionUUID->
  "3dafddb5-7c27-4aa0-af26-c508a92fada4"],
 ", ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorProduct"]], "InlineFormula",ExpressionUUID->
  "2a742d1e-b71a-4d79-9a43-9f4307dfb367"],
 ", and ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorContract"]], "InlineFormula",ExpressionUUID->
  "8a3097e3-78ad-4d58-aa3d-0cbabcb681b5"],
 ". Anything else is treated as a tensor leaf."
}], "Notes",
 CellID->108015121,ExpressionUUID->"97835d60-f5e9-4e9c-86c2-d4b444e4f83c"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["\"\<Labels\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "b6f66a9c-4b9e-4783-8aa8-5b3315242593"],
 " option controls node labels: ",
 Cell[BoxData[
  StyleBox["\"\<Dimensions\>\"",
   ShowStringCharacters->True]], "InlineFormula",ExpressionUUID->
  "bb2e7b4b-a5da-47cc-8e02-318e30a96892"],
 " labels each node by its tensor dimensions, subscripted by the contracted \
axes; any other value (including the default ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Automatic"]], "InlineFormula",ExpressionUUID->
  "e2e26328-e762-4f4d-b1ec-a0c5c189d0e3"],
 ") labels each node by the symbolic contraction operation (",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Inactive",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Inactive"], "[", 
   ButtonBox["ArrayDot",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/ArrayDot"], "]"}]], "InlineFormula",
  ExpressionUUID->"5070c8f9-d298-4cfe-8824-ced45cbb1e44"],
 ", ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Inactive",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Inactive"], "[", 
   ButtonBox["TensorContract",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/TensorContract"], "]"}]], "InlineFormula",
  ExpressionUUID->"0785d8fb-c002-4398-b34b-214adfa6d05c"],
 ", etc.) wrapped around ",
 Cell[BoxData[
  ButtonBox["ArraySymbol",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ArraySymbol"]], 
  "InlineFormula",ExpressionUUID->"7e46a996-1de9-455e-9335-cbf680afb2c6"],
 " placeholders."
}], "Notes",
 CellID->25972871,ExpressionUUID->"b00cb49f-c78b-439f-818a-f8625d7705c9"],

Cell[TextData[{
