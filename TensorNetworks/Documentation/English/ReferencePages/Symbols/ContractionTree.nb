expression ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "03d745f7-265a-4595-ab51-ec5dd09fa125"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ff454719-dda7-4c73-b0c3-0571679ec4cf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ContractionTree",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/ContractionTree"], "[", 
   RowBox[{
    StyleBox["expr", "TI"], ",", 
    StyleBox["opts", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "dbcb6f51-ba73-40bd-9a65-a74180c1dc8b"],
 "\[LineSeparator]applies the option settings ",
 Cell[BoxData[
  StyleBox["opts", "TI"]], "InlineFormula",ExpressionUUID->
  "86e8ca53-de2f-4f09-bb46-76038367eacf"],
 " (any ",
 Cell[BoxData[
  ButtonBox["Tree",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Tree"]], "InlineFormula",ExpressionUUID->
  "2a6cad47-836b-43c0-817c-7d0075a04a0b"],
 " option plus the ",
