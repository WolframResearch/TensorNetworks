Cell[CellGroupData[{

Cell["Different paths", "ExampleSubsection",
 CellID->905029004,ExpressionUUID->"b99c898d-ab11-40a9-95c8-55f82d87f3c1"],

Cell[TextData[{
 "The greedy path is a heuristic; the optimal path produced by ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"01c0a0ea-2fd3-423d-8cb1-f5134cb234ee"],
 " typically yields a different contraction order, visible in the tree \
shape:"
}], "ExampleText",
 CellID->608887465,ExpressionUUID->"2cecb609-6839-4777-b6b1-44ff270381cf"],

