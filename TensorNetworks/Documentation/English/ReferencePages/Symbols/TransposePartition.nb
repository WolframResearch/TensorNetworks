Cell["Non-partition input", "ExampleSubsection",
 CellID->552745575,ExpressionUUID->"b2fd96dc-bc97-4f9a-8320-8b9eed7faba6"],

Cell["\<\
A list whose entries do not form a non-increasing sequence is not a valid \
partition. TransposePartition issues a message and returns $Failed; the \
assertion below confirms that outcome:\
\>", "ExampleText",
 CellID->488247794,ExpressionUUID->"87b5be74-4391-4437-9049-b6bb4f89f00d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Quiet", "[", 
   RowBox[{"TransposePartition", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}], "]"}], " ", "===",
   " ", "$Failed"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->660282859,ExpressionUUID->"004be908-8f49-4e2e-a16f-58b086ca6342"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
 CellID->76739115,ExpressionUUID->"b30752fb-7c2d-41b5-acd1-5b97a144af78"]
}, Open  ]],

