Cell[CellGroupData[{

Cell["Self-conjugate partitions", "ExampleSubsection",
 CellID->664136013,ExpressionUUID->"04d1f882-3530-47ec-b3c7-456be72dc88f"],

Cell["\<\
A partition is self-conjugate when its Young diagram is symmetric about its \
main diagonal. Enumerate the self-conjugate partitions of n = 1 ... 7:\
\>", "ExampleText",
 CellID->597503020,ExpressionUUID->"18bc7cc0-d875-4e16-aadc-c20fefa8bf16"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"IntegerPartitions", "[", "n", "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"TransposePartition", "[", "#1", "]"}], " ", "===", " ", 
       "#1"}], " ", "&"}]}], " ", "]"}], ",", " ", 
   RowBox[{"{", 
