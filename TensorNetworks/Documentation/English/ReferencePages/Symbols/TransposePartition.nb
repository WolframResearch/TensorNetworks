The length of the conjugate equals the largest part of the original partition:\
\>", "ExampleText",
 CellID->871983453,ExpressionUUID->"3b89e36f-de9f-4404-8c2a-e39c3ecaafed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Length", "[", 
    RowBox[{"TransposePartition", "[", 
     RowBox[{"{", 
      RowBox[{"6", ",", " ", "4", ",", " ", "3", ",", " ", "1"}], "}"}], 
     "]"}], "]"}], ",", " ", 
   RowBox[{"First", "[", 
    RowBox[{"{", 
     RowBox[{"6", ",", " ", "4", ",", " ", "3", ",", " ", "1"}], "}"}], 
    "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->378201525,ExpressionUUID->"598d6455-bd98-44d6-99b1-0fa5af2af2c3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "6"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->474481236,ExpressionUUID->"6391a353-f13a-48e6-8590-a3ac808a1c36"]
}, Open  ]]
}, Open  ]]
