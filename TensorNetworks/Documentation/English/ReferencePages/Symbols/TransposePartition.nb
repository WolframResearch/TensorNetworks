 CellID->196796385,ExpressionUUID->"4bd34a44-0a31-4a14-bb69-6ddb1850eb12"],

Cell["\<\
TransposePartition uses PartitionQ as its input validator. The two functions \
agree on which lists are accepted:\
\>", "ExampleText",
 CellID->69046670,ExpressionUUID->"385e55ab-1897-4d4f-87fd-263779b67870"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"PartitionQ", "[", 
    RowBox[{"{", 
     RowBox[{"4", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}], ",", " ", 
   RowBox[{"TransposePartition", "[", 
    RowBox[{"{", 
     RowBox[{"4", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->333279321,ExpressionUUID->"2b7401d8-56d3-4071-a86c-f216cfe5c6fe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "1", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->941237879,ExpressionUUID->"4556841d-9b5b-474e-989a-a17146427272"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
