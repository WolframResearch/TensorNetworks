  $Line = 0; Null]], "ExampleSection",
 CellID->80284633,ExpressionUUID->"246e46ef-0fd7-49a8-b4f1-f24281443acc"],

Cell["\<\
The empty partition is special-cased. Even though PartitionQ[{}] is False, \
TransposePartition[{}] is defined and returns the empty list:\
\>", "ExampleText",
 CellID->188569898,ExpressionUUID->"4ac01e8b-322a-4c4b-9a74-be7bad3eacbd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"TransposePartition", "[", 
    RowBox[{"{", "}"}], "]"}], ",", " ", 
   RowBox[{"PartitionQ", "[", 
