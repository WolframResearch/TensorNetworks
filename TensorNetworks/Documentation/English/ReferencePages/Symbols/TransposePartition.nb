Notebook[{

Cell[CellGroupData[{
Cell["TransposePartition", "ObjectName",
 CellID->320579364,ExpressionUUID->"eee53de3-13f7-4a2e-802c-e1b5de22b6ae"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c3cc09d8-b725-46be-b1b7-b6e5ac0198c8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TransposePartition",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TransposePartition"], "[", 
   
   StyleBox["partition", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "5347387d-ff38-4b62-ae89-15fba66fb6fb"],
 "\[LineSeparator]returns the conjugate (transpose) of an integer partition, \
equivalent to swapping rows and columns of the corresponding Young diagram."
}], "Usage",
 CellID->172581409,ExpressionUUID->"34e59bc6-77fb-4133-88ee-8cad164154cc"],

Cell[TextData[{
 "Each entry of the result is the count of partition parts at least as large \
as the column index: the j-th element of the conjugate is ",
 Cell[BoxData[
  RowBox[{"Count", "[", 
   StyleBox["partition", "TI"], ",", 
   RowBox[{
    StyleBox["x_", "TI"], "/;", 
    RowBox[{
     StyleBox["x", "TI"], "\[GreaterEqual]", 
     StyleBox["j", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "13823e4a-3cd4-4465-884b-6a3920be000c"],
 "."
}], "Notes",
 CellID->223337487,ExpressionUUID->"6731682d-1e22-4e8d-bff0-567ca104c5c6"],

Cell[TextData[{
 Cell[BoxData[
 "TransposePartition"], "InlineFormula",ExpressionUUID->
  "7e057a41-98d7-49e9-b16a-67032240d523"],
 " is the partition-level analogue of swapping rows and columns of the Young \
diagram associated with the partition."
}], "Notes",
 CellID->984669801,ExpressionUUID->"d8f2f204-8904-4157-8903-ca6c94ccb847"],

Cell[TextData[{
 Cell[BoxData[
 "TransposePartition"], "InlineFormula",ExpressionUUID->
  "44a88fb0-8692-462e-9d52-410a92845775"],
 " is a self-inverse operation: ",
 Cell[BoxData[
  RowBox[{"TransposePartition", "[", 
   RowBox[{"TransposePartition", "[", 
    StyleBox["par", "TI"], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "24760aee-7b19-4007-9ccf-8ed26945b911"],
 " is identical to ",
 Cell[BoxData[
  StyleBox["par", "TI"]], "InlineFormula",ExpressionUUID->
  "fb7556c2-b707-47c8-b708-ead5e89ee8ed"],
 " for every valid partition."
}], "Notes",
 CellID->685904443,ExpressionUUID->"82f49174-b37a-4bd8-bdb3-3f1410040072"],

Cell[TextData[{
 "Self-conjugate partitions (those whose Young diagram is symmetric about its \
main diagonal) satisfy ",
 Cell[BoxData[
  RowBox[{"TransposePartition", "[", 
   StyleBox["par", "TI"], "]", "===", 
   StyleBox["par", "TI"]}]], "InlineFormula",ExpressionUUID->
  "744a3bac-1947-46d9-9ce1-56a466f65c17"],
 ". Examples include ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", "2", ",", "1"}], "}"}]], "InlineFormula",ExpressionUUID->
  "123f9783-f989-4e91-80cd-23a3f38c57dc"],
 " and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", "2", ",", "1", ",", "1"}], "}"}]], "InlineFormula",
  ExpressionUUID->"5c04437d-8d6b-4bbb-bf9d-13c59f969fd1"],
 "."
}], "Notes",
 CellID->309493800,ExpressionUUID->"11f33c18-a67d-4131-a89b-4544347fc795"],

Cell[TextData[{
 "The length of the conjugate equals the largest part of the input: ",
 Cell[BoxData[
  RowBox[{"Length", "[", 
   RowBox[{"TransposePartition", "[", 
    StyleBox["par", "TI"], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "8aca726c-ad47-4c8f-956b-901832c0c64e"],
 " equals ",
 Cell[BoxData[
  RowBox[{"First", "[", 
   StyleBox["par", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d46f16e0-1dfc-4b3b-ad4d-8f71f114e432"],
 "."
}], "Notes",
 CellID->571753287,ExpressionUUID->"211c1a88-787b-40e4-85a9-878c3aae6276"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"TransposePartition", "[", 
   RowBox[{"{", "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "cb5a9046-83e9-42cb-b626-2f6dbf8ea40b"],
 " is defined and returns ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "64ced1ba-dcf8-4a1e-86ca-bfeb5a237c97"],
 " as a special case, even though ",
 Cell[BoxData[
  RowBox[{"PartitionQ", "[", 
   RowBox[{"{", "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "27039d4f-102a-4e71-ab2a-fc6f5633474c"],
 " returns ",
 Cell[BoxData[
 "False"], "InlineFormula",ExpressionUUID->
  "5d0b8566-7c99-44ff-a672-9020b3f72d4e"],
 "."
}], "Notes",
 CellID->40550656,ExpressionUUID->"e31f839a-64f6-4522-b114-b022f58b0b43"],

Cell[TextData[{
 "Non-partition input (anything failing ",
 Cell[BoxData[
  RowBox[{"PartitionQ", "[", "\[Ellipsis]", "]"}]], "InlineFormula",
  ExpressionUUID->"f113aca1-d6a8-4574-baea-77017aa28978"],
 ") issues a ",
 Cell[BoxData[
  RowBox[{"TransposePartition", "::", "notpar"}]], "InlineFormula",
  ExpressionUUID->"59e5db50-d907-49b4-b092-211745caea8e"],
 " message and returns ",
 Cell[BoxData[
 "$Failed"], "InlineFormula",ExpressionUUID->
  "2e0b7dcd-79cd-4719-a569-37ae799b4660"],
 "."
}], "Notes",
 CellID->924238015,ExpressionUUID->"f1d9f91d-8d3e-4a74-b716-afb9a0717701"]
}, Open  ]],

