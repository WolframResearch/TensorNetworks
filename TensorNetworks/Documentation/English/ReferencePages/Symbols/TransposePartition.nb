   "2ce82d0f-1ea6-4ace-8347-fc6b4f5b094e"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->159455405,ExpressionUUID->"04b5793a-5951-4162-8ca3-f6ec9ae2ca62"],

Cell["\<\
The hook-length formula gives the same irrep dimension for a partition and \
its conjugate; HookFactor (the reciprocal product of hook lengths) is \
therefore conjugation-invariant:\
\>", "ExampleText",
 CellID->996187992,ExpressionUUID->"353effc8-d7c1-466a-9ff5-2e87d8be11a6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HookFactor", "[", 
    RowBox[{"{", 
     RowBox[{"4", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}], ",", " ", 
   RowBox[{"HookFactor", "[", 
    RowBox[{"TransposePartition", "[", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->180694541,ExpressionUUID->"15dc9638-2755-4bc2-b572-e03c52c6925e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", "144"], ",", 
   FractionBox["1", "144"]}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->814664892,ExpressionUUID->"020b0db5-4b32-425b-b378-a15a30374e03"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "c8382da4-3cb2-464b-807a-3823788aa096"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->389238327,ExpressionUUID->"1986a82b-0221-42fc-8b28-74eee726471d"],

Cell["\<\
HookLengths internally relies on TransposePartition to compute the leg of \
each hook; the two hook-length tables for a partition and its conjugate are \
related by transposition and agree as multisets:\
\>", "ExampleText",
 CellID->590522952,ExpressionUUID->"7245ade2-8be1-4ec2-87ec-aa87172d5248"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{"HookLengths", "[", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}], "]"}], "]"}],
   " ", "===", " ", 
  RowBox[{"Sort", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{"HookLengths", "[", 
     RowBox[{"TransposePartition", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "2", ",", " ", "1"}], "}"}], "]"}], "]"}], 
    "]"}], "]"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->323723701,ExpressionUUID->"fcad3b93-7dad-43c4-81c0-68e9d183e0b2"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]=",
 CellID->689622689,ExpressionUUID->"124fd398-d64d-4b8a-8527-41b70cd564d1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "\t", "ExampleDelimiter",ExpressionUUID->
   "f024c826-47c0-442b-94e6-4a17949ee28b"],
  $Line = 0; Null]], "ExampleDelimiter",
 CellID->846167594,ExpressionUUID->"3778bb70-2720-4ae8-b922-458c14666635"],

