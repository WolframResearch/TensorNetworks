Notebook[{

Cell[CellGroupData[{
Cell["PathQ", "ObjectName",
 CellID->420010001,ExpressionUUID->"e92afdc9-29a9-4cdb-ba91-db13d8513527"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"abaa24d3-1f94-46a3-a014-d3014a471ce7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PathQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathQ"], "[", 
   StyleBox["path", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3f5d3ff5-8954-4a1a-9e37-b002cda2a050"],
 "\[LineSeparator]yields ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "42002000-1aaa-abbb-bccc-caaaaaaaaaaa"],
 " if ",
 Cell[BoxData[
  StyleBox["path", "TI"]], "InlineFormula",ExpressionUUID->
  "42002000-2aaa-abbb-bccc-caaaaaaaaaaa"],
 " is a list whose elements are either ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["i", "TI"], "}"}]], "InlineFormula",ExpressionUUID->
  "42002000-3aaa-abbb-bccc-caaaaaaaaaaa"],
 " (singleton) or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "42002000-4aaa-abbb-bccc-caaaaaaaaaaa"],
 " (pair) integer lists, and ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "42002000-5aaa-abbb-bccc-caaaaaaaaaaa"],
 " otherwise."
}], "Usage",
 CellID->420010002,ExpressionUUID->"9fa504f2-0967-4282-b5f6-c593e20fe7da"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["PathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathQ"]], "InlineFormula",
  ExpressionUUID->"42003000-1aaa-abbb-bccc-caaaaaaaaaaa"],
 " returns ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "42003000-2aaa-abbb-bccc-caaaaaaaaaaa"],
 " for any nonempty list whose every element matches the pattern ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"_", "Integer"}], "}"}], "|", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"_", "Integer"}], ",", 
     RowBox[{"_", "Integer"}]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "42003000-3aaa-abbb-bccc-caaaaaaaaaaa"],
 ". Both forms are valid because the contraction-path utilities accept either \
linear paths (all pairs, ",
 Cell[BoxData[
  ButtonBox["CanonicalPathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPathQ"]], 
  "InlineFormula",ExpressionUUID->"42003000-4aaa-abbb-bccc-caaaaaaaaaaa"],
 ") or paths interleaved with singleton ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["i", "TI"], "}"}]], "InlineFormula",ExpressionUUID->
  "42003000-5aaa-abbb-bccc-caaaaaaaaaaa"],
 " markers that record a tensor's presence without contracting it."
}], "Notes",
 CellID->420010003,ExpressionUUID->"d43f25f1-572b-4903-bf07-12d4b6447161"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["PathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathQ"]], "InlineFormula",
  ExpressionUUID->"42003010-1aaa-abbb-bccc-caaaaaaaaaaa"],
 " is the looser of the path predicates. For the strict canonical form (every \
element is a pair in opt_einsum convention), use ",
 Cell[BoxData[
  ButtonBox["CanonicalPathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPathQ"]], 
  "InlineFormula",ExpressionUUID->"42003010-2aaa-abbb-bccc-caaaaaaaaaaa"],
 ". For the nested-tree form, use ",
 Cell[BoxData[
  ButtonBox["TreePathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TreePathQ"]], 
  "InlineFormula",ExpressionUUID->"42003010-3aaa-abbb-bccc-caaaaaaaaaaa"],
 "."
}], "Notes",
 CellID->420010004,ExpressionUUID->"42003010-4aaa-abbb-bccc-caaaaaaaaaaa"],

Cell[TextData[{
 "Both linear (canonical) and tree-fragment paths satisfy ",
 Cell[BoxData[
  ButtonBox["PathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathQ"]], "InlineFormula",
  ExpressionUUID->"42003020-1aaa-abbb-bccc-caaaaaaaaaaa"],
 ", which makes it the right input check for utilities that accept either \
form, such as ",
 Cell[BoxData[
  ButtonBox["CanonicalPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPath"]], 
  "InlineFormula",ExpressionUUID->"42003020-2aaa-abbb-bccc-caaaaaaaaaaa"],
 ", ",
 Cell[BoxData[
  ButtonBox["PathToTreePath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathToTreePath"]], 
  "InlineFormula",ExpressionUUID->"42003020-3aaa-abbb-bccc-caaaaaaaaaaa"],
 ", and ",
 Cell[BoxData[
  ButtonBox["PathIndexContractions",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathIndexContractions"]], 
  "InlineFormula",ExpressionUUID->"42003020-4aaa-abbb-bccc-caaaaaaaaaaa"],
 "."
}], "Notes",
 CellID->420010005,ExpressionUUID->"42003020-5aaa-abbb-bccc-caaaaaaaaaaa"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["PathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathQ"]], "InlineFormula",
  ExpressionUUID->"42003030-1aaa-abbb-bccc-caaaaaaaaaaa"],
 " returns ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "42003030-2aaa-abbb-bccc-caaaaaaaaaaa"],
 " for the empty list ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "42003030-3aaa-abbb-bccc-caaaaaaaaaaa"],
 " (the underlying pattern ",
 Cell[BoxData["..."], "InlineFormula",ExpressionUUID->
  "42003030-4aaa-abbb-bccc-caaaaaaaaaaa"],
 " requires at least one element), and for anything else not matching the \
pattern: bare integers, symbolic entries, lists of triples, or non-list \
inputs."
}], "Notes",
 CellID->420010006,ExpressionUUID->"42003030-5aaa-abbb-bccc-caaaaaaaaaaa"]
}, Open  ]],

