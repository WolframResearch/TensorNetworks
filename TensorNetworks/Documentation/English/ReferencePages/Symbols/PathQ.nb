  RowBox[{"safeCanonicalize", "[", "p_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"PathQ", "[", "p", "]"}], ",", 
    RowBox[{"CanonicalPath", "[", "p", "]"}], ",", 
    RowBox[{"Missing", "[", "\"\<NotAPath\>\"", "]"}]}], "]"}]}]], "Input",
