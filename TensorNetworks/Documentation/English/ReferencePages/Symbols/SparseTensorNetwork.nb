Cell[CellGroupData[{
Cell["SparseTensorNetwork", "ObjectName",
 CellID->100000296,ExpressionUUID->"2855d646-b642-4c28-a6d5-62f95b902cb4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d0c5b47b-dbc3-478c-b6f0-5c4f0382775f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SparseTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/SparseTensorNetwork"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "4afd932a-3744-4b77-ad66-18169ed45f46"],
 "\[LineSeparator]returns a tensor network with every rank-",
 Cell[BoxData[
  RowBox[{">", " ", "0"}]], "InlineFormula",ExpressionUUID->
  "459e7f20-4d87-40ac-868d-0dde4021be77"],
 " tensor of ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "f5e8a427-21b1-4d5d-971d-1f84c87301b5"],
 " converted to a ",
 Cell[BoxData[
  ButtonBox["SparseArray",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/SparseArray"]], "InlineFormula",ExpressionUUID->
  "0914efc2-152b-40ff-9c60-06154eb424d9"],
 "."
}], "Usage",
 CellID->100000005,ExpressionUUID->"6ca7dd3d-b9f3-4675-aaaf-29a78327eb45"],

Cell[TextData[{
 "Rank-0 tensors (scalars) are preserved as-is\[LongDash]",
 Cell[BoxData[
  ButtonBox["SparseArray",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/SparseArray"]], "InlineFormula",ExpressionUUID->
  "e07295cc-513d-4790-b5e3-5fc3b8c7fc80"],
 " is not applied to them."
}], "Notes",
 CellID->100000008,ExpressionUUID->"6ecafa48-c4d9-4171-be01-19644086af15"],

Cell["\<\
The hyperedges and the output specification of the input network are \
preserved unchanged.\
\>", "Notes",
 CellID->100000010,ExpressionUUID->"2f33fd05-96fc-464b-b8d4-5631ad24ca73"],

Cell[TextData[{
 "The dual property form is ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<SparseQ\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"61e59da0-f66c-4f69-a0b5-27f7ed825132"],
 ", a predicate testing whether every tensor of ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "98d3cb9a-fcfa-4c2d-bba6-f809efbd30f3"],
 " is already a ",
 Cell[BoxData[
  ButtonBox["SparseArray",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/SparseArray"]], "InlineFormula",ExpressionUUID->
  "3967261c-ec27-4da7-905a-df01f67c06b6"],
 "; ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["SparseTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/SparseTensorNetwork"], "[", 
   StyleBox["tn", "TI"], "]", "[", "\"\<SparseQ\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"66bc3072-30dd-480e-9ec0-37b101ba5f7c"],
 " is always ",
 Cell[BoxData[
 "True"], "InlineFormula",ExpressionUUID->
  "e6918dd2-d73c-4550-8a38-21c552af653a"],
 "."
}], "Notes",
 CellID->100000017,ExpressionUUID->"a01748bd-3e32-4da4-8149-bda167f1595f"],

Cell[TextData[{
 "All paclet operations (",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"e3824c82-e67a-44d8-9ac9-7095a3499652"],
 ", path finders, and so on) work transparently on sparse-stored networks; \
choose ",
 Cell[BoxData[
  ButtonBox["SparseArray",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/SparseArray"]], "InlineFormula",ExpressionUUID->
  "795cd37b-f526-432b-af07-983df9e2f59a"],
 " storage for memory savings when most tensor entries are zero."
}], "Notes",
 CellID->100000021,ExpressionUUID->"9883447a-957d-43f4-a94f-c347d2dc81f8"]
}, Open  ]],

