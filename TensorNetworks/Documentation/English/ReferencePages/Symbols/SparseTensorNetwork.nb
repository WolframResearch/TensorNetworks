Cell["\<\
The contracted result is identical (numerically) to the contraction of the \
dense network:\
\>", "ExampleText",
 CellID->100000195,ExpressionUUID->"1a2f580b-5cd4-4b03-a4e4-1fdfa08f4f29"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"TensorNetworkContract", "[", "spm", "]"}], " ", "==", " ", 
  RowBox[{"TensorNetworkContract", "[", "mps", "]"}]}]], "Input",
 CellLabel->"In[100000197]:=",
 CellID->100000198,ExpressionUUID->"296f0bab-01b2-4bbc-aaed-9446d36c258e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[100000200]=",
 CellID->100000201,ExpressionUUID->"4385b6b1-9bfb-4dfc-b03a-27f5f96bcdef"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "c8869a92-611a-47be-8b4d-b336f50ed713"],
  $Line = 0; Null]], "ExampleSection",
 CellID->100000203,ExpressionUUID->"defcddac-add9-486f-a73e-3d543db94d95"],

Cell["\<\
The dual property form is the SparseQ predicate, which tests whether every \
tensor of a network is a SparseArray:\
\>", "ExampleText",
 CellID->100000205,ExpressionUUID->"9a5910d8-5bd3-4de7-8c1e-f7e5489a58fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", "[", "\"\<SparseQ\>\"", "]"}]], "Input",
 CellLabel->"In[100000207]:=",
 CellID->100000208,ExpressionUUID->"b987b7fc-54e5-45e9-941c-27a0e0fb290e"],

Cell[BoxData["False"], "Output",
 CellLabel->"Out[100000210]=",
 CellID->100000211,ExpressionUUID->"c3148a86-4a70-42ba-8ef9-921db3e1d3d0"]
}, Open  ]],

Cell["After SparseTensorNetwork, the predicate returns True:", "ExampleText",
 CellID->100000213,ExpressionUUID->"5bd69ed7-8b5a-477a-8da5-9eeb01eb6dd3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SparseTensorNetwork", "[", "tn", "]"}], "[", "\"\<SparseQ\>\"", 
  "]"}]], "Input",
 CellLabel->"In[100000215]:=",
 CellID->100000216,ExpressionUUID->"28a83496-de19-485e-8d70-f8d4d2b35f40"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[100000218]=",
 CellID->100000219,ExpressionUUID->"56ae941e-baa8-4088-a19c-90f316ca2f5e"]
}, Open  ]],

Cell["\<\
Internally, SparseTensorNetwork maps SparseArray over every rank > 0 tensor; \
the construction is equivalent to:\
\>", "ExampleText",
 CellID->100000221,ExpressionUUID->"93d59773-e40c-4af5-8b27-068092afd750"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{"SparseArray", " ", "/@", " ", 
     RowBox[{"tn", "[", "\"\<Tensors\>\"", "]"}]}], ",", " ", 
    RowBox[{"tn", "[", "\"\<Hyperedges\>\"", "]"}], ",", " ", 
    RowBox[{"tn", "[", "\"\<Output\>\"", "]"}]}], "]"}], " ", "===", " ", 
  RowBox[{"SparseTensorNetwork", "[", "tn", "]"}]}]], "Input",
 CellLabel->"In[100000223]:=",
 CellID->100000224,ExpressionUUID->"16905a48-21b8-4326-8451-4c9e23b6fb76"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[100000226]=",
 CellID->100000227,ExpressionUUID->"36da28d8-b731-41a0-886a-fcec604a8420"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Possible Issues", "ExampleSection",ExpressionUUID->
   "5169241a-fe61-4cf6-bef5-4cbb56c877a6"],
  $Line = 0; Null]], "ExampleSection",
 CellID->100000229,ExpressionUUID->"8e516183-86f5-440c-a378-651b5091e87b"],

Cell["\<\
SparseArray storage is a memory win only when most entries of a tensor are \
zero. For small dense tensors, the SparseArray container itself can be larger \
than the original packed array:\
\>", "ExampleText",
 CellID->100000231,ExpressionUUID->"bd45fdb7-5534-4cb4-9821-126444b47ec2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dense", " ", "=", " ", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], " "}]], "Input",\

 CellLabel->"In[100000233]:=",
 CellID->100000234,ExpressionUUID->"83e0e7b6-0f02-404f-b836-12f5a0d5846d"],

Cell["Compare ByteCount of the dense and sparse forms:", "ExampleText",
 CellID->100000236,ExpressionUUID->"f31f9678-c922-4b20-b0c9-c1edcc3e8ed7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ByteCount", "[", "dense", "]"}], ",", " ", 
   RowBox[{"ByteCount", "[", 
    RowBox[{"SparseArray", "[", "dense", "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[100000238]:=",
 CellID->100000239,ExpressionUUID->"397ef1c4-caa5-496a-8351-b13f5cf468ed"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"208", ",", "728"}], "}"}]], "Output",
 CellLabel->"Out[100000241]=",
 CellID->100000242,ExpressionUUID->"e7e95a03-aef4-4553-b36c-2655ffb27572"]
}, Open  ]],

Cell["\<\
A correspondingly sized dense-with-all-nonzero tensor network grows in size \
after conversion to sparse storage, and contraction operations on it may run \
more slowly than on the original packed tensors:\
\>", "ExampleText",
 CellID->100000244,ExpressionUUID->"78ce31f4-1e55-4307-a5b0-8c1b62e2e6b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ByteCount", "[", 
    RowBox[{"TensorNetwork", "[", 
     RowBox[{
      RowBox[{"{", "dense", "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "}"}]}], "]"}], "]"}], ",", " ", 
   
   RowBox[{"ByteCount", "[", 
    RowBox[{"SparseTensorNetwork", "[", 
     RowBox[{"TensorNetwork", "[", 
      RowBox[{
       RowBox[{"{", "dense", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], "}"}]}], "]"}], "]"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[100000246]:=",
 CellID->100000247,ExpressionUUID->"b18c98f3-d840-4375-a650-f1202139cd3f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"456", ",", "976"}], "}"}]], "Output",
 CellLabel->"Out[100000249]=",
 CellID->100000250,ExpressionUUID->"027c5dc4-901a-482b-8312-a3914ec08b11"]
}, Open  ]],

Cell["\<\
Use SparseTensorNetwork when most tensor entries are zero or structurally \
sparse \[Dash] for example, tensors produced by symbolic constructions like \
SymbolicDeltaProductArray or by quantum-circuit gate decompositions \[Dash] \
not for dense numerical data.\
\>", "ExampleText",
 CellID->100000252,ExpressionUUID->"e69b2e20-5f3d-4aad-b65b-8d3e999d43dc"]
}, Open  ]],

