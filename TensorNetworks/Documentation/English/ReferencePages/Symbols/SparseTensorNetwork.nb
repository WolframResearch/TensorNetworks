Cell["\<\
Construct a tensor network with two dense tensors and convert it to a \
sparse-stored tensor network:\
\>", "ExampleText",
 CellID->100000059,ExpressionUUID->"7ad22bfb-bdd7-4ad9-bf92-fcc5eaf40c6f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", " ", "B"}], "}"}], " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}]}], ";"}], 
  " "}]], "Input",
 CellLabel->"In[100000056]:=",
 CellID->100000057,ExpressionUUID->"f9fc7b68-32e3-4ac0-8aff-0f5e2bd0aa04"],

