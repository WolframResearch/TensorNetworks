Cell["Check if an expression is a valid tensor network:", "ExampleText",
 CellID->580001001,ExpressionUUID->"580001001-q-text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tn", "=",
   RowBox[{"TensorNetwork", "[",
    RowBox[{
     RowBox[{"{",
      RowBox[{
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
       RowBox[{"RandomReal", "[",
        RowBox[{
         RowBox[{"{",
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
     RowBox[{"{",
      RowBox[{
       RowBox[{"{",
        RowBox[{"i", ",", "j"}], "}"}], ",",
       RowBox[{"{",
        RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->580001002,ExpressionUUID->"580001002-q-input1"],

Cell[BoxData[
 RowBox[{"TensorNetworkQ", "[", "tn", "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->580001003,ExpressionUUID->"580001003-q-input2"],

