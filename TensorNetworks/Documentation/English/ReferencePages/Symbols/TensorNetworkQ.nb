Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b204d95f-be00-4e8c-a48a-5134a53343b7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetworkQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkQ"], "[", 
   StyleBox["tn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "078a6f1e-bbce-4ed7-af0a-619ae24edfab"],
 "\[LineSeparator]yields ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "d6173fba-37a0-45c7-b9e3-4f95ca632407"],
 " if ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "11dd6fcf-4c58-4056-8b05-729454e37e27"],
 " is a valid ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"9501f934-5657-4a66-ac76-a61fbd8a99a3"],
 " object, and ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "4709dbe1-d070-4555-9de2-2f106cbed8b3"],
 " otherwise."
}], "Usage",
 CellID->390392795,ExpressionUUID->"e1ea5de1-5454-4788-bb36-ae219bbfe556"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetworkQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkQ"]], 
  "InlineFormula",ExpressionUUID->"e4ac2b86-b7b6-480c-b290-b0b375317f9d"],
 " returns ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "cfb809f3-b773-463d-88d6-ee43417e6fb8"],
 " only when the head of ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "a50096f8-dc94-4afc-968c-3392cb1b7a8d"],
 " is ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"a4dc6402-1ee0-4085-bac0-82b425f2a407"],
 " and its tensors, hyperedges, and output specification are internally \
consistent; any other head yields ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/False"]], "InlineFormula",ExpressionUUID->
  "00dcaa3f-6e55-4db0-be4c-fdbfda1fb162"],
 "."
}], "Notes",
 CellID->983073008,ExpressionUUID->"6bd46d1e-d83c-41dc-ab78-8650f96f6f98"],

Cell[TextData[{
 "Internal consistency requires three conditions on a ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"3b6c7bc3-f09d-4082-8956-0a240f279bb5"],
 "[",
 Cell[BoxData[
  StyleBox["tensors", "TI"]], "InlineFormula",ExpressionUUID->
  "c3a3639e-4297-4697-8005-131b6f76d0ef"],
 ", ",
 Cell[BoxData[
  StyleBox["hyperedges", "TI"]], "InlineFormula",ExpressionUUID->
  "7761be6b-a14f-497c-9c24-cbda42392c57"],
 ", ",
 Cell[BoxData[
  StyleBox["output", "TI"]], "InlineFormula",ExpressionUUID->
  "264df400-5e30-41e0-aeb2-a44954ceae63"],
 "] expression: the length of ",
 Cell[BoxData[
  StyleBox["tensors", "TI"]], "InlineFormula",ExpressionUUID->
  "937e5612-9e3c-40b9-940e-b5be02cc9005"],
 " must equal the length of ",
 Cell[BoxData[
  StyleBox["hyperedges", "TI"]], "InlineFormula",ExpressionUUID->
  "2702481e-ed31-40d7-a19a-821c374a1d74"],
 "; each tensor's rank must equal the length of its hyperedge list; and every \
occurrence of a shared index must report the same dimension."
}], "Notes",
 CellID->963907769,ExpressionUUID->"957a2bd1-e387-44a2-8cca-a414d8241bcd"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["output", "TI"]], "InlineFormula",ExpressionUUID->
  "6cd783ce-a9eb-4448-9fe5-dff94d7df20d"],
 " is not ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Automatic"]], "InlineFormula",ExpressionUUID->
  "7c84b68d-a5a5-499a-955c-556ed85bca33"],
 ", every entry of ",
 Cell[BoxData[
  StyleBox["output", "TI"]], "InlineFormula",ExpressionUUID->
  "f987fdda-d95f-4137-9b4b-dc9ccacbf74f"],
 " must also appear in some hyperedge."
}], "Notes",
 CellID->333931128,ExpressionUUID->"e58941f6-e3d6-47c8-ab9d-8038ba04f5fe"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetworkQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkQ"]], 
  "InlineFormula",ExpressionUUID->"f8a325fd-24da-4cf5-a5df-c01a65912951"],
 " caches the validation result via ",
 Cell[BoxData[
 "System`Private`HoldValidQ"], "InlineFormula",ExpressionUUID->
  "39401463-59cf-4223-a795-6cd76341eb83"],
 ": an unvalidated ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"7c73566e-1e78-4240-b426-b09f8f54a0ab"],
 "[\[Ellipsis]] expression is checked once on first evaluation; if the check \
passes, ",
 Cell[BoxData[
 "System`Private`HoldSetValid"], "InlineFormula",ExpressionUUID->
  "9ad0df4b-4d65-45de-983b-cc2207f89b27"],
 " marks the expression and ",
 Cell[BoxData[
 "System`Private`HoldSetNoEntry"], "InlineFormula",ExpressionUUID->
  "aa941d62-e5d4-42c7-b271-ceb1c573519a"],
 " freezes its argument slots, so subsequent calls short-circuit without \
re-validating."
}], "Notes",
 CellID->263307568,ExpressionUUID->"eec47f3c-fa15-45f2-bbde-2644aba77fc7"],

Cell[TextData[{
 "Property dispatch on a ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"b1f3612c-058e-437d-8490-1e2cfa63db94"],
 " object is guarded by ",
 Cell[BoxData[
  ButtonBox["TensorNetworkQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkQ"]], 
  "InlineFormula",ExpressionUUID->"12524123-af8d-4762-ab8c-802250cdcb8a"],
 ": ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Property\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"26ec3361-60fb-41d3-be3d-43766366b012"],
 " only evaluates when ",
 Cell[BoxData[
  StyleBox["tn", "TI"]], "InlineFormula",ExpressionUUID->
  "b08e097f-5643-40ec-ac3a-3b8e774aae6f"],
 " satisfies ",
 Cell[BoxData[
  ButtonBox["TensorNetworkQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkQ"]], 
  "InlineFormula",ExpressionUUID->"2530b2dd-7cfb-4d43-86c9-d597c7fd7a23"],
 ", so an invalid ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"c6e8436a-5071-4b4c-95bf-4851b5ee9563"],
 "[\[Ellipsis]] expression is left unevaluated rather than returning a wrong \
answer."
}], "Notes",
 CellID->839855718,ExpressionUUID->"a755409d-060d-4a15-b969-e6f548f48833"]
}, Open  ]],

