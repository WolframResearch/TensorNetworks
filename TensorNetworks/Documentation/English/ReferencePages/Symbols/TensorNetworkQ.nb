Cell["If the number of tensors does not match the number of hyperedge lists, the result is False:", "ExampleText",
 CellID->779564267,ExpressionUUID->"ac35140e-3040-4032-8cc7-d62d3d7aa014"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorNetworkQ", "[",
  RowBox[{"TensorNetwork", "[",
   RowBox[{
