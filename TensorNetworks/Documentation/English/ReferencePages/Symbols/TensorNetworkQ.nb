Cell["Test whether an expression is a valid tensor network:", "ExampleText",
 CellID->988078637,ExpressionUUID->"cad3d62d-4f00-4950-b419-5ef87cd4b08e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  "TensorNetworkQ", "[",
  RowBox[{
   "TensorNetwork", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{
      RowBox[{"RandomReal", "[",
       RowBox[{
        RowBox[{"{",
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"2", ",", "3"}], "}"}]}], "]"}], ",",
      RowBox[{"RandomReal", "[",
       RowBox[{
        RowBox[{"{",
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",",
    RowBox[{"{",
     RowBox[{
      RowBox[{"{",
       RowBox[{"i", ",", "j"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"j", ",", "k"}], "}"}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->398765340,ExpressionUUID->"72f00827-a9f8-46c8-8148-e09ca4416fbe"],

