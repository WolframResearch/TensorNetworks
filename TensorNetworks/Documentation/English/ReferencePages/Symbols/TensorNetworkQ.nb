Cell["Use TensorNetworkQ as a gate so downstream operations only see valid networks:", "ExampleText",
 CellID->835409861,ExpressionUUID->"16d773f1-3a17-4d9e-896f-05953faf040e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"safeContractCount", "[", "net_", "]"}], ":=",
   RowBox[{"If", "[",
    RowBox[{
     RowBox[{"TensorNetworkQ", "[", "net", "]"}], ",",
     RowBox[{"Length", "[",
      RowBox[{"net", "[", "\"\<Tensors\>\"", "]"}], "]"}], ",", "$Failed"}], "]"}]}], ";", "\[IndentingNewLine]",
  RowBox[{"{",
   RowBox[{
    RowBox[{"safeContractCount", "[",
     RowBox[{"TensorNetwork", "[",
      RowBox[{"{",
       RowBox[{
        RowBox[{"{",
         RowBox[{"i", ",", "j"}], "}"}], ",",
        RowBox[{"{",
         RowBox[{"j", ",", "k"}], "}"}]}], "}"}], "]"}], "]"}], ",",
    RowBox[{"safeContractCount", "[",
     RowBox[{"{",
      RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:=",
 CellID->758303364,ExpressionUUID->"d371fe48-d260-44f0-866b-9868853d7810"],

Cell[BoxData[
 RowBox[{"{", RowBox[{"2", ",", "$Failed"}], "}"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->676870184,ExpressionUUID->"995969f1-ad19-42c1-8476-ad13e473e223"]
}, Open]]
}, Open]],

