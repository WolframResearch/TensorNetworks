       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}], ",",
        " ", 
