\>", "ExampleText",
 CellID->164903114,ExpressionUUID->"38087115-788b-4e08-889b-6d8bccd20590"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauDimension", "[", 
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
