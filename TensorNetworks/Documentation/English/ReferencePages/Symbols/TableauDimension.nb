Notebook[{

Cell[CellGroupData[{
Cell["TableauDimension", "ObjectName",ExpressionUUID->"06f7982e-e06f-4bae-a09c-37628324e2e0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4ad0f765-88b5-4bf4-958d-b81d6616a640"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"], "[", 
   StyleBox["tableau", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "22498e27-43e9-4e17-a9fa-9519d3193520"],
 "\[LineSeparator]gives the dimension of the irreducible representation of \
the symmetric group corresponding to a Young ",
 StyleBox["tableau", " TI"],
 ", computed via the hook-length formula. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"67de4796-dad3-4f32-b90d-b38e489f64bb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"], "[", 
   StyleBox["partition", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "305cab2f-74c7-413e-96ca-79666682fb1f"],
 "\[LineSeparator]does the same when the input is a bare integer ",
 StyleBox["partition", "TI"],
 "."
}], "Usage",ExpressionUUID->"74905bba-0c69-4591-a92b-878236c0e6ff"],

Cell[TextData[{
 "The dimension of the irrep labeled by a partition ",
 Cell[BoxData[
  StyleBox["par", "TI"]], "InlineFormula",ExpressionUUID->
  "9fabecbd-7b2a-4c25-9920-4e16c74c8bcd"],
 " of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "abe092b4-ef80-4f6d-afb9-97315043f679"],
 " is given by the hook-length formula ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], "=", 
   FractionBox[
    RowBox[{
     StyleBox["n", "TI"], "!"}], 
    RowBox[{"\[Product]", 
     StyleBox["h", "TI"]}]]}]], "InlineFormula",ExpressionUUID->
  "f6a7dc5e-3b17-46d3-9acb-9d1879f0cabc"],
 ", where the product runs over the hook lengths ",
 Cell[BoxData[
  StyleBox["h", "TI"]], "InlineFormula",ExpressionUUID->
  "caecb1c7-cae7-4acb-9c30-e23802a0cd35"],
 " of the cells of the Young diagram of ",
 Cell[BoxData[
  StyleBox["par", "TI"]], "InlineFormula",ExpressionUUID->
  "3107c35b-e0b7-4980-83a4-7b04567818ab"],
 "."
}], "Notes",
 CellID->596523208,ExpressionUUID->"1eaf0572-a201-4cd0-a4ae-7d4c2d94ddca"],

Cell[TextData[{
 "Internally ",
 Cell[BoxData[
  ButtonBox["TableauDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"]], 
  "InlineFormula",ExpressionUUID->"c2d92a20-160b-4e62-9ffe-2defba940600"],
 " evaluates ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "!", "\[CenterDot]", 
   ButtonBox["HookFactor",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"], "[", 
   StyleBox["par", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "f163c4a5-432d-446d-95cc-cd585ba62d35"],
 " using the Frobenius determinant form, which is ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"\[ScriptCapitalO]", "\[ThinSpace]", 
    RowBox[{"(", "r", ")"}]}], "3"]], "InlineFormula",ExpressionUUID->
  "591ec68c-5f08-414a-97cb-c575129426e1"],
 " in the number of rows ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",ExpressionUUID->
  "5a7312fc-aefb-4137-beea-4ce6983b029e"],
 " of the partition. This is faster than the naive ",
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"\[ScriptCapitalO]", "\[ThinSpace]", 
    RowBox[{"(", "n", ")"}]}], "2"]], "InlineFormula",ExpressionUUID->
  "7d55c873-01ab-487b-a3f4-2107ff790162"],
 " evaluation that explicitly forms every hook length, especially for \
partitions with few rows but many boxes."
}], "Notes",
 CellID->798188130,ExpressionUUID->"e746c332-8913-4943-98db-5620213dc599"],

Cell[TextData[{
 "The single-row partition ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["n", "TI"], "}"}]], "InlineFormula",ExpressionUUID->
  "21f28ae9-4d81-4b58-bbd2-701889cba462"],
 " labels the fully symmetric (trivial) irrep and the single-column partition \
",
 Cell[BoxData[
  RowBox[{"{", "1", ",", "\[Ellipsis]", ",", "1", "}"}]], "InlineFormula",
  ExpressionUUID->"ea7dd80c-2bf5-49d4-9049-f37e37b2c0e2"],
 " labels the fully antisymmetric (sign) irrep; both are one-dimensional. \
Mixed shapes give the intermediate Specht-module dimensions."
}], "Notes",
 CellID->835444725,ExpressionUUID->"320e4da9-76f6-47ca-b1dc-3fafc6fa8f6b"],

Cell[TextData[{
 "Summing the squared dimensions over all partitions of ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "5eb64330-729d-4b67-ab2e-91431e192e2b"],
 " recovers the order of the symmetric group: ",
 Cell[BoxData[
  RowBox[{
   UnderscriptBox["\[Sum]", 
    StyleBox["par", "TI"]], 
   SuperscriptBox[
    RowBox[{
     ButtonBox["TableauDimension",
      BaseStyle->"Link",
      ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"], "[", 
     
     StyleBox["par", "TI"], "]"}], "2"], "=", 
   RowBox[{
    StyleBox["n", "TI"], "!"}]}]], "InlineFormula",ExpressionUUID->
  "16a3d148-3619-4587-bd5d-3f66d10334e5"],
 "."
}], "Notes",
 CellID->513499135,ExpressionUUID->"eee8ab17-980b-4ed5-ae65-b1a501e73487"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"], "[", 
   StyleBox["yt", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "fd13bddc-dfcb-4929-8679-4f0b04a80b8f"],
 " is shorthand for ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["TableauDimension",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"], "[", 
   ButtonBox["TableauShape",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"], "[", 
   StyleBox["yt", "TI"], "]", "]"}]], "InlineFormula",ExpressionUUID->
  "df957a6d-5215-4095-aa94-8d6186a8395a"],
 ": the dimension depends only on the shape of the tableau, never on how the \
boxes are filled."
}], "Notes",
 CellID->268403321,ExpressionUUID->"d8aa7c25-64fa-41d2-897c-85725c7cd57e"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TableauDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"]], 
  "InlineFormula",ExpressionUUID->"d15041df-c4f8-4afe-8708-1b013a61f025"],
 " returns ",
 Cell[BoxData[
  ButtonBox["$Failed",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$Failed"]], "InlineFormula",ExpressionUUID->
  "8b19acad-a205-43f1-b9a7-8910493a95f4"],
 " and emits ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"TableauDimension", "::", "noyt"}], "MR"]], "InlineFormula",
  ExpressionUUID->"23f1056c-4669-49c6-a81b-c347b4f81f07"],
 " when given anything other than a Young tableau or an integer partition (a \
list of weakly decreasing positive integers)."
}], "Notes",
 CellID->57461719,ExpressionUUID->"da21cf5f-c119-4be2-9753-2714a3f1cadd"]
}, Open  ]],

