Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7684a28f-33ca-4e27-a637-6d14351eef72"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorJoin",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/TensorJoin"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["i\:2081", "TI"], ",", 
      StyleBox["i\:2082", "TI"], ",", "\[Ellipsis]"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"A\:2081", ",", "A\:2082", ",", "\[Ellipsis]"}], "}"}]}], "]"}]],
   "InlineFormula",ExpressionUUID->"1a2dba85-baf6-4f29-b947-89fcb7bcdffc"],
 "\[LineSeparator]joins tensors over shared indices, broadcasting along \
non-shared dimensions. \[Bullet] Returns {indices, tensor} where tensor is \
the joined result padded appropriately."
}], "Usage",
