            RowBox[{"Subscript", "[", 
             RowBox[{"1", ",", " ", "1"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
        
        RowBox[{"DirectedEdge", "[", 
         RowBox[{"1", ",", " ", "2", ",", " ", 
          RowBox[{"{", 
