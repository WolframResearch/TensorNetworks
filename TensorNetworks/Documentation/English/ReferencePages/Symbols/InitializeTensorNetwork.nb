Cell["\<\
Build a small open chain whose left boundary is a placeholder stub at vertex \
0:\
\>", "ExampleText",
 CellID->143633188,ExpressionUUID->"4abcc3fc-2e7e-484f-921d-c11004f22f68"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"chain", " ", "=", " ", 
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"DirectedEdge", "[", 
         RowBox[{"0", ",", " ", "1", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Superscript", "[", 
             RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"1", ",", " ", "1"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
        
        RowBox[{"DirectedEdge", "[", 
         RowBox[{"1", ",", " ", "2", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Superscript", "[", 
             RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"2", ",", " ", "1"}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",",
       " ", 
      RowBox[{"AnnotationRules", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<Tensor\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"0.", ",", " ", "0."}], "}"}]}], ",", " ", 
            RowBox[{"\"\<Index\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"Superscript", "[", 
               RowBox[{"0", ",", " ", "1"}], "]"}], "}"}]}], ",", " ", 
            RowBox[{"VertexLabels", " ", "->", " ", "\"\<Stub\>\""}]}], 
           "}"}]}], ",", " ", 
         RowBox[{"1", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<Tensor\>\"", " ", "->", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"1", ",", " ", 
               RowBox[{"{", 
                RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
            RowBox[{"\"\<Index\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"1", ",", " ", "1"}], "]"}], ",", " ", 
               RowBox[{"Superscript", "[", 
                RowBox[{"1", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
            RowBox[{"VertexLabels", " ", "->", " ", "1"}]}], "}"}]}], ",", 
         " ", 
         RowBox[{"2", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<Tensor\>\"", " ", "->", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"1", ",", " ", 
               RowBox[{"{", 
                RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ",", " ", 
            RowBox[{"\"\<Index\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"2", ",", " ", "1"}], "]"}], ",", " ", 
               RowBox[{"Superscript", "[", 
                RowBox[{"2", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
            RowBox[{"VertexLabels", " ", "->", " ", "2"}]}], "}"}]}]}], 
        "}"}]}]}], "]"}]}], ";"}], " "}]], "Input",
 CellLabel->"In[1]:=",
 CellID->764133012,ExpressionUUID->"98172321-cd12-43f3-87b1-3fc6528a060f"],

Cell["Close the boundary by binding a length-2 vector to the stub:", \
"ExampleText",
 CellID->135704287,ExpressionUUID->"4a923b49-be33-4b0c-a186-77f4d6c5de5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"init", " ", "=", " ", 
    RowBox[{"InitializeTensorNetwork", "[", 
     RowBox[{"chain", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.5", ",", " ", 
        RowBox[{"-", "0.3"}]}], "}"}]}], "]"}]}], ";"}], " "}]], "Input",
 CellLabel->"In[2]:=",
 CellID->572192140,ExpressionUUID->"8d2f35bb-79b0-4d79-85ef-2dcf9ab179c9"],

Cell["\<\
The new boundary vertex 0 carries the supplied tensor verbatim:\
\>", "ExampleText",
 CellID->914780573,ExpressionUUID->"43d7bc06-bf56-470d-ac34-aa51e97e3176"],

Cell[BoxData[
 RowBox[{"AnnotationValue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"init", ",", " ", "0"}], "}"}], ",", " ", "\"\<Tensor\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->610933894,ExpressionUUID->"3b35fd94-1f53-4517-a383-c624a33ce1c8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.5`", ",", 
   RowBox[{"-", "0.3`"}]}], "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->82190650,ExpressionUUID->"2acc990d-d460-4ffb-81b9-2a3e90a27380"],

Cell["\<\
Its default index list is {Superscript[0, 1], \[Ellipsis], Superscript[0, \
r]}, where r is the rank of the boundary tensor:\
\>", "ExampleText",
 CellID->833979767,ExpressionUUID->"21b37a20-63be-422a-9c37-0a5ff87c3290"],

Cell[BoxData[
 RowBox[{"AnnotationValue", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"init", ",", " ", "0"}], "}"}], ",", " ", "\"\<Index\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->480632566,ExpressionUUID->"c8e99898-7774-47f2-870c-158e3de5b126"],

Cell[BoxData[
 RowBox[{"{", 
  TemplateBox[{"0", "1"},
   "Superscript"], "}"}]], "Output",
 CellLabel->"Out[4]=",
 CellID->852922159,ExpressionUUID->"dfb87077-f971-4c83-a6a0-3501b15c76f8"],

Cell["\<\
The vertex carries the label \"Initial\", so it stands out in graph plots:\
\>", "ExampleText",
