Notebook[{

Cell[CellGroupData[{
Cell["InitializeTensorNetwork", "ObjectName",
 CellID->977864545,ExpressionUUID->"33f080b1-6aec-4ae9-bdd4-d18cca1e1928"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0b04d613-b534-4fd3-88f4-6889e9574086"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["InitializeTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/InitializeTensorNetwork"], 
   "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", 
    StyleBox["tensor", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3b1e32a8-459d-4817-bc30-fd612510500b"],
 "\[LineSeparator]rebinds the boundary of ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "10932123-7b03-4cc1-8875-1e7bdc1cc6bd"],
 " to a new vertex 0 annotated with ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "882454b9-f885-4025-a58b-a109070da040"],
 " and default ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Superscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Superscript"], "[", "0", ",", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ab42cdfb-40d0-4d8f-bced-b08045ff6893"],
 " indices.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2fb7c182-3042-4113-ad1a-ab77b9c9fd7c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["InitializeTensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/InitializeTensorNetwork"], 
   "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", 
    StyleBox["tensor", "TI"], ",", 
    StyleBox["indices", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8b658cdb-34e7-485c-aa2e-bff66f17cf1a"],
 "\[LineSeparator]uses the explicit index list ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "8265b55a-e684-4b0c-8c8a-9d513e950083"],
 " for the new vertex."
}], "Usage",
 CellID->675254042,ExpressionUUID->"71480ad6-0955-494e-8edb-a034ad68b102"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["InitializeTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/InitializeTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"65ba3b77-89bb-482b-badc-6a464a99cfa1"],
 " operates on the ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "0ddce123-bba9-4135-8426-faa3885981cd"],
 " form: its first argument must satisfy ",
 Cell[BoxData[
  ButtonBox["TensorNetworkGraphQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphQ"]], 
  "InlineFormula",ExpressionUUID->"ddd70d39-d6d2-4ed2-b8bb-97c1463b8a6e"],
 "."
}], "Notes",
 CellID->138529949,ExpressionUUID->"e9f113ef-9e97-4290-8ad8-1d7305972cd2"],

Cell[TextData[{
 "Every vertex of ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "f715f8e0-7510-4bbe-9bb4-02d10dd435a2"],
 " whose label is non-positive (",
 Cell[BoxData[
 "0"], "InlineFormula",ExpressionUUID->"3dd64998-7645-428d-ae81-37df6a2bafe0"],
 ", ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",ExpressionUUID->
  "4eabd3f2-2b21-422e-9e91-9096488e9bb6"],
 ", ",
 "\[Ellipsis]) is removed before the new boundary is attached. Each edge that \
previously emanated from such a vertex is re-routed from a fresh vertex ",
 Cell[BoxData[
 "0"], "InlineFormula",ExpressionUUID->"bf7e7e8b-395a-43e3-8eae-360670f08b78"],
 " with source slot ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Superscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Superscript"], "[", "0", ",", 
   StyleBox["k", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "17fe09fc-58d8-40bc-a4fd-7eba1b7a4775"],
 ", where ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "10e2c3d9-8dbb-4f98-babd-b7c7b40d8faf"],
 " enumerates the rerouted edges."
}], "Notes",
 CellID->196413196,ExpressionUUID->"f85c11db-ecb7-4956-bf5e-c3899758b0a8"],

Cell[TextData[{
 "The new vertex is annotated ",
 Cell[BoxData["\"\<Tensor\>\""], "InlineFormula",ExpressionUUID->
  "084c57ce-6a23-4ee8-b81a-130641df4a32"],
 " \[Rule] ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "15900d4d-39d3-43b1-849e-2aa2fcc75f11"],
 ", ",
 Cell[BoxData["\"\<Index\>\""], "InlineFormula",ExpressionUUID->
  "4c1bb0d2-9720-47a3-811c-078614a94ac0"],
 " \[Rule] ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "da242d1e-a63e-493b-a58c-84566d4fdf4a"],
 ", and ",
 Cell[BoxData[
  ButtonBox["VertexLabels",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/VertexLabels"]], "InlineFormula",ExpressionUUID->
  "a61d4d55-903d-4c9d-8222-d2e7253743a0"],
 " \[Rule] ",
 Cell[BoxData["\"\<Initial\>\""], "InlineFormula",ExpressionUUID->
  "7d9f847a-865f-4066-af58-ce06df742e6a"],
 " so it appears as a boundary in graph plots."
}], "Notes",
 CellID->998770550,ExpressionUUID->"1577f1c5-3147-432c-bdb3-8e7990e8eac1"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "59a8e345-2353-4ac0-87a9-46d95b026a2f"],
 " is ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Automatic"]], "InlineFormula",ExpressionUUID->
  "736ea504-4a3d-45f4-9db2-45cafd086e59"],
 " (the default), it is set to ",
 Cell[BoxData[
  RowBox[{"{", 
   ButtonBox["Superscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Superscript"], "[", "0", ",", "1", "]", ",", 
   ButtonBox["Superscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Superscript"], "[", "0", ",", "2", "]", ",", 
   "\[Ellipsis]", ",", 
   ButtonBox["Superscript",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Superscript"], "[", "0", ",", 
   StyleBox["r", "TI"], "]", "}"}]], "InlineFormula",ExpressionUUID->
  "6e96f1ed-cf0c-48cf-a7d7-65bbdf6a1f16"],
 ", where ",
 Cell[BoxData[
  StyleBox["r", "TI"]], "InlineFormula",ExpressionUUID->
  "b18c8692-070a-4a4d-b539-2ed7e9b73179"],
 " is the rank of ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "3a77e13c-99e1-4c65-a736-392640097fc5"],
 "."
}], "Notes",
 CellID->304042460,ExpressionUUID->"b3c40a89-7970-495e-bcc6-544caf926346"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["InitializeTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/InitializeTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"4b1d1d1b-bcb2-462e-bae2-ccc7a98ea99d"],
 " is the boundary-replacement counterpart of ",
 Cell[BoxData[
  ButtonBox["TensorNetworkAdd",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkAdd"]], 
  "InlineFormula",ExpressionUUID->"c9afbe51-01fe-448a-b9e8-5713b1d9b525"],
 ": it does not introduce a new tensor next to the existing ones but instead \
replaces whatever stub was previously bound at the boundary."
}], "Notes",
 CellID->552642500,ExpressionUUID->"789f6563-f679-43b1-98b2-51689dc1665b"],

Cell[TextData[{
 "Repeated calls leave the vertex and edge sets unchanged but replace the ",
 Cell[BoxData["\"\<Tensor\>\""], "InlineFormula",ExpressionUUID->
  "5ce89b0b-7f9c-430e-8ae2-a75b2c91b136"],
 " annotation of vertex ",
 Cell[BoxData[
 "0"], "InlineFormula",ExpressionUUID->"12c16e43-df3e-4491-875f-52fa49fff265"],
 ": ",
 Cell[BoxData[
  ButtonBox["InitializeTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/InitializeTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"92339e27-0a65-47dc-804d-f37ff9bc2b2f"],
 " is idempotent on graph structure and only changes the boundary data."
}], "Notes",
 CellID->116203495,ExpressionUUID->"93887511-4044-4ffa-a07d-99cb1b28edda"]
}, Open  ]],

