        RowBox[{"{", 
         RowBox[{"5.", ",", " ", "6.", ",", " ", "7.", ",", " ", "8."}], 
         "}"}]}], "}"}]}], "]"}]}], ";"}], " "}]], "Input",
 CellLabel->"In[1]:=",
