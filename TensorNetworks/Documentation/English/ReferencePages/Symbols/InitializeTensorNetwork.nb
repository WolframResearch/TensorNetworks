            RowBox[{"VertexLabels", " ", "->", " ", "1"}]}], "}"}]}], ",", 
         " ", 
         RowBox[{"2", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<Tensor\>\"", " ", "->", " ", 
