Cell[CellGroupData[{

Cell["Higher-rank boundary tensors", "ExampleSubsection",ExpressionUUID->"b898983b-a832-4cfc-8a6c-ad2bd0be556d"],

Cell["\<\
Two stub vertices feed two edges into the network; a rank-2 boundary tensor \
binds both at once and collapses them into the single new vertex 0:\
\>", "ExampleText",
 CellID->476782099,ExpressionUUID->"501c0e17-fce5-4c04-9b63-559e7ad140fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"twoStubs", " ", "=", " ", 
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", 
        RowBox[{"-", "2"}], ",", " ", "1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"DirectedEdge", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "1", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Superscript", "[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"1", ",", " ", "1"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
        
        RowBox[{"DirectedEdge", "[", 
         RowBox[{
          RowBox[{"-", "2"}], ",", " ", "2", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Superscript", "[", 
             RowBox[{
              RowBox[{"-", "2"}], ",", " ", "1"}], "]"}], ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"2", ",", " ", "2"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
        
        RowBox[{"DirectedEdge", "[", 
         RowBox[{"1", ",", " ", "2", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Superscript", "[", 
             RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"2", ",", " ", "1"}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",",
       " ", 
      RowBox[{"AnnotationRules", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<Tensor\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"0.", ",", " ", "0."}], "}"}]}], ",", " ", 
            RowBox[{"\"\<Index\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"Superscript", "[", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], "}"}]}], ",", " ", 
            RowBox[{"VertexLabels", " ", "->", " ", "\"\<Stub1\>\""}]}], 
           "}"}]}], ",", " ", 
         RowBox[{
          RowBox[{"-", "2"}], " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<Tensor\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"0.", ",", " ", "0.", ",", " ", "0.", ",", " ", "0."}], 
              "}"}]}], ",", " ", 
            RowBox[{"\"\<Index\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"Superscript", "[", 
               RowBox[{
                RowBox[{"-", "2"}], ",", " ", "1"}], "]"}], "}"}]}], ",", " ", 
            RowBox[{"VertexLabels", " ", "->", " ", "\"\<Stub2\>\""}]}], 
           "}"}]}], ",", " ", 
         RowBox[{"1", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<Tensor\>\"", " ", "->", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"1", ",", " ", 
               RowBox[{"{", 
                RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
            RowBox[{"\"\<Index\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"1", ",", " ", "1"}], "]"}], ",", " ", 
               RowBox[{"Superscript", "[", 
                RowBox[{"1", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
            RowBox[{"VertexLabels", " ", "->", " ", "1"}]}], "}"}]}], ",", 
         " ", 
         RowBox[{"2", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<Tensor\>\"", " ", "->", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"1", ",", " ", 
               RowBox[{"{", 
                RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ",", " ", 
            RowBox[{"\"\<Index\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"2", ",", " ", "1"}], "]"}], ",", " ", 
               RowBox[{"Subscript", "[", 
                RowBox[{"2", ",", " ", "2"}], "]"}]}], "}"}]}], ",", " ", 
            RowBox[{"VertexLabels", " ", "->", " ", "2"}]}], "}"}]}]}], 
        "}"}]}]}], "]"}]}], ";", " ", 
   RowBox[{"initTwo", " ", "=", " ", 
    RowBox[{"InitializeTensorNetwork", "[", 
