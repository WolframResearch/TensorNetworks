            RowBox[{"Superscript", "[", 
             RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"2", ",", " ", "1"}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",",
       " ", 
      RowBox[{"AnnotationRules", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", " ", "->", " ", 
