              RowBox[{"1", ",", " ", 
               RowBox[{"{", 
                RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ",", " ", 
            RowBox[{"\"\<Index\>\"", " ", "->", " ", 
