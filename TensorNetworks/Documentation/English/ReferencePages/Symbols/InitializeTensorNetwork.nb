Cell[CellGroupData[{

Cell["Default indices", "ExampleSubsection",ExpressionUUID->"59ea771b-90bd-4af4-a7db-6dbfc6d4532c"],

Cell["\<\
With no index argument, the new boundary vertex receives sequential \
Superscript[0, k] labels matching the tensor rank. Build a stub chain and \
pass only the boundary tensor:\
\>", "ExampleText",
 CellID->153185053,ExpressionUUID->"b233a473-d37c-4205-8021-fdc6b200b70e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"chain", " ", "=", " ", 
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"DirectedEdge", "[", 
         RowBox[{"0", ",", " ", "1", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Superscript", "[", 
             RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"1", ",", " ", "1"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
        
        RowBox[{"DirectedEdge", "[", 
         RowBox[{"1", ",", " ", "2", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Superscript", "[", 
             RowBox[{"1", ",", " ", "2"}], "]"}], ",", " ", 
            RowBox[{"Subscript", "[", 
             RowBox[{"2", ",", " ", "1"}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",",
       " ", 
      RowBox[{"AnnotationRules", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"0", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<Tensor\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"0.", ",", " ", "0."}], "}"}]}], ",", " ", 
            RowBox[{"\"\<Index\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"Superscript", "[", 
               RowBox[{"0", ",", " ", "1"}], "]"}], "}"}]}], ",", " ", 
            RowBox[{"VertexLabels", " ", "->", " ", "\"\<Stub\>\""}]}], 
           "}"}]}], ",", " ", 
         RowBox[{"1", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<Tensor\>\"", " ", "->", " ", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"1", ",", " ", 
               RowBox[{"{", 
                RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
            RowBox[{"\"\<Index\>\"", " ", "->", " ", 
