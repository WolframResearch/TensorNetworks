Cell[CellGroupData[{

Cell["ToTensorNetworkGraph does not create stubs automatically", \
"ExampleSubsection",ExpressionUUID->"d6a01f70-069e-4ccf-8358-835d34cca7d5"],

Cell["\<\
The hyperedge form of ToTensorNetworkGraph records free indices on the \
existing vertices but does not introduce a boundary stub vertex. A stub must \
be attached manually before InitializeTensorNetwork can be called:\
\>", "ExampleText",
 CellID->97860561,ExpressionUUID->"09854497-12e3-4f83-8ce6-85dde0f76bea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"noStub", " ", "=", " ", 
   RowBox[{"ToTensorNetworkGraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "k"}], "}"}]}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"VertexList", "[", "noStub", "]"}], ",", " ", 
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"VertexList", "[", "noStub", "]"}], ",", " ", 
      RowBox[{"_", "?", "NonPositive"}]}], "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:=",
