Notebook[{

Cell[CellGroupData[{
Cell["TreePathToPath", "ObjectName",
 CellID->853854265,ExpressionUUID->"2119845e-ac91-47a9-ab65-8ba5bcf4638a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cc93d2cb-6ce1-42ec-875c-1ebf30e4f7b0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TreePathToPath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TreePathToPath"], "[", 
   StyleBox["treePath", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "358d7036-a017-41d6-88dd-ce210b24706e"],
 "\[LineSeparator]converts the tree-structured contraction ",
 Cell[BoxData[
  StyleBox["treePath", "TI"]], "InlineFormula",ExpressionUUID->
  "a1010101-0000-0000-0000-000000000001"],
 " to a linear (pairwise) path representation.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a1010101-0000-0000-0000-000000000002"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TreePathToPath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TreePathToPath"], "[", 
   RowBox[{
    StyleBox["treePath", "TI"], ",", 
    StyleBox["indices", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a1010101-0000-0000-0000-000000000003"],
 "\[LineSeparator]uses the explicit ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "a1010101-0000-0000-0000-000000000004"],
 " list to label the tree's leaves."
}], "Usage",
 CellChangeTimes->{3.978638309794592*^9},
 CellID->1242902601,ExpressionUUID->"e34bb88c-30ea-4a4b-8d8d-bd2526bda980"],

Cell[TextData[{
 "The output follows the opt_einsum convention: a list of integer pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], "}"}], ",", "\[Ellipsis]"}], "}"}]], 
  "InlineFormula",ExpressionUUID->"a1010102-0000-0000-0000-000000000001"],
 " where each step removes the tensors at positions ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "a1010102-0000-0000-0000-000000000002"],
 ", ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "a1010102-0000-0000-0000-000000000003"],
 " from the working list and appends their contraction at the end."
}], "Notes",
 CellID->890580638,ExpressionUUID->"01d5eebb-e6cd-4068-b99f-0537e724364d"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TreePathToPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TreePathToPath"]], 
  "InlineFormula",ExpressionUUID->"a1010103-0000-0000-0000-000000000001"],
 " is the inverse of ",
 Cell[BoxData[
  ButtonBox["PathToTreePath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathToTreePath"]], 
  "InlineFormula",ExpressionUUID->"a1010103-0000-0000-0000-000000000002"],
 ". On canonical inputs the round-trip ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["PathToTreePath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/PathToTreePath"], "@", 
   ButtonBox["TreePathToPath",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TreePathToPath"]}]], 
  "InlineFormula",ExpressionUUID->"a1010103-0000-0000-0000-000000000003"],
 " is the identity."
}], "Notes",
 CellID->650100001,ExpressionUUID->"a1010103-0000-0000-0000-000000000004"],

Cell[TextData[{
 "Internally, ",
 Cell[BoxData[
  ButtonBox["TreePathToPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TreePathToPath"]], 
  "InlineFormula",ExpressionUUID->"a1010104-0000-0000-0000-000000000001"],
 " uses ",
 Cell[BoxData[
  ButtonBox["Scan",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Scan"]], "InlineFormula",ExpressionUUID->
  "a1010104-0000-0000-0000-000000000002"],
 " at level ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"0", ",", 
    RowBox[{"-", "3"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "a1010104-0000-0000-0000-000000000003"],
 " (the parent of each leaf pair); positional bookkeeping tracks where each \
new contraction lands in the working list."
}], "Notes",
 CellID->650100002,ExpressionUUID->"a1010104-0000-0000-0000-000000000004"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "a1010105-0000-0000-0000-000000000001"],
 " is ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Automatic"]], "InlineFormula",ExpressionUUID->
  "a1010105-0000-0000-0000-000000000002"],
 ", the index list is derived as ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Sort",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Sort"], "[", 
   RowBox[{
    ButtonBox["Cases",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Cases"], "[", 
    RowBox[{
     StyleBox["treePath", "TI"], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["x", "TI"], "_"}], "}"}], "\[RuleDelayed]", 
      StyleBox["x", "TI"]}], ",", "All"}], "]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"a1010105-0000-0000-0000-000000000003"],
 " \[LongDash] the sorted list of leaf labels."
}], "Notes",
 CellID->650100003,ExpressionUUID->"a1010105-0000-0000-0000-000000000004"],

Cell[TextData[{
 "When ",
 Cell[BoxData[
  StyleBox["indices", "TI"]], "InlineFormula",ExpressionUUID->
  "a1010106-0000-0000-0000-000000000001"],
 " is given explicitly, its length must match the number of leaves in ",
 Cell[BoxData[
  StyleBox["treePath", "TI"]], "InlineFormula",ExpressionUUID->
  "a1010106-0000-0000-0000-000000000002"],
 ", and its elements must coincide with the tree's leaf labels. A length \
mismatch or a label mismatch is not detected: the call returns a malformed \
result rather than a ",
 Cell[BoxData[
  ButtonBox["Failure",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Failure"]], "InlineFormula",ExpressionUUID->
  "a1010106-0000-0000-0000-000000000003"],
 "."
}], "Notes",
 CellID->650100004,ExpressionUUID->"a1010106-0000-0000-0000-000000000004"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  StyleBox["treePath", "TI"]], "InlineFormula",ExpressionUUID->
  "a1010107-0000-0000-0000-000000000001"],
 " does not satisfy ",
 Cell[BoxData[
  ButtonBox["TreePathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TreePathQ"]], 
  "InlineFormula",ExpressionUUID->"a1010107-0000-0000-0000-000000000002"],
 ", the call is left unevaluated."
}], "Notes",
 CellID->650100005,ExpressionUUID->"a1010107-0000-0000-0000-000000000003"]
}, Open  ]],

