Cell[CellGroupData[{
Cell["TensorNetwork", "ObjectName",
 CellID->655424651,ExpressionUUID->"d16284ab-44c7-4053-82e7-38cee3956117"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"65da51af-ca0f-43a7-8b66-d200e98f0dbd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["A", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["A", "TI"], "2"], ",", "\[Ellipsis]"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["h", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["h", "TI"], "2"], ",", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"7b0bbb79-1428-4f9f-9a62-a2a4d859c589"],
 "\[LineSeparator]creates a tensor network from tensors ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["A", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",ExpressionUUID->
  "28cd4cd2-c1b0-44af-a8d7-9041f6cbd603"],
 " and hyperedge index lists ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["h", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",ExpressionUUID->
  "9e990096-642e-4945-96ff-65d2e37cf0ad"],
 "; repeated indices in the ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["h", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",ExpressionUUID->
  "75926605-bbf9-4eeb-b781-fb95bf99948b"],
 " denote contractions. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f7809975-2963-4c34-9e45-0bf2ddd66ff0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"], "[", 
   RowBox[{
    StyleBox["tensors", "TI"], ",", 
    StyleBox["hyperedges", "TI"], ",", 
    StyleBox["output", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b29a912c-5591-49e6-914f-342443ff7632"],
 "\[LineSeparator]fixes the order of free indices in the contracted result to \
",
 Cell[BoxData[
  StyleBox["output", "TI"]], "InlineFormula",ExpressionUUID->
  "2c69a98d-503a-4f98-9168-2972349bf61d"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"042d3c51-b7cd-41f0-9fa2-0d033b9e2781"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"], "[", 
   RowBox[{
    StyleBox["tensors", "TI"], ",", 
    RowBox[{
     StyleBox["in", "TI"], "\[Rule]", 
     StyleBox["out", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a5cf8d5b-c5c4-4d97-98b5-3984ff5b818b"],
 "\[LineSeparator]uses Einstein-summation rule syntax. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"fdea1208-13dd-47de-a686-7d17f62786ca"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"], "[", 
   RowBox[{
    StyleBox["tensors", "TI"], ",", 
    StyleBox["indices", "TI"], ",", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a577f3d6-2931-4010-9705-30c3fc95ff8f"],
 "\[LineSeparator]with a ",
 Cell[BoxData[
  ButtonBox["Cycles",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Cycles"]], "InlineFormula",ExpressionUUID->
  "08a957bd-d94f-4742-83d9-eaecf3420dbe"],
 " permutation ",
 Cell[BoxData[
  StyleBox["perm", "TI"]], "InlineFormula",ExpressionUUID->
  "74609787-71d0-4157-84ad-c0c288270df0"],
 " permutes the derived free indices. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c7087a12-3af1-44e8-8898-1a5a531b73d6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"], "[", 
   StyleBox["hyperedges", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2cb65171-ef02-4027-b953-ef0f39fc91aa"],
 "\[LineSeparator]builds a symbolic network with one ",
 Cell[BoxData[
  ButtonBox["ArraySymbol",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ArraySymbol"]], "InlineFormula",ExpressionUUID->
  "63afd8dd-a6e0-4a42-8136-dd7526471503"],
 " tensor per hyperedge. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"9df9beb7-5a39-40c3-add1-4ac0d0492682"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"], "[", 
   RowBox[{
    StyleBox["hyperedges", "TI"], "\[Rule]", 
    StyleBox["output", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d0403846-e8c2-481d-8d2f-174545c80407"],
 "\[LineSeparator]builds a symbolic network with explicit output index list. \
\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4374d4b2-a26a-4ed9-b278-0d278b9ce18d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"], "[", 
   RowBox[{
    RowBox[{
     StyleBox["hyperedges", "TI"], "\[Rule]", 
     StyleBox["output", "TI"]}], ",", 
    StyleBox["dims", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "da3c8534-828b-432b-84b6-c0142c50805c"],
 "\[LineSeparator]with an ",
 Cell[BoxData[
  ButtonBox["Association",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Association"]], "InlineFormula",ExpressionUUID->
  "daf464d9-744c-4a1f-9aed-6aff4bd0db73"],
 " ",
 Cell[BoxData[
  StyleBox["dims", "TI"]], "InlineFormula",ExpressionUUID->
  "6e5ba8ed-0f12-48b9-86a0-55ad0e78802d"],
 " of index\[Rule]dimension entries fixes the dimensions of symbolic tensors. \
\[Bullet]\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f3025dcd-2a3c-4fda-bd0b-71ea6124f6e9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"], "[", 
   RowBox[{
    RowBox[{
     StyleBox["hyperedges", "TI"], "\[Rule]", 
     StyleBox["output", "TI"]}], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["d", "TI"], "1"], ",", 
      SubscriptBox[
       StyleBox["d", "TI"], "2"], ",", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"ab217e49-901e-4339-97e4-73390468ab02"],
 "\[LineSeparator]with a positional list of dimensions for the union of \
indices. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"86be1928-3a6c-4dfc-9b91-da7a0eff5bfd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "783f26e0-c329-470e-a120-8d69ec5448d2"],
 "\[LineSeparator]constructs a network from an ",
 Cell[BoxData[
  ButtonBox["Inactive",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Inactive"]], "InlineFormula",ExpressionUUID->
  "c06e73d9-5bb8-4d88-a7b2-5fcaada15f40"],
 " ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorContract"]], "InlineFormula",ExpressionUUID->
  "b3bc943d-10a8-4cc5-9241-8b652421d39f"],
 " over a ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorProduct"]], "InlineFormula",ExpressionUUID->
  "d7122306-2225-48e7-b03b-b5fa31345e24"],
 ". \[Bullet]\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d1b06018-57e0-4eeb-b521-74fd3129715d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"], "[", 
   RowBox[{
    ButtonBox["Transpose",
     BaseStyle->"Link",
     ButtonData->"paclet:ref/Transpose"], "[", 
    RowBox[{
     StyleBox["expr", "TI"], ",", 
     StyleBox["perm", "TI"]}], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "e40959b6-2f10-42c3-bb36-a6d4b3577ba9"],
 "\[LineSeparator]wraps a ",
 Cell[BoxData[
  ButtonBox["Transpose",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Transpose"]], "InlineFormula",ExpressionUUID->
  "4253800a-7e3d-4d48-baff-bad42e2fae1c"],
 " of an inactive contraction so the output index order follows ",
 Cell[BoxData[
  StyleBox["perm", "TI"]], "InlineFormula",ExpressionUUID->
  "41329648-71c2-497b-84af-3af4806d6bed"],
 ". \[Bullet]\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f115082f-7235-4183-9cda-fa1d9e6c24c1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "5026c4e7-d022-4f50-adb1-2b044d14c0bd"],
 "\[LineSeparator]reconstructs a network from a tensor-network ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "e63f2448-5168-463c-a1b9-d71ccdec38e3"],
 " produced by ",
 Cell[BoxData[
  ButtonBox["ToTensorNetworkGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]], 
  "InlineFormula",ExpressionUUID->"70936580-b8ed-4f3a-b271-4683f38da219"],
 "."
}], "Usage",
 CellChangeTimes->{{3.988130048501934*^9, 3.9881300641694717`*^9}, 
   3.9881300943375196`*^9},
 CellID->1278483894,ExpressionUUID->"69a20278-97a6-42ec-9017-1091f30ef526"],

Cell["\<\
Repeated indices in the hyperedge lists denote contractions; indices \
appearing exactly once are free (output) indices.\
\>", "Notes",
 CellID->1904918223,ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cbe"],

Cell[TextData[{
 "Hyperedge entries can be integers or symbols, but every entry of a single \
hyperedge list ",
 Cell[BoxData[
  StyleBox["h", "TI"]], "InlineFormula",ExpressionUUID->
  "66b8d7f2-25a3-42a8-b47d-685ba01b20b6"],
 " must have length equal to the rank of the corresponding tensor."
}], "Notes",
 CellID->1904918224,ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cb1"],

Cell[TextData[{
 "When the third argument is ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Automatic"]], "InlineFormula",ExpressionUUID->
  "0e6632fd-e618-4165-b8da-73c77760a968"],
 " (the default), the free indices of the network are derived from the \
hyperedge structure in their order of first appearance."
}], "Notes",
 CellID->1904918227,ExpressionUUID->"13954265-aaaa-eeee-aaaa-2a6cb1aaa101"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cb2"],
 " objects support property access via the syntax ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Property\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cb3"],
 "; use ",
 Cell[BoxData[
  RowBox[{
   StyleBox["tn", "TI"], "[", "\"\<Properties\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"73afec17-2043-4ebf-9cc1-b5a889d98a2e"],
 " to list every supported key."
}], "Notes",
 CellID->1904918225,ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cb4"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cb5"],
 " to evaluate the network to a single tensor; the contraction path can be \
supplied explicitly or chosen by ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"5e430eec-e675-4910-8ed3-bcc3bf9410b6"],
 " or ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"fe6a5eff-fd52-4bff-ac2f-3e0818e32b48"],
 "."
}], "Notes",
 CellID->1904918226,ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cb6"],

Cell[TextData[{
 "A network is binary when every index appears in at most two tensors; use ",
 Cell[BoxData[
  ButtonBox["BinaryTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"a7e415eb-418b-4deb-824a-c0b0bee1b166"],
 " to convert a hyper-edge network (an index shared by three or more tensors) \
to its binary equivalent by inserting copy tensors. ",
 Cell[BoxData[
  ButtonBox["BinaryTensorNetworkQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetworkQ"]], 
  "InlineFormula",ExpressionUUID->"36abe9b3-433d-4553-b292-467e1a572c2d"],
 " tests for that condition."
}], "Notes",
 CellID->1904918228,ExpressionUUID->"13954265-bbbb-cccc-aaaa-2a6cb1bbb102"],

Cell[TextData[{
 "Output cells display a summary box (icon, tensor count, free-index count, \
binary/sparse flags, output dimension) generated by an upvalue on ",
 Cell[BoxData[
  ButtonBox["MakeBoxes",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/MakeBoxes"]], "InlineFormula",ExpressionUUID->
  "c4857819-ecc3-4995-ab6b-8aeab8cac36a"],
 "; the icon is the network's hypergraph for binary networks with at most ten \
tensors and a placeholder graph otherwise."
}], "Notes",
 CellID->1904918229,ExpressionUUID->"13954265-cccc-dddd-aaaa-2a6cb1ccc103"]
}, Open  ]],

