Cell[CellGroupData[{
Cell["TensorNetwork", "ObjectName",
 CellID->655424651,ExpressionUUID->"d16284ab-44c7-4053-82e7-38cee3956117"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"57107deb-a537-4595-b60d-112feb6b0031"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/TensorNetwork"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A\:2081", ",", "A\:2082", ",", "\[Ellipsis]"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["h\:2081", "TI"], ",", 
      StyleBox["h\:2082", "TI"], ",", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"733827ae-0c80-4b1a-9535-8b34cb364b58"],
 "\[LineSeparator]creates a tensor network from tensors A\:1d62 with \
hyperedge index lists h\:1d62. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6f82fdc5-c7d5-4079-8a8d-fb8e1e01043f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/TensorNetwork"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A\:2081", ",", "A\:2082", ",", "\[Ellipsis]"}], "}"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["i\:2081", "TI"], ",", 
       StyleBox["i\:2082", "TI"], ",", "\[Ellipsis]"}], "}"}], "\[Rule]", 
     StyleBox["output", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "9bf1b9b9-e3a7-4af0-ba3b-07b6d32a4574"],
 "\[LineSeparator]creates a tensor network using Einstein summation notation. \
\[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"8d6bbc63-6f81-4fcd-9fb5-f18c0bc60f97"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/TensorNetwork"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c43ede37-f955-453a-9524-ecddbe5d234e"],
 "\[LineSeparator]constructs a tensor network from ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "5bffa5db-e1e9-48ea-af33-263c31e9eecc"],
 ",",
 Cell[BoxData[
  ButtonBox["Transpose",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "917e99bb-d962-44df-8edc-c535ddbedc88"],
 ",or ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "8eb48f37-aee1-431b-988f-e261719fd8a3"],
 " expressions. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"0552f8a7-290a-49c2-b410-7fe6e5ec2b8b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/TensorNetwork"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "23c5b49d-444c-497b-b463-508ba12ebe5c"],
 "\[LineSeparator]creates a tensor network from a directed acyclic ",
 Cell[BoxData[
  StyleBox["graph", "TI"]], "InlineFormula",ExpressionUUID->
  "4fe4c684-8200-425a-b093-f58221a4f6d0"],
 " with tensor annotations."
}], "Usage",
