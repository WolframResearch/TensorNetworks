Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"57107deb-a537-4595-b60d-112feb6b0031"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/TensorNetwork"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A\:2081", ",", "A\:2082", ",", "\[Ellipsis]"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["h\:2081", "TI"], ",", 
      StyleBox["h\:2082", "TI"], ",", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"733827ae-0c80-4b1a-9535-8b34cb364b58"],
 "\[LineSeparator]creates a tensor network from tensors A\:1d62 with \
hyperedge index lists h\:1d62. \[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6f82fdc5-c7d5-4079-8a8d-fb8e1e01043f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/TensorNetwork"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A\:2081", ",", "A\:2082", ",", "\[Ellipsis]"}], "}"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["i\:2081", "TI"], ",", 
       StyleBox["i\:2082", "TI"], ",", "\[Ellipsis]"}], "}"}], "\[Rule]", 
     StyleBox["output", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "9bf1b9b9-e3a7-4af0-ba3b-07b6d32a4574"],
 "\[LineSeparator]creates a tensor network using Einstein summation notation. \
\[Bullet] \n",
 Cell["   ", "ModInfo",ExpressionUUID->"8d6bbc63-6f81-4fcd-9fb5-f18c0bc60f97"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorNetwork",
    BaseStyle->"Link",
