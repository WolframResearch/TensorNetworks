Cell["\<\
Compute the inner product of two quantum states represented as vectors:\
\>", "ExampleText",
 CellID->400000001,ExpressionUUID->"d0000001-0000-0000-0000-000000000001"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"psi", "=", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "-", "I"}], ",", 
       RowBox[{"1", "+", "I"}]}], "}"}], ",", 
     RowBox[{"{", "4", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phi", "=", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "-", "I"}], ",", 
       RowBox[{"1", "+", "I"}]}], "}"}], ",", 
     RowBox[{"{", "4", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"tn", "=", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Conjugate", "[", "psi", "]"}], ",", "phi"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "i", "}"}], ",", 
      RowBox[{"{", "i", "}"}]}], "}"}]}], "]"}]}]}], "Input",
 CellLabel->"In[262]:=",
 CellID->400000002,ExpressionUUID->"d0000002-0000-0000-0000-000000000002"],

