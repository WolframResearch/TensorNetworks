Cell[BoxData[
 RowBox[{"TensorContract", "[", 
  RowBox[{
   RowBox[{
    TemplateBox[{"\[FormalCapitalT]", "2", "\[FormalD]", "\[FormalD]"},
     "ArraySymbol2"], "\[TensorProduct]", 
    TemplateBox[{
     "\[FormalCapitalT]", "3", "\[FormalD]", "\[FormalD]", "\[FormalD]"},
     "ArraySymbol2"], "\[TensorProduct]", 
    TemplateBox[{"\[FormalCapitalT]", "2", "\[FormalD]", "\[FormalD]"},
     "ArraySymbol2"]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "6"}], "}"}]}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.978640298111054*^9, 3.978657454673874*^9, 
  3.98813015128454*^9},
 CellLabel->"Out[223]=",
 CellID->572099527,ExpressionUUID->"4bbe1814-4baa-41b6-b2df-4098fd58cf74"]
}, Open  ]],

