         Subscript[3, 2]}}}, {AnnotationRules -> {4 -> {"Index" -> {
             Subscript[4, 1], 
             Subscript[4, 2], 
             Superscript[4, 3]}, "Tensor" -> 
           SymbolicDeltaProductArray[{3, 3, 3}, {{1, 2, 3}}]}, 2 -> {"Index" -> {
             Superscript[2, 1], 
             Subscript[2, 2], 
             Superscript[2, 3]}, 
           "Tensor" -> {{{0.19809138871543697`, 0.3546840647092502}, {
