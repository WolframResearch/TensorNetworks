Cell["\<\
Repeated indices in hyperedge lists indicate contraction between the \
corresponding tensor indices.\
\>", "Notes",
 CellID->1904918223,ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cbe"],

Cell["\<\
Free indices (appearing exactly once) become the output indices of the \
contracted network.\
\>", "Notes",
 CellID->1904918224,ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cb1"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:WolframTensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cb2"],
 " objects support property access via ",
 Cell[BoxData[
  RowBox[{"tn", "[", "\"\<Property\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cb3"],
 " syntax."
}], "Notes",
 CellID->1904918225,ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cb4"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:WolframTensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cb5"],
 " to evaluate the tensor network and obtain a numerical tensor."
}], "Notes",
 CellID->1904918226,ExpressionUUID->"13954265-be93-4dab-a2e1-2a7caa6e6cb6"]
}, Open  ]],

