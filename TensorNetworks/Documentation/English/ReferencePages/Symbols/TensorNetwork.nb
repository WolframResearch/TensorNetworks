Cell["\<\
TensorNetwork emits the TensorNetwork::dim message and returns $Failed when \
the dimensions of a contracted index do not match (here 4 vs 5 for index \
j).\
\>", "ExampleText",
 CellID->600000003,ExpressionUUID->"f0000003-0000-0000-0000-000000000003"],

