Cell[CellGroupData[{

Cell["Maximally entangled cut", "ExampleSubsection",
 CellID->604982271,ExpressionUUID->"71205bbd-45a5-49c2-83ea-a24e94424350"],

Cell["\<\
A two-site MPS whose bond carries the Bell state |00\[RightAngleBracket]+|11\
\[RightAngleBracket] has a uniform Schmidt spectrum at the bond, with each \
value equal to 1/Sqrt[2]:\
\>", "ExampleText",
 CellID->562266817,ExpressionUUID->"3a7060d3-65c7-4e90-a7c0-304ff09fad94"],

