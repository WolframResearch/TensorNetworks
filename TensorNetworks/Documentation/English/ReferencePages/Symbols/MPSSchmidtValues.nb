Notebook[{

Cell[CellGroupData[{
Cell["MPSSchmidtValues", "ObjectName",
 CellID->1980210421,ExpressionUUID->"1b5d7f61-4515-4252-8d20-b59af3525675"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"63ce7625-86be-4f92-a1a7-15c0e34b0f26"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSSchmidtValues",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframTensorNetworks/ref/MPSSchmidtValues"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", 
    StyleBox["site", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "dc228797-ea9a-405b-a67c-40eeb08d592a"],
 "\[LineSeparator]returns the normalized Schmidt coefficients \[Lambda]\:1d62 \
at the bond between ",
 Cell[BoxData[
  StyleBox["site", "TI"]], "InlineFormula",ExpressionUUID->
  "7571528d-b685-422c-9cda-35fcb238da89"],
 " and site+1. \[Bullet] The values satisfy \[Sum] \[Lambda]\:1d62^2 = 1. \
\[Bullet] ",
 Cell[BoxData[
  ButtonBox["Number",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "71d0192d-d5d7-4e34-afe5-d57ded48797f"],
 " of values equals the bond dimension at that cut."
}], "Usage",
 CellChangeTimes->{{3.978638388419888*^9, 3.978638388502584*^9}},
 CellID->1842468188,ExpressionUUID->"6ba73d36-ae9e-458d-909e-67564e1c1242"],

