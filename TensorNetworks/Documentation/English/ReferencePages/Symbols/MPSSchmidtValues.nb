Cell[CellGroupData[{

Cell["Canonicalization invariance", "ExampleSubsection",
 CellID->518613085,ExpressionUUID->"da898cba-5d44-4cb4-a6f5-862d37edbc90"],

Cell["\<\
The result does not depend on the input canonicalization, because the \
function internally calls MPSCanonicalForm[mps, {\"Mixed\", site}] before \
reading the bond:\
\>", "ExampleText",
 CellID->253389314,ExpressionUUID->"9f8ff4fd-060e-4752-871f-fb088ef25122"],

