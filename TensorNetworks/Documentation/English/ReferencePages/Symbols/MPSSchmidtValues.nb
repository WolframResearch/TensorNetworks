Notebook[{

Cell[CellGroupData[{
Cell["MPSSchmidtValues", "ObjectName",
 CellID->212244623,ExpressionUUID->"8ada0abd-55da-42c5-b61c-180acdb05388"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9e05b710-81bd-4167-9a78-e156868dc53f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSSchmidtValues",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSSchmidtValues"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", 
    StyleBox["site", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "500cd481-1b15-42da-ab91-a091e89f459e"],
 "\[LineSeparator]returns the normalized Schmidt coefficients ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "62c64a0c-98e7-41c2-a7c4-7f100e8a202a"],
 " at the bond between ",
 Cell[BoxData[
  StyleBox["site", "TI"]], "InlineFormula",ExpressionUUID->
  "9a43b24f-5fe2-4ce8-b588-852b77391418"],
 " and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["site", "TI"], "+", "1"}]], "InlineFormula",ExpressionUUID->
  "a26cbab1-2993-4abc-badd-d432b27a5d53"],
 "."
}], "Usage",
 CellID->303531438,ExpressionUUID->"823564ea-808a-4f0c-b3d4-896b4333b168"],

Cell[TextData[{
 "The values satisfy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["i", "TI"]], 
    SuperscriptBox[
     SubscriptBox["\[Lambda]", 
      StyleBox["i", "TI"]], "2"], "=", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c614093f-749f-4186-9092-209cb225f5b7"],
 " \[LongDash] they are the square roots of a probability distribution across \
the bond."
}], "Notes",
 CellID->247694475,ExpressionUUID->"e9884162-d06c-4cd6-82bd-a6621f34ff10"],

Cell[TextData[{
 "The number of values equals the bond dimension at that cut, so ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Length",
    BaseStyle->"Link",
    ButtonData->"paclet:ref/Length"], "[", 
   RowBox[{
    ButtonBox["MPSSchmidtValues",
     BaseStyle->"Link",
     ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSSchmidtValues"], "[", 
    RowBox[{
     StyleBox["mps", "TI"], ",", 
     StyleBox["site", "TI"]}], "]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "454e03e4-90d5-4e64-95b9-3cb60ea43149"],
 " reports the local bond dimension across the cut."
}], "Notes",
 CellID->462970307,ExpressionUUID->"57ff03d2-44fa-4664-a105-336e2e74b49a"],

Cell[TextData[{
 "Valid values of ",
 Cell[BoxData[
  StyleBox["site", "TI"]], "InlineFormula",ExpressionUUID->
  "0c41e0b4-1d1c-46ef-9da4-65e1c546fda0"],
 " label bonds and run from ",
 Cell[BoxData[
 "1"], "InlineFormula",ExpressionUUID->"2b441155-b1f4-4d82-8a2e-58cea90b6a64"],
 " through ",
 Cell[BoxData[
  RowBox[{
   StyleBox["N", "TI"], "-", "1"}]], "InlineFormula",ExpressionUUID->
  "1886093e-90ca-4ac2-b025-c82c8f6e182e"],
 " for an MPS of length ",
 Cell[BoxData[
  StyleBox["N", "TI"]], "InlineFormula",ExpressionUUID->
  "74669c7c-83dd-4bd7-a675-072f2ba031ac"],
 "; out-of-range values return ",
 Cell[BoxData[
  RowBox[{"{", "1.", "}"}]], "InlineFormula",ExpressionUUID->
  "f6c8d202-21d8-4c0e-abf5-ad010e0d4440"],
 " (the trivial single-value distribution)."
}], "Notes",
 CellID->702361215,ExpressionUUID->"a4bf155e-5e24-45e0-9434-fdada937b6af"],

Cell[TextData[{
 "The function internally canonicalizes ",
 Cell[BoxData[
  StyleBox["mps", "TI"]], "InlineFormula",ExpressionUUID->
  "181597b7-980f-4321-af73-7969614a9879"],
 " to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["MPSCanonicalForm",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/TensorNetworks/ref/MPSCanonicalForm"], "[", 
   RowBox[{
    StyleBox["mps", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<Mixed\>\"", ",", 
      StyleBox["site", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"0f9a4e48-dd43-4ea6-b2bf-59f1c61b4cc1"],
 " before extracting the bond singular values, so the result does not depend \
on the input canonicalization."
}], "Notes",
 CellID->610743941,ExpressionUUID->"bb6ee13b-a65c-40bf-98a1-e0fb3361c90f"],

Cell[TextData[{
 "The singular values are extracted with ",
 Cell[BoxData[
  ButtonBox["SingularValueList",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/SingularValueList"]], "InlineFormula",
  ExpressionUUID->"5f2051e1-c2dd-4c4d-92a3-caa883525cf9"],
 "; the ",
 Cell[BoxData[
  StyleBox["U", "TI"]], "InlineFormula",ExpressionUUID->
  "919510a5-0825-481b-9f0a-54eb906f2ff7"],
 " and ",
 Cell[BoxData[
  StyleBox["V", "TI"]], "InlineFormula",ExpressionUUID->
  "10d85394-e8e2-4594-8d27-d6d7f1cc9060"],
 " factors of the SVD are discarded, which is cheaper than a full ",
 Cell[BoxData[
  ButtonBox["SingularValueDecomposition",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/SingularValueDecomposition"]], "InlineFormula",
  ExpressionUUID->"8bb2806c-433f-42ba-b2e5-cbc8cbc20bb8"],
 "."
}], "Notes",
 CellID->20650920,ExpressionUUID->"5ed5aab4-2187-460e-a960-30aa8236f6a8"],

Cell[TextData[{
 "The returned list is normalized to unit ",
 Cell[BoxData[
  ButtonBox["Norm",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Norm"]], "InlineFormula",ExpressionUUID->
  "7dbfc665-4eaa-47a8-a92d-d6d5640fee26"],
 " so that downstream entropies use a proper probability vector."
}], "Notes",
 CellID->586974430,ExpressionUUID->"eb2bbdae-9460-4bec-a60e-8e9825f0ef25"],

Cell[TextData[{
 "A product state has a single nonzero Schmidt value at every bond, so the \
output is ",
 Cell[BoxData[
  RowBox[{"{", "1.", "}"}]], "InlineFormula",ExpressionUUID->
  "c200f9b9-febd-4143-bfd7-a99b21df1052"],
 " at every cut; a maximally entangled cut with bond dimension ",
 Cell[BoxData[
  StyleBox["D", "TI"]], "InlineFormula",ExpressionUUID->
  "2c39bf80-c5a5-4830-8ecf-8ab0b9bddf46"],
 " yields a uniform spectrum with each value equal to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SqrtBox[
     StyleBox["D", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a2aeeb64-e6a9-4edf-a8b6-57258d611f41"],
 "."
}], "Notes",
 CellID->825960723,ExpressionUUID->"af78f1a2-1ce7-4680-ab48-b7903d759a5e"]
}, Open  ]],

