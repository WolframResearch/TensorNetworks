     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3", ",", " ", "5"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[254]:=",ExpressionUUID->"681a0cf2-e1bc-4cde-af32-319f97ab0df1"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9888385865245247`*^9},
 CellLabel->"Out[254]=",
 CellID->1097569649,ExpressionUUID->"66c3c985-598d-4535-b805-045109a09cd2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Anything that is not a ",
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", "...", "]"}]], "InlineFormula",ExpressionUUID->
  "bc5739a6-99d1-483a-b496-aa76d702c704"],
 " is rejected by head."
}], "Text",ExpressionUUID->"d3e3e463-5758-4601-b4a7-664a40ca426f"],

