Cell[CellGroupData[{

Cell["\<\
The search returns 84 two-term identities, derived without input from the \
textbook. They include the three classical Riemann pair-symmetries plus every \
consequence (composing two pair-antisymmetries gives a pair-swap, etc.). \
Extract the textbook three from the discovered list by set intersection.\
\>", "Text",ExpressionUUID->"9b378ce6-51b7-47be-a740-485ec1b3d563"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Intersection", "[", 
  RowBox[{"twoTerm", ",", " ", 
   RowBox[{"{", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
        "  ", "1", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
        "  ", "1", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "4", ",", " ", "3"}], "}"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
        " ", 
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4", ",", " ", "1", ",", " ", "2"}], "}"}]}], 
      "}"}]}], "\n", "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[428]:=",ExpressionUUID->"6e27cfc0-2e65-4c6b-8af2-02f7a1fda6ac"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
     RowBox[{"-", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4", ",", "1", ",", "2"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", "1", ",", 
