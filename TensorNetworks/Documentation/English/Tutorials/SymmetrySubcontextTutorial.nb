Cell[CellGroupData[{

Cell["\<\
The three within-sector contractions sum to the bare Frobenius product.\
\>", "Text",ExpressionUUID->"0b6a971b-7e74-42ac-8520-438358ecf86c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Chop", "[", 
   RowBox[{"bareFro", " ", "-", " ", 
    RowBox[{"Total", " ", "@", " ", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"sectorContract", "[", 
        RowBox[{"T3", ",", " ", "S3", ",", " ", "syt3"}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"sectorContract", "[", 
        RowBox[{"T3", ",", " ", "S3", ",", " ", "syt21"}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"sectorContract", "[", 
        RowBox[{"T3", ",", " ", "S3", ",", " ", "syt111"}], "]"}]}], "\n", 
      "}"}]}]}], "]"}], " ", "<", " ", "tol"}]], "Input",
 CellLabel->
  "In[400]:=",ExpressionUUID->"d8443fe7-c6ec-4903-ab9a-fde8dff61d08"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9888385889680223`*^9},
 CellLabel->"Out[400]=",
 CellID->1388026280,ExpressionUUID->"5cd578fe-2e23-4751-a6c9-7ba366aae634"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Mismatched-sector projections give zero by Schur orthogonality: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T", "TI"], "3"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7fe37fee-c07a-477a-af1e-7bc988a1f7c7"],
 " projected onto one shape against ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "3"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5f5cf9b8-8c5c-4cb2-be6d-2065b72d798a"],
 " projected onto a ",
 StyleBox["different", "TI"],
 " shape vanishes for every cross-shape pair."
}], "Text",ExpressionUUID->"63442e93-e5a2-4de9-99ee-185521cb14ef"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"crossContract", "[", 
    RowBox[{
    "U_", ",", " ", "V_", ",", " ", "sytU_List", ",", " ", "sytV_List"}], 
    "]"}], " ", ":=", "\n", "    ", 
   RowBox[{"TensorNetworkContract", " ", "@", " ", 
    RowBox[{"TensorNetwork", "[", "\n", "        ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"YoungProject", "[", 
            RowBox[{"U", ",", " ", 
             RowBox[{"YoungTableau", "[", "#", "]"}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "sytU"}], "]"}], ",", "\n", "         ", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"YoungProject", "[", 
            RowBox[{"V", ",", " ", 
             RowBox[{"YoungTableau", "[", "#", "]"}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "sytV"}], "]"}]}], "}"}], ",", "\n", "        ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\"", ",", " ", "\"\<k\>\""}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\"", ",", " ", "\"\<k\>\""}], 
         "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", "}"}]}], "\n", "    ", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Chop", " ", "@", " ", 
  RowBox[{"{", "\n", "    ", 
   RowBox[{
    RowBox[{"crossContract", "[", 
     RowBox[{"T3", ",", " ", "S3", ",", " ", "syt3", ",", "   ", "syt21"}], 
     "]"}], ",", " ", 
    RowBox[{"crossContract", "[", 
     RowBox[{"T3", ",", " ", "S3", ",", " ", "syt3", ",", "   ", "syt111"}], 
     "]"}], ",", "\n", "    ", 
    RowBox[{"crossContract", "[", 
     RowBox[{"T3", ",", " ", "S3", ",", " ", "syt21", ",", "  ", "syt3"}], 
     "]"}], ",", "  ", 
    RowBox[{"crossContract", "[", 
     RowBox[{"T3", ",", " ", "S3", ",", " ", "syt21", ",", "  ", "syt111"}], 
     "]"}], ",", "\n", "    ", 
    RowBox[{"crossContract", "[", 
     RowBox[{"T3", ",", " ", "S3", ",", " ", "syt111", ",", " ", "syt3"}], 
     "]"}], ",", "  ", 
    RowBox[{"crossContract", "[", 
     RowBox[{"T3", ",", " ", "S3", ",", " ", "syt111", ",", " ", "syt21"}], 
     "]"}]}], "\n", "}"}]}]}], "Input",
 CellLabel->
  "In[401]:=",ExpressionUUID->"023e597c-49a7-4f3a-b296-dba43e34a1a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.988838588995578*^9},
 CellLabel->"Out[402]=",
 CellID->442830599,ExpressionUUID->"2c7434e2-b322-4e68-979d-298b7766f53b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The sum of the three within-block contractions reproduces the full Frobenius \
product.\
\>", "Text",ExpressionUUID->"3a2d0afe-7b8d-4025-9173-e867efa61573"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"froFull", " ", "-", " ", 
   RowBox[{"(", 
    RowBox[{"b3", " ", "+", " ", "b21", " ", "+", " ", "b111"}], ")"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[403]:=",ExpressionUUID->"98694ed4-5136-421d-aadf-b5bd5ba38efe"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.988838589017868*^9},
 CellLabel->"Out[403]=",
 CellID->1623040538,ExpressionUUID->"9d93185f-3514-4377-8488-0fcd68db6e18"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Now demonstrate that every cross-block term vanishes identically: the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "3", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8a0f05f8-b453-4e7f-b253-80b64b014005"],
 " block of ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "55a1ca59-5aaa-42ec-a585-d0980cbe1a71"],
 " does not see the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7daa2e77-564a-4b9c-8b4d-a2e25d275ae2"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b443fc54-b8b8-41d2-8a41-633bd213f82a"],
 " block of ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "77e516a7-62a0-4540-b7b6-cfdf37d35867"],
 ", and so on."
}], "Text",ExpressionUUID->"115d3ad6-d366-4968-8702-e3a6f03542e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"e3", " ", "*", " ", "f21"}], "]"}], "]"}], ",", "   ", 
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"e3", " ", "*", " ", "f111"}], "]"}], "]"}], ",", "\n", 
    "      ", 
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"e21", " ", "*", " ", "f3"}], "]"}], "]"}], ",", "   ", 
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"e21", " ", "*", " ", "f111"}], "]"}], "]"}], ",", "\n", 
    "      ", 
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"e111", " ", "*", " ", "f3"}], "]"}], "]"}], ",", "  ", 
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"e111", " ", "*", " ", "f21"}], "]"}], "]"}]}], "}"}], 
  "]"}]], "Input",
 CellLabel->
  "In[404]:=",ExpressionUUID->"7530ef50-2efc-4977-a0cd-15e2b8ca2104"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.988838589045313*^9},
 CellLabel->"Out[404]=",
 CellID->1105037972,ExpressionUUID->"d8e0ee0a-2097-4003-b9cb-35c8f4b76f92"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"76a0c854-4d68-4c19-8529-e2ae9ec47770"],
 " the fully antisymmetric block ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"68ee124a-8c18-44ab-961e-b491e8ef6679"],
 " is identically zero: three mutually orthogonal antisymmetric labels cannot \
fit in a two-dimensional space (Pauli exclusion for three fermions on a \
two-level bond)."
}], "Text",ExpressionUUID->"7723cd6d-066e-4295-9773-572c4cafc723"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", "b111", "]"}]], "Input",
 CellLabel->
  "In[405]:=",ExpressionUUID->"7063eafd-f3ca-432c-a92d-c2d1b1548b06"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.9888385890668097`*^9},
 CellLabel->"Out[405]=",
 CellID->934616148,ExpressionUUID->"864b5c2f-66b7-4f8a-8c3c-0391985a96ff"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "That zero is exact, not numerical: the same Pauli-exclusion zero that \
killed the rank-2 antisymmetric singlet at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"df562e94-a993-48f6-b4ba-38e4f692ff9b"],
 ", lifted by one slot. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9624942a-790c-4064-90de-17d765ca5b31"],
 " the full Frobenius product on a rank-3 bond is exhausted by only two \
within-block contractions, the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "3", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7d4891b3-3aa5-4a26-9d77-8e829cf102b3"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"448ebbde-a3db-4205-843a-bbfcdb01cb94"],
 " pieces."
}], "Text",ExpressionUUID->"e7f5f689-eb1d-436f-a50e-b61a0d501241"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"froFull", " ", "-", " ", 
   RowBox[{"(", 
    RowBox[{"b3", " ", "+", " ", "b21"}], ")"}]}], "]"}]], "Input",
 CellLabel->
  "In[406]:=",ExpressionUUID->"c32a84e6-c13e-4d32-8429-a80833c1699f"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.9888385890955057`*^9},
 CellLabel->"Out[406]=",
 CellID->1398205278,ExpressionUUID->"5b21b732-d7e2-48b3-a7a2-a6aff88cb270"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The payoff for TN code is concrete: with an ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "902d8d90-e0ff-4b20-8b68-4d98dea5c4df"],
 " symmetry constraint on the bond, only irreducible representations whose \
diagrams fit in dimension ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d3378f5c-3921-4d36-bddf-67fbcfdefbd2"],
 " contribute. Diagrams with more than ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "21776356-d5c2-4666-a65c-c2b6b9384cec"],
 " rows give the zero subspace and drop out of the bond enumeration before \
any contraction begins. ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "477920fb-b2bc-4039-8b66-961ccb7016df"],
 ", ",
 Cell[BoxData[
 "HookFactor"], "InlineFormula",ExpressionUUID->
  "f7273e15-3489-49c5-8aab-16ea7444307c"],
 ", and the diagram itself are exactly the bookkeeping for this \
dimension-aware enumeration."
}], "Text",ExpressionUUID->"841f25d7-cffd-4351-944e-a23c9605a17f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Riemann tensor as a TN node", "Subsection",ExpressionUUID->"1f85aec3-6aec-40db-883e-211ce0ee2613"],

Cell[TextData[{
 StyleBox["The Riemann curvature tensor obeys four algebraic symmetries: two \
pair-antisymmetries, a pair-swap symmetry, and the multi-term first Bianchi \
identity. One ", "TI"],
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "7ee652d4-2bd9-49a4-b2f6-ff8cecfc4ca4"],
 StyleBox[" onto the ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cd5e996e-1f39-4bb8-9ed2-c3459debe1a2"],
 StyleBox[" tableau enforces all four simultaneously, including the Bianchi \
identity that built-in ", "TI"],
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "9e7f5fe6-9566-4ecf-9070-86b581025515"],
 StyleBox[" cannot reach with any single permutation generator.", "TI"]
}], "Text",ExpressionUUID->"94068d66-f460-42c0-9145-ee440a8344ea"],

Cell[TextData[{
 "The Riemann curvature tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["R", "TI"], 
    StyleBox[
     RowBox[{"a", "b", "c", "d"}], "TI"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a9e5f9a4-0d3e-43be-b1eb-331c4cb61983"],
 " is a rank-4 tensor with four classical symmetries:"
}], "Text",ExpressionUUID->"088bf3a9-634e-4013-ba8d-a8aa3a828881"],

Cell[TextData[{
 "Antisymmetric in the first pair: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]], "\[LongEqual]", "-", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"b", "a", "c", "d"}], "TI"]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"4f94ecae-ec6b-4a31-b83e-19af0c9e2f3f"],
 "."
}], "ItemNumbered",ExpressionUUID->"87890d9f-42ad-44f5-9b43-fca1656fc8ad"],

Cell[TextData[{
 "Antisymmetric in the second pair: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]], "\[LongEqual]", "-", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "d", "c"}], "TI"]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"47d45c1e-b4bd-4d85-abd0-2d30aac28ff2"],
 "."
}], "ItemNumbered",ExpressionUUID->"ff4911d9-8854-4a29-9fd1-4c145200a125"],

Cell[TextData[{
 "Symmetric under pair swap: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"c", "d", "a", "b"}], "TI"]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f07764b7-bc5d-4023-9ce9-db60d86ebf66"],
 "."
}], "ItemNumbered",ExpressionUUID->"0b39a684-418b-4a30-894c-78c4e9b96be9"],

Cell[TextData[{
 StyleBox["First Bianchi identity", "TI"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "c", "d", "b"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "d", "b", "c"}], "TI"]], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ad044fc3-1e80-4fda-bbd1-f6780d265f56"],
 "."
}], "ItemNumbered",ExpressionUUID->"19e5ee28-082b-4152-a94b-93858d75295a"],

Cell[TextData[{
 "The first three are ",
 StyleBox["single-term", "TI"],
 " slot symmetries (each says ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", "\[PlusMinus]", 
    SuperscriptBox[
     StyleBox["T", "TI"], "\[Sigma]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c92bb03a-3109-4363-8fe5-59945e9742db"],
 " for one permutation ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1554e07b-b7dd-4c94-8a30-e0278762ffda"],
 "). Standard WL canonicalisation via ",
 Cell[BoxData[
  RowBox[{"TensorReduce", "[", 
   RowBox[{"Arrays", "[", 
    RowBox[{"...", ",", " ", "sym"}], "]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"b47a0ae0-2761-40b7-bca3-9790fd9335b3"],
 " covers them. The fourth, the first Bianchi identity, is ",
 StyleBox["multi-term", "TI"],
 ": a sum of three permutations is zero, and no single ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Sigma]", ",", "\[Phi]"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"146f2e9c-a3e6-4a2d-b874-a288041db813"],
 " pair tells you that. ",
 StyleBox["This is the gap the Symmetry functions fill.",
  FontWeight->"Bold"]
}], "Text",ExpressionUUID->"967f9dbc-666b-4fa4-b78f-66db3409153f"],

Cell[TextData[{
 "All four constraints together are the content of a single ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7e7f257b-6a0b-49ae-a158-f17ebfa3a51e"],
 " irreducible representation, the one labelled by the partition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4e14cfb2-29f9-4130-b64d-71ee1303ff46"],
 ". The Riemann tensor ",
 StyleBox["is", "TI"],
 " the projection of a generic rank-4 tensor onto this irreducible \
representation, and one ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "6a9a1c6d-f0be-44a7-9349-f09742e1a827"],
 " call enforces every constraint at once."
}], "Text",ExpressionUUID->"e185ed34-167e-4273-810c-9cbfb5bbdc0a"],

Cell[CellGroupData[{

Cell[TextData[{
 "Before doing the projection, inspect the combinatorial data of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"aa23d7c3-328f-4a3c-a97a-d28874563111"],
 " diagram. First, confirm ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2782ed3e-e014-46ed-859b-8afd0d4d180f"],
 " is a valid partition."
}], "Text",ExpressionUUID->"3a7534b3-04d3-4a49-9eeb-d5dbde712511"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PartitionQ", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[407]:=",ExpressionUUID->"5ee525e7-5649-45ed-9ea8-85ee112ff9a8"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988838589120861*^9},
 CellLabel->"Out[407]=",
 CellID->1870041872,ExpressionUUID->"90a25e4d-657c-4953-b63f-69e19c22f3b1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Read off the hook-length nested list. The diagram has four cells arranged \
in a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Cross]", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5b8d0de0-6e9d-466e-a531-a2ba278d9893"],
 " square."
}], "Text",ExpressionUUID->"04abfac5-0f2f-4f01-9340-caf492d4b2ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookLengths", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[408]:=",ExpressionUUID->"edbf75e3-e150-45ab-9e46-794b8f60920a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988838589138845*^9},
 CellLabel->"Out[408]=",
 CellID->1370568859,ExpressionUUID->"b073d0e5-047d-456a-910b-156e740a0709"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The hook-length product is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "3", "\[CenterDot]", "2", "\[CenterDot]", "2", "\[CenterDot]", "1", "\[LongEqual]",
     "12"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9a4629f9-57af-4e47-b613-d989c87b0485"],
 ", so the hook factor is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "12"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"96a3e893-5089-43e2-8fc7-53712f520378"],
 "."
}], "Text",ExpressionUUID->"8cc8a2d2-9c5b-471e-9ed2-4bfefdd2f480"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookFactor", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[409]:=",ExpressionUUID->"a0c81322-764b-45b0-9602-1f82a45bd8c1"],

Cell[BoxData[
 FractionBox["1", "12"]], "Output",
 CellChangeTimes->{3.988838589164302*^9},
 CellLabel->"Out[409]=",
 CellID->1241215491,ExpressionUUID->"34a07d6e-8a78-46b3-af22-2234a7fa8f29"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The irreducible representation dimension is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"4", "!"}], "/", "12", "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8e9756dd-4363-4d10-9a9a-6f465af3014c"],
 ": the Riemann irreducible representation is two-dimensional."
}], "Text",ExpressionUUID->"ec172afd-27aa-43f9-bf9d-eb1af63b6149"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauDimension", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[410]:=",ExpressionUUID->"0503a402-3ecc-4bb8-8de6-9a3de99550d8"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.988838589183044*^9},
 CellLabel->"Out[410]=",
 CellID->452610279,ExpressionUUID->"bc211af1-32bf-4e84-9341-38da7cc6a5db"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The shape is self-conjugate (a square diagram is its own transpose), which \
is why the Riemann irreducible representation sits \"on the diagonal\" of the \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"37facfba-ce9d-4593-8a28-707015a03642"],
 " representation table and does not flip statistics under \
partition-conjugation."
}], "Text",ExpressionUUID->"e4ae5358-77f8-42c1-bb99-1468c902e19b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransposePartition", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[411]:=",ExpressionUUID->"1de23ad2-44f5-40b0-9b38-66bcc77e21c2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "2"}], "}"}]], "Output",
 CellChangeTimes->{3.988838589206463*^9},
 CellLabel->"Out[411]=",
 CellID->633881479,ExpressionUUID->"a8dc0da3-2597-44b5-82f9-319ff67b70e2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The mono-term-only attempt with built-in ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "4e0636bd-949c-4c0f-8cb8-b14fbc18490f"]
}], "Subsubsection",ExpressionUUID->"9fff518c-7b30-40ff-913f-d71a06bfaa38"],

Cell[TextData[{
 StyleBox["Built-in ", "TI"],
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "c53c1de7-8a9d-491d-a6c2-8b6ac9f91694"],
 StyleBox[" with the three mono-term Riemann pair generators leaves an ", 
  "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", "1", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d0967f29-a05e-4026-8523-ec91226693c2"],
 StyleBox[" Bianchi residue: the boundary the Symmetry functions exist to \
cross.", "TI"]
}], "Text",ExpressionUUID->"d2d75657-7deb-40e7-91dd-0c66ecbcc743"],

Cell[CellGroupData[{

Cell[TextData[{
 "Take a generic rank-4 tensor in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"15e8d87b-ac01-4523-8779-b05c6f08c37f"],
 "."
}], "Text",ExpressionUUID->"8d92ebd4-cadb-4508-909f-119d676f3d6b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T0", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4", ",", " ", "4", ",", " ", "4"}], "}"}]}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[412]:=",ExpressionUUID->"9f4ef837-5788-4645-b46f-537bbd3f56ff"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The three pair symmetries (the mono-term part of the Riemann conditions) \
lift directly into a built-in ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "bda7c2d4-39a3-4254-977d-2db89527bb66"],
 " generator list."
}], "Text",ExpressionUUID->"beb1ac12-7580-437e-9140-607aad2efd44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"riemannGens", " ", "=", " ", 
   RowBox[{"{", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cycles", "[", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], "}"}], "]"}], ",", "         ", 
       RowBox[{"-", "1"}]}], "}"}], ",", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"antisym", " ", "in", " ", 
       RowBox[{"(", 
        RowBox[{"1", ",", "2"}], ")"}]}], " ", "*)"}], "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cycles", "[", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], "}"}], "]"}], ",", "         ", 
       RowBox[{"-", "1"}]}], "}"}], ",", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"antisym", " ", "in", " ", 
       RowBox[{"(", 
        RowBox[{"3", ",", "4"}], ")"}]}], " ", "*)"}], "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cycles", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}], ",", "  ", 
       "1"}], "}"}]}], "    ", 
    RowBox[{"(*", " ", 
     RowBox[{"pair", "-", "swap"}], " ", "*)"}], "\n", "}"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[414]:=",ExpressionUUID->"661e2694-c950-4079-996b-51aefb802829"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Apply the built-in projector to obtain a mono-term-symmetrised rank-4 tensor.\
\
\>", "Text",ExpressionUUID->"8e84df60-f665-4e9c-b0bc-84775adbd7ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Rmono", " ", "=", " ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"Symmetrize", "[", 
     RowBox[{"T0", ",", " ", "riemannGens"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[415]:=",ExpressionUUID->"5b66c7bf-11ec-4bc4-a462-8e8e3e071fa4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Check antisymmetry in the first pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7cf5d474-7e97-46af-8795-37be8f7a4f79"],
 "."
}], "Text",ExpressionUUID->"aee2227a-c267-4c8d-8291-534b1eb1605f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Rmono", " ", "+", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Rmono", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "1", ",", " ", "3", ",", " ", "4"}], "}"}]}], 
       "]"}]}], "]"}], "]"}], "]"}], " ", "<", " ", "tol"}]], "Input",
 CellLabel->
  "In[416]:=",ExpressionUUID->"646b27d8-3085-42b4-a3a3-ce1d0d3eb2e4"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.98883858928168*^9},
 CellLabel->"Out[416]=",
 CellID->2127128433,ExpressionUUID->"9d36dd7d-9357-455b-b2d9-1415d6593836"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Check antisymmetry in the second pair ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"3", ",", "4"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a218876a-15b0-4a75-85c9-d41f86c9d7ae"],
 "."
}], "Text",ExpressionUUID->"58804a9c-778a-4325-99b6-7af7bae9bca6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Rmono", " ", "+", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Rmono", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "4", ",", " ", "3"}], "}"}]}], 
       "]"}]}], "]"}], "]"}], "]"}], " ", "<", " ", "tol"}]], "Input",
 CellLabel->
  "In[417]:=",ExpressionUUID->"dbb4530f-49d5-4698-997a-3752822ad3d1"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988838589306274*^9},
 CellLabel->"Out[417]=",
 CellID->1487301822,ExpressionUUID->"3337432b-f35d-4a80-be4f-beb782533163"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Check pair-swap symmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", ",", "2"}], ")"}], "\[LeftRightArrow]", 
    RowBox[{"(", 
     RowBox[{"3", ",", "4"}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b01040a1-ad38-479a-a1fc-ab7aa8c92ee8"],
 "."
}], "Text",ExpressionUUID->"f199dc51-660b-42f2-b214-cf02b22534ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Rmono", " ", "-", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Rmono", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4", ",", " ", "1", ",", " ", "2"}], "}"}]}], 
       "]"}]}], "]"}], "]"}], "]"}], " ", "<", " ", "tol"}]], "Input",
 CellLabel->
  "In[418]:=",ExpressionUUID->"63846093-8dae-4eb0-974b-63e5f0a2a55a"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.98883858933293*^9},
 CellLabel->"Out[418]=",
 CellID->372071274,ExpressionUUID->"b1e22b25-d7b5-49ad-a78e-815d25a650a6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["All three pass. Now check the first Bianchi identity.", "Text",ExpressionUUID->"9173a523-c5f7-487b-b5fb-f06d75c26023"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{"Flatten", "[", "\n", "    ", 
    RowBox[{"Rmono", " ", "+", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Rmono", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3", ",", " ", "4", ",", " ", "2"}], "}"}]}], 
      "]"}], " ", "+", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Rmono", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4", ",", " ", "2", ",", " ", "3"}], "}"}]}], 
      "]"}]}], "\n", "]"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[419]:=",ExpressionUUID->"cc652e71-aad2-486b-9f2a-42a4b6504125"],

Cell[BoxData["0.6784053898126099`"], "Output",
 CellChangeTimes->{3.98883858935855*^9},
 CellLabel->"Out[419]=",
 CellID->2077005701,ExpressionUUID->"0a368144-bff3-4192-b551-74aee720a5a7"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Built-in ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "0cf96e90-c64b-462a-b2ee-8d4efdd8953d"],
 " produces a tensor with the three pair symmetries, but the Bianchi sum has ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", "1", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"13c83944-229d-468e-94db-d1147441db0c"],
 " residual. No mono-term language can fix this: Bianchi asks three permuted \
copies to sum to zero, which is two relations short of the single-permutation \
form ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "2922d4ec-74a1-4e08-9b4e-20dd4d0e1982"],
 " understands. The corresponding count is visible in ",
 Cell[BoxData[
 "SymmetrizedIndependentComponents"], "InlineFormula",ExpressionUUID->
  "7fcea4af-bb26-4a74-bb3b-9fd2a0cff9b1"],
 ": at dimension 4 with the three mono-term Riemann generators the kernel \
reports 21 independent components, whereas the true number of Riemann \
components (post-Bianchi) is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["n", "TI"], "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["n", "TI"], "2"], "-", "1"}], ")"}], "/", "12", "\[LongEqual]",
     "20"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0943ff55-b09d-4d87-b899-c2522251dfff"],
 ". The single missing relation is Bianchi."
}], "Text",ExpressionUUID->"540022fd-46ef-4215-8a57-eec3864c6812"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The Young-projector solution: discovering the algebraic identities\
\>", "Subsubsection",ExpressionUUID->"01b5146b-7337-4bf3-b9c8-4b0c9bead062"],

Cell[TextData[{
 StyleBox["The four classical Riemann symmetries are not separately ", "TI"],
 "assumed",
 StyleBox[" but ", "TI"],
 "derived",
 StyleBox[" from the ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1f766ed9-addc-479a-9518-ba905e54a4b0"],
 StyleBox[" projector itself. Searching the right-annihilator of ", "TI"],
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e6958d11-efd2-4274-9654-f0d9dbc399b4"],
 StyleBox[" in the group algebra ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     SubscriptBox[
      StyleBox["S", "TI"], "4"], "]"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"37919eca-a173-47ae-b447-147a634565c5"],
 StyleBox[" recovers the textbook first Bianchi identity as one specific \
kernel element, without naming it in advance.", "TI"]
}], "Text",ExpressionUUID->"f90db7c6-aeff-4f8f-b33c-401e9a5d356e"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"53b27163-f661-40f7-aaba-12afef0bb1e4"],
 " Young projector ",
 StyleBox["defines", "TI"],
 " the Riemann irreducible representation: every tensor in its image \
satisfies the four classical Riemann identities by construction. The more \
interesting move is the reverse direction, ",
 StyleBox["deriving those identities from the projector",
  FontWeight->"Bold"],
 ", without listing them in advance. The Symmetry functions make this \
constructive rather than verifying."
}], "Text",ExpressionUUID->"08852704-ae78-4169-a6c4-faf65a8536fe"],

Cell[CellGroupData[{

Cell["\<\
Begin by fixing a slot labelling: build the rank-4 Young tableau whose two \
columns hold the two antisymmetric pairs and whose two rows hold the \
pair-swap-symmetric slots.\
\>", "Text",ExpressionUUID->"a2d7e834-2f0f-4dc9-8e5c-dbab55e7e95c"],

