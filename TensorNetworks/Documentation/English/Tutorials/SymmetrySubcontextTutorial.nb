Cell[CellGroupData[{

Cell[TextData[{
 "The other two cells of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"be48fe25-2cd6-42ab-8130-9471c9b4c2a2"],
 " are corners; each has hook length ",
 Cell[BoxData[
