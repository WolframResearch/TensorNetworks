}, Open  ]]
}, Open  ]],

Cell["\<\
The decomposition is exact, computed without any eigenvalue routine. Each \
Symmetry function plays a distinct role:\
\>", "Text",ExpressionUUID->"67754f4f-95b7-4473-a810-a983affa8654"],

Cell[TextData[{
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "e954a5b1-7965-48d4-9e4c-bfe3cc2817c9"],
 " names each block by its shape."
}], "Item",ExpressionUUID->"64cd947b-3581-4873-9368-ef2f9084ba87"],

Cell[TextData[{
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "a968fe8a-dbfe-4a7c-96eb-07b542cdfe9c"],
 " projects the input tensor onto that block."
}], "Item",ExpressionUUID->"c3cf24ec-fe9d-47c1-ab82-61fbace7ad54"],

Cell[TextData[{
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "a13465b1-8da7-4175-90dc-9ecd23178df1"],
 " counts standard tableaux per shape: the number of ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "37c4474d-0cf1-4204-87f0-7e85d37d8050"],
 " calls to sum into the isotypic ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"df95d81d-4303-4a1a-b5b5-4afb276b0a4a"],
 "."
}], "Item",ExpressionUUID->"c9a7eed5-fdb5-4cdb-b3c2-987ddeb8e0d1"],

Cell[TextData[{
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "dc84b2e8-6bd8-4a3c-8631-e5d319d54e69"],
 " feeds ",
 Cell[BoxData[
 "SchurDimension"], "InlineFormula",ExpressionUUID->
  "4020fa3f-ac2a-4523-af4b-84338fa034a9"],
 " for the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], 
    StyleBox["L", "TI"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1e727b8e-d159-4e52-aacb-91feca4fd3bd"],
 " factor."
}], "Item",ExpressionUUID->"b7f26138-f45a-4666-8c7c-6ef50b2c0999"],

Cell[CellGroupData[{

Cell[TextData[{
 "The projector is insensitive to complex entries: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], "12"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d71198af-7410-4f48-99e0-ad8487277a7e"],
 " relabels slots, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[RightTeeArrow]", 
    SuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e3ce7233-2db6-4c33-93f6-8f075c623758"],
 " is transpose with no conjugation. Repeat on a random complex rank-3 tensor."
}], "Text",ExpressionUUID->"4938017f-1f83-4cbe-a954-80ae7525a32b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "11", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T3c", " ", "=", " ", 
   RowBox[{"RandomComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], " ", "-", " ", "I"}], ",", " ", 
       RowBox[{"1", " ", "+", " ", "I"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2", ",", " ", "2"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[381]:=",ExpressionUUID->"5aa82b95-dda7-41e4-a3bb-6e1b085515ab"]
}, Open  ]],

Cell[CellGroupData[{

