 "."
}], "Text",ExpressionUUID->"e373b544-cf0a-455d-8bf4-8705a7c157c8"],

Cell[CellGroupData[{

Cell[TextData[{
 "Cross-check against an explicit matrix diagonalisation. First, build a \
helper that realises one pair-swap ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bde5f1a5-6b25-48d0-b0d2-62cbbdb69a3d"],
 " as a ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["d", "TI"], "3"], "\[Cross]", 
    SuperscriptBox[
     StyleBox["d", "TI"], "3"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6f893f1d-d772-4a74-b249-cddb72d956ad"],
 " matrix at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"642a3886-ef25-465b-b9ae-f102014f2f3b"],
 "."
}], "Text",ExpressionUUID->"2a3692a9-0018-4646-bab4-87f78d9e9171"],

Cell[BoxData[
 RowBox[{
  RowBox[{"applySwap", "[", 
   RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"perm", " ", "=", " ", 
      RowBox[{"Range", "[", "3", "]"}]}], "}"}], ",", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"perm", "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], "]"}], " ", "=", " ", 
      RowBox[{"perm", "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"b", ",", " ", "a"}], "}"}], "]"}], "]"}]}], ";", "\n", 
     "    ", 
     RowBox[{"ArrayReshape", "[", "\n", "        ", 
      RowBox[{
       RowBox[{"Transpose", "[", "\n", "            ", 
        RowBox[{
         RowBox[{"Normal", " ", "@", " ", 
          RowBox[{"SparseArray", "[", "\n", "                ", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                  "i", ",", " ", "j", ",", " ", "k", ",", " ", "i", ",", " ", 
                   "j", ",", " ", "k"}], "}"}], " ", "->", " ", "1"}], ",", 
                "\n", "                    ", 
                RowBox[{"{", 
                 RowBox[{"i", ",", " ", "2"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"j", ",", " ", "2"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"k", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
              "2"}], "]"}], ",", "\n", "                ", 
            RowBox[{"{", 
             RowBox[{
             "2", ",", " ", "2", ",", " ", "2", ",", " ", "2", ",", " ", "2", 
              ",", " ", "2"}], "}"}]}], "\n", "            ", "]"}]}], ",", 
         "\n", "            ", 
         RowBox[{"Join", "[", 
          RowBox[{"perm", ",", " ", 
           RowBox[{"{", 
            RowBox[{"4", ",", " ", "5", ",", " ", "6"}], "}"}]}], "]"}]}], 
        "\n", "        ", "]"}], ",", "\n", "        ", 
       RowBox[{"{", 
        RowBox[{"8", ",", " ", "8"}], "}"}]}], "\n", "    ", "]"}]}]}], "\n", 
   "]"}]}]], "Input",
 CellLabel->
  "In[462]:=",ExpressionUUID->"0a766e1d-18fe-43d5-ab3d-42d259543813"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Assemble ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["P", "TI"], "12"], "+", 
    SubscriptBox[
     StyleBox["P", "TI"], "13"], "+", 
    SubscriptBox[
     StyleBox["P", "TI"], "23"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f9fb02e0-c792-46c1-95bd-541a3116baff"],
 " as an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Cross]", "8"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d9e55719-a70a-47dc-925d-843a5a01f710"],
 " matrix."
}], "Text",ExpressionUUID->"eaebf2aa-e86c-472a-82ad-9650579b226a"],

