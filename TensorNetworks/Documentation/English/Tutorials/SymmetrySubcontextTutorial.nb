Cell[CellGroupData[{

Cell["Familiar rank-2 tensors and their TN-bond payoffs", "Subsection",ExpressionUUID->"5d995336-7dd0-4d4f-9ff2-9bc2da687a36"],

Cell[TextData[{
 "The two rank-2 tableau classes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2d6a9e71-e9db-4388-9cc7-b250b61c8614"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"29f164fc-5ea9-4672-afe7-97eb2988e5d0"],
 " are nothing exotic: they are every symmetric matrix and every \
antisymmetric matrix you have ever seen. The examples below confirm this on \
textbook tensors (metric, Pauli, EM, Levi-Civita, covariance) and then turn \
the same projection machinery on three operational TN constructs: \
singlet/triplet decomposition, the SWAP-gate eigenspace, and a fermionic bond \
inside a tensor-network contraction. All of them share the rank-2 tableaux ",
 Cell[BoxData[
 "symTab"], "InlineFormula",ExpressionUUID->
  "5227b059-fe01-4c72-98dc-40c1129c048a"],
 " and ",
 Cell[BoxData[
 "antiTab"], "InlineFormula",ExpressionUUID->
  "d7a87199-4385-4386-b31a-aa156aede40d"],
 " and the same ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "13904480-f2b0-4bab-834a-bfa8840221cb"],
 " workflow."
}], "Text",ExpressionUUID->"98aa229f-fd41-4db9-9279-073578504b6d"],

Cell[CellGroupData[{

Cell[TextData[{
 "The four single-qubit operators (identity plus the three Pauli matrices) \
are a clean illustration. Each is a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Cross]", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5134c6f1-8484-4037-b57b-7087e9ae3a3f"],
 " matrix that lies entirely in one of the two shapes:"
}], "Text",ExpressionUUID->"50ca2e90-8523-40d7-a335-a0d1d9fd383e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Id", ",", " ", "sx", ",", " ", "sy", ",", " ", "sz"}], "}"}], 
   " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "j", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", "3"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[256]:=",ExpressionUUID->"c32f55d4-c4a8-463c-a2c9-68892f7fd939"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The identity, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    StyleBox["x", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "add1777d-4f50-4562-ba4e-1f3cc07b2dc7"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    StyleBox["z", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6c2a6cb7-ef97-4d7a-a6d1-e9e7d9b77cbd"],
 " equal their own transpose; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    StyleBox["y", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0285125e-a9a5-48c2-816f-3c6b976e66f0"],
 " negates under transpose:"
}], "Text",ExpressionUUID->"2592ac4f-0d0e-4bd8-b375-eb73e2f57274"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Id", " ", "==", " ", 
    RowBox[{"Transpose", "[", "Id", "]"}]}], ",", " ", 
   RowBox[{"sx", " ", "==", " ", 
    RowBox[{"Transpose", "[", "sx", "]"}]}], ",", " ", 
   RowBox[{"sy", " ", "==", " ", 
    RowBox[{"-", 
     RowBox[{"Transpose", "[", "sy", "]"}]}]}], ",", " ", 
   RowBox[{"sz", " ", "==", " ", 
    RowBox[{"Transpose", "[", "sz", "]"}]}]}], "}"}]], "Input",
 CellLabel->
  "In[257]:=",ExpressionUUID->"136ff9fc-adc1-41a6-ac4d-43b88cbb63db"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.9888385865764112`*^9},
 CellLabel->"Out[257]=",
 CellID->2067020300,ExpressionUUID->"7a4bab3d-a659-4620-bbbe-b7ad1e58334c"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "So the four-element Pauli basis splits as three matrices in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "feef4f06-2655-4a93-9236-ef51071ae42d"],
 " shape (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["I", "TI"], ",", 
    SubscriptBox["\[Sigma]", 
     StyleBox["x", "TI"]], ",", 
    SubscriptBox["\[Sigma]", 
     StyleBox["z", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ff316756-ed9d-4609-9ec8-01b2fcf8c681"],
 ") and one in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8a952e9e-fc9c-4b15-a489-9e02574dcba4"],
 " shape (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    StyleBox["y", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8bfb0a03-4d22-46a1-8c08-06ae9a218ff1"],
 "). That matches the Schur-Weyl dimensions exactly: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "+", "1"}], ")"}], "/", "2", "\[LongEqual]", "3"}],
    TraditionalForm]], "InlineFormula",ExpressionUUID->
  "92b815ac-51a0-477c-bf8f-bf961180dab8"],
 " symmetric matrices plus ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "-", "1"}], ")"}], "/", "2", "\[LongEqual]", "1"}],
    TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a985a4e6-3c5e-4ef6-8da7-d29f2180401e"],
 " antisymmetric matrix gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["d", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bb61de5d-293c-4c18-aa5d-086ce6498a9e"],
 " total."
}], "Text",ExpressionUUID->"0799cb33-a002-4490-b7ff-ee5a15a48d34"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "25b1f1c4-eeee-4ecd-b41b-06baf6663a4c"],
 " applied to a tensor that already lives in one shape is a sanity check: the \
right-shape projection is the identity on that tensor, the wrong-shape \
projection is zero. Name the symmetric two-box tableau."
}], "Text",ExpressionUUID->"fa6c8cdc-1c98-47f9-9107-e99f01ec4521"],

Cell[BoxData[
 RowBox[{
  RowBox[{"symTab", " ", "=", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", "2", "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[258]:=",ExpressionUUID->"21a0e62d-f1b0-4de9-849c-59a68b7abb22"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Name the antisymmetric two-box tableau.", "Text",ExpressionUUID->"d4d6c2d3-c70e-4ffa-a050-d0df52852b00"],

Cell[BoxData[
 RowBox[{
  RowBox[{"antiTab", " ", "=", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[259]:=",ExpressionUUID->"22ed5231-ad1c-4df5-a4fb-85417aa6f2c2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "A ",
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", "...", "]"}]], "InlineFormula",ExpressionUUID->
  "d0039d33-2098-49ee-b1bf-456ecaba85e0"],
 " is atomic, so explicit accessors are the only way to read off its row and \
column structure. ",
 Cell[BoxData[
 "TableauRows"], "InlineFormula",ExpressionUUID->
  "be00bec3-7502-4460-bc11-fda6c120b5a4"],
 " returns the list of row-slot lists; ",
 Cell[BoxData[
 "TableauColumns"], "InlineFormula",ExpressionUUID->
  "46ee8bcc-95a9-4a20-bc14-23816947d8ad"],
 " returns the list of column-slot lists (correctly handling ragged shapes). \
These are the inputs ",
 Cell[BoxData[
 "YoungSymmetrize"], "InlineFormula",ExpressionUUID->
  "e36b6b04-8421-48a3-8966-eeb48e9d435c"],
 " and ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "898edaa6-a204-409b-a4a8-75f237d1c734"],
 " consume internally. Read the symmetric tableau's row and column lists."
}], "Text",ExpressionUUID->"04f76cc1-020b-44da-ab47-3f5183217264"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"TableauRows", "[", "symTab", "]"}], ",", " ", 
   RowBox[{"TableauColumns", "[", "symTab", "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[260]:=",ExpressionUUID->"1f4409e9-a5de-41a7-8c24-1b85579f0a02"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", "2", "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988838586624837*^9},
 CellLabel->"Out[260]=",
 CellID->567224581,ExpressionUUID->"ca5f0090-dc0a-474f-9a08-8d6851b0623a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Read the antisymmetric tableau's row and column lists.", "Text",ExpressionUUID->"7221dd58-04f6-4604-8145-09fd3b614934"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"TableauRows", "[", "antiTab", "]"}], ",", " ", 
   RowBox[{"TableauColumns", "[", "antiTab", "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[261]:=",ExpressionUUID->"48ab3c30-25d2-4975-9227-55e9addd8fc1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", "2", "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9888385866488237`*^9},
 CellLabel->"Out[261]=",
 CellID->663623834,ExpressionUUID->"f8763a3d-7411-455a-97c3-d7b9c589ef5d"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Note the row-column swap between ",
 Cell[BoxData[
 "symTab"], "InlineFormula",ExpressionUUID->
  "9c388038-6903-454f-ace8-682d86f9caed"],
 " and ",
 Cell[BoxData[
 "antiTab"], "InlineFormula",ExpressionUUID->
  "f239e35e-8bc3-4aef-9b4c-ac117c183de3"],
 ": transposing the partition (",
 Cell[BoxData[
  RowBox[{"{", "2", "}"}]], "InlineFormula",ExpressionUUID->
  "9afa9fa5-5969-49f0-8e76-7f0c39520d0c"],
 " \[LeftRightArrow] ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "1"}], "}"}]], "InlineFormula",ExpressionUUID->
  "bf297db6-d403-4b2c-a82e-806e43c9db59"],
 ") swaps the row and column slot lists, which is exactly the \"exchange \
symmetric for antisymmetric\" mirror visible at the structural level."
}], "Text",ExpressionUUID->"14e5cfe1-dc63-4535-8cbf-db5610e81f18"],

Cell[CellGroupData[{

Cell[TextData[{
 "Before turning these tableaux loose on real tensors, sanity-check that both \
are well-formed standard tableaux. The ",
 Cell[BoxData[
 "YoungTableauQ"], "InlineFormula",ExpressionUUID->
  "31b0854d-1c0c-4d22-9c29-a07570eaa986"],
 " predicate is the gatekeeper: it rejects ill-formed entries (already shown \
in the constructor section above) and accepts the well-formed ones. Check the \
symmetric tableau."
}], "Text",ExpressionUUID->"74542fa6-982d-4bff-abb9-da5a1c3a5968"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableauQ", "[", "symTab", "]"}]], "Input",
 CellLabel->
  "In[262]:=",ExpressionUUID->"ac8c800f-2b1d-4e8d-b9de-5df05c54b967"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988838586664344*^9},
 CellLabel->"Out[262]=",
 CellID->1643199167,ExpressionUUID->"ef4432d0-e8f5-4116-9341-34acb17706f7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Check the antisymmetric tableau.", "Text",ExpressionUUID->"49157499-1f49-46e2-879e-aa85648e0067"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableauQ", "[", "antiTab", "]"}]], "Input",
 CellLabel->
  "In[263]:=",ExpressionUUID->"8dc6b936-4bd7-47c6-b026-4e7a6fb41f6d"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9888385866857977`*^9},
 CellLabel->"Out[263]=",
 CellID->608699349,ExpressionUUID->"76247414-f797-4103-a83d-d1bca8793eb3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Both pass. Next, read off the structural numbers each tableau carries. ",
 Cell[BoxData[
 "TableauShape"], "InlineFormula",ExpressionUUID->
  "4da4d54f-afda-4b3e-b1be-1c7a1f32e4d0"],
 " returns the underlying partition; ",
 Cell[BoxData[
 "TableauSize"], "InlineFormula",ExpressionUUID->
  "c9bb255c-7748-411a-83a6-a1426fa77d4c"],
 " returns the total box count, which is the rank of any tensor the tableau \
can act on. Read the symmetric tableau's partition."
}], "Text",ExpressionUUID->"93f16876-4e70-4980-921a-e73d1314616d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauShape", "[", "symTab", "]"}]], "Input",
 CellLabel->
  "In[264]:=",ExpressionUUID->"3fc92edf-50fc-4b75-9423-5a1b7badcffb"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output",
 CellChangeTimes->{3.988838586704565*^9},
 CellLabel->"Out[264]=",
 CellID->1945347982,ExpressionUUID->"522c852e-2c19-4414-99e2-4d70bf8ea676"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Read its box count.", "Text",ExpressionUUID->"cb643839-e212-4e49-9369-140ef88af341"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauSize", "[", "symTab", "]"}]], "Input",
 CellLabel->
  "In[265]:=",ExpressionUUID->"acf5290f-1cfd-41be-8d52-425a5f08a75f"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.9888385867291307`*^9},
 CellLabel->"Out[265]=",
 CellID->25007899,ExpressionUUID->"265a1b9e-620a-4336-91c4-b4008e98ff8a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Read the antisymmetric tableau's partition.", "Text",ExpressionUUID->"324172eb-149d-4204-8549-0610615dc8c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauShape", "[", "antiTab", "]"}]], "Input",
 CellLabel->
  "In[266]:=",ExpressionUUID->"78725450-5462-4202-bb0b-afcf9eca5636"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{3.9888385867451982`*^9},
 CellLabel->"Out[266]=",
 CellID->1548447328,ExpressionUUID->"99cab79f-e2d9-49e1-8f16-c1de31f3cc57"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Read its box count.", "Text",ExpressionUUID->"c3a61718-36da-42e8-934e-ec402e9d5282"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauSize", "[", "antiTab", "]"}]], "Input",
 CellLabel->
  "In[267]:=",ExpressionUUID->"8f50ee57-abcd-44e2-b7ca-92a191a7ee5a"],

Cell[BoxData["2"], "Output",
 CellChangeTimes->{3.9888385867707033`*^9},
 CellLabel->"Out[267]=",
 CellID->1547407350,ExpressionUUID->"593f4943-87a8-4c81-862a-ca94fb675b02"]
}, Open  ]]
}, Open  ]],

Cell["\<\
Both tableaux carry two boxes, so they act on rank-2 tensors. Every concrete \
example in the rest of this section is a rank-2 tensor, so this constraint is \
automatically met; later sections that work with rank-3 and rank-4 tensors \
will need different tableaux of the matching size.\
\>", "Text",ExpressionUUID->"d56c60a0-ff06-4bbb-935e-91602f901084"],

Cell[CellGroupData[{

Cell[TextData[{
 "Project ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    StyleBox["x", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f0cba0db-fc1e-4e33-8720-1a4c683be203"],
 " onto the symmetric shape; the result is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    StyleBox["x", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c92e6e8d-3c62-45d4-a8ee-7525bb080f05"],
 " itself."
}], "Text",ExpressionUUID->"39f7cc9e-ead3-4dc8-a7f4-3d0aa5424c6b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungProject", "[", 
  RowBox[{"sx", ",", " ", "symTab"}], "]"}]], "Input",
 CellLabel->
  "In[268]:=",ExpressionUUID->"05393a54-fa9e-433c-9c9e-8b7b66bc417b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988838586786311*^9},
 CellLabel->"Out[268]=",
 CellID->1248366280,ExpressionUUID->"c0923ad2-1abc-4820-b569-efc6cc8d49ab"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Project ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    StyleBox["x", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d9ccf0e5-7327-4856-b867-e3e121effaff"],
 " onto the antisymmetric shape; the result vanishes."
}], "Text",ExpressionUUID->"92360110-33fa-435c-9dae-c8f1d0bff675"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungProject", "[", 
  RowBox[{"sx", ",", " ", "antiTab"}], "]"}]], "Input",
 CellLabel->
  "In[269]:=",ExpressionUUID->"6f33162c-4722-404b-a005-623a4ef89c4a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988838586810753*^9},
 CellLabel->"Out[269]=",
 CellID->376836770,ExpressionUUID->"7921a7b4-3b84-4945-ba4d-e28434f5c4ab"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Project ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    StyleBox["y", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3d37a948-2f49-4410-a56c-054b4e7c8556"],
 " onto the antisymmetric shape; the result is ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    StyleBox["y", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2e93c374-cc43-487d-be5d-e04267c41c9c"],
 " itself."
}], "Text",ExpressionUUID->"6d8c28a3-4f18-415e-9b00-2ff99c2e25e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungProject", "[", 
  RowBox[{"sy", ",", " ", "antiTab"}], "]"}]], "Input",
 CellLabel->
  "In[270]:=",ExpressionUUID->"46f7ca4d-70b1-4511-a26a-40031dc68117"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"-", "\[ImaginaryI]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[ImaginaryI]", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988838586828813*^9},
 CellLabel->"Out[270]=",
 CellID->566318387,ExpressionUUID->"b5e2e860-240e-46ed-ad3a-7d401238ebb1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Project ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    StyleBox["y", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "627348da-f424-472e-9e78-ad4129a98297"],
 " onto the symmetric shape; the result vanishes."
}], "Text",ExpressionUUID->"e6379cef-01f6-4e50-a96c-2cc6275c2f78"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungProject", "[", 
  RowBox[{"sy", ",", " ", "symTab"}], "]"}]], "Input",
 CellLabel->
  "In[271]:=",ExpressionUUID->"4c8eb740-0fd7-41bd-b30a-bc0093aacec3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988838586851324*^9},
 CellLabel->"Out[271]=",
 CellID->465606805,ExpressionUUID->"94e28b52-5f72-4a6e-bc8c-6e73e992c0cd"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Alongside the projector ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "39c6d129-e748-45c5-abe7-1f8bce797847"],
 ", the Symmetry functions also expose the unnormalised Young symmetriser ",
 Cell[BoxData[
 "YoungSymmetrize"], "InlineFormula",ExpressionUUID->
  "0c955b79-f53b-4786-b38b-be6d18944fc6"],
 ", which returns ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["T", "TI"]], "\[CenterDot]", 
    StyleBox["T", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "add0f11c-e45c-4a68-a400-d0b19766234e"],
 " instead of the projector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox["T", "TI"]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["d", "TI"], "\[Lambda]"], "/", 
      StyleBox["n", "TI"], "!"}], ")"}], " ", 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5105644c-5611-4bec-a41b-d52ff65fb28a"],
 ". For a rank-2 tensor and the symmetric tableau, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["c", "TI"], 
     RowBox[{"{", "2", "}"}]], "\[LongEqual]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"d665d12f-10f0-490c-b07f-e712b899c1a8"],
 " row-stabiliser order ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LongEqual]", 
    RowBox[{"2", "!"}], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c5456fe2-b442-4f6f-9b1b-56b1c7059ecd"],
 ", so the unnormalised version is twice the projection."
}], "Text",ExpressionUUID->"df2bc926-3314-4e00-b44a-fe13384e24d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"YoungSymmetrize", "[", 
   RowBox[{"sx", ",", " ", "symTab"}], "]"}], " ", "==", " ", 
  RowBox[{"2", " ", "*", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"sx", ",", " ", "symTab"}], "]"}]}]}]], "Input",
 CellLabel->
  "In[272]:=",ExpressionUUID->"2b7803d6-b93c-4615-af89-bb118851df91"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.98883858686701*^9},
 CellLabel->"Out[272]=",
 CellID->23161967,ExpressionUUID->"c6c4b567-9c00-4a17-94af-ebe50cb5ae83"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Under the hood ",
 Cell[BoxData[
 "YoungSymmetrize"], "InlineFormula",ExpressionUUID->
  "6fca972c-7605-4be7-bdd1-58a973203a6f"],
 " is built directly on built-in WL's ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "a949774e-74c9-4fb1-9f39-43302c4f12e7"],
 ": it calls ",
 Cell[BoxData[
  RowBox[{"Symmetrize", "[", 
   RowBox[{"T", ",", " ", 
    RowBox[{"Symmetric", " ", "/@", " ", 
     RowBox[{"TableauRows", "[", "tab", "]"}]}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"1f445b1b-66be-48e0-b05a-204971d98ca8"],
 " (row symmetrisation) then ",
 Cell[BoxData[
  RowBox[{"Symmetrize", "[", 
   RowBox[{"...", ",", " ", 
    RowBox[{"Antisymmetric", " ", "/@", " ", 
     RowBox[{"TableauColumns", "[", "tab", "]"}]}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"93a7c6c4-6868-4cce-baaf-2a0056fe2115"],
 " (column antisymmetrisation), scaled by the row- and column-stabiliser \
orders to undo ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "b64ecf01-b25e-4e34-8203-d43852a37343"],
 "'s built-in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "|", 
    StyleBox["G", "TI"], "|"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0591c7b3-ab42-4eda-95ba-f76e8fa573bf"],
 " normalisation. The two ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "68ab968a-3fd5-4b3a-a9b1-77bc0974f98f"],
 " calls compose because rows and columns of a Young tableau touch disjoint \
slot sets."
}], "Text",ExpressionUUID->"963bf35c-7d3b-496c-a7b3-8a9498839ece"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"YoungSymmetrize", "[", 
   RowBox[{"sx", ",", " ", "symTab"}], "]"}], " ", "==", " ", 
  RowBox[{"2", " ", "*", " ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"Symmetrize", "[", 
     RowBox[{"sx", ",", " ", 
      RowBox[{"Symmetric", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]}], "]"}]}]}]}]], "Input",
 CellLabel->
  "In[273]:=",ExpressionUUID->"63daaeec-5969-4e11-9cce-4926f3a71b7c"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9888385868907013`*^9},
 CellLabel->"Out[273]=",
 CellID->588639262,ExpressionUUID->"9e679e92-59c4-4961-8469-1a9506efb514"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The two projections decompose any rank-2 tensor: their sum returns the \
original. This is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7cc2fb75-5c5e-4b71-ac4b-f43af0189d68"],
 " instance of the general fact that on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c562ca39-2bf4-4f11-9812-8edb7339a0be"],
 " the sum of isotypic projectors over all partitions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[RightTee]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7773f32d-40a8-492f-ae76-d52546b5db61"],
 " is the identity."
}], "Text",ExpressionUUID->"26e1e2b3-66e2-4769-9bb5-254f02f3d061"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"YoungProject", "[", 
    RowBox[{"sx", ",", " ", "symTab"}], "]"}], " ", "+", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"sx", ",", " ", "antiTab"}], "]"}]}], " ", "==", " ", 
  "sx"}]], "Input",
 CellLabel->
  "In[274]:=",ExpressionUUID->"28571e89-b091-4e82-a210-979ec6d0fad6"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988838586907632*^9},
 CellLabel->"Out[274]=",
 CellID->1950398352,ExpressionUUID->"d5ef5c4c-8a41-44e7-a5fd-fe3a91ab3db4"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "A short census of rank-2 tensors the reader has seen and the shape each one \
lives in follows. Each entry uses the same four-step pattern: build the \
tensor, test the right-shape projection against the original with ",
 Cell[BoxData["=="], "InlineFormula",ExpressionUUID->
  "6752bc96-a983-4481-b658-7f18e4f4da88"],
 " (returns ",
 Cell[BoxData[
 "True"], "InlineFormula",ExpressionUUID->
  "3643b943-d311-4fb4-a18d-90e67118a5e6"],
 ", confirming the tensor lives there), evaluate the wrong-shape projection \
alone (returns the zero matrix, confirming the orthogonal sector is empty), \
and read the symmetry class with the built-in detector. Anything mixed would \
split into a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "85f3912b-2bfa-4ab3-9a04-00bb78f25944"],
 "-piece and a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"58f2a09c-d64f-45ff-b2d3-02b5ec08d718"],
 "-piece that ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "3f1d9e78-4738-496f-9e74-ef0313bb4be0"],
 " decomposes; the census examples are all single-shape, so one of the two \
cells is trivially zero by construction."
}], "Text",ExpressionUUID->"8293ccec-f9f0-4893-a56c-cb6bfc70aa1f"],

Cell[CellGroupData[{

Cell[TextData[{
 "Minkowski metric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["g", "TI"], "\[Mu]\[Nu]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0e9105df-dbf7-401d-a455-8848e53539e6"]
}], "Subsubsection",ExpressionUUID->"5bb3d567-b15e-43f4-9075-3db37e0bd361"],

Cell[TextData[{
 StyleBox["The metric of flat spacetime is symmetric by definition: ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["g", "TI"], "\[Mu]\[Nu]"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["g", "TI"], "\[Nu]\[Mu]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"24a85d23-f870-49a3-bc0d-fe0550ac3088"],
 StyleBox[" encodes distance, which is reciprocal. ", "TI"],
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "48bd027d-2300-4bd5-a9d7-6eaedb95fc7a"],
 StyleBox[" lands ", "TI"],
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7bd6f45c-bc71-4b25-8d5a-53d79d5c399d"],
 StyleBox[" entirely in the symmetric ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ded7cee1-2d4f-456c-89a7-5d7f560b6c3e"],
 StyleBox[" class with zero antisymmetric residue, the canonical first sanity \
check that the projector is wired correctly.", "TI"]
}], "Text",ExpressionUUID->"37d511fe-f124-4412-9c87-7cdf3de12a2c"],

Cell[CellGroupData[{

Cell[TextData[{
 "The Minkowski metric is a diagonal matrix with signature ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"-", ",", "+", ",", "+", ",", "+"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b15d7505-59e7-4cdc-86a2-4d932a94580b"],
 "."
}], "Text",ExpressionUUID->"d9f87162-9443-433a-b238-d8df6b661c3e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g", " ", "=", " ", 
  RowBox[{"DiagonalMatrix", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}],
    "]"}]}]], "Input",
 CellLabel->
  "In[275]:=",ExpressionUUID->"8cbae0e8-c948-4e9f-9be7-ab5e49c109a8"],

