 Cell[BoxData[
  RowBox[{"ZeroSymmetric", "[", 
   RowBox[{"{", "slots", "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "1509ca95-0f80-41b5-b2ad-df51ac278f12"],
 ","
}], "Item",ExpressionUUID->"85f6256b-ce3b-430b-8da0-8de18d30fbb6"],

