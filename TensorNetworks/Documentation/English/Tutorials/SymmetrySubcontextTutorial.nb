    StyleBox["d", "TI"], "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e34a9676-fa5e-44f1-9724-20c52e9dda25"],
 "."
}], "Text",ExpressionUUID->"6ef733b4-7cd2-4721-9c5f-97426918a896"],

Cell[BoxData[{
 RowBox[{
