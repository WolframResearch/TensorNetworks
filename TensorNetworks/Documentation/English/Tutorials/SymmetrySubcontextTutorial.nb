   SubscriptBox[
    StyleBox["T", "TI"], "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"daf98313-f502-40b5-a6ae-de85d83aac16"],
 " (resolution of identity)."
}], "Text",ExpressionUUID->"9c0a053b-48ed-4e54-bb76-1750b4990504"],

