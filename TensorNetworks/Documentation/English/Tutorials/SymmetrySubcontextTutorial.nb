Cell[CellGroupData[{

Cell[TextData[{
 "Electromagnetic field tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["F", "TI"], "\[Mu]\[Nu]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e09415ee-fb07-4e9d-b0df-70b8965a2fd1"],
 " (from a 4-potential)"
}], "Subsubsection",ExpressionUUID->"754182ec-b727-4f4a-bb3b-2c6433fbc1a1"],

Cell[TextData[{
 StyleBox["The electromagnetic field tensor is built as ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["F", "TI"], "\[Mu]\[Nu]"], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", "\[Mu]"], 
    SubscriptBox[
     StyleBox["A", "TI"], "\[Nu]"], "-", 
    SubscriptBox["\[PartialD]", "\[Nu]"], 
    SubscriptBox[
     StyleBox["A", "TI"], "\[Mu]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e4766118-4d71-4cde-bd18-199b94294d6f"],
 StyleBox[", antisymmetric by construction (three ", "TI"],
 Cell[BoxData[
  FormBox[
   StyleBox["E", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "04ddd846-28dc-4b71-855c-db621b5ade5e"],
 StyleBox["-components, three ", "TI"],
 Cell[BoxData[
  FormBox[
   StyleBox["B", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "53cf80da-c36a-42e6-ba53-76a4c541eb7d"],
 StyleBox["-components). ", "TI"],
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "3529d903-fe11-45a8-9ebe-3127e0375ddf"],
 StyleBox[" confirms it lives entirely in the ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"db1f900a-4b08-4cbd-906b-12ea5af95a9b"],
 StyleBox[" class, the structural reason the EM field has six independent \
components in 4D rather than sixteen.", "TI"]
}], "Text",ExpressionUUID->"8d3f497f-1fd1-49db-8e2b-d8a6b5e63fa9"],

Cell[CellGroupData[{

Cell[TextData[{
 "The EM field tensor is the antisymmetrised Jacobian of a 4-potential, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["F", "TI"], "\[Mu]\[Nu]"], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", "\[Mu]"], 
    SubscriptBox[
     StyleBox["A", "TI"], "\[Nu]"], "-", 
    SubscriptBox["\[PartialD]", "\[Nu]"], 
    SubscriptBox[
     StyleBox["A", "TI"], "\[Mu]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3dfa035f-cea8-41f5-bf7e-b4e3643663f8"],
 "."
}], "Text",ExpressionUUID->"a0949443-f1e0-4b00-b750-e0f009eaab64"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coords", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"Through", "[", 
    RowBox[{
     RowBox[{"Array", "[", 
      RowBox[{"a", ",", " ", "4"}], "]"}], "[", 
     RowBox[{"Sequence", " ", "@@", " ", "coords"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"J", " ", "=", " ", 
   RowBox[{"Grad", "[", 
    RowBox[{"A", ",", " ", "coords"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"F", " ", "=", " ", 
   RowBox[{
    RowBox[{"Transpose", "[", "J", "]"}], " ", "-", " ", "J"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[293]:=",ExpressionUUID->"3ff4378b-0887-4166-9c2c-1b7be6e2e5f6"]
}, Open  ]],

