      RowBox[{"1", ",", "1", ",", "1"}], "}"}], ")"}], "\[LongEqual]", "0", "-",
     "1", "-", "2", "\[LongEqual]", 
    RowBox[{"-", "3"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d57b5982-2844-4edb-901f-bbd195074385"],
 ". Together with the block multiplicities from the Schur-Weyl example \
earlier, ",
 StyleBox["this is the full spectrum of ", "TI"],
