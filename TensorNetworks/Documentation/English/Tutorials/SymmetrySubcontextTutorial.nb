 RowBox[{
  RowBox[{"d", " ", "=", " ", "6"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"M1", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"M2", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[349]:=",ExpressionUUID->"96524d76-0f48-4701-a0a9-011dd764d431"]
}, Open  ]],

