      RowBox[{"2", ",", "1", ",", "3", ",", "4"}], "}"}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.988838589764394*^9},
 CellLabel->"Out[428]=",
 CellID->1943528206,ExpressionUUID->"904c2e46-3c0b-4754-be2c-3a8d402c123a"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The three textbook generators (slot ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6920f8f5-791e-41a6-8553-2ae72069df24"],
 " antisym, slot ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"3", ",", "4"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8b984fb8-d980-48bd-a5b4-3fabba3e77c1"],
 " antisym, pair-swap) are present in the discovered list, but not \
privileged: the projector treats all 84 derived two-term identities on equal \
footing."
}], "Text",ExpressionUUID->"ad227fca-21c3-49be-9f98-9b8db929b003"],

Cell[CellGroupData[{

Cell[TextData[{
 "Now sweep three-term identities ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", 
     StyleBox["a", "TI"]], "+", 
    SubscriptBox["\[Sigma]", 
     StyleBox["b", "TI"]], "+", 
    SubscriptBox["\[Sigma]", 
     StyleBox["c", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f9efde3b-e2d9-482b-9229-3c0fa7aee89a"],
 " supported on permutations that fix slot 1 (i.e. act non-trivially only on \
slots ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8f0ae2c1-8fc0-4e69-b705-e2c68d4e7570"],
 "). The Bianchi identity will appear here without our naming it. The \
slot-1-fixing positions come straight from ",
 Cell[BoxData[
 "Position"], "InlineFormula",ExpressionUUID->
  "14901a32-e686-41a5-8c5a-4ab0e541896c"],
 "; the subset enumerator is ",
 Cell[BoxData[
  RowBox[{"Subsets", "[", 
   RowBox[{"*", 
    RowBox[{",", " ", 
     RowBox[{"{", "3", "}"}]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f5704e02-8778-4758-bd66-3ebe1945d411"],
 "."
}], "Text",ExpressionUUID->"9ec42d96-4b9e-4240-ac2b-c9cb42b5e5d7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fixSlot1", " ", "=", " ", 
   RowBox[{"Flatten", " ", "@", " ", 
    RowBox[{"Position", "[", 
     RowBox[{"perms", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "_", ",", " ", "_", ",", " ", "_"}], "}"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"threeTerm", " ", "=", " ", 
   RowBox[{"Cases", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Subsets", "[", 
      RowBox[{"fixSlot1", ",", " ", 
       RowBox[{"{", "3", "}"}]}], "]"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a_", ",", " ", "b_", ",", " ", "c_"}], "}"}], " ", "/;", " ", 
       RowBox[{"isRelation", "[", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"b", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"c", " ", "->", " ", "1"}]}], "}"}], ",", " ", "24"}], 
         "]"}], "]"}]}], " ", ":>", "\n", "        ", 
      RowBox[{"perms", "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], "]"}], "]"}]}]}],
     "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"Length", "[", "threeTerm", "]"}]}], "Input",
 CellLabel->
  "In[429]:=",ExpressionUUID->"1c400a92-4e65-4bde-98c6-c94e4cbbef7c"],

Cell[BoxData["2"], "Output",
