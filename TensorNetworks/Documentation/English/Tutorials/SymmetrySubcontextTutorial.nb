Cell[CellGroupData[{

Cell["\<\
The full trace equals the sum of only the two same-shape block traces.\
\>", "Text",ExpressionUUID->"a955691a-ec9d-478f-8a4a-9fd33804ac4f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"fullTrace", " ", "-", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{"Ms1", " ", ".", " ", "Ms2"}], "]"}], " ", "+", " ", 
     RowBox[{"Tr", "[", 
      RowBox[{"Ma1", " ", ".", " ", "Ma2"}], "]"}]}], ")"}]}], "]"}]], "Input",\

 CellLabel->
  "In[360]:=",ExpressionUUID->"3d04149d-a81d-466c-92af-ba70990da912"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.9888385882155046`*^9},
 CellLabel->"Out[360]=",
 CellID->1066690882,ExpressionUUID->"d4370e1c-ef67-4321-a6b5-0c40445613c6"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The textbook identity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"t", "r"}], "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["S", "TI"], "\[CenterDot]", 
      StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"4916b5fe-6d38-4c89-ad8d-9b4c58c608ec"],
 " for ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "04d692c9-5427-4a2c-87ce-b02f37705efc"],
 " symmetric and ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f9457091-f9ff-4d87-a2bc-9070309bf6e3"],
 " antisymmetric is the same Schur-orthogonality statement, in one line: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], 
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox[
      RowBox[{"j", "i"}], "TI"]], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox[
      RowBox[{"j", "i"}], "TI"]], 
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox[
      RowBox[{"j", "i"}], "TI"]], "\[LongEqual]", "-", 
    SubscriptBox[
     StyleBox["S", "TI"], 
     StyleBox[
      RowBox[{"j", "i"}], "TI"]], 
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"433ee530-3ff0-48a4-ae2a-0a9c43ca77fd"],
 ", then relabel ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["i", "TI"], "\[LeftRightArrow]", 
    StyleBox["j", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d954ab98-cf3b-404f-89bf-de4925d44362"],
 " to get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"t", "r"}], "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["S", "TI"], "\[CenterDot]", 
      StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", "-", 
    StyleBox[
     RowBox[{"t", "r"}], "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["S", "TI"], "\[CenterDot]", 
      StyleBox["A", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5afe1f21-cfd4-4740-89ad-19507227e167"],
 ". The Symmetry functions turn this into a contraction-path skipping rule: \
whenever a bond connects a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6c318b4c-d721-407b-ac76-2fb4def0eff0"],
 "-typed tensor to a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9c96fe75-a549-4d97-aac7-69b937005d2c"],
 "-typed one, the contribution is zero by construction. At rank 2 this skips \
50% of the block multiplications; the savings grow with rank, as the rank-3 \
example next shows (at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f84bc817-96e0-4621-a3da-806f7be6eb21"],
 " the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"758e129d-ef29-45ca-a530-0ccf26ad43b7"],
 " block is empty, so its contraction is skipped before any data is \
touched)."
}], "Text",ExpressionUUID->"ddb9c9bd-6d34-4ce1-886c-6fbb07f93672"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Beyond rank 2: three higher-rank payoffs", "Section",ExpressionUUID->"c246472d-2148-408e-8c78-f8ccea99e37a"],

Cell[TextData[{
 "Rank 2 admits only two Young diagrams (",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1e60078d-b805-4189-b6c3-a0dd9960554b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"11538948-66eb-4cb1-a79a-5885845a4e27"],
 "), so ",
 Cell[BoxData[
  RowBox[{"IntegerPartitions", "[", "2", "]"}]], "InlineFormula",
  ExpressionUUID->"63e80134-f105-4a4d-9fb6-48b2ae1aac05"],
 ", ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "19619152-55e1-4d52-8683-ed8a88d420e8"],
 ", ",
 Cell[BoxData[
 "HookFactor"], "InlineFormula",ExpressionUUID->
  "7d193bd8-ca31-43b3-8220-28d35377effd"],
 ", ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "dd423821-ddb7-45a3-b79f-41dada02ddf5"],
 ", and ",
 Cell[BoxData[
 "SchurDimension"], "InlineFormula",ExpressionUUID->
  "9f60f789-59c6-44da-9881-85c7230a0b9b"],
 " all return trivially small answers. At rank 3 and above the toolbox \
switches on: partitions of ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3ced6408-6e73-48e7-bc0a-db8b23cb7820"],
 " proliferate (three at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6a22845e-3882-4089-9c34-276c77d22b7e"],
 ", five at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ba7ed47b-7ad7-476c-9ba7-f205ce8fb6f6"],
 ", seven at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "5"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7ae779b1-f2d1-4186-b8ab-2ad54a185cb1"],
 "), each with its own physical interpretation (bosonic, parastatistical, \
fermionic, curvature-like) and bond-dimension growth in ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "026ed2b4-4f4e-4f47-bb21-ee751e4b459f"],
 ". Enumeration, sizing, and projection now require the combinatorial layer \
in earnest. The three sections below exercise it on three orthogonal axes, \
each isolating a qualitative capability that the rank-2 examples could not \
show:"
}], "Text",ExpressionUUID->"e8ff39bc-5740-412b-9cd4-2a9d08a39e74"],

Cell[TextData[{
 "The ",
 StyleBox["Schur-Weyl decomposition on three sites",
  FontWeight->"Bold"],
 " uses the full partition arithmetic at rank 3: how a generic ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a56e708b-62c3-45e7-93e2-cd2805aac401"],
 " three-qubit bond splits into bosonic, parastatistical, and fermionic \
blocks, and how ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"TableauDimension", "[", "par", "]"}], " ", "*", " ", 
   RowBox[{"SchurDimension", "[", 
    RowBox[{"par", ",", " ", "d"}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "2d259485-fa5c-4453-ab74-8b2266701e09"],
 " reads off block sizes before any contraction."
}], "Item",ExpressionUUID->"d5baaec5-db6d-4ae3-829b-86e25b636bb7"],

Cell[TextData[{
 "The ",
 StyleBox["Riemann curvature tensor",
  FontWeight->"Bold"],
 " is the canonical rank-4 example where built-in ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "c16f74ef-d6ca-4ce0-9527-2fa1b835e929"],
 " falls short: the algebraic first Bianchi identity is a multi-term relation \
that no ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Cycles", "[", "...", "]"}], ",", " ", "phase"}], "}"}]], 
  "InlineFormula",ExpressionUUID->"1b309cb1-c7ac-4433-8220-7f13fd143f75"],
 " generator list can express, and it is the explicit content of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a0d19532-9135-457c-b52e-148c0bebeedc"],
 " Young projector. We derive the Bianchi identity from the projector itself \
rather than verifying it post-hoc."
}], "Item",ExpressionUUID->"7d9a49d2-5650-4a57-89b2-eacdf92e1395"],

Cell[TextData[{
 "The ",
 StyleBox["class-function Hamiltonian",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "<", 
      StyleBox["j", "TI"]}],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6fca41af-4015-4874-a079-20fcaebd27d7"],
 " closes the arc. Its full spectrum on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e71fa31f-b3d4-4ab5-a6e3-271fbb2d9d97"],
 " is the content sum ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], "(", "\[Lambda]", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"2922de00-6d86-40df-b1b4-16472291bc6f"],
 " over partitions of ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dba50a6c-edd9-43c3-88c6-e14721c9ceb8"],
 ", with multiplicities ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], "\[CenterDot]", "dim", 
    SubscriptBox[
     StyleBox["W", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"33beb649-c922-4152-8df8-8406a586234f"],
 ". No eigenvalue routine; every spectral line is a closed-form expression in \
the combinatorial functions above."
}], "Item",ExpressionUUID->"d59b2413-6996-45d5-ad64-0a9b592abe18"],

Cell[CellGroupData[{

Cell["\<\
Schur-Weyl on three sites: how a tensor decomposes by symmetry\
\>", "Subsection",ExpressionUUID->"29715cb7-c02b-4c68-8055-918ea922f2ab"],

Cell[TextData[{
 StyleBox["Three indistinguishable particles split into a bosonic block, a \
fermionic block, and a parastatistical mixed-symmetry block: the canonical \
Schur-Weyl decomposition of ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "52cc42e1-056d-4f5c-8cb4-19901a5c51ee"],
 StyleBox[". ", "TI"],
 Cell[BoxData[
 "IntegerPartitions"], "InlineFormula",ExpressionUUID->
  "3dd2435e-1098-4b95-a66a-7b42799c2495"],
 StyleBox[", ", "TI"],
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "da7ce724-5503-44f0-8203-8935620787bf"],
 StyleBox[", and ", "TI"],
 Cell[BoxData[
 "SchurDimension"], "InlineFormula",ExpressionUUID->
  "515834f5-478b-4880-a579-bf57a97dfcdc"],
 StyleBox[" deliver all three block sizes in closed form, and ", "TI"],
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "4ede0b11-3dcc-4844-ab60-b4451df1727b"],
 StyleBox[" produces the actual tensors in each block.", "TI"]
}], "Text",ExpressionUUID->"9a8bce43-5b0e-49f9-be55-f8b54af11417"],

Cell[CellGroupData[{

Cell[TextData[{
 "Take ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["C",
      FontSlant->"Plain"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"dbaf76cc-210a-4b6d-ad03-288528743af7"],
 " and look at the rank-3 tensor space ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "97b8f09d-34ec-4058-a67c-7c83ec535bc1"],
 ". It has dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["n", "TI"]], "\[LongEqual]", 
    SuperscriptBox["2", "3"], "\[LongEqual]", "8"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"47f14374-29bf-4f2b-95ee-99bb8ee5c446"],
 ". The Schur-Weyl theorem says this space splits into pieces labelled by \
partitions of 3 (i.e. irreducible representations of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "3"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0aad0d00-2bcc-4375-a739-2fe20b907e9a"],
 "):"
}], "Text",ExpressionUUID->"3c7c9985-0594-4f41-b77e-354000930509"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    SubscriptBox["\[CirclePlus]", 
     RowBox[{"\[Lambda]", "\[RightTee]", "3"}]], 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], "\[CircleTimes]", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}], "."}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"a946ac63-68f0-4c52-\
8344-cd254ea8b8af"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The three partitions are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "3", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "de8f774b-476b-40c1-bbc8-05e34a914433"],
 " (fully symmetric, bosonic), ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"87e6f0cb-af0b-40d7-a0af-f57f96f19e37"],
 " (mixed symmetry), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"71ba76c7-5f8e-477a-85ee-9bcfd4fd955f"],
 " (fully antisymmetric, fermionic). Each block has dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], "\[CenterDot]", "dim", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"19fca3f9-2488-4fa9-bad1-814470560ae1"],
 ". The first factor is the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c4342560-f9fe-4cf1-b6f7-268c383d2cd2"],
 " irreducible representation dimension; the second is the Weyl dimension \
formula:"
}], "Text",ExpressionUUID->"933038d6-a628-42e9-8ac9-86e0bed86baf"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{"dim", 
    SuperscriptBox[
     StyleBox["S", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], 
      StyleBox["d", "TI"]], ")"}], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    UnderscriptBox["\[Product]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        StyleBox["i", "TI"], ",", 
        StyleBox["j", "TI"]}], ")"}], "\[Element]", "\[Lambda]"}],
     LimitsPositioning->True], 
    FractionBox[
     RowBox[{
      StyleBox["d", "TI"], "+", 
      StyleBox["j", "TI"], "-", 
      StyleBox["i", "TI"]}], 
     RowBox[{
      StyleBox["h", "TI"], "(", 
      RowBox[{
       StyleBox["i", "TI"], ",", 
       StyleBox["j", "TI"]}], ")"}]], "."}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"9d1f10e9-12a7-4156-\
a9af-beddf29b51d4"]
}, Open  ]],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["h", "TI"], "(", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8bf6eb1d-c3c7-4180-bc63-1977521475bb"],
 " is the ",
 StyleBox["hook length", "TI"],
 " of cell ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["i", "TI"], ",", 
     StyleBox["j", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f1ed9189-1c16-4c0c-b296-d2b220a73975"],
 ": the number of cells in its hook (itself, the cells to its right in the \
same row, and the cells below it in the same column), computed below by ",
 Cell[BoxData[
 "HookLength"], "InlineFormula",ExpressionUUID->
  "9e234ea0-1b41-420c-b77d-8a8393dd2522"],
 " and ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "4a8042e9-b19b-427d-a555-4b5d366139c5"],
 "."
}], "Text",ExpressionUUID->"22913bf2-e6cb-474f-953c-24ae23520f83"],

Cell[CellGroupData[{

Cell[TextData[{
 "Enumerate the partitions of ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d61d2d9c-7874-4d67-a0bd-415bb4bf24a7"],
 " with the built-in ",
 Cell[BoxData[
  RowBox[{"IntegerPartitions", "[", "n", "]"}]], "InlineFormula",
  ExpressionUUID->"e5a66aa8-7af5-4729-ad76-5f0772480836"],
 ", which returns them in reverse-lexicographic order (fully symmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox["n", "TI"], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9f41e5fe-2107-4be5-8bd4-dcaf19a55a3c"],
 " first, fully antisymmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "\[Ellipsis]", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"d7c2f165-436a-475a-b3e8-f71a876d525b"],
 " last). The list length is the partition counting function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "(", 
    StyleBox["n", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"29d1f87e-67d1-4304-8a80-dc1519867486"],
 ", equal to the number of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "66f14de9-292f-4d45-93cc-96619245b6a0"],
 " irreducible representations."
}], "Text",ExpressionUUID->"b4a6076e-ea37-4214-acb4-939d4927c6a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"parts", " ", "=", " ", 
  RowBox[{"IntegerPartitions", "[", "3", "]"}]}]], "Input",
 CellLabel->
  "In[361]:=",ExpressionUUID->"5bfb2c44-8adc-418e-a01c-372145c4250e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988838588235323*^9},
 CellLabel->"Out[361]=",
 CellID->680168618,ExpressionUUID->"580fd623-9870-4c7b-bfc4-e99484e4008a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Validate each one is a legal Young-diagram shape (non-increasing, positive \
integers, non-empty).\
\>", "Text",ExpressionUUID->"0711d75e-7812-42cb-95a7-fa26d83e1d73"],

