Cell[CellGroupData[{

Cell[TextData[{
 "The TN payoff is concrete: in block-sparse storage the off-diagonal terms \
are never computed. For two generic tensors the within-sector sums still \
total ",
 Cell[BoxData[
  FormBox["256", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dc4b5a4a-f0cb-421c-9e4a-22a76d5edf16"],
 " multiplications, so no savings. The win appears when a tensor is \
constrained to a single sector. A Riemann-like tensor lives only in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4a0304dd-1d19-473e-b171-7a5113c0e600"],
 " block, so its contraction with any partner only sees the partner's ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bf2761ce-c85b-46c6-a1db-afdcf81fd6bb"],
 " component: a ",
 Cell[BoxData[
  FormBox["40", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "01fdc31d-e6b4-4aa5-91f3-bca27c1fc141"],
 "-multiplication contraction instead of ",
 Cell[BoxData[
  FormBox["256", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2d36044c-5622-427c-9ab9-222ec27cdf08"],
 "."
}], "Text",ExpressionUUID->"efb0c189-3235-47e5-afd7-f350a4859d6f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"T2riemann", " ", "=", " ", 
   RowBox[{"T2blk", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "2"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Total", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"T1", " ", "*", " ", "T2riemann"}], "]"}], "]"}], ",", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"T1blk", "[", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2"}], "}"}], "]"}], " ", "*", " ", 
      "T2riemann"}], "]"}], "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[457]:=",ExpressionUUID->"5f916487-ce64-48c6-9ece-e5603aeebeca"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1.3279028510554916`", ",", "1.327902851055491`"}], "}"}]], "Output",\

 CellChangeTimes->{3.988838590404728*^9},
 CellLabel->"Out[458]=",
 CellID->845351936,ExpressionUUID->"ebdf689c-5433-4c6d-a80a-d8286a19eca2"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Both contractions return the same scalar: only the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6d79295c-26a3-4b20-80ec-c94441eaf3bd"],
 " projection of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T", "TI"], "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f33e0bc8-e800-44c1-859e-3285a6e52812"],
 " contributes when its partner is Riemann-like. That is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6.4", "\[Cross]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c0a7dbe8-62c3-4b58-b7b0-cdde8470e406"],
 " FLOP saving on this single bond contraction, with no approximation. In a \
many-tensor TN of symmetric or curvature-like tensors the per-bond savings \
compound multiplicatively, and the dimension table above tells the \
contraction-path optimiser which sector products to skip before any \
multiplication runs."
}], "Text",ExpressionUUID->"f55d6fc8-dc1d-444f-854e-06c663321616"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["A class-function Hamiltonian and content sums", "Subsection",ExpressionUUID->"0cddc41b-f771-463c-88c9-634df0fe45d3"],

Cell[TextData[{
 StyleBox["A permutation-invariant Hamiltonian ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "<", 
      StyleBox["j", "TI"]}],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b09c4f6d-d94a-4b82-91c1-f28bcbc344a7"],
 StyleBox[" on ", "TI"],
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8d9acc6b-e9f0-48dd-a74f-bbd251c1b91f"],
 StyleBox[" identical sites commutes with every isotypic projector, so its \
spectrum is the list of content sums ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], "(", "\[Lambda]", ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"2ebc2321-dbe3-4c66-9031-8cf39e1c4910"],
 StyleBox[" over partitions of ", "TI"],
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "77c31c5a-1f0f-48fa-9273-48bda4696157"],
 StyleBox[" with multiplicities ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], "\[CenterDot]", "dim", 
    SubscriptBox[
     StyleBox["W", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7169412b-5b4f-40d6-86af-8201e8cb916b"],
 StyleBox[". ", "TI"],
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "f14158cb-a30a-455e-a621-cfa2939099a9"],
 StyleBox[", ", "TI"],
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "c64d73c1-39d3-4d4e-82d4-c3e6ab88af79"],
 StyleBox[", and ", "TI"],
 Cell[BoxData[
 "SchurDimension"], "InlineFormula",ExpressionUUID->
  "8db9e715-40ff-400f-b818-09aef269bf13"],
 StyleBox[" deliver every spectral line and degeneracy in closed form, no \
eigenvalue routine needed.", "TI"]
}], "Text",ExpressionUUID->"b6d9bf81-255d-404a-b99e-2008addbda24"],

Cell[CellGroupData[{

Cell[TextData[{
 "The dimensions alone are useful, but the Symmetry functions also \
pre-compute eigenvalues of Hamiltonians that are ",
 StyleBox["class functions", "TI"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c3ace3a3-e1c4-408e-9900-fb73eb478342"],
 ": operators built from permutations whose value depends only on cycle \
structure. The classic example is the sum of all pair-swaps,"
}], "Text",ExpressionUUID->"645aa7fa-938b-4bb6-9a61-00c1cb10904a"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "<", 
      StyleBox["j", "TI"]}],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"b65cdcae-fa15-48ba-\
8453-ad3393ebd4c4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "acting on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5652930b-ab2e-4dfd-b185-4acc04b10886"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3eb7ae2d-6b7d-40d9-a718-40d28dda9317"],
 " is the swap of the ",
 Cell[BoxData[
  FormBox[
   StyleBox["i", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7499d0d1-02ab-46e4-b1f1-60fb0b92a00d"],
 "th and ",
 Cell[BoxData[
  FormBox[
   StyleBox["j", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a9d1d8f7-e58a-4a53-b3d9-8180ec69fa76"],
 "th tensor factors. By Schur-Weyl, ",
 Cell[BoxData[
  FormBox[
   StyleBox["H", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "99907a59-1a3a-4c0a-8e97-81bf8b730286"],
 " commutes with every isotypic projector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3e55ee85-74a6-4b02-8c9f-1ba123c61850"],
 " and is therefore ",
 StyleBox["constant on each ", "TI"],
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dcd14b86-f41e-4129-a0ff-0f794aa55399"],
 StyleBox["-block", "TI"],
 ". The constant is the ",
 StyleBox["content sum", "TI"],
 " of the partition,"
}], "Text",ExpressionUUID->"2745b2af-9efb-436b-922d-0f47b740578e"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], 
