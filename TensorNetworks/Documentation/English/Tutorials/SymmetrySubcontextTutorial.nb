Cell[CellGroupData[{

Cell[TextData[{
 "The ",
 StyleBox["isotypic", "TI"],
 " projector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b7ad5945-d1c3-4539-b4b5-2e1742476cb6"],
 " is the sum of single-tableau projectors over the standard tableaux of \
shape ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8ff0afa3-2894-4b3d-9842-9be5897321e5"],
 ". It projects onto the full ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d086f4fe-d066-4bb5-8b8f-3358146c6971"],
 " copies of the irreducible representation inside ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", "4"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"195856ec-75ad-4e86-a445-19f9409b754f"],
 ", and the five ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c36598be-4b55-423c-a720-4057d4b95cf4"],
 " together form a resolution of identity."
}], "Text",ExpressionUUID->"2841d21c-04d6-48dd-9227-0174ddbf2a0e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"isotypic", "[", 
    RowBox[{"T_", ",", " ", "par_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"YoungProject", "[", 
       RowBox[{"T", ",", " ", 
        RowBox[{"YoungTableau", "[", "#", "]"}]}], "]"}], " ", "&"}], " ", "/@",
      " ", 
     RowBox[{"syt", "[", "par", "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[451]:=",ExpressionUUID->"e648006a-04b2-41e4-bf82-1cfda6f5ab7a"]
}, Open  ]],

