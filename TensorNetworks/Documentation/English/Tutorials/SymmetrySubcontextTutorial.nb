Cell["\<\
The central blob is the tensor; the seven labelled legs are its slots. Shared \
legs become bonds between two such nodes, and a tensor network is a \
collection of these stars glued at common legs.\
\>", "Text",ExpressionUUID->"f9d90a6a-bc18-49a7-9a8c-5dba297b32b2"],

Cell["\<\
Two group actions live on this picture, and both recur throughout the \
tutorial:\
\>", "Text",ExpressionUUID->"f37eb419-a1ee-4863-8a8c-e7571667a291"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "73d89af6-1588-45b6-ace9-b5e51daaca16"],
 ", the ",
 StyleBox["symmetric group", "TI"],
 " on ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4397fd2b-ce63-4da0-bc1b-360475170fb2"],
 " letters, comprises the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "!"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f9e9b757-e406-47e1-9efa-f7975f7e0bd3"],
 " permutations of the slots. It acts on the diagram by ",
 StyleBox["permuting which leg is which",
  FontWeight->"Bold"],
 ". For rank ",
 Cell[BoxData[
  FormBox["7", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9af8f3c7-a3d8-48ff-ba19-14acc2ba110a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["S", "TI"], "7"], "|", "\[LongEqual]", "5040"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "58b2a821-1eb9-4526-9b00-85994890aa0b"],
 "."
}], "Item",ExpressionUUID->"d8e07e69-ce7e-4305-ab71-c64d241d2d42"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], 
    StyleBox["L", "TI"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a6711d62-e307-4da0-a8c9-543620172229"],
 ", the ",
 StyleBox["general linear group", "TI"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[Cross]", 
    StyleBox["d", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "771b5364-b97b-43fe-89d1-104e7834f2db"],
 " invertible matrices, acts on a single leg of dimension ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c855cfa9-0b11-4f04-8e63-f06b9432938d"],
 " by ",
 StyleBox["basis change",
  FontWeight->"Bold"],
 ", and on the full tensor by changing basis at every leg simultaneously. It \
is a continuous group of dimension ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["d", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"88030ccf-6226-4fca-950f-57b82dd72fdd"],
 "."
}], "Item",ExpressionUUID->"6edd88cb-42e8-4e87-a6ab-8721bf45b248"],

Cell[TextData[{
 "The two actions commute, and Schur-Weyl duality turns that commuting pair \
into a direct-sum decomposition of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3f2d8c6e-73fb-4a7a-908f-52c23b07ce52"],
 " into blocks indexed by Young diagrams of size ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "85f3a1a5-9875-48ba-a1ee-30452f08c3ce"],
 ". The Symmetry functions handle the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a36f8a7a-cd5d-47db-8f09-824b722217e6"],
 " side (",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "8072c453-1b53-4527-9ddd-a3d26096f71b"],
 " lands a tensor in a chosen block); ",
 Cell[BoxData[
 "SchurDimension"], "InlineFormula",ExpressionUUID->
  "9fea7a47-09c6-447c-95e9-1f5e1003ea00"],
 " reports the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], 
    StyleBox["L", "TI"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4b997d10-4987-4533-98f4-6e2b215b4353"],
 " side (the block size at bond dimension ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d5026187-363f-4bf1-ad28-61d26c138221"],
 ")."
}], "Text",ExpressionUUID->"1af67b46-dcf5-48eb-bde6-6f93102e9963"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Two indistinguishable particles on a bond", "Section",ExpressionUUID->"70efc466-8fb7-41bf-ac57-e1b109a9c781"],

Cell[TextData[{
 "The simplest non-trivial tensor in a tensor network is a rank-2 node ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["T", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f3a7dcb5-aa0f-484e-9770-f5f2103a0460"],
 " on a bond between two physical sites, with each index ranging over a ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ae1d4d46-2297-493d-bb56-e5e43dc08e19"],
 "-dimensional local Hilbert space ",
 Cell[BoxData[
  FormBox[
   StyleBox["V", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9cf4dcde-2979-47f6-a063-2a62153dcfe3"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[Element]", 
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a5caa13d-cceb-4479-b906-5286aa9759bc"],
 ". This rank-2 bond is the elementary building block of every MPS, MERA, and \
PEPS, and the symmetry rule worked out here generalises slot-by-slot to every \
higher-rank tensor in the rest of the tutorial."
}], "Text",ExpressionUUID->"5c78f443-e861-441e-b654-020763d23984"],

Cell[CellGroupData[{

Cell["Identical particles and the exchange operator", "Subsection",ExpressionUUID->"481293e5-fa32-4f9f-a39c-6095789740f1"],

Cell[CellGroupData[{

Cell[TextData[{
 "Identical quantum particles carry no intrinsic labels: photons in a cavity, \
electrons in an atom, helium-4 atoms in a superfluid, the indices we attach \
are bookkeeping, not physics. Quantum mechanics enforces this with a sharp \
rule on the two-particle wavefunction ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["x", "TI"], "1"], ",", 
     SubscriptBox[
      StyleBox["x", "TI"], "2"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"06c2b2c9-72fc-4b4a-aa2e-de2dcfec7a3c"],
 ":"
}], "Text",ExpressionUUID->"e9c5d065-0223-4f3e-b081-2608318b0866"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalPsi]", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["x", "TI"], "2"], ",", 
       SubscriptBox[
        StyleBox["x", "TI"], "1"]}], ")"}]}], " ", "\[LongEqual]", " ", 
    RowBox[{
     RowBox[{"\[PlusMinus]", " ", "\[CapitalPsi]"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["x", "TI"], "1"], ",", 
        SubscriptBox[
         StyleBox["x", "TI"], "2"]}], ")"}], "."}]}]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"47467ecf-774d-4f25-\
b0ce-2697536aaa2e"]
}, Open  ]],

Cell[TextData[{
 "The plus sign is the ",
 StyleBox["bosonic", "TI"],
 " case (integer spin: photons, mesons, He-4, Cooper pairs). The minus sign \
is the ",
 StyleBox["fermionic", "TI"],
 " case (half-integer spin: electrons, protons, He-3); setting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["x", "TI"], "1"], "\[LongEqual]", 
    SubscriptBox[
     StyleBox["x", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b6710e7d-9c94-431e-a359-20ee5a164049"],
 " forces ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalPsi]", "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"1db46c73-8e2c-402d-8a01-4f34c43eb03f"],
 ", the Pauli exclusion principle."
}], "Text",ExpressionUUID->"b1d27628-a33f-4d83-8143-ff16a17bc57f"],

Cell[CellGroupData[{

Cell[TextData[{
 "Write the wavefunction in tensor form, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", "\[CapitalPsi]", "\[RightAngleBracket]", "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox[
      RowBox[{"i", "j"}], "TI"],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], " ", "|", 
    StyleBox["i", "TI"], "\[RightAngleBracket]", "\[CircleTimes]", "|", 
    StyleBox["j", "TI"], "\[RightAngleBracket]", "\[Element]", 
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f05e5c1b-3059-4aee-bc1c-08c34617bfa5"],
 ". The ",
 StyleBox["exchange operator", "TI"],
 " (the SWAP gate in quantum computing) ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], "12"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c15081e1-8613-4f28-bc92-9991f8eb2855"],
 " acts by relabelling the two factors,"
}], "Text",ExpressionUUID->"4c191ff8-2c7c-4c87-ba89-a2276c1b7753"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], "12"], " ", 
    RowBox[{"(", 
     RowBox[{"|", 
      StyleBox["i", "TI"]}], "\[RightAngleBracket]"}], "\[CircleTimes]", "|", 
    
    StyleBox["j", "TI"], "\[RightAngleBracket]", 
    RowBox[{")", " "}], 
    RowBox[{"\[LongEqual]", " "}], "|", 
    StyleBox["j", "TI"], "\[RightAngleBracket]", "\[CircleTimes]", "|", 
    StyleBox["i", "TI"], "\[RightAngleBracket]", ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"f57989e6-07f7-482a-\
94ce-0d8d41b2e246"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "sending coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], "\[RightTeeArrow]", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"j", "i"}], "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b2244ed8-54d2-46ab-816a-ecce81455a2c"],
 ". ",
 StyleBox["This is the ordinary transpose ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e7d8d9b9-0da0-4cea-843a-b931f634a338"],
 StyleBox[", not the adjoint ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], "\[Dagger]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5082df77-1abe-4e52-82ba-b6d57c5e787f"],
 StyleBox[".",
  FontWeight->"Bold"],
 " SWAP relabels slots; no complex conjugation enters. So even for complex ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2f3540d7-d9dd-423c-a403-70e9cb4631c1"],
 ", the bosonic and fermionic conditions are"
}], "Text",ExpressionUUID->"0834ea36-71ce-480f-892d-e94b32793a6e"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{"boson", 
    RowBox[{":", " "}], 
    StyleBox["T", "TI"], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    SuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["T", "TI"]], 
    RowBox[{",", "    "}], "fermion", 
    RowBox[{":", " "}], 
    StyleBox["T", "TI"], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    RowBox[{"-", " "}], 
    SuperscriptBox[
     StyleBox["T", "TI"], 
     StyleBox["T", "TI"]], "."}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"5c1810ba-eeb6-4bbf-\
b2b3-c384a5a9b090"]
}, Open  ]],

Cell[TextData[{
 "Hermiticity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["T", "TI"], "\[Dagger]"], "\[LongEqual]", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox[
       StyleBox["T", "TI"], "*"], ")"}], 
     StyleBox["T", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c1c322f1-566a-456f-b93c-1d8f395a843c"],
 ", is a separate constraint outside the symmetric-group story; built-in WL \
captures it via ",
 Cell[BoxData[
  RowBox[{"Hermitian", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "2b6c15f6-4761-498c-b12f-deb2ecdaf733"],
 ". On real entries the kernel collapses ",
 Cell[BoxData[
  RowBox[{"Matrices", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "n"}], "}"}], ",", " ", "Reals", ",", " ", 
    RowBox[{"Hermitian", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], "]"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"a8bb33ea-bd67-4b75-aa62-a37a3f779ba9"],
 " to ",
 Cell[BoxData[
  RowBox[{"Matrices", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", "n"}], "}"}], ",", " ", "Reals", ",", " ", 
    RowBox[{"Symmetric", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], "]"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"eb72829e-f59a-4a77-beab-641322c565be"],
 " because the conjugation has no imaginary part to act on."
}], "Text",ExpressionUUID->"5ad51ac3-4538-495d-8182-a0898ddf1c32"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The symmetric / antisymmetric decomposition", "Subsection",ExpressionUUID->"07469c6b-ea0d-4745-97eb-94a71bcf4763"],

Cell[CellGroupData[{

Cell[TextData[{
 "A generic complex matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[Element]", 
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "87e14994-848b-4b33-8fe5-1ad8d3d769f4"],
 " is neither symmetric nor antisymmetric, but it splits cleanly:"
}], "Text",ExpressionUUID->"043b57df-bc7f-414c-af9f-5cb3ee788dee"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "+", 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["T", "TI"]]}], ")"}], " ", 
    RowBox[{"+", " "}], 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["T", "TI"], "-", 
      SuperscriptBox[
       StyleBox["T", "TI"], 
       StyleBox["T", "TI"]]}], ")"}], ","}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"a3ef8613-3865-4828-\
8be9-6c5377cb2f24"]
}, Open  ]],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], "sym"], "\[Element]", 
    SuperscriptBox[
     StyleBox["Sym",
      FontSlant->"Plain"], "2"], 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "290fbd4b-b755-4bce-85e9-1fa3a96a8b46"],
 " (dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "+", "1"}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"49b49133-81b3-4f34-bdc4-324ef82c977c"],
 ") and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["T", "TI"], "anti"], "\[Element]", 
    SuperscriptBox["\[CapitalLambda]", "2"], 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "302ae5c4-8a7f-415f-a7ae-e898f7c129ca"],
 " (dimension ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "-", "1"}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"06aa99c8-bbdb-49f2-89a5-5baa115bf46c"],
 "). These are the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8440c28e-8c29-4fc4-8dd2-7e7afd71aecd"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6ba0d7f1-cd9b-47db-a5ec-7eee052f3a41"],
 " eigenspaces of SWAP, and their dimensions sum to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["d", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8bf8d3e4-9729-4219-be13-ffd72237e5ea"],
 ". The Symmetry functions name the two pieces by their symmetry class (the \
partition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4cc18983-1292-4834-8fb0-87cede647d97"],
 " for boson, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bfad9ab4-c520-46a8-b8c4-88ab2cd7c741"],
 " for fermion) and produce each with a single call. The naming object is the \
",
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "e8d2ce8f-276a-49da-a6b2-65f261636faf"],
 "."
}], "Text",ExpressionUUID->"dbea6838-88a1-48bc-8574-02669c4d1ee2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "e1971582-5d5d-4101-9af4-7b74d67ad6c9"],
 ": the named handle for a symmetry class"
}], "Subsection",ExpressionUUID->"f0444b8f-0e05-46ac-a570-d801b9774ae5"],

Cell[TextData[{
 "A ",
 StyleBox["Young tableau", "TI"],
 " is a left-justified arrangement of boxes (the \"shape\") together with a \
labelling of those boxes by the slot indices ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", 
     StyleBox["n", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"92f2224c-a57d-43df-ab8d-04d71029f85f"],
 " of the tensor we plan to act on. ",
 StyleBox["The labelling must be a permutation of ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7e652cb2-e189-4a6a-83df-44b19e2dcf3a"],
 " (a ",
 StyleBox["standard tableau", "TI"],
 "). For two indices there are exactly two shapes:"
}], "Text",ExpressionUUID->"62efa96a-7730-4a9b-b9e5-194499596bc4"],

Cell[TextData[{
 "one row of two boxes, written ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b8699f14-19c2-43c0-a0ff-0399b797138f"],
 ", labels the ",
 StyleBox["symmetric", "TI"],
 " class;"
}], "Item",ExpressionUUID->"ba3906e0-f015-4a81-b295-5d515c4a7e51"],

Cell[TextData[{
 "one column of two boxes, written ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3616fe1f-5cdc-4bcb-ae1d-5758de88f412"],
 ", labels the ",
 StyleBox["antisymmetric", "TI"],
 " class."
}], "Item",ExpressionUUID->"e1870753-93b3-4fa4-895e-4607461a8fcf"],

