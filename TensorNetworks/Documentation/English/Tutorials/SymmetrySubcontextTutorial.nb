   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.988838587994904*^9},
 CellLabel->"Out[345]=",
 CellID->1108087907,ExpressionUUID->"6c96a370-5d40-48a1-82fa-bcfb1b32ed49"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The TN compression payoff is the dimension of the symmetric subspace, which \
is exactly what ",
 Cell[BoxData[
  RowBox[{"SchurDimension", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", " ", "2"}], "]"}]], "InlineFormula",
  ExpressionUUID->"3c307130-ec3d-4a7c-956f-b52b64c92d37"],
 " returns. The Schur-Weyl decomposition isolates this ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["n", "TI"], "+", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9271e783-00dd-46c8-bc95-ba049e47e0ac"],
 "-dimensional sector inside the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a0b46516-8311-409d-8de9-a0f167254b99"],
 "-dimensional full Hilbert space."
}], "Text",ExpressionUUID->"a3342e76-7e8f-4c42-8508-139d5fdc0985"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"nn", ",", " ", 
     RowBox[{"SchurDimension", "[", 
      RowBox[{
       RowBox[{"{", "nn", "}"}], ",", " ", "2"}], "]"}], ",", " ", 
     RowBox[{"2", "^", "nn"}], ",", "\n", "     ", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"2.", "^", "nn"}], " ", "/", " ", 
        RowBox[{"(", 
         RowBox[{"nn", " ", "+", " ", "1"}], ")"}]}], ",", " ", "3"}], 
      "]"}]}], "}"}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{"nn", ",", " ", "4", ",", " ", "10"}], "}"}]}], "\n", 
  "]"}]], "Input",
 CellLabel->
  "In[346]:=",ExpressionUUID->"8975e8af-2a71-4aec-9ce1-9f6030d8a874"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "5", ",", "16", ",", "3.2000000000000001776`3."}], 
    "}"}], ",", 
