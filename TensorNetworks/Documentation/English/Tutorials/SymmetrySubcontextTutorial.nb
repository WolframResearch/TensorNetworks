Cell[CellGroupData[{

Cell[TextData[{
 "Each call returns a typed ",
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", "...", "]"}]], "InlineFormula",ExpressionUUID->
  "f7b2103d-1c17-42a5-8fb6-c84cda21a21a"],
 " with a summary display. The constructor accepts two forms. The ",
 StyleBox["partition", "TI"],
 " form just used takes a non-increasing list of row lengths and fills slot \
labels ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6fcd461b-966c-43ca-9bf7-1a396288ff2f"],
 " row by row. The ",
 StyleBox["explicit-rows", "TI"],
 " form takes the rows of slot labels directly; the symmetric two-tableau \
equivalent reads:"
}], "Text",ExpressionUUID->"f5d8b1e5-1f75-403a-87b9-9af2b59229a2"],

