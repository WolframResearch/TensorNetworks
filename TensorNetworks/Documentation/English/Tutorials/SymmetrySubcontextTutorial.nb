Cell[CellGroupData[{

Cell[TextData[{
 "Two-spin singlet vs triplet (spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2261f31a-c362-4c9e-9484-05347de22585"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"cac5355d-174e-433f-a487-2192666b974c"],
 ")"
}], "Subsubsection",ExpressionUUID->"6f75c810-1323-47f9-8cc6-32b520311f62"],

Cell[TextData[{
 StyleBox["Two spin-", "TI"],
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "087902c6-f721-43d5-9dc0-0f0cbded6f8a"],
 StyleBox[" particles couple into a spin-0 singlet (antisymmetric) plus a \
spin-1 triplet (symmetric), the Clebsch-Gordan decomposition ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "\[CircleTimes]", 
    FractionBox["1", "2"], "\[LongEqual]", "0", "\[CirclePlus]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "56972621-8943-42c4-adf2-ce27c714fa02"],
 StyleBox[". ", "TI"],
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "83366f3d-30eb-4c2e-9eca-dec40cb5880b"],
 StyleBox[" onto ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cb1ba46e-6a91-4e89-916b-7cb50014ab11"],
 StyleBox[" and ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"85127cf8-afec-4bbe-a2eb-f0f2da13d5eb"],
 StyleBox[" separates them in one call, one projector per total-spin sector.",
   "TI"]
}], "Text",ExpressionUUID->"b51d11f4-c383-4be4-b431-bedff5cc715f"],

Cell[TextData[{
 "A pair of spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ee37b249-0369-41fd-85d4-72a02f8132a8"],
 " particles has a 4-dimensional Hilbert space ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d65ad415-f0e1-49b3-9ac9-2392a6b3e7b0"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"fb0c1767-4e39-49ad-b33a-c443fd26ac36"],
 ". The two-spin wavefunctions split into one singlet (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e07efd97-9a40-4d57-9a02-7c2b707bec7e"],
 ", antisymmetric) and three triplet states (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8f429471-e2d4-4a89-86a2-ea769ab9e88b"],
 ", symmetric). In coefficient-tensor form a state ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", "\[CapitalPsi]", "\[RightAngleBracket]", "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox[
      RowBox[{"i", "j"}], "TI"],
     LimitsPositioning->True], 
    SubscriptBox["\[Psi]", 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], "|", 
    StyleBox["i", "TI"], 
    StyleBox["j", "TI"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"5ac0dcbc-c726-47e9-8c8d-cc14b6571aeb"],
 " has a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Cross]", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"990e5d6c-b39d-49af-9efb-0c0e5945741e"],
 " coefficient matrix ",
 Cell[BoxData[
  FormBox["\[Psi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b55ce0ea-0e15-4ae8-ae6e-b0362b972bd4"],
 ": singlet iff ",
 Cell[BoxData[
  FormBox["\[Psi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1f93f18a-74ac-4743-a06a-b9cf43e47f3a"],
 " is antisymmetric, triplet iff ",
 Cell[BoxData[
  FormBox["\[Psi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e3bca799-378e-40b1-9766-f001b1ba7014"],
 " is symmetric."
}], "Text",ExpressionUUID->"add57eaf-39f0-4cd0-88e4-b58bd31e1aae"],

Cell[CellGroupData[{

Cell[TextData[{
