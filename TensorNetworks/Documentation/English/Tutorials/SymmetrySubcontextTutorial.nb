Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.988838588259424*^9},
 CellLabel->"Out[362]=",
 CellID->538509745,ExpressionUUID->"619c9aab-7cd6-48a5-8cbd-4a6a8f40b804"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "For a bond of dimension ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4b607092-eba5-43ac-befe-5dcb8756bf88"],
 ", only diagrams with at most ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e4f14d48-e1ff-4b23-a1d1-383f29be6fcf"],
 " rows contribute; the rest give zero-dimensional Weyl modules. The \
two-argument form ",
 Cell[BoxData[
  RowBox[{"IntegerPartitions", "[", 
   RowBox[{"n", ",", " ", "d"}], "]"}]], "InlineFormula",ExpressionUUID->
  "b53a5045-1c1e-4722-a3fd-a26bb61427f7"],
 " pre-filters to the irreducible representations that fit in the bond. At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9484a85b-ec7a-4dcb-a2ee-5d84f2f3e3ae"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"fd4c195c-2b1e-49b6-954d-49c56aa3d7b8"],
 " the fermionic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"821d6c52-3904-47de-8d29-1fbd1903ee50"],
 " drops out."
}], "Text",ExpressionUUID->"e2b2a42f-ed31-4fd0-b251-d0aa50937029"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IntegerPartitions", "[", 
  RowBox[{"3", ",", " ", "2"}], "]"}]], "Input",
 CellLabel->
  "In[363]:=",ExpressionUUID->"1e4f0787-758b-4c16-ac41-2710b59da06b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988838588284567*^9},
 CellLabel->"Out[363]=",
 CellID->1237195757,ExpressionUUID->"5837837b-e69e-4392-b87e-e7becf3dade9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HookLength", "[", 
   RowBox[{"tab", ",", " ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", "c"}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"2854c3e6-8fd0-42a8-ab73-4b040ed74c88"],
 " reads a single hook value at one cell of the diagram. The mixed-symmetry \
shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c931b5c5-e32c-4670-9ccd-c85542b572a9"],
 " has three cells; the top-left cell has hook length ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9bfa8343-2917-451e-a071-d7887f8bb6ff"],
 " (itself, the cell to its right, the cell below)."
}], "Text",ExpressionUUID->"ef499f95-734c-4a6c-a79b-b9bed747f811"],

Cell[CellGroupData[{

