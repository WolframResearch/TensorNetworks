Cell["Contract within the fully antisymmetric block.", "Text",ExpressionUUID->"39a21aa9-19db-41f0-a24f-0e21d7ed236a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"b111", " ", "=", " ", 
  RowBox[{"Total", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{"e111", " ", "*", " ", "f111"}], "]"}], "]"}]}]], "Input",
 CellLabel->
  "In[395]:=",ExpressionUUID->"a45d91d4-0974-4aa5-b31c-996f440a2799"],

