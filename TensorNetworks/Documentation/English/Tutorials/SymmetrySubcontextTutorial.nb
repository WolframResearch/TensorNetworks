Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "e075fd03-8780-44e3-bb50-fa004b0031d8"],
 " is idempotent: projecting twice equals projecting once. This is why \
iterative TN algorithms (DMRG, TDVP) use the normalised projector rather than \
the unnormalised ",
 Cell[BoxData[
 "YoungSymmetrize"], "InlineFormula",ExpressionUUID->
  "1d819c24-9539-4402-b37a-1ea291caf343"],
 ", which would blow up by a factor of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "!", "/", 
    SubscriptBox[
     StyleBox["d", "TI"], "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"003430ad-cd2f-4c54-a2ab-3fd41ad43c10"],
 " on every iteration."
}], "Text",ExpressionUUID->"3d35bcbc-d6bf-4951-a4e8-5b1f588eab12"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"YoungProject", "[", 
   RowBox[{
    RowBox[{"YoungProject", "[", 
     RowBox[{"K", ",", " ", "symTab"}], "]"}], ",", " ", "symTab"}], "]"}], 
  " ", "==", " ", 
  RowBox[{"YoungProject", "[", 
   RowBox[{"K", ",", " ", "symTab"}], "]"}]}]], "Input",
 CellLabel->
  "In[287]:=",ExpressionUUID->"e386eb11-da04-4278-838b-affb5c4608e4"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988838587143839*^9},
 CellLabel->"Out[287]=",
 CellID->1985988987,ExpressionUUID->"299302ce-e5d5-4074-bc0c-300cc2aecdee"]
}, Open  ]]
}, Open  ]],

