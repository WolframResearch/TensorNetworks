Cell["\<\
The tutorial is structured around two physical settings that together bring \
every function into play:\
\>", "Text",ExpressionUUID->"5d80c199-ab24-4092-934e-0e61293535a2"],

Cell[TextData[{
 StyleBox["Familiar rank-2 tensors and their TN-bond payoffs",
  FontWeight->"Bold"],
 " introduces ",
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "6def5d31-41c1-4ef2-960d-f3bfe7b4f6ad"],
 ", ",
 Cell[BoxData[
 "YoungTableauQ"], "InlineFormula",ExpressionUUID->
  "2e60fbda-d17b-4ebb-ae49-edfee9e71c28"],
 ", the four accessors (",
 Cell[BoxData[
 "TableauShape"], "InlineFormula",ExpressionUUID->
  "7fdbdcea-ddef-4ba1-841e-6ca8cd64d616"],
 ", ",
 Cell[BoxData[
 "TableauSize"], "InlineFormula",ExpressionUUID->
  "9141ba2b-7327-47b8-abc7-7dadc8af58e9"],
 ", ",
 Cell[BoxData[
 "TableauRows"], "InlineFormula",ExpressionUUID->
  "e7b24985-adb5-4d32-8824-5ccd5416bd59"],
 ", ",
 Cell[BoxData[
 "TableauColumns"], "InlineFormula",ExpressionUUID->
  "f51afd5c-c56a-44aa-9b2e-d7e81121982b"],
 "), ",
 Cell[BoxData[
 "YoungSymmetrize"], "InlineFormula",ExpressionUUID->
  "fa1cbe70-bf9c-4870-85d3-cc9c52e429ef"],
 ", and ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "36a9add2-e27d-4c0d-a740-94f074a6e319"],
 " through symmetric / antisymmetric matrices from physics (metric, Pauli, EM \
tensor, \[Ellipsis]) and operational TN constructs (singlet/triplet \
decomposition, SWAP-gate eigenspace, fermionic bond), closing with a \
block-sparse trace identity on a rank-2 bond."
}], "ItemNumbered",ExpressionUUID->"1e386e5d-ad62-43fb-b825-a163333ec3ff"],

Cell[TextData[{
 StyleBox["Beyond rank 2: three higher-rank payoffs",
  FontWeight->"Bold"],
 " introduces ",
 Cell[BoxData[
 "PartitionQ"], "InlineFormula",ExpressionUUID->
  "ef111f36-f66b-4089-82d0-c74158dabc35"],
 ", ",
 Cell[BoxData[
 "TransposePartition"], "InlineFormula",ExpressionUUID->
  "2dc1a50b-cf3a-409f-8ce7-6cea99552189"],
 ", ",
 Cell[BoxData[
 "HookLength"], "InlineFormula",ExpressionUUID->
  "0232a21a-81fe-401a-a73a-b99cab2055a0"],
 ", ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "42619ea4-3d21-407c-a1ac-9f715a222a2b"],
 ", ",
 Cell[BoxData[
 "HookFactor"], "InlineFormula",ExpressionUUID->
  "1d62bcb1-8555-493e-b344-f7365c590df0"],
 ", and ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "65752043-bcfd-4e8b-ba3c-9c5c0745ad93"],
 " through three larger examples: the Schur-Weyl block decomposition on three \
sites (with a block-sparse Frobenius contraction), the Riemann curvature \
tensor as a rank-4 TN node (with multi-term algebraic identities derived from \
the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"25480b95-f188-409a-9028-97271c416b1e"],
 " projector, including the first Bianchi identity), and the spectrum of a \
class-function Hamiltonian via content sums."
}], "ItemNumbered",ExpressionUUID->"8f9b9ece-ad6c-43aa-9c44-e32d78ee52c6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Where the Symmetry functions sit in WL's tensor stack", "Section",ExpressionUUID->"31a650f7-a067-4aaf-acbf-598cd5be270e"],

Cell[CellGroupData[{

Cell[TextData[{
 "Before any code, fix the structural relationship between the Symmetry \
functions and built-in Wolfram Language tensor symmetry. Built-in WL (since \
9.0) ships a complete language for ",
 StyleBox["mono-term", "TI"],
 " symmetries: relations of the form"
}], "Text",ExpressionUUID->"84411bf8-fb1d-495b-89ef-8f98890aed76"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    RowBox[{"\[Phi]", " "}], 
    StyleBox["TensorTranspose",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["T", "TI"], ",", "\[Sigma]"}], "]"}], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    StyleBox["T", "TI"]}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"7858f031-6c6a-4a5f-\
b09a-2672537e57c9"]
}, Open  ]],

