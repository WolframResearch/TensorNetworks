Cell[TextData[{
 "Four eigenvalues equal to ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e75caa3c-478f-47ae-9587-7c2d97a1754c"],
 " in the ",
