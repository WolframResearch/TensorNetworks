Cell[CellGroupData[{

Cell[TextData[{
 "Spring-constant matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["K", "TI"], 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fbb0cc79-f682-48f1-8768-ebcc03c63eda"],
 " (Hessian of a scalar potential)"
}], "Subsubsection",ExpressionUUID->"1a7a7c32-d049-4ecc-9312-745e6f6a85f1"],

Cell[TextData[{
 StyleBox["Mixed partials of a smooth potential commute, so the \
spring-constant matrix is symmetric. ", "TI"],
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "5fe47555-493b-497e-8634-52965113b944"],
 StyleBox[" recasts that textbook identity as a ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b6293adc-369c-4a91-a638-4d260a484e58"],
 StyleBox["-projection statement: the antisymmetric remainder is identically \
zero, checkable in one line.", "TI"]
}], "Text",ExpressionUUID->"e87c5f70-bc7b-4579-b8f8-fd1d8f7c75e6"],

Cell[CellGroupData[{

Cell[TextData[{
 "The spring-constant matrix is the Hessian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["K", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", 
     StyleBox["i", "TI"]], 
    SubscriptBox["\[PartialD]", 
     StyleBox["j", "TI"]], 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e15f3228-d090-4899-94e8-6f8c6e56a190"],
 " of a scalar potential. For a purely quadratic ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["y", "TI"]}], ")"}], "\[LongEqual]", 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"3", 
      SuperscriptBox[
       StyleBox["x", "TI"], "2"], "+", "2", 
      SuperscriptBox[
       StyleBox["y", "TI"], "2"], "+", 
      StyleBox["x", "TI"], 
      StyleBox["y", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ba04bd20-df41-4e74-9b68-109b54a2e8de"],
 " the Hessian is a constant matrix with no ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["x", "TI"], ",", 
    StyleBox["y", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3c134d0e-5496-4cb5-9d8f-e42ad1dc5a3f"],
 " dependence, so no equilibrium-point substitution is needed. The built-in \
second-order form ",
 Cell[BoxData[
  RowBox[{"D", "[", 
   RowBox[{"V", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "2"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"f582c680-c7c0-4185-ac80-6ebe22645c13"],
 " handles the partial-derivative bookkeeping."
}], "Text",ExpressionUUID->"e4e6b3f2-a319-4ec6-b1e0-de9617b0d6fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"K", " ", "=", " ", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"x", "^", "2"}]}], " ", "+", " ", 
       RowBox[{"2", " ", 
        RowBox[{"y", "^", "2"}]}], " ", "+", " ", 
       RowBox[{"x", " ", "y"}]}], ")"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "2"}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[284]:=",ExpressionUUID->"04bbc43d-6fd8-455c-b6e9-a5b118804734"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", 
     FractionBox["1", "2"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "2"], ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9888385870900993`*^9},
 CellLabel->"Out[284]=",
 CellID->23441681,ExpressionUUID->"06aa24e4-e3bc-47c5-b06e-870ded6b665d"]
}, Open  ]]
}, Open  ]],

