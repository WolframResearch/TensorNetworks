Cell[CellGroupData[{

Cell[TextData[{
 "Form the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"5", "\[Cross]", "5"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"15b80441-41d5-4e52-8269-e67b49e03b0a"],
 " matrix of ",
 StyleBox["cross-sector", "TI"],
 " contractions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["T", "TI"], "1", 
      RowBox[{"(", "\[Lambda]", ")"}]], ",", 
     SubsuperscriptBox[
      StyleBox["T", "TI"], "2", 
      RowBox[{"(", "\[Mu]", ")"}]]}], "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9118bb4c-b441-4018-af9e-f67566420703"],
 ". Every off-diagonal entry vanishes identically by Schur orthogonality."
}], "Text",ExpressionUUID->"316c8cd6-8286-4e4a-9606-d79a18ee06e8"],

