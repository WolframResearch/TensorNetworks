     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], ")"}], "\[LongEqual]", "0", "+", "1", "-",
     "1", "\[LongEqual]", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cecd5a93-cf0b-47b3-b3f7-d95feba9b948"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], 
