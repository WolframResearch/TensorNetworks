Cell[CellGroupData[{

Cell[TextData[{
 "The same block-sparsity holds inside the paclet's TN flow. Build the \
unprojected two-node network over ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b301f1d2-ead5-4f58-a28a-86cd3ff2152f"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["S", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "19868ffa-8d06-4b5a-87d8-1d21b205067c"],
 " with all three indices shared, contract it, and recover the full Frobenius \
product."
}], "Text",ExpressionUUID->"3c09654c-fa68-4bb1-911d-19d7e1fee323"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bareFro", " ", "=", " ", 
  RowBox[{"TensorNetworkContract", " ", "@", "\n", "    ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"T3", ",", " ", "S3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\"", ",", " ", "\"\<k\>\""}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\"", ",", " ", "\"\<k\>\""}], 
        "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", "}"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[396]:=",ExpressionUUID->"03e5789c-5008-42df-a654-6f6403f97e43"],

Cell[BoxData[
 RowBox[{"-", "1.0574609962413515`"}]], "Output",
 CellChangeTimes->{3.988838588893079*^9},
 CellLabel->"Out[396]=",
 CellID->680811392,ExpressionUUID->"fd7c55f2-e431-48dc-b24f-4983285196b6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Apply ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "bf2de178-6d25-44f6-8094-ef37d908df92"],
 " to both nodes inside the network, restricting them to a chosen irrep \
sector before the contraction runs. The helper below sums over the standard \
tableaux of a given shape, projects both inputs into that sector, and \
contracts the resulting two-node TN."
}], "Text",ExpressionUUID->"a67008af-9cd3-496e-8b1b-c2f11120e3b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sectorContract", "[", 
    RowBox[{"U_", ",", " ", "V_", ",", " ", "syt_List"}], "]"}], " ", ":=", 
   "\n", "    ", 
   RowBox[{"TensorNetworkContract", " ", "@", " ", 
    RowBox[{"TensorNetwork", "[", "\n", "        ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"YoungProject", "[", 
            RowBox[{"U", ",", " ", 
             RowBox[{"YoungTableau", "[", "#", "]"}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "syt"}], "]"}], ",", "\n", "         ", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"YoungProject", "[", 
            RowBox[{"V", ",", " ", 
             RowBox[{"YoungTableau", "[", "#", "]"}]}], "]"}], " ", "&"}], 
          " ", "/@", " ", "syt"}], "]"}]}], "}"}], ",", "\n", "        ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\"", ",", " ", "\"\<k\>\""}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\"", ",", " ", "\"\<k\>\""}], 
         "}"}]}], "}"}], ",", " ", 
      RowBox[{"{", "}"}]}], "\n", "    ", "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[397]:=",ExpressionUUID->"5f730409-13a4-4996-9e11-5a9a7387cdd7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
List the three standard-tableau sets and evaluate the three within-sector \
contractions through the paclet's contraction engine.\
\>", "Text",ExpressionUUID->"fc823348-7a11-4bbe-98fa-7e542c8e1ba5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"syt3", ",", " ", "syt21", ",", " ", "syt111"}], "}"}], " ", "=", 
   " ", 
   RowBox[{"{", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "}"}], "}"}], ",",
      "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
         RowBox[{"{", "3", "}"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"{", "2", "}"}]}], "}"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "1", "}"}], ",", " ", 
        RowBox[{"{", "2", "}"}], ",", " ", 
        RowBox[{"{", "3", "}"}]}], "}"}], "}"}]}], "\n", "}"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"sectorContract", "[", 
    RowBox[{"T3", ",", " ", "S3", ",", " ", "syt3"}], "]"}], ",", "\n", " ", 
   RowBox[{"sectorContract", "[", 
    RowBox[{"T3", ",", " ", "S3", ",", " ", "syt21"}], "]"}], ",", "\n", " ", 
   
   RowBox[{"sectorContract", "[", 
    RowBox[{"T3", ",", " ", "S3", ",", " ", "syt111"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->
  "In[398]:=",ExpressionUUID->"21115596-f9d6-46f8-9854-5cc4a5ebfaaf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "0.905209307273169`"}], ",", 
   RowBox[{"-", "0.15225168896818228`"}], ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.9888385889413643`*^9},
