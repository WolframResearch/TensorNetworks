}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Two three-term annihilators. One of them is precisely the cyclic \
permutations of slots ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"38a481c5-3e57-4dd9-814e-46748a5a4f0e"],
 " acting on ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b8d0086c-2b4e-4024-8c9c-856a203b0390"],
 ": identity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " "}], 
     RowBox[{"3", " "}], "4"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2396acf5-3392-4681-a30e-3d593f6505aa"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " "}], 
     RowBox[{"4", " "}], "3"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9207b2a8-56f2-4424-82f9-0cc247fb1220"],
 ". This is the ",
 StyleBox["first Bianchi identity",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "c", "d", "b"}], "TI"]], "+", 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "d", "b", "c"}], "TI"]], "\[LongEqual]", "0"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "75cc8663-8209-4e97-bc86-4b9f5055d0c7"],
 ", derived here from the projector definition with no textbook input."
}], "Text",ExpressionUUID->"199d686c-bbaf-432a-88d4-8db2ab794160"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Position", "[", 
  RowBox[{"threeTerm", ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3", ",", " ", "4", ",", " ", "2"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "4", ",", " ", "2", ",", " ", "3"}], "}"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[432]:=",ExpressionUUID->"964bf214-8d91-4c32-8ed2-ff09e175d39d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", "1", "}"}], "}"}]], "Output",
 CellChangeTimes->{3.988838589812879*^9},
 CellLabel->"Out[432]=",
 CellID->882821847,ExpressionUUID->"9bd8f647-707d-47b8-8df8-a61d9ffe48f3"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Bianchi appears at position 1; the second three-term identity is its image \
under the pair-swap-plus-(34)-antisym relations already in the two-term \
sweep. The multi-term constraint that ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "0c6bd005-649b-4c21-8b82-19e7ee525ac6"],
 " could not reach has been generated from the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f9853d78-3845-4986-995c-7961b8b0d573"],
 " Young projector itself, not assumed, not looked up."
}], "Text",ExpressionUUID->"2c824ed0-0a11-4a49-8d03-eaf8ca45aac1"],

Cell[CellGroupData[{

Cell[TextData[{
 "For completeness, point-check the four classical Riemann identities on ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "744a4fd6-2430-4a91-a7b4-3428f81b29cd"],
 " directly (redundant now, since each is in the discovered list)."
}], "Text",ExpressionUUID->"42abef1c-4e79-4eb5-a2d4-19b8ebeedf1b"],

