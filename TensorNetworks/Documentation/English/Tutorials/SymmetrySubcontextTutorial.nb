Cell[CellGroupData[{

Cell[TextData[{
 "The W-state is one of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "+", "1", "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"cf098b3d-6af7-473f-bdeb-20e8a42c826b"],
 " Dicke states. Building any other one is the same construction with a \
different bit-string seed; the symmetric Young projector pulls the symmetric \
component out and normalisation finishes the job."
}], "Text",ExpressionUUID->"b03c2299-45ce-4c1e-a03b-c32980d40995"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dickeState", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"raw", " ", "=", " ", 
       RowBox[{"YoungProject", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"Normal", " ", "@", " ", 
          RowBox[{"SparseArray", "[", "\n", "            ", 
           RowBox[{
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"ConstantArray", "[", 
                RowBox[{"2", ",", " ", "k"}], "]"}], ",", " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"n", " ", "-", " ", "k"}]}], "]"}]}], "]"}], " ", "->",
              " ", "1"}], ",", "\n", "            ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"2", ",", " ", "n"}], "]"}]}], "]"}]}], ",", "\n", 
         "        ", "nTab"}], "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"raw", " ", "/", " ", 
      RowBox[{"Norm", "[", 
       RowBox[{"Flatten", "[", "raw", "]"}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dicke", " ", "=", " ", 
   RowBox[{"dickeState", " ", "/@", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", " ", "n"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[343]:=",ExpressionUUID->"b8fa608b-e5ac-4a1c-a714-62120fe2306c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The six Dicke states form an orthonormal basis of the symmetric subspace; \
their Gram matrix is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", "\[Cross]", "6"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e97bfabf-47ee-4704-b6bc-5d4c8680ce50"],
 " identity."
}], "Text",ExpressionUUID->"74e1d031-179c-487e-ade2-bd1151fe89c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{"Outer", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Flatten", "[", "#1", "]"}], " ", ".", " ", 
       RowBox[{"Flatten", "[", "#2", "]"}]}], " ", "&"}], ",", " ", "dicke", ",",
      " ", "dicke", ",", " ", "1"}], "]"}], " ", "-", " ", 
   RowBox[{"IdentityMatrix", "[", 
    RowBox[{"n", " ", "+", " ", "1"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[345]:=",ExpressionUUID->"814c1769-bf34-45fb-8308-587435e1fa66"],

