     RowBox[{"swapPlus", " ", ".", " ", 
      RowBox[{"Flatten", "[", "Tcoef", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}], " ", "==", " ", 
   RowBox[{"YoungProject", "[", 
