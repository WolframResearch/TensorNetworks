   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     SubscriptBox[
      StyleBox["T", "TI"], "1"], ",", 
     SubscriptBox[
      StyleBox["T", "TI"], "2"]}], "\[RightAngleBracket]"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8e9ed739-dcc9-4093-850c-120e72843f55"],
 " equals the sum of the five within-sector contractions."
}], "Text",ExpressionUUID->"80c07943-0d45-40f3-8a0e-e349acfa8e88"],

