  FormBox["\[Phi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "afd5f402-b8e5-4fb2-9e97-0eceb3326943"],
 ". The kernel surface for these is"
}], "Text",ExpressionUUID->"9db25b25-add5-41f6-b101-fc1d719c031d"],

