Cell[TextData[{
 "All four hold. The first three are mono-term and reachable by built-in ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "d85fc7d2-58ac-4d99-a3a8-25c8cdaba833"],
 " (and built-in ",
 Cell[BoxData[
 "TensorSymmetry"], "InlineFormula",ExpressionUUID->
  "96b8baf1-2344-42af-81bc-b9b0930da86d"],
 " would report them); the last is the Bianchi identity, multi-term, ",
 StyleBox["not", "TI"],
 " reachable by ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "e0361bad-b7c4-4099-b232-894c7d3e971a"],
 ", and the very thing the discovery loop above just produced from scratch."
}], "Text",ExpressionUUID->"04368f88-e9ef-4184-a7e2-9fd0fc9f2afd"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Composition with built-in ",
 Cell[BoxData[
 "TensorSymmetry"], "InlineFormula",ExpressionUUID->
  "70721ccf-8f58-42dd-bae7-8bfdc8fb3f8d"]
}], "Subsubsection",ExpressionUUID->"6dc1cfb2-5215-4826-baf9-a20148607f80"],

Cell[TextData[{
 StyleBox["A ", "TI"],
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "faa595ea-0a72-42f4-8432-f0f149f77c05"],
 StyleBox["-output tensor is recognised by built-in ", "TI"],
 Cell[BoxData[
 "TensorSymmetry"], "InlineFormula",ExpressionUUID->
  "975931be-f705-4d97-a179-7a038d95b290"],
 StyleBox[", which reports the three mono-term Riemann pair generators (but \
not Bianchi, which is multi-term). The two layers compose cleanly: multi-term \
projection upstream, mono-term detection downstream.", "TI"]
}], "Text",ExpressionUUID->"becdc220-420f-4bd7-a583-1d681c11fa4e"],

Cell[CellGroupData[{

Cell[TextData[{
 "After projection, the mono-term content of ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "57aa4cc7-e2bc-4393-9b52-d8be1decfb77"],
 " is detected by ",
 Cell[BoxData[
 "TensorSymmetry"], "InlineFormula",ExpressionUUID->
  "0357e473-3333-4b29-9f33-b97ddee2a828"],
 ":"
}], "Text",ExpressionUUID->"28962545-c70a-4e47-add7-eaa487648cfe"],

