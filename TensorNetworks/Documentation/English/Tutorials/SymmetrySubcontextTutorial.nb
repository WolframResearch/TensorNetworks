Cell[CellGroupData[{

Cell[TextData[{
 "2D Levi-Civita ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8fec2b98-b173-4540-98fb-8a8b51d24da5"]
}], "Subsubsection",ExpressionUUID->"43a9904e-42c1-4988-b786-010cb6ed6471"],

Cell[TextData[{
 StyleBox["The Levi-Civita symbol ", "TI"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", 
    StyleBox[
     RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"25f0ba71-5bfe-4a80-ad5a-eaef837b7c02"],
 StyleBox[" is the orientation tensor on a 2D plane: antisymmetric by \
definition. At ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"95810167-27d2-4927-b845-011adf443204"],
 StyleBox[" the antisymmetric sector is one-dimensional, so ", "TI"],
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "b93bb5fd-6a9a-4999-bc1f-39e40c250ef0"],
 StyleBox[" plus ", "TI"],
 Cell[BoxData[
  RowBox[{
   RowBox[{"SchurDimension", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", " ", "2"}], "]"}], " ", "=", " ", 
   "1"}]], "InlineFormula",ExpressionUUID->
  "6c4e8d1c-11c0-4d93-8eb2-518c6cc2f572"],
 StyleBox[" together prove ", "TI"],
 Cell[BoxData[
  FormBox["\[Epsilon]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6f42a918-5b80-4819-8db5-b985610aa5fe"],
 StyleBox[" is the unique (up to scale) antisymmetric rank-2 tensor on a \
2-qubit bond.", "TI"]
}], "Text",ExpressionUUID->"b8d43b15-b543-48a3-9604-f958f5816c71"],

