   RowBox[{"{", 
    RowBox[{"1", ",", "\[Rho]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Rho]", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9888385871842747`*^9},
 CellLabel->"Out[289]=",
 CellID->1345757857,ExpressionUUID->"f0425bc2-db86-48d7-be0b-4bc76761b37a"]
}, Open  ]]
}, Open  ]],

