Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HookLengths", "[", "par", "]"}]], "InlineFormula",ExpressionUUID->
  "dac856e0-4605-48dd-956d-1ad9122a5867"],
 " returns all hook lengths in one nested list, matching the diagram's row \
structure."
}], "Text",ExpressionUUID->"676b06d8-9304-4684-8917-c957b2876b74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookLengths", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "1"}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[366]:=",ExpressionUUID->"e01a06db-23f5-436c-a8e9-cb8d730e5720"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "1"}], "}"}], ",", 
   RowBox[{"{", "1", "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988838588351009*^9},
 CellLabel->"Out[366]=",
 CellID->1259097655,ExpressionUUID->"bf9142d6-2fdb-4bb6-abb0-42bc4026c5be"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"HookFactor", "[", "par", "]"}]], "InlineFormula",ExpressionUUID->
  "0974f65d-5913-47ab-bf8f-e66d8673adf8"],
 " is the reciprocal of the hook-length product, evaluated by the Frobenius \
determinant formula in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    SuperscriptBox[
     StyleBox["r", "TI"], "2"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"79d66612-2574-434b-9685-2a44686fd659"],
 " where ",
 Cell[BoxData[
  FormBox[
   StyleBox["r", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f82f17dd-70f6-4d02-9964-be4eb57f6f7a"],
 " is the number of rows."
}], "Text",ExpressionUUID->"2b5633e5-8f0b-4e7f-b6b5-3562b9d4e1df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HookFactor", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "1"}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[367]:=",ExpressionUUID->"1359f821-4757-4e9b-9cca-d47f8f3be114"],

Cell[BoxData[
 FractionBox["1", "3"]], "Output",
 CellChangeTimes->{3.9888385883673153`*^9},
 CellLabel->"Out[367]=",
 CellID->350430047,ExpressionUUID->"ffc0fc47-7f69-4ab3-a6b8-72b2786024a4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The irreducible representation dimension is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "!"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"36cf6cc1-7f0c-4a07-bf77-a7c239b89189"],
 " times the hook factor, which is exactly what ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "a33b9516-58ab-4797-b123-783626f20ff5"],
 " packages."
}], "Text",ExpressionUUID->"bfa9277e-7192-4b41-85cc-39022c71f2b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"TableauDimension", "[", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], " ", "==", " ", 
  RowBox[{
   RowBox[{"3", "!"}], " ", "*", " ", 
   RowBox[{"HookFactor", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "1"}], "}"}], "]"}]}]}]], "Input",
 CellLabel->
  "In[368]:=",ExpressionUUID->"bf52beb0-e723-4ab4-842d-81fc3406ceae"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9888385883921223`*^9},
 CellLabel->"Out[368]=",
 CellID->1277639855,ExpressionUUID->"21a064b4-865f-4cd8-95a8-7b15a51055b4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Read off all three ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "3"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"69f5e089-900b-4a55-85d6-31f41b66c575"],
 " irreducible representation dimensions in one shot."
}], "Text",ExpressionUUID->"2cbf31e8-971d-4bc1-989f-838ef03daa75"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableauDimension", " ", "/@", " ", "parts"}]], "Input",
 CellLabel->
  "In[369]:=",ExpressionUUID->"553bc091-fb7e-4855-9da1-cf303403db35"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{3.98883858840821*^9},
 CellLabel->"Out[369]=",
 CellID->604056632,ExpressionUUID->"e91bd431-ba45-457f-b8f9-ff360a6de042"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The sum of squared dimensions equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["S", "TI"], "3"], "|", "\[LongEqual]", "6"}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"1b4afcda-5ac1-4840-8c40-7a8e60d04dea"],
 " (the Plancherel identity)."
}], "Text",ExpressionUUID->"e398a3f6-c03c-412f-ab9b-f0b4c256dbec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"TableauDimension", "[", "#", "]"}], "^", "2"}], " ", "&"}], " ",
    "/@", " ", "parts"}], "]"}]], "Input",
 CellLabel->
  "In[370]:=",ExpressionUUID->"2509e5ad-b16c-4a47-bc05-c759265a607b"],

Cell[BoxData["6"], "Output",
 CellChangeTimes->{3.98883858843363*^9},
 CellLabel->"Out[370]=",
 CellID->1224614655,ExpressionUUID->"08bd5d98-9e66-4609-bacf-45dc380b7bbe"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
 "TransposePartition"], "InlineFormula",ExpressionUUID->
  "5bb98c38-5a06-4e77-8e18-c3ba3dae2707"],
 " is the boson\[LeftRightArrow]fermion duality: flipping the diagram across \
its main diagonal swaps the symmetric and antisymmetric statistics. The \
mixed-symmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"efd5d413-49f2-4c08-bc29-591348a7ab37"],
 " is self-conjugate at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"229e037e-fea8-4381-a35c-9a56694fe4bd"],
 "."
}], "Text",ExpressionUUID->"f1c008ff-fe17-41cf-8a2f-ac1d65e75467"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransposePartition", " ", "/@", " ", "parts"}]], "Input",
 CellLabel->
  "In[371]:=",ExpressionUUID->"5d5ba7ac-253a-4d7c-8c93-6f63dbb36ba5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.98883858845348*^9},
 CellLabel->"Out[371]=",
 CellID->615233737,ExpressionUUID->"2d0cd584-20b7-435c-bce7-76c9acdd3e16"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The GL(",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3c746d13-4f60-4bb4-b449-e479ce630815"],
 ") factor of the Weyl dimension formula is exported as ",
 Cell[BoxData[
  RowBox[{"SchurDimension", "[", 
   RowBox[{"par", ",", " ", "d"}], "]"}]], "InlineFormula",ExpressionUUID->
  "11f337ca-ee82-4fff-ae71-79ee0161e62a"],
 ", the Symmetry functions' hook-content-formula counterpart to ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "66f89ad0-b51b-486e-a50d-c5bea896c3d7"],
 ": while ",
 Cell[BoxData[
  RowBox[{"TableauDimension", "[", "par", "]"}]], "InlineFormula",
  ExpressionUUID->"e9040c04-4afd-4510-932f-a6bc1d99c526"],
 " returns the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6e435fbe-cbcd-485e-8e97-4a98d1d63cc5"],
 " irreducible representation dim ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"02788d19-88fc-43c6-97cb-7bacc3943e5d"],
 " (independent of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f12eaa9a-75ce-4d68-95ad-5aae4db2c784"],
 "), ",
 Cell[BoxData[
  RowBox[{"SchurDimension", "[", 
   RowBox[{"par", ",", " ", "d"}], "]"}]], "InlineFormula",ExpressionUUID->
  "f9fd276d-5fe5-41d6-8c9d-0949116a7a0a"],
 " returns the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], 
    StyleBox["L", "TI"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b979aafb-2939-4052-8e65-8ca83197d5a9"],
 " Weyl module dim ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["W", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Product]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        StyleBox["i", "TI"], ",", 
        StyleBox["j", "TI"]}], ")"}], "\[Element]", "\[Lambda]"}],
     LimitsPositioning->True], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "+", 
      StyleBox["j", "TI"], "-", 
      StyleBox["i", "TI"]}], ")"}], "/", 
    StyleBox["h", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6f15b683-a1dc-4fa5-9980-12aab30811fa"],
 ". The two together give the size of the ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "03512087-375b-4698-91f3-8cc1d1705f6e"],
 "-block of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c3e46866-d601-462c-b83e-669ddae8dcc4"],
 "."
}], "Text",ExpressionUUID->"03af5250-a81c-4a39-a13c-23a3be15998c"],

Cell[CellGroupData[{

Cell[TextData[{
 "Predict the block sizes at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2", ",", 
    StyleBox["n", "TI"], "\[LongEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"412dab3c-0888-4a2f-9978-270fbc2ce5bf"],
 ":"
}], "Text",ExpressionUUID->"d5484bfd-7033-41cb-87c0-82f5d43d4935"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"par", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TableauDimension", "[", "par", "]"}], ",", " ", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{"par", ",", " ", "2"}], "]"}], ",", "\n", "            ", 
      RowBox[{
       RowBox[{"TableauDimension", "[", "par", "]"}], " ", "*", " ", 
       RowBox[{"SchurDimension", "[", 
        RowBox[{"par", ",", " ", "2"}], "]"}]}]}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{"par", ",", " ", "parts"}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->
  "In[372]:=",ExpressionUUID->"29f4ec4c-f60c-49b2-b773-1479ad7c014f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "3", "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "4", ",", "4"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2", ",", "4"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0"}], "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9888385884764853`*^9},
 CellLabel->"Out[372]=",
 CellID->99657454,ExpressionUUID->"364082a9-c1ae-4b12-bca1-0ab74e0185aa"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Read row by row: the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "3", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "39e90ec2-c4e6-4bdb-a9e3-511a5d488cd8"],
 " block has size ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[CenterDot]", "4", "\[LongEqual]", "4"}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"ccca635a-f0f0-4183-b469-177e1ac0566b"],
 " (a four-dimensional bosonic sector). The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"75723a82-f6d4-4066-a024-457799f9e145"],
 " mixed block has size ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[CenterDot]", "2", "\[LongEqual]", "4"}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"5e243208-1704-4e18-a082-837f14fb1a96"],
 ". The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"07a39fb9-681a-4fd5-9cc2-d25a2d31cd95"],
 " fermionic block has size ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[CenterDot]", "0", "\[LongEqual]", "0"}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"4e433ccb-f8d6-43d5-a952-909d3fba4019"],
 ", ",
 StyleBox["exactly zero", "TI"],
 ", because you cannot antisymmetrise three slots over a two-dimensional \
space (the Pauli principle for three spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e7cbcdd3-72aa-483b-b154-411799142563"],
 " particles forbids it). The sum is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "+", "4", "+", "0", "\[LongEqual]", "8", "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"be00a557-6dc0-4dc1-9b04-9a349aaf37b7"],
 ". The decomposition exhausts the tensor space and tells you, without ever \
forming a projector, that any operation involving the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"d5b2a502-5f78-4956-bf1f-5a919e3db0c1"],
 " sector can be skipped."
}], "Text",ExpressionUUID->"414bb209-312c-48ad-a6b1-f84e722c1a5c"],

Cell[CellGroupData[{

Cell[TextData[{
 "When the input is already a ",
 Cell[BoxData[
 "YoungTableau"], "InlineFormula",ExpressionUUID->
  "52717620-bd5b-46db-9c30-37f07f264bb0"],
 ", ",
 Cell[BoxData[
  RowBox[{"TableauWeylDimension", "[", 
   RowBox[{"tab", ",", " ", "d"}], "]"}]], "InlineFormula",ExpressionUUID->
  "966cd4f3-6eac-40ae-869e-bb7f84c9ecb7"],
 " returns the same ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["W", "TI"], "\[Lambda]"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"88336152-030a-48ca-806a-81386b8f7181"],
 " by delegating to ",
 Cell[BoxData[
  RowBox[{"SchurDimension", "[", 
   RowBox[{
    RowBox[{"TableauShape", "[", "tab", "]"}], ",", " ", "d"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"02dc9543-5256-46bf-a577-d4543326af67"],
 ". Pair it with ",
 Cell[BoxData[
  RowBox[{"TableauDimension", "[", "tab", "]"}]], "InlineFormula",
  ExpressionUUID->"634f199d-1b82-48d8-a84e-9f5b78b7d1d0"],
 " to read both Schur-Weyl factors off the same object."
}], "Text",ExpressionUUID->"56ecbd15-05ff-42b8-972b-afe665ffc01d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TableauWeylDimension", "[", 
    RowBox[{
     RowBox[{"YoungTableau", "[", "#", "]"}], ",", " ", "2"}], "]"}], " ", 
   "&"}], " ", "/@", " ", "parts"}]], "Input",
 CellLabel->
  "In[373]:=",ExpressionUUID->"6a09b621-8a20-4d1f-bfae-4b0fadb8ec07"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "2", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.988838588495768*^9},
 CellLabel->"Out[373]=",
 CellID->2053068365,ExpressionUUID->"816229bb-2142-45d9-8ee8-beff47ee4b76"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The construction generalises to higher ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b00a82e1-af05-4e11-af17-3b45dd3c376c"],
 " and is the foundation of symmetry-resolved DMRG / TDVP: every bond carries \
an exact decomposition by partition ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "95105d1a-b7ad-4f1c-9761-2e86c1a520a2"],
 " and the block dimensions are read off in closed form."
}], "Text",ExpressionUUID->"b7ef1c27-593b-4817-8834-693e9cb1bcd2"],

Cell[TextData[{
 "Measure the decomposition explicitly, projector by projector. For each ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[RightTee]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ccce8e56-d78d-4cbd-909a-b0ee460ba188"],
 ", the isotypic projector ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["E", "TI"], "\[Lambda]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7792deb2-c713-4dca-bec5-f8327a2213e8"],
 " on ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", "3"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c92a7e8e-d3d3-4838-aabe-899d807b0a31"],
 " is the sum of single-tableau Young projectors over the standard tableaux \
of shape ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f5dd8fc9-7f76-4a33-b3d9-367c9fc5652c"],
 ". There is one of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "3", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8112af7e-e805-4b16-9bdd-8f281ae9caed"],
 " (namely ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"1532a95f-0831-4050-ba2b-25778c579f0b"],
 "), two of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1b18af58-d63f-4491-bc5e-9ff784c660cc"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", "3", "}"}]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5d2c1868-3719-49f1-a0a2-cb5b4ec82e5b"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", "2", "}"}]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1ea9a54a-4ffc-4c9e-9039-abe7756bab47"],
 ", matching ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"TableauDimension", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], " ", "=", " ", "2"}]], 
  "InlineFormula",ExpressionUUID->"ce837882-1503-494d-ba1b-94276247cea2"],
 "), and one of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a978f65a-17d2-43be-bb0c-c726e51c0d5e"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", "2", "}"}], ",", 
     RowBox[{"{", "3", "}"}]}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8cd474c6-2afe-4090-b9f5-6924846b6d34"],
 ")."
}], "Text",ExpressionUUID->"6456a436-f903-443a-a52a-67de2be9ce8c"],

Cell[CellGroupData[{

Cell[TextData[{
 "Build a random rank-3 tensor in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9cc508fb-6599-4330-86dd-0dceacc9d8f3"],
 "."
}], "Text",ExpressionUUID->"3fbb208c-7536-4537-8ef5-ef24dae5f45b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T3", " ", "=", " ", 
