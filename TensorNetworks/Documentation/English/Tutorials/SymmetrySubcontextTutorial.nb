Cell[CellGroupData[{

Cell[TextData[{
 "An element ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["k", "TI"]], " ", 
    SubscriptBox["\[Sigma]", 
     StyleBox["k", "TI"]], "\[Element]", 
    StyleBox["C",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     SubscriptBox[
      StyleBox["S", "TI"], "4"], "]"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ec834116-a664-41a2-8a68-c642b460e576"],
 " acts on ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0f559493-ffe1-4199-8379-2f129c31dbb0"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderscriptBox["\[Sum]", 
     StyleBox["k", "TI"],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["c", "TI"], 
     StyleBox["k", "TI"]], " ", 
    SubscriptBox["\[Sigma]", 
     StyleBox["k", "TI"]], 
    RowBox[{"(", 
     StyleBox["R", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9b3a0e2c-534d-44d1-9314-229a86582720"],
 ", and is an algebraic identity of ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "99f4e281-3d28-4759-8e9b-3de97797f9b8"],
 " exactly when that sum is zero. The right-annihilator of ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cafe035b-4484-4a80-a136-f02bfb3d2764"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     SubscriptBox[
      StyleBox["S", "TI"], "4"], "]"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cf3c4fe0-c7fc-4108-aa28-bfab1f6c892a"],
 " is the space of identities the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a5db977b-0536-4ffd-9fbc-b996fa2c3803"],
 " irreducible representation enforces, and it is searchable: precompute the \
24 permuted copies of ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6b27b41c-c4e5-4e99-a374-05402b34b8b7"],
 " once and the relation predicate becomes a single dot product against a \
coefficient vector."
}], "Text",ExpressionUUID->"af7e444a-77fd-4308-b8a4-b64311447f46"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"perms", " ", "=", " ", 
   RowBox[{"Permutations", "[", 
    RowBox[{"Range", "[", "4", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"permutedR", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"R", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "perms"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"isRelation", "[", "coefs_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"coefs", " ", ".", " ", "permutedR"}], "]"}], "]"}], "]"}], 
    " ", "<", " ", "tol"}]}], ";"}]}], "Input",
 CellLabel->
  "In[423]:=",ExpressionUUID->"a4daaa12-463b-4e36-94f7-d2f4b225a6b5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Sweep all two-term combinations ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", 
     StyleBox["a", "TI"]], "+", 
    RowBox[{"\[Epsilon]", " "}], 
    SubscriptBox["\[Sigma]", 
     StyleBox["b", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"82d0456b-7151-49d0-8ed9-bcea87755c73"],
 " over ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["a", "TI"], "<", 
    StyleBox["b", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4a53594a-711d-4aaa-96e2-12a1f4f75040"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "\[Element]", 
    RowBox[{"{", 
     RowBox[{"\[PlusMinus]", "1"}], "}"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"539f2594-bb93-406a-b931-1853a040076c"],
 " using ",
 Cell[BoxData[
 "Subsets"], "InlineFormula",ExpressionUUID->
  "c0ff12e6-2044-4515-9e92-a7e30c246159"],
 " to enumerate ordered index pairs and ",
 Cell[BoxData[
 "Cases"], "InlineFormula",ExpressionUUID->
  "3aec6aec-ccc0-4cd4-b5c0-1228bc02a291"],
 " to keep only the annihilators, decoded as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Sigma]", 
      StyleBox["a", "TI"]], ",", "\[Epsilon]", ",", 
     SubscriptBox["\[Sigma]", 
      StyleBox["b", "TI"]]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1e17d1fd-1dd5-460e-b84e-ca850fcbcd8b"],
 " triples."
}], "Text",ExpressionUUID->"8126f76a-fe40-4e20-8ecb-97c532095f58"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"twoTerm", " ", "=", " ", 
   RowBox[{"Cases", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "[", "24", "]"}], ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}]}], "}"}], "]"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a_", ",", " ", "b_"}], "}"}], ",", " ", "eps_"}], "}"}], 
       " ", "/;", " ", 
       RowBox[{"isRelation", "[", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"b", " ", "->", " ", "eps"}]}], "}"}], ",", " ", "24"}], 
         "]"}], "]"}]}], " ", ":>", "\n", "        ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"perms", "[", 
         RowBox[{"[", "a", "]"}], "]"}], ",", " ", "eps", ",", " ", 
        RowBox[{"perms", "[", 
         RowBox[{"[", "b", "]"}], "]"}]}], "}"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"Length", "[", "twoTerm", "]"}]}], "Input",
 CellLabel->
  "In[426]:=",ExpressionUUID->"a52dd877-466f-4420-9132-cd2a642aaa1c"],

Cell[BoxData["84"], "Output",
 CellChangeTimes->{3.98883858973765*^9},
 CellLabel->"Out[427]=",
