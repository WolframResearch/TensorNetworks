   RowBox[{"contentSum", "[", "par_List", "]"}], " ", ":=", "\n", "    ", 
   RowBox[{"Total", " ", "@", " ", 
    RowBox[{"Flatten", " ", "@", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"j", " ", "-", " ", "i"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "par", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", 
         RowBox[{"par", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}]}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[460]:=",ExpressionUUID->"d806a934-47d6-4c9b-94dc-da7b2019ae7c"]
}, Open  ]],

