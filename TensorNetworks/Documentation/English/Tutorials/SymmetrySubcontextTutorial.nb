Cell[CellGroupData[{

Cell["\<\
Symbolic covariance matrix of a bivariate normal distribution\
\>", "Subsubsection",ExpressionUUID->"4e8e4565-ded7-498d-9285-8a9a1b57a266"],

Cell[TextData[{
 StyleBox["Covariance is symmetric in its two variables: ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Cov",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["X", "TI"], ",", 
      StyleBox["Y", "TI"]}], ")"}], "\[LongEqual]", 
    StyleBox["Cov",
     FontSlant->"Plain"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["Y", "TI"], ",", 
      StyleBox["X", "TI"]}], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d5dfe086-f486-48d8-acb5-a9d9766f7408"],
 StyleBox[" by definition. ", "TI"],
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "2ae107a0-ef45-472a-a3f3-c8ed2ece18e8"],
 StyleBox[" confirms this symbolically in the correlation parameter ", "TI"],
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9d47664e-4232-4115-a0a9-3341c30f0251"],
 StyleBox[", the structural reason a covariance bond carries ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "+", "1"}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e37d1989-fba4-454f-b4e6-84fa372b7b87"],
 StyleBox[" free entries rather than ", "TI"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["d", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e9e3ff7a-5a81-4626-b5fe-de191531cae1"],
 StyleBox[".", "TI"]
}], "Text",ExpressionUUID->"7d367511-1979-4538-8eb6-dd63a3d46f0d"],

Cell[CellGroupData[{

Cell[TextData[{
 "The covariance matrix of a multivariate distribution is symbolic when the \
distribution carries a symbolic parameter. For the bivariate normal ",
 Cell[BoxData[
  RowBox[{"BinormalDistribution", "[", "\[Rho]", "]"}]], "InlineFormula",
  ExpressionUUID->"123852f2-1c33-46bb-8362-a64aa51a699d"],
 " (unit variances, correlation parameter ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4ae93183-8afa-40f1-a5e2-53ca03fdb571"],
 "), built-in ",
 Cell[BoxData[
 "Covariance"], "InlineFormula",ExpressionUUID->
  "93757b6c-1674-4053-bb74-076411432fc3"],
 " returns the symbolic matrix ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"1", "\[Rho]"},
       {"\[Rho]", "1"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.28], {
           Offset[0.7]}, 
          Offset[0.28]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d4edc617-ddb0-49e2-bccf-823acf88d8c6"],
 ", manifestly symmetric in ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dae2559c-245c-41e2-85eb-823322450389"],
 "."
}], "Text",ExpressionUUID->"c68a97d5-a870-4948-b389-06b1eb42c5f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"covMat", " ", "=", " ", 
