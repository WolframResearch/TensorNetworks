 CellID->2079071816,ExpressionUUID->"0b03aa40-5482-4ea8-b08c-8862896c08e3"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The two lists agree exactly. The numerical diagonalisation was a courtesy; \
the spectrum was already determined by the combinatorics of ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "8d2db7c2-3831-46ef-a997-320c6c2741cc"],
 ", ",
 Cell[BoxData[
 "SchurDimension"], "InlineFormula",ExpressionUUID->
  "fed1ec90-ef1c-4d49-a5db-189c86874bf4"],
 " (powered by ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "adbd39d2-8183-4e1f-b6d0-78673d385f6a"],
 "), and ",
 Cell[BoxData[
 "contentSum"], "InlineFormula",ExpressionUUID->
  "0733533b-07ef-4e8a-8e50-9ea687438ece"],
 "."
}], "Text",ExpressionUUID->"5450b664-adab-49a9-9280-eed3aa251bb9"],

Cell[CellGroupData[{

Cell[TextData[{
 "That cross-check used an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"8", "\[Cross]", "8"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a03f9f09-9bce-4649-bc4b-cb1e88e34de3"],
 " matrix. The combinatorial path scales with the number of partitions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "(", 
    StyleBox["n", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cebf8f28-d916-4db0-9376-e31445ade8cc"],
 ", which grows slowly with ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0c915f9d-61ed-43fb-a2a0-9958980aca66"],
 ", while explicit diagonalisation scales with the matrix dimension ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "342d542e-0a90-4f8a-952d-3e1fdab0c792"],
 ", which grows quickly. Generalise the helpers and time both paths on a \
larger system."
}], "Text",ExpressionUUID->"a0babda8-a149-450f-b706-88ff91e641f0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"applySwapND", "[", 
    RowBox[{"a_", ",", " ", "b_", ",", " ", "n_", ",", " ", "d_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"perm", " ", "=", " ", 
       RowBox[{"Range", "[", "n", "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"perm", "[", 
        RowBox[{"[", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], "]"}], " ", "=", " ", 
       RowBox[{"perm", "[", 
        RowBox[{"[", 
         RowBox[{"{", 
          RowBox[{"b", ",", " ", "a"}], "}"}], "]"}], "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"ArrayReshape", "[", "\n", "        ", 
       RowBox[{
        RowBox[{"Transpose", "[", "\n", "            ", 
         RowBox[{
          RowBox[{"ArrayReshape", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", 
             RowBox[{"d", "^", "n"}], "]"}], ",", " ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"d", ",", " ", 
              RowBox[{"2", " ", "n"}]}], "]"}]}], "]"}], ",", "\n", 
          "            ", 
          RowBox[{"Join", "[", 
           RowBox[{"perm", ",", " ", 
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{"n", " ", "+", " ", "1"}], ",", " ", 
              RowBox[{"2", " ", "n"}]}], "]"}]}], "]"}]}], "\n", "        ", 
         "]"}], ",", "\n", "        ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"d", "^", "n"}], ",", " ", 
          RowBox[{"d", "^", "n"}]}], "}"}]}], "\n", "    ", "]"}]}]}], "\n", 
    "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"classFnH", "[", 
     RowBox[{"n_", ",", " ", "d_"}], "]"}], " ", ":=", "\n", "    ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"applySwapND", "[", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", " ", "n", ",", " ", "d"}], 
        "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"Subsets", "[", 
       RowBox[{
        RowBox[{"Range", "[", "n", "]"}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"partitionSpectrum", "[", 
    RowBox[{"n_", ",", " ", "d_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Sort", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Flatten", " ", "@", " ", 
      RowBox[{"Map", "[", "\n", "        ", 
       RowBox[{
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"contentSum", "[", "#", "]"}], ",", "\n", "            ", 
           RowBox[{
            RowBox[{"TableauDimension", "[", "#", "]"}], " ", "*", " ", 
            RowBox[{"SchurDimension", "[", 
             RowBox[{"#", ",", " ", "d"}], "]"}]}]}], "]"}], " ", "&"}], ",", 
        "\n", "        ", 
        RowBox[{"IntegerPartitions", "[", "n", "]"}]}], "\n", "    ", "]"}]}],
      ",", "\n", "    ", "Greater"}], "\n", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[466]:=",ExpressionUUID->"a969bb84-a8d3-47d1-96c7-408bb6e1a415"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6cac98f0-9761-4c9c-b4a7-049614b45606"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"be1d1e88-f54a-4999-92ef-2975cf53436e"],
 " the Hilbert space is 64-dimensional and the explicit Hamiltonian is a \
dense ",
 Cell[BoxData[
  FormBox[
   RowBox[{"64", "\[Cross]", "64"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6908603a-1e58-4940-ac13-54246e563444"],
 " matrix. Clear the cache and time both paths."
}], "Text",ExpressionUUID->"35d42b78-0b5d-44f6-aed3-d5b6a17df0e3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearSystemCache", "[", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tCombi", ",", " ", "sCombi"}], "}"}], " ", "=", " ", 
   RowBox[{"AbsoluteTiming", " ", "@", " ", 
    RowBox[{"partitionSpectrum", "[", 
     RowBox[{"6", ",", " ", "2"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearSystemCache", "[", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tNaive", ",", " ", "sNaive"}], "}"}], " ", "=", " ", 
   RowBox[{"AbsoluteTiming", " ", "@", " ", 
    RowBox[{"Sort", "[", 
     RowBox[{
      RowBox[{"Eigenvalues", " ", "@", " ", 
       RowBox[{"classFnH", "[", 
        RowBox[{"6", ",", " ", "2"}], "]"}]}], ",", " ", "Greater"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"tCombi", ",", " ", "tNaive"}], "}"}]}], "Input",
 CellLabel->
  "In[469]:=",ExpressionUUID->"f915dfd2-3dba-4688-87f3-7fbe7c042ec6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.000616`", ",", "0.118348`"}], "}"}]], "Output",
 CellChangeTimes->{3.9888385906959753`*^9},
 CellLabel->"Out[473]=",
 CellID->1253591175,ExpressionUUID->"58b0de0e-b374-4a4b-be5f-bd6c42b91925"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"sCombi", " ", "-", " ", "sNaive"}], "]"}], "]"}], " ", "<", " ", 
  "tol"}]], "Input",
 CellLabel->
  "In[474]:=",ExpressionUUID->"8eb01cb1-9595-48d0-9593-a927e04e9383"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988838590719325*^9},
 CellLabel->"Out[474]=",
 CellID->144817508,ExpressionUUID->"07fbd761-9a1a-49c9-9780-a4fb590e8591"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The two spectra match to machine precision, and the combinatorial path \
finishes in sub-millisecond time while the dense diagonalisation takes orders \
of magnitude longer. The gap widens with ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3895d102-a4ba-4765-9881-13da2a476302"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a2ddaaa3-fcb8-4696-91da-27bbf806febc"],
 ", because the combinatorial cost is set by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["p", "TI"], "(", 
    StyleBox["n", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"13ad3d01-1084-490d-a0b9-95d2b19f56ff"],
 " partitions while the diagonalisation cost scales with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7ccc821c-2572-4607-88b1-9027c47922db"],
 "."
}], "Text",ExpressionUUID->"940485b8-86f5-431a-8c4f-7cd346efdd72"],

Cell[TextData[{
 "This is the payoff for permutation-invariant systems. Hamiltonians that are \
class functions of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d01c8296-e68e-4e71-8512-92f316e008db"],
 " on the sites (all-to-all exchange, certain ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["J", "TI"], "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ad4933f9-a105-4029-be6e-e207e6ea828d"],
 "-",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["J", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cbb10021-c19b-47d5-ad58-418c10ffed0e"],
 " symmetric models, collective spin models) have their full spectrum \
determined by partitions of ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0c73bcf2-ae20-4335-ba30-e39e72a98689"],
 " and block multiplicities. No exact diagonalisation, no Lanczos sweep, no \
SVD: a single sum over an ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{
     RowBox[{"IntegerPartitions", 
       RowBox[{"[", 
         StyleBox["n", "TI"], "]"}]}]},
    "Abs"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3d3a4bcf-193e-4d00-9439-15c88391c597"],
 "-entry table delivers every eigenvalue with multiplicity."
}], "Text",ExpressionUUID->"bd71ef1b-d34e-47a1-8715-bdf866e7b896"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Where this leaves us", "Section",ExpressionUUID->"c712f411-beeb-44df-bca2-b6e0b6ca0a33"],

Cell[TextData[{
 "Every Symmetry function in ",
 Cell[BoxData[
  StyleBox["Wolfram`TensorNetworks`Symmetry`", "InlineCode"]], "InlineCode",
  ExpressionUUID->"36740e23-0297-4727-9cbb-48cb8818d0c1"],
 " has appeared at least once on a tensor with a physical reason to exist. \
Five operational capabilities follow:"
}], "Text",ExpressionUUID->"fbca7726-bb6c-44d2-93b8-571aa91cf22c"],

Cell[TextData[{
 StyleBox["Block-size prediction.",
  FontWeight->"Bold"],
 " For a rank-",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "aa12fe9a-8b9c-4a42-997b-c528c331de24"],
 " tensor and partition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[RightTee]", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "be2b3c8b-29e5-4b34-b212-0e3dd79d4c40"],
 ", read the size of the ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "13ea4516-51ca-4c7c-8f2c-f37135366800"],
 "-isotypic block at any bond dimension ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2694d6e7-28f8-4233-bb73-799a87fbb1a2"],
 " from ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"TableauDimension", "[", "par", "]"}], " ", "*", " ", 
   RowBox[{"SchurDimension", "[", 
    RowBox[{"par", ",", " ", "d"}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "f2684677-059d-4a3a-b9af-677fd108b406"],
 ", and identify sectors that vanish identically (rank-3 fermionic at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b2e3a9fd-9c76-4c90-9c52-595ad863aae4"],
 ", rank-4 fully antisymmetric at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LessEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"aa8e5a53-93f2-4efe-a888-3335f7c8c138"],
 ", etc.). Demonstrated in the rank-3 Schur-Weyl table and the rank-4 \
enumeration."
}], "Item",ExpressionUUID->"46693ae1-c0b9-4376-97af-1787ea13cde2"],

Cell[TextData[{
 StyleBox["Multi-term symmetry projection.",
  FontWeight->"Bold"],
 " Enforce all classical Riemann symmetries (the three pair relations plus \
the multi-term first Bianchi identity) with a single ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "50e83673-a2a1-4a24-85dc-1cc273d0841c"],
 " onto the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c484f3a6-a835-42e3-ac7d-8457ab0c5f5d"],
 " tableau, where built-in ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "7aecdd2c-e513-48aa-9cb2-1b8e0f09eeaa"],
 " reaches only the mono-term subset. Demonstrated in the Riemann section, \
which also derives those identities by searching the right-annihilator of ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b08c03c5-e0f6-4d45-8643-6087455b5670"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     SubscriptBox[
      StyleBox["S", "TI"], "4"], "]"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"34b15787-dc90-4ae9-b858-ef6ed1e1b78f"],
 "."
}], "Item",ExpressionUUID->"cd5e2d1f-70d6-4c5c-8909-14da119f8f1e"],

Cell[TextData[{
 StyleBox["Statistics-sector projection that survives contraction.",
  FontWeight->"Bold"],
 " Project a TN bond onto a chosen statistics sector (boson, fermion, or \
mixed); built-in ",
 Cell[BoxData[
 "TensorContract"], "InlineFormula",ExpressionUUID->
  "80bb3536-bb18-48bc-bdf7-acca2f87fe1d"],
 " and ",
 Cell[BoxData[
 "Dot"], "InlineFormula",ExpressionUUID->
  "2dd8be31-1db5-4e77-8bed-40398652b80f"],
 " preserve the sector automatically downstream. Demonstrated on the \
fermionic bond and the Ricci partial trace."
}], "Item",ExpressionUUID->"b835f63e-3134-4f9b-be88-759e12086aaf"],

Cell[TextData[{
 StyleBox["Block-sparse contraction.",
  FontWeight->"Bold"],
 " Replace a dense ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "be6ce60d-110a-4432-9ca2-358c2c36979f"],
 "-element bond contraction by the sum of within-sector contractions over the \
irreducible-representation blocks; cross-sector products are zero by Schur \
orthogonality. Demonstrated at rank 2 (block-sparse trace), rank 3 \
(block-sparse Frobenius), and rank 4 (the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"5", "\[Cross]", "5"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"167ecc37-178d-4b5c-9a0e-7e7d74ca3110"],
 " same-sector-only diagonal; ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6.4", "\[Cross]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"86b9a4fd-0675-40ba-8715-7be431ff9c9a"],
 " FLOP saving with one Riemann-like tensor)."
}], "Item",ExpressionUUID->"fb0210eb-8bbf-44d2-80e3-6ca495974a83"],

Cell[TextData[{
 StyleBox["Class-function Hamiltonian spectrum from combinatorics.",
  FontWeight->"Bold"],
 " For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["H", "TI"], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], "<", 
      StyleBox["j", "TI"]}],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["P", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a7abd02f-2de8-43b8-8627-9df2aae4262e"],
 ", every eigenvalue with multiplicity follows from ",
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "e307b0af-29f7-4a98-80dd-a23c85769599"],
 ", ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "c2aed811-ea09-48ce-977b-17c2b7a2b186"],
 ", ",
 Cell[BoxData[
 "SchurDimension"], "InlineFormula",ExpressionUUID->
  "7c78996c-4c4a-49e2-9545-3a372fa73eeb"],
 ", and a one-line ",
 Cell[BoxData[
 "contentSum"], "InlineFormula",ExpressionUUID->
  "9ace317f-7f56-4e32-834c-8efaf79724e7"],
 " helper, with no diagonalisation. The class-function H section measures \
both paths, with the combinatorial path orders of magnitude faster at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "6", ",", 
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9753d02d-6950-454c-9f65-2e5597f25d42"],
 "."
}], "Item",ExpressionUUID->"928509d7-6fa5-467b-a569-42bd2bd5b996"],

Cell["Three traps worth flagging:", "Text",ExpressionUUID->"4a25eaf2-a792-45f3-b873-ddcd49e2a6d3"],

Cell[TextData[{
 Cell[BoxData[
 "YoungSymmetrize"], "InlineFormula",ExpressionUUID->
  "47efd544-f3fa-44da-ac21-574a52fc0cdf"],
 " returns the ",
 StyleBox["unnormalised", "TI"],
 " symmetriser ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["c", "TI"], 
    StyleBox["T", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "342c6acd-11ee-4b4f-8cdd-74dca54ef7ef"],
 "; for a projector (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["P", "TI"], "2"], "\[LongEqual]", 
    StyleBox["P", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "28625c7f-f3bb-4368-9e29-5e672a105ed6"],
 ") call ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "638ae840-0305-4ea2-bfbd-9f3d32322589"],
 ". Iterative TN algorithms need the idempotent."
}], "Item",ExpressionUUID->"aa659f6c-cca1-40b2-ba4a-7085e777d00a"],

Cell["\<\
The Young symmetriser is applied rows-first, columns-second: row symmetry can \
be broken by the subsequent column antisymmetrisation. For mixed-symmetry \
diagrams (anything other than fully-row or fully-column) the first symmetry \
imposed is not generally preserved.\
\>", "Item",ExpressionUUID->"4a6b2026-6a03-44ac-9274-d1c125620fb6"],

Cell[TextData[{
 "The validator is strict: tableau slot labels must be a permutation of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", ",", "2", ",", "\[Ellipsis]", ",", 
    StyleBox["n", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c540545b-a3db-4a16-b6bb-7cec5f65ef0f"],
 ". Distinct positive integers outside that range (e.g. ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", " ", "5", ",", " ", "7"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}]], "InlineFormula",
  ExpressionUUID->"7aadc944-917b-4d32-98d9-850f96af9e7b"],
 ") are rejected."
}], "Item",ExpressionUUID->"1d0de37b-e087-420e-bf66-de7dbe31ee13"],

