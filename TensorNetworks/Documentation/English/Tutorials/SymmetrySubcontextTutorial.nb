  ExpressionUUID->"c7581d02-4641-4321-b1af-18e7ed1ed332"],
 "."
}], "Text",ExpressionUUID->"5803fcfa-2b16-4a58-adc2-751016648a6e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"ArrayReshape", "[", 
