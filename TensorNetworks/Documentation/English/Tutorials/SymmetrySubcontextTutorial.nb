  "In[315]:=",ExpressionUUID->"cc199d89-bd4b-45e5-84dd-f0d329b715e3"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.98883858766457*^9},
 CellLabel->"Out[315]=",
 CellID->75621612,ExpressionUUID->"6aa98fd9-f827-4d3f-94ec-0fa313da690b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Both hold identically (not just numerically), so ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "3f7efe72-80ce-4423-b01d-c5c41e16f723"],
 " and SWAP-eigenspace projection are the same linear map on rank-2 tensors. \
The eigenspace dimensions are the ranks of the two SWAP projectors."
}], "Text",ExpressionUUID->"2eb18822-2ec5-4b79-85e5-6d72a79c574d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"MatrixRank", "[", "swapPlus", "]"}], ",", " ", 
   RowBox[{"MatrixRank", "[", "swapMinus", "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[316]:=",ExpressionUUID->"0dfab257-e237-4008-9819-180c0577edc7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"3", ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{3.98883858768963*^9},
 CellLabel->"Out[316]=",
 CellID->1809597507,ExpressionUUID->"6ec4941c-332d-4465-a193-3926ff8ef475"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Three and one, matching ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "+", "1"}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8ae5172c-f6a9-4ce4-afed-5eb4911d87d0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "-", "1"}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"4b56f7b3-2c7d-4a4e-82de-11698ea1f8cc"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"de4d57b0-add1-4687-8cb1-3ff74d1691a3"],
 ": the symmetric block holds the spin-",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9b653ce3-3336-4edc-85b9-71cee89da2c3"],
 " triplet, the antisymmetric block holds the spin-",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4b8e6694-b2ff-48c4-b324-9b3d08a46dd3"],
 " singlet. SWAP, transpose, ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "b714dc89-aa32-4d3d-80d3-fb1cc949eb7a"],
 ", and built-in ",
 Cell[BoxData[
  RowBox[{"Symmetrize", "[", 
   RowBox[{"...", ",", " ", 
    RowBox[{"Symmetric", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], "]"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"1205b8d2-8abc-4412-92bc-98640db726dc"],
 " are the same operation written in four notations; whichever one is most \
readable in context is the one to reach for."
}], "Text",ExpressionUUID->"ca31e684-133b-4dc8-8cee-b3a9919d38fc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A fermionic bond in a TN", "Subsubsection",ExpressionUUID->"21fef19c-9cb7-4539-8464-7343ae0b29a8"],

Cell[TextData[{
 StyleBox["A fermionic bond carries a tensor that must be antisymmetric under \
particle exchange (the Pauli principle on a single edge of a TN). One ", "TI"],
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "d8cbd804-ab06-4c0e-a8fd-5a76e7bf1836"],
 StyleBox[" onto ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"95bf0117-ef5a-4250-9553-4235bd844cf7"],
 StyleBox[" enforces this before any contraction; downstream ", "TI"],
 Cell[BoxData[
 "Dot"], "InlineFormula",ExpressionUUID->
  "e8431595-0c0b-491b-80a0-1cd5e521892a"],
 StyleBox[", ", "TI"],
 Cell[BoxData[
 "TensorContract"], "InlineFormula",ExpressionUUID->
  "4c3f1c3f-17e8-48ba-a26b-a70cedece61d"],
 StyleBox[", and SVD preserve the sector automatically, halving the stored \
entries from ", "TI"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["d", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3a2f551d-550f-4777-baf8-d01759fd34cc"],
 StyleBox[" to ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "-", "1"}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"669e4dee-9c11-4b20-a6ad-3651c605df27"],
 StyleBox[".", "TI"]
}], "Text",ExpressionUUID->"51ffc8d8-0640-4e04-8ef7-fd0514dd36ac"],

Cell[CellGroupData[{

Cell[TextData[{
 "Here the projection saves storage. A one-bond TN with two nodes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["A", "TI"], ",", 
    StyleBox["B", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "835d512c-a4a4-417c-9c11-cb7be0adca87"],
 " describing identical fermions and bond tensor ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "41240826-f18d-4e2d-855d-1a12ec2fdbe3"],
 " contracts to"
}], "Text",ExpressionUUID->"c1fdeae1-d44b-4715-abdd-85579de43a01"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{"value", " ", 
    RowBox[{"\[LongEqual]", " "}], 
    UnderscriptBox["\[Sum]", 
     RowBox[{
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox["i", "TI"]], " ", 
    SubscriptBox[
     StyleBox["T", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], " ", 
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox["j", "TI"]], "."}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"661179b9-e126-4d2b-\
884e-2f4d8cf770a0"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The physics demands ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[Element]", 
    SuperscriptBox["\[CapitalLambda]", "2"], 
    StyleBox["V", "TI"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "123ba78b-1ed9-40aa-946e-f33cb8622676"],
 ". Storing both halves of ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4b61e20b-7257-4665-8960-fb11a1637627"],
 " wastes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], "+", "1"}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"add8fb6b-b65e-43e6-ae6a-bf824fd7d63d"],
 " slots on a sector the Pauli principle forbids; one ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "915c6e1e-1028-4ae5-808c-0db3855dfde4"],
 " zeroes it. Start with a generic random bond tensor at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0e3801af-fee4-44f2-b5c4-cd517190335a"],
 "."
}], "Text",ExpressionUUID->"950cef1c-c6e0-4ba0-9cbf-42ad85ae0d7f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "3", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d", " ", "=", " ", "4"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"d", ",", " ", "d"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[317]:=",ExpressionUUID->"ab59055e-e34d-4a0d-939c-d98a057d6817"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Project onto the antisymmetric (fermionic) shape.", "Text",ExpressionUUID->"4086b0ee-659b-4ac5-a386-8d1abd8659ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TFermi", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T", ",", " ", "antiTab"}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[320]:=",ExpressionUUID->"d0735dcd-80dc-4534-bd53-4083f23e1e0e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Build random vectors for the two surrounding nodes.", "Text",ExpressionUUID->"934435b0-014f-485a-afbe-3843cea97be7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "d"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"B", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "d"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[321]:=",ExpressionUUID->"ef46a893-a3b4-4612-aa8f-55479134510b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Contract the projected bond against ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5769e046-0da4-4976-ab26-0b82240700f9"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["B", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "adeb1b4f-1b03-4fa7-9d6a-621d5509a10f"],
 ". The scalar equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "(", 
    RowBox[{
     StyleBox["A", "TI"], "\[CenterDot]", 
     StyleBox["T", "TI"], "\[CenterDot]", 
     StyleBox["B", "TI"], "-", 
     StyleBox["B", "TI"], "\[CenterDot]", 
     StyleBox["T", "TI"], "\[CenterDot]", 
     StyleBox["A", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c39a95a5-a7c1-4169-a0f5-4427f571c96d"],
 " by direct expansion."
}], "Text",ExpressionUUID->"4cf93943-23be-44bd-8bd1-57219010c735"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"A", " ", ".", " ", "TFermi", " ", ".", " ", "B"}]], "Input",
 CellLabel->
  "In[323]:=",ExpressionUUID->"091258a8-d9b1-4f81-ba51-caba9b94132c"],

Cell[BoxData["0.001351512511221694`"], "Output",
 CellChangeTimes->{3.9888385877633543`*^9},
 CellLabel->"Out[323]=",
 CellID->1241891335,ExpressionUUID->"eff1032d-caec-4e2c-bdf0-9828fee1a20c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "To see what the Young projection ",
 StyleBox["does", "TI"],
 " to a tensor network, build the same three-node network with the ",
 StyleBox["unprojected",
  FontWeight->"Bold"],
 " bond ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7fcbeae6-7217-43cf-9963-1c88788357a1"],
 " and contract it through the paclet's contraction engine. Encode the three \
nodes and their shared indices as a hyperedge list (vector ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "927f96ae-2e0c-46ae-bfc6-ea3ef4ae2047"],
 " on index ",
 Cell[BoxData[
 "i"], "InlineFormula",ExpressionUUID->"8e5a844e-9bc9-4081-abbe-d14869da2991"],
 ", the bond on ",
 Cell[BoxData[
  RowBox[{"i", ",", " ", "j"}]], "InlineFormula",ExpressionUUID->
  "a70ced27-e468-4fcd-ac98-57319289ca2f"],
 ", vector ",
 Cell[BoxData[
  FormBox[
   StyleBox["B", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1aec534b-cb9f-4964-b77c-0a180f1405d6"],
 " on ",
 Cell[BoxData[
 "j"], "InlineFormula",ExpressionUUID->"e1c898b6-4fcc-4ed0-90a3-fff6564056b4"],
 "), then let ",
 Cell[BoxData[
 "TensorNetworkContract"], "InlineFormula",ExpressionUUID->
  "b0727c83-4c4a-4797-9043-7f2e8b9ade24"],
 " evaluate it."
}], "Text",ExpressionUUID->"d551b516-99c8-43a8-8961-f98a08074882"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bareTN", " ", "=", " ", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", " ", "T", ",", " ", "B"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "\"\<i\>\"", "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\""}], "}"}], ",", " ", 
      RowBox[{"{", "\"\<j\>\"", "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.988838660589405*^9, 3.988838670189556*^9}},
 CellLabel->
  "In[477]:=",ExpressionUUID->"fb14d598-b984-452b-96f5-f5cbba88902f"],

