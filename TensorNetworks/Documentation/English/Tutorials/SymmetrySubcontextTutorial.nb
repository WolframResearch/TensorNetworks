     Cell[BoxData[
     "HookFactor"], "InlineFormula",ExpressionUUID->
      "bc8c0205-eaad-4b39-b83c-33c17d5e400e"]
    }], "TableText",ExpressionUUID->"2b5c3e1a-b89b-48d1-b846-8a45b98dd026"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
