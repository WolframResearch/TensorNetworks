    "\[LongEqual]", "3"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7bb65bbe-46c2-45fe-b87a-9b49cc28efae"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["c", "TI"], 
