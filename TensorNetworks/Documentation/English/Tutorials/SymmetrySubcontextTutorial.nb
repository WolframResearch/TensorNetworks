Cell[CellGroupData[{

Cell[TextData[{
 "Now apply ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "bde77d0f-8032-49af-a33c-1b9edfd00386"],
 " to the bond node ",
 StyleBox["inside", "TI"],
 " the network: feed the antisymmetric projection of ",
 Cell[BoxData[
  FormBox[
   StyleBox["T", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "175ef02e-8acd-4028-bac7-f46d2e36b3af"],
 " into the same hyperedge layout, then contract. This is the \
symmetry-to-core-TN handoff in one step: ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "841c50bd-0739-4839-ad5d-153245111c7d"],
 " rewrites the bond into the fermionic sector, and ",
 Cell[BoxData[
 "TensorNetworkContract"], "InlineFormula",ExpressionUUID->
  "f3ffaaee-e273-4415-af1b-6ad215d05a67"],
 " evaluates the symmetry-restricted network."
}], "Text",ExpressionUUID->"7c763354-4b9c-4446-bde7-f07d911c17ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fermionTN", " ", "=", " ", 
  RowBox[{"TensorNetwork", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", " ", 
      RowBox[{"YoungProject", "[", 
       RowBox[{"T", ",", " ", "antiTab"}], "]"}], ",", " ", "B"}], "}"}], ",",
     "\n", "    ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "\"\<i\>\"", "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<i\>\"", ",", " ", "\"\<j\>\""}], "}"}], ",", " ", 
      RowBox[{"{", "\"\<j\>\"", "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.988838674475791*^9, 3.98883867967037*^9}},
 CellLabel->
  "In[479]:=",ExpressionUUID->"c6352ce1-d45a-44ac-9d7e-d7913a4c5c0f"],

