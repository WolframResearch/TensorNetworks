            RowBox[{"{", "3", "}"}], ",", " ", "2"}], "]"}]}]}], "]"}], ",", 
       "\n", "        ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"contentSum", "[", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], ",", "    ", 
         RowBox[{
          RowBox[{"TableauDimension", "[", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "1"}], "}"}], "]"}], "    ", "*", " ", 
          RowBox[{"SchurDimension", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", "2"}], "]"}]}]}], 
        "]"}], ",", "\n", "        ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"contentSum", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "]"}], ",", 
         " ", 
         RowBox[{
          RowBox[{"TableauDimension", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "]"}], " ", "*",
           " ", 
          RowBox[{"SchurDimension", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
            "2"}], "]"}]}]}], "]"}]}], "\n", "    ", "}"}]}], ",", "\n", 
    "    ", "Greater"}], "\n", "]"}]}]], "Input",
 CellLabel->
