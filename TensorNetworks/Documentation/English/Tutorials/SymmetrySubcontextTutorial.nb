Cell[BoxData[
 RowBox[{"TensorNetworkContract", "[", "fermionTN", "]"}]], "Input",
 CellChangeTimes->{{3.988838674475791*^9, 3.988838678477118*^9}},
 CellLabel->"In[480]:=",
 CellID->2006213875,ExpressionUUID->"9975461f-ffca-4110-9f9d-08145da3062c"],

