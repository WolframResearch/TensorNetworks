    "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988838588015284*^9},
 CellLabel->"Out[346]=",
 CellID->655266165,ExpressionUUID->"c231167d-1920-409d-a15d-8ddece091e89"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Read the rightmost column: at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "10"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"45daa6d4-6f73-4f16-9bc1-aa5ef53d7407"],
 " the symmetric subspace is 11-dimensional inside a 1024-dimensional Hilbert \
space, a 93-fold compression. Every TN algorithm that promises to stay in the \
symmetric sector (Dicke-state preparation, Lipkin-Meshkov-Glick spin models, \
permutation-invariant Ans\[ADoubleDot]tze) only needs to allocate and \
contract ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    StyleBox["n", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8f1b80fb-1ba4-4e4d-9dc4-b58b9eef2fc6"],
 " amplitudes per bond, not ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    SuperscriptBox["2", 
     StyleBox["n", "TI"]], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1e458505-4cdf-42d3-9a16-980a2f43c25e"],
 ". The ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "e2b42121-75fb-415b-8673-a5297899401c"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox["n", "TI"], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"aa572a10-5e93-4d4a-99d8-9bf78ea9ef24"],
 " produces the state, the ",
 Cell[BoxData[
  RowBox[{"SchurDimension", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", " ", "2"}], "]"}]], "InlineFormula",
  ExpressionUUID->"ee9c0a70-ecf0-43c0-a18b-719c72dfaed4"],
 " produces the bond size, and built-in ",
 Cell[BoxData[
 "TensorContract"], "InlineFormula",ExpressionUUID->
  "fc5d4760-bb4c-4910-a0d0-bb4be7be0e38"],
 " / ",
 Cell[BoxData[
 "Dot"], "InlineFormula",ExpressionUUID->
  "2217bd73-8b5e-4d86-a7aa-867fd7a9fdc7"],
 " see and preserve the symmetry sector automatically."
}], "Text",ExpressionUUID->"7087e020-01f4-4182-8170-074f79759e60"],

Cell[CellGroupData[{

Cell[TextData[{
 "Time the W-state construction across a sweep of ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2c9ec8cb-d2aa-436a-8fb2-d99212c207d6"],
 ". The builder below applies the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox["n", "TI"], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0211dce1-6e5d-4f02-b3f6-5b4a4926d77a"],
 " Young projector to the single-excitation seed and normalises; the table \
reports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "4", ",", "6", ",", "8", ",", "10", ",",
     "12"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bdf754d0-aea0-4eca-8259-e7d6f22f21c8"],
 "."
}], "Text",ExpressionUUID->"8471e229-7ad9-4eed-a077-aa6c7a49ad73"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"buildW", "[", "nn_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"raw", " ", "=", " ", 
       RowBox[{"YoungProject", "[", "\n", "        ", 
        RowBox[{
         RowBox[{"Normal", " ", "@", " ", 
          RowBox[{"SparseArray", "[", "\n", "            ", 
           RowBox[{
            RowBox[{
             RowBox[{"Prepend", "[", 
              RowBox[{
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", " ", 
                 RowBox[{"nn", " ", "-", " ", "1"}]}], "]"}], ",", " ", "2"}],
               "]"}], " ", "->", " ", "1"}], ",", "\n", "            ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"2", ",", " ", "nn"}], "]"}]}], "]"}]}], ",", "\n", 
         "        ", 
         RowBox[{"YoungTableau", "[", 
          RowBox[{"{", "nn", "}"}], "]"}]}], "]"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"raw", " ", "/", " ", 
      RowBox[{"Norm", "[", 
       RowBox[{"Flatten", "[", "raw", "]"}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"nn", ",", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"buildW", "[", "nn", "]"}], "]"}]}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"nn", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "4", ",", " ", "6", ",", " ", "8", ",", " ", "10", ",", " ", "12"}], 
      "}"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[347]:=",ExpressionUUID->"69b75aff-00fa-4862-bc36-df171c53a4aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "0.000308`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"6", ",", "0.000519`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"8", ",", "0.00136`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "0.003819`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"12", ",", "0.013533`"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988838588051906*^9},
 CellLabel->"Out[348]=",
 CellID->762293339,ExpressionUUID->"997455b8-111c-459c-84c2-db3d3f63bbfe"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The construction stays sub-second up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "12"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"77f6f138-af81-41a3-afb7-c943f9ceffbf"],
 ". At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "13"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"baf12b82-e3a9-4c3b-a0f3-8526ef1efb01"],
 " and above the internal ",
 Cell[BoxData[
 "SymmetrizedArray"], "InlineFormula",ExpressionUUID->
  "7bba4c58-b3ba-4762-b24d-350573f10ceb"],
 " that backs ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "47c853d3-c673-4613-8cc0-7ce83761954c"],
 " runs out of memory enumerating ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8cb611e7-7fac-4b43-9f1d-a9d891564c4e"],
 " orbits, and the recipe stops. The output tensor would still fit (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["2", "20"], "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"dd59af34-1618-4314-8cb7-6601b36a83c9"],
 " M doubles ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[TildeTilde]", "8"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6bb7942b-2eb5-4c94-88d6-ae7dfe51ff85"],
 " MB even at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "20"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"decb8955-7566-4600-9ec5-62c00d296188"],
 "); the wall is the symmetriser construction, not the storage. For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[GreaterEqual]", "13"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7a2e2fed-7bbe-423b-a6e3-f3340df8be85"],
 ", bypass ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "74e226e3-a14c-4e02-a6e1-495bb57c5529"],
 " and build Dicke states directly in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["n", "TI"], "+", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e7a2b8b1-2341-49ac-be0b-56fbcca43622"],
 "-dimensional symmetric basis from one closed-form binomial amplitude per \
state. The bond size is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"SchurDimension", "[", 
    RowBox[{
     RowBox[{"{", "n", "}"}], ",", " ", "2"}], "]"}], " ", "=", " ", 
   RowBox[{"n", " ", "+", " ", "1"}]}]], "InlineFormula",ExpressionUUID->
  "cbc5c6b9-5097-4652-ab32-2bf0f830da77"],
 " regardless of which route produces the state."
}], "Text",ExpressionUUID->"7420f3ec-cb17-400c-8db8-30fd35496f4a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Block-sparse trace: cross-shape contractions vanish identically\
\>", "Subsubsection",ExpressionUUID->"3192d882-3220-4475-8593-58d4af758567"],

Cell[TextData[{
 StyleBox["Contracting two bond tensors block-diagonalises along symmetry \
classes: a symmetric tensor cannot 'see' an antisymmetric one. Projecting \
onto ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6d03e6f0-e9b5-45be-9e7c-36a89355b3be"],
 StyleBox[" and ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a7f20c84-51b4-4cb6-8dab-60ab63a4b292"],
 StyleBox[" makes this explicit, and Schur orthogonality lets a \
contraction-path optimiser skip cross-shape products before any \
multiplication runs.", "TI"]
}], "Text",ExpressionUUID->"cdc6df14-421f-46b5-ad0a-028faa75fbb4"],

Cell[TextData[{
 "The Frobenius trace ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"t", "r"}], "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["A", "TI"], "\[CenterDot]", 
      StyleBox["B", "TI"]}], ")"}], "\[LongEqual]", 
    UnderscriptBox["\[Sum]", 
     StyleBox[
      RowBox[{"i", "j"}], "TI"],
     LimitsPositioning->True], 
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], 
    SubscriptBox[
     StyleBox["B", "TI"], 
     StyleBox[
      RowBox[{"j", "i"}], "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c5c8124c-f63e-45bb-9c0c-4a2aa972bdd8"],
 " is the basic two-tensor contraction over a rank-2 bond. It admits a \
block-sparse decomposition along symmetry classes: the trace splits into \
pairs ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Lambda]", ",", "\[Mu]"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b20057c4-f662-4549-b169-5b4b3bf74732"],
 " and the two cross-shape pairs vanish identically. A symmetry-aware \
contraction-path optimiser skips them before any multiplication."
}], "Text",ExpressionUUID->"7dcb711e-2144-47ca-ac4a-8578dc0c532f"],

Cell[CellGroupData[{

Cell[TextData[{
 "Build two random rank-2 tensors at ",
 Cell[BoxData[
