Cell[TextData[{
 StyleBox["A rank-", "TI"],
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3a5f4ce2-290e-4a65-bd78-a1c8d483d85b"],
 StyleBox[" tensor is a node with ", "TI"],
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "da4818a3-e411-40f5-8e5a-621bf79bdeb8"],
 StyleBox[" labelled legs, one per slot. This is the visual vocabulary every \
tensor-network argument uses when an indexed sum reads more naturally as a \
diagram.", "TI"]
}], "Text",ExpressionUUID->"4dd3f90f-7767-461e-b776-5d9f40600d50"],

