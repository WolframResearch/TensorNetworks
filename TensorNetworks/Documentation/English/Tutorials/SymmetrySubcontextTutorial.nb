 CellID->492134592,ExpressionUUID->"7b40252c-8313-4dba-a0a4-e05ec7e2644e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The two scalars differ. What the projection removes is exactly the \
symmetric piece ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], "(", 
    RowBox[{
     StyleBox["A", "TI"], "\[CenterDot]", 
     StyleBox["T", "TI"], "\[CenterDot]", 
     StyleBox["B", "TI"], "+", 
     StyleBox["B", "TI"], "\[CenterDot]", 
     StyleBox["T", "TI"], "\[CenterDot]", 
     StyleBox["A", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c9da524f-68c0-4be9-a706-caf0237dd83b"],
 " that the Pauli principle forbids for identical fermions."
}], "Text",ExpressionUUID->"205bef4e-25e9-4c6b-bf1c-9aa906e99caf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Chop", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"TensorNetworkContract", "[", "bareTN", "]"}], " ", "-", " ", 
      RowBox[{"TensorNetworkContract", "[", "fermionTN", "]"}]}], ")"}], " ", 
    "-", "\n", "     ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"A", " ", ".", " ", "T", " ", ".", " ", "B"}], " ", "+", " ", 
       RowBox[{"B", " ", ".", " ", "T", " ", ".", " ", "A"}]}], ")"}], "/", 
     "2"}]}], "]"}], " ", "<", " ", "tol"}]], "Input",
 CellLabel->
  "In[481]:=",ExpressionUUID->"95a3aa6e-c14d-437e-99d7-93fedca032c6"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988838587828594*^9, 3.988838685024081*^9},
 CellLabel->"Out[481]=",
 CellID->2043290364,ExpressionUUID->"ae187dbb-16be-40ba-b409-8c83386702ec"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", " ", ".", " ", "T", " ", ".", " ", "B"}], ")"}], " ", "-", 
    " ", 
    RowBox[{"(", 
     RowBox[{"A", " ", ".", " ", "TFermi", " ", ".", " ", "B"}], ")"}]}], 
   "]"}], " ", ">", " ", "tol"}]], "Input",
 CellLabel->
  "In[329]:=",ExpressionUUID->"93ba4c8a-0c1f-4ef9-bda7-5e270079e8c0"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988838587853146*^9},
 CellLabel->"Out[329]=",
 CellID->1357936702,ExpressionUUID->"066f2421-8c2c-4be2-ba75-75200c33524c"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "After the projection, every downstream TN operation that respects index \
types (",
 Cell[BoxData[
 "TensorContract"], "InlineFormula",ExpressionUUID->
  "fd9b731f-ccc0-49b7-a9da-2a41f8c412f5"],
 ", ",
 Cell[BoxData[
 "Dot"], "InlineFormula",ExpressionUUID->
  "0ccccd59-3962-42dd-81ee-68188e9cf8b7"],
 ", SVD on the paired index, partial trace) preserves the antisymmetric \
class. The orthogonal sector is gone for good, halving the bond's worth of \
stored numbers in the asymptotic limit. If memory matters more than \
evaluation speed, you can also store the projected bond as a ",
 Cell[BoxData[
  RowBox[{"SymmetrizedArray", "[", 
   RowBox[{"...", ",", " ", 
    RowBox[{"Antisymmetric", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], "]"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"9b3739cd-9dd7-4798-bc54-cf5f0df82333"],
 "; built-in WL handles tensor-arithmetic on it without ever materialising \
the dense form."
}], "Text",ExpressionUUID->"80ccb9b2-9804-4cf7-9807-a0b639caa393"],

Cell["\<\
The same project-first-then-contract pattern carries to higher-rank fermionic \
networks, to bosonic permutation-invariant Hamiltonians, and (with a \
different Young diagram) to the Riemann curvature tensor in the next section.\
\
\>", "Text",ExpressionUUID->"7b540b8a-8442-4475-930d-92209a00f9c5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Magnetization sectors on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "5"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"e8aa2e00-e346-4d2c-beb7-30fb76a5af69"],
 " qubits from a single ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox["n", "TI"], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"76840921-4ba9-4400-a238-bc25fadecb2d"],
 " Young projector"
}], "Subsubsection",ExpressionUUID->"b1f73d12-fc6c-46e9-8642-a1a6dc0a200c"],

Cell[TextData[{
 StyleBox["A permutation-symmetric many-qubit state has well-defined total \
spin and magnetisation, and lives in a tiny ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["n", "TI"], "+", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ce5dfde0-8d40-4cc0-ab87-e88999dd7a80"],
 StyleBox["-dim subspace of the ", "TI"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "43fed52b-b75c-4879-bd6d-c9967bd863d2"],
 StyleBox["-dim full Hilbert space. One ", "TI"],
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "38c7a8ea-40fc-4149-9d37-4dfa7f118325"],
 StyleBox[" onto ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox["n", "TI"], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2a6ae99e-8a68-4490-bae8-74a168c0ed60"],
 StyleBox[" builds W- and Dicke states with exact ", "TI"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["z", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "de48a1dd-43ad-453a-9fcd-46df099e5536"],
 StyleBox[" and ", "TI"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "\[RightVector]"], "2"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"25facb4e-ff95-484d-92bd-273b01d1f54c"],
 StyleBox[" quantum numbers; ", "TI"],
 Cell[BoxData[
  RowBox[{"SchurDimension", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", " ", "2"}], "]"}]], "InlineFormula",
  ExpressionUUID->"b2263e5f-57fc-4668-b86c-ee639b7ec08a"],
 StyleBox[" gives the bond-dim compression, a 93-fold reduction at ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "10"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"1660fc00-23ad-49d5-b3eb-e3444a1ed2e2"],
 StyleBox[".", "TI"]
}], "Text",ExpressionUUID->"31157f58-f02b-46f0-b2a2-f445e028289f"],

Cell[TextData[{
 "Dicke states ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubsuperscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["n", "TI"], 
     StyleBox["k", "TI"]], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"508400f0-da3a-4446-9f85-6b45c5806866"],
 " are the totally symmetric ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "71f157c8-34ba-402f-9c61-c213c1652cdd"],
 "-qubit states with exactly ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "753c6c0e-9a21-4617-bf44-d0d4560d7175"],
 " down-spins. They form an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["n", "TI"], "+", "1"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8821832d-bdbc-4f2d-b54f-8df483f62851"],
 "-dimensional orthonormal basis of the symmetric subspace of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     SuperscriptBox[
      StyleBox["C",
       FontSlant->"Plain"], "2"], ")"}], 
    RowBox[{"\[CircleTimes]", 
     StyleBox["n", "TI"]}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bf57dca1-6ce7-43be-9b0c-fa54227318a2"],
 ", label every magnetization sector inside that subspace, and underpin the \
symmetric many-qubit ans\[ADoubleDot]tze used in cavity QED, atomic-ensemble \
metrology (superradiance, spin squeezing), and permutation-invariant NISQ \
benchmarks. Construction recipe: feed the bit string ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"|", "1"}], 
     StyleBox["k", "TI"]], 
    SuperscriptBox["0", 
     RowBox[{
      StyleBox["n", "TI"], "-", 
      StyleBox["k", "TI"]}]], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"3a3858c1-1ba8-4839-bdfd-0fe553555d4b"],
 " through the totally symmetric Young projector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox["n", "TI"], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bcad5227-d405-475e-b4b6-f7b2aaf6be8d"],
 " and normalise. One ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "54b111ef-ed3a-48e3-89f6-3f61efa73c85"],
 " call, one quantum many-body state."
}], "Text",ExpressionUUID->"b93bf304-b46c-4ae4-afd8-755894352cdc"],

Cell[CellGroupData[{

Cell["Set the chain length and the relevant Young tableau.", "Text",ExpressionUUID->"acc60949-280c-4a92-92c0-fa7c3667248c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", " ", "=", " ", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nTab", " ", "=", " ", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", "n", "}"}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[330]:=",ExpressionUUID->"9d396e36-e2db-4873-8c8f-5d959fa4523f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Build the W-state ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    SubscriptBox[
     StyleBox["W", "TI"], "5"], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"116e89bd-e115-4c1d-b77a-1adbbfaa446c"],
 " as the symmetric Young projection of the unsymmetrised single-excitation \
seed ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "10000"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"238d7bfb-9c56-40fc-9b89-0ddf70d236e6"],
 ", then unit-normalise."
}], "Text",ExpressionUUID->"9d08e213-272a-42eb-a6fa-3a77a2d314b6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"seedW", " ", "=", " ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"SparseArray", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "2", ",", " ", "1", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], 
        "}"}], " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"2", ",", " ", "n"}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wRaw", " ", "=", " ", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"seedW", ",", " ", "nTab"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wState", " ", "=", " ", 
   RowBox[{"wRaw", " ", "/", " ", 
    RowBox[{"Norm", "[", 
     RowBox[{"Flatten", "[", "wRaw", "]"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[332]:=",ExpressionUUID->"1cfc1709-6c31-4173-9329-e187375416b2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The flattened state has exactly five non-zero amplitudes, each equal to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SqrtBox["5"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "79199a86-ea61-4651-937b-e7ad42750b6d"],
 ", sitting at the five basis positions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"|", "10000"}], "\[RightAngleBracket]", ",", 
    RowBox[{"|", "01000"}], "\[RightAngleBracket]", ",", 
    RowBox[{"|", "00100"}], "\[RightAngleBracket]", ",", 
    RowBox[{"|", "00010"}], "\[RightAngleBracket]", ",", 
    RowBox[{"|", "00001"}], "\[RightAngleBracket]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"2b8308a0-c537-47d6-87e2-354d12e7109a"],
 "."
}], "Text",ExpressionUUID->"5956e96a-8c22-456f-a8fa-58fd1be87960"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Cases", "[", 
  RowBox[{
   RowBox[{"Flatten", "[", "wState", "]"}], ",", " ", 
   RowBox[{"x_", " ", "/;", " ", 
    RowBox[{
     RowBox[{"Abs", "[", "x", "]"}], " ", ">", " ", 
