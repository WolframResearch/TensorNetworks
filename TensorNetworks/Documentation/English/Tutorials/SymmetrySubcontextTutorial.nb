Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"predicted", " ", "=", " ", 
  RowBox[{"Sort", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"Flatten", " ", "@", " ", 
     RowBox[{"{", "\n", "        ", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"contentSum", "[", 
          RowBox[{"{", "3", "}"}], "]"}], ",", "       ", 
