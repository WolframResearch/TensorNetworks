Cell[CellGroupData[{

Cell[TextData[{
 "For magnetisation checks build the total-",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["z", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d01151fb-03e9-422c-9696-dc16b9fb9e26"],
 " operator as a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"32", "\[Cross]", "32"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"16a3f560-6820-4ab1-843b-8b40377d3a8f"],
 " matrix: a sum of single-site ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Sigma]", 
     StyleBox["z", "TI"]], "/", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7f07d83e-01ef-4f22-bd19-450f48e63ce1"],
 " insertions in an otherwise-identity Kronecker product. The same shape \
works for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["x", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "90044f5a-25ad-4484-9c5c-90178a93d2d9"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["y", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d5c52164-4ee2-4ae8-9f82-08eb2e3a355e"],
 "."
}], "Text",ExpressionUUID->"f05f8ef8-2bbf-44ff-bcdd-3c6f65346027"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sumSpinOp", "[", "op_", "]"}], " ", ":=", " ", 
   RowBox[{"Sum", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"KroneckerProduct", " ", "@@", " ", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", "n"}], "]"}], ",",
         " ", 
        RowBox[{"i", " ", "->", " ", "op"}]}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "n"}], "}"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sZtot", " ", "=", " ", 
   RowBox[{"sumSpinOp", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[336]:=",ExpressionUUID->"550fc0c3-6649-4224-baeb-1cc76e4b3f99"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The W-state has one spin-down among five spin-ups, so its total \
magnetisation eigenvalue is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["n", "TI"], "-", "2"}], ")"}], "/", "2", "\[LongEqual]", "3", "/",
     "2"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "655bbeed-45b0-40ae-8b39-8109a04cc648"],
 "."
}], "Text",ExpressionUUID->"6bc2ca00-f0e8-4351-9145-37d3608fc6a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{"sZtot", " ", ".", " ", 
    RowBox[{"Flatten", "[", "wState", "]"}]}], " ", "-", " ", 
   RowBox[{
    RowBox[{"3", "/", "2"}], " ", 
    RowBox[{"Flatten", "[", "wState", "]"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[338]:=",ExpressionUUID->"8f30163a-6319-4874-a635-55dae2ce1a61"],

Cell[BoxData[
 RowBox[{"{", 
