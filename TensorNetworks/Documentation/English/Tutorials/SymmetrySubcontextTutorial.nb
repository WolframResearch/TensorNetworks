Cell[TextData[{
 "The same singlet-plus-symmetric-pair composition is the structural recipe \
for the 1D AKLT spin-1 chain: a virtual ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"adf23ecf-6ec6-46a3-918b-d4b36790ba6e"],
 " singlet on each edge, then a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3ee4f1b1-2ef3-453d-bbc4-745b7873d785"],
 " symmetric projection on each site combining the two virtual spin-",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a403c3b3-88ce-4e78-a2f4-8af175417b9c"],
 " legs into a single physical spin-",
 Cell[BoxData[
  FormBox["1", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8fa83e1d-bb10-4fda-b03f-f06df277bb04"],
 ". The resulting bond-dimension-",
 Cell[BoxData[
  FormBox["2", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2a709738-1bdd-48c0-8bd3-35834dcedc41"],
 " MPS matrices are ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", "\[PlusMinus]"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a1a26ffb-0a03-4e2a-844c-3d03e0723481"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", 
    StyleBox["z", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1e45e1b2-8a65-4810-bff2-6ff04a0c496f"],
 " up to normalisation; East, van de Wetering, Chancellor & Grushin (",
 ButtonBox["arXiv:2012.01219",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2012.01219"], None}],
 ") give the ZX-diagrammatic derivation. The next subsection takes the same \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    StyleBox["n", "TI"], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0d9820ee-8b58-49e3-a3af-2d64dddaaf09"],
 " symmetric projector to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "5"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"025fa807-b581-4693-b7f7-581d67899b47"],
 " qubits, producing a different family of physically meaningful states."
}], "Text",ExpressionUUID->"1efe3faf-488b-415f-9c0d-d62c972c37b3"],

Cell[TextData[{
 "For an arbitrary two-spin coefficient matrix ",
 Cell[BoxData[
  FormBox["\[Psi]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6f12d03a-fc40-47ac-af86-60ee38b5a418"],
 ", the ",
 StyleBox["singlet amplitude", "TI"],
 " (the weight of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"24286c14-c098-4c4e-9a13-bde3cced754b"],
 " component) is the inner product of the normalised singlet with ",
 Cell[BoxData[
  RowBox[{"YoungProject", "[", 
   RowBox[{"psi", ",", " ", "antiTab"}], "]"}]], "InlineFormula",
  ExpressionUUID->"1edac305-da38-4f63-be4c-251f45c1cf88"],
 ": \"is this state entangled along the singlet axis?\" reduced to one \
function call."
}], "Text",ExpressionUUID->"e062484f-aec2-4754-8d18-e2e29686556e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SWAP gate as the symmetrise/antisymmetrise machine", "Subsubsection",ExpressionUUID->"cadee8cc-3bbb-42c5-aa23-3278f6d5b46c"],

Cell[TextData[{
 StyleBox["The two-qubit SWAP gate has ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "94438b89-52e0-4c21-a70d-c9156d208fc3"],
 StyleBox[" and ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8a89e466-32a6-4e01-89de-c733b1159042"],
 StyleBox[" eigenspaces of dimension 3 (triplet, symmetric) and 1 (singlet, \
antisymmetric). ", "TI"],
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "a9d4ecdf-73c3-446e-9f1b-93a9b2de00ae"],
 StyleBox[" onto ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "035877e3-e649-47aa-84c8-795dfb3b65ec"],
 StyleBox[" and ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fa5a3eff-bfc4-4a0c-a297-5b973ecceba0"],
 StyleBox[" realises those eigenspace projectors directly, showing that SWAP, \
transpose, Young projection, and built-in ", "TI"],
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "df0e1bbc-5816-4bd3-8e41-4752111c1086"],
 StyleBox[" are the same operation written in four notations.", "TI"]
}], "Text",ExpressionUUID->"4546b40e-b5e5-40d9-abae-d8aca1609342"],

Cell[CellGroupData[{

Cell[TextData[{
 "In the two-qubit Hilbert space (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0b6c5422-dbd7-4a38-ad63-7e11584a219b"],
 " on each site, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["V", "TI"], "\[CircleTimes]", 
    StyleBox["V", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["C",
      FontSlant->"Plain"], "4"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e5f1b91d-26f5-4a4b-be9d-7289f79f9295"],
 ") the SWAP gate is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "\[Cross]", "4"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d0db507c-a328-4451-81a7-522f16b3c132"],
 " matrix realising ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P", "TI"], "12"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e97818f7-6cb9-4c53-a56e-2905c1e21071"],
 ". Build it from a ",
 Cell[BoxData[
 "SparseArray"], "InlineFormula",ExpressionUUID->
  "4b1819cd-3a12-4019-ac0d-f1e20f500552"],
 " with the rule ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{
      StyleBox["k", "TI"], ",", 
      StyleBox["l", "TI"], "|", "SWAP", "|", 
      StyleBox["i", "TI"], ",", 
      StyleBox["j", "TI"]}], "\[RightAngleBracket]"}], "\[LongEqual]", 
    SubscriptBox["\[Delta]", 
     StyleBox[
      RowBox[{"k", "j"}], "TI"]], 
    SubscriptBox["\[Delta]", 
     StyleBox[
      RowBox[{"l", "i"}], "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"22fc1828-5193-4639-859c-d559c72cc7b2"],
 "."
}], "Text",ExpressionUUID->"b29eda49-f8b6-4cc1-a3be-de24ec6ae14c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"swapGate", " ", "=", " ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"ArrayReshape", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"i_", ",", " ", "j_", ",", " ", "k_", ",", " ", "l_"}], 
            "}"}], " ", "/;", " ", 
           RowBox[{
            RowBox[{"i", " ", "==", " ", "l"}], " ", "&&", " ", 
            RowBox[{"j", " ", "==", " ", "k"}]}]}], " ", "->", " ", "1"}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2", ",", " ", "2", ",", " ", "2"}], "}"}]}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}]}], "\n", "]"}]}]}], ";"}]], "Input",\

 CellLabel->
  "In[310]:=",ExpressionUUID->"c8556664-c44d-4f66-b54a-700ae0927a6f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The claim is that the Young projectors ",
 Cell[BoxData[
  RowBox[{"YoungProject", "[", 
   RowBox[{"*", 
    RowBox[{",", " ", "symTab"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "94bec764-dbe1-4249-9d2d-2f5e4ddf1dc7"],
 " and ",
 Cell[BoxData[
  RowBox[{"YoungProject", "[", 
   RowBox[{"*", 
    RowBox[{",", " ", "antiTab"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "dc67c71d-7664-4f27-9e4e-27f01d95a9ff"],
 " are exactly the projectors onto the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3cc001a3-481a-428a-af35-db33926a2377"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "496e8cf1-6001-4edd-a41f-e314572521c9"],
 " eigenspaces of this SWAP:"
}], "Text",ExpressionUUID->"abbb3b8f-3e26-48d2-a34a-c264dca2c9d9"],

Cell[BoxData[
 PaneBox[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P", "TI"], 
     RowBox[{"{", "2", "}"}]], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["I", "TI"], "+", "SWAP"}], ")"}], 
    RowBox[{",", "    "}], 
    SubscriptBox[
     StyleBox["P", "TI"], 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]], " ", 
    RowBox[{"\[LongEqual]", " "}], 
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["I", "TI"], "-", "SWAP"}], ")"}], "."}],
   TraditionalForm],
  Alignment->Center,
  ImageSize->Full]], "DisplayFormula",ExpressionUUID->"c0aaf14a-6e6f-4b99-\
8d47-590fd4e4287d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Verify it. Form the two SWAP-eigenspace projectors as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", "\[Cross]", "4"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8700fa3c-8fa3-4be7-9264-2300edf84f4b"],
 " matrices."
}], "Text",ExpressionUUID->"9470e1b5-423d-4955-bfee-7e1f4d80f582"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"swapPlus", "  ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "4", "]"}], " ", "+", " ", "swapGate"}], 
     ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"swapMinus", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "4", "]"}], " ", "-", " ", "swapGate"}], 
     ")"}], "/", "2"}]}], ";"}]}], "Input",
 CellLabel->
  "In[311]:=",ExpressionUUID->"bd57d855-40ed-4345-86e7-9afdb3dd3709"]
}, Open  ]],

