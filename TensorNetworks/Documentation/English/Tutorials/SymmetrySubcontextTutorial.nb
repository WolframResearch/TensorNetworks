     RowBox[{"1", ",", " ", "3"}], "]"}], " ", "+", " ", 
    RowBox[{"applySwap", "[", 
     RowBox[{"2", ",", " ", "3"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->
