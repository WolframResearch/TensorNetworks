Cell[TextData[{
 "The explicit form matters beyond rank 2 because it picks ",
 StyleBox["which", "TI"],
 " slot lives in which row and column. For example, ",
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "cf807891-6a2b-4900-93ab-fa67068ebbac"],
 " is a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4f0f4fac-8dee-436f-a6f5-1abee82f1159"],
 "-shape tableau on rank 3 with slot 3 paired with slot 1 in the column, \
distinct from the default ",
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", "3", "}"}]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "cd87eaa6-3367-4536-a033-2a85d8b18194"],
 " that fills row by row."
}], "Text",ExpressionUUID->"27aa7953-2fe2-4473-bd0b-438c2568fdc5"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
 "YoungTableauQ"], "InlineFormula",ExpressionUUID->
  "7a497261-0089-4905-a597-4c3737757fc6"],
 " decides whether a ",
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", "...", "]"}]], "InlineFormula",ExpressionUUID->
  "77a2cbbb-b732-42a8-9d4f-4753ac90878e"],
 " is well-formed, rejecting malformed input before it reaches ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "45dc0b20-04cd-4f24-a8b6-ceb8325e98cd"],
 ". Increasing row lengths violate the partition condition."
}], "Text",ExpressionUUID->"b098d1fa-18a6-4dbe-a8e6-1876633e52d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableauQ", "[", 
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[251]:=",ExpressionUUID->"6749bf56-ff82-4f60-ad3d-bf960ba533fb"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.988838550138818*^9, 3.988838586452565*^9},
 CellLabel->"Out[251]=",
 CellID->1990457439,ExpressionUUID->"f36dc434-11c6-4752-9717-94b726825061"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Duplicate slot labels are rejected.", "Text",ExpressionUUID->"689b122c-6d82-4330-9ed7-42eb0690beae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableauQ", "[", 
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[252]:=",ExpressionUUID->"f355b9ec-69a9-4aff-a6d4-f16c6a3069d0"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.98883855154904*^9, 3.9888385864736757`*^9},
 CellLabel->"Out[252]=",
 CellID->117924307,ExpressionUUID->"954cebf0-4d93-485a-a2f3-e7ce3039a9dd"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Slot labels that are not a permutation of ",
 Cell[BoxData[
  RowBox[{"Range", "[", "n", "]"}]], "InlineFormula",ExpressionUUID->
  "2d00cff4-a792-405a-a1bf-90c396389ab4"],
 " are rejected even when distinct and positive. Here the slots are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "5", ",", "7"}], "}"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "94225777-e797-46fe-b1af-b663a7f807b9"],
 ", missing ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "12775549-4eda-4e40-babd-1a0dc52b5575"],
 " and ",
 Cell[BoxData[
  FormBox["6", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3b133c79-80e6-426f-b1d6-89d265fe0f50"],
 "."
}], "Text",ExpressionUUID->"f6e349c3-30f9-4ff2-ac7c-9f98b3d5edb6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"YoungTableauQ", "[", 
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "5", ",", " ", "7"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[253]:=",ExpressionUUID->"2650106e-6821-4dd1-97be-446b89da9bda"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.988838554000236*^9, 3.988838586499876*^9},
 CellLabel->"Out[253]=",
 CellID->1973905215,ExpressionUUID->"8ade4fc8-2109-406b-96ab-50559e03828a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Custom slot orderings ",
 StyleBox["within", "TI"],
 " the legal label set are allowed: the slots here are a permutation of ",
 Cell[BoxData[
  RowBox[{"Range", "[", "5", "]"}]], "InlineFormula",ExpressionUUID->
  "a87dc837-35e7-457a-9210-8b63913bf9c2"],
 "."
}], "Text",ExpressionUUID->"2a964fb8-9aa1-4c63-a4c2-ace5cb178fa3"],

