     ExpressionUUID->"f52ed8d8-5dd3-4301-8a49-641512b15261"]], "TableText",
     ExpressionUUID->"08918cba-677d-4c1a-902d-7abb78e5a453"]},
   {Cell[TextData[{
     "Hook lengths for ",
     Cell[BoxData[
      FormBox[
       SubscriptBox[
        StyleBox["S", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",
      ExpressionUUID->"dab5ed8c-509e-448d-90b3-1ab6827406d5"],
     " representation theory"
    }], "TableText",ExpressionUUID->"02928fc3-892b-4097-8256-a5c652d39091"], 
    Cell["(not supported)", "TableText",ExpressionUUID->
     "5204cac7-5154-49b4-a988-2c0d946c1551"], Cell[TextData[{
     Cell[BoxData[
     "HookLength"], "InlineFormula",ExpressionUUID->
      "f07d5648-1b17-490a-89c1-ed78921b53a1"],
