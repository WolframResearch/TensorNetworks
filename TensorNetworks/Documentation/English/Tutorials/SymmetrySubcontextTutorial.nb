}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "It also lives in the maximum-spin sector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], "\[LongEqual]", 
    StyleBox["n", "TI"], "/", "2", "\[LongEqual]", "5", "/", "2"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "17f83c6e-c0ca-4019-8521-964efcd361c6"],
 ", with ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "\[RightVector]"], "tot", "2"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"edbf0c2d-49aa-4290-b84b-493a65eb813e"],
 " eigenvalue ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["S", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["S", "TI"], "+", "1"}], ")"}], "\[LongEqual]", "35", "/", 
    "4"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c96a392b-c590-4446-bfd6-9c6601273041"],
 ". Assemble ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox[
    OverscriptBox[
     StyleBox["S", "TI"], "\[RightVector]"], "tot", "2"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8eb9450b-81ca-4a67-9461-478bb1be6f4b"],
 " from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["x", "TI"]], ",", 
    SuperscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["y", "TI"]], ",", 
    SuperscriptBox[
     StyleBox["S", "TI"], 
     StyleBox["z", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"efed7d6a-5c22-490f-8d72-3dc233c1f055"],
 " and apply."
}], "Text",ExpressionUUID->"817c4681-c39b-42b6-a3c6-a4c05abe4de6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sXtot", " ", "=", " ", 
   RowBox[{"sumSpinOp", "[", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "1", "]"}], "/", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sYtot", " ", "=", " ", 
   RowBox[{"sumSpinOp", "[", 
