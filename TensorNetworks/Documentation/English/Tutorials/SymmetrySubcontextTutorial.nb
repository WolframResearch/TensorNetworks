Cell[CellGroupData[{

Cell[TextData[{
 "The first cross-shape block, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"t", "r"}], "TI"], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], 
      RowBox[{"1", ",", 
       RowBox[{"{", "2", "}"}]}]], "\[CenterDot]", 
     SubscriptBox[
      StyleBox["M", "TI"], 
      RowBox[{"2", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}]]}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"66cca1cf-5228-4909-a478-2cac31f824ec"],
 ", vanishes."
}], "Text",ExpressionUUID->"85a18d64-7b7e-4688-9139-a7680e714b3e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"Tr", "[", 
   RowBox[{"Ms1", " ", ".", " ", "Ma2"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[358]:=",ExpressionUUID->"f7752ca0-56b2-4322-ac1b-6daded73bd3a"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.988838588172847*^9},
 CellLabel->"Out[358]=",
 CellID->1564074198,ExpressionUUID->"cc012e76-0f44-4ded-ab3a-38be144e38f7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The other cross-shape block, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     RowBox[{"t", "r"}], "TI"], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["M", "TI"], 
      RowBox[{"1", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}]], "\[CenterDot]", 
     SubscriptBox[
      StyleBox["M", "TI"], 
      RowBox[{"2", ",", 
       RowBox[{"{", "2", "}"}]}]]}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"cd20cfde-7fcc-4b73-85b9-b380e916f947"],
 ", vanishes."
}], "Text",ExpressionUUID->"59210805-6e37-49c3-86b5-c90fefe5873d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Chop", "[", 
  RowBox[{"Tr", "[", 
   RowBox[{"Ma1", " ", ".", " ", "Ms2"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[359]:=",ExpressionUUID->"fedaf3a9-bf7c-4de1-924c-1c559dbe3872"],

