     RowBox[{"PauliMatrix", "[", "2", "]"}], "/", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"s2tot", " ", "=", " ", 
   RowBox[{
    RowBox[{"sXtot", " ", ".", " ", "sXtot"}], " ", "+", " ", 
    RowBox[{"sYtot", " ", ".", " ", "sYtot"}], " ", "+", " ", 
    RowBox[{"sZtot", " ", ".", " ", "sZtot"}]}]}], ";"}], "\n", 
 RowBox[{"Chop", "[", 
  RowBox[{
   RowBox[{"s2tot", " ", ".", " ", 
    RowBox[{"Flatten", "[", "wState", "]"}]}], " ", "-", " ", 
