Cell[CellGroupData[{

Cell[TextData[{
 "Stress-energy tensor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], "\[Mu]\[Nu]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ba01ee9f-61f7-4039-bec6-fa7ae46a3f81"],
 " (perfect fluid)"
}], "Subsubsection",ExpressionUUID->"7272f588-84e4-4c56-bd2c-88c613f69511"],

Cell[TextData[{
 StyleBox["The stress-energy tensor of a perfect fluid encodes energy and \
momentum flow, which is reciprocal, so ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], "\[Mu]\[Nu]"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["T", "TI"], "\[Nu]\[Mu]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ff337129-a229-419b-9368-2384146f0c61"],
 StyleBox[" for any ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", ",", 
    StyleBox["p", "TI"], ",", 
    SuperscriptBox[
     StyleBox["u", "TI"], "\[Mu]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bd44b1c3-c919-4311-b765-3d1ad160c68e"],
 StyleBox[". ", "TI"],
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "d8b92f7d-6193-4719-86ff-a24c3931b6ca"],
 StyleBox[" confirms this symbolically, letting a TN library halve the stored \
components on a stress-energy bond.", "TI"]
}], "Text",ExpressionUUID->"4285ccda-c6f1-435d-a881-281ca8841e1d"],

Cell[CellGroupData[{

Cell[TextData[{
 "Build the stress-energy tensor of a perfect fluid, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["T", "TI"], "\[Mu]\[Nu]"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"\[Rho]", "+", 
      StyleBox["p", "TI"]}], ")"}], " ", 
    SuperscriptBox[
     StyleBox["u", "TI"], "\[Mu]"], 
    SuperscriptBox[
     StyleBox["u", "TI"], "\[Nu]"], "+", 
    StyleBox["p", "TI"], " ", 
    SuperscriptBox[
     StyleBox["g", "TI"], "\[Mu]\[Nu]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e0c8a5e7-af22-4063-bd49-c1d0bfefa9fb"],
 ", from a generic 4-velocity and the Minkowski metric. Here ",
 Cell[BoxData[
  FormBox["\[Rho]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0fcc0184-390a-4cd2-9ab8-bece0dbd636a"],
 " is the energy density, ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6da8711f-3890-4890-8088-7d3e093e4ac4"],
 " the isotropic pressure, and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["u", "TI"], "\[Mu]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5e42c1ba-0e22-4958-aa19-94593636345c"],
 " the fluid's 4-velocity (normalised ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["u", "TI"], "\[Mu]"], 
    SubscriptBox[
     StyleBox["u", "TI"], "\[Mu]"], "\[LongEqual]", 
    RowBox[{"-", "1"}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b4dc6bb4-291f-4a9a-aaf9-228e176dcc41"],
 " in the mostly-plus signature). In the rest frame ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["u", "TI"], "\[Mu]"], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"1", ",", "0", ",", "0", ",", "0"}], ")"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7d3f89ed-3503-4317-acb7-289c1276cd45"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["T", "TI"], "\[Mu]\[Nu]"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0b3baa83-f43d-4f2e-9f8f-74749009e556"],
 " reduces to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["diag",
     FontSlant->"Plain"], "(", 
    RowBox[{"\[Rho]", ",", 
     StyleBox["p", "TI"], ",", 
     StyleBox["p", "TI"], ",", 
     StyleBox["p", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a66c7c43-a3c8-454b-8f6d-1b3613631fb1"],
 ". The tensor is manifestly symmetric in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"\[Mu]", ",", "\[Nu]"}], ")"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c6df2a6b-d377-496f-b3df-c59615a3feb7"],
 " for any ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", ",", 
    StyleBox["p", "TI"], ",", 
    SuperscriptBox[
     StyleBox["u", "TI"], "\[Mu]"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2831fe91-9594-44e3-b6c0-edb7924defed"],
 "."
}], "Text",ExpressionUUID->"f10dbc09-384e-4ee5-81bf-002257e93cdf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"u", " ", "=", " ", 
   RowBox[{"Array", "[", 
    RowBox[{"uu", ",", " ", "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"TSE", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"rho", " ", "+", " ", "p"}], ")"}], " ", 
     RowBox[{"TensorProduct", "[", 
      RowBox[{"u", ",", " ", "u"}], "]"}]}], " ", "+", " ", 
    RowBox[{"p", " ", "g"}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[279]:=",ExpressionUUID->"90ac8017-3b85-4b4c-92ca-7cff82cf44ce"]
}, Open  ]],

