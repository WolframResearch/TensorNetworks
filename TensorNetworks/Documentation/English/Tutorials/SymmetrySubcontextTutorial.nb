Cell[BoxData[
 RowBox[{"TensorSymmetry", "[", "R", "]"}]], "Input",
 CellLabel->
  "In[437]:=",ExpressionUUID->"79656f34-92d5-463a-8bfd-cad73a56315f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cycles", "[", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4"}], "}"}], "}"}], "]"}], ",", 
     RowBox[{"-", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cycles", "[", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], "}"}], "]"}], ",", 
     RowBox[{"-", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cycles", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}]}], "}"}], "]"}], ",", "1"}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9888385899240923`*^9},
 CellLabel->"Out[437]=",
 CellID->1188199978,ExpressionUUID->"8e3f259c-6573-4d23-be1c-58ccfb15b229"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Built-in WL reports the three Riemann pair generators. Bianchi is not a ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"perm", ",", " ", "phase"}], "}"}]], "InlineFormula",
  ExpressionUUID->"16409ada-84e9-4a6e-9f94-e9a049648513"],
 " relation so it cannot be a generator here, even though it is satisfied \
identically by the components of ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ec6412a3-6901-4afb-951d-bd902c88c23b"],
 ". The roles divide cleanly: the Symmetry functions produce a tensor in the \
irreducible representation, ",
 Cell[BoxData[
 "TensorSymmetry"], "InlineFormula",ExpressionUUID->
  "a6c18a82-cbfe-45a1-8ae6-31beec9a7ce9"],
 " reads off the mono-term subgroup of its slot symmetries. ",
 Cell[BoxData[
 "YoungProject"], "InlineFormula",ExpressionUUID->
  "3927cc80-30ba-4e12-ac6f-ee5a59cb5987"],
 " outputs a plain array (or a ",
 Cell[BoxData[
 "SymmetrizedArray"], "InlineFormula",ExpressionUUID->
  "4275250c-734a-4b1c-86c2-709dca78d2e8"],
 "-compatible structure) that built-in WL handles directly."
}], "Text",ExpressionUUID->"9f626d07-30d6-47bd-8ea5-bd3874636605"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The TN reward", "Subsubsection",ExpressionUUID->"0d314576-bef3-47a3-ac9f-165f70cb3cc8"],

Cell[TextData[{
 StyleBox["Once ", "TI"],
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "53e58b40-1fb5-4811-9fed-78460e19c070"],
 StyleBox[" sits in the ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f5519f1b-e1f6-4baa-9458-ad234a0c6e4d"],
 StyleBox[" block, contracting one upper-lower pair via ", "TI"],
 Cell[BoxData[
 "TensorContract"], "InlineFormula",ExpressionUUID->
  "fd7476c7-5c3f-46e6-a96b-2fab3a8329b5"],
 StyleBox[" produces the symmetric Ricci tensor with no separate \
re-symmetrisation step. Built-in tensor machinery sees and preserves the \
irreducible-representation structure automatically.", "TI"]
}], "Text",ExpressionUUID->"41cf07fb-82d3-45a6-ab62-6748bcf98502"],

Cell[CellGroupData[{

Cell[TextData[{
 "Once ",
 Cell[BoxData[
  FormBox[
   StyleBox["R", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bccbfef5-8050-4edc-b789-2b246fabf36b"],
 " lives in the right irreducible representation, downstream contractions \
preserve the structure for free. The Euclidean Ricci tensor is the partial \
trace ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"b", "d"}], "TI"]], "\[LongEqual]", 
    SuperscriptBox["\[Delta]", 
     StyleBox[
      RowBox[{"a", "c"}], "TI"]], 
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"a", "b", "c", "d"}], "TI"]]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"5874b719-97ad-43cf-97f6-db5dab14455a"],
 ", written ",
 Cell[BoxData[
  RowBox[{"TensorContract", "[", 
   RowBox[{"R", ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"7f96468f-494f-4659-bbca-6f920ec0753e"],
 ". It comes out symmetric automatically:"
}], "Text",ExpressionUUID->"56535e07-9656-45db-99f2-1754773c0624"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Ric", " ", "=", " ", 
   RowBox[{"TensorContract", "[", 
    RowBox[{"R", ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Ric", " ", "-", " ", 
      RowBox[{"Transpose", "[", "Ric", "]"}]}], "]"}], "]"}], "]"}], " ", "<",
   " ", "tol"}]}], "Input",
 CellLabel->
  "In[438]:=",ExpressionUUID->"aed6a952-003a-4ae2-bf8e-fa681932a371"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988838589942746*^9},
 CellLabel->"Out[439]=",
 CellID->626596793,ExpressionUUID->"30d743fe-e313-4347-b09b-fdd36d2a24df"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
No separate re-symmetrisation step. The scalar curvature is the trace of the \
Ricci tensor:\
\>", "Text",ExpressionUUID->"12ce517e-415c-400e-af7b-76faf1665a73"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Tr", "[", "Ric", "]"}]], "Input",
 CellLabel->
  "In[440]:=",ExpressionUUID->"2be0d532-940d-46ad-8927-5db7f456783f"],

Cell[BoxData["1.186550486536456`"], "Output",
 CellChangeTimes->{3.988838589967146*^9},
 CellLabel->"Out[440]=",
 CellID->2099978710,ExpressionUUID->"4e24b720-e65d-4eff-951b-4b795f7a53ae"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The Weyl tensor is ",
 StyleBox["not", "TI"],
 " a separate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f2370389-0faf-45b5-a96c-6394ec312974"],
 " irreducible representation: it is the trace-free part of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5db8a811-f8f0-4fe4-a5cc-de93e6a472a4"],
 " block under the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    StyleBox["d", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b143025b-61ba-4803-9cd1-727cfa7ef116"],
 " action on the four vector indices. Extracting it requires subtracting \
Ricci and scalar-curvature traces using the metric, which is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    StyleBox["d", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f73b3a77-408e-45e9-a798-16c2410505bd"],
 " (or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], 
    StyleBox["L", "TI"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"84442ae3-3860-49af-9cf1-67391252c323"],
 ") representation theory on the ",
 StyleBox["indices", "TI"],
 ", not ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["S", "TI"], 
    StyleBox["n", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "696e0ac1-a8d5-4634-8a4a-ed8ec7bb24ae"],
 " representation theory on the ",
 StyleBox["slots", "TI"],
 ". The Symmetry functions handle the slot layer cleanly; the index-level ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["O", "TI"], "(", 
    StyleBox["d", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ae1efebf-d7fb-41dd-8650-84ddb1e067df"],
 " decomposition into Weyl + traceless Ricci + scalar lives on top of it."
}], "Text",ExpressionUUID->"3b7ea956-075c-4ffa-b157-26eb6275f04d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Component count at arbitrary spacetime dimension", "Subsubsection",ExpressionUUID->"77a0472d-6e1e-4a80-8a47-292149a5f490"],

Cell[TextData[{
 StyleBox["The Riemann tensor has ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["d", "TI"], "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "2"], "-", "1"}], ")"}], "/", "12"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6a61da3f-087d-43ae-a2b0-cbd60ec49ecf"],
 StyleBox[" independent components in dimension ", "TI"],
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cba129e5-9896-486c-ad13-0f0fe11064bd"],
 StyleBox[" (1, 6, 20, 50 at ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2", ",", "3", ",", "4", ",", "5"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "90876fc9-9e83-4f39-8a41-a6892c9372b2"],
 StyleBox["). ", "TI"],
 Cell[BoxData[
  RowBox[{"SchurDimension", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "2"}], "}"}], ",", " ", "d"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"3cdc37cd-3729-476f-8c74-990a3560b3f1"],
 StyleBox[" returns this textbook count in closed form via the hook-content \
formula, and a brute-force ", "TI"],
 Cell[BoxData[
 "MatrixRank"], "InlineFormula",ExpressionUUID->
  "1ccaacfc-ee77-410e-b4e6-3501fa8110c4"],
 StyleBox[" of the projector confirms it numerically at small ", "TI"],
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dc994320-e689-4135-bca3-00df5f78ce8b"],
 StyleBox[".", "TI"]
}], "Text",ExpressionUUID->"aac82a4e-57cb-4511-bd3b-dc16a9043ba3"],

Cell[CellGroupData[{

Cell[TextData[{
 "How many independent Riemann components are there in dimension ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1fc1a2ad-9a2a-4fdb-867d-55274e2c1267"],
 "? The textbook answer is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     StyleBox["d", "TI"], "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       StyleBox["d", "TI"], "2"], "-", "1"}], ")"}], "/", "12"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c2d18dd4-1b62-4cbe-a694-782e42cd8c2a"],
 " (so 1, 6, 20, 50 at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "2", ",", "3", ",", "4", ",", "5"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b9044d98-38cc-4058-9670-d5c44baae841"],
 "). That count is ",
 StyleBox["exactly", "TI"],
 " the dimension of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["G", "TI"], 
    StyleBox["L", "TI"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6744d7f7-7062-4d73-ac63-fc5e034a4f16"],
 " Weyl module ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["W", "TI"], 
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4edce122-f648-480a-8b7f-3fa28c2ac83a"],
 ", which is the value of the Schur polynomial ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["s", "TI"], 
     RowBox[{"2", ",", "2"}]], "(", 
    SuperscriptBox["1", 
     StyleBox["d", "TI"]], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3ad64a92-37f7-4d6c-899f-c60f134ffb74"],
 " that our ",
 Cell[BoxData[
 "HookLengths"], "InlineFormula",ExpressionUUID->
  "1a6ffd78-09d8-40d4-a6bd-112b7b5be32c"],
 "-driven ",
 Cell[BoxData[
 "SchurDimension"], "InlineFormula",ExpressionUUID->
  "4c4c2ea1-d215-468e-a720-0bc5bcfd408b"],
 " returns. Apply it at the four physically interesting dimensions."
}], "Text",ExpressionUUID->"49669cdf-ee6c-448f-b34c-232cebb1b6ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", ",", " ", 
     RowBox[{"SchurDimension", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "2"}], "}"}], ",", " ", "d"}], "]"}]}], "}"}], 
   ",", " ", 
   RowBox[{"{", 
    RowBox[{"d", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3", ",", " ", "4", ",", " ", "5"}], "}"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[441]:=",ExpressionUUID->"ca0e6231-6b2d-4b60-848b-0a49a65bc7a7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "6"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "20"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "50"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9888385899880753`*^9},
 CellLabel->"Out[441]=",
 CellID->448440525,ExpressionUUID->"93bd5188-44e5-4571-a772-7e9c3aa70d70"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Numerically verify the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"676399e3-6098-4543-8a86-3282138afbd0"],
 " count by computing the rank of the linear map ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["T", "TI"], "\[RightTeeArrow]", 
    StyleBox["YoungProject",
     FontSlant->"Plain"], 
    RowBox[{"[", 
     RowBox[{
      StyleBox["T", "TI"], ",", 
      StyleBox["YoungTableau",
       FontSlant->"Plain"], 
      RowBox[{"[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "4"}], "}"}]}], "}"}], "]"}]}], "]"}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "682b8ee5-fd74-4667-9238-50ec0e4b24cc"],
 " on the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["4", "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"28ef7499-80b8-4f8e-ac98-6ff862503268"],
 "-dimensional space of generic rank-4 tensors."
}], "Text",ExpressionUUID->"9ed081b9-b816-4bc4-afd6-bdd8de137f1e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"projectionRank", "[", "d_", "]"}], " ", ":=", " ", 
   RowBox[{"MatrixRank", " ", "@", " ", 
    RowBox[{"Transpose", " ", "@", " ", 
     RowBox[{"Map", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"YoungProject", "[", 
          RowBox[{
           RowBox[{"ArrayReshape", "[", 
            RowBox[{"#", ",", " ", 
             RowBox[{"{", 
              RowBox[{"d", ",", " ", "d", ",", " ", "d", ",", " ", "d"}], 
              "}"}]}], "]"}], ",", "\n", "                         ", 
           RowBox[{"YoungTableau", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}], "]"}]}], "]"}], 
         "]"}], " ", "&"}], ",", "\n", "    ", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"d", "^", "4"}], "]"}]}], "\n", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{"projectionRank", "[", "4", "]"}]}], "Input",
 CellLabel->
  "In[442]:=",ExpressionUUID->"9537a4c9-c8f2-4454-b417-69aa9b838ba1"],

Cell[BoxData["20"], "Output",
 CellChangeTimes->{3.9888385901820507`*^9},
 CellLabel->"Out[443]=",
 CellID->1419786352,ExpressionUUID->"d12333dd-b456-4ba5-8f78-41c23339e9ff"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Twenty, as expected. The full ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["S", "TI"], "4"], "\[CircleTimes]", 
    StyleBox["G", "TI"], 
    StyleBox["L", "TI"], 
    RowBox[{"(", 
     StyleBox["d", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7fb98c6f-93c7-4228-a11f-308be85a52f4"],
 " block dimension is twice this, since ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"TableauDimension", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}], "]"}], " ", "=", " ", "2"}]], 
  "InlineFormula",ExpressionUUID->"fdf7d812-c94d-4291-a768-437b888daeee"],
 " (there are two standard tableaux of shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"391f32bb-ab20-4aa5-a477-4508bc2d4c8c"],
 ", hence two isomorphic copies of the irreducible representation living \
inside ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", "4"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ca63d642-8927-41c0-a464-6725cc539150"],
 "): the second standard tableau is ",
 Cell[BoxData[
  RowBox[{"YoungTableau", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"982ee9af-72e4-4e88-9359-3c6baea0e909"],
 ", projecting onto a separate 20-dimensional subspace orthogonal to the \
first."
}], "Text",ExpressionUUID->"8efdf93e-2600-4c61-8da8-f766dff7adc5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["TN-bond enumeration for a rank-4 bond", "Subsubsection",ExpressionUUID->"2b2504b9-4aff-44ed-86ba-ad815826a9a6"],

Cell[TextData[{
 StyleBox["A rank-4 TN tensor at bond dimension ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"06564899-9f0e-410f-8754-b244ad46cfa6"],
 StyleBox[" splits into five irreducible-representation blocks of sizes ", 
  "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"35", ",", "135", ",", "40", ",", "45", ",", "1"}], "}"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "20e743a9-e9c9-4fb6-b62c-02a522d8424f"],
 StyleBox[", summing to ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["4", "4"], "\[LongEqual]", "256"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a2ce86d3-7836-42fa-a96b-a5f2d942963a"],
 StyleBox[". ", "TI"],
 Cell[BoxData[
  RowBox[{"IntegerPartitions", "[", "4", "]"}]], "InlineFormula",
  ExpressionUUID->"eccbd773-2d8f-4510-bb68-d3bb07c45b9f"],
 StyleBox[", ", "TI"],
 Cell[BoxData[
 "TableauDimension"], "InlineFormula",ExpressionUUID->
  "eebcfa20-fb22-4122-b7bf-fe6eceaa1e69"],
 StyleBox[", and ", "TI"],
 Cell[BoxData[
 "SchurDimension"], "InlineFormula",ExpressionUUID->
  "0ef5b3f9-91d0-413c-8345-bb9c98dba8d4"],
 StyleBox[" together produce this table in closed form, which a \
symmetry-resolved TN library consults to pre-allocate block storage before \
any contraction runs.", "TI"]
}], "Text",ExpressionUUID->"5e1c9174-2b09-4f3f-836b-30e1c37c7343"],

Cell[CellGroupData[{

Cell[TextData[{
 "All five partitions of 4 together decompose the rank-4 tensor space at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f9e289ee-1f87-4321-9191-e2bf6f6d79fa"],
 " block-by-block."
}], "Text",ExpressionUUID->"f6b2afa3-9e46-4dde-bc6c-139b9aa612d7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "    ", 
  RowBox[{
   RowBox[{"par", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"TableauDimension", "[", "par", "]"}], ",", " ", 
      RowBox[{"SchurDimension", "[", 
       RowBox[{"par", ",", " ", "4"}], "]"}], ",", "\n", "            ", 
      RowBox[{
       RowBox[{"TableauDimension", "[", "par", "]"}], " ", "*", " ", 
       RowBox[{"SchurDimension", "[", 
        RowBox[{"par", ",", " ", "4"}], "]"}]}]}], "}"}]}], ",", "\n", "    ", 
   RowBox[{"{", 
    RowBox[{"par", ",", " ", 
     RowBox[{"IntegerPartitions", "[", "4", "]"}]}], "}"}]}], "\n", 
  "]"}]], "Input",
 CellLabel->
  "In[444]:=",ExpressionUUID->"130e419d-481e-4f10-a29e-9a71f6c4f824"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", "4", "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "35", ",", "35"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", "1"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3", ",", "45", ",", "135"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "20", ",", "40"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3", ",", "15", ",", "45"}], "}"}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1"}], "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.988838590203312*^9},
 CellLabel->"Out[444]=",
 CellID->1658416247,ExpressionUUID->"c64fe524-cb99-49dc-88d2-852e1727ef2b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Read the totals column (",
 Cell[BoxData[
  FormBox[
   RowBox[{"dim", 
    SubscriptBox[
     StyleBox["V", "TI"], "\[Lambda]"], "\[CenterDot]", "dim", 
    SubscriptBox[
     StyleBox["W", "TI"], "\[Lambda]"], 
    RowBox[{"(", "4", ")"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"20a98ad8-b634-4111-8e2a-26a8cefa3866"],
 "): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "35", "+", "135", "+", "40", "+", "45", "+", "1", "\[LongEqual]", "?"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bdc369ca-394c-48c7-9ad5-bc802aa847e5"],
 ". Sum it."
}], "Text",ExpressionUUID->"a885eb0f-a107-4c4c-8cc6-1378753e47c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Total", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"TableauDimension", "[", "#", "]"}], " ", "*", " ", 
     RowBox[{"SchurDimension", "[", 
      RowBox[{"#", ",", " ", "4"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
   RowBox[{"IntegerPartitions", "[", "4", "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[445]:=",ExpressionUUID->"a4e570b0-32e6-4439-927f-f4924c013a5d"],

Cell[BoxData["256"], "Output",
 CellChangeTimes->{3.988838590230453*^9},
 CellLabel->"Out[445]=",
 CellID->811608916,ExpressionUUID->"8c010c11-efea-488e-990c-7162bc3a727f"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The total is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"256", "\[LongEqual]", 
    SuperscriptBox["4", "4"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b986bad5-cace-49ba-be1a-2f4a5f31bf5d"],
 ": the five sectors exhaust the space. A TN library can carry the same data \
either as a flat ",
 Cell[BoxData[
  FormBox["256", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2a5a2e3f-ff58-4d0f-9a0d-7c6c8a7a84eb"],
 "-vector or as five block-sparse pieces of sizes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"35", ",", "135", ",", "40", ",", "45", ",", "1"}], "}"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d7af0ce6-c6a6-4fad-9e48-13e868deffa8"],
 ". When symmetry forbids transitions between sectors (e.g. only ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"de346838-4d94-4aef-ae39-79869091f08f"],
 " is dynamical, as for a curvature tensor), the block-sparse form needs ",
 Cell[BoxData[
  FormBox["40", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "90614c4f-142b-435e-ac5c-4e0a7275aafa"],
 " numbers instead of ",
 Cell[BoxData[
  FormBox["256", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7fd0afd8-2b5f-49a6-9819-b57b789e8477"],
 ": a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6.4", "\[Cross]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"87ccd6d3-6e76-455d-952a-4021277ae229"],
 " compression at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"57f8e5af-6bcb-4cd1-a354-6271f33fa13c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6.2", "\[Cross]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"820813a7-d816-480e-a139-7724d290eee5"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "6"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"311c83c2-4eb5-4e65-88a8-3ef3371cf315"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"619c9651-576b-431f-ad63-e3104dee9d22"],
 " block holds ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[CenterDot]", "105", "\[LongEqual]", "210"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2f02be03-67ac-4324-bcee-17aeb87df120"],
 " out of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["6", "4"], "\[LongEqual]", "1296"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"85d91800-ca16-49b8-91cc-7c35a50577a6"],
 "), and so on."
}], "Text",ExpressionUUID->"606c5026-ea5b-41df-acc3-cf649d7d1e55"],

Cell["\<\
The dimension counting itself costs only a few hook-length products, the \
cheapest pre-allocation step in a symmetry-resolved TN code.\
\>", "Text",ExpressionUUID->"7457621f-a8e8-42c9-8d0c-44259b63966d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Block-sparse contraction on a rank-4 bond", "Subsubsection",ExpressionUUID->"d85b4492-ffd9-4034-819a-044f77f836e7"],

Cell[TextData[{
 StyleBox["Contracting two rank-4 tensors at ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c91c8f5e-1b16-46dd-bdd7-049aca17d4d8"],
 StyleBox[" splits into a ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"5", "\[Cross]", "5"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cbf2d3ab-0dbb-4f00-8302-9d0b33ea361f"],
 StyleBox[" same-sector-only diagonal: 20 cross-sector products are zero by \
Schur orthogonality. When one tensor is symmetry-constrained (e.g. \
Riemann-like, ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "2"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f5560e36-e718-4d15-90f0-73f89a6481cf"],
 StyleBox["-block only), the contraction collapses from 256 multiplications \
to 40, a ", "TI"],
 Cell[BoxData[
  FormBox[
   RowBox[{"6.4", "\[Cross]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7e7dc70c-493c-4e31-b14d-2037343e57ea"],
 StyleBox[" FLOP saving per bond that compounds across a many-tensor \
network.", "TI"]
}], "Text",ExpressionUUID->"8a9f568b-0ad3-419a-a6fc-959540c7c18e"],

Cell[CellGroupData[{

Cell[TextData[{
 "The enumeration is more than bookkeeping. Every Frobenius contraction of \
two rank-4 tensors at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"2d198cdf-780e-4ce7-bcf1-765b836db9d1"],
 " block-decomposes by Schur orthogonality: only same-sector pairs \
contribute, every cross-sector contribution is zero. Build two generic random \
rank-4 tensors."
}], "Text",ExpressionUUID->"d753eb76-da86-4fd9-84b2-be1494bf2a9f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T1", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4", ",", " ", "4", ",", " ", "4"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "100", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T2", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4", ",", " ", "4", ",", " ", "4"}], "}"}]}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[446]:=",ExpressionUUID->"0f1da0d9-0018-4240-9569-11cb0cfb8201"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The five partitions of 4 each have several standard tableaux (one per copy \
of the irreducible representation inside ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["V", "TI"], 
    RowBox[{"\[CircleTimes]", "4"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"60cf177d-deed-464b-9c24-984e57760191"],
 "). Enumerate them in an ",
 Cell[BoxData[
 "Association"], "InlineFormula",ExpressionUUID->
  "5fefddcd-889d-49b3-97d5-59a4123520eb"],
 " keyed by partition."
}], "Text",ExpressionUUID->"738a7474-e0e9-495d-8838-3d796ccf9535"],

Cell[BoxData[
 RowBox[{
  RowBox[{"syt", " ", "=", " ", 
   RowBox[{"<|", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "4", "}"}], "          ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], 
        "}"}], "}"}]}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "1"}], "}"}], "       ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", "4", "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", "3", "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", "2", "}"}]}], "}"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}], "       ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "4"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "4"}], "}"}]}], "}"}]}], "}"}]}], ",", "\n",
      "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "1", ",", " ", "1"}], "}"}], "    ", "->", " ", 
      
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", "3", "}"}], ",", " ", 
          RowBox[{"{", "4", "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
          RowBox[{"{", "2", "}"}], ",", " ", 
          RowBox[{"{", "4", "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", "2", "}"}], ",", " ", 
          RowBox[{"{", "3", "}"}]}], "}"}]}], "}"}]}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}], " ",
       "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "1", "}"}], ",", " ", 
         RowBox[{"{", "2", "}"}], ",", " ", 
         RowBox[{"{", "3", "}"}], ",", " ", 
         RowBox[{"{", "4", "}"}]}], "}"}], "}"}]}]}], "\n", "|>"}]}], 
  ";"}]], "Input",
 CellLabel->
