ionUUID->"ab7a4e2f-51ae-4261-9321-1d09377c3254"],

Cell[TextData[{
 "The two layers compose. ",
 Cell[BoxData[
 "YoungSymmetrize"], "InlineFormula",ExpressionUUID->
  "f8e4fb97-8232-4080-b1ce-5c084326076f"],
 " is two ",
 Cell[BoxData[
 "Symmetrize"], "InlineFormula",ExpressionUUID->
  "c7618998-365f-42b0-9c96-53bb0e049c4f"],
 " calls (",
 Cell[BoxData[
  RowBox[{"Symmetric", " ", "/@", " ", "rows"}]], "InlineFormula",
  ExpressionUUID->"28f5479f-e10c-4a48-ba2e-849de23a779a"],
 ", then ",
 Cell[BoxData[
  RowBox[{"Antisymmetric", " ", "/@", " ", "columns"}]], "InlineFormula",
  ExpressionUUID->"3bbc0e04-b632-4e52-9951-19ebae86d12f"],
 ") plus the row- and column-stabiliser normalisation factors. The multi-term \
machinery extends the mono-term machinery, not competes with it."
}], "Text",ExpressionUUID->"7a66aaf9-1781-4c74-92d8-726002b4189a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Setup", "Section",ExpressionUUID->"f301b9c5-ff36-4900-af6d-ea952ac62e10"],

Cell[CellGroupData[{

Cell[TextData[{
 "Load the paclet and pull the Symmetry functions into scope; both ",
 Cell[BoxData[
 "Needs"], "InlineFormula",ExpressionUUID->
  "7ee0404a-589e-4c9e-84ef-03da39232f15"],
 " are assumed in every subsequent cell. The ",
 Cell[BoxData[
 "tol"], "InlineFormula",ExpressionUUID->
  "54925049-2d3b-4d5f-92f0-063dfccc376d"],
 " constant sets the numerical tolerance for \"is this tensor identity \
satisfied?\" checks throughout."
}], "Text",ExpressionUUID->"4bdd6692-0e67-4b23-bceb-4042920e5538"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`TensorNetworks`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<Wolfram`TensorNetworks`Symmetry`\>\"", "]"}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"tol", " ", "=", " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "10"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.988838886981781*^9, 3.988838887716675*^9}},
 CellLabel->
  "In[242]:=",ExpressionUUID->"eb26f34e-05d3-429c-8d81-724158d913bd"]
}, Open  ]]
}, Open  ]],

