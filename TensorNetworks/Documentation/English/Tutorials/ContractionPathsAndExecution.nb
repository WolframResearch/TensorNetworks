Cell[CellGroupData[{

Cell[TextData[{
 "The ",
 "\"TransposeFunction\"",
 " option lets the caller substitute a custom transpose primitive in the \
final permutation step \[Dash] useful when contracting tensors that live in a \
non-standard storage format (e.g., a ",
 Cell[BoxData[
  ButtonBox["SparseArray",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/SparseArray"]], "InlineFormula",ExpressionUUID->
  "e98238c0-e5a3-41bb-91c3-9264a91b3eee"],
 " packing). The default is the system ",
 Cell[BoxData[
  ButtonBox["Transpose",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Transpose"]], "InlineFormula",ExpressionUUID->
  "8b8b8109-1077-4512-b521-f5e830d6ff97"],
 "."
}], "Text",ExpressionUUID->"cb3e9b57-dd9e-4303-9158-96dafbfda6a5"],

