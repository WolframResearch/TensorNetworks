Cell[CellGroupData[{

Cell["\<\
\"AllowOuterProducts\" permits the optimizer to introduce outer-product steps \
(pairs with no shared index). The default disallows them since they multiply \
tensor sizes without contracting; some networks benefit from allowing the \
search to consider them.\
\>", "Text",ExpressionUUID->"4b99129d-067a-4ccf-9bd1-d7fe01eb41c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OptimalContractionPath", "[", 
  RowBox[{"tn", ",", 
   RowBox[{"\"\<AllowOuterProducts\>\"", "\[Rule]", "True"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[174]:=",ExpressionUUID->"4182f445-4fb7-4870-87a1-4e4671d3dac0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9881161351770573`*^9, 3.988224813893837*^9},
 CellLabel->"Out[174]=",
 CellID->481584535,ExpressionUUID->"d82cbb42-23f7-407b-8ec2-f576b34f47a5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
\"PreSimplify\" mirrors the greedy option \[Dash] fuses duplicate indices and \
trivial dimensions before the dynamic-programming search runs.\
\>", "Text",ExpressionUUID->"ccf29523-9241-433c-b9a7-244d20304a67"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OptimalContractionPath", "[", 
  RowBox[{"tn", ",", 
   RowBox[{"\"\<PreSimplify\>\"", "\[Rule]", "True"}]}], "]"}]], "Input",
