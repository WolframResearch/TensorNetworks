Cell[CellGroupData[{

Cell["\<\
\"TensorContract\" keeps every step as a symbolic \
TensorContract[TensorProduct[\[Ellipsis]], \[Ellipsis]] expression activated \
at the end. Closest to the textbook definition; slower for large networks.\
\>", "Text",ExpressionUUID->"d0de514c-1caa-40fa-995c-04a5d47bcbb8"],

