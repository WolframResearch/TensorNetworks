   RowBox[{"TensorNetworkContraction", "[", 
    RowBox[{"mpsNum", ",", "p", ",", 
     RowBox[{"Method", "\[Rule]", "\"\<TableSum\>\""}]}], "]"}], 
   "]"}]}]], "Input",
