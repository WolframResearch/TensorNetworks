   RowBox[{"Method", "\[Rule]", "\"\<max\>\""}]}], "]"}]], "Input",
 CellLabel->
  "In[170]:=",ExpressionUUID->"b93b5d9d-9f90-4e91-a9cf-e9ec49d94e3d"],

Cell[BoxData[
