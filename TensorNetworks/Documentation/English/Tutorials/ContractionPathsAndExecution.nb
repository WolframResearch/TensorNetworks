                   2.3843857390036622`}}], 
                  Opacity[1], {}}}}, {
                LightDarkSwitched[
                 Opacity[0.1, 
                  Hue[0.63, 0.66, 0.81]], 
                 GrayLevel[1]], {
                 FilledCurveBox[{
                   
                   BSplineCurve[{{1.344624860310275, 2.429638883913072}, {
                    1.8431947282458234`, 2.476500345303722}, {
                    2.0823544756007033`, 1.9391162474560293`}}], 
                   
                   BSplineCurve[{{2.0823544756007033`, 1.9391162474560293`}, {
                    2.1962408044083146`, 2.5971930874535967`}, {
