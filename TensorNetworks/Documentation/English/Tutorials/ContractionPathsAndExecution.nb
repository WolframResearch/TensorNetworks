Cell[CellGroupData[{

Cell[TextData[{
 "\"TableSum\"",
 " constructs an explicit ",
 "Table[Sum[\[Ellipsis]], iterators]",
 " form. Pedagogically clear but quadratic in iteration count; demonstrate \
via the inactive path and ",
 Cell[BoxData[
  ButtonBox["ActivateTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ActivateTensors"]], 
  "InlineFormula",ExpressionUUID->"d207756c-f9dc-4835-9f45-4dcb65111b2b"],
 ". Note: ",
 "Method \[Rule] \"TableSum\"",
 " does not currently round-trip through ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"ea5d3adb-b80e-450b-a2af-4898cb58e4ac"],
 " (with ",
 "\"Inactive\" \[Rule] False",
 ") \[Dash] invoke via ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
   "InlineFormula",ExpressionUUID->"969949b0-26cb-4a00-814b-387d9ffd506b"],
 " plus ",
 Cell[BoxData[
  ButtonBox["ActivateTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ActivateTensors"]], 
  "InlineFormula",ExpressionUUID->"7aa32273-8a65-49a9-aa51-c9f50955ecd6"],
 " instead."
}], "Text",ExpressionUUID->"7f5fc736-a1f6-49e3-8e1e-e5d44aa3a59f"],

