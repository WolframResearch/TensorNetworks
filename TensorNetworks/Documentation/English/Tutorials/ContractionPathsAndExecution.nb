Cell[TextData[{
 "\"ArrayDotTranspose\"",
 " permutes axes to a canonical layout before each pairwise contraction. \
Same numerical result as ",
 "\"ArrayDot\"",
 ", different internal representation."
}], "Text"],

Cell[BoxData[
 RowBox[{"r3", "=",
  RowBox[{"TensorNetworkContract", "[",
   RowBox[{"mpsNum", ",", "p", ",",
    RowBox[{"Method", "\[Rule]", "\"\<ArrayDotTranspose\>\""}]}], "]"}]}]],
 "Input"],

Cell["Verify against the \"ArrayDot\" baseline.", "Text"],

Cell[BoxData[
 RowBox[{"Max", "[",
  RowBox[{"Abs", "[",
   RowBox[{"Flatten", "[",
    RowBox[{"r1", "-", "r3"}], "]"}], "]"}], "]"}]], "Input"],

Cell[TextData[{
 "\"TensorContract\"",
 " keeps every step as a symbolic ",
 "TensorContract[TensorProduct[\[Ellipsis]], \[Ellipsis]]",
 " expression activated at the end. Closest to the textbook definition; \
slower for large networks."
}], "Text"],

Cell[BoxData[
 RowBox[{"r4", "=",
  RowBox[{"ActivateTensors", "[",
   RowBox[{"TensorNetworkContraction", "[",
    RowBox[{"mpsNum", ",", "p", ",",
     RowBox[{"Method", "\[Rule]", "\"\<TensorContract\>\""}]}], "]"}],
   "]"}]}]], "Input"],

Cell["Same numerics.", "Text"],

Cell[BoxData[
 RowBox[{"Max", "[",
  RowBox[{"Abs", "[",
   RowBox[{"Flatten", "[",
    RowBox[{"r1", "-", "r4"}], "]"}], "]"}], "]"}]], "Input"],

Cell[TextData[{
 "\"TableSum\"",
 " constructs an explicit ",
 "Table[Sum[\[Ellipsis]], iterators]",
 " form. Pedagogically clear but quadratic in iteration count; demonstrate \
via the inactive path and ",
 Cell[BoxData[
  ButtonBox["ActivateTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ActivateTensors"]],
  "InlineFormula"],
 ". Note: ",
 "Method \[Rule] \"TableSum\"",
 " does not currently round-trip through ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]],
  "InlineFormula"],
 " (with ",
 "\"Inactive\" \[Rule] False",
 ") \[Dash] invoke via ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
  "InlineFormula"],
 " plus ",
 Cell[BoxData[
  ButtonBox["ActivateTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ActivateTensors"]],
  "InlineFormula"],
 " instead."
}], "Text"],

Cell[BoxData[
 RowBox[{"r5", "=",
  RowBox[{"ActivateTensors", "[",
   RowBox[{"TensorNetworkContraction", "[",
    RowBox[{"mpsNum", ",", "p", ",",
     RowBox[{"Method", "\[Rule]", "\"\<TableSum\>\""}]}], "]"}],
   "]"}]}]], "Input"],

Cell["Same numerics \[Dash] the engine is correct, only the end-to-end \
TensorNetworkContract path is broken.", "Text"],

Cell[BoxData[
 RowBox[{"Max", "[",
  RowBox[{"Abs", "[",
   RowBox[{"Flatten", "[",
    RowBox[{"r1", "-", "r5"}], "]"}], "]"}], "]"}]], "Input"],

Cell[TextData[{
 "The point of the comparison is not the wall-clock difference \[Dash] both \
engines complete instantly on a three-tensor chain \[Dash] but the \
verification that they produce ",
 "the same number",
 " from the same path. On networks where this is not obvious (because the \
engines route operands differently and accumulate floating-point error along \
different orderings), the maximum absolute difference is a useful smoke test \
that nothing about the contraction has gone wrong. Differences larger than a \
few times the working ",
 Cell[BoxData[
  ButtonBox["MachineEpsilon",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/$MachineEpsilon"]], "InlineFormula",ExpressionUUID->
  "83a9b8e8-bf09-4a9a-9525-d90c8089ed3b"],
 " almost always signal an index mismatch, a wrong path, or a tensor of the \
wrong shape \[Dash] not a real engine bug."
}], "Text",ExpressionUUID->"e9cd7b7c-d089-46c1-ba58-313a6e20508f"],

Cell[TextData[{
 "The two results agree to machine precision \[Dash] up to floating-point \
noise the engines are interchangeable, and on most networks the difference \
between them is invisible to a downstream consumer. The choice is therefore a \
performance choice, not a correctness choice. Concretely: pick ",
 "\"ArrayDot\"",
 " for dense numerical work (the default), where the optimized primitive \
beats every other route. Pick ",
 "\"TensorContract\"",
 " when you want the cleanest symbolic expression for downstream pattern \
matching or human inspection \[Dash] the resulting tree mentions only ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorProduct"]], "InlineFormula",ExpressionUUID->
  "71fa0870-0b1f-4bcf-b4c9-8ba15ed27eb6"],
 " and ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorContract"]], "InlineFormula",ExpressionUUID->
  "c84f6c37-ffc6-4aff-ae63-c242c3cc9bfb"],
 ", which are easier to walk than the mixed ",
 "ArrayDot",
 "/",
 "Transpose",
 " trees the default produces. Pick ",
 "\"Dot\"",
 " when an external matrix-multiplication routine is faster than the built-in \
",
 "ArrayDot",
 " (for example, when ",
 Cell[BoxData[
  ButtonBox["Dot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Dot"]], "InlineFormula",ExpressionUUID->
  "d50bcca8-bddb-4160-852c-4c0148583dd3"],
 " has been overloaded to call a GPU-accelerated library). And reach for ",
 "\"ArrayDotTranspose\"",
 " only when you're debugging \[Dash] it makes the per-step axis alignment \
explicit in the expression tree, at the cost of a slightly larger ",
 "Inactive",
 " representation."
}], "Text",ExpressionUUID->"afb76378-8cac-4728-b0c7-4c25b1c25f7c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Inactive Expressions", "Section",ExpressionUUID->"6ae6221c-fa98-433c-a803-b5fbb5c1314e"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
   "InlineFormula",ExpressionUUID->"68a5951f-f114-4d5c-bf41-10564bfbdc59"],
 " (with the final ",
 "tion",
 ") returns a symbolic ",
 Cell[BoxData[
  ButtonBox["Inactive",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Inactive"]], "InlineFormula",ExpressionUUID->
  "e2519020-07f7-4081-a158-d5e6f862c37a"],
 " tree representing the planned contraction \[Dash] every operator wears an ",
 "Inactive[\[Ellipsis]]",
 " head, so nothing has been numerically evaluated yet. This is the natural \
unit of inspection: the expression shows exactly which sub-tensors will be \
built and in what order, but no array has been allocated and no arithmetic \
has happened. The Wolfram Language convention is that ",
 Cell[BoxData[
  ButtonBox["Inactive",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Inactive"]], "InlineFormula",ExpressionUUID->
  "cf20fec1-0b52-4ed0-a0b1-90b3a329965a"],
 "-wrapped heads are inert under evaluation \[Dash] they print, they \
pattern-match, they nest, but they do not execute \[Dash] until ",
 Cell[BoxData[
  ButtonBox["Activate",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Activate"]], "InlineFormula",ExpressionUUID->
  "def28418-bec9-401a-90ee-3b6ba4e3aa8a"],
 " or ",
 Cell[BoxData[
  ButtonBox["ActivateTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ActivateTensors"]], 
  "InlineFormula",ExpressionUUID->"66b380cd-117d-4993-b7bd-2509f7bb18ba"],
 " strips the ",
 "Inactive",
 " heads off. ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"6b46118f-3147-4d74-a7ec-a2a41b7aca61"],
 " (no ",
 "tion",
 ") is the shorthand that activates the same tree in one call \[Dash] \
equivalent to ",
 "TensorNetworkContraction[net, path, \"Inactive\" \[Rule] False]",
 " or to wrapping ",
 "ActivateTensors",
 " around the previous result."
}], "Text",ExpressionUUID->"99ba1222-fdf4-49ec-88b2-2c53168747ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"plan", "=", 
  RowBox[{"TensorNetworkContraction", "[", 
   RowBox[{"mps", ",", "path"}], "]"}]}]], "Input",
 CellLabel->
  "In[117]:=",ExpressionUUID->"90c34d4b-2e35-41cd-a8dd-df94e0a507f9"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"Transpose"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[Transpose]"], "[", 
  RowBox[{
   RowBox[{
    TemplateBox[{"ArrayDot"},
     "InactiveHead",
     BaseStyle->"Inactive",
     SyntaxForm->"Symbol",
     Tooltip->"Inactive[ArrayDot]"], "[", 
    RowBox[{
     TemplateBox[{"\"C\"", "2", "3", "2"},
      "ArraySymbol2"], ",", 
     RowBox[{
      TemplateBox[{"ArrayDot"},
       "InactiveHead",
       BaseStyle->"Inactive",
       SyntaxForm->"Symbol",
       Tooltip->"Inactive[ArrayDot]"], "[", 
      RowBox[{
       TemplateBox[{"\"A\"", "2", "2", "3"},
        "ArraySymbol2"], ",", 
       TemplateBox[{"\"B\"", "2", "3", "3"},
        "ArraySymbol2"], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "}"}]}], "]"}], ",", 
   RowBox[{"Cycles", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], "}"}], "]"}]}], "]"}]], "Output",
 CellChangeTimes->{3.9880654284143267`*^9},
 CellLabel->"Out[117]=",
 CellID->1413758465,ExpressionUUID->"119a3d8f-fe34-4489-9ee5-7fd12abdd021"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Read from the inside out: build the AB intermediate with ",
 "Inactive[ArrayDot]",
 " over shared axis pair ",
 "{{2,1}}",
 " (axis ",
 "2",
 " of ",
 "A",
 " meets axis ",
 "1",
 " of ",
 "B",
 "), contract that with ",
 "C",
 " over axis pair ",
 "{{1,2}}",
 ", and finally transpose the result by ",
 "Cycles[{{1,2}}]",
 " to match the free-index ordering ",
 "{1, 4}",
 " specified by the network. The transpose is necessary because the \
contraction order chose to put the rightmost tensor ",
 "C",
 " on the outside of the call; without it, the free legs would emerge in the \
order ",
 "{4, 1}",
 " rather than ",
 "{1, 4}",
 ". Because the ",
 "ArraySymbol",
 " placeholders are still abstract, this works even when the tensors have no \
concrete data \[Dash] useful for cost analysis and for symbolic codegen, \
where the same plan can be specialized to multiple concrete networks of \
matching shape. To turn the plan into a number, hand the expression to ",
 Cell[BoxData[
  ButtonBox["ActivateTensors",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ActivateTensors"]], 
  "InlineFormula",ExpressionUUID->"109aee4e-ba39-40f1-bb1d-6e73fe64f50f"],
 ":"
}], "Text",ExpressionUUID->"0be77196-757c-44c7-bc13-ecef2d39d742"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ActivateTensors", "[", 
  RowBox[{"TensorNetworkContraction", "[", 
   RowBox[{"mpsNum", ",", "p"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[118]:=",ExpressionUUID->"8bd77975-0507-49d1-977e-cdef27eb1afd"],

Cell[BoxData[
 RowBox[{"TensorNetworkContraction", "[", 
  RowBox[{"mpsNum", ",", "p"}], "]"}]], "Output",
 CellChangeTimes->{3.988065428427733*^9},
 CellLabel->"Out[118]=",
 CellID->1279450847,ExpressionUUID->"3b76251a-c27d-4b34-a429-9570e0c2a126"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The result is a ",
 "2\[Times]2",
 " numeric array \[Dash] the same value ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"a3590f0e-fc58-4291-9637-0b2c16f3199a"],
 " would return in one call. The separation between plan and execution is the \
value here: when a network is large enough that contraction takes minutes, \
building the ",
 "Inactive",
 " expression first lets you inspect the dimension flow at every node (via ",
 Cell[BoxData[
  ButtonBox["ContractionTree",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ContractionTree"]], 
  "InlineFormula",ExpressionUUID->"b6bdab7d-eb1b-4be6-81aa-839078102a49"],
 "), estimate cost, switch engines per sub-tree, or evaluate symbolically \
against ",
 "ArraySymbol",
 " placeholders before committing to numerics. The same machinery underpins \
",
 Cell[BoxData[
  ButtonBox["TensorNetworkContractions",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/TensorNetworks/ref/TensorNetworkContractions"]], 
  "InlineFormula",ExpressionUUID->"4d9b47b8-ab5b-4e03-85cd-08e3ccbb0d10"],
 ", which returns the per-step index-contraction list directly from a network \
without committing to a specific path \[Dash] handy when many candidate paths \
must be costed against the same network."
}], "Text",ExpressionUUID->"738a686a-e2d4-40bb-9402-e60889aea754"],

Cell["\<\
Putting the whole pipeline together: choose a planner, pass its output to \
TensorNetworkContraction to get an Inactive plan, inspect it (with \
ContractionTree, with PathIndexContractions, or by reading the symbolic \
expression directly), then call ActivateTensors when you want a number. For \
one-shot use, TensorNetworkContract collapses all three steps into a single \
call. The path is data, the plan is data, the result is data \[Dash] every \
level is inspectable and every level is interchangeable, which is why the \
same paclet handles a three-tensor MPS contraction and a \
multi-thousand-tensor PEPS overlap with the same vocabulary.\
\>", "Text",ExpressionUUID->"cdf5ff69-0ff8-46b5-81b1-4565377d33bb"],

Cell["\<\
In day-to-day use the most common pattern is the shortest one: \
TensorNetworkContract[net] by itself. The function selects the greedy \
heuristic for large networks and the size-optimal dynamic-programming search \
for small ones, picks \"ArrayDot\" as the engine, and returns the final \
tensor. The longer pipeline of this tutorial \[Dash] choosing the planner, \
choosing the objective, choosing the engine, holding the plan inactive, \
walking the tree \[Dash] is what you reach for when the default takes too \
long, when memory runs out, when the result must be verified across engines, \
or when the contraction is part of a symbolic codegen pass that will run \
thousands of times against tensors of the same shape. The investment pays off \
precisely when a contraction stops being a one-line call and becomes \
something you need to reason about.\
\>", "Text",ExpressionUUID->"d3b149d8-4af6-4134-b6ae-1522e2a53c13"],

Cell[TextData[{
 "The ",
 "\"Inactive\"",
 " option toggles whether the result is an ",
 "Inactive[\[Ellipsis]]",
 " expression tree (default ",
 "True",
 ", the symbolic form) or the evaluated tensor."
}], "Text"],

Cell[BoxData[
 RowBox[{"TensorNetworkContraction", "[",
  RowBox[{"mpsNum", ",", "p", ",",
   RowBox[{"\"\<Inactive\>\"", "\[Rule]", "True"}]}], "]"}]], "Input"],

Cell[TextData[{
 "Setting ",
 "\"Inactive\" \[Rule] False",
 " reduces ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
  "InlineFormula"],
 " to ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]],
  "InlineFormula"],
 " \[Dash] i.e., the latter is the former with ",
 "\"Inactive\" \[Rule] False",
 " baked in."
}], "Text"],

Cell[BoxData[
 RowBox[{"TensorNetworkContraction", "[",
  RowBox[{"mpsNum", ",", "p", ",",
   RowBox[{"\"\<Inactive\>\"", "\[Rule]", "False"}]}], "]"}]], "Input"],

Cell[TextData[{
 "The path argument can also be a method-name string. ",
 "TensorNetworkContract[tn, \"Greedy\"]",
 " is shorthand for ",
 "TensorNetworkContract[tn, GreedyContractionPath[tn]]",
 "; ",
 "\"Optimal\"",
 ", ",
 "\"flops\"",
 ", ",
 "\"max\"",
 ", ",
 "\"size\"",
 ", ",
 "\"write\"",
 ", ",
 "\"combo\"",
 ", ",
 "\"limit\"",
 " all dispatch to the corresponding optimal-path call."
}], "Text"],

Cell[BoxData[
 RowBox[{"TensorNetworkContract", "[",
  RowBox[{"mpsNum", ",", "\"\<Greedy\>\""}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{"TensorNetworkContract", "[",
  RowBox[{"mpsNum", ",", "\"\<flops\>\""}], "]"}]], "Input"],

Cell[TextData[{
 "The ",
 "\"TransposeFunction\"",
 " option lets the caller substitute a custom transpose primitive in the \
final permutation step \[Dash] useful when contracting tensors that live in a \
non-standard storage format (e.g., a ",
 Cell[BoxData[
  ButtonBox["SparseArray",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/SparseArray"]], "InlineFormula"],
 " packing). The default is the system ",
 Cell[BoxData[
  ButtonBox["Transpose",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Transpose"]], "InlineFormula"],
 "."
}], "Text"],

Cell[BoxData[
 RowBox[{"TensorNetworkContraction", "[",
  RowBox[{"mpsNum", ",", "p", ",",
   RowBox[{"\"\<TransposeFunction\>\"", "\[Rule]", "Transpose"}]}], "]"}]],
 "Input"]
}, Open  ]],

