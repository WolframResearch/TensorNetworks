Cell[CellGroupData[{

Cell[TextData[{
 "Setting ",
 "\"Inactive\" \[Rule] False",
 " reduces ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
   "InlineFormula",ExpressionUUID->"adb47547-f95d-402b-acab-4c5c17588bde"],
 " to ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"00cb6a36-c4cb-4280-8fa3-7865fc716907"],
 " \[Dash] i.e., the latter is the former with ",
 "\"Inactive\" \[Rule] False",
 " baked in."
}], "Text",ExpressionUUID->"54cea1d8-ec98-4242-8187-b52352a65020"],

Cell[CellGroupData[{

Cell[BoxData[
