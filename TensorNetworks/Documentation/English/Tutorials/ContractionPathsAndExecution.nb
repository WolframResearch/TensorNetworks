   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9881161351239653`*^9, 3.9882248138061647`*^9},
 CellLabel->"Out[170]=",
 CellID->1446056833,ExpressionUUID->"be400ec8-83f6-49b7-8479-8f3b287c0544"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OptimalContractionPath", "[", 
  RowBox[{"tn", ",", 
   RowBox[{"Method", "\[Rule]", "\"\<write\>\""}]}], "]"}]], "Input",
 CellLabel->
  "In[171]:=",ExpressionUUID->"9d62f503-0f87-4ab0-8bc9-97599d022b47"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.98811613513166*^9, 3.988224813830412*^9},
 CellLabel->"Out[171]=",
 CellID->804759132,ExpressionUUID->"5a81377d-277c-419b-b743-d2d0508c1da5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OptimalContractionPath", "[", 
  RowBox[{"tn", ",", 
   RowBox[{"Method", "\[Rule]", "\"\<combo\>\""}]}], "]"}]], "Input",
 CellLabel->
  "In[172]:=",ExpressionUUID->"1ae09434-78e0-4490-8d19-31e195089547"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
