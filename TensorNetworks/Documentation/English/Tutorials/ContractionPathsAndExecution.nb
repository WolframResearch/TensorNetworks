    RowBox[{"3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988065428096322*^9, 3.9881161349645147`*^9, 
  3.98822481359382*^9},
 CellLabel->"Out[160]=",
 CellID->1879419400,ExpressionUUID->"3b71ae88-4d45-4d04-8e89-50ee36557d0e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Four options shape the search. ",
 "\"Temperature\"",
 " perturbs the greedy choice with simulated-annealing noise (zero or ",
 Cell[BoxData[
  ButtonBox["None",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/None"]], "InlineFormula",ExpressionUUID->
  "4e524049-0d44-4782-8aa1-ab63acd1f3a4"],
 " is deterministic; positive values widen the search by sometimes accepting \
a suboptimal pair, which lets the planner escape local minima at the cost of \
reproducibility). ",
 "\"RandomSeed\"",
 " makes a noisy run reproducible by fixing the underlying random stream. ",
 "\"MaxNeighbors\"",
 " caps how many candidate pairs are scored at each step, trading quality for \
speed on very dense graphs \[Dash] useful for thousand-tensor PEPS-like \
networks where the per-step candidate list is itself large. ",
 "\"MemoryWeight\"",
 " adds a penalty proportional to peak intermediate memory, which can change \
the chosen path when the cheapest-size step would build a large transient \
tensor. A practical pattern is to run the planner three times \[Dash] with ",
 "\"Temperature\"",
 " ",
 "\[Rule]",
 " ",
 "0",
 " (default), with a small positive temperature and a fixed seed, and with ",
 "\"MemoryWeight\"",
 " ",
 "\[Rule]",
 " ",
 "2.0",
 " \[Dash] then pick whichever path has the lowest objective on the actual \
network:"
}], "Text",ExpressionUUID->"9924b498-d72e-4b26-8a0e-1c943cc74ffe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GreedyContractionPath", "[", 
  RowBox[{"tn", ",", 
   RowBox[{"\"\<MemoryWeight\>\"", "\[Rule]", "2.0"}], ",", 
   RowBox[{"\"\<Temperature\>\"", "\[Rule]", "0.5"}], ",", 
   RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", "1"}]}], "]"}]], "Input",
 CellLabel->
  "In[161]:=",ExpressionUUID->"aaeb5879-f8c8-4278-970d-1495ebbafcf7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.98806542811302*^9, 3.9881161349827137`*^9, 
  3.988224813615738*^9},
 CellLabel->"Out[161]=",
 CellID->64892077,ExpressionUUID->"99dfa944-83c3-40f5-8c25-cd1bb176bbcf"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The memory penalty has rerouted the planner: instead of starting with \
positions ",
 "1",
 " and ",
 "2",
 ", it now begins at ",
 "4",
 " and ",
 "5",
 " and keeps the working tensors smaller through the run. On the small test \
network the difference in cost is modest; on a thousand-tensor lattice it can \
be the difference between contractible and out-of-memory. A reasonable rule \
of thumb: when peak memory matters more than wall-clock time \[Dash] often \
the case on a laptop or for very tall MERA stacks \[Dash] set ",
 "\"MemoryWeight\"",
 " ",
 "\[Rule]",
 " ",
 "1.0",
 " or above. When tensors are uniformly small but there are many of them, \
leave the default and accept that two adjacent tensors might briefly fuse \
into something fat. Greedy paths are also stable input for ",
 Cell[BoxData[
  ButtonBox["TensorNetworkContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContract"]], 
  "InlineFormula",ExpressionUUID->"022f49b8-b9f7-4dca-8530-a0efea5793e2"],
 ": none of the downstream execution machinery cares whether a path came from \
the greedy heuristic or the optimal planner, only that it satisfies ",
 Cell[BoxData[
  ButtonBox["CanonicalPathQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/CanonicalPathQ"]],
  "InlineFormula",ExpressionUUID->"3ab79a74-ffe3-4ecb-a9bd-599c41e03c0e"],
 "."
}], "Text",ExpressionUUID->"9ec6e58a-bca5-41eb-8f13-abe60a372853"],

Cell[CellGroupData[{

Cell["\<\
The \"MaxNeighbors\" option caps the size of the greedy beam \[Dash] the \
number of candidate contractions considered at each step. Lower values are \
faster but less optimal.\
\>", "Text",ExpressionUUID->"e849b479-221c-4ab7-8248-204c84687089"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GreedyContractionPath", "[", 
  RowBox[{"tn", ",", 
   RowBox[{"\"\<MaxNeighbors\>\"", "\[Rule]", "3"}]}], "]"}]], "Input",
 CellLabel->
  "In[162]:=",ExpressionUUID->"9deb3fbe-0ef4-40db-9bcb-2dfe0b7510ee"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9881161350008087`*^9, 3.988224813639256*^9},
 CellLabel->"Out[162]=",
 CellID->1866929110,ExpressionUUID->"62e07a74-9b28-4805-83ed-2736f3646b5d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The ",
 "\"PreSimplify\"",
 " option (default ",
 Cell[BoxData[
  ButtonBox["None",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/None"]], "InlineFormula",ExpressionUUID->
  "d1c7c61b-323b-47b0-bd2d-d036699d7899"],
 ") preprocesses the network \[Dash] fuses duplicate indices and removes \
trivial dimensions \[Dash] before the greedy search."
}], "Text",ExpressionUUID->"5077105c-6b92-477c-a943-5e8220917b7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GreedyContractionPath", "[", 
  RowBox[{"tn", ",", 
   RowBox[{"\"\<PreSimplify\>\"", "\[Rule]", "True"}]}], "]"}]], "Input",
 CellLabel->
  "In[163]:=",ExpressionUUID->"7ccc4d38-86b1-4dc3-8aeb-6d018a75231f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9881161350133123`*^9, 3.988224813659738*^9},
 CellLabel->"Out[163]=",
 CellID->593985453,ExpressionUUID->"53f380c7-595b-4b47-a8a9-1e5ccc97b616"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Different \"RandomSeed\" values explore different greedy paths; with non-zero \
\"Temperature\" this is a stochastic local search.\
\>", "Text",ExpressionUUID->"800d2ca0-563a-461a-8bb3-cdf4f90ee1b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GreedyContractionPath", "[", 
  RowBox[{"tn", ",", 
   RowBox[{"\"\<Temperature\>\"", "\[Rule]", "1.0"}], ",", 
   RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", "7"}]}], "]"}]], "Input",
 CellLabel->
  "In[164]:=",ExpressionUUID->"31e99e8e-2497-465b-a169-470d4ce63396"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988116135027717*^9, 3.988224813681238*^9},
 CellLabel->"Out[164]=",
 CellID->1609517315,ExpressionUUID->"47ab82ba-de63-43e8-b96c-db0ba1043235"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GreedyContractionPath", "[", 
  RowBox[{"tn", ",", 
   RowBox[{"\"\<Temperature\>\"", "\[Rule]", "1.0"}], ",", 
   RowBox[{"\"\<RandomSeed\>\"", "\[Rule]", "13"}]}], "]"}]], "Input",
 CellLabel->
  "In[165]:=",ExpressionUUID->"b9f36023-a546-49c6-ba17-696b49fc6cac"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
