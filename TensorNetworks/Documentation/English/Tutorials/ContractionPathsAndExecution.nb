    RowBox[{"{",
     RowBox[{
      RowBox[{"{",
       RowBox[{"1", ",", "2"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"2", ",", "3"}], "}"}], ",",
      RowBox[{"{",
       RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
