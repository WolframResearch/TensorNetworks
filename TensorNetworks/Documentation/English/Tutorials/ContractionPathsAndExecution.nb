Cell[CellGroupData[{

Cell["5. Visualizing the Contraction", "Section",ExpressionUUID->"8ec6506c-10cd-494e-8d61-e75f7ad23ec5"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetworkContraction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkContraction"]],
   "InlineFormula",ExpressionUUID->"2226162a-f410-4ad6-b539-a1c41470e978"],
 " composes a path with a network into a single nested ",
 "Inactive",
 " expression \[Dash] essentially an abstract syntax tree of the planned \
contraction, where every node is ",
 "Inactive[ArrayDot]",
 ", ",
 "Inactive[Transpose]",
 ", or another back-end primitive. ",
 Cell[BoxData[
  ButtonBox["ContractionTree",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ContractionTree"]], 
  "InlineFormula",ExpressionUUID->"a8079df4-0f8f-49ef-8cf7-5a0f13cbc852"],
 " converts that expression into a ",
 Cell[BoxData[
  ButtonBox["Tree",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Tree"]], "InlineFormula",ExpressionUUID->
  "f7ace820-d738-4e0f-aced-a8e8af44b35b"],
 " object suitable for graphical display:"
}], "Text",ExpressionUUID->"fdc48675-53ac-4ec0-91c5-c5262924bc28"],

