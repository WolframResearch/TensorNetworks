Cell[CellGroupData[{

Cell["\<\
The default labels are symbolic tensor names \[Dash] each node displays a \
placeholder T annotated with the dimensions it will carry. This view is \
useful when you care about which input tensor became which intermediate. To \
emphasize the dimension flow at every junction, set \"Labels\" to \
\"Dimensions\" instead. Each node then shows just its shape and the \
contracted axis count, making it easy to spot where intermediates balloon. \
The ratio between the largest dimension at any node and the dimensions of the \
leaves is a visual proxy for the path's peak-memory cost:\
\>", "Text",ExpressionUUID->"dd13bf6f-da40-4430-87d5-47a6e2ba0901"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ContractionTree", "[", 
  RowBox[{"expr", ",", 
   RowBox[{"\"\<Labels\>\"", "\[Rule]", "\"\<Dimensions\>\""}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[129]:=",ExpressionUUID->"06fb88a1-7ff0-4e54-a79a-89aff8f34e4c"],

