   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988116135106299*^9, 3.9882248137859364`*^9},
 CellLabel->"Out[169]=",
 CellID->1029937779,ExpressionUUID->"eff8157e-fcc7-446b-b343-42a7e3f2ea82"]
}, Open  ]],

