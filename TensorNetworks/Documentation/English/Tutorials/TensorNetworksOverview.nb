    RowBox[{"6", ",", "4", ",", "2"}], "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{3.988111726037343*^9},
 CellLabel->"In[18]:=",ExpressionUUID->"dc7b2fc2-b890-4f1a-99e0-9e6e167a2f09"],

