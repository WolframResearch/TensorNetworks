Cell[CellGroupData[{

Cell["2. Inspecting Structure", "Section",ExpressionUUID->"ced39290-b975-4a61-a0ab-14ba0a4272ce"],

Cell[CellGroupData[{

Cell["\<\
Networks support both functional accessors and a property-dispatch syntax. \
The keys \"FreeIndices\", \"Bonds\", and \"BinaryQ\" answer the three \
questions you ask first about any network: which indices remain after \
contraction, which pairs are joined and at what bond dimension, and whether \
every shared index touches exactly two tensors (the binary case, where the \
network reduces to a graph rather than a hypergraph).\
\>", "Text",ExpressionUUID->"241f04e7-edca-4a7d-8795-260d6c4bb721"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mps", "[", "\"\<FreeIndices\>\"", "]"}]], "Input",
 CellLabel->
  "In[121]:=",ExpressionUUID->"95200505-d06d-4309-85c2-b8b10b17e52d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"7", ",", "8", ",", "9", ",", "10", ",", "11", ",", "12"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.98811173052398*^9, 3.988112518597966*^9, 
  3.988116119809431*^9},
 CellLabel->"Out[121]=",
 CellID->2138772777,ExpressionUUID->"d4d1cd6b-92d1-4aff-b81a-b58c671cafb2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The six free indices are the dangling \"physical\" legs of the chain. The \
bond list spells out the contracted edges and their dimensions:\
\>", "Text",ExpressionUUID->"fa91ff9c-95c5-4220-8345-2bbb75125929"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mps", "[", "\"\<Bonds\>\"", "]"}]], "Input",
 CellLabel->
  "In[122]:=",ExpressionUUID->"e8ba6fe6-f5fc-4049-8f3d-8e44c6e4b8d7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"1", "1"},
       "Superscript"], ",", 
      TemplateBox[{"2", "1"},
       "Superscript"]}], "}"}], "\[Rule]", "4"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"2", "2"},
       "Superscript"], ",", 
      TemplateBox[{"3", "2"},
       "Superscript"]}], "}"}], "\[Rule]", "4"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"3", "3"},
       "Superscript"], ",", 
      TemplateBox[{"4", "3"},
       "Superscript"]}], "}"}], "\[Rule]", "4"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"4", "4"},
       "Superscript"], ",", 
      TemplateBox[{"5", "4"},
       "Superscript"]}], "}"}], "\[Rule]", "4"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"5", "5"},
       "Superscript"], ",", 
      TemplateBox[{"6", "5"},
       "Superscript"]}], "}"}], "\[Rule]", "4"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988111732983128*^9, 3.9881125207064533`*^9, 
  3.9881161198314133`*^9},
 CellLabel->"Out[122]=",
 CellID->1772779553,ExpressionUUID->"425bd929-1601-4cc8-9307-c010b317264e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Each key on the left is a pair of index slots written as Superscript[tensor, \
position]; the right side is the bond dimension. Five edges of dimension 4 \
\[Dash] one between every adjacent pair \[Dash] confirm the chain topology. \
Asking \"BinaryQ\" verifies that no index lives in three or more tensors:\
\>", "Text",ExpressionUUID->"aedc5b33-bcb4-4db2-beae-29c1a569bc4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mps", "[", "\"\<BinaryQ\>\"", "]"}]], "Input",
 CellLabel->
  "In[123]:=",ExpressionUUID->"c00487a8-a051-41db-b746-a30376518345"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988111735086721*^9, 3.98811252276863*^9, 
  3.988116119851149*^9},
 CellLabel->"Out[123]=",
 CellID->917828793,ExpressionUUID->"6b7fd68a-3977-47e8-8763-5dbec9393cb5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "For a single Association of every cached structural property, call ",
 Cell[BoxData[
  ButtonBox["TensorNetworkData",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkData"]], 
  "InlineFormula",ExpressionUUID->"5b6621a4-a5df-4f12-96fc-06f0fc6c1566"],
 " with no second argument:"
}], "Text",ExpressionUUID->"68edc206-9834-472a-aa19-600942e4f63e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "[", 
  RowBox[{"TensorNetworkData", "[", "mps", "]"}], "]"}]], "Input",
 CellLabel->
  "In[124]:=",ExpressionUUID->"63fc0ac4-90f5-4de7-92e5-caa3fb50d643"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Tensors\"\>", ",", "\<\"Dimensions\"\>", 
   ",", "\<\"Hyperedges\"\>", ",", "\<\"Indices\"\>", ",", "\<\"Vertices\"\>",
    ",", "\<\"Bonds\"\>", ",", "\<\"Contractions\"\>", 
   ",", "\<\"ContractionIndices\"\>", ",", "\<\"FreeIndices\"\>"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.98811173859799*^9, 3.988112526535253*^9, 
  3.988116119868408*^9},
 CellLabel->"Out[124]=",
 CellID->573487550,ExpressionUUID->"26e4a5e9-c49f-4fe6-adcd-7353322aa54e"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Finding a Contraction Path", "Section",ExpressionUUID->"802b4dc6-b3ed-4f96-99ee-c1eb5a531ef1"],

Cell[CellGroupData[{

Cell[TextData[{
 "The cost of contracting a network depends drastically on the order in which \
pairs are merged. A path is a list of pairs {i, j} using the ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"60d8c4f4-64b1-4d7d-8039-bfc5a1d2d45f"],
 " convention: at each step the tensors in positions i and j are contracted, \
both are removed, and the result is appended to the end of the list. ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"8c674d7e-901d-4fad-a2f1-72d6baadacdb"],
 " runs a full search; with Method \[Rule] \"flops\" it minimizes the total \
floating-point operation count rather than the default \"size\" objective:"
}], "Text",ExpressionUUID->"61620943-cebf-44d5-9312-c9dbe0cf0ba9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"path", "=", 
  RowBox[{"OptimalContractionPath", "[", 
   RowBox[{"mps", ",", 
    RowBox[{"Method", "\[Rule]", "\"\<flops\>\""}]}], "]"}]}]], "Input",
 CellLabel->
  "In[125]:=",ExpressionUUID->"32fce00c-9275-4f79-8f54-9b6336ffbca5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
