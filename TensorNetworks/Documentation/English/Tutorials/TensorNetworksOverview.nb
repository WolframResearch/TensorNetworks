Notebook[{

Cell[CellGroupData[{
Cell["Tensor Networks Overview", "Title",ExpressionUUID->"e8933101-1b5d-40a1-8851-0d2c7a41455c"],

Cell[CellGroupData[{

Cell[TextData[{
 "The Wolfram tensor-networks paclet represents networks as bundles of \
tensors with a list of hyperedges and computes contractions through a layered \
pipeline: constructors build a network, inspectors expose its index \
structure, transforms restructure it, path finders order the pairwise \
contractions, and an execution layer carries them out. This overview walks \
one running example ",
 Cell[BoxData[
  ButtonBox["RandomTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"1a24a71e-9bb2-4ddb-8ab1-640d20e379bd"],
 " through each tier so that the function names you will reach for in later \
tutorials sit on a single mental map."
}], "Text",ExpressionUUID->"b128839d-3845-4b65-8c56-4ca67de6d556"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Wolfram`TensorNetworks`\>\"", "]"}]], "Input",
 CellLabel->
  "In[111]:=",ExpressionUUID->"8d481c42-8d92-4bc8-a819-140b0ebc606c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Constructing a Network", "Section",ExpressionUUID->"fd0514e0-2fb9-43db-b94b-2974de180859"],

Cell[CellGroupData[{

Cell[TextData[{
 "The fundamental object is ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"6e740e18-efc8-4705-87ff-8c816e21313a"],
 "[",
 "tensors",
 ", ",
 "hyperedges",
 "], where ",
 "tensors",
 " is a list of numeric arrays and ",
 "hyperedges",
 " is a list of index lists, one per tensor. Each entry of a hyperedge is an \
integer label; labels that appear in two or more tensors are contracted \
indices, and labels that appear once are free. Here a rank-2, rank-3, and \
rank-2 tensor share four indices in a closed pattern with one free index:"
}], "Text",ExpressionUUID->"fff70fca-2f23-46a5-8cf3-25c987353d2e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t1", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t2", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t3", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"tn", "=", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t1", ",", "t2", ",", "t3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{3.988111702736768*^9},
 CellLabel->
  "In[112]:=",ExpressionUUID->"7a580f8a-1d16-4961-96ff-a83ffde0fdd9"],

