Cell[CellGroupData[{

Cell[TextData[{
 "A second, idiomatic constructor builds families with known topology. \
Calling ",
 Cell[BoxData[
  ButtonBox["RandomTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"30407f41-94c9-47f1-a302-db97c37d1e1c"],
 "[\"MPS\"[L, D, d]] returns a length-L matrix product state with bond \
dimension D and physical dimension d. The result is still a TensorNetwork \
expression \[Dash] no specialized MPS type \[Dash] so every tier below \
applies uniformly:"
}], "Text",ExpressionUUID->"7c7429cb-e886-4192-b90d-355cd0cc5873"],

