Cell[BoxData[
 RowBox[{"MPSCanonicalQ", "[", 
  RowBox[{"canon", ",", "\"\<Left\>\""}], "]"}]], "Input",
 CellChangeTimes->{3.988116394399743*^9},
 CellLabel->"In[211]:=",
 CellID->206146708,ExpressionUUID->"6d1c4269-7509-40df-b00e-78076df370af"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988116334662709*^9, 3.988224846949355*^9},
 CellLabel->"Out[211]=",
 CellID->1157899115,ExpressionUUID->"929f8d26-a051-43d0-9c29-ec9ea6802cf7"]
