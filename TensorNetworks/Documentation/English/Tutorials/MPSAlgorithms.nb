Cell[CellGroupData[{

Cell[TextData[{
 "The MPS routines in this paclet assume the open-boundary tensor layout used \
by ",
 Cell[BoxData[
  ButtonBox["RandomTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"89ac6343-281c-43a3-9497-dabc1c80b32f"],
 ": every bulk tensor is shaped ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"leftBond", ",", "rightBond", ",", "physical"}], "}"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8c119678-05f3-4d11-b335-5ae266f591f8"],
 " and each boundary tensor is shaped ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"bond", ",", "physical"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"785bef00-e941-4fae-9319-1c910f2f4e15"],
 ". Reading the tensor dimensions confirms this for the chain just built."
}], "Text",ExpressionUUID->"b8b5c637-28cb-4c2e-8519-53a06b2735a7"],

