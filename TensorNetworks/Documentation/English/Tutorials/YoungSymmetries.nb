Cell[TextData[{
 "The shape ",
 Cell[BoxData[
  ButtonBox["TableauShape",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauShape"]], 
  "InlineFormula",ExpressionUUID->"7492b816-9059-4bff-86cc-0e7e8eefcfa3"],
 ", total number of boxes ",
 Cell[BoxData[
  ButtonBox["TableauSize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauSize"]], 
  "InlineFormula",ExpressionUUID->"de9d957c-6ff3-4876-824f-4f70c2dff5e1"],
 ", and validity predicate ",
 Cell[BoxData[
  ButtonBox["YoungTableauQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungTableauQ"]], 
  "InlineFormula",ExpressionUUID->"205faf33-c19e-4dae-ba9f-6982a21f30ff"],
 " read off directly from the data structure."
}], "Text",ExpressionUUID->"e5ca909c-139c-4f26-bfcf-b17122673785"],

