Cell[CellGroupData[{

Cell["2. The Hook-Length Formula", "Section",ExpressionUUID->"65863ac8-ca26-4a14-a843-b13ccb5b4584"],

Cell[TextData[{
 "The hook of a cell ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cd8c075e-8cb2-469f-b464-f7c7f1f29f94"],
 " is the set of cells lying to its right in row ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "39c74a2d-59b6-4c35-ac36-56d9febb76bf"],
 " together with the cells below it in column ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0683dbca-9575-467d-887a-03657914b64f"],
 ", plus the cell itself. Frame and James' hook-length formula expresses the \
dimension of the corresponding ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "aaeafe46-ef96-4bda-95d1-08aa96d67f09"],
 " irrep as"
}], "Text",ExpressionUUID->"9f7fc0ef-b8e4-461c-a566-0d70e314147d"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["d", "\[Lambda]"], "=", 
   FractionBox[
    RowBox[{"n", "!"}], 
    RowBox[{
     UnderscriptBox["\[Product]", 
      RowBox[{"(", 
       RowBox[{"i", ",", "j"}], ")"}]], " ", 
     RowBox[{"h", "(", 
      RowBox[{"i", ",", "j"}], ")"}]}]]}], 
  TraditionalForm]],ExpressionUUID->"582c33a7-d493-4433-aaca-f9f72697558c"]], \
"Text",ExpressionUUID->"5ba1bec0-a31a-4710-a014-f0e25b1c4c0e"],

Cell[CellGroupData[{

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"585f35ed-228b-4b0c-bbe3-6a56f760f1ff"],
 " is the hook length at cell ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7b7b8a44-3e66-4705-bb50-476852e43e5b"],
 ". ",
 Cell[BoxData[
  ButtonBox["HookLengths",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookLengths"]], 
  "InlineFormula",ExpressionUUID->"03c40a5f-115d-40a0-9896-e4a3584a7220"],
 " returns all hook lengths arranged in the tableau shape, and ",
 Cell[BoxData[
  ButtonBox["HookLength",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookLength"]], 
  "InlineFormula",ExpressionUUID->"e302e93b-b0a1-4ef2-91a7-4c694d644e01"],
 " picks out a single cell."
}], "Text",ExpressionUUID->"92d1a007-5a2d-4ce2-8d87-fe63a16351d7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HookLengths", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"HookLength", "[", 
    RowBox[{"yt", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"60fb0492-533a-4b5c-b926-955543dae8e9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"4", ",", "3", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}]}], "}"}], ",", "4"}], "}"}]], "Output",
 CellChangeTimes->{3.9881165531902323`*^9, 3.9882248717049627`*^9, 
  3.988224942528051*^9, 3.988225097059032*^9},
 CellLabel->"Out[6]=",
 CellID->1217798699,ExpressionUUID->"9470c102-23cf-45ac-a0f4-b3f257cd686d"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Multiplying the hook lengths and dividing into ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "!"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "88d12e8b-e653-4d0f-ac1c-5b6603447d5c"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"5", "!"}], 
     RowBox[{
     "4", "\[CenterDot]", "3", "\[CenterDot]", "1", "\[CenterDot]", "2", "\[CenterDot]",
       "1"}]], "=", "5"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "66e3f538-f947-4c6d-9eac-2deb5e0f0aaa"],
 ", which is what ",
 Cell[BoxData[
  ButtonBox["TableauDimension",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TableauDimension"]], 
  "InlineFormula",ExpressionUUID->"d2d823cb-ea19-4beb-a8be-ef4154f38f9c"],
 " reports. Internally the paclet does not loop over the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "233d5438-8325-40f4-9639-6b0e23b94053"],
 " cells; it uses the Frobenius determinant form, which is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["r", "3"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"986f182a-d97a-4413-813a-be554d1959ee"],
 " in the number of rows ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c78aee9f-71ab-44c0-bad7-8f5ec63b1756"],
 " rather than ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["n", "2"], ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"00c49f53-cbb3-4efc-9793-874009f374bd"],
 " in the box count. The reciprocal of the hook product is exposed directly \
as ",
 Cell[BoxData[
  ButtonBox["HookFactor",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/HookFactor"]], 
  "InlineFormula",ExpressionUUID->"bbc8f849-c16e-44cc-9195-f42a7639a6ed"],
 ", with the identity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"TableauDimension", "[", "\[Lambda]", "]"}], "=", 
    RowBox[{
     RowBox[{"n", "!"}], "\[CenterDot]", 
     RowBox[{"HookFactor", "[", "\[Lambda]", "]"}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"af0596b6-c5b2-4734-bcf6-ca0ac25c7f5a"],
 "."
}], "Text",ExpressionUUID->"f7dbf215-9454-48e4-b0da-b67d46e92f37"],

Cell[CellGroupData[{

Cell[TextData[{
 "Two partition-level utilities round out the combinatorics. ",
 Cell[BoxData[
  ButtonBox["PartitionQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/PartitionQ"]], 
  "InlineFormula",ExpressionUUID->"0a884cf8-9ede-4541-a29f-7fb94868127b"],
 " tests whether a list of integers is a partition (positive and \
non-increasing), and ",
 Cell[BoxData[
  ButtonBox["TransposePartition",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TransposePartition"]], 
  "InlineFormula",ExpressionUUID->"76525f23-d254-446d-ad2e-01d9ab377a49"],
 " conjugates a Young diagram by swapping its rows and columns. The \
dimensions of conjugate partitions agree, since transposing a diagram turns \
the symmetrizer into the antisymmetrizer and vice versa."
}], "Text",ExpressionUUID->"5ac218f9-a432-4caa-9552-97ee166e8f0a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"TableauDimension", "[", "yt", "]"}], ",", 
   RowBox[{"HookFactor", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"PartitionQ", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2"}], "}"}], "]"}], ",", 
   RowBox[{"PartitionQ", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], "]"}], ",", 
   RowBox[{"TransposePartition", "[", 
    RowBox[{"{", 
     RowBox[{"4", ",", "2", ",", "1"}], "}"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"cd359a88-39b9-478d-9c3d-fe835f277858"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"5", ",", 
   FractionBox["1", "24"], ",", "True", ",", "False", ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "2", ",", "1", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988116553204385*^9, 3.9882248717261353`*^9, 
  3.9882249425522757`*^9, 3.988225097081612*^9},
 CellLabel->"Out[7]=",
 CellID->2023578183,ExpressionUUID->"f2d5948e-d9d8-46f2-bc02-c548891cc0d0"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Projecting Tensors", "Section",ExpressionUUID->"3ecb2362-9512-48ac-95c8-ef821a2d7800"],

Cell[TextData[{
 "The Young symmetrizer associated with a tableau ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9f15de2e-ddfe-412d-aca7-cb0df6d7656e"],
 " is the algebra element ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "T"], "=", 
    RowBox[{
     SubscriptBox["a", "T"], "\[CenterDot]", 
     SubscriptBox["b", "T"]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bacb868b-030d-4a3d-8b8e-9a8709638105"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["b", "T"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9a8b9f6a-626c-4c23-a28b-04686c9751ef"],
 " symmetrizes the slots in each row of ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2a8fe346-fa23-4ecb-a7b4-5f0696da2bc7"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["a", "T"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2279cc3e-923f-4538-8c42-ce7fff1dcdd0"],
 " antisymmetrizes the slots in each column. The paclet applies them in \
exactly that order \[Dash] rows first, then columns \[Dash] which is the \
order that leaves the final column antisymmetry intact. ",
 Cell[BoxData[
  ButtonBox["YoungSymmetrize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungSymmetrize"]], 
  "InlineFormula",ExpressionUUID->"85837e61-958b-4ea9-a3ec-c3f2ec03fda2"],
 " evaluates ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "T"], "[", "T", "]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f74e92bc-c4a3-4329-946a-9efbe1d28924"],
 " on a tensor whose rank equals the tableau size."
}], "Text",ExpressionUUID->"e07e6b86-bc0f-45ed-be0b-fa7195446775"],

Cell[TextData[{
 "The unnormalized symmetrizer satisfies ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["c", "T"], "2"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"n", "!"}], 
      SubscriptBox["d", "\[Lambda]"]], 
     SubscriptBox["c", "T"]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f23eef91-116f-4d36-9ffc-3c485f633bb9"],
 ", so the genuine projector onto the irrep is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "T"], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["d", "\[Lambda]"], 
      RowBox[{"n", "!"}]], 
     SubscriptBox["c", "T"]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bf282087-3c4b-4b8e-a0d9-b01d08b85260"],
 ". This is what ",
 Cell[BoxData[
  ButtonBox["YoungProject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/YoungProject"]], 
  "InlineFormula",ExpressionUUID->"e9ca16c6-66b7-41b2-9091-3d5fd091c3ad"],
 " applies, with the normalization chosen so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["P", "2"], "=", "P"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"83464b35-d9b6-49fe-9b5f-09f3471dac0f"],
 "."
}], "Text",ExpressionUUID->"ab8680b1-1453-4c80-8ae5-4ba8b866c0c3"],

Cell[CellGroupData[{

Cell[TextData[{
 "The rank-2 case is the most familiar sanity check: shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "2", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f94afe23-225a-4d9a-9faa-8a16e240da7f"],
 " projects onto the symmetric part ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"T", "+", 
      SuperscriptBox["T", "\[Transpose]"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a134b6d5-3c98-48e9-b0a4-50ea61ee5ab4"],
 ", and shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8b73f999-43a9-4724-b326-37651d63f3fe"],
 " onto the antisymmetric part ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"T", "-", 
      SuperscriptBox["T", "\[Transpose]"]}], ")"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ce4a50ce-a0f8-450c-b931-e7b8e1c245da"],
 ". A symbolic ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9afbb76e-c73d-4ac1-9688-28c113849028"],
 " tensor confirms both."
}], "Text",ExpressionUUID->"3a41d4d0-e4c4-42f4-ba92-ea77d7f77266"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"T", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "b"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "d"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"YoungProject", "[", 
    RowBox[{"T", ",", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", "2", "}"}], "]"}]}], "]"}], ",", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"T", ",", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "]"}]}], "]"}]}], "}"}]}], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"08c93413-74c6-4ca4-a02d-6131f50eccf9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", 
       FractionBox[
        RowBox[{"b", "+", "c"}], "2"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        RowBox[{"b", "+", "c"}], "2"], ",", "d"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox[
        RowBox[{"b", "-", "c"}], "2"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "b"}], "+", "c"}], ")"}]}], ",", "0"}], "}"}]}], 
    "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988116553219853*^9, 3.9882248717440567`*^9, 
  3.9882249425714006`*^9, 3.9882250971089163`*^9},
 CellLabel->"Out[9]=",
 CellID->580004142,ExpressionUUID->"e379d33b-bdde-4ed2-ab49-6040aca10f22"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "At rank three the new feature is the mixed-symmetry irrep ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"cc8c2869-1b7c-4c4f-9f6b-bb9fe7dc6eb7"],
 ", whose representation is two-dimensional. A rank-3 tensor decomposes into \
the symmetric piece (shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "3", "}"}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ab7d1f0a-75a7-40a5-b3c3-47db2a157a44"],
 ", dimension 1), the antisymmetric piece (shape ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1"}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"325846f5-e1a5-4beb-a28c-5a5ff3962e22"],
 ", dimension 1), and two copies of the mixed irrep (one for each standard \
filling of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ceba75ae-58c7-4802-b94d-e2bce918c19b"],
 ", giving total dimension 2). Projecting twice with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"YoungProject", "[", 
    RowBox[{"\[CenterEllipsis]", ",", 
     RowBox[{"YoungTableau", "[", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "]"}]}], "]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"27541e34-6585-4e0c-8e56-7989a7c70c5b"],
 " should be the same as projecting once."
}], "Text",ExpressionUUID->"efdf7283-4284-4080-a182-12abeff1f2d1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R", "=", 
   RowBox[{"Round", "[", 
    RowBox[{
     RowBox[{"10", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"1", ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "]"}]}], ",", "0.01"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"yt21", "=", 
   RowBox[{"YoungTableau", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"P1", "=", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"R", ",", "yt21"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"P2", "=", 
   RowBox[{"YoungProject", "[", 
    RowBox[{"P1", ",", "yt21"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{"P1", "-", "P2"}], "]"}], "]"}], "]"}]}], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"ccfa7da8-b074-4303-ace5-6f1217348705"],

Cell[BoxData["0.`"], "Output",
 CellChangeTimes->{3.98811655323376*^9, 3.988224871766306*^9, 
  3.988224942597088*^9, 3.988225097131706*^9},
 CellLabel->"Out[15]=",
 CellID->701340861,ExpressionUUID->"0812d08e-de80-4aec-9862-c584ae7ff71a"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The residual is numerically zero, confirming ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["P", "2"], "=", "P"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f398f6c3-2745-4e8e-b4ea-29318cf20f19"],
 ". Combining the projectors for all shapes of a given size recovers the \
original tensor, which is the statement that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "n"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "32a7aec0-e0ed-41a3-a625-cb3084db6b92"],
 " acts completely reducibly on rank-",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1f0b64d4-af4d-4943-b295-3cacb4431352"],
 " tensors. The combinatorial bookkeeping that controls when each shape \
contributes \[Dash] tableau dimensions and hook lengths \[Dash] is exactly \
what the earlier sections compute."
}], "Text",ExpressionUUID->"1ee606e0-1fd1-460d-8ced-eb6fab872f6a"]
}, Open  ]],

