Cell[CellGroupData[{

Cell["3.8. Random networks on arbitrary graphs", "Subsection",ExpressionUUID->"5ef117a3-a59a-4495-8c8a-c0175c3a9d9d"],

Cell[TextData[{
 "Outside the named topology families, ",
 Cell[BoxData[
  ButtonBox["RandomTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"baa50dbf-0fea-4046-b6bf-8ac3b24ab574"],
 " accepts any ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "7d99c975-e325-4fdd-9979-2f88907d0f67"],
 " object (anything satisfying ",
 Cell[BoxData[
  ButtonBox["GraphQ",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/GraphQ"]], "InlineFormula",ExpressionUUID->
  "1d73db45-d6f7-441e-8b66-39a2e9c9e890"],
 "), or an ",
 StyleBox["{n, m}", "Code"],
 " shortcut that expands to ",
 StyleBox["RandomGraph[{n, m}]", "Code"],
 ". Each graph vertex becomes a tensor; each graph edge becomes a contracted \
bond. The dimension argument has three forms, and an optional third argument \
controls how many additional free legs each vertex carries beyond its graph \
degree."
}], "Text",ExpressionUUID->"1b3db914-83c5-4a47-8609-2e06e5d59869"],

Cell[TextData[{
 "Three forms are available:\n  \[Bullet] ",
 StyleBox["RandomTensorNetwork[g, maxDim]", "Code"],
 " \[LongDash] each index gets an independent random dimension in ",
 StyleBox["{2, maxDim}", "Code"],
 ".\n  \[Bullet] ",
 StyleBox["RandomTensorNetwork[g, {fixedDim}]", "Code"],
 " \[LongDash] every index has the same dimension ",
 StyleBox["fixedDim", "Code"],
 ".\n  \[Bullet] ",
 StyleBox["RandomTensorNetwork[g, dimSpec, additionalRank]", "Code"],
 " \[LongDash] each vertex's rank is sampled from ",
 StyleBox["{VertexDegree[v], VertexDegree[v] + additionalRank}", "Code"],
 ", and the extra legs become free indices."
}], "Text",ExpressionUUID->"02717d01-8149-4b9d-ad79-204c6b7af678"],

Cell[TextData[{
 "The ",
 StyleBox["Method -> \"Complex\"", "Code"],
 " option draws the tensor entries from a complex distribution rather than \
the default real one. This is the standard form used to generate inputs for \
contraction-path benchmarks \[LongDash] see ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"1c7a471f-c6a5-46b8-bdf3-f99a82d7cc3a"],
 " and ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"d0a4c57b-23dd-4778-b575-b611cf6c29f0"],
 "."
}], "Text",ExpressionUUID->"cdbb9390-3037-4b7f-b41f-8f11ad4c5e89"],

Cell[CellGroupData[{

Cell["A 5-vertex, 8-edge random graph with dimensions up to 3:", "Text",ExpressionUUID->"3462b31e-7e2f-423f-8f5f-6f8fc5e4f305"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";", " ", 
  RowBox[{"tnA", "=", 
   RowBox[{"RandomTensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"5", ",", "8"}], "}"}], ",", "3"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"960e32e3-d1d4-445d-95bf-26c46c8a8233"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tnA", "[", "\"\<Size\>\"", "]"}]], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"c4333aa7-07ea-4d98-b8ad-41e92bc408a7"],

Cell[BoxData["5"], "Output",
 CellChangeTimes->{3.988065095924055*^9},
 CellLabel->"Out[41]=",
 CellID->314638032,ExpressionUUID->"5c25be13-1f47-4e71-b055-16c634b07d3c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Fixed dimension 2 on every index:", "Text",ExpressionUUID->"2cc98e20-eb7b-4bf4-9a1c-c23dd96e66b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tnB", "=", 
   RowBox[{"RandomTensorNetwork", "[", 
    RowBox[{
     RowBox[{"RandomGraph", "[", 
      RowBox[{"{", 
       RowBox[{"6", ",", "10"}], "}"}], "]"}], ",", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"aad7252e-d860-41e8-9739-5cb382dfc2fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", "@", 
  RowBox[{"Catenate", "@", 
   RowBox[{"tnB", "[", "\"\<Dimensions\>\"", "]"}]}]}]], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"dd791612-c2a2-4e74-8bad-ece5b8cfa3cf"],

Cell[BoxData[
 RowBox[{"{", "2", "}"}]], "Output",
 CellChangeTimes->{3.9880650959530888`*^9},
 CellLabel->"Out[43]=",
 CellID->1016664910,ExpressionUUID->"f60f7e5b-28a3-4efc-8bd1-b4116648527c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Adding ",
 StyleBox["additionalRank -> 2", "Code"],
 " gives each vertex between ",
 StyleBox["VertexDegree[v]", "Code"],
 " and ",
 StyleBox["VertexDegree[v] + 2", "Code"],
 " legs; the surplus become free indices, useful when generating networks \
with prescribed free-leg counts:"
}], "Text",ExpressionUUID->"1b9663d7-0a96-405c-bcb7-aa72449704b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tnC", "=", 
   RowBox[{"RandomTensorNetwork", "[", 
    RowBox[{
     RowBox[{"RandomGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", "6"}], "}"}], "]"}], ",", "3", ",", "2"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"8329bb2e-3aff-4560-847d-af820c33a06d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tnC", "[", "\"\<FreeIndices\>\"", "]"}]], "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"c8d87c33-95ba-46e5-abd4-94899b25ff04"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "5", ",", "7", ",", "11", ",", "12", ",", "16", ",", "18"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.988065095981142*^9},
 CellLabel->"Out[45]=",
 CellID->1707246838,ExpressionUUID->"05dc05c8-4e6b-4b8b-87d6-663f6d7151fb"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Property dispatch", "Section",ExpressionUUID->"deb86ef1-8283-44db-92c9-35c99abf390d"],

Cell[CellGroupData[{

Cell[TextData[{
 "Every property of a network is reached through the same dispatch syntax: ",
 StyleBox["tn[\"PropertyName\"]", "Code"],
 ". This keeps the surface API small \[LongDash] there is no separate ",
 StyleBox["TensorNetworkXyz", "Code"],
 " accessor function for each field. The same property names appear inside \
the full data association returned by ",
 Cell[BoxData[
  ButtonBox["TensorNetworkData",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkData"]], 
  "InlineFormula",ExpressionUUID->"5b65da28-091f-4d33-b601-0a5f6b7efca9"],
 ", so you can either pick off one field at a time or grab everything in one \
call. The dispatch is implemented as a downvalue on the ",
 Cell[BoxData[
  ButtonBox["TensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"474114b4-e190-4d14-bcbd-6696c196f52d"],
 " head and is therefore extensible from outside the paclet if you need to \
attach your own derived quantities."
}], "Text",ExpressionUUID->"1e67e0c8-f75a-4bec-9215-91cf962395c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tnD", "=", 
  RowBox[{"RandomTensorNetwork", "[", 
   RowBox[{"\"\<MPS\>\"", "[", 
    RowBox[{"3", ",", "2", ",", "2"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"13305de4-326d-43df-9dec-1ccce5c1790e"],

