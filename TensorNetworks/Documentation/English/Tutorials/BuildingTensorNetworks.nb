Cell[CellGroupData[{

Cell["6.2. Renaming indices on the graph form", "Subsection",ExpressionUUID->"873f60f4-77ee-4056-a959-73542fff0055"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetworkReplaceIndices",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/TensorNetworks/ref/TensorNetworkReplaceIndices"]], 
  "InlineFormula",ExpressionUUID->"ed6bbf76-bf99-4baf-aa0f-06e24b080615"],
 " renames legs. It operates on the ",
 Cell[BoxData[
  ButtonBox["ToTensorNetworkGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]], 
  "InlineFormula",ExpressionUUID->"29633d0a-4177-4e32-83b8-2edd50cde06a"],
 " form, which carries typed indices as vertex annotations \[LongDash] a leg \
of tensor ",
 StyleBox["i", "Code"],
 " bearing label ",
 StyleBox["k", "Code"],
 " is stored as ",
 Cell[BoxData[
  SuperscriptBox["i", "k"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "befe56fc-8a5d-4bf5-a19f-d2d67d491fd6"],
 ". The replacement rules are applied at vertex annotation level, so you pass \
rules whose left-hand sides are the typed index forms returned by ",
 StyleBox["tn[\"Indices\"]", "Code"],
 ". Below, both legs of tensor 1 are renamed to string labels."
}], "Text",
 CellChangeTimes->{{3.9880597298344803`*^9, 
  3.988059730943039*^9}},ExpressionUUID->"5acf8374-b012-4ed8-9f34-\
f8ad557ef9c6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"g0", "=", 
   RowBox[{"ToTensorNetworkGraph", "[", "base", "]"}]}], ";", " ", 
  RowBox[{"g1", "=", 
   RowBox[{"TensorNetworkReplaceIndices", "[", 
    RowBox[{"g0", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        TemplateBox[{"1", "1"},
         "Superscript"], "\[Rule]", "\"\<a\>\""}], ",", 
       RowBox[{
        TemplateBox[{"1", "2"},
         "Superscript"], "\[Rule]", "\"\<b\>\""}]}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.988059742548987*^9, 3.988059745128824*^9}},
 CellLabel->
  "In[144]:=",ExpressionUUID->"115d8262-d022-4263-b1d0-091dc3da481e"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2}, {{{1, 2}}, Null, {{"b", 
         Subscript[2, 1]}}}, {AnnotationRules -> {2 -> {"Index" -> {
             Subscript[2, 1], 
             Subscript[2, 2]}}, 1 -> {"Index" -> {"a", "b"}}}}]]}, 
    TagBox[
     GraphicsGroupBox[
      GraphicsComplexBox[{{1., 0.}, {0., 1.2246467991473532`*^-16}}, {
        {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[
         Medium], ArrowBox[{1, 2}, 0.01273]}, 
        {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
         DiskBox[1, 0.01273], DiskBox[2, 0.01273]}}]],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None]], "Output",
 CellChangeTimes->{{3.988059719590069*^9, 3.9880597459363956`*^9}, 
