Cell[CellGroupData[{

Cell[TextData[{
 "Adding ",
 StyleBox["additionalRank -> 2", "Code"],
 " gives each vertex between ",
 StyleBox["VertexDegree[v]", "Code"],
 " and ",
 StyleBox["VertexDegree[v] + 2", "Code"],
 " legs; the surplus become free indices, useful when generating networks \
with prescribed free-leg counts:"
}], "Text",ExpressionUUID->"1b9663d7-0a96-405c-bcb7-aa72449704b4"],

