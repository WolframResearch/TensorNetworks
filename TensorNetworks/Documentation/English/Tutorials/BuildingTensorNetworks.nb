Cell[CellGroupData[{

Cell[TextData[{
 "The default free-index order would have been ",
 StyleBox["{1, 3}", "Code"],
 ". Applying the cycle ",
 StyleBox["(1 2)", "Code"],
 " swaps the two positions, giving ",
 StyleBox["{3, 1}", "Code"],
 "."
}], "Text",ExpressionUUID->"593e7c40-450c-4082-a16b-8f505e975530"],

