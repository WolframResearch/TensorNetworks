Cell[CellGroupData[{

Cell["3.3. Matrix product operators", "Subsection",ExpressionUUID->"861d4b66-dcf2-4b6f-94b0-7e4ef8c6539f"],

Cell[CellGroupData[{

Cell[TextData[{
 "A matrix product operator (",
 StyleBox["\"MPO\"", "Code"],
 ") doubles the physical legs \[LongDash] one ket-side and one bra-side per \
site, so that the object represents an operator rather than a state. Each \
interior tensor has rank 4 (two bond legs plus two physical legs); each \
boundary tensor has rank 3. The free-index list interleaves the ket and bra \
indices in pairs."
}], "Text",ExpressionUUID->"f92da148-4175-42a9-913f-d3fcab88b895"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mpo", "=", 
  RowBox[{"RandomTensorNetwork", "[", 
   RowBox[{"\"\<MPO\>\"", "[", 
    RowBox[{"4", ",", "2", ",", "2"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"ed501f4a-6be4-445e-a8af-7119a0c5ae32"],

