Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorNetworkData",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkData"]], 
  "InlineFormula",ExpressionUUID->"1de57c73-2f1f-43f2-a302-a41feb4e0ed1"],
 " gives back the full underlying association in one call. Use it for \
serialization, for writing functions that walk every field at once, or when \
you want to grab several properties without paying the dispatch overhead per \
access."
}], "Text",ExpressionUUID->"27ad748f-b4de-44a4-8def-720f9369a1c4"],

