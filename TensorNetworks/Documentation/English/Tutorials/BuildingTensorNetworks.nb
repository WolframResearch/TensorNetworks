  NamespaceBox["Hypergraph",
   DynamicModuleBox[{Typeset`hg = HoldComplete[
     WolframInstitute`Hypergraph`Hypergraph[{1, 2, 3}, 
      WolframInstitute`Hypergraph`Hyperedges[{1, 2}, {2, 3}], 
      VertexLabels -> {All -> Automatic}, 
      EdgeLabels -> {{1, 2} -> 1, {2, 3} -> 2}, 
      EdgeStyle -> {{1, 2} -> RGBColor[0.368417, 0.506779, 0.709798], {2, 3} -> 
