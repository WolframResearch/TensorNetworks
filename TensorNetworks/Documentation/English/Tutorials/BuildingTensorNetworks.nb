Cell[CellGroupData[{

Cell["3.8. Random networks on arbitrary graphs", "Subsection",ExpressionUUID->"5ef117a3-a59a-4495-8c8a-c0175c3a9d9d"],

Cell[TextData[{
 "Outside the named topology families, ",
 Cell[BoxData[
  ButtonBox["RandomTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/RandomTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"baa50dbf-0fea-4046-b6bf-8ac3b24ab574"],
 " accepts any ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "7d99c975-e325-4fdd-9979-2f88907d0f67"],
 " object (anything satisfying ",
 Cell[BoxData[
  ButtonBox["GraphQ",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/GraphQ"]], "InlineFormula",ExpressionUUID->
  "1d73db45-d6f7-441e-8b66-39a2e9c9e890"],
 "), or an ",
 StyleBox["{n, m}", "Code"],
 " shortcut that expands to ",
 StyleBox["RandomGraph[{n, m}]", "Code"],
 ". Each graph vertex becomes a tensor; each graph edge becomes a contracted \
bond. The dimension argument has three forms, and an optional third argument \
controls how many additional free legs each vertex carries beyond its graph \
degree."
}], "Text",ExpressionUUID->"1b3db914-83c5-4a47-8609-2e06e5d59869"],

Cell[TextData[{
 "Three forms are available:\n  \[Bullet] ",
 StyleBox["RandomTensorNetwork[g, maxDim]", "Code"],
 " \[LongDash] each index gets an independent random dimension in ",
 StyleBox["{2, maxDim}", "Code"],
 ".\n  \[Bullet] ",
 StyleBox["RandomTensorNetwork[g, {fixedDim}]", "Code"],
 " \[LongDash] every index has the same dimension ",
 StyleBox["fixedDim", "Code"],
 ".\n  \[Bullet] ",
 StyleBox["RandomTensorNetwork[g, dimSpec, additionalRank]", "Code"],
 " \[LongDash] each vertex's rank is sampled from ",
 StyleBox["{VertexDegree[v], VertexDegree[v] + additionalRank}", "Code"],
 ", and the extra legs become free indices."
}], "Text",ExpressionUUID->"02717d01-8149-4b9d-ad79-204c6b7af678"],

Cell[TextData[{
 "The ",
 StyleBox["Method -> \"Complex\"", "Code"],
 " option draws the tensor entries from a complex distribution rather than \
the default real one. This is the standard form used to generate inputs for \
contraction-path benchmarks \[LongDash] see ",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"1c7a471f-c6a5-46b8-bdf3-f99a82d7cc3a"],
 " and ",
 Cell[BoxData[
  ButtonBox["OptimalContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/OptimalContractionPath"]], 
  "InlineFormula",ExpressionUUID->"d0a4c57b-23dd-4778-b575-b611cf6c29f0"],
 "."
}], "Text",ExpressionUUID->"cdbb9390-3037-4b7f-b41f-8f11ad4c5e89"],

Cell[CellGroupData[{

Cell["A 5-vertex, 8-edge random graph with dimensions up to 3:", "Text",ExpressionUUID->"3462b31e-7e2f-423f-8f5f-6f8fc5e4f305"],

Cell[CellGroupData[{

