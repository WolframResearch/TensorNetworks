Cell[CellGroupData[{

Cell[TextData[{
 "Enumerate every property the dispatch knows about with ",
 StyleBox["tn[\"Properties\"]", "Code"],
 ". The list includes both the raw fields and several derived views (",
 StyleBox["\"Hypergraph\"", "Code"],
 ", ",
 StyleBox["\"Vertices\"", "Code"],
 ", ",
 StyleBox["\"Ranks\"", "Code"],
 "). Use this as a discoverability handle when exploring a new network."
}], "Text",ExpressionUUID->"fd12614e-6f29-4e3a-b986-94a685772f7a"],

