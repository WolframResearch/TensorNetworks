   3.98811554983928*^9, 3.988224790113521*^9},
 CellLabel->"Out[144]=",
 CellID->1333210004,ExpressionUUID->"0d78bb76-17f0-4924-871d-c93aa9da9a2e"]
}, Open  ]],

