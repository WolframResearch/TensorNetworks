Cell[CellGroupData[{

Cell["2.3. Inactive TensorContract expression", "Subsection",ExpressionUUID->"ca22a094-badb-4709-b3a5-8de365cdb0c8"],

Cell[CellGroupData[{

Cell[TextData[{
 "Form 3: lift an unevaluated ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorContract"]], 
  "InlineFormula",ExpressionUUID->"da7671b9-a8dc-45b2-a963-f9c434368aa4"],
 " expression. The contraction is written in the native ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorProduct"]], 
  "InlineFormula",ExpressionUUID->"6a8a0195-7464-4b5f-a287-53a2b09dc0c5"],
 " / ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorContract"]], 
  "InlineFormula",ExpressionUUID->"8fcc7bc4-92f8-4cf1-8d0b-0f2feb766fd7"],
 " notation Wolfram Language uses for higher-rank tensor algebra; the ",
 Cell[BoxData[
  ButtonBox["Inactive",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/Inactive"]], 
  "InlineFormula",ExpressionUUID->"f91e8216-9772-49d6-bea8-7e766d4e5b91"],
 " wrapper keeps it from evaluating eagerly. This is the natural bridge from \
a mathematical description of a contraction into network form \[LongDash] the \
inactive expression carries enough information to recover both the tensors \
and the contracted axis pairs, and the constructor reads it directly."
}], "Text",ExpressionUUID->"3cd2ee4d-fe3f-4e45-80ac-008da45a20f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn3", "=", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{"Inactive", "[", "TensorContract", "]"}], "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Inactive", "[", "TensorProduct", "]"}], "[", 
      RowBox[{"A", ",", "B"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.988058970171792*^9, 3.988058972721015*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"7a45682c-ec72-4e24-8273-fae580eb426c"],

