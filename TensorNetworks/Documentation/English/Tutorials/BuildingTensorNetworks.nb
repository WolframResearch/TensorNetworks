Cell[CellGroupData[{

Cell[TextData[{
 "The arrow notation ",
 StyleBox["1 -> 2", "Code"],
 " in the new hyperedge list denotes the rewritten leg name: it reads as \
\"the copy of the old index 2 that hangs off tensor 1.\" Each original tensor \
keeps one of these distinguished names instead of the shared label, and the \
new delta tensor connects them all. The naming is a record of where the \
spider came from."
}], "Text",ExpressionUUID->"2c366b73-20cc-4c38-84c9-9f01267b6a71"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bin", "[", "\"\<Hyperedges\>\"", "]"}]], "Input",
 CellLabel->
  "In[137]:=",ExpressionUUID->"d026ba28-27f3-47ce-9970-0825e6f06029"],

