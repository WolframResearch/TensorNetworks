Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["\"FreeIndices\"", "Code"],
 " names the open legs \[LongDash] the indices that survive the contraction. ",
 StyleBox["\"Dimensions\"", "Code"],
 " returns one list per tensor giving the size of each of its legs, parallel \
to the hyperedge list. Together these are enough to predict the shape of the \
contracted result without actually running the contraction."
}], "Text",ExpressionUUID->"0943eec4-52e0-414a-bf48-aaa73a72d09a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"tnD", "[", "\"\<FreeIndices\>\"", "]"}], ",", 
   RowBox[{"tnD", "[", "\"\<Dimensions\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[121]:=",ExpressionUUID->"fadbd9bf-b245-4eb5-ac4f-0d80fbb4148a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "5", ",", "6"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988059648876478*^9, 3.988065096085835*^9, 
  3.9881126535900717`*^9, 3.988113454697947*^9, 3.9881155492032633`*^9, 
