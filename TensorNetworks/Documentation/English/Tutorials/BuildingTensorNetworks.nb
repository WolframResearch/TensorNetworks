   RowBox[{"{", 
    RowBox[{"1", ",", 
     RowBox[{"1", "\[Rule]", "2"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", "\[Rule]", "2"}], ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"3", "\[Rule]", "2"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "2"}], ",", 
     RowBox[{"2", "\[Rule]", "2"}], ",", 
     RowBox[{"3", "\[Rule]", "2"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988059700340703*^9, 3.988065096429495*^9, 
  3.988112653889989*^9, 3.988113455043161*^9, 3.988115549542274*^9},
