Cell[CellGroupData[{

Cell["2.7. Round-trip from an annotated graph", "Subsection",ExpressionUUID->"7a689b41-5902-4fa3-b838-06ca6ed6386b"],

Cell[CellGroupData[{

Cell[TextData[{
 "The constructor also accepts an annotated ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Graph"]], "InlineFormula",ExpressionUUID->
  "e1ecba05-2f09-4e20-a85b-a57a7e4d69c9"],
 " whose vertices carry tensors and indices as annotations \[LongDash] in \
other words, anything satisfying ",
 Cell[BoxData[
  ButtonBox["TensorNetworkGraphQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkGraphQ"]], 
  "InlineFormula",ExpressionUUID->"8c316be5-b0a2-483b-a232-ad6d376db63f"],
 ". This is the inverse of ",
 Cell[BoxData[
  ButtonBox["ToTensorNetworkGraph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ToTensorNetworkGraph"]], 
  "InlineFormula",ExpressionUUID->"69d68f1b-80c9-4df9-83e2-9240da3ee7d0"],
 ": starting from a flat ",
 StyleBox["TensorNetwork[\[Ellipsis]]", "Code"],
 ", round-tripping through the graph form and back recovers a flat object \
with the same tensors and the same contraction pattern. The integer index \
labels are replaced by structured ",
 StyleBox["Superscript", "Code"],
 "/",
 StyleBox["Subscript", "Code"],
 " labels that record edge direction, but the underlying bond pattern is \
unchanged."
}], "Text",ExpressionUUID->"709dbc4c-9771-4741-afcc-2baaee4cdd0b"],

