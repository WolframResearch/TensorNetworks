Cell[CellGroupData[{

Cell["4.1. Function form vs property form", "Subsection",ExpressionUUID->"dbe8317a-8d16-4b95-98fb-fffe6a446122"],

Cell[TextData[{
 "For every key dispatched through ",
 StyleBox["tn[\"Key\"]", "Code"],
 " there is a standalone function with the same name. Both forms return \
identical results and share an implementation \[LongDash] the property form \
just forwards to the function. Pick whichever reads cleaner at the call site: \
the property form is concise when the network is already in hand; the \
function form composes naturally with ",
 StyleBox["Map", "Code"],
 ", ",
 StyleBox["@*", "Code"],
 ", and other higher-order operators."
}], "Text",ExpressionUUID->"aa19977d-27b8-43c1-93da-de0e1368c734"],

