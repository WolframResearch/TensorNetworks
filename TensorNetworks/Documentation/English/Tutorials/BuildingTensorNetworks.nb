Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["BinaryTensorNetworkQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/BinaryTensorNetworkQ"]], 
  "InlineFormula",ExpressionUUID->"a05baf9e-8327-406c-ac8a-270632994d12"],
 " confirms the network is not binary: the label 2 appears in three tensors, \
so at least one index occurs more than twice. Any network that hits this case \
will be rejected by purely pairwise path-search code unless it is \
preprocessed."
}], "Text",ExpressionUUID->"37d177b9-ce2a-4f3a-ac1b-53ac44bbb90d"],

