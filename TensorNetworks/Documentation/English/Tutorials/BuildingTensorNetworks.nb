Cell[CellGroupData[{

Cell["2.2. Einsum-style with explicit output", "Subsection",ExpressionUUID->"612aab25-3f91-4fec-875a-0b4039793d34"],

Cell[CellGroupData[{

Cell[TextData[{
 "Form 2: einsum-style with an explicit ",
 StyleBox["hyperedges -> output", "Code"],
 " rule. The right-hand side lists which indices survive as free legs after \
contraction. Setting it equal to the indices that appear once recovers ",
 StyleBox["Automatic", "Code"],
 " behavior; setting it to ",
 StyleBox["{}", "Code"],
 " contracts the network to a scalar (a tensor trace); setting it to a \
permutation of the auto-free list reorders the output axes. This is the form \
most directly cognate with einsum strings in NumPy or with ITensor's \
index-naming conventions."
}], "Text",ExpressionUUID->"961eeb65-8f5b-4bce-a327-fde4bc5374a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn2", "=", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"A", ",", "B"}], "}"}], ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"257bd51d-af82-46f9-a942-1e146f5e0c84"],

