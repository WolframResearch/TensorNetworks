Cell[CellGroupData[{

Cell["3.6. MERA", "Subsection",ExpressionUUID->"c0164d22-24f2-4bca-94e9-d31d8cdd16dc"],

Cell[CellGroupData[{

Cell[TextData[{
 "The multi-scale entanglement renormalization ansatz (",
 StyleBox["\"MERA\"", "Code"],
 ") adds horizontal disentanglers between layers of a tree, giving the \
network a characteristic causal-cone structure that captures critical scaling \
well. Specify ",
 StyleBox["width", "Code"],
 " (number of physical sites), bond dimension, and ",
 StyleBox["layers", "Code"],
 " (renormalization depth)."
}], "Text",ExpressionUUID->"5e067b59-c9b2-46aa-8868-677787a62b86"],

