}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["\"Indices\"", "Code"],
 " returns a typed view: each leg becomes a ",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/Superscript"]], 
  "InlineFormula",ExpressionUUID->"340211f7-6d46-460d-ac08-f9ed7be1cc46"],
 " carrying both its tensor identifier and its hyperedge label, of the form \
",
 StyleBox["Superscript[tensor, edge]", "Code"],
 ". This is the form that downstream graph-level operations like ",
 Cell[BoxData[
  ButtonBox["TensorNetworkReplaceIndices",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/TensorNetworks/ref/TensorNetworkReplaceIndices"]], 
  "InlineFormula",ExpressionUUID->"f2317b37-8fcf-4a93-ae39-e4a84b5f6289"],
 " consume \[LongDash] the typed wrapper disambiguates which copy of a shared \
label you mean when the same integer appears as a leg of more than one tensor."
}], "Text",ExpressionUUID->"c344b11a-ad47-4e23-acde-823bf0ea1cbf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tnD", "[", "\"\<Indices\>\"", "]"}]], "Input",
 CellLabel->
  "In[122]:=",ExpressionUUID->"bf5be72e-946c-4c5b-bbe8-89bc0da4343f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1"},
      "Superscript"], ",", 
     TemplateBox[{"1", "4"},
      "Superscript"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"2", "1"},
      "Superscript"], ",", 
     TemplateBox[{"2", "2"},
      "Superscript"], ",", 
     TemplateBox[{"2", "5"},
      "Superscript"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"3", "2"},
      "Superscript"], ",", 
     TemplateBox[{"3", "6"},
      "Superscript"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988059651074628*^9, 3.988065096100556*^9, 
  3.988112653605667*^9, 3.98811345471143*^9, 3.9881155492164707`*^9, 
  3.9882247893265333`*^9},
 CellLabel->"Out[122]=",
 CellID->1603286218,ExpressionUUID->"46f2b629-27ca-4da6-b2a0-4a91af708f92"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["\"Bonds\"", "Code"],
 " enumerates the contracted edges and the dimension each one carries. Each \
bond is reported as a rule from a pair of typed indices to a dimension, which \
makes it easy to scan a network and sanity-check that adjacent tensors agree \
on the dimensions of shared legs before contraction. A mismatch in this \
output is always the cause of a downstream evaluation error."
}], "Text",ExpressionUUID->"1a95f450-ace8-4cd5-a003-7fce6e2d8318"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tnD", "[", "\"\<Bonds\>\"", "]"}]], "Input",
 CellLabel->
  "In[123]:=",ExpressionUUID->"dec19fd1-5eff-42c0-a255-a488380a4312"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"1", "1"},
       "Superscript"], ",", 
      TemplateBox[{"2", "1"},
       "Superscript"]}], "}"}], "\[Rule]", "2"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"2", "2"},
       "Superscript"], ",", 
      TemplateBox[{"3", "2"},
       "Superscript"]}], "}"}], "\[Rule]", "2"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9880596525927973`*^9, 3.988065096120929*^9, 
  3.9881126536206617`*^9, 3.988113454727008*^9, 3.9881155492383213`*^9, 
  3.988224789349956*^9},
 CellLabel->"Out[123]=",
 CellID->1954147017,ExpressionUUID->"94ecb1af-6a55-40ce-992b-b9acd845d45a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Two boolean flags summarize the network's structural state. ",
 StyleBox["\"BinaryQ\"", "Code"],
 " is ",
 StyleBox["True", "Code"],
 " when every index appears in at most two tensors \[LongDash] i.e. the \
network is a pure (multi)graph, not a true hypergraph. ",
 StyleBox["\"SparseQ\"", "Code"],
 " reports whether every tensor is a ",
 Cell[BoxData[
  ButtonBox["SparseArray",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/SparseArray"]], 
  "InlineFormula",ExpressionUUID->"f6d0f795-e870-4f30-b6dd-3625b4492660"],
 ". These two predicates control which fast paths the contraction engine can \
take: binary networks can be fed directly into a pairwise path search, and \
sparse networks use ",
 Cell[BoxData[
  ButtonBox["SparseArray",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/SparseArray"]], 
  "InlineFormula",ExpressionUUID->"53a587d3-70e1-4a7e-bbca-e0e4ee13963c"],
 "-aware tensor algebra throughout."
}], "Text",ExpressionUUID->"5d8d3ce5-c003-40c3-a5bb-f33d8e40dcfb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"tnD", "[", "\"\<BinaryQ\>\"", "]"}], ",", 
   RowBox[{"tnD", "[", "\"\<SparseQ\>\"", "]"}]}], "}"}]], "Input",
 CellLabel->
  "In[124]:=",ExpressionUUID->"66824eb3-3d6b-4c9b-a755-3ea62345fdfa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False"}], "}"}]], "Output",
 CellChangeTimes->{3.988059654875848*^9, 3.988065096137038*^9, 
  3.988112653634899*^9, 3.988113454743697*^9, 3.9881155492529097`*^9, 
  3.988224789370173*^9},
 CellLabel->"Out[124]=",
 CellID->1881501148,ExpressionUUID->"ddb68fe1-fbcd-401f-9ee6-29f4e8c6d497"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["\"Graph\"", "Code"],
 " returns the network as a ",
 Cell[BoxData[
  ButtonBox["Graph",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/Graph"]], "InlineFormula",
  ExpressionUUID->"5926cbaf-aab9-4053-9b09-29f560497110"],
 " object \[LongDash] tensors and bond-spiders as vertices, leg connections \
as directed edges. It is the form used by visualization, path-search, and \
structural-edit code paths. The graph is bipartite in spirit (tensor vertices \
vs. spider vertices), with edges directed from the spider toward each \
connected tensor leg."
}], "Text",ExpressionUUID->"e749ef09-d1b3-4360-861d-5b0486828cc3"],

Cell[CellGroupData[{

