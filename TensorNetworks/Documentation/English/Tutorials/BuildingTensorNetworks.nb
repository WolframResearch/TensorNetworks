Cell[CellGroupData[{

Cell["\<\
Symbolic tensor networks with contractions slots, final output and a specific \
glorbal-index dimensions:\
\>", "Text",
 CellChangeTimes->{{3.988059213339336*^9, 3.988059227879794*^9}},
 CellID->805742636,ExpressionUUID->"2218043d-44fb-4d55-99c0-e4436b7510d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn5", "=", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}]}], ",", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"1", "->", "2"}], ",", 
      RowBox[{"2", "->", "5"}], ",", 
