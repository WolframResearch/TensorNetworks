      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], "}"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"7ca694e8-890c-4dbb-9900-8dcbcf7b8097"],

