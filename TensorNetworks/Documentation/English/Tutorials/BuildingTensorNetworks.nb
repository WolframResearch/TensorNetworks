Cell[CellGroupData[{

Cell["6.3. Sparse storage", "Subsection",ExpressionUUID->"8debc7ab-cd71-4052-8c2b-491493efe2ff"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SparseTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/SparseTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"0214e9f7-9c55-469b-9249-c105c72e6094"],
 " converts every tensor in the network to ",
 Cell[BoxData[
  ButtonBox["SparseArray",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/SparseArray"]], 
  "InlineFormula",ExpressionUUID->"c4162d19-9a49-4f3b-9574-be00c63fc4d0"],
 " form. The hypergraph and indices are preserved exactly; only the storage \
representation of the tensor entries changes. This is useful before \
evaluating contractions on highly sparse or structured tensors \[LongDash] \
the contraction engine has fast paths for ",
 Cell[BoxData[
  ButtonBox["SparseArray",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/SparseArray"]], 
  "InlineFormula",ExpressionUUID->"f943b4ad-01c4-45a8-b4f9-283c29210afa"],
 " inputs that avoid materializing dense intermediates."
}], "Text",ExpressionUUID->"ac445e45-3b6f-4407-af65-88bb824ac93e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sparseTN", "=", 
  RowBox[{"SparseTensorNetwork", "[", "base", "]"}]}]], "Input",
 CellLabel->
  "In[146]:=",ExpressionUUID->"d9a33530-9dcb-4a99-a390-e5c87106adc0"],

