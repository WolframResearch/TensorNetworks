     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"T2", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"1", ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"T3", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"1", ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "5"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[60]:=",ExpressionUUID->"9467c6d3-4835-42fd-b4e6-f98ed3cae9a6"],

