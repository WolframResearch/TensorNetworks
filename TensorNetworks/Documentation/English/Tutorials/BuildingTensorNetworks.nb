           "Superscript"]}], "}"}], ",", 
        TemplateBox[{"2", 
          SubscriptBox["2", "2"]},
         "Superscript"]}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"ContractionIndices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        TemplateBox[{"1", "1"},
         "Superscript"], ",", 
        TemplateBox[{"1", "2"},
         "Superscript"]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        TemplateBox[{"1", "2"},
         "Superscript"], ",", 
        SubscriptBox["2", "2"]}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"FreeIndices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
