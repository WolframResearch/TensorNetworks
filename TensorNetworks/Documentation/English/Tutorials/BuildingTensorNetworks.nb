Cell[CellGroupData[{

Cell["3.7. Boundary and field options", "Subsection",ExpressionUUID->"115f4a3e-43bb-4c9c-a470-010e300e3584"],

Cell[CellGroupData[{

Cell[TextData[{
 "Chain families accept the boundary option ",
 StyleBox["\"Boundary\" -> \"Open\"", "Code"],
 " (default \[LongDash] the leftmost and rightmost sites have rank 2) or ",
 StyleBox["\"Periodic\"", "Code"],
 " \[LongDash] the latter wraps the last site back to the first, adding one \
extra hyperedge and making every site interior-shaped. All families accept ",
 StyleBox["Method -> \"Complex\"", "Code"],
 " to populate tensors with complex Gaussian entries instead of real ones; \
the underlying distribution becomes the standard complex normal, and \
downstream contractions remain complex throughout."
}], "Text",ExpressionUUID->"714dfbbd-543f-4dc4-a6d2-ff0ea137fa9f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mpsP", "=", 
  RowBox[{"RandomTensorNetwork", "[", 
   RowBox[{
    RowBox[{"\"\<MPS\>\"", "[", 
     RowBox[{"4", ",", "2", ",", "2"}], "]"}], ",", 
    RowBox[{"\"\<Boundary\>\"", "\[Rule]", "\"\<Periodic\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"f8625eb3-1473-4475-bf8e-ccd3ed49d4be"],

