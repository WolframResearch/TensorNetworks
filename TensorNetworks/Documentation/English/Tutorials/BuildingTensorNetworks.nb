Cell[CellGroupData[{

Cell["2.4. Symbolic skeleton from hypergraph", "Subsection",ExpressionUUID->"04513f1f-2647-4cfe-9fb6-eaac41ccc126"],

Cell[TextData[{
 "Form 4: build a symbolic skeleton from the hypergraph alone. The first \
argument is the hyperedge list (optionally with an output spec); the second \
is an association mapping each leg label to its dimension. Tensors are filled \
in with ",
 Cell[BoxData[
  ButtonBox["ArraySymbol",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ArraySymbol"]], 
  "InlineFormula",ExpressionUUID->"fd3d5b92-04cd-4f26-8ffd-091af41babbd"],
 " of the correct shape, all bearing the same formal symbol so they are \
clearly placeholders. Use this when the hypergraph topology is fixed but the \
entries are not \[LongDash] for symbolic manipulations, scaling analyses, or \
as a template that ",
 Cell[BoxData[
  ButtonBox["InitializeTensorNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/InitializeTensorNetwork"]], 
  "InlineFormula",ExpressionUUID->"b2f5bfdd-1e1c-4514-8450-0ba0c6f10416"],
 " can later populate with real values."
}], "Text",ExpressionUUID->"e12fbbc1-3f99-48a7-a67c-ce4aa797ba66"],

