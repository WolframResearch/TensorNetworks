       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[66]:=",ExpressionUUID->"1db20ad0-ec71-47ac-9acc-2909d5445ded"],

