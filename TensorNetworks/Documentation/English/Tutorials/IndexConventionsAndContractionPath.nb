Cell[TextData[{
 "In this drawing the vertices are the indices ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], ",", 
   StyleBox["j", "TI"], ",", 
   StyleBox["k", "TI"], ",", 
   StyleBox["l", "TI"], ",", 
   StyleBox["m", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "187adc3d-3961-76c2-4819-d667b8145c28"],
 " and each edge is a tensor, spanning the indices it carries: ",
 Cell[BoxData["t1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "641c78eb-7f03-7846-0c24-71b57ab64aac"],
 " over ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["i", "TI"]}], ",", 
   RowBox[{
    StyleBox["j", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bfcc75d-c21d-6fb0-0983-df06f7a8359a"],
 ", ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "112ae6ec-4b5c-6ad2-4729-ffb66ee93838"],
 " over ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["j", "TI"]}], ",", 
   StyleBox["k", "TI"], ",", 
   RowBox[{
    StyleBox["l", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6121b9de-dddd-aca8-10de-309bd469f6f2"],
 ", ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30209679-023a-ee91-61df-0823b7ccb4fb"],
 " over ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["k", "TI"]}], ",", 
   StyleBox["l", "TI"], ",", 
   RowBox[{
    StyleBox["m", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29bc1606-c22d-409d-5f43-8863f7d812e7"],
 ". An index that lies on two tensors is a contracted bond, that is, a vertex \
shared by two edges: ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bf1e1bf-5b3e-c64b-298e-f8f95ec8ac91"],
 " joins ",
 Cell[BoxData["t1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3119d855-3ffd-7401-6726-d21fb9885f6b"],
 " and ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a6d1b5-4e36-fa69-125d-c8ff6bc0c8b3"],
 ", while ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c41cdc9-5ab3-1ef5-247e-e4935f4664df"],
 " and ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51fce014-dca1-0630-0783-fa51d5546d1a"],
 " both join ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657c1c65-980e-511d-1303-964f19bb2067"],
 " and ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f15dbd5-5f35-596c-352a-d29f5ac02bb6"],
 " (the doubled bond). An index on a single tensor is free, a vertex in just \
one edge: ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e9b7e66-629a-1114-26b9-7040172f607e"],
 " on ",
 Cell[BoxData["t1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "585a51e6-774f-2dd2-087a-48c002fa7738"],
 " and ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7c0b5b-c40c-ea6a-4b03-a304edbeb8b0"],
 " on ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370294fd-9e49-2d35-5d31-0da71bfc741f"],
 ". This is the same split that the contractions listing gave, now visible at \
a glance. Note it is the dual of the usual tensor-network diagram, where \
tensors are nodes and indices are lines; here the two roles are swapped."
}], "Text",
 CellID->1113655915,ExpressionUUID->"2845529c-454d-b13b-587b-4bc66cf90001"],

Cell[TextData[{
 StyleBox["Global slots.",
  FontWeight->"Bold"],
 " Contraction flattens the operands into one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorProduct"]], "paclet:ref/TensorProduct"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7519012f-e657-215b-2326-988893e273a1"],
 ", and a global index is a ",
 StyleBox["slot position", "TI"],
 " in that flattened product. Lower the ",
 Cell[BoxData["EinsteinSummation"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "594776df-9e75-d16a-0f7d-6f991b01a3b0"],
 " spec to see those slots:"
}], "Text",
 CellID->1606118752,ExpressionUUID->"6405505f-4b92-3bd6-0c3b-4a196e24893c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{"\"\<ij,jkl,klm->im\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[8]:= ",
 CellID->98218265,ExpressionUUID->"6878c7f8-419e-9db5-1807-dea27028e79f"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"TensorContract"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[TensorContract]"], "[", 
  RowBox[{
   RowBox[{
    TemplateBox[{"\"t1\"", "2", "2", "3"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    TemplateBox[{"\"t2\"", "3", "3", "4", "5"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    TemplateBox[{"\"t3\"", "3", "4", "5", "2"},
     "ArraySymbol2"]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "7"}], "}"}]}], "}"}]}], "]"}]], "Output",
 CellLabel->"Out[8]= ",
 CellID->941128874,ExpressionUUID->"48a3d607-c312-9dd3-7850-c860f6a4e739"]
}, Open  ]],

Cell[TextData[{
 "The output is an inactive ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorContract"]], "paclet:ref/TensorContract"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "539491e8-328f-8d7b-01ab-08b2473bd441"],
 " of the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorProduct"]], "paclet:ref/TensorProduct"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7fcf59b5-a5ca-2155-25f5-50fecc7f73bf"],
 " with contraction pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"4", ",", "6"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"5", ",", "7"}], "}"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "023f49e2-a747-9723-33c5-60cfd2f3fa09"],
 ". The integers are slot positions in the flattened ",
 Cell[BoxData[
  RowBox[{"TensorProduct", "[", 
   RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21aa1c49-e16c-f406-57a9-9612901edf6c"],
 ". To see the slots explicitly, flatten the data labels:"
}], "Text",
 CellID->339082558,ExpressionUUID->"289b85cd-827f-9a9c-58b8-1c97370be8e6"],

Cell[CellGroupData[{

