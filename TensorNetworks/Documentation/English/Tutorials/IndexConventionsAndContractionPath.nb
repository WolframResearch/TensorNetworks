Cell[TextData[{
 "The result lists the eight legs in order, and the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cfa2c34-ef50-7d46-5499-c6718ae547ac"],
 "-th element is global slot ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "362a4e41-4988-041f-5e2a-602b683d6f65"],
 ": its base is the tensor, its superscript the ",
 Cell[BoxData["EinsteinSummation"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01ed6b92-5a5f-fa78-3792-82dc5febc942"],
 " label. So ",
 Cell[BoxData["t1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "107fa29c-d013-1000-4004-3bd9e1a6636a"],
 " owns slots 1-2, ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6798df62-4cc7-e4e1-0da7-d74c6573cecb"],
 " owns 3-5, ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "49f5450b-e8d1-97dd-7f8b-5d548965fd27"],
 " owns 6-8, and the lowering reads: sum slot 2 with 3 (the two ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2570a8a5-7a6f-59e7-530f-410f7f1a2bcd"],
 "'s), 4 with 6 (",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b990c23-b656-01a6-39a6-a58cc3e3538c"],
 "), 5 with 7 (",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "52243646-2fbd-210e-03db-a8204a487054"],
 "). The free slots 1 (",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1acd7f4d-3da3-7753-4af3-7717b4565db9"],
 ") and 8 (",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "062d91f0-6326-41c0-2fd2-08ba16d3132a"],
 ") survive in slot order ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ac7f74a-ce09-be58-4afc-ef17ebbd04a2"],
 ", which is the order we requested, so there is no trailing transpose. \
Output order is its own convention: free legs survive tensor-then-leg, and \
requesting a different order would append a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Transpose"]], "paclet:ref/Transpose"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6f6ad260-8ee1-565a-1569-d44a2a943ca0"],
 "."
}], "Text",
 CellID->443736588,ExpressionUUID->"612fd791-c81e-86f2-10d4-cedae9a8ecd8"],

Cell["\<\
2. The contraction-path convention: pairwise steps over operands\
\>", "Section",
 CellID->1593449978,ExpressionUUID->"26dca2d1-2715-746d-4ee3-3b9b52a05eb7"],

Cell[TextData[{
 "Contraction happens pairwise and in sequence. A path is a list of steps; \
each step picks two tensors from the ",
 StyleBox["current", "TI"],
 " pool, sums over every leg they share, and puts the resulting tensor back \
in the pool for the later steps. The path numbers ",
 StyleBox["operands", "TI"],
 ", not legs: it says which two tensors meet at each step, and the legs that \
get summed are simply whatever those two share. The final value does not \
depend on the order, but the order is what the executor walks, and it fixes \
which indices are summed when."
}], "Text",
 CellID->1742646261,ExpressionUUID->"296a77cd-8fa3-dd44-5f6a-6e972a57a7ae"],

Cell["Rebuild the running network for this section:", "Text",
 CellID->29467524,ExpressionUUID->"6b853673-18d0-d9fa-19ba-a83d996aabc0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"t1", " ", "=", " ", 
   RowBox[{"ArraySymbol", "[", 
    RowBox[{"\"\<t1\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"t2", " ", "=", " ", 
   RowBox[{"ArraySymbol", "[", 
    RowBox[{"\"\<t2\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"t3", " ", "=", " ", 
   RowBox[{"ArraySymbol", "[", 
    RowBox[{"\"\<t3\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "5", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tn", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "}"}], " ", "->",
       " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "5"}], "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[10]:= ",
 CellID->1939141443,ExpressionUUID->"25b5b884-ef74-61b3-534a-31e18a013399"],

Cell["Get a contraction path for the tensor network and keep it:", "Text",
 CellID->5047578,ExpressionUUID->"574a2197-51ef-7938-7d49-b8d1679a4802"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"path", " ", "=", " ", 
  RowBox[{"GreedyContractionPath", "[", "tn", "]"}]}]], "Input",
 CellLabel->"In[11]:= ",
 CellID->1683074990,ExpressionUUID->"6e85e9ed-427b-8528-16ba-00b7770fec72"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[11]= ",
 CellID->2083312163,ExpressionUUID->"73b76025-96bb-3fff-214d-798f234f85c5"]
}, Open  ]],

Cell[TextData[{
 "The result ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31f4c073-8ff6-126f-678b-da3d298360b5"],
 " is two steps over the three operands ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ff7667-e560-b2c0-2285-68408c1a002a"],
 ". Step 1's ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "3"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c9be80e-0554-61c1-24b8-0268ace1332b"],
 " contracts operands 2 and 3 (",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106b7ad8-6378-599b-4069-7382160d2be1"],
 ", ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e6f7c7a-fa8f-2da1-2615-7627ff3a778b"],
 "); their result re-enters the pool, now ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"t1", ",", " ", "t2t3"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "304452a4-201b-d64c-607c-4b0e51afbc96"],
 ", so step 2's ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6beff1f8-c64a-83a6-1994-e8a5f3fcd18c"],
 " means ",
 Cell[BoxData["t1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b5b9263-9199-4e16-7978-144d202c157c"],
 " and ",
 Cell[BoxData["t2t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "475d7054-346c-a3cc-6d63-6a1ebd1ef116"],
 ". Operand numbers are reused because after each contraction the two inputs \
are replaced by their single result. (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GreedyContractionPath"]], 
    "paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath", 
    "Wolfram/TensorNetworks Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ef71510-aa09-eca9-568c-8d5dcfbdb6f3"],
 " is one of several functions that compute such a path; they differ in the \
cost of the path they return, not in any index convention, so we just use \
one.)"
}], "Text",
 CellID->1892712309,ExpressionUUID->"3343f580-98d5-e31c-6170-ecea1961ce66"],

Cell["\<\
The path is an abstract recipe; the executor turns it into an explicit nest \
of pairwise contractions. Build that expression, left inactive so we can read \
the plan:\
\>", "Text",
 CellID->787969749,ExpressionUUID->"20a7420b-376a-b23f-505d-6455421c0105"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ic", " ", "=", " ", 
  RowBox[{"TensorNetworkContraction", "[", 
   RowBox[{"tn", ",", " ", "path"}], "]"}]}]], "Input",
 CellLabel->"In[12]:= ",
 CellID->360188390,ExpressionUUID->"6af863a9-1098-c609-1a98-7af3a112ad53"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"ArrayDot"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[ArrayDot]"], "[", 
  RowBox[{
   TemplateBox[{"\"t1\"", "2", "2", "3"},
    "ArraySymbol2"], ",", 
   RowBox[{
    TemplateBox[{"ArrayDot"},
     "InactiveHead",
     BaseStyle->"Inactive",
     SyntaxForm->"Symbol",
     Tooltip->"Inactive[ArrayDot]"], "[", 
    RowBox[{
     TemplateBox[{"\"t2\"", "3", "3", "4", "5"},
      "ArraySymbol2"], ",", 
     TemplateBox[{"\"t3\"", "3", "4", "5", "2"},
      "ArraySymbol2"], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}], "}"}]}], "]"}]], "Output",
 CellLabel->"Out[12]= ",
 CellID->614617602,ExpressionUUID->"055bc2ad-6b92-a3be-3378-dbf70e24f184"]
}, Open  ]],

Cell[TextData[{
 "The output is ",
 Cell[BoxData[
  RowBox[{"ArrayDot", "[", 
   RowBox[{"t1", ",", " ", 
    RowBox[{"ArrayDot", "[", 
     RowBox[{"t2", ",", " ", "t3", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b0fb60e-2211-365f-5934-286857a59ca5"],
 " (inactive), read inside-out. The inner ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ArrayDot"]], "paclet:ref/ArrayDot"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "201a2509-bdd9-2fa1-5039-bd53346c758b"],
 " is step 1: contract ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7085d256-6adc-aa08-20ba-d4100f6ef952"],
 " and ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f932952-49a5-d34f-05a0-c11c6851a195"],
 " over their two shared legs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ",", 
   StyleBox["l", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "160f17c4-d31a-fe19-3e34-8ea1e6acc563"],
 " (the operand-local axis pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2"}], "}"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10beb8bd-bdb6-ee93-4045-31e73440b4f9"],
 " of section 3). The outer ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ArrayDot"]], "paclet:ref/ArrayDot"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3fdc991b-fead-14b0-65e3-1144fb587e9a"],
 " is step 2: contract ",
 Cell[BoxData["t1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3657d2c5-05c0-ac85-5e6c-cbafac7af6ef"],
 " with that intermediate over their shared ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0642d375-09f3-9942-2e71-cb3faf87eba8"],
 ". The nesting ",
 StyleBox["is", "TI"],
 " the order, and each node carries the axes summed at that step."
}], "Text",
 CellID->357930410,ExpressionUUID->"0651775d-2bad-791b-2e6f-6f074e584861"],

Cell["\<\
The same thing is clearer as a tree. Render the contraction hierarchy with \
dimension labels:\
\>", "Text",
 CellID->1802489801,ExpressionUUID->"63b9e3d6-2298-231e-1146-fa9057128e64"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ContractionTree", "[", 
  RowBox[{"ic", ",", " ", 
   RowBox[{"\"\<Labels\>\"", " ", "->", " ", "\"\<Dimensions\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[13]:= ",
 CellID->800886605,ExpressionUUID->"67c13665-f813-2f11-0dfe-a84ef9a6727b"],

