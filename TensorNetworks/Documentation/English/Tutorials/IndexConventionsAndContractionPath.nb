   RowBox[{"\"\<Labels\>\"", " ", "->", " ", "\"\<Dimensions\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"c9c12fc7-565e-40f4-8d81-4bd29f4ce4ea"],

