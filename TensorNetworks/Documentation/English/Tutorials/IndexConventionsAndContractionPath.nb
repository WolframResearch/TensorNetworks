Cell[TextData[{
 "The tensor network is binary: every index sits on at most two tensors, so \
every contraction is an ordinary pair of tensors. The doubled bond between ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "957025c8-75fb-4860-8016-755163b29cb3"],
 " and ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "e1f917ed-44c0-4d96-b0eb-15b396323096"],
 " makes the multi-axis ",
 Cell[BoxData[
 "ArrayDot"], "InlineFormula",ExpressionUUID->
  "2690fedc-20cf-4521-a1a4-25c883c4ac1e"],
 " case concrete, and the rank-3 tensors make the ",
 Cell[BoxData[
 "TensorContract"], "InlineFormula",ExpressionUUID->
  "cebef260-a6d8-4318-ae6b-2956ee9870fe"],
 " blocks nontrivial. As an ",
 Cell[BoxData[
 "EinsteinSummation"], "InlineFormula",ExpressionUUID->
  "5c541139-5ddb-4f1f-8ed9-b6d48909cabc"],
 " string the same network is ",
 Cell[BoxData["\"\<ij,jkl,klm->im\>\""], "InlineFormula",ExpressionUUID->
  "cf7a3e9b-1083-46aa-809e-18dd94ab89f6"],
 ". The three-or-more case is the subject of the last section."
}], "Text",ExpressionUUID->"b1b1fa2e-b005-4485-8119-7d0b4e806733"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
1. Reading the legs: EinsteinSummation, data labels, global slots\
\>", "Section",ExpressionUUID->"93c45ddc-6c4b-4c03-b6ae-75861778cd73"],

Cell[TextData[{
 "Three of the four leg conventions give a leg a fixed identity, independent \
of any contraction; we read them off the tensor network here. The fourth, the \
",
 Cell[BoxData[
 "ArrayDot"], "InlineFormula",ExpressionUUID->
  "556e145f-a4ee-404f-aaea-217f0152f26d"],
 " operand-local axes, comes with the contraction in section 3."
}], "Text",ExpressionUUID->"0266d2b8-4105-4fc3-b7e7-cd014372fe20"],

Cell[TextData[{
 StyleBox["EinsteinSummation labels.",
  FontWeight->"Bold"],
 " A label is an abstract name. A label that appears on two tensors is \
contracted; a label that appears once is free; the part after ",
 Cell[BoxData["->"], "InlineFormula",ExpressionUUID->
  "9e7af234-bd0f-4604-9129-491255883551"],
 " fixes the output order. That is the entire convention, and ",
 Cell[BoxData["\"\<ij,jkl,klm->im\>\""], "InlineFormula",ExpressionUUID->
  "03765f03-41a4-4252-aed3-b2933095b747"],
 " already encodes it: ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "642e5e3c-6173-49bd-9bc5-d3dfdde01f2e"],
 ", ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "3d4de1e6-723b-4a34-8743-a8340ed71fff"],
 ", ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "22798197-cd48-494d-81c3-b7caebeba894"],
 " repeat (contracted), ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "c2723d8c-5e45-4331-96bb-677f45f0e768"],
 ", ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",ExpressionUUID->
  "a3dba04f-062e-4e76-a8d2-7b6ce833def0"],
 " appear once (free), and the output is the two free legs."
}], "Text",ExpressionUUID->"2488bc0d-be31-43f4-a402-4c1b2f5003e2"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Data labels.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  ButtonBox["TensorNetworkData",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/TensorNetworkData"]], 
  "InlineFormula",ExpressionUUID->"01dc7dad-6e74-459b-a185-76f33a4a2c2c"],
 " is the low-level form the rest of the kernel consumes. It tags every leg \
with its tensor position and its label (a ",
 Cell[BoxData[
  ButtonBox["Superscript",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Superscript"]], "InlineFormula",ExpressionUUID->
  "de9f9ef1-493c-4077-908f-4dd19bf01a2a"],
 " of position over label), so a leg is addressable by ",
 StyleBox["which tensor", "TI"],
 " and ",
 StyleBox["which label", "TI"],
 ". List the per-leg labels:"
}], "Text",ExpressionUUID->"c1074f21-2ccc-4b13-bdf9-2d7fe7f3cbce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", "[", "\"\<Indices\>\"", "]"}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"132896e2-0b27-4a6b-a2b0-375decb11642"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1"},
      "Superscript"], ",", 
     TemplateBox[{"1", "2"},
      "Superscript"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"2", "2"},
      "Superscript"], ",", 
     TemplateBox[{"2", "3"},
      "Superscript"], ",", 
     TemplateBox[{"2", "4"},
      "Superscript"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"3", "3"},
      "Superscript"], ",", 
     TemplateBox[{"3", "4"},
      "Superscript"], ",", 
     TemplateBox[{"3", "5"},
      "Superscript"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9896759309909077`*^9},
 CellLabel->"Out[9]=",
 CellID->63917456,ExpressionUUID->"e201cf6d-1b20-41fe-9213-12bc84337f01"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Each entry is one leg, tagged by tensor position (the base) and ",
 Cell[BoxData[
 "EinsteinSummation"], "InlineFormula",ExpressionUUID->
  "028bf1f0-3edc-45c2-a02e-f5c694776441"],
 " label (the superscript); the position-2, label-4 entry, for instance, is \
tensor 2's ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "e171cbaf-b5bd-4335-b536-f9f1f6927c34"],
 "-leg. Read off the bonds:"
}], "Text",ExpressionUUID->"cdb6eed7-5e00-4824-aaf5-c19952be368d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", "[", "\"\<Bonds\>\"", "]"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"ada07aee-b50d-468c-b9dc-35f5ad7e37e9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"1", "2"},
       "Superscript"], ",", 
      TemplateBox[{"2", "2"},
       "Superscript"]}], "}"}], "\[Rule]", "3"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"2", "3"},
       "Superscript"], ",", 
      TemplateBox[{"3", "3"},
       "Superscript"]}], "}"}], "\[Rule]", "4"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"2", "4"},
       "Superscript"], ",", 
      TemplateBox[{"3", "4"},
       "Superscript"]}], "}"}], "\[Rule]", "5"}]}], "}"}]], "Output",
 CellChangeTimes->{3.989675939305326*^9},
 CellLabel->"Out[10]=",
 CellID->2007396545,ExpressionUUID->"39642ab0-f23d-4cbf-96f6-84ba5071d27a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "This gives the three bond groups with their dimensions: the ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "ad9bd17d-b947-4766-b830-26abbbd8acf1"],
 "-bond has dimension 3, the ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "d72dbd29-8fdf-4b94-9de1-efa8d48a737d"],
 "-bond dimension 4, and the ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "ea9abdda-38ae-4cbd-8f40-45590f7f75c9"],
 "-bond dimension 5. Each bond pairs the two legs that share a label and \
records the dimension summed over it. Now the free legs, the labels that \
appear on only one tensor:"
}], "Text",ExpressionUUID->"44936d64-4a5d-4ace-82f1-b26b876d28d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", "[", "\"\<FreeIndices\>\"", "]"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"d371e434-1d50-46d2-a541-c1ac101a903f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "5"}], "}"}]], "Output",
 CellChangeTimes->{3.989675941446896*^9},
 CellLabel->"Out[11]=",
 CellID->339133874,ExpressionUUID->"19e4e5c1-9cfa-46c0-831f-688cdd67e512"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "5"}], "}"}]], "InlineFormula",ExpressionUUID->
  "70396594-bdb8-4726-9bcb-d47e2bfbe54a"],
 ", the free labels ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["m", "TI"]}]], "InlineFormula",ExpressionUUID->
  "9ecb3d0e-d9eb-45e5-809a-ce130c8ae481"],
 " in the requested output order. Now tag every leg as either a bond group or \
a bare free label:"
}], "Text",ExpressionUUID->"c9917d14-f61e-4437-8ab3-6dd491c3e73f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", "[", "\"\<Contractions\>\"", "]"}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"f5319748-1357-42b2-8c31-aa995a6e0882"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1"},
      "Superscript"], ",", 
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"1", "2"},
        "Superscript"], ",", 
       TemplateBox[{"2", "2"},
        "Superscript"]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"1", "2"},
        "Superscript"], ",", 
       TemplateBox[{"2", "2"},
        "Superscript"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"2", "3"},
        "Superscript"], ",", 
       TemplateBox[{"3", "3"},
        "Superscript"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"2", "4"},
        "Superscript"], ",", 
       TemplateBox[{"3", "4"},
        "Superscript"]}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"2", "3"},
        "Superscript"], ",", 
       TemplateBox[{"3", "3"},
        "Superscript"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       TemplateBox[{"2", "4"},
        "Superscript"], ",", 
       TemplateBox[{"3", "4"},
        "Superscript"]}], "}"}], ",", 
     TemplateBox[{"3", "5"},
      "Superscript"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.989675944624339*^9},
 CellLabel->"Out[12]=",
 CellID->281362882,ExpressionUUID->"1a7da277-150c-46d2-8b57-e800422ffa16"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The result mirrors the per-tensor shape: the row for ",
 Cell[BoxData[
 "t1"], "InlineFormula",ExpressionUUID->
  "2867458b-1be1-437c-bfd7-b65efc650159"],
 " is its free ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "f783b8e4-0986-4400-ae9e-7608f0cbb607"],
 " followed by the ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "5b502b80-87a7-408d-8a71-ffb47dd9418b"],
 "-bond; the row for ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "72a3a9b0-32eb-402f-bf8a-e4afcb22c8ef"],
 " is the ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "1a57b033-c3ff-458e-8925-cf045e77c444"],
 "-, ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "06d174f3-740d-4bfb-b0bd-cefbb5d9b877"],
 "- and ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "09552cc2-10bb-4e1d-a75a-a40ba6a3e192"],
 "-bonds; the row for ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "ddef866f-3801-4425-95be-03bcdf54a622"],
 " is the ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "3074dd5e-6e91-4be4-b8c3-259150d08747"],
 "-bond, the ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "b549638f-fe05-44ec-b7fb-f3fb50a6e86a"],
 "-bond, then its free ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",ExpressionUUID->
  "a3f5b7da-abcd-4ef4-8224-a68325109668"],
 ". A leg shown as a bare label is free; a leg shown as a list is contracted, \
and that list names exactly the legs it sums with."
}], "Text",ExpressionUUID->"5c89d9a0-d828-4737-94fe-6d46df7a8b83"],

Cell[CellGroupData[{

Cell["\<\
The same bond-versus-free structure is easier to take in as a picture. Draw \
the network as a hypergraph:\
\>", "Text",ExpressionUUID->"152f63a2-5308-4666-8d02-d75cb9508b21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", "[", "\"\<Hypergraph\>\"", "]"}]], "Input",
 CellLabel->"In[7]:= ",ExpressionUUID->"aa060c87-4705-4042-8f3a-da3fc8ad214a"],

