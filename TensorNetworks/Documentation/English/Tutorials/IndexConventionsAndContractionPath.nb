Cell[TextData[{
 "The leaves are the input tensors (dims ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "3"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c9a615-af45-c085-0ef6-385ecaf192ef"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", "4", ",", "5"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0513e607-0f4c-1e20-3320-f861aaf9650a"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", "5", ",", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0371ff35-cd30-cda2-310e-f77ee4ca9788"],
 "), and each internal node is one pairwise contraction, annotated by the \
axes it sums and the dimensions of its result. The lower node contracts ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6833ae6a-6ac5-a2c8-19c0-40340f71f012"],
 " with ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f7f2999-1aee-25a5-0504-c0c39e988f8f"],
 " over ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2"}], "}"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "128c7526-c883-085d-42b4-6c83e9365aa7"],
 " to make a ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3279c00f-c9e2-8758-6206-da68ef94eda2"],
 " tensor (legs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], ",", 
   StyleBox["m", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50b12ff8-e606-85f7-004e-c6a593b0efdd"],
 "); the root contracts ",
 Cell[BoxData["t1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640f47a5-4648-c62d-0c35-5e0f73e2ad77"],
 " with that over ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63a48922-0fac-666c-115b-208caa594cb6"],
 " to make the final ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "387a9e0d-0234-0e73-6819-1057b7c15559"],
 " (legs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], ",", 
   StyleBox["m", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f64ca0d-9927-5f44-651b-ec5718d225ae"],
 "). Reading the tree bottom-up gives the exact contraction sequence, and \
reading a node tells you which legs were summed there."
}], "Text",
 CellID->1651187567,ExpressionUUID->"399d1ff3-4632-be92-6fa2-96bd73c404f8"],

Cell[TextData[{
 "In words, the sequence is: start with ",
 Cell[BoxData["t1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1170384d-2f38-2c50-470f-b2174acd76ba"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["j", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ce33075-6d34-44a7-1490-aa3f04c12e8d"],
 ", ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54e2b6d5-0ba4-5b19-7c91-2f9fae512663"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], ",", 
    StyleBox["k", "TI"], ",", 
    StyleBox["l", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6334ac9c-43f1-85c0-12cb-45c67585ef2a"],
 ", ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74397683-04f4-1d4d-1dc7-6fedac816797"],
 " ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["k", "TI"], ",", 
    StyleBox["l", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "735e49d5-32a1-4a48-2166-609f47541892"],
 "; step 1 sums the two shared legs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ",", 
   StyleBox["l", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "335d55a2-cf9b-493d-6163-4c0fea2e1807"],
 " to get the intermediate ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["j", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3bfbbd45-edb8-1b0b-6998-352e844d6651"],
 "; step 2 sums the shared ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "045023ab-c37d-b770-2c6f-baf4f6091a5a"],
 " to get ",
 Cell[BoxData[
  RowBox[{
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["i", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73e8aeff-5b91-f8f4-2197-47b95e25cade"],
 ". Every step sums exactly the legs common to the two operands it joins, and \
the free legs of both survive into the result."
}], "Text",
 CellID->941376513,ExpressionUUID->"33e490f1-5bc8-e939-619b-09bb5e62b803"],

Cell[TextData[{
 "The path itself never mentions ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], ",", 
   StyleBox["k", "TI"], ",", 
   StyleBox["l", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "794a4309-908b-2549-2f4a-5b53213f8f93"],
 "; the summed legs are implied by which operands meet. Recover them \
explicitly:"
}], "Text",
 CellID->2120243592,ExpressionUUID->"167ebcf0-2b32-2a61-3e05-35ba4ec7794b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PathIndexContractions", "[", 
  RowBox[{"path", ",", " ", 
   RowBox[{"TensorNetworkData", "[", "tn", "]"}]}], "]"}]], "Input",
 CellLabel->"In[14]:= ",
 CellID->1471736196,ExpressionUUID->"15eb24b6-b946-3a65-43e8-bdf038f0894f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "6"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "7"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[14]= ",
 CellID->98487553,ExpressionUUID->"27d2a24c-1e84-19ee-4de1-44169b316b34"]
}, Open  ]],

Cell[TextData[{
 "The output ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"4", ",", "6"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"5", ",", "7"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285985c7-a1c8-13eb-5866-1ca0d07d6131"],
 " lists the summed legs as ",
 StyleBox["global slots", "TI"],
 ", one step at a time: step 1 sums slots ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", "6"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57868ed1-450c-c474-7dbd-279b6cbeaf5e"],
 " (",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c5e608e-35dc-f74f-3466-79e8bc6edd95"],
 ") and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"5", ",", "7"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a1e4090-3303-05ed-4a26-59da46b66f37"],
 " (",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10256af3-3972-af7a-41da-83bdb804f240"],
 "), step 2 sums ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "3"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "457602f1-d86e-ac86-730d-9bbad918f6ec"],
 " (",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "499f95c1-a958-6c18-7fa4-0caac8ed3762"],
 "). Those are exactly the lowering pairs from section 1, regrouped by path \
step, the bridge from the operand-only path back to the leg conventions."
}], "Text",
 CellID->1820947576,ExpressionUUID->"0f1e874b-6d22-b8ab-3525-1f1504d40af1"],

Cell["\<\
Finally, the operand numbering has an alternative that never reuses a number, \
giving every tensor and intermediate a permanent id. Request it:\
\>", "Text",
 CellID->670734585,ExpressionUUID->"0c02104f-9807-e6c4-3431-8a2919b3cc2e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GreedyContractionPath", "[", 
  RowBox[{"tn", ",", " ", 
   RowBox[{"\"\<FixedIndexing\>\"", " ", "->", " ", "True"}]}], 
  "]"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->19023026,ExpressionUUID->"6f909018-5ea1-6a32-15af-0a425b543918"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[15]= ",
 CellID->623243872,ExpressionUUID->"2f4595f3-090a-1216-557a-0cbda8bf617c"]
}, Open  ]],

Cell[TextData[{
 "The same tree now reads ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"4", ",", "1"}], "}"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06385f5e-e9d4-4e6c-2fd8-571b886114b6"],
 ": merging operands 2 and 3 creates the intermediate with id 4, and step 2 \
joins operand 1 with that stable 4. Same sequence, two operand-numbering \
conventions."
}], "Text",
 CellID->393464600,ExpressionUUID->"25d2fb85-296f-82e5-53e1-f2ef481bd0cf"],

Cell["3. The ArrayDot convention: operand-local axes", "Section",
 CellID->1484396876,ExpressionUUID->"3b9a140e-d97a-4136-69b9-8e6bd80f101c"],

Cell[TextData[{
 "The executor contracts two tensors at a time, and its default primitive ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ArrayDot"]], "paclet:ref/ArrayDot"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4f9438da-b80f-a114-75ab-b18439bbf07e"],
 " uses the fourth leg convention: it names each operand's ",
 StyleBox["own", "TI"],
 " axes. A contraction is a list of ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"axisInA", ",", " ", "axisInB"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7281c19b-2602-dcd4-22be-d8c553b4a63e"],
 " pairs, each axis counted within its own tensor. The doubled bond between \
",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c8746fc-db76-c487-64bd-5fb9de00aeed"],
 " and ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11f0f87a-e6f0-91cd-478f-f227928ae317"],
 " (the shared legs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ",", 
   StyleBox["l", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "473164ce-b547-c1f4-6ecf-7da83cf393de"],
 ") makes this concrete. Instantiate the two tensors numerically (call the \
instances ",
 Cell[BoxData["b"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12c4fc3b-e00c-2bba-42fb-f66491b97980"],
 " and ",
 Cell[BoxData["c"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d7e6892-18cd-6f45-4b05-81dc997835af"],
 ") and contract over ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], ",", 
   StyleBox["l", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "325c8f47-cd85-89da-6263-2720e431db20"],
 " three equivalent ways:"
}], "Text",
 CellID->1149283354,ExpressionUUID->"43fcea2e-12ab-c026-7183-0388a75f930c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"c", " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5", ",", " ", "2"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"ArrayDot", "[", 
     RowBox[{"b", ",", " ", "c", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "]"}], " ", "==", 
    "\n", "   ", 
    RowBox[{"ArrayDot", "[", 
     RowBox[{"b", ",", " ", "c", ",", " ", "2"}], "]"}], " ", "==", "\n", 
    "   ", 
    RowBox[{"TensorContract", "[", 
     RowBox[{
      RowBox[{"TensorProduct", "[", 
       RowBox[{"b", ",", " ", "c"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "5"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[16]:= ",
 CellID->232671466,ExpressionUUID->"5b416c07-c3d3-bf4f-097e-8660f6670595"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[16]= ",
 CellID->636028256,ExpressionUUID->"5add4728-e92e-eff1-0ae3-5f7588d8b5db"]
}, Open  ]],

Cell[TextData[{
 "The result is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "621761a3-d300-b412-122d-780ce6ba1f78"],
 ", so all three name the same contraction. The first is the ",
 Cell[BoxData["ArrayDot"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b08d465-1dcc-fb87-0937-ce4f947ec9ed"],
 " ",
 StyleBox["pair form", "TI"],
 ": ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "1"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d3ffb2e-09a8-fc78-24c4-f288a842c742"],
 " contracts ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4139b36b-52b1-2977-70c6-2b356744785d"],
 "'s axis 2 (",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "494d6e39-7750-b6eb-7f72-806302ea1c31"],
 ") with ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39b01e29-d171-5c92-6f4f-9072e00426f8"],
 "'s axis 1 (",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6d713e-2461-11c8-7513-69784d146312"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14ad582f-66ff-93eb-3c53-5189128be131"],
 " contracts ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f7ea056-2d28-85ec-7505-3a1044c2ef36"],
 "'s axis 3 (",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "16b00368-b832-202d-3e4f-9b3239c77377"],
 ") with ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06d00634-a672-f252-2eef-9871d304c0b8"],
 "'s axis 2 (",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "05feeeaf-4f58-f7b7-3385-07096ad2dd9d"],
 "). The second is the ",
 StyleBox["count form", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{"ArrayDot", "[", 
   RowBox[{"b", ",", " ", "c", ",", " ", "2"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "583a98af-415b-100e-09d9-110970ee6354"],
 ", which contracts ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07beae85-a317-6bf9-2d45-47eed6a239c3"],
 "'s last two axes with ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "503c05d1-55e8-8c5e-01c3-9c9b6382d6a4"],
 "'s first two; it works here only because the shared axes happen to be ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60049622-f570-0e0e-103b-0f8ffc055554"],
 "'s trailing block and ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40ea559d-da93-7842-70ea-4cc6df264aa8"],
 "'s leading block. The third is the global-slot form, and comparing it to \
the pair form gives the translation: an ",
 Cell[BoxData["a"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "23ccc6ee-92c0-e596-51f3-dfc8277acffc"],
 "-axis keeps its number, while ",
 Cell[BoxData["b"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "114d8d02-b276-9c05-4772-256fc700e76f"],
 "'s axis ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"b", "i"}], "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dc22b63-32d1-862f-5bf1-c34d4765ed75"],
 " is the global slot ",
 Cell[BoxData[
  RowBox[{
   StyleBox["rank",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["a", "TI"], 
   StyleBox["]",
    SpanMaxSize->1], "+", 
   StyleBox["b", "TI"], 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36ea7e2c-072a-2221-5eea-7076b2df710b"],
 " (here ",
 Cell[BoxData[
  RowBox[{
   StyleBox["rank",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["t2",
    FontSlant->"Italic"], 
   StyleBox["]",
    SpanMaxSize->1], "=", "3"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b23761c-2477-64e8-0ad1-68464d024e32"],
 ", so ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73216bcf-7cf1-61ac-22de-82a9748433f6"],
 "'s axes 1,2 are global slots 4,5). The point of the operand-local \
convention is that a pairwise step never builds the growing flattened slot \
list; it only ever names two operands' own axes, which is why ",
 Cell[BoxData["ArrayDot"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69fa63e8-c0ca-4913-1f9a-7ab5f17f1879"],
 " is the cheap default."
}], "Text",
 CellID->559599970,ExpressionUUID->"409bca18-cbd6-e54d-70b8-ec45ee60cf97"],

Cell["4. The same contraction in every convention", "Section",
 CellID->1710123944,ExpressionUUID->"10b62b5f-1d3f-f012-404d-c31994cbc378"],

Cell[TextData[{
 "Putting it together, here is the single sum over ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79984792-c453-565a-2fb8-5edfede63ca0"],
 " (the bond between ",
 Cell[BoxData["t1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d45428e-8fa1-6801-4b7b-5be82a543b6b"],
 " and ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "604bb87d-3174-a116-1048-32274006f07c"],
 ") in all five conventions:"
}], "Text",
 CellID->934597701,ExpressionUUID->"763191a2-6f8b-197a-1fce-080c0a3e6840"],

