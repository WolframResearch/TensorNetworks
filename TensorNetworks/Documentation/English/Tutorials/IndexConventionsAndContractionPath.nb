Cell[TextData[{
 "The tensor network is binary: every index sits on at most two tensors, so \
every contraction is an ordinary pair of tensors. The doubled bond between ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f417ec-7166-d78d-038b-8eb60010bdd7"],
 " and ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b6e5dad-9702-0c1f-7916-54f722b75765"],
 " makes the multi-axis ",
 Cell[BoxData["ArrayDot"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d359769-845f-cd94-44ca-0f332deb97fe"],
 " case concrete, and the rank-3 tensors make the ",
 Cell[BoxData["TensorContract"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2055bfee-d4b5-7aa2-506a-36cbdd404888"],
 " blocks nontrivial. As an ",
 Cell[BoxData["EinsteinSummation"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 " string the same network is ",
 Cell[BoxData["\"\<ij,jkl,klm->im\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 ". The three-or-more case is the subject of the last section."
}], "Text",
 CellID->1641200340,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell["\<\
1. Reading the legs: EinsteinSummation, data labels, global slots\
\>", "Section",
 CellID->1424533854,ExpressionUUID->"25a0bfbe-b1d4-2428-535f-36fbc0668f72"],

Cell[TextData[{
 "Three of the four leg conventions give a leg a fixed identity, independent \
of any contraction; we read them off the tensor network here. The fourth, the \
",
 Cell[BoxData["ArrayDot"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04786d0e-016a-d127-2c07-8568b01ca00d"],
 " operand-local axes, comes with the contraction in section 3."
}], "Text",
 CellID->535457321,ExpressionUUID->"2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],

Cell["Rebuild the running network for this section:", "Text",
 CellID->141959522,ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"t1", " ", "=", " ", 
   RowBox[{"ArraySymbol", "[", 
    RowBox[{"\"\<t1\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"t2", " ", "=", " ", 
   RowBox[{"ArraySymbol", "[", 
    RowBox[{"\"\<t2\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"t3", " ", "=", " ", 
   RowBox[{"ArraySymbol", "[", 
    RowBox[{"\"\<t3\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "5", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tn", " ", "=", " ", 
   RowBox[{"TensorNetwork", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "}"}], " ", "->",
       " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "5"}], "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->299517738,ExpressionUUID->"14fd1512-f616-8834-3c82-8d5f83a0db1e"],

Cell[TextData[{
 StyleBox["EinsteinSummation labels.",
  FontWeight->"Bold"],
 " A label is an abstract name. A label that appears on two tensors is \
contracted; a label that appears once is free; the part after ",
 Cell[BoxData["->"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66c67103-72a1-9427-0efe-696d0755ff0d"],
 " fixes the output order. That is the entire convention, and ",
 Cell[BoxData["\"\<ij,jkl,klm->im\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 " already encodes it: ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58ee7ecb-1370-1005-0896-7795a605636f"],
 ", ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],
 ", ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],
 " repeat (contracted), ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3181a460-bc62-f1ee-67be-3e4a3514c334"],
 ", ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],
 " appear once (free), and the output is the two free legs."
}], "Text",
 CellID->2142391071,ExpressionUUID->"6b45e796-37a7-eecc-197a-fed04253b416"],

Cell[TextData[{
 StyleBox["Data labels.",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorNetworkData"]], 
    "paclet:Wolfram/TensorNetworks/ref/TensorNetworkData", 
    "Wolfram/TensorNetworks Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 " is the low-level form the rest of the kernel consumes. It tags every leg \
with its tensor position and its label (a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Superscript"]], "paclet:ref/Superscript"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "250a2d7c-9b81-05b0-5309-c5261e346f9a"],
 " of position over label), so a leg is addressable by ",
 StyleBox["which tensor", "TI"],
 " and ",
 StyleBox["which label", "TI"],
 ". List the per-leg labels:"
}], "Text",
 CellID->1002769646,ExpressionUUID->"15a9104d-5625-6af3-4356-8a1763d038d9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", "[", "\"\<Indices\>\"", "]"}]], "Input",
 CellLabel->"In[3]:= ",
 CellID->804706604,ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"1", "1"},
      "Superscript"], ",", 
     TemplateBox[{"1", "2"},
      "Superscript"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"2", "2"},
      "Superscript"], ",", 
     TemplateBox[{"2", "3"},
      "Superscript"], ",", 
     TemplateBox[{"2", "4"},
      "Superscript"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     TemplateBox[{"3", "3"},
      "Superscript"], ",", 
     TemplateBox[{"3", "4"},
      "Superscript"], ",", 
     TemplateBox[{"3", "5"},
      "Superscript"]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",
 CellID->1372406984,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"]
}, Open  ]],

Cell[TextData[{
 "Each entry is one leg, tagged by tensor position (the base) and ",
 Cell[BoxData["EinsteinSummation"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "341c54d9-3079-6bba-5c24-4d83410c3980"],
 " label (the superscript); the position-2, label-4 entry, for instance, is \
tensor 2's ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbf9c2b-d84a-d79b-4b44-1674d9fcbde1"],
 "-leg. Read off the bonds:"
}], "Text",
 CellID->2122865143,ExpressionUUID->"0f449897-1a0e-51e7-357b-11d19fbb23cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", "[", "\"\<Bonds\>\"", "]"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->480417995,ExpressionUUID->"6d5a63ab-93b9-14f3-1b7a-7af5264c7ed9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"1", "2"},
       "Superscript"], ",", 
      TemplateBox[{"2", "2"},
       "Superscript"]}], "}"}], "\[Rule]", "3"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"2", "3"},
       "Superscript"], ",", 
      TemplateBox[{"3", "3"},
       "Superscript"]}], "}"}], "\[Rule]", "4"}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"2", "4"},
       "Superscript"], ",", 
      TemplateBox[{"3", "4"},
       "Superscript"]}], "}"}], "\[Rule]", "5"}]}], "}"}]], "Output",
 CellLabel->"Out[4]= ",
 CellID->1790704712,ExpressionUUID->"5077c06e-c394-b43c-000c-da4bf6261f06"]
}, Open  ]],

Cell[TextData[{
 "This gives the three bond groups with their dimensions: the ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07359582-e823-44a1-2eca-0cef89d62e8b"],
 "-bond has dimension 3, the ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c239bd0-3ff5-3b18-25d0-129ab9818662"],
 "-bond dimension 4, and the ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "68c76573-72ce-0c1a-18fd-7d3d077b5760"],
 "-bond dimension 5. Each bond pairs the two legs that share a label and \
records the dimension summed over it. Now the free legs, the labels that \
appear on only one tensor:"
}], "Text",
 CellID->753514147,ExpressionUUID->"6184d2f2-049e-728e-17bb-cbbcad2b40d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", "[", "\"\<FreeIndices\>\"", "]"}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->2112731703,ExpressionUUID->"4fd967ef-5008-0b29-75e7-7ec961bd5673"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "5"}], "}"}]], "Output",
 CellLabel->"Out[5]= ",
 CellID->1175750198,ExpressionUUID->"19bb1c5e-57ab-6e36-4f58-9618625e351c"]
}, Open  ]],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "5"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c8dcc56-7aa9-964a-04b2-e6107f5dfc90"],
 ", the free labels ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], ",", 
   StyleBox["m", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30baa1c8-66ad-75e0-6059-389213585fca"],
 " in the requested output order. Now tag every leg as either a bond group or \
a bare free label:"
}], "Text",
 CellID->632614636,ExpressionUUID->"52535901-cb26-8b9c-0261-516aeed0d9e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tn", "[", "\"\<Contractions\>\"", "]"}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->758895630,ExpressionUUID->"323a4b1c-b138-a791-63da-6359c0b20dfb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
