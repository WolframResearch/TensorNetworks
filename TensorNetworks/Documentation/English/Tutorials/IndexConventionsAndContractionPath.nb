            0.2578919, 0.3547453, 0.49685860000000004`],
           BackFaceColor->RGBColor[0.2578919, 0.3547453, 0.49685860000000004`],
           GraphicsColor->RGBColor[0.2578919, 0.3547453, 0.49685860000000004`],
           FontWeight->Bold,
           
           FontColor->RGBColor[
            0.2578919, 0.3547453, 
             0.49685860000000004`]], \
{2.7528645056021777, 0.8368299062484716}]}}}, 
      {RGBColor[0.880722, 0.611041, 0.142051], 
       FilledCurveBox[{
        BSplineCurve[{{0.9039307851398664, 0.3647688200248645}, {
          1.441893633141224, 0.5861976169269032}, {2.1320088426994834`, 
          0.6874763434169361}}], 
         BSplineCurve[{{2.1320088426994834`, 0.6874763434169361}, {
          1.4812891191684996`, 0.7166486101599163}, {1.0615127292489688`, 
          0.8865727929569174}}], 
