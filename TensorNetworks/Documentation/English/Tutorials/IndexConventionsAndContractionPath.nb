}, Open  ]],

Cell[TextData[{
 "The result mirrors the per-tensor shape: the row for ",
 Cell[BoxData["t1"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "511b3347-8d7d-ab60-0738-ab212409f64a"],
 " is its free ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36c19c85-764d-0b01-5efe-15ef03f8566b"],
 " followed by the ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6815cd54-0cd7-196f-182a-e51ea5626bb5"],
 "-bond; the row for ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "519775d4-d545-25f2-07ad-6c91dcf18fd8"],
 " is the ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5900aac7-5263-773e-0f3f-43a167165a04"],
 "-, ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ecfdb3-2197-c9b0-2e93-f4fd50239b9a"],
 "- and ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d95fcb-3316-2212-42e7-569546a37178"],
 "-bonds; the row for ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "733995c2-f5bf-78ee-22c6-0caffc4a4a34"],
 " is the ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f8ab258-7e7f-0723-7589-34027b0a6a09"],
 "-bond, the ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b12ee74-9953-131d-1921-003e18e67e67"],
 "-bond, then its free ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65262d3c-fccc-1dc6-0cdd-c579f579672c"],
 ". A leg shown as a bare label is free; a leg shown as a list is contracted, \
and that list names exactly the legs it sums with."
}], "Text",
 CellID->1303163127,ExpressionUUID->"5e157ee2-48da-d240-062b-77cc696ca0aa"],

Cell["\<\
The same bond-versus-free structure is easier to take in as a picture. Draw \
the network as a hypergraph:\
\>", "Text",
 CellID->2098230307,ExpressionUUID->"78287f93-0f12-7c52-2828-76ddaaa746b8"],

