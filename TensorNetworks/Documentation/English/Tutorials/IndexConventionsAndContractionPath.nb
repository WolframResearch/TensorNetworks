  }]], "2ColumnTableMod",
 CellID->284780108,ExpressionUUID->"710db4a8-d877-0db2-2732-2df5d9025798"],

Cell[TextData[{
 "The translations are mechanical: lay all legs end to end and a repeated ",
 Cell[BoxData["EinsteinSummation"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e12f72-3ad4-a92f-279e-c73cbf66f875"],
 " label becomes the pair of its two global slots; a ",
 Cell[BoxData["b"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06ea8612-dd18-b4f0-2ee9-185fd4921eda"],
 "-axis at global slot ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b02f270-2101-5c3d-3931-f43a50b42707"],
 " is operand-local axis ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "-", 
   StyleBox["rank",
    FontSlant->"Plain"], "\[ThinSpace]", 
   StyleBox["[",
    SpanMaxSize->1], 
   StyleBox["a", "TI"], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1868bf-f524-2aaf-5b27-81f8fcd178f5"],
 " (here ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "669caa83-24d6-d7e9-0ea3-43ed4d60bd33"],
 "'s ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ae50fd0-6d1f-8fa4-0a9a-a69a04abd58e"],
 " at slot 3 is local axis ",
 Cell[BoxData[
  RowBox[{"3", "-", "2", "=", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66e7a4a8-d710-64fe-0e9c-3df5e2a54ec4"],
 "); a path step names two operands and the summed legs are the labels they \
share."
}], "Text",
 CellID->643798763,ExpressionUUID->"3e73fafe-05d0-7203-6600-f3b8ac654169"],

Cell["5. What else a repeated index can mean", "Section",
 CellID->268959046,ExpressionUUID->"7fb7b09a-ac3b-ef52-254c-29c7c5cfb5b8"],

Cell["\<\
A repeated index in the tensor network is always a plain pairwise \
contraction. Two other cases exist, and each has its own index convention.\
\>", "Text",
 CellID->403125484,ExpressionUUID->"12c044c4-b778-74e1-42f0-5da1c20d5ecb"],

Cell[TextData[{
 StyleBox["Broadcasting: a repeated index kept in the output.",
  FontWeight->"Bold"],
 " If a repeated index is ",
 StyleBox["not", "TI"],
 " summed but kept in the output, it is not a contraction at all; it is a \
broadcast, the tensor-network form of the einsum string ",
 Cell[BoxData["\"\<ij,j->ij\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d9aa029-60a8-273a-6bb9-3a7311428a00"],
 ". ",
 Cell[BoxData["EinsteinSummation"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64adc082-4122-deff-0c52-d9ec70d4a4c5"],
 " routes this through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IndexedMultiply"]], 
    "paclet:Wolfram/TensorNetworks/ref/IndexedMultiply", 
    "Wolfram/TensorNetworks Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7e451771-8a55-ceec-267a-8f3b2fe19436"],
 ", which aligns the shared axis and multiplies elementwise. Show that ",
 Cell[BoxData["\"\<ij,j->ij\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4670f053-f537-0b3f-6e0f-ea1cfcc25605"],
 " multiplies each column of a matrix by a vector:"
}], "Text",
 CellID->931950651,ExpressionUUID->"330aabc0-bdd5-22a3-6109-42aa34607089"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"{", "3", "}"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"ActivateTensors", "[", 
     RowBox[{"EinsteinSummation", "[", 
      RowBox[{"\"\<ij,j->ij\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "v"}], "}"}]}], "]"}], "]"}], " ", "==", " ", 
    RowBox[{"a", " ", "*", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"v", ",", " ", 
       RowBox[{"Length", "[", "a", "]"}]}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[17]:= ",
 CellID->666326815,ExpressionUUID->"38c8cb12-19a5-fbf9-68f7-e35c9851c9c3"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[17]= ",
 CellID->2074914640,ExpressionUUID->"70d705b8-410a-1477-20ec-9ce270bf7f5d"]
}, Open  ]],

Cell[TextData[{
 "The result is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "737c509e-bc52-eefb-2104-49d835e4b4c1"],
 ". Here ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01a44b6b-c85f-9e0e-375c-6334e9ebe554"],
 " appears on both inputs ",
 StyleBox["and", "TI"],
 " in the output, so it survives as a single shared axis rather than being \
summed. Look at what ",
 Cell[BoxData["IndexedMultiply"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10bcaec6-cc03-bcfd-4043-47a3e5b706c7"],
 " returns directly:"
}], "Text",
 CellID->622967176,ExpressionUUID->"25120901-cfbc-a8e6-5321-a16aea4efacc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IndexedMultiply", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "5", ",", " ", "6"}], "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"10", ",", " ", "20", ",", " ", "30"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[18]:= ",
 CellID->299073241,ExpressionUUID->"3ee7491f-72c3-8814-669d-61590777db7e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"10", ",", "40", ",", "90"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"40", ",", "100", ",", "180"}], "}"}]}], "}"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[18]= ",
 CellID->1435264822,ExpressionUUID->"67860241-8011-89c8-0dbd-a42b31a5db12"]
}, Open  ]],

Cell[TextData[{
 "It returns a pair: the labels ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "2"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1318f44b-7a0d-b86f-4127-ee157fb90ab5"],
 " (the de-duplicated union, each once) and the broadcast tensor ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"10", ",", " ", "40", ",", " ", "90"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"40", ",", " ", "100", ",", " ", "180"}], "}"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "221ecbfd-1ed7-d323-5225-e2a79b63be09"],
 " of dims ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "3"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f067a83-888f-4db3-653e-73ed293a1799"],
 ", each column of the matrix scaled by the matching vector entry. The \
convention to remember: a repeated index that reaches the output is one \
diagonal axis, identified across the tensors that carry it, not a contraction \
pair. So the tensor network never invokes ",
 Cell[BoxData["IndexedMultiply"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "287fc527-5526-9e30-5804-dc815cd0e51a"],
 ", its repeated indices ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], ",", 
   StyleBox["k", "TI"], ",", 
   StyleBox["l", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2207e002-80f7-0285-523c-fa6c308250ef"],
 " are all summed; broadcasting needs a ",
 StyleBox["shared output", "TI"],
 " index like the one above."
}], "Text",
 CellID->320615307,ExpressionUUID->"440467ae-8db5-79b4-6c3c-7e0824404b9e"],

Cell[TextData[{
 StyleBox["Hyperedges: a contracted index on three or more tensors.",
  FontWeight->"Bold"],
 " A contracted index on three or more tensors (a hyperedge) has no single \
pairwise form. Rebuild the three-tensor network and add a fourth tensor ",
 Cell[BoxData["t4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "141585f4-d1c1-5bbd-3c2a-1cb1e0742987"],
 " carrying ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d27d006-86b8-9131-64dc-ca603332e01b"],
 " (and a new free leg ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "6"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e44340b-ef5c-51d5-667b-ae548ae9233f"],
 "), so ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "321034f4-436e-dcec-622f-adbe7618a636"],
 " now sits on ",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1287d3f9-6500-de4e-42bc-caa30cbaa494"],
 ", ",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3035d7f6-28ea-dcd5-61ca-ceb0489ca63f"],
 ", ",
 Cell[BoxData["t4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "087f5f2f-6486-1b59-3805-56890d3369a3"],
 ":"
}], "Text",
 CellID->1594238871,ExpressionUUID->"7ddf1aac-cdaa-cd7e-2be4-9309e45c9444"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"t1", " ", "=", " ", 
   RowBox[{"ArraySymbol", "[", 
    RowBox[{"\"\<t1\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"t2", " ", "=", " ", 
   RowBox[{"ArraySymbol", "[", 
    RowBox[{"\"\<t2\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"t3", " ", "=", " ", 
   RowBox[{"ArraySymbol", "[", 
    RowBox[{"\"\<t3\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "5", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t4", " ", "=", " ", 
   RowBox[{"ArraySymbol", "[", 
    RowBox[{"\"\<t4\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[19]:= ",
 CellID->2002505366,ExpressionUUID->"2b41c4a9-15e8-1804-597e-ddf3a39d6b6e"],

Cell["Lower the four-tensor network:", "Text",
 CellID->2121396920,ExpressionUUID->"13ecd9ee-6506-67bb-4193-d0c80cb34d81"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "6"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "5", ",", " ", "6"}], "}"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t1", ",", " ", "t2", ",", " ", "t3", ",", " ", "t4"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[20]:= ",
 CellID->655171200,ExpressionUUID->"6724c974-bdf1-27a5-0edb-e13e3b858d8f"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"TensorContract"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[TensorContract]"], "[", 
  RowBox[{
   RowBox[{
    TemplateBox[{"\"t1\"", "2", "2", "3"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    TemplateBox[{"\"t2\"", "3", "3", "4", "5"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    TemplateBox[{"\"t3\"", "3", "4", "5", "2"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    TemplateBox[{"\"t4\"", "2", "4", "2"},
     "ArraySymbol2"]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "6", ",", "9"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "7"}], "}"}]}], "}"}]}], "]"}]], "Output",
 CellLabel->"Out[20]= ",
 CellID->1043022705,ExpressionUUID->"2b52875c-0948-9ae8-5961-1f06a8e2e832"]
}, Open  ]],

Cell[TextData[{
 "In the lowering the ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "53412643-5a68-df00-017e-b82d5f02a26a"],
 " contraction is the group ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "6", ",", " ", "9"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "696f5b1d-d56b-3a26-1f15-5346dc1f890c"],
 ", a ",
 StyleBox["three-element", "TI"],
 " group rather than a pair: slot 4 (",
 Cell[BoxData["t2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0eb02373-2484-618c-364f-bb3d4d3133d6"],
 "'s ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "640353f1-ff8e-e9b3-0c31-4abafa38bb99"],
 "), slot 6 (",
 Cell[BoxData["t3"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "37161f66-4600-a3a8-5d2d-974073baf1f2"],
 "'s ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e44757e-c407-f813-567c-6d3bedb3cb79"],
 "), slot 9 (",
 Cell[BoxData["t4"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07a61755-6475-fbf7-2d5d-8f1f0d01c9dd"],
 "'s ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "539b0e4e-9e5a-5525-01b8-a0281bef3c0f"],
 "). ",
 Cell[BoxData["TensorContract"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cd82739-42e3-b7ed-44e7-bf6376971d37"],
 " treats it as a generalized trace over all three slots at once. That is the \
global-slot convention's answer to a hyperedge: groups, not just pairs."
}], "Text",
 CellID->50259360,ExpressionUUID->"0971a20b-7913-467e-3f0e-445578a62d44"],

Cell[TextData[{
 "A contraction path is still built from pairwise steps, and a hyperedge fits \
them without a three-way group: a step sums an index its two operands share \
only when no other tensor and no output still carries it, and otherwise keeps \
it, once, as a ",
 StyleBox["batch", "TI"],
 " index of the result. The index rides along every step that still needs it \
and is summed by the last one. Build the four-tensor network:"
}], "Text",
 CellID->680111415,ExpressionUUID->"09df342d-d743-5809-3fe4-ae76e2f62b53"],

Cell[CellGroupData[{

