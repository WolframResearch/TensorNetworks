   RowBox[{
    RowBox[{"{", 
     RowBox[{"t1", ",", " ", "t2", ",", " ", "t3", ",", " ", "t4"}], "}"}], ",",
     " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "6"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[21]:= ",
 CellID->1051605173,ExpressionUUID->"0a0cc1e9-e2ca-26d9-3a33-d8b2977c8c23"],

