Cell[TextData[{
 "The leaves are the input tensors (dims ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "3"}], "}"}]], "InlineFormula",ExpressionUUID->
  "b311bd66-aee4-4588-a84f-d44fe761d3b2"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", "4", ",", "5"}], "}"}]], "InlineFormula",ExpressionUUID->
  "5ca9d4db-e78d-43eb-af93-c3e297c69465"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", "5", ",", "2"}], "}"}]], "InlineFormula",ExpressionUUID->
  "30da2a56-afaf-4881-8bc5-bc5375cc0ea0"],
 "), and each internal node is one pairwise contraction, annotated by the \
axes it sums and the dimensions of its result. The lower node contracts ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "d8442a8f-0f1b-4f78-9c73-351d5d6bf1e2"],
 " with ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "ef3710a9-5ddf-4c21-b26d-35a680d9e975"],
 " over ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2"}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "2548a5dc-6a83-46e4-ac27-bba3fa051831"],
 " to make a ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", "2"}], "}"}]], "InlineFormula",ExpressionUUID->
  "544183b3-414a-453e-83c4-d0590caaee2f"],
 " tensor (legs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["m", "TI"]}]], "InlineFormula",ExpressionUUID->
  "3503790a-b797-472e-a28f-5c48265c128b"],
 "); the root contracts ",
 Cell[BoxData[
 "t1"], "InlineFormula",ExpressionUUID->
  "b7c50881-9f66-495b-a9da-c7ef2e521fd5"],
 " with that over ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}], "}"}]], "InlineFormula",ExpressionUUID->
  "231991be-18b4-46ab-ac1b-64072e2a94a1"],
 " to make the final ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "2"}], "}"}]], "InlineFormula",ExpressionUUID->
  "4f0e24ab-fd72-454d-bdc0-2323829cafcd"],
 " (legs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["m", "TI"]}]], "InlineFormula",ExpressionUUID->
  "2bd87bad-49ff-44fb-8751-f1f5a232b539"],
 "). Reading the tree bottom-up gives the exact contraction sequence, and \
reading a node tells you which legs were summed there."
}], "Text",ExpressionUUID->"580843a6-9d71-4b0b-a946-c5a536514c51"],

Cell[TextData[{
 "In words, the sequence is: start with ",
 Cell[BoxData[
 "t1"], "InlineFormula",ExpressionUUID->
  "6bd727ba-9fab-4a2b-93a2-3358e518d7f5"],
 " ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    StyleBox["i", "TI"], 
    RowBox[{",", "\[ThinSpace]"}], 
    StyleBox["j", "TI"]}], ")"}]], "InlineFormula",ExpressionUUID->
  "86290a33-7e16-40b4-ad89-ef1feb26c9fb"],
 ", ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "af92b9fb-a667-4bd7-8d02-10ae460e322a"],
 " ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    StyleBox["j", "TI"], 
    RowBox[{",", "\[ThinSpace]"}], 
    StyleBox["k", "TI"], 
    RowBox[{",", "\[ThinSpace]"}], 
    StyleBox["l", "TI"]}], ")"}]], "InlineFormula",ExpressionUUID->
  "ab87b6f9-bbf0-4feb-895c-fb09b758bf5f"],
 ", ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "2940af2d-aed9-4548-a4d8-72d06b6bab24"],
 " ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    StyleBox["k", "TI"], 
    RowBox[{",", "\[ThinSpace]"}], 
    StyleBox["l", "TI"], 
    RowBox[{",", "\[ThinSpace]"}], 
    StyleBox["m", "TI"]}], ")"}]], "InlineFormula",ExpressionUUID->
  "852022aa-301c-4ec9-bfee-03d1346d3c22"],
 "; step 1 sums the two shared legs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["l", "TI"]}]], "InlineFormula",ExpressionUUID->
  "180b3cfd-2cb6-4948-bdef-fb6a82809f9d"],
 " to get the intermediate ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    StyleBox["j", "TI"], 
    RowBox[{",", "\[ThinSpace]"}], 
    StyleBox["m", "TI"]}], ")"}]], "InlineFormula",ExpressionUUID->
  "58afd28c-df24-455d-9e13-f53148306175"],
 "; step 2 sums the shared ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "ad89ef63-82ed-4f9f-87df-119a0fb08357"],
 " to get ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    StyleBox["i", "TI"], 
    RowBox[{",", "\[ThinSpace]"}], 
    StyleBox["m", "TI"]}], ")"}]], "InlineFormula",ExpressionUUID->
  "2a7138cb-9b57-4462-807b-543a5caab17a"],
 ". Every step sums exactly the legs common to the two operands it joins, and \
the free legs of both survive into the result."
}], "Text",ExpressionUUID->"52b358aa-27b2-4fe0-b30b-9119bfd0d873"],

Cell[CellGroupData[{

Cell[TextData[{
 "The path itself never mentions ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["k", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["l", "TI"]}]], "InlineFormula",ExpressionUUID->
  "0cbd2047-dacc-45bf-8bf8-e8d7a333ef45"],
 "; the summed legs are implied by which operands meet. Recover them \
explicitly:"
}], "Text",ExpressionUUID->"1a81d9c3-c407-42e8-862a-c8c395e55e5f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PathIndexContractions", "[", 
  RowBox[{"path", ",", " ", 
   RowBox[{"TensorNetworkData", "[", "tn", "]"}]}], "]"}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"162e8402-ebca-444f-b157-d9510436b9ca"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "6"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "7"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.989676035878026*^9},
 CellLabel->"Out[18]=",
 CellID->2078822014,ExpressionUUID->"0d5760db-10c9-447c-9130-ebb9f590b557"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The output ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"4", ",", "6"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"5", ",", "7"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "5f4c2575-3251-44b4-8483-d8be2e9b5cd9"],
 " lists the summed legs as ",
 StyleBox["global slots", "TI"],
 ", one step at a time: step 1 sums slots ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", "6"}], "}"}]], "InlineFormula",ExpressionUUID->
  "ef61f6be-cc37-4486-ac9b-075a81a71bbd"],
 " (",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "f23dae68-9cd0-494f-9121-037385df6a23"],
 ") and ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"5", ",", "7"}], "}"}]], "InlineFormula",ExpressionUUID->
  "f23a2e48-b51d-4c09-a501-42e626fbc30f"],
 " (",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "65c84f79-17cc-4ed1-8854-d3ae702a9714"],
 "), step 2 sums ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "3"}], "}"}]], "InlineFormula",ExpressionUUID->
  "bcc86b6c-4389-421c-8447-4cae565db88c"],
 " (",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "ed8edd1a-4375-4aaa-9562-2b87684c2a21"],
 "). Those are exactly the lowering pairs from section 1, regrouped by path \
step, the bridge from the operand-only path back to the leg conventions."
}], "Text",ExpressionUUID->"2f7ca4cb-c4f5-4f69-b846-cd875d946dee"],

Cell[CellGroupData[{

Cell["\<\
Finally, the operand numbering has an alternative that never reuses a number, \
giving every tensor and intermediate a permanent id. Request it:\
\>", "Text",ExpressionUUID->"ae3cba2a-3a35-4cca-9bfe-0b62b9e9f33d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GreedyContractionPath", "[", 
  RowBox[{"tn", ",", " ", 
   RowBox[{"\"\<FixedIndexing\>\"", " ", "->", " ", "True"}]}], 
  "]"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"58ac581f-5c56-4ec1-a876-2934360b14ee"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.989676050764599*^9},
 CellLabel->"Out[19]=",
 CellID->1448687903,ExpressionUUID->"065517d6-0c07-48e3-ae63-69d2fe101aaf"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The same tree now reads ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"4", ",", "1"}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "2b74c9a8-5958-4689-9c7c-47b0d8658476"],
 ": merging operands 2 and 3 creates the intermediate with id 4, and step 2 \
joins operand 1 with that stable 4. Same sequence, two operand-numbering \
conventions."
}], "Text",ExpressionUUID->"e03ad662-62a8-4d31-bd34-9cf6ba82c297"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. The ArrayDot convention: operand-local axes", "Section",ExpressionUUID->"520f089a-d8f9-4d13-aef3-3d4c2ed2f515"],

Cell[CellGroupData[{

Cell[TextData[{
 "The executor contracts two tensors at a time, and its default primitive ",
 Cell[BoxData[
  ButtonBox["ArrayDot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ArrayDot"]], "InlineFormula",ExpressionUUID->
  "59f5f70b-efa0-46ee-8a38-87aac66c5401"],
 " uses the fourth leg convention: it names each operand's ",
 StyleBox["own", "TI"],
 " axes. A contraction is a list of ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"axisInA", ",", " ", "axisInB"}], "}"}]], "InlineFormula",
  ExpressionUUID->"de4da20b-c8b7-4e4a-b66b-c64fb487a4a9"],
 " pairs, each axis counted within its own tensor. The doubled bond between \
",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "f4edf202-0091-4907-b759-153023619a9c"],
 " and ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "453738cf-a101-415f-a01a-afac1889a031"],
 " (the shared legs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["l", "TI"]}]], "InlineFormula",ExpressionUUID->
  "23876e5b-892d-460b-a25e-12977a5e35db"],
 ") makes this concrete. Instantiate the two tensors numerically (call the \
instances ",
 Cell[BoxData[
 "b"], "InlineFormula",ExpressionUUID->"ec0a43fb-ae09-40cb-8a6d-06883a646c05"],
 " and ",
 Cell[BoxData[
 "c"], "InlineFormula",ExpressionUUID->"6d86946a-3780-49ef-9f9f-0e27b357678f"],
 ") and contract over ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["l", "TI"]}]], "InlineFormula",ExpressionUUID->
  "0073695c-d87f-4aab-a366-95ebfbeb86c7"],
 " three equivalent ways:"
}], "Text",ExpressionUUID->"5c7148e9-bbed-43ea-8330-dffd923006aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"b", " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{"c", " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5", ",", " ", "2"}], "}"}]}], "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"ArrayDot", "[", 
     RowBox[{"b", ",", " ", "c", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "2"}], "}"}]}], "}"}]}], "]"}], " ", "==", 
    "\n", "   ", 
    RowBox[{"ArrayDot", "[", 
     RowBox[{"b", ",", " ", "c", ",", " ", "2"}], "]"}], " ", "==", "\n", 
    "   ", 
    RowBox[{"TensorContract", "[", 
     RowBox[{
      RowBox[{"TensorProduct", "[", 
       RowBox[{"b", ",", " ", "c"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "5"}], "}"}]}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"593bcc79-a5f1-4cae-be76-7a97af8aa8b2"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.989676058978387*^9},
 CellLabel->"Out[20]=",
 CellID->1516900936,ExpressionUUID->"b221bd3b-a785-4b5d-89a4-293cd52c85e2"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
 "True"], "InlineFormula",ExpressionUUID->
  "ff5aae6e-a5f5-4366-bccd-6a908eb84032"],
 ", so all three name the same contraction. The first is the ",
 Cell[BoxData[
 "ArrayDot"], "InlineFormula",ExpressionUUID->
  "fca1e18d-185b-41ca-b26a-7fe56f54ce2c"],
 " ",
 StyleBox["pair form", "TI"],
 ": ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "1"}], "}"}]], "InlineFormula",ExpressionUUID->
  "649188ac-2c07-403b-bcc9-fa825901242e"],
 " contracts ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "a6b3fce6-f171-4b0c-be3c-cbd59c7082f5"],
 "'s axis 2 (",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "9a1bcc74-b8af-4a19-a7d1-e4588d09127d"],
 ") with ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "3c804030-7972-45f0-9b40-25a60c282edd"],
 "'s axis 1 (",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "63cbf416-3522-401b-85fd-525ea54430c0"],
 "), ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"3", ",", "2"}], "}"}]], "InlineFormula",ExpressionUUID->
  "a981116c-28c7-4266-b693-ff11cb8cb94a"],
 " contracts ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "a301a41d-0c16-47c1-bbe1-135e4d1e3137"],
 "'s axis 3 (",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "f1c1eb13-f329-429d-b44c-3f2561f5e060"],
 ") with ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "92b151ad-ff2d-405c-aa3a-ab52eada49b0"],
 "'s axis 2 (",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "0ba5362d-a6c2-4e1a-8dfa-efa46b0e3e2a"],
 "). The second is the ",
 StyleBox["count form", "TI"],
 " ",
 Cell[BoxData[
  RowBox[{"ArrayDot", "[", 
   RowBox[{"b", ",", " ", "c", ",", " ", "2"}], "]"}]], "InlineFormula",
  ExpressionUUID->"7d972617-2079-4159-979d-a51fd83e9a2a"],
 ", which contracts ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "9e51dfb4-2c95-4265-b38c-6eb5b292da79"],
 "'s last two axes with ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "e21d78de-09ab-4e09-ae8a-0a9ed36d8c78"],
 "'s first two; it works here only because the shared axes happen to be ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "3941129d-6d39-48e0-bfd7-7a6a4f4e9b06"],
 "'s trailing block and ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "0e14dcdf-b239-477d-972b-6e6bed25e75a"],
 "'s leading block. The third is the global-slot form, and comparing it to \
the pair form gives the translation: an ",
 Cell[BoxData[
 "a"], "InlineFormula",ExpressionUUID->"ec630828-7e83-43c3-bc6b-7e12154dd4cd"],
 "-axis keeps its number, while ",
 Cell[BoxData[
 "b"], "InlineFormula",ExpressionUUID->"3d4503ef-5b4c-4584-a531-b4703225829d"],
 "'s axis ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"b", "i"}], "TI"]], "InlineFormula",ExpressionUUID->
  "b6f53fdf-9837-4d9b-9259-8b7d248a8a0b"],
 " is the global slot ",
 Cell[BoxData[
  RowBox[{
   StyleBox["rank",
    FontSlant->"Plain"], "\[ThinSpace]", "[", 
   StyleBox["a", "TI"], "]", "+", 
   StyleBox["b", "TI"], 
   StyleBox["i", "TI"]}]], "InlineFormula",ExpressionUUID->
  "cde338fd-5faa-4838-80b8-026ce60fc850"],
 " (here ",
 Cell[BoxData[
  RowBox[{
   StyleBox["rank",
    FontSlant->"Plain"], "\[ThinSpace]", "[", 
   StyleBox[
    RowBox[{
     StyleBox["t", "TI"], "2"}],
    FontSlant->"Italic"], "]", "=", "3"}]], "InlineFormula",ExpressionUUID->
  "a347cb4b-9f8e-4178-aae1-fb622a43a430"],
 ", so ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "3cb36f92-a922-4411-a4f7-0382490b2f31"],
 "'s axes 1,2 are global slots 4,5). The point of the operand-local \
convention is that a pairwise step never builds the growing flattened slot \
list; it only ever names two operands' own axes, which is why ",
 Cell[BoxData[
 "ArrayDot"], "InlineFormula",ExpressionUUID->
  "fbe3c00a-2fa2-4cc3-a63a-5792ba1ed299"],
 " is the cheap default."
}], "Text",ExpressionUUID->"3f683ac6-332c-47e0-b00a-4423ebf6c8ec"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. The same contraction in every convention", "Section",ExpressionUUID->"6f743760-cafb-41c4-adf5-bcbd08349161"],

Cell[CellGroupData[{

Cell[TextData[{
 "Putting it together, here is the single sum over ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "bb5447af-8a7a-4519-9c07-724f510f3dc6"],
 " (the bond between ",
 Cell[BoxData[
 "t1"], "InlineFormula",ExpressionUUID->
  "c5efcc41-7f44-49b4-98c6-5e52e2c47b7d"],
 " and ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "521c59b1-b531-4f1a-ab2f-b4f56bcdd4d9"],
 ") in all five conventions:"
}], "Text",ExpressionUUID->"04c5c614-8c0f-4799-8744-6580ba4fa763"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a947775b-70a7-43fa-8d23-ccb6ed57ad61"], Cell["Convention", "TableText",
     FontWeight->Bold,ExpressionUUID->"33989bd0-2f62-44d3-9f7c-f4137f3fe46b"],
     Cell[TextData[{
     "the sum over ",
     Cell[BoxData[
      StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
      "32de4f4e-20c5-4403-b89f-1270ca1e96f0"]
    }], "TableText",
     FontWeight->Bold,ExpressionUUID->"5b3b03d8-9ce8-40bc-a728-b8a5a1ffd8ed"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b386eeda-0e5e-4535-b710-ed871549aae5"], Cell[TextData[Cell[BoxData[
    "EinsteinSummation"], "InlineFormula",ExpressionUUID->
     "099705a0-b706-4a2a-b2c3-a9e93d4fed1d"]], "TableText",ExpressionUUID->
     "f3f93af2-1759-4ac9-8e9f-ccecd90617b9"], Cell[TextData[{
     "the repeated label ",
     Cell[BoxData[
      StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
      "196a2678-776e-40ac-8d03-756357749147"],
     " in ",
     Cell[
     BoxData["\"\<ij,jkl,klm->im\>\""], "InlineFormula",ExpressionUUID->
      "0eeb9bbb-4f7b-44ec-b561-9aa7fc1f2606"]
    }], "TableText",ExpressionUUID->"f381f642-ae25-465d-91cf-727185d25529"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5e9de145-cac5-4cd9-87ab-e5e41351841d"], Cell[TextData[{
     Cell[BoxData[
     "TensorNetwork"], "InlineFormula",ExpressionUUID->
      "721173e6-fa24-449d-bd33-7ef0e9fffc9b"],
     " data"
    }], "TableText",ExpressionUUID->"4cd85e60-838c-45d3-a04b-13fb1136fea0"], 
    Cell[TextData[{
     "the bond group joining ",
     Cell[BoxData[
     "t1"], "InlineFormula",ExpressionUUID->
      "c5b08543-53e4-498a-b37d-d4ceb4bdf053"],
     "'s ",
     Cell[BoxData[
      StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
      "87a768c4-82ec-40c7-adb8-1225fb9c6f45"],
     "-leg and ",
     Cell[BoxData[
     "t2"], "InlineFormula",ExpressionUUID->
      "eda6b1d4-ce07-4ff3-a587-73e9a8ba3045"],
     "'s ",
     Cell[BoxData[
      StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
      "7e41bad0-e74c-4f17-920e-e8400371ee6a"],
     "-leg"
    }], "TableText",ExpressionUUID->"c4342593-cdf7-4172-b3e7-b7e07d40c916"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "55032f48-f9fa-4be7-bb42-2d056d01e651"], Cell[TextData[{
     Cell[BoxData[
     "TensorContract"], "InlineFormula",ExpressionUUID->
      "4d0ae3f7-f3af-467d-902c-af74b177ae8b"],
     " global slots"
    }], "TableText",ExpressionUUID->"c562c736-e3a5-448f-b565-866db0f65e1a"], 
    Cell[TextData[{
     "the pair ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]], "InlineFormula",ExpressionUUID->
      "14b5dec2-bd84-4a01-adda-01358c355575"],
     " (slot 2 is ",
     Cell[BoxData[
     "t1"], "InlineFormula",ExpressionUUID->
      "8efb1751-efd6-4fc2-919d-0bef60dd0bdf"],
     "'s ",
     Cell[BoxData[
      StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
      "82292103-b243-4996-a006-e2159c7efa11"],
     ", slot 3 is ",
     Cell[BoxData[
     "t2"], "InlineFormula",ExpressionUUID->
      "017ce0c1-32c7-43ce-a041-c9427c3c7802"],
     "'s ",
     Cell[BoxData[
      StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
      "138517dc-e553-4630-9fb6-2540656cd7fe"],
     ")"
    }], "TableText",ExpressionUUID->"2c262ebd-2f1c-411f-9b88-d4847d693fcc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ed3460ad-5e87-4a54-a509-9a93ed3cb256"], Cell[TextData[{
     Cell[BoxData[
     "ArrayDot"], "InlineFormula",ExpressionUUID->
      "accb7c1b-8121-417e-83b2-7f8139f22c23"],
     " operand-local"
    }], "TableText",ExpressionUUID->"31c9568c-639e-4d67-bef7-203c33b26519"], 
    Cell[TextData[{
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}]], "InlineFormula",ExpressionUUID->
      "bbfc3af6-c788-4c51-8964-bab6530bf363"],
     " (axis 2 of ",
     Cell[BoxData[
     "t1"], "InlineFormula",ExpressionUUID->
      "28158372-49e1-449d-a793-3335fab2fc1f"],
     " with axis 1 of ",
     Cell[BoxData[
     "t2"], "InlineFormula",ExpressionUUID->
      "585c7743-575b-4b36-a798-320245fa1004"],
     ")"
    }], "TableText",ExpressionUUID->"b41d268d-d2da-4b12-a5a0-362b25294542"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5cc40f6f-65f1-4103-b4b7-079b5e23d489"], Cell[
    "contraction path", "TableText",ExpressionUUID->
     "6fdf4060-7dee-4650-81c8-4d2733b794c8"], Cell[TextData[{
     "implicit in the step that contracts the operands holding ",
     Cell[BoxData[
     "t1"], "InlineFormula",ExpressionUUID->
      "c5e3b546-fb83-4e26-a61a-2756fc50a7ec"],
     " and ",
     Cell[BoxData[
     "t2"], "InlineFormula",ExpressionUUID->
      "b8d8d864-727e-460a-b9f8-aac642dd7292"]
    }], "TableText",ExpressionUUID->"13bd1700-4260-41b2-a1a7-931a0fa1e38f"]}
  }]], "2ColumnTableMod",ExpressionUUID->"e7e03a54-c0ea-4315-b75b-\
dabae48f67a2"]
}, Open  ]],

Cell[TextData[{
 "The translations are mechanical: lay all legs end to end and a repeated ",
 Cell[BoxData[
 "EinsteinSummation"], "InlineFormula",ExpressionUUID->
  "a828660e-38df-46cb-b50e-0a1c6d5e8ce8"],
 " label becomes the pair of its two global slots; a ",
 Cell[BoxData[
 "b"], "InlineFormula",ExpressionUUID->"45c89cf6-4807-4d38-ad1a-919637e87458"],
 "-axis at global slot ",
 Cell[BoxData[
  StyleBox["s", "TI"]], "InlineFormula",ExpressionUUID->
  "4ddf2844-e335-4cfa-97a3-b06c6715412f"],
 " is operand-local axis ",
 Cell[BoxData[
  RowBox[{
   StyleBox["s", "TI"], "-", 
   StyleBox["rank",
    FontSlant->"Plain"], "\[ThinSpace]", "[", 
   StyleBox["a", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "26d896be-4a39-4069-9506-ec5cb90819ff"],
 " (here ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "5bf0649e-90e8-46ee-8d6d-00b0d7ec3825"],
 "'s ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "be4c7a1e-a665-4040-971f-e12f6650c007"],
 " at slot 3 is local axis ",
 Cell[BoxData[
  RowBox[{"3", "-", "2", "=", "1"}]], "InlineFormula",ExpressionUUID->
  "49bbdab2-2b6e-469c-a1bb-b7eba619a78e"],
 "); a path step names two operands and the summed legs are the labels they \
share."
}], "Text",ExpressionUUID->"2dad01b7-f6c4-4dca-9592-88762ca58ae7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. What else a repeated index can mean", "Section",ExpressionUUID->"d46d4f0a-70e5-4a7a-8dda-6f2e8f7e37dc"],

Cell["\<\
A repeated index in the tensor network is always a plain pairwise \
contraction. Two other cases exist, and each has its own index convention.\
\>", "Text",ExpressionUUID->"387cb947-359a-49ed-88b8-088a29ff404d"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Broadcasting: a repeated index kept in the output.",
  FontWeight->"Bold"],
 " If a repeated index is ",
 StyleBox["not", "TI"],
 " summed but kept in the output, it is not a contraction at all; it is a \
broadcast, the tensor-network form of the einsum string ",
 Cell[BoxData["\"\<ij,j->ij\>\""], "InlineFormula",ExpressionUUID->
  "86039d22-d22d-4a3c-826c-08380b22c699"],
 ". ",
 Cell[BoxData[
 "EinsteinSummation"], "InlineFormula",ExpressionUUID->
  "15d50bb0-ac42-4afc-8789-b37b00def1b0"],
 " routes this through ",
 Cell[BoxData[
  ButtonBox["IndexedMultiply",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/IndexedMultiply"]], 
  "InlineFormula",ExpressionUUID->"4502cfc3-8af0-4ec7-a8ee-e16e7c0db95e"],
 ", which aligns the shared axis and multiplies elementwise. Show that ",
 Cell[BoxData["\"\<ij,j->ij\>\""], "InlineFormula",ExpressionUUID->
  "24fca947-255a-4871-8cf2-56d2094ced3f"],
 " multiplies each column of a matrix by a vector:"
}], "Text",ExpressionUUID->"f4ee452e-33a9-4685-804e-9c62520c0caa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"v", " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"1", ",", " ", 
        RowBox[{"{", "3", "}"}]}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"ActivateTensors", "[", 
     RowBox[{"EinsteinSummation", "[", 
      RowBox[{"\"\<ij,j->ij\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "v"}], "}"}]}], "]"}], "]"}], " ", "==", " ", 
    RowBox[{"a", " ", "*", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"v", ",", " ", 
       RowBox[{"Length", "[", "a", "]"}]}], "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"312283a4-9dcc-420e-a5c8-b881a5257275"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.989676066113617*^9},
 CellLabel->"Out[21]=",
 CellID->1039870588,ExpressionUUID->"7e4fa2b9-d381-4f19-aa49-2f105caadbff"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The result is ",
 Cell[BoxData[
 "True"], "InlineFormula",ExpressionUUID->
  "5c62b334-7bfe-4167-9d73-446fb56491a9"],
 ". Here ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "889dc8ac-cab3-4981-ab05-2eb752969d62"],
 " appears on both inputs ",
 StyleBox["and", "TI"],
 " in the output, so it survives as a single shared axis rather than being \
summed. Look at what ",
 Cell[BoxData[
 "IndexedMultiply"], "InlineFormula",ExpressionUUID->
  "9d72fd7c-dda4-472a-9099-f2dd7e014910"],
 " returns directly:"
}], "Text",ExpressionUUID->"94831f4e-c262-4acb-948c-4326b1b06dab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IndexedMultiply", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", "2", "}"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        SubscriptBox["mat", "##"], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        SubscriptBox["vec", "##"], "&"}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.989676242140953*^9, 3.989676324092534*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"6ad11b16-2e2b-4348-b747-d80920ca83fb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["vec", "1"], " ", 
        SubscriptBox["mat", 
         RowBox[{"1", ",", "1"}]]}], ",", 
       RowBox[{
        SubscriptBox["vec", "2"], " ", 
        SubscriptBox["mat", 
         RowBox[{"1", ",", "2"}]]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["vec", "1"], " ", 
        SubscriptBox["mat", 
         RowBox[{"2", ",", "1"}]]}], ",", 
       RowBox[{
        SubscriptBox["vec", "2"], " ", 
        SubscriptBox["mat", 
         RowBox[{"2", ",", "2"}]]}]}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.989676070326501*^9, {3.9896762868485727`*^9, 3.9896763244508257`*^9}},
 CellLabel->"Out[33]=",
 CellID->1790883483,ExpressionUUID->"130b16a2-c7a7-4904-be94-97f32a3ad532"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "It returns a pair: the labels ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "2"}], "}"}]], "InlineFormula",ExpressionUUID->
  "bf1a0052-7f26-466f-9055-bad655570288"],
 " (the de-duplicated union, each once) and the broadcast tensor ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SubscriptBox["vec", "1"], " ", 
       SubscriptBox["mat", 
        RowBox[{"1", ",", "1"}]]}], ",", 
      RowBox[{
       SubscriptBox["vec", "2"], " ", 
       SubscriptBox["mat", 
        RowBox[{"1", ",", "2"}]]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SubscriptBox["vec", "1"], " ", 
       SubscriptBox["mat", 
        RowBox[{"2", ",", "1"}]]}], ",", 
      RowBox[{
       SubscriptBox["vec", "2"], " ", 
       SubscriptBox["mat", 
        RowBox[{"2", ",", "2"}]]}]}], "}"}]}], "}"}]], "InlineFormula",
  ExpressionUUID->"f9f2f546-f087-4d23-a8d0-b865cf6277aa"],
 " of dims ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "3"}], "}"}]], "InlineFormula",ExpressionUUID->
  "92b27434-0667-409c-8938-b1ed598c5914"],
 ", each column of the matrix scaled by the matching vector entry. The \
convention to remember: a repeated index that reaches the output is one \
diagonal axis, identified across the tensors that carry it, not a contraction \
pair. So the tensor network never invokes ",
 Cell[BoxData[
 "IndexedMultiply"], "InlineFormula",ExpressionUUID->
  "427539c6-680d-4d61-bbe7-cf67eaeb21b2"],
 ", its repeated indices ",
 Cell[BoxData[
  RowBox[{
   StyleBox["j", "TI"], ",", "\[ThinSpace]", 
   StyleBox["k", "TI"], ",", "\[ThinSpace]", 
   StyleBox["l", "TI"]}]], "InlineFormula",ExpressionUUID->
  "c710e2e2-fcc6-488d-b9be-8b13ad665edc"],
 " are all summed; broadcasting needs a ",
 StyleBox["shared output", "TI"],
 " index like the one above."
}], "Text",
 CellChangeTimes->{{3.9896763400985622`*^9, 
  3.98967634009867*^9}},ExpressionUUID->"ea1844e0-612a-4d01-86ee-\
8f6870ffdb24"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Hyperedges: a contracted index on three or more tensors.",
  FontWeight->"Bold"],
 " A contracted index on three or more tensors (a hyperedge) has no single \
pairwise form. Rebuild the three-tensor network and add a fourth tensor ",
 Cell[BoxData[
 "t4"], "InlineFormula",ExpressionUUID->
  "717b98d9-41e0-43e7-b959-25690d751496"],
 " carrying ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "02a0c345-4dc0-42f9-a5a4-8cea144018f0"],
 " (and a new free leg ",
 Cell[BoxData[
  RowBox[{
   StyleBox["n", "TI"], "=", "6"}]], "InlineFormula",ExpressionUUID->
  "51ce63e0-715c-4f62-98f6-e13966509ec2"],
 "), so ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "3cdd7dad-b90c-477d-9195-1fa53f852594"],
 " now sits on ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "2aec63e1-270c-4fbd-8ed3-4d0994765524"],
 ", ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "2e088d0f-8f85-41aa-b080-c3008b48b774"],
 ", ",
 Cell[BoxData[
 "t4"], "InlineFormula",ExpressionUUID->
  "cf283c61-ada2-48b1-b387-d0dee912c337"],
 ":"
}], "Text",ExpressionUUID->"5910c2e9-d4fa-49b4-93c7-5ae927885125"],

Cell[BoxData[
 RowBox[{
  RowBox[{"t4", " ", "=", " ", 
   RowBox[{"ArraySymbol", "[", 
    RowBox[{"\"\<t4\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9896761394026527`*^9, 3.989676140217381*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"214a4da3-7e56-4776-89c7-b1f451da1072"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Lower the four-tensor network:", "Text",ExpressionUUID->"d9e5de70-c9ef-4756-b74e-d8173b3da749"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "6"}], "}"}]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "5", ",", " ", "6"}], "}"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t1", ",", " ", "t2", ",", " ", "t3", ",", " ", "t4"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"cc89ba46-17b4-46c2-abed-ddddba1bcbbc"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"TensorContract"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[TensorContract]"], "[", 
  RowBox[{
   RowBox[{
    TemplateBox[{"\"t1\"", "2", "2", "3"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    TemplateBox[{"\"t2\"", "3", "3", "4", "5"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    TemplateBox[{"\"t3\"", "3", "4", "5", "2"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    TemplateBox[{"\"t4\"", "2", "4", "2"},
     "ArraySymbol2"]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "6", ",", "9"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "7"}], "}"}]}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.9896761423259*^9},
 CellLabel->"Out[24]=",
 CellID->1938302256,ExpressionUUID->"1b9b0921-9173-42fa-8fbc-c864ebd90875"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "In the lowering the ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "ac8935f2-7652-4b61-948f-e293ffd357d5"],
 " contraction is the group ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "6", ",", " ", "9"}], "}"}]], "InlineFormula",
  ExpressionUUID->"8c398419-51b8-48d7-a25c-f7b722a4d996"],
 ", a ",
 StyleBox["three-element", "TI"],
 " group rather than a pair: slot 4 (",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "12b75a02-2ae6-4d78-875a-2135e8ca283a"],
 "'s ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "30c7b4d2-b4a7-41bc-b378-0cf8e2e06200"],
 "), slot 6 (",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "68f9e0f8-515a-404c-b2c6-44cb5de2c311"],
 "'s ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "30245b2d-8808-4031-91e4-a526603f7d63"],
 "), slot 9 (",
 Cell[BoxData[
 "t4"], "InlineFormula",ExpressionUUID->
  "a180d121-4846-49c2-b479-b40b52b91145"],
 "'s ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "ab3dc441-3d35-4b6d-904f-0011f2f9c096"],
 "). ",
 Cell[BoxData[
 "TensorContract"], "InlineFormula",ExpressionUUID->
  "83db2407-1b9b-44cf-8b72-d3127344b41b"],
 " treats it as a generalized trace over all three slots at once. That is the \
global-slot convention's answer to a hyperedge: groups, not just pairs."
}], "Text",ExpressionUUID->"a6d0b3b1-2e98-4f94-be45-b2962f125437"],

Cell[CellGroupData[{

Cell["\<\
The contraction-path machinery cannot use a three-way group, because a path \
is built from pairwise steps. It instead binarizes: it inserts an explicit \
delta \"spider\" tensor so the hyperedge becomes ordinary two-tensor bonds. \
Build the four-tensor network:\
\>", "Text",ExpressionUUID->"bfb7845d-2c94-467d-81a9-4b60e77c941f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tnH", " ", "=", " ", 
  RowBox[{"TensorNetwork", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"t1", ",", " ", "t2", ",", " ", "t3", ",", " ", "t4"}], "}"}], ",",
     " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4", ",", " ", "5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "6"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"d255cba6-2ace-458f-8164-34ed69bc2e5a"],

