Cell[CellGroupData[{

Cell["\<\
Its binarized form adds one spider, raising the operand count from four to \
five:\
\>", "Text",ExpressionUUID->"7df4584a-caf1-4ac2-b726-d1522f56d791"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"BinaryTensorNetwork", "[", "tnH", "]"}], "[", "\"\<Size\>\"", 
  "]"}]], "Input",
 CellLabel->
  "In[22]:= ",ExpressionUUID->"8a53a076-c1ef-4cef-b8b9-c3c21ff036e0"],

Cell[BoxData["5"], "Output",
 CellLabel->
  "Out[22]= ",ExpressionUUID->"7b2391e2-9f0f-47b7-a9c3-d42c1ac35538"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The greedy path then runs over that five-operand pool:", "Text",ExpressionUUID->"87237be7-5c86-46f6-8d99-c02ff28a297c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GreedyContractionPath", "[", "tnH", "]"}]], "Input",
 CellLabel->
  "In[23]:= ",ExpressionUUID->"40a94397-31b1-42a3-8042-c95fd6c75e58"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellLabel->
  "Out[23]= ",ExpressionUUID->"c795995b-1828-4f58-ac1d-f223ed946e5e"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The path ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"4", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "3d0108dc-a2f4-4462-a5d3-5bb922929830"],
 " has four steps over five operands. So a contracted hyperedge has two \
equivalent representations: one ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "d93fdbfa-447f-409d-be08-34258bc911d8"],
 "-element group in the global-slot convention (",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorContract"]], "InlineFormula",ExpressionUUID->
  "d7914a73-5aef-4a05-a90e-3672919a001c"],
 "), or an explicit delta spider plus pairwise bonds in the path convention."
}], "Text",ExpressionUUID->"8a7aca9d-09fc-43c7-b25f-0b4f127658ad"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Where this leaves us", "Section",ExpressionUUID->"9c81207b-8c23-4bfb-a85a-516b0f31a404"],

Cell["\<\
We built one network and read its indices in every convention the kernel uses:\
\>", "Text",ExpressionUUID->"6521aa56-5440-4478-a3a8-d45635d1f333"],

Cell[TextData[{
 "A repeated ",
 Cell[BoxData[
 "EinsteinSummation"], "InlineFormula",ExpressionUUID->
  "a66416d1-1b1c-42ad-9d3f-837909fe994f"],
 " label that is summed becomes one ",
 Cell[BoxData[
 "TensorContract"], "InlineFormula",ExpressionUUID->
  "6dba77d6-c090-4321-a595-9848b915fa04"],
 " group of its global slots (a pair for two tensors, an ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "ee010762-0a84-4910-8172-5ad066d60c1d"],
 "-element group for more); a once-only label is a free slot."
}], "Item",ExpressionUUID->"0e83a068-75ae-4e01-a220-b4a3951c8a08"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
 "TensorNetwork"], "InlineFormula",ExpressionUUID->
  "dfc5fa6b-dfbd-4787-ab69-1688c5f0a50e"],
 " data labels tag each leg with its tensor position and label; shared labels \
are bond groups, once-only labels are the free indices and set the output \
order."
}], "Item",ExpressionUUID->"9ba688b4-9ea9-4642-9a13-0d3c3564f9ba"],

Cell[TextData[{
 "A contraction path numbers operands and lists pairwise steps in order; \
reading the nested ",
 Cell[BoxData[
 "ArrayDot"], "InlineFormula",ExpressionUUID->
  "8ffd5f05-234d-4d86-b3d9-b43910d2db30"],
 " (or the ",
 Cell[BoxData[
  ButtonBox["ContractionTree",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/ContractionTree"]], 
  "InlineFormula",ExpressionUUID->"de2bab5b-0fc1-4b2a-807e-796055a73432"],
 ") gives the sequence, and the legs summed at a step are recovered from the \
data."
}], "Item",ExpressionUUID->"028da3bf-d2bf-4f04-9d29-42e6f71c1528"],

Cell[TextData[{
 Cell[BoxData[
 "ArrayDot"], "InlineFormula",ExpressionUUID->
  "d15f1065-306a-4f8a-bad3-3cdfbeed2a4c"],
 " re-expresses a pairwise step in operand-local axes; ",
 Cell[BoxData[
 "b"], "InlineFormula",ExpressionUUID->"13094c6d-eb91-46fe-abf1-ce5a3b37e7b1"],
 "'s axis ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"b", "i"}], "TI"]], "InlineFormula",ExpressionUUID->
  "07b88bf8-6229-41c0-ba96-91d066e86e3d"],
 " is the global slot ",
 Cell[BoxData[
  RowBox[{
   StyleBox["rank",
    FontSlant->"Plain"], "\[ThinSpace]", "[", 
   StyleBox["a", "TI"], "]", "+", 
   StyleBox["b", "TI"], 
   StyleBox["i", "TI"]}]], "InlineFormula",ExpressionUUID->
  "21955065-8d53-48e3-935e-237cf0a711ff"],
 "."
}], "Item",ExpressionUUID->"daa0fd12-ee7d-4169-a0b3-6feaa3a9dbe7"],

Cell[TextData[{
 "A repeated index that survives to the output is a broadcast (",
 Cell[BoxData[
  ButtonBox["IndexedMultiply",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/IndexedMultiply"]], 
  "InlineFormula",ExpressionUUID->"af0e68b2-5c89-4763-b606-2c91d5202735"],
 "), not a contraction; a contracted index on three or more tensors is an ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "05c9dd93-19d9-4bd3-92c4-6ac1091465fa"],
 "-element group or, for path execution, a binarized spider."
}], "Item",ExpressionUUID->"3f2c807b-4210-462b-8e5a-585532c433e4"]
}, Open  ]],

