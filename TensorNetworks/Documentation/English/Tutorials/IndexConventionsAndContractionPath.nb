Cell[TextData[{
 "In this drawing the vertices are the indices ",
 Cell[BoxData[
  RowBox[{
   StyleBox["i", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["j", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["k", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["l", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["m", "TI"]}]], "InlineFormula",ExpressionUUID->
  "5ed2207f-72d7-47c7-8110-90d817243673"],
 " and each edge is a tensor, spanning the indices it carries: ",
 Cell[BoxData[
 "t1"], "InlineFormula",ExpressionUUID->
  "4533e4a2-c6c0-42cf-a967-22871d7f67ba"],
 " over ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["i", "TI"]}], 
   RowBox[{",", "\[ThinSpace]"}], 
   RowBox[{
    StyleBox["j", "TI"], "}"}]}]], "InlineFormula",ExpressionUUID->
  "23ac0064-46d1-477f-a169-6b2dd18bd4b2"],
 ", ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "60255834-bfb6-4310-b7b2-637afc6f3020"],
 " over ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["j", "TI"]}], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["k", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   RowBox[{
    StyleBox["l", "TI"], "}"}]}]], "InlineFormula",ExpressionUUID->
  "293cea41-f076-4211-a32d-20c2baaf001e"],
 ", ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "767a5f51-c064-44be-a173-07f615d737d6"],
 " over ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["k", "TI"]}], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["l", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   RowBox[{
    StyleBox["m", "TI"], "}"}]}]], "InlineFormula",ExpressionUUID->
  "005308ac-4739-4dcc-840e-28ddaa2e9c8e"],
 ". An index that lies on two tensors is a contracted bond, that is, a vertex \
shared by two edges: ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "2a3db013-c217-443c-b004-348facc4f579"],
 " joins ",
 Cell[BoxData[
 "t1"], "InlineFormula",ExpressionUUID->
  "c32770ae-7696-4b36-a4e7-84247124baf4"],
 " and ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "d147d77e-3516-4024-9ff4-832095c69635"],
 ", while ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "ec80ffc9-b93c-48c3-b84f-92eb93300326"],
 " and ",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "8a47e69e-c4cd-4ff0-b523-c64d73611baf"],
 " both join ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "bed36eea-9ac6-40ae-bbcd-3eb4087026de"],
 " and ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "23efcc05-09a8-4947-bd73-41bb9d3a9edf"],
 " (the doubled bond). An index on a single tensor is free, a vertex in just \
one edge: ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "0cbed09c-070a-412e-84a6-d00a2f6a73eb"],
 " on ",
 Cell[BoxData[
 "t1"], "InlineFormula",ExpressionUUID->
  "be18db60-b74a-4bd1-827f-c67231fd6ad9"],
 " and ",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",ExpressionUUID->
  "118c4f76-31fc-4dec-a487-54d55056a1d2"],
 " on ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "d890f1ad-7063-4b36-a7f3-7cf7a5bb0588"],
 ". This is the same split that the contractions listing gave, now visible at \
a glance. Note it is the dual of the usual tensor-network diagram, where \
tensors are nodes and indices are lines; here the two roles are swapped."
}], "Text",ExpressionUUID->"ae303369-4851-4e35-8c5b-77ae81d72756"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Global slots.",
  FontWeight->"Bold"],
 " Contraction flattens the operands into one ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorProduct"]], "InlineFormula",ExpressionUUID->
  "cf64bf01-7863-4d68-93a0-6e50dd5e455a"],
 ", and a global index is a ",
 StyleBox["slot position", "TI"],
 " in that flattened product. Lower the ",
 Cell[BoxData[
 "EinsteinSummation"], "InlineFormula",ExpressionUUID->
  "d0cc9a96-6d44-4188-84b6-b8f20931f6b3"],
 " spec to see those slots:"
}], "Text",ExpressionUUID->"6fecd285-b718-4bb3-994b-086b925f6b4d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EinsteinSummation", "[", 
  RowBox[{"\"\<ij,jkl,klm->im\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"d46b6413-a8c0-4654-92da-fdd43933b022"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"TensorContract"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[TensorContract]"], "[", 
  RowBox[{
   RowBox[{
    TemplateBox[{"\"t1\"", "2", "2", "3"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    TemplateBox[{"\"t2\"", "3", "3", "4", "5"},
     "ArraySymbol2"], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    TemplateBox[{"\"t3\"", "3", "4", "5", "2"},
     "ArraySymbol2"]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"5", ",", "7"}], "}"}]}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.989675988426219*^9},
 CellLabel->"Out[13]=",
 CellID->230496109,ExpressionUUID->"eea6b445-b03f-465e-94a7-4516da97f44d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The output is an inactive ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorContract"]], "InlineFormula",ExpressionUUID->
  "afb90802-842b-4818-a2b1-ece70ffee848"],
 " of the ",
 Cell[BoxData[
  ButtonBox["TensorProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorProduct"]], "InlineFormula",ExpressionUUID->
  "094692f3-c99b-4149-8147-02d2a35e5025"],
 " with contraction pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"4", ",", "6"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"5", ",", "7"}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "d3038edc-28ec-421e-8fc5-9bf8b4cec5a7"],
 ". The integers are slot positions in the flattened ",
 Cell[BoxData[
  RowBox[{"TensorProduct", "[", 
   RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "]"}]], "InlineFormula",
  ExpressionUUID->"5b03cc28-f6b4-4866-919f-cb320c635923"],
 ". To see the slots explicitly, flatten the data labels:"
}], "Text",ExpressionUUID->"27206b36-363d-4860-bd56-85212ac74b7a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Catenate", "[", 
  RowBox[{"tn", "[", "\"\<Indices\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"69a6e30b-2d23-4d8e-a40e-91238d62b53e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{"1", "1"},
    "Superscript"], ",", 
   TemplateBox[{"1", "2"},
    "Superscript"], ",", 
   TemplateBox[{"2", "2"},
    "Superscript"], ",", 
   TemplateBox[{"2", "3"},
    "Superscript"], ",", 
   TemplateBox[{"2", "4"},
    "Superscript"], ",", 
   TemplateBox[{"3", "3"},
    "Superscript"], ",", 
   TemplateBox[{"3", "4"},
    "Superscript"], ",", 
   TemplateBox[{"3", "5"},
    "Superscript"]}], "}"}]], "Output",
 CellChangeTimes->{3.9896759958314333`*^9},
 CellLabel->"Out[14]=",
 CellID->1515364315,ExpressionUUID->"17051287-4b38-414b-96db-8c12d48a02fb"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The result lists the eight legs in order, and the ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "a2033f84-7206-4f13-a958-a13ad3b0b850"],
 "-th element is global slot ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "b9e4aabf-c851-400f-9059-4aabfa1044f5"],
 ": its base is the tensor, its superscript the ",
 Cell[BoxData[
 "EinsteinSummation"], "InlineFormula",ExpressionUUID->
  "f9f07fbb-ba37-46dc-8c18-a39bbc77a9f4"],
 " label. So ",
 Cell[BoxData[
 "t1"], "InlineFormula",ExpressionUUID->
  "62b0760d-c438-44a0-81ea-82d787b77d12"],
 " owns slots 1-2, ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "ff268da2-a089-4411-8a84-0602f32699b9"],
 " owns 3-5, ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "cebed9ea-27bc-4549-9956-2dd1ee6e1525"],
 " owns 6-8, and the lowering reads: sum slot 2 with 3 (the two ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "9dfd30b6-8197-478c-a81e-3ad75a41f764"],
 "'s), 4 with 6 (",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "1993962f-8bb5-4226-afce-15aa7dc26fc7"],
 "), 5 with 7 (",
 Cell[BoxData[
  StyleBox["l", "TI"]], "InlineFormula",ExpressionUUID->
  "7043f5a9-292b-4b8b-9d2e-25f7c73d559a"],
 "). The free slots 1 (",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "8726dc34-40fc-43d1-aa9c-7c49c192d3a6"],
 ") and 8 (",
 Cell[BoxData[
  StyleBox["m", "TI"]], "InlineFormula",ExpressionUUID->
  "9eb11f4d-d2b9-4864-912a-484fd0cd8d47"],
 ") survive in slot order ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    StyleBox["i", "TI"], 
    RowBox[{",", "\[ThinSpace]"}], 
    StyleBox["m", "TI"]}], ")"}]], "InlineFormula",ExpressionUUID->
  "faecaa00-d183-4f04-8904-99c246bbb41a"],
 ", which is the order we requested, so there is no trailing transpose. \
Output order is its own convention: free legs survive tensor-then-leg, and \
requesting a different order would append a ",
 Cell[BoxData[
  ButtonBox["Transpose",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Transpose"]], "InlineFormula",ExpressionUUID->
  "59b053ef-03aa-45c8-8f58-594baf220819"],
 "."
}], "Text",ExpressionUUID->"0345458c-784e-499e-88c1-05b5351c2430"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
2. The contraction-path convention: pairwise steps over operands\
\>", "Section",ExpressionUUID->"2fa84fa1-7db6-4bd8-a5ab-61824d0b34f9"],

Cell[TextData[{
 "Contraction happens pairwise and in sequence. A path is a list of steps; \
each step picks two tensors from the ",
 StyleBox["current", "TI"],
 " pool, sums over every leg they share, and puts the resulting tensor back \
in the pool for the later steps. The path numbers ",
 StyleBox["operands", "TI"],
 ", not legs: it says which two tensors meet at each step, and the legs that \
get summed are simply whatever those two share. The final value does not \
depend on the order, but the order is what the executor walks, and it fixes \
which indices are summed when."
}], "Text",ExpressionUUID->"2f959dde-2cda-44a9-a8da-b54a8e058341"],

Cell[CellGroupData[{

Cell["Get a contraction path for the tensor network and keep it:", "Text",ExpressionUUID->"f523df9f-f444-4d76-92ce-cf5e2c9fa25f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"path", " ", "=", " ", 
  RowBox[{"GreedyContractionPath", "[", "tn", "]"}]}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"aab23091-0688-4726-9aac-90f097fc80b8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.989676004790153*^9},
 CellLabel->"Out[15]=",
 CellID->865487441,ExpressionUUID->"1d7d2fcb-1918-42a9-ae12-3adf73d5eb07"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The result ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "ca0996e1-f2d2-490c-8767-d93672759f6a"],
 " is two steps over the three operands ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"t1", ",", " ", "t2", ",", " ", "t3"}], "}"}]], "InlineFormula",
  ExpressionUUID->"d6e3e923-f76e-42c1-91b5-2cd6b5ef53c6"],
 ". Step 1's ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", "3"}], "}"}]], "InlineFormula",ExpressionUUID->
  "1733c6a3-eaa4-4c5f-b782-418740fe1c4e"],
 " contracts operands 2 and 3 (",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "a88c0760-c5ec-426b-9a33-60f9ddd9c4e2"],
 ", ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "91ac9279-3757-4a38-a26c-f79570560340"],
 "); their result re-enters the pool, now ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"t1", ",", " ", "t2t3"}], "}"}]], "InlineFormula",ExpressionUUID->
  "98145c7e-f3da-4ebb-b727-48065ba521f1"],
 ", so step 2's ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "2"}], "}"}]], "InlineFormula",ExpressionUUID->
  "768451d3-6945-400e-ada1-6c388115720e"],
 " means ",
 Cell[BoxData[
 "t1"], "InlineFormula",ExpressionUUID->
  "b3128df2-9535-45f5-86fd-4d090ed1bee5"],
 " and ",
 Cell[BoxData[
 "t2t3"], "InlineFormula",ExpressionUUID->
  "1630340c-77b6-4019-95bd-4f192dfd3f4d"],
 ". Operand numbers are reused because after each contraction the two inputs \
are replaced by their single result. (",
 Cell[BoxData[
  ButtonBox["GreedyContractionPath",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/TensorNetworks/ref/GreedyContractionPath"]], 
  "InlineFormula",ExpressionUUID->"dd602378-aa25-410a-ac7c-9eb0e1664590"],
 " is one of several functions that compute such a path; they differ in the \
cost of the path they return, not in any index convention, so we just use \
one.)"
}], "Text",ExpressionUUID->"423b5b59-2ae6-48bf-81fc-25e77dbd57e0"],

Cell[CellGroupData[{

Cell["\<\
The path is an abstract recipe; the executor turns it into an explicit nest \
of pairwise contractions. Build that expression, left inactive so we can read \
the plan:\
\>", "Text",ExpressionUUID->"7bc92488-7a43-4d7d-b9f8-3978bf3fbbe2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ic", " ", "=", " ", 
  RowBox[{"TensorNetworkContraction", "[", 
   RowBox[{"tn", ",", " ", "path"}], "]"}]}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"cf1bc518-5693-457c-bd6e-76dd82f0b22c"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"ArrayDot"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[ArrayDot]"], "[", 
  RowBox[{
   TemplateBox[{"\"t1\"", "2", "2", "3"},
    "ArraySymbol2"], ",", 
   RowBox[{
    TemplateBox[{"ArrayDot"},
     "InactiveHead",
     BaseStyle->"Inactive",
     SyntaxForm->"Symbol",
     Tooltip->"Inactive[ArrayDot]"], "[", 
    RowBox[{
     TemplateBox[{"\"t2\"", "3", "3", "4", "5"},
      "ArraySymbol2"], ",", 
     TemplateBox[{"\"t3\"", "3", "4", "5", "2"},
      "ArraySymbol2"], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.989676008591426*^9},
 CellLabel->"Out[16]=",
 CellID->1530210541,ExpressionUUID->"d2f34ab1-7af5-49ee-b854-4722adcbcd30"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The output is ",
 Cell[BoxData[
  RowBox[{"ArrayDot", "[", 
   RowBox[{"t1", ",", " ", 
    RowBox[{"ArrayDot", "[", 
     RowBox[{"t2", ",", " ", "t3", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"e45f6fc0-57dd-4f85-bf91-3f37100cf70d"],
 " (inactive), read inside-out. The inner ",
 Cell[BoxData[
  ButtonBox["ArrayDot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ArrayDot"]], "InlineFormula",ExpressionUUID->
  "04ee6c37-d5b2-41c9-b9b8-fa4efe2cc3b1"],
 " is step 1: contract ",
 Cell[BoxData[
 "t2"], "InlineFormula",ExpressionUUID->
  "8448927a-f702-4f14-a393-fd789833eb3a"],
 " and ",
 Cell[BoxData[
 "t3"], "InlineFormula",ExpressionUUID->
  "8a227f7a-ed6e-4cfe-a093-2c2c0734775f"],
 " over their two shared legs ",
 Cell[BoxData[
  RowBox[{
   StyleBox["k", "TI"], 
   RowBox[{",", "\[ThinSpace]"}], 
   StyleBox["l", "TI"]}]], "InlineFormula",ExpressionUUID->
  "22dfe0e4-c46f-4713-9aa2-a3b2f9d849e6"],
 " (the operand-local axis pairs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"2", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2"}], "}"}]}], "}"}]], "InlineFormula",ExpressionUUID->
  "e9d477db-c3cc-4d86-ae37-133aef42c1c7"],
 " of section 3). The outer ",
 Cell[BoxData[
  ButtonBox["ArrayDot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ArrayDot"]], "InlineFormula",ExpressionUUID->
  "23d9a3bf-e25d-4177-9774-1daa3ccf292d"],
 " is step 2: contract ",
 Cell[BoxData[
 "t1"], "InlineFormula",ExpressionUUID->
  "f65d41e4-3e15-42f2-9a68-311b910ed0ce"],
 " with that intermediate over their shared ",
 Cell[BoxData[
  StyleBox["j", "TI"]], "InlineFormula",ExpressionUUID->
  "5039b6d6-bfdf-4cfa-893d-fcee4cb13425"],
 ". The nesting ",
 StyleBox["is", "TI"],
 " the order, and each node carries the axes summed at that step."
}], "Text",ExpressionUUID->"ed7a6156-e42a-47a6-b61b-125e8e1231f6"],

Cell[CellGroupData[{

Cell["\<\
The same thing is clearer as a tree. Render the contraction hierarchy with \
dimension labels:\
\>", "Text",ExpressionUUID->"d7d8ca46-7ea4-4db5-b8aa-2ac6974fcae8"],

